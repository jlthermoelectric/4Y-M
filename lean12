/-! ## 9. `V`, the plaquettes meeting `V`, the exterior links and the averages

The tables of Section 8 are decoded here, and closed checks (`decide +kernel`) show that they
enumerate exactly the geometric objects of Section 7. -/

section Tables

/-- The code of the `a`-th link of `V`. -/
def vCode (a : ℕ) : ℕ := dig 13 vpk a

/-- The `a`-th link of `V`. -/
def vLink (a : ℕ) : Link := linkOfCode (vCode a)

/-- **The enumeration of `V`**: 784 links, lexicographic in `(x, μ)`. `V_spec` shows that it is a
bijection onto `{l | inV l}`. -/
def vList (a : Fin 784) : Link := vLink a

/-- The code of the `e`-th exterior link. -/
def eCode (e : ℕ) : ℕ := dig 13 epk e

/-- **The exterior links**: 1668 active links outside `V`, lexicographic in `(x, μ)`. They include
every active link outside `V` that lies in a plaquette meeting `V` or in a block average of `W`
(`codeOK_ne` with `pslot_ok` and `aslot_ok`). -/
def eLink (e : ℕ) : Link := linkOfCode (eCode e)

/-- The code of the `i`-th plaquette meeting `V`. -/
def pCode (i : ℕ) : ℕ := dig 14 ppk i

/-- **The plaquettes meeting `V`**: 2080, lexicographic in `(x, μ, ν)`. `plaq_spec` shows that
`i ↦ pPlaq i` is a bijection from `Fin 2080` onto `{p | μ < ν, p meets V}`. -/
def pPlaq (i : ℕ) : Plaq := plaqOfCode (pCode i)

/-- The slot code of link `k` of plaquette `i`: `a < 784` for `vLink a`, `784 + e` for `eLink e`,
`2452` for a tree link. -/
def ps (i k : ℕ) : ℕ := dig 12 pslots (Nat.add (Nat.mul 4 i) k)

/-- The slot code of link `s` of average `r`. -/
def asl (r s : ℕ) : ℕ := dig 12 aslots (Nat.add (Nat.mul 32 r) s)

/-- The direction `r mod 4` of the average `r = 4 yi + μ`. -/
def avgDir (r : ℕ) : Fin 4 := ⟨r % 4, Nat.mod_lt _ (by norm_num)⟩

/-- Link `s = 2m + b` of the average `r = 4 yi + μ`: `(2y + o, μ)` for `b = 0` and
`(2y + o + e_μ, μ)` for `b = 1`, with `y = blockOf yi` and `o` the binary digits of `m`. -/
def avgLink (r s : ℕ) : Link :=
  if s % 2 = 0 then (blockSite (blockOf (r / 4)) (s / 2), avgDir r)
  else (blockSite (blockOf (r / 4)) (s / 2) + unitVec (avgDir r), avgDir r)

/-- The slot code `c` is correct for the link `l`. -/
def codeOK (c : ℕ) (l : Link) : Bool :=
  if c < 784 then linkEq (vLink c) l
  else if c < 2452 then linkEq (eLink (c - 784)) l
  else decide (c = 2452) && isTree l

/-- The codes of `V` are the codes of all links of `V`, in increasing order. -/
theorem vcheck : (List.range 784).map vCode =
    (List.range 5184).filter (fun n => inV (linkOfCode n)) := by decide +kernel

/-- The plaquette codes are the codes of all plaquettes meeting `V`, in increasing order. -/
theorem pcheck : (List.range 2080).map pCode =
    (List.range 10000).filter (fun n => decide (n / 4 % 4 < n % 4) && meetsV (plaqOfCode n)) := by
  decide +kernel

/-- The exterior links are active links outside `V`, with increasing codes. -/
theorem echeck : allBelow 1668 (fun e => decide (eCode e < 5184) && !isTree (eLink e) &&
    !inV (eLink e)) = true := by decide +kernel

theorem esorted : allBelow 1667 (fun e => decide (eCode e < eCode (e + 1))) = true := by
  decide +kernel

/-- Every plaquette slot code is correct. -/
theorem pslotCheck : allBelow 2080 (fun i => dirs.all fun k => codeOK (ps i k) (plaqLink (pPlaq i) k))
    = true := by decide +kernel

/-- Every average slot code is correct. -/
theorem aslotCheck : allBelow 64 (fun r => allBelow 32 fun s => codeOK (asl r s) (avgLink r s)) =
    true := by decide +kernel

theorem mem_vcodes {n : ℕ} :
    n ∈ (List.range 784).map vCode ↔ n < 5184 ∧ inV (linkOfCode n) = true := by
  rw [vcheck, List.mem_filter, List.mem_range]

theorem vCode_spec {a : ℕ} (ha : a < 784) : vCode a < 5184 ∧ inV (vLink a) = true :=
  mem_vcodes.mp (List.mem_map.mpr ⟨a, List.mem_range.mpr ha, rfl⟩)

theorem vLink_inj {a a' : ℕ} (ha : a < 784) (ha' : a' < 784) (h : vLink a = vLink a') : a = a' := by
  have hc := linkOfCode_inj (vCode_spec ha).1 (vCode_spec ha').1 h
  have hnd : ((List.range 784).map vCode).Nodup := by
    rw [vcheck]; exact List.nodup_range.filter _
  exact List.inj_on_of_nodup_map hnd (List.mem_range.mpr ha) (List.mem_range.mpr ha') hc

theorem vList_injective : Function.Injective vList := fun a a' h => Fin.ext (vLink_inj a.2 a'.2 h)

/-- **`V` is enumerated by `vList`.** -/
theorem V_spec (l : Link) : inV l = true ↔ ∃ a : Fin 784, vList a = l := by
  constructor
  · intro h
    obtain ⟨n, hn, rfl⟩ := exists_linkCode l (base_of_inV h)
    obtain ⟨a, ha, han⟩ := List.mem_map.mp (mem_vcodes.mpr ⟨hn, h⟩)
    exact ⟨⟨a, List.mem_range.mp ha⟩, by simp [vList, vLink, han]⟩
  · rintro ⟨a, rfl⟩
    exact (vCode_spec a.2).2

theorem mem_pcodes {n : ℕ} : n ∈ (List.range 2080).map pCode ↔
    n < 10000 ∧ n / 4 % 4 < n % 4 ∧ meetsV (plaqOfCode n) = true := by
  rw [pcheck, List.mem_filter, List.mem_range, Bool.and_eq_true, decide_eq_true_eq]

theorem pCode_spec {i : ℕ} (hi : i < 2080) :
    pCode i < 10000 ∧ pCode i / 4 % 4 < pCode i % 4 ∧ meetsV (pPlaq i) = true :=
  mem_pcodes.mp (List.mem_map.mpr ⟨i, List.mem_range.mpr hi, rfl⟩)

theorem pPlaq_inj {i i' : ℕ} (hi : i < 2080) (hi' : i' < 2080) (h : pPlaq i = pPlaq i') : i = i' := by
  have hc := plaqOfCode_inj (pCode_spec hi).1 (pCode_spec hi').1 h
  have hnd : ((List.range 2080).map pCode).Nodup := by
    rw [pcheck]; exact List.nodup_range.filter _
  exact List.inj_on_of_nodup_map hnd (List.mem_range.mpr hi) (List.mem_range.mpr hi') hc

/-- **The plaquettes meeting `V` are enumerated by `pPlaq`.** -/
theorem plaq_spec (p : Plaq) : (p.2.1 < p.2.2 ∧ meetsV p = true) ↔ ∃ i : Fin 2080, pPlaq i = p := by
  constructor
  · rintro ⟨hlt, h⟩
    obtain ⟨n, hn, rfl⟩ := exists_plaqCode p (base_of_meetsV h)
    have hlt' : n / 4 % 4 < n % 4 := by simpa [plaqOfCode, Fin.lt_def] using hlt
    obtain ⟨i, hi, hin⟩ := List.mem_map.mp (mem_pcodes.mpr ⟨hn, hlt', h⟩)
    exact ⟨⟨i, List.mem_range.mp hi⟩, by simp [pPlaq, hin]⟩
  · rintro ⟨i, rfl⟩
    obtain ⟨-, h1, h2⟩ := pCode_spec i.2
    exact ⟨by simpa [pPlaq, plaqOfCode, Fin.lt_def] using h1, h2⟩

theorem pPlaq_injective : Function.Injective (fun i : Fin 2080 => pPlaq i) :=
  fun i i' h => Fin.ext (pPlaq_inj i.2 i'.2 h)

theorem eLink_spec {e : ℕ} (he : e < 1668) :
    eCode e < 5184 ∧ isTree (eLink e) = false ∧ inV (eLink e) = false := by
  have h := (allBelow_iff.mp echeck) e he
  simp only [Bool.and_eq_true, decide_eq_true_eq, Bool.not_eq_eq_eq_not, Bool.not_true] at h
  exact ⟨h.1.1, h.1.2, h.2⟩

theorem eCode_lt_of_lt {e e' : ℕ} (h : e < e') (he' : e' < 1668) : eCode e < eCode e' := by
  induction e' with
  | zero => omega
  | succ e' ih =>
    have hs : eCode e' < eCode (e' + 1) := by
      simpa using (allBelow_iff.mp esorted) e' (by omega)
    rcases Nat.lt_succ_iff_lt_or_eq.mp h with h' | h'
    · exact (ih h' (by omega)).trans hs
    · subst h'; exact hs

theorem eLink_inj {e e' : ℕ} (he : e < 1668) (he' : e' < 1668) (h : eLink e = eLink e') : e = e' := by
  have hc := linkOfCode_inj (eLink_spec he).1 (eLink_spec he').1 h
  rcases lt_trichotomy e e' with h1 | h1 | h1
  · exact absurd hc (eCode_lt_of_lt h1 he').ne
  · exact h1
  · exact absurd hc.symm (eCode_lt_of_lt h1 he).ne

theorem codeOK_vList {c : ℕ} {l : Link} (h : codeOK c l = true) (a : Fin 784) :
    vList a = l ↔ c = a := by
  have hV := (vCode_spec a.2).2
  unfold codeOK at h
  split_ifs at h with h1 h2
  · rw [linkEq_iff] at h
    subst h
    exact ⟨fun h' => (vLink_inj a.2 h1 h').symm, fun h' => by rw [h']; rfl⟩
  · rw [linkEq_iff] at h
    subst h
    refine ⟨fun h' => ?_, fun h' => by omega⟩
    have := (eLink_spec (show c - 784 < 1668 by omega)).2.2
    rw [vList] at h'
    rw [h'] at hV
    rw [hV] at this
    exact absurd this (by decide)
  · simp only [Bool.and_eq_true, decide_eq_true_eq] at h
    refine ⟨fun h' => ?_, fun h' => by omega⟩
    rw [vList] at h'
    rw [h', inV, h.2] at hV
    simp at hV

theorem codeOK_eLink {c : ℕ} {l : Link} (h : codeOK c l = true) {e : ℕ} (he : e < 1668) :
    eLink e = l ↔ c = 784 + e := by
  have hE := eLink_spec he
  unfold codeOK at h
  split_ifs at h with h1 h2
  · rw [linkEq_iff] at h
    subst h
    refine ⟨fun h' => ?_, fun h' => by omega⟩
    have := (vCode_spec h1).2
    rw [← h', hE.2.2] at this
    exact absurd this (by decide)
  · rw [linkEq_iff] at h
    subst h
    refine ⟨fun h' => ?_, fun h' => by rw [h', Nat.add_sub_cancel_left]⟩
    have := eLink_inj he (show c - 784 < 1668 by omega) h'
    omega
  · simp only [Bool.and_eq_true, decide_eq_true_eq] at h
    refine ⟨fun h' => ?_, fun h' => by omega⟩
    rw [h', h.2] at hE
    exact absurd hE.2.1 (by decide)

theorem codeOK_ne {c : ℕ} {l j : Link} (h : codeOK c l = true) (hjt : isTree j = false)
    (hjV : inV j = false) (hje : ∀ e < 1668, eLink e ≠ j) : l ≠ j := by
  rintro rfl
  unfold codeOK at h
  split_ifs at h with h1 h2
  · rw [linkEq_iff] at h
    rw [← h, (vCode_spec h1).2] at hjV
    exact absurd hjV (by decide)
  · rw [linkEq_iff] at h
    exact hje (c - 784) (by omega) h
  · simp only [Bool.and_eq_true, decide_eq_true_eq] at h
    rw [h.2] at hjt
    exact absurd hjt (by decide)

theorem pslot_ok {i : ℕ} (hi : i < 2080) (k : Fin 4) :
    codeOK (ps i k) (plaqLink (pPlaq i) k) = true := by
  have h := (allBelow_iff.mp pslotCheck) i hi
  rw [List.all_eq_true] at h
  exact h k (mem_dirs k)

theorem aslot_ok {r s : ℕ} (hr : r < 64) (hs : s < 32) : codeOK (asl r s) (avgLink r s) = true :=
  (allBelow_iff.mp ((allBelow_iff.mp aslotCheck) r hr)) s hs

end Tables

/-! ## 10. The matrices `D`, `H`, `B`, `f_j`, `g_j` and the problem of `thm:constrainedcube`

`D` is the matrix of the plaquette fields `d_p|_V` (rows: plaquettes meeting `V`), `H = Dᵀ D` is
the matrix of `∑_{p ∩ V ≠ ∅} (dφ)_p²` on `ℝ^V`, `B` is the matrix of the block averages restricted
to `V`, `f_j = Dᵀ d_j` with `d_j` the exterior column of `j`, and `g_j` is minus the coefficients of
`j` in the averages. -/

section Problem

open Matrix

/-- The plaquette rows on `V`: `D_{p a}` = signed coefficient of the link `a` of `V` in `(dφ)_p`. -/
noncomputable def Dm : Matrix (Fin 2080) (Fin 784) ℝ := fun i a =>
  ∑ k : Fin 4, (plaqSign k : ℝ) * if vList a = plaqLink (pPlaq i) k then 1 else 0

/-- The exterior column of the link `j`: its signed coefficient in each `(dφ)_p`. -/
noncomputable def dsrc (j : Link) : Fin 2080 → ℝ := fun i =>
  ∑ k : Fin 4, (plaqSign k : ℝ) * if j = plaqLink (pPlaq i) k then 1 else 0

/-- `H = Dᵀ D`, the matrix of `∑_{p ∩ V ≠ ∅} (dφ)_p²` on `ℝ^V`. -/
noncomputable def Hm : Matrix (Fin 784) (Fin 784) ℝ := Dmᵀ * Dm

/-- `f_j = Dᵀ d_j`, so that `Q(u + δ_j) = ⟨u, H u⟩ + 2 ⟨f_j, u⟩ + Q(δ_j)` (`cubeQ_eq`). -/
noncomputable def fv (j : Link) : Fin 784 → ℝ := Dmᵀ *ᵥ dsrc j

/-- The block averages on `V`: `B_{r a}` = coefficient of the link `a` of `V` in `V_{y,μ}`,
`r = 4 yi + μ`, `y = blockOf yi`. -/
noncomputable def Bm : Matrix (Fin 64) (Fin 784) ℝ := fun r a =>
  (1 / 16) * ∑ m : Fin 16, ((if vList a = (blockSite (blockOf (r / 4)) m, avgDir r) then 1 else 0) +
    (if vList a = (blockSite (blockOf (r / 4)) m + unitVec (avgDir r), avgDir r) then 1 else 0))

/-- `g_j`: minus the coefficients of `j` in the block averages. -/
noncomputable def gv (j : Link) : Fin 64 → ℝ := fun r =>
  -((1 / 16) * ∑ m : Fin 16, ((if j = (blockSite (blockOf (r / 4)) m, avgDir r) then 1 else 0) +
    (if j = (blockSite (blockOf (r / 4)) m + unitVec (avgDir r), avgDir r) then 1 else 0)))

/-- The field on the links given by `u ∈ ℝ^V`, zero off `V`. -/
noncomputable def extV (u : Fin 784 → ℝ) (l : Link) : ℝ := ∑ a, if vList a = l then u a else 0

/-- `δ_j`. -/
noncomputable def delta (j l : Link) : ℝ := if j = l then 1 else 0

/-- **The objective** `Q(φ) = ∑_{p ∩ V ≠ ∅} (dφ)_p²`, the sum over the plaquettes meeting `V`
(`plaq_spec`). -/
noncomputable def cubeQ (φ : Link → ℝ) : ℝ := ∑ i : Fin 2080, dPlaq φ (pPlaq i) ^ 2

/-- **The constraints**: `V_{y,μ}(φ) = 0` for every block `y ∈ W = {0,1}⁴` and every `μ`. -/
def cubeConstr (φ : Link → ℝ) : Prop :=
  ∀ (yi : Fin 16) (μ : Fin 4), blockAvg (blockOf yi) μ φ = 0

/-- **`u` is a constrained minimiser for the exterior link `j`**: `u` minimises `Q(u + δ_j)` over
the `u ∈ ℝ^V` with `V_{y,μ}(u + δ_j) = 0` for every `y ∈ W` and `μ`, that is, `B u = g_j`. -/
def IsCubeMin (j : Link) (u : Fin 784 → ℝ) : Prop :=
  cubeConstr (fun l => extV u l + delta j l) ∧
    ∀ v : Fin 784 → ℝ, cubeConstr (fun l => extV v l + delta j l) →
      cubeQ (fun l => extV u l + delta j l) ≤ cubeQ (fun l => extV v l + delta j l)

theorem dPlaq_add (φ ψ : Link → ℝ) (p : Plaq) :
    dPlaq (fun l => φ l + ψ l) p = dPlaq φ p + dPlaq ψ p := by
  simp only [dPlaq]; ring

theorem dPlaq_extV (u : Fin 784 → ℝ) (i : Fin 2080) : dPlaq (extV u) (pPlaq i) = (Dm *ᵥ u) i := by
  rw [dPlaq_eq_sum]
  simp only [extV, Dm, Matrix.mulVec, dotProduct, Finset.mul_sum, Finset.sum_mul]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun k _ => ?_
  split_ifs <;> ring

theorem dPlaq_delta (j : Link) (i : Fin 2080) : dPlaq (delta j) (pPlaq i) = dsrc j i := by
  rw [dPlaq_eq_sum]; rfl

theorem blockAvg_add (y : Site) (μ : Fin 4) (φ ψ : Link → ℝ) :
    blockAvg y μ (fun l => φ l + ψ l) = blockAvg y μ φ + blockAvg y μ ψ := by
  simp only [blockAvg, ← mul_add, ← Finset.sum_add_distrib]
  congr 1
  refine Finset.sum_congr rfl fun m _ => ?_
  ring

theorem blockAvg_extV (u : Fin 784 → ℝ) (r : Fin 64) :
    blockAvg (blockOf (r / 4)) (avgDir r) (extV u) = (Bm *ᵥ u) r := by
  simp only [blockAvg, extV, Bm, Matrix.mulVec, dotProduct, ← Finset.sum_add_distrib,
    Finset.mul_sum, Finset.sum_mul]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun m _ => Finset.sum_congr rfl fun a _ => ?_
  split_ifs <;> ring

theorem blockAvg_delta (j : Link) (r : Fin 64) :
    blockAvg (blockOf (r / 4)) (avgDir r) (delta j) = -gv j r := by
  simp only [blockAvg, delta, gv, neg_neg]

theorem Hm_symm : Hmᵀ = Hm := by
  simp [Hm, Matrix.transpose_mul]

/-- `∑ᵢ ((D u)ᵢ + dᵢ)² = ⟨u, Dᵀ D u⟩ + 2 ⟨Dᵀ d, u⟩ + ∑ᵢ dᵢ²`. -/
theorem sum_sq_affine {ι π : Type*} [Fintype ι] [Fintype π] (D : Matrix π ι ℝ) (u : ι → ℝ)
    (d : π → ℝ) : ∑ i, ((D *ᵥ u) i + d i) ^ 2 =
      CubeCert.quadObj (Dᵀ * D) (Dᵀ *ᵥ d) u + ∑ i, d i ^ 2 := by
  have h1 : u ⬝ᵥ ((Dᵀ * D) *ᵥ u) = (D *ᵥ u) ⬝ᵥ (D *ᵥ u) := by
    rw [← Matrix.mulVec_mulVec, Matrix.dotProduct_mulVec, Matrix.vecMul_transpose]
  have h2 : (Dᵀ *ᵥ d) ⬝ᵥ u = (D *ᵥ u) ⬝ᵥ d := by
    rw [dotProduct_comm, Matrix.dotProduct_mulVec, Matrix.vecMul_transpose]
  rw [CubeCert.quadObj, h1, h2]
  simp only [dotProduct, ← Finset.sum_add_distrib, Finset.mul_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  ring

/-- **`Q(u + δ_j) = ⟨u, H u⟩ + 2 ⟨f_j, u⟩ + Q(δ_j)`**: the objective differs from
`quadObj H f_j u` by the constant `Q(δ_j)`, independent of `u`. -/
theorem cubeQ_eq (j : Link) (u : Fin 784 → ℝ) :
    cubeQ (fun l => extV u l + delta j l) = CubeCert.quadObj Hm (fv j) u + cubeQ (delta j) := by
  have h : ∀ i : Fin 2080, dPlaq (fun l => extV u l + delta j l) (pPlaq i) = (Dm *ᵥ u) i + dsrc j i :=
    fun i => by rw [dPlaq_add, dPlaq_extV, dPlaq_delta]
  simp only [cubeQ, h, dPlaq_delta]
  exact sum_sq_affine Dm u (dsrc j)

/-- `Q(u) = |D u|²` for `u ∈ ℝ^V`. -/
theorem cubeQ_extV (u : Fin 784 → ℝ) : cubeQ (extV u) = (Dm *ᵥ u) ⬝ᵥ (Dm *ᵥ u) := by
  simp only [cubeQ, dPlaq_extV, dotProduct, sq]

theorem forall_avg_iff (P : Fin 16 → Fin 4 → Prop) :
    (∀ (yi : Fin 16) (μ : Fin 4), P yi μ) ↔
      ∀ r : Fin 64, P ⟨r / 4, by omega⟩ (avgDir r) := by
  constructor
  · intro h r; exact h _ _
  · intro h yi μ
    have := h ⟨4 * yi + μ, by omega⟩
    have e1 : (⟨(4 * (yi : ℕ) + μ) / 4, by omega⟩ : Fin 16) = yi := Fin.ext (by simp; omega)
    have e2 : avgDir (4 * yi + μ) = μ := Fin.ext (by simp [avgDir])
    simpa [e1, e2] using this

/-- **The constraints are `B u = g_j`.** -/
theorem cubeConstr_iff (j : Link) (u : Fin 784 → ℝ) :
    cubeConstr (fun l => extV u l + delta j l) ↔ Bm *ᵥ u = gv j := by
  unfold cubeConstr
  rw [forall_avg_iff (fun yi μ => blockAvg (blockOf yi) μ (fun l => extV u l + delta j l) = 0)]
  simp only [blockAvg_add]
  simp only [blockAvg_extV, blockAvg_delta, funext_iff]
  exact forall_congr' fun r => by constructor <;> intro h <;> linarith

theorem cubeConstr_zero_iff (u : Fin 784 → ℝ) : cubeConstr (extV u) ↔ Bm *ᵥ u = 0 := by
  unfold cubeConstr
  rw [forall_avg_iff (fun yi μ => blockAvg (blockOf yi) μ (extV u) = 0)]
  simp only [blockAvg_extV, funext_iff, Pi.zero_apply]

/-- **The problem as a quadratic program**: `u` is a constrained minimiser of `Q(u + δ_j)` iff it
minimises `⟨u, H u⟩ + 2 ⟨f_j, u⟩` on `{B u = g_j}`. -/
theorem isCubeMin_iff (j : Link) (u : Fin 784 → ℝ) :
    IsCubeMin j u ↔ CubeCert.IsConstrMin Hm (fv j) Bm (gv j) u := by
  simp only [IsCubeMin, CubeCert.IsConstrMin, cubeConstr_iff, cubeQ_eq, add_le_add_iff_right]

end Problem

/-! ## 11. Code form of the matrices

The slot codes turn `D`, `B`, `d_j`, `g_j` into integer arrays (`Dz`, `Bz`) that the kernel
computes with. -/

section Codes

open Matrix

/-- `D` in code form: `Dz i t = ∑_k σ_k [slot k of plaquette i has code t]`. -/
def Dz (i t : ℕ) : ℤ := ∑ k : Fin 4, plaqSign k * if ps i k = t then 1 else 0

/-- `16 B` in code form: `Bz r t = #{s < 32 | slot s of average r has code t}`. -/
def Bz (r t : ℕ) : ℤ := ∑ s ∈ range 32, if asl r s = t then 1 else 0

theorem Dm_eq (i : Fin 2080) (a : Fin 784) : Dm i a = (Dz i a : ℝ) := by
  simp only [Dm, Dz, Int.cast_sum, Int.cast_mul]
  refine Finset.sum_congr rfl fun k _ => ?_
  have h := codeOK_vList (pslot_ok i.2 k) a
  by_cases hk : ps i k = a
  · rw [if_pos (h.mpr hk), if_pos hk]; simp
  · rw [if_neg (fun h' => hk (h.mp h')), if_neg hk]; simp

theorem dsrc_ext {e : ℕ} (he : e < 1668) (i : Fin 2080) : dsrc (eLink e) i = (Dz i (784 + e) : ℝ) := by
  simp only [dsrc, Dz, Int.cast_sum, Int.cast_mul]
  refine Finset.sum_congr rfl fun k _ => ?_
  have h := codeOK_eLink (pslot_ok i.2 k) he
  by_cases hk : ps i k = 784 + e
  · rw [if_pos (h.mpr hk), if_pos hk]; simp
  · rw [if_neg (fun h' => hk (h.mp h')), if_neg hk]; simp

theorem dsrc_other {j : Link} (hjt : isTree j = false) (hjV : inV j = false)
    (hje : ∀ e < 1668, eLink e ≠ j) (i : Fin 2080) : dsrc j i = 0 := by
  simp only [dsrc]
  refine Finset.sum_eq_zero fun k _ => ?_
  rw [if_neg (fun h => codeOK_ne (pslot_ok i.2 k) hjt hjV hje h.symm), mul_zero]

theorem avgLink_even (r m : ℕ) :
    avgLink r (2 * m) = (blockSite (blockOf (r / 4)) m, avgDir r) := by
  simp [avgLink]

theorem avgLink_odd (r m : ℕ) :
    avgLink r (2 * m + 1) = (blockSite (blockOf (r / 4)) m + unitVec (avgDir r), avgDir r) := by
  simp only [avgLink]
  rw [if_neg (by omega)]
  congr 3
  omega

theorem sum_pairs (F : ℕ → ℝ) (n : ℕ) :
    ∑ m ∈ range n, (F (2 * m) + F (2 * m + 1)) = ∑ s ∈ range (2 * n), F s := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [sum_range_succ, ih, show 2 * (n + 1) = 2 * n + 1 + 1 by ring, sum_range_succ,
      sum_range_succ]
    ring

theorem Bm_eq (r : Fin 64) (a : Fin 784) : Bm r a = (Bz r a : ℝ) / 16 := by
  have key : ∀ s < 32, (if vList a = avgLink r s then (1 : ℝ) else 0) =
      ((if asl r s = a then 1 else 0 : ℤ) : ℝ) := by
    intro s hs
    have h := codeOK_vList (aslot_ok r.2 hs) a
    by_cases hk : asl r s = a
    · rw [if_pos (h.mpr hk), if_pos hk]; simp
    · rw [if_neg (fun h' => hk (h.mp h')), if_neg hk]; simp
  simp only [Bm, Bz, Int.cast_sum]
  rw [← sum_pairs (fun s => ((if asl r s = a then 1 else 0 : ℤ) : ℝ)) 16,
    ← Fin.sum_univ_eq_sum_range (fun m => ((if asl r (2 * m) = a then 1 else 0 : ℤ) : ℝ) +
      ((if asl r (2 * m + 1) = a then 1 else 0 : ℤ) : ℝ)) 16]
  rw [one_div, div_eq_inv_mul]
  congr 1
  refine Finset.sum_congr rfl fun m _ => ?_
  rw [← key _ (by omega), ← key _ (by omega), avgLink_even, avgLink_odd]

theorem gv_ext {e : ℕ} (he : e < 1668) (r : Fin 64) : gv (eLink e) r = -(Bz r (784 + e) : ℝ) / 16 := by
  have key : ∀ s < 32, (if eLink e = avgLink r s then (1 : ℝ) else 0) =
      ((if asl r s = 784 + e then 1 else 0 : ℤ) : ℝ) := by
    intro s hs
    have h := codeOK_eLink (aslot_ok r.2 hs) he
    by_cases hk : asl r s = 784 + e
    · rw [if_pos (h.mpr hk), if_pos hk]; simp
    · rw [if_neg (fun h' => hk (h.mp h')), if_neg hk]; simp
  simp only [gv, Bz, Int.cast_sum]
  rw [← sum_pairs (fun s => ((if asl r s = 784 + e then 1 else 0 : ℤ) : ℝ)) 16,
    ← Fin.sum_univ_eq_sum_range (fun m => ((if asl r (2 * m) = 784 + e then 1 else 0 : ℤ) : ℝ) +
      ((if asl r (2 * m + 1) = 784 + e then 1 else 0 : ℤ) : ℝ)) 16]
  rw [neg_div, one_div, div_eq_inv_mul]
  congr 2
  refine Finset.sum_congr rfl fun m _ => ?_
  rw [← key _ (by omega), ← key _ (by omega), avgLink_even, avgLink_odd]

theorem gv_other {j : Link} (hjt : isTree j = false) (hjV : inV j = false)
    (hje : ∀ e < 1668, eLink e ≠ j) (r : Fin 64) : gv j r = 0 := by
  have key : ∀ s < 32, (if j = avgLink r s then (1 : ℝ) else 0) = 0 := fun s hs =>
    if_neg fun h => codeOK_ne (aslot_ok r.2 hs) hjt hjV hje h.symm
  simp only [gv]
  rw [Finset.sum_eq_zero fun (m : Fin 16) _ => by
    rw [← avgLink_even, ← avgLink_odd, key _ (by omega), key _ (by omega), add_zero]]
  simp

end Codes

/-! ## 12. The gap certificate

The data give `48 M` row by row (`mpk`), `N` (`nrow`) and weights `a_p` (`apk`). The kernel checks
the exact identity `M D + N B = I` on `ℝ^V` in packed form (base `2^16`, `gapIdCheck`) and the
weighted Schur test `∑_e A_ep R_e ≤ (2217/100) a_p` with `A = |M|` entrywise, `R_e = ∑_p A_ep a_p`
(base `2^48`, `schurCheck`). -/

section Gap

open Matrix

/-- The position of a slot code in a packed vector: the code itself if it is a link of `V`, `784`
(a junk position) otherwise. -/
def pos (c : ℕ) : ℕ := bif Nat.blt c 784 then c else 784

theorem pos_eq_of_lt {c : ℕ} (h : c < 784) : pos c = c := by
  unfold pos; rw [Nat.blt_eq.mpr h]; rfl

theorem pos_eq_of_ge {c : ℕ} (h : ¬ c < 784) : pos c = 784 := by
  unfold pos
  rw [blt_false h]; rfl

theorem pos_lt (c : ℕ) : pos c < 785 := by
  by_cases h : c < 784
  · rw [pos_eq_of_lt h]; omega
  · rw [pos_eq_of_ge h]; omega

theorem pos_eq_iff (c : ℕ) {t : ℕ} (ht : t < 784) : pos c = t ↔ c = t := by
  by_cases h : c < 784
  · rw [pos_eq_of_lt h]
  · rw [pos_eq_of_ge h]; omega

/-- `|a − b|` in `ℕ`. -/
def absd (a b : ℕ) : ℕ := Nat.add (Nat.sub a b) (Nat.sub b a)

theorem absd_eq (a b : ℕ) : (absd a b : ℤ) = |(a : ℤ) - b| := by
  unfold absd
  rcases le_total a b with h | h
  · rw [show Nat.sub a b = 0 from Nat.sub_eq_zero_of_le h, abs_of_nonpos (by omega)]
    show ((0 + (b - a) : ℕ) : ℤ) = _
    push_cast [h]; ring
  · rw [show Nat.sub b a = 0 from Nat.sub_eq_zero_of_le h, abs_of_nonneg (by omega)]
    show ((a - b + 0 : ℕ) : ℤ) = _
    push_cast [h]; ring

/-- `2^(16 t)`, kernel form. -/
def gpw (t : ℕ) : ℕ := Nat.shiftLeft 1 (Nat.mul 16 t)

theorem gpw_eq (t : ℕ) : gpw t = 2 ^ (16 * t) := by
  show 1 <<< (16 * t) = _
  rw [Nat.shiftLeft_eq, one_mul]

/-- The packed positive slots of plaquette `i` (base `2^16`). -/
def gP (i : ℕ) : ℕ := Nat.add (gpw (pos (ps i 0))) (gpw (pos (ps i 1)))
/-- The packed negative slots of plaquette `i`. -/
def gN (i : ℕ) : ℕ := Nat.add (gpw (pos (ps i 2))) (gpw (pos (ps i 3)))
/-- The packed slots of average `r`. -/
def gB (r : ℕ) : ℕ := nsum 32 (fun s => gpw (pos (asl r s)))

/-- Entry `k` of `48 M`. -/
def mEnt (k : ℕ) : ℕ := dig 19 mpk k
/-- Its plaquette. -/
def mP (k : ℕ) : ℕ := Nat.mod (mEnt k) 4096
/-- Its value plus `64`. -/
def mV (k : ℕ) : ℕ := Nat.div (mEnt k) 4096
/-- The start of row `e`. -/
def mS (e : ℕ) : ℕ := dig 15 mstart e
/-- The length of row `e`. -/
def mLen (e : ℕ) : ℕ := Nat.sub (mS (e + 1)) (mS e)
/-- Row `e` of `N`: `r + 1` if `N_{e r} = 1`, `0` if empty. -/
def nR (e : ℕ) : ℕ := dig 7 nrow e
/-- The weight `a_p`. -/
def aW (p : ℕ) : ℕ := dig 13 apk p

/-- The positive and negative parts of entry `k` of `48 M`. -/
def mpos (k : ℕ) : ℕ := Nat.sub (mV k) 64
def mneg (k : ℕ) : ℕ := Nat.sub 64 (mV k)

/-- Row `e` of `48 M D + 48 N B`, positive part (packed). -/
def GP (e : ℕ) : ℕ :=
  Nat.add (nsum (mLen e) fun i => Nat.add (Nat.mul (mpos (mS e + i)) (gP (mP (mS e + i))))
      (Nat.mul (mneg (mS e + i)) (gN (mP (mS e + i)))))
    (bif Nat.beq (nR e) 0 then 0 else Nat.mul 3 (gB (Nat.sub (nR e) 1)))

/-- Row `e` of `48 M D` negative part plus `48 δ_e` (packed). -/
def GN (e : ℕ) : ℕ :=
  Nat.add (nsum (mLen e) fun i => Nat.add (Nat.mul (mpos (mS e + i)) (gN (mP (mS e + i))))
      (Nat.mul (mneg (mS e + i)) (gP (mP (mS e + i)))))
    (Nat.mul 48 (gpw e))

/-- `∑ |48 M_ep|` over row `e`. -/
def gAbs (e : ℕ) : ℕ := nsum (mLen e) fun i => Nat.add (mpos (mS e + i)) (mneg (mS e + i))

/-- The identity check for row `e`. -/
def gapRowOK (e : ℕ) : Bool :=
  Nat.blt (Nat.add (Nat.mul 2 (gAbs e)) 144) 65536 && Nat.ble (nR e) 64 &&
    allBelow (mLen e) (fun i => Nat.blt (mP (mS e + i)) 2080) &&
    Nat.beq (Nat.mod (GP e) (Nat.shiftLeft 1 (Nat.mul 16 784)))
      (Nat.mod (GN e) (Nat.shiftLeft 1 (Nat.mul 16 784)))

/-- **The identity `M D + N B = I`**, checked row by row. -/
theorem gapIdCheck : allBelow 784 gapRowOK = true := by decide +kernel

/-- `48 R_e = ∑_p |48 M_ep| a_p`. -/
def Rw (e : ℕ) : ℕ := nsum (mLen e) fun i => Nat.mul (absd (mV (mS e + i)) 64) (aW (mP (mS e + i)))

/-- `2^(48 p)`, kernel form. -/
def cpw (p : ℕ) : ℕ := Nat.shiftLeft 1 (Nat.mul 48 p)

/-- The column sums `∑_e |48 M_ep| · 48 R_e`, packed in base `2^48`. -/
def colAcc : ℕ := nsum 784 fun e => forceN (Rw e) fun R => nsum (mLen e) fun i =>
  Nat.mul (Nat.mul (absd (mV (mS e + i)) 64) R) (cpw (mP (mS e + i)))

/-- The total of all column sums (a bound for every digit of `colAcc`). -/
def colTot : ℕ := nsum 784 fun e => forceN (Rw e) fun R => nsum (mLen e) fun i =>
  Nat.mul (absd (mV (mS e + i)) 64) R

/-- **The weighted Schur test**: `100 ∑_e |48 M_ep| 48 R_e ≤ 2217 · 48² · a_p` for every `p`. -/
def schurOK : Bool :=
  Nat.blt colTot (Nat.pow 2 48) &&
    allBelow 2080 fun p => Nat.ble 1 (aW p) && Nat.ble (Nat.mul 100 (dig 48 colAcc p)) (Nat.mul 5107968 (aW p))

theorem schurCheck : schurOK = true := by decide +kernel

end Gap

/-! ## 13. Soundness of the gap checks, and the gap -/

section GapSound

open Matrix

/-- The digits of a packed slot position. -/
theorem pow_pos_npk (K c : ℕ) : 2 ^ (K * pos c) = npk K 785 (fun t => if pos c = t then 1 else 0) :=
  (npk_single (pos_lt c)).symm

/-- The digits of `gP i`. -/
def gPd (i t : ℕ) : ℕ := (if pos (ps i 0) = t then 1 else 0) + (if pos (ps i 1) = t then 1 else 0)
/-- The digits of `gN i`. -/
def gNd (i t : ℕ) : ℕ := (if pos (ps i 2) = t then 1 else 0) + (if pos (ps i 3) = t then 1 else 0)
/-- The digits of `gB r`. -/
def gBd (r t : ℕ) : ℕ := ∑ s ∈ range 32, if pos (asl r s) = t then 1 else 0

theorem gPd_le (i t : ℕ) : gPd i t ≤ 2 := by unfold gPd; split_ifs <;> omega
theorem gNd_le (i t : ℕ) : gNd i t ≤ 2 := by unfold gNd; split_ifs <;> omega
theorem gBd_le (r t : ℕ) : gBd r t ≤ 32 := by
  unfold gBd
  calc ∑ s ∈ range 32, (if pos (asl r s) = t then 1 else 0) ≤ ∑ _s ∈ range 32, 1 :=
        Finset.sum_le_sum fun s _ => by split_ifs <;> omega
    _ = 32 := by simp

theorem gP_eq (i : ℕ) : gP i = npk 16 785 (gPd i) := by
  show gpw (pos (ps i 0)) + gpw (pos (ps i 1)) = _
  rw [gpw_eq, gpw_eq, pow_pos_npk, pow_pos_npk, ← npk_add]; rfl

theorem gN_eq (i : ℕ) : gN i = npk 16 785 (gNd i) := by
  show gpw (pos (ps i 2)) + gpw (pos (ps i 3)) = _
  rw [gpw_eq, gpw_eq, pow_pos_npk, pow_pos_npk, ← npk_add]; rfl

theorem gB_eq (r : ℕ) : gB r = npk 16 785 (gBd r) := by
  rw [gB, nsum_eq]
  simp only [gpw_eq, pow_pos_npk]
  rw [← npk_sum]; rfl

/-- The digits of `GP e`. -/
def WPg (e t : ℕ) : ℕ :=
  (∑ i ∈ range (mLen e), (mpos (mS e + i) * gPd (mP (mS e + i)) t +
    mneg (mS e + i) * gNd (mP (mS e + i)) t)) + (if nR e = 0 then 0 else 3 * gBd (nR e - 1) t)

/-- The digits of `GN e`. -/
def WNg (e t : ℕ) : ℕ :=
  (∑ i ∈ range (mLen e), (mpos (mS e + i) * gNd (mP (mS e + i)) t +
    mneg (mS e + i) * gPd (mP (mS e + i)) t)) + 48 * (if e = t then 1 else 0)

theorem GP_eq (e : ℕ) : GP e = npk 16 785 (WPg e) := by
  have h1 : (nsum (mLen e) fun i => Nat.add (Nat.mul (mpos (mS e + i)) (gP (mP (mS e + i))))
      (Nat.mul (mneg (mS e + i)) (gN (mP (mS e + i))))) =
      npk 16 785 (fun t => ∑ i ∈ range (mLen e), (mpos (mS e + i) * gPd (mP (mS e + i)) t +
        mneg (mS e + i) * gNd (mP (mS e + i)) t)) := by
    rw [nsum_eq, npk_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    show mpos _ * gP _ + mneg _ * gN _ = _
    rw [gP_eq, gN_eq, ← npk_mul, ← npk_mul, ← npk_add]
  have h2 : (bif Nat.beq (nR e) 0 then 0 else Nat.mul 3 (gB (Nat.sub (nR e) 1))) =
      npk 16 785 (fun t => if nR e = 0 then 0 else 3 * gBd (nR e - 1) t) := by
    by_cases h : nR e = 0
    · have hb : Nat.beq (nR e) 0 = true := by rw [h]; rfl
      rw [hb]; simp [h, npk]
    · rw [beq_false h]
      simp only [h, if_false, cond_false]
      show 3 * gB (nR e - 1) = _
      rw [gB_eq, npk_mul]
  show (_ : ℕ) + _ = _
  rw [h1, h2, ← npk_add]; rfl

theorem GN_eq {e : ℕ} (he : e < 784) : GN e = npk 16 785 (WNg e) := by
  have h1 : (nsum (mLen e) fun i => Nat.add (Nat.mul (mpos (mS e + i)) (gN (mP (mS e + i))))
      (Nat.mul (mneg (mS e + i)) (gP (mP (mS e + i))))) =
      npk 16 785 (fun t => ∑ i ∈ range (mLen e), (mpos (mS e + i) * gNd (mP (mS e + i)) t +
        mneg (mS e + i) * gPd (mP (mS e + i)) t)) := by
    rw [nsum_eq, npk_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    show mpos _ * gN _ + mneg _ * gP _ = _
    rw [gP_eq, gN_eq, ← npk_mul, ← npk_mul, ← npk_add]
  have h2 : Nat.mul 48 (gpw e) = npk 16 785 (fun t => 48 * (if e = t then 1 else 0)) := by
    show 48 * gpw e = _
    rw [gpw_eq, ← npk_single (show e < 785 by omega), npk_mul]
  show (_ : ℕ) + _ = _
  rw [h1, h2, ← npk_add]; rfl

theorem gAbs_eq (e : ℕ) : gAbs e = ∑ i ∈ range (mLen e), (mpos (mS e + i) + mneg (mS e + i)) := by
  rw [gAbs, nsum_eq]; rfl

theorem WPg_le (e t : ℕ) : WPg e t ≤ 2 * gAbs e + 96 := by
  unfold WPg
  rw [gAbs_eq, Finset.mul_sum]
  have h1 : ∑ i ∈ range (mLen e), (mpos (mS e + i) * gPd (mP (mS e + i)) t +
      mneg (mS e + i) * gNd (mP (mS e + i)) t) ≤
      ∑ i ∈ range (mLen e), 2 * (mpos (mS e + i) + mneg (mS e + i)) :=
    Finset.sum_le_sum fun i _ => by
      have := gPd_le (mP (mS e + i)) t
      have := gNd_le (mP (mS e + i)) t
      nlinarith
  have h2 : (if nR e = 0 then 0 else 3 * gBd (nR e - 1) t) ≤ 96 := by
    split_ifs
    · omega
    · have := gBd_le (nR e - 1) t; omega
  omega

theorem WNg_le (e t : ℕ) : WNg e t ≤ 2 * gAbs e + 96 := by
  unfold WNg
  rw [gAbs_eq, Finset.mul_sum]
  have h1 : ∑ i ∈ range (mLen e), (mpos (mS e + i) * gNd (mP (mS e + i)) t +
      mneg (mS e + i) * gPd (mP (mS e + i)) t) ≤
      ∑ i ∈ range (mLen e), 2 * (mpos (mS e + i) + mneg (mS e + i)) :=
    Finset.sum_le_sum fun i _ => by
      have := gPd_le (mP (mS e + i)) t
      have := gNd_le (mP (mS e + i)) t
      nlinarith
  have h2 : 48 * (if e = t then 1 else 0) ≤ 96 := by split_ifs <;> omega
  omega

/-- `48 M` in code form: `Mq e p = ∑ (entries of row e at plaquette p)`. -/
def Mq (e p : ℕ) : ℤ := ∑ i ∈ range (mLen e), if mP (mS e + i) = p then ((mV (mS e + i) : ℤ) - 64) else 0

/-- `48 A`, `A ≥ |M|`. -/
def Aq (e p : ℕ) : ℕ := ∑ i ∈ range (mLen e), if mP (mS e + i) = p then absd (mV (mS e + i)) 64 else 0

/-- `N` in code form. -/
def Nq (e r : ℕ) : ℤ := if nR e = r + 1 then 1 else 0

theorem gPd_sub_gNd {i t : ℕ} (ht : t < 784) : (gPd i t : ℤ) - gNd i t = Dz i t := by
  simp only [gPd, gNd, Dz, Fin.sum_univ_four, pos_eq_iff _ ht]
  simp [plaqSign]
  split_ifs <;> simp

theorem gBd_eq {r t : ℕ} (ht : t < 784) : (gBd r t : ℤ) = Bz r t := by
  simp only [gBd, Bz, pos_eq_iff _ ht]
  push_cast
  rfl

theorem mpos_sub_mneg (k : ℕ) : (mpos k : ℤ) - mneg k = (mV k : ℤ) - 64 := by
  show ((mV k - 64 : ℕ) : ℤ) - ((64 - mV k : ℕ) : ℤ) = _
  omega

/-- The facts checked for row `e`. -/
theorem gapRow_facts {e : ℕ} (he : e < 784) :
    2 * gAbs e + 144 < 65536 ∧ nR e ≤ 64 ∧ (∀ i < mLen e, mP (mS e + i) < 2080) ∧
      Nat.mod (GP e) (Nat.shiftLeft 1 (Nat.mul 16 784)) =
        Nat.mod (GN e) (Nat.shiftLeft 1 (Nat.mul 16 784)) := by
  have hrow := (allBelow_iff.mp gapIdCheck) e he
  unfold gapRowOK at hrow
  rw [Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true] at hrow
  obtain ⟨⟨⟨hb, hn⟩, hp⟩, heq⟩ := hrow
  refine ⟨Nat.blt_eq.mp hb, Nat.ble_eq.mp hn, fun i hi => ?_, Nat.eq_of_beq_eq_true heq⟩
  exact Nat.blt_eq.mp ((allBelow_iff.mp hp) i hi)

/-- **The identity, row `e`**: `∑_p 48 M_ep D_pt + 3 ∑_r N_er (16 B)_rt = 48 δ_et`. -/
theorem gap_identity {e t : ℕ} (he : e < 784) (ht : t < 784) :
    ∑ p ∈ range 2080, Mq e p * Dz p t + 3 * ∑ r ∈ range 64, Nq e r * Bz r t =
      48 * (if e = t then 1 else 0) := by
  obtain ⟨hb', hn, hp, heq⟩ := gapRow_facts he
  have hbnd : ∀ t < 785, WPg e t < 2 ^ 16 ∧ WNg e t < 2 ^ 16 := fun t _ =>
    ⟨by have := WPg_le e t; show WPg e t < 65536; omega,
     by have := WNg_le e t; show WNg e t < 65536; omega⟩
  rw [GP_eq, GN_eq he] at heq
  have hm : npk 16 784 (WPg e) = npk 16 784 (WNg e) :=
    (npk_mod' (K := 16) (n := 785) (v := WPg e) (m := 784) (fun t ht => (hbnd t ht).1)
      (by omega)).symm.trans
      (heq.trans (npk_mod' (K := 16) (n := 785) (v := WNg e) (m := 784)
        (fun t ht => (hbnd t ht).2) (by omega)))
  have hdig : WPg e t = WNg e t := by
    have d1 := npk_digit (n := 784) (fun s hs => (hbnd s (by omega)).1) ht
    have d2 := npk_digit (n := 784) (fun s hs => (hbnd s (by omega)).2) ht
    rw [← d1, ← d2, hm]
  have hz : ((WPg e t : ℕ) : ℤ) - WNg e t = 0 := by rw [hdig]; ring
  -- expand the digits
  have hN : ((if nR e = 0 then 0 else 3 * gBd (nR e - 1) t : ℕ) : ℤ) =
      3 * ∑ r ∈ range 64, Nq e r * Bz r t := by
    by_cases h0 : nR e = 0
    · simp [h0, Nq]
    · rw [if_neg h0]
      have : ∑ r ∈ range 64, Nq e r * Bz r t = Bz (nR e - 1) t := by
        simp only [Nq, ite_mul, one_mul, zero_mul]
        rw [Finset.sum_eq_single (nR e - 1)]
        · rw [if_pos (by omega)]
        · intro r _ hr; rw [if_neg (by omega)]
        · intro h; exact absurd (Finset.mem_range.mpr (by omega)) h
      rw [this, ← gBd_eq ht]; push_cast; ring
  have hM : ∑ p ∈ range 2080, Mq e p * Dz p t =
      ∑ i ∈ range (mLen e), ((mV (mS e + i) : ℤ) - 64) * Dz (mP (mS e + i)) t := by
    simp only [Mq, Finset.sum_mul]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun i hi => ?_
    simp only [ite_mul, zero_mul]
    rw [Finset.sum_ite_eq]
    rw [if_pos (Finset.mem_range.mpr (hp i (Finset.mem_range.mp hi)))]
  have e1 : ((WPg e t : ℕ) : ℤ) = (∑ i ∈ range (mLen e), ((mpos (mS e + i) : ℤ) *
      gPd (mP (mS e + i)) t + mneg (mS e + i) * gNd (mP (mS e + i)) t)) +
      3 * ∑ r ∈ range 64, Nq e r * Bz r t := by
    rw [← hN]; simp only [WPg, Nat.cast_add, Nat.cast_sum, Nat.cast_mul]
  have e2 : ((WNg e t : ℕ) : ℤ) = (∑ i ∈ range (mLen e), ((mpos (mS e + i) : ℤ) *
      gNd (mP (mS e + i)) t + mneg (mS e + i) * gPd (mP (mS e + i)) t)) +
      48 * (if e = t then 1 else 0) := by
    simp only [WNg, Nat.cast_add, Nat.cast_sum, Nat.cast_mul]
    split_ifs <;> simp
  have e3 : ∀ i ∈ range (mLen e), ((mpos (mS e + i) : ℤ) * gPd (mP (mS e + i)) t +
      mneg (mS e + i) * gNd (mP (mS e + i)) t) - (mpos (mS e + i) * gNd (mP (mS e + i)) t +
      mneg (mS e + i) * gPd (mP (mS e + i)) t) =
      ((mV (mS e + i) : ℤ) - 64) * Dz (mP (mS e + i)) t := by
    intro i _
    rw [← mpos_sub_mneg, ← gPd_sub_gNd ht]; ring
  have hsum := Finset.sum_congr rfl e3
  rw [Finset.sum_sub_distrib] at hsum
  rw [e1, e2] at hz
  rw [hM, ← hsum]
  linarith

theorem mP_lt {e i : ℕ} (he : e < 784) (hi : i < mLen e) : mP (mS e + i) < 2080 :=
  (gapRow_facts he).2.2.1 i hi

/-- `48 M` as a real matrix, divided by `48`. -/
noncomputable def Mr : Matrix (Fin 784) (Fin 2080) ℝ := fun e p => (Mq e p : ℝ) / 48
/-- `A ≥ |M|` as a real matrix. -/
noncomputable def Ar : Matrix (Fin 784) (Fin 2080) ℝ := fun e p => (Aq e p : ℝ) / 48
/-- `N` as a real matrix. -/
noncomputable def Nr : Matrix (Fin 784) (Fin 64) ℝ := fun e r => (Nq e r : ℝ)

/-- **`M D + N B = I` on `ℝ^V`.** -/
theorem gap_matrix_identity : Mr * Dm + Nr * Bm = 1 := by
  ext e t
  simp only [Matrix.add_apply, Matrix.mul_apply, Mr, Nr, Dm_eq, Bm_eq, Matrix.one_apply]
  have h := gap_identity e.2 t.2
  rw [← Fin.sum_univ_eq_sum_range (fun p => Mq e p * Dz p t),
    ← Fin.sum_univ_eq_sum_range (fun r => Nq e r * Bz r t)] at h
  have h' := congrArg (fun z : ℤ => (z : ℝ)) h
  simp only [Int.cast_add, Int.cast_mul, Int.cast_sum, Int.cast_ofNat] at h'
  have e1 : ∑ p : Fin 2080, (Mq e p : ℝ) / 48 * Dz p t =
      (∑ p : Fin 2080, (Mq e p : ℝ) * Dz p t) / 48 := by
    rw [Finset.sum_div]; exact Finset.sum_congr rfl fun p _ => by ring
  have e2 : ∑ r : Fin 64, (Nq e r : ℝ) * ((Bz r t : ℝ) / 16) =
      (∑ r : Fin 64, (Nq e r : ℝ) * Bz r t) / 16 := by
    rw [Finset.sum_div]; exact Finset.sum_congr rfl fun r _ => by ring
  rw [e1, e2]
  by_cases het : e = t
  · subst het
    simp only [if_true, Int.cast_one] at h' ⊢
    linarith
  · have het' : (e : ℕ) ≠ t := fun h => het (Fin.ext h)
    simp only [het, het', if_false, Int.cast_zero, mul_zero] at h' ⊢
    linarith

theorem absd_real (a b : ℕ) : ((absd a b : ℕ) : ℝ) = |(a : ℝ) - b| := by
  have h := absd_eq a b
  have h' := congrArg (fun z : ℤ => (z : ℝ)) h
  simpa using h'

theorem Mr_le_Ar (e : Fin 784) (p : Fin 2080) : |Mr e p| ≤ Ar e p := by
  simp only [Mr, Ar, abs_div, abs_of_pos (show (0 : ℝ) < 48 by norm_num)]
  refine div_le_div_of_nonneg_right ?_ (by norm_num)
  simp only [Mq, Aq, Int.cast_sum, Nat.cast_sum]
  refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun i _ => ?_)
  split_ifs
  · rw [absd_real]; push_cast; exact le_refl _
  · simp

theorem Rw_eq {e : ℕ} (he : e < 784) :
    (Rw e : ℝ) = ∑ p : Fin 2080, (Aq e p : ℝ) * aW p := by
  rw [Fin.sum_univ_eq_sum_range (fun p => (Aq e p : ℝ) * aW p)]
  have hR : Rw e = ∑ i ∈ range (mLen e), absd (mV (mS e + i)) 64 * aW (mP (mS e + i)) := by
    rw [Rw, nsum_eq]; rfl
  rw [hR]
  simp only [Aq, Nat.cast_sum, Finset.sum_mul]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun i hi => ?_
  simp only [Nat.cast_ite, Nat.cast_zero, ite_mul, zero_mul]
  rw [Finset.sum_ite_eq, if_pos (Finset.mem_range.mpr (mP_lt he (Finset.mem_range.mp hi)))]
  push_cast
  rfl

/-- The digits of `colAcc`. -/
def colD (p : ℕ) : ℕ := ∑ e ∈ range 784, Aq e p * Rw e

theorem colAcc_eq : colAcc = npk 48 2080 colD := by
  have h : ∀ e ∈ range 784, (forceN (Rw e) fun R => nsum (mLen e) fun i =>
      Nat.mul (Nat.mul (absd (mV (mS e + i)) 64) R) (cpw (mP (mS e + i)))) =
      npk 48 2080 (fun p => Aq e p * Rw e) := by
    intro e he
    rw [forceN_eq, nsum_eq]
    have h1 : ∀ i ∈ range (mLen e), Nat.mul (Nat.mul (absd (mV (mS e + i)) 64) (Rw e))
        (cpw (mP (mS e + i))) = npk 48 2080 (fun p => (if mP (mS e + i) = p then
          absd (mV (mS e + i)) 64 else 0) * Rw e) := by
      intro i hi
      have hlt := mP_lt (Finset.mem_range.mp he) (Finset.mem_range.mp hi)
      show absd _ _ * Rw e * cpw _ = _
      have hc : cpw (mP (mS e + i)) = 2 ^ (48 * mP (mS e + i)) := by
        show 1 <<< (48 * _) = _; rw [Nat.shiftLeft_eq, one_mul]
      rw [hc, ← npk_single hlt, ← npk_mul]
      refine npk_congr fun p _ => ?_
      split_ifs <;> ring
    rw [Finset.sum_congr rfl h1, ← npk_sum]
    refine npk_congr fun p _ => ?_
    simp only [Aq, Finset.sum_mul]
  rw [colAcc, nsum_eq, Finset.sum_congr rfl h, ← npk_sum]
  rfl

theorem colD_le (p : ℕ) : colD p ≤ colTot := by
  rw [colTot, nsum_eq]
  refine Finset.sum_le_sum fun e _ => ?_
  rw [forceN_eq, nsum_eq, Aq, Finset.sum_mul]
  refine Finset.sum_le_sum fun i _ => ?_
  split_ifs <;> simp

theorem hcol_cube (p : Fin 2080) :
    ∑ e, Ar e p * ∑ p', Ar e p' * (aW p' : ℝ) ≤ 2217 / 100 * (aW p : ℝ) := by
  have hs := schurCheck
  simp only [schurOK, Bool.and_eq_true, Nat.blt_eq, Nat.ble_eq, allBelow_iff] at hs
  obtain ⟨htot, hp⟩ := hs
  have hdig : dig 48 colAcc p = colD p := by
    rw [colAcc_eq]
    exact dig_npk (fun q _ => lt_of_le_of_lt (colD_le q) htot) p.2
  have hle := (hp p p.2).2
  rw [hdig] at hle
  have hle' : (100 : ℝ) * colD p ≤ 5107968 * aW p := by exact_mod_cast hle
  have e1 : ∀ e : Fin 784, ∑ p', Ar e p' * (aW p' : ℝ) = (Rw e : ℝ) / 48 := by
    intro e
    rw [Rw_eq e.2, Finset.sum_div]
    exact Finset.sum_congr rfl fun q _ => by simp only [Ar]; ring
  have e1' : ∀ e : Fin 784, Ar e p * ∑ p', Ar e p' * (aW p' : ℝ) =
      (Aq e p : ℝ) / 48 * ((Rw e : ℝ) / 48) := fun e => by rw [e1 e]; rfl
  rw [Finset.sum_congr rfl fun e _ => e1' e]
  have e2 : ∑ e : Fin 784, (Aq e p : ℝ) / 48 * ((Rw e : ℝ) / 48) = (colD p : ℝ) / 2304 := by
    rw [colD, Nat.cast_sum, ← Fin.sum_univ_eq_sum_range (fun e => ((Aq e p * Rw e : ℕ) : ℝ)),
      Finset.sum_div]
    exact Finset.sum_congr rfl fun e _ => by push_cast; ring
  rw [e2]
  linarith

theorem aW_pos (p : Fin 2080) : (0 : ℝ) < aW p := by
  have hs := schurCheck
  simp only [schurOK, Bool.and_eq_true, Nat.blt_eq, Nat.ble_eq, allBelow_iff] at hs
  exact_mod_cast (hs.2 p p.2).1

/-- `|x|² ≤ (2217/100) |D x|²` on `ker B`. -/
theorem gap_D (x : Fin 784 → ℝ) (hx : Bm *ᵥ x = 0) :
    x ⬝ᵥ x ≤ 2217 / 100 * ((Dm *ᵥ x) ⬝ᵥ (Dm *ᵥ x)) :=
  schur_gap Dm Bm Mr Ar Nr (fun p => (aW p : ℝ)) gap_matrix_identity Mr_le_Ar aW_pos hcol_cube x hx

theorem dot_Hm (x : Fin 784 → ℝ) : x ⬝ᵥ (Hm *ᵥ x) = (Dm *ᵥ x) ⬝ᵥ (Dm *ᵥ x) := by
  rw [Hm, ← Matrix.mulVec_mulVec, Matrix.dotProduct_mulVec, Matrix.vecMul_transpose]

/-- **The gap of `H` on `ker B`**: `⟨e, H e⟩ ≥ (100/2217) |e|²` whenever `B e = 0`. -/
theorem cube_kerGap : CubeCert.KerGap Hm Bm (100 / 2217) := by
  intro x hx
  have h := gap_D x hx
  rw [dot_Hm]
  calc 100 / 2217 * (x ⬝ᵥ x) ≤ 100 / 2217 * (2217 / 100 * ((Dm *ᵥ x) ⬝ᵥ (Dm *ᵥ x))) :=
        mul_le_mul_of_nonneg_left h (by norm_num)
    _ = (Dm *ᵥ x) ⬝ᵥ (Dm *ᵥ x) := by ring

/-- **`cube_gap`.** For every `e ∈ ℝ^V` whose block averages all vanish (`B e = 0`),
`(100/2217) ∑_{a ∈ V} e_a² ≤ ∑_{p ∩ V ≠ ∅} (d_p|_V e)²`. -/
theorem cube_gap (x : Fin 784 → ℝ) (hx : cubeConstr (extV x)) :
    100 / 2217 * ∑ a, x a ^ 2 ≤ cubeQ (extV x) := by
  have h := cube_kerGap x ((cubeConstr_zero_iff x).mp hx)
  rw [cubeQ_extV, ← dot_Hm]
  have e2 : x ⬝ᵥ x = ∑ a, x a ^ 2 := by simp [dotProduct, sq]
  rw [e2] at h
  exact h

end GapSound

/-! ## 14. The per-link certificate

A class certificate holds `K`, the numerators `Nu` of `ũ = s Nu / 2^K` (offset digits of width
`wU`) and `Lam` of `λ̃ = s Lam / 2^K` (width `wL`). For the exterior link `e` with sign `s`, the
kernel computes `T⁺`, `T⁻` (base `2^56`, positions `< 785`, position `784` collecting the slots off
`V`) whose digits differ by `R_t = 16 · 2^K · r_t`, `r = H ũ + f_j − Bᵀ λ̃`, and checks
(P1) `B ũ = g_j`, (P2) `‖ũ‖₁ ≤ 1248/100`, (P3) `784 (100·2217)² ∑ R_t² ≤ (16·2^K·1248 − 1600 ‖Nu‖₁)² 100²`. -/

section Link

open Matrix

/-- A class certificate. -/
structure Cls where
  /-- the exponent of the scale `2^K` -/
  K : ℕ
  /-- the digit width of `Nu` -/
  wU : ℕ
  /-- `Nu + 2^(wU-1)`, packed -/
  U : ℕ
  /-- the digit width of `Lam` -/
  wL : ℕ
  /-- `Lam + 2^(wL-1)`, packed -/
  L : ℕ

/-- `2^(56 t)`, kernel form. -/
def pw (t : ℕ) : ℕ := Nat.shiftLeft 1 (Nat.mul 56 t)
/-- The offset of `Nu`. -/
def oU (c : Cls) : ℕ := 2 ^ (c.wU - 1)
/-- Digit `a` of the packed `Nu`. -/
def uq (c : Cls) (a : ℕ) : ℕ := dig c.wU c.U a
/-- The digit at slot code `x` (the offset for slots off `V`). -/
def uv (c : Cls) (x : ℕ) : ℕ := bif Nat.blt x 784 then uq c x else oU c
/-- The offset of `Lam`. -/
def oL (c : Cls) : ℕ := 2 ^ (c.wL - 1)
/-- Digit `r` of the packed `Lam`. -/
def lq (c : Cls) (r : ℕ) : ℕ := dig c.wL c.L r
/-- The packed positive slots of plaquette `i` (base `2^56`). -/
def rP (i : ℕ) : ℕ := Nat.add (pw (pos (ps i 0))) (pw (pos (ps i 1)))
/-- The packed negative slots of plaquette `i`. -/
def rN (i : ℕ) : ℕ := Nat.add (pw (pos (ps i 2))) (pw (pos (ps i 3)))
/-- The `Nu` digits on the positive slots. -/
def Xc (c : Cls) (i : ℕ) : ℕ := Nat.add (uv c (ps i 0)) (uv c (ps i 1))
/-- The `Nu` digits on the negative slots. -/
def Yc (c : Cls) (i : ℕ) : ℕ := Nat.add (uv c (ps i 2)) (uv c (ps i 3))
def CP (c : Cls) : ℕ :=
  nsum 2080 fun i => Nat.mul 16 (Nat.add (Nat.mul (Xc c i) (rP i)) (Nat.mul (Yc c i) (rN i)))
def CN (c : Cls) : ℕ :=
  nsum 2080 fun i => Nat.mul 16 (Nat.add (Nat.mul (Xc c i) (rN i)) (Nat.mul (Yc c i) (rP i)))
/-- The packed slots of average `r` (base `2^56`). -/
def bR (r : ℕ) : ℕ := nsum 32 fun s => pw (pos (asl r s))
def LP (c : Cls) : ℕ := nsum 64 fun r => Nat.mul (lq c r) (bR r)
def OL (c : Cls) : ℕ := nsum 64 fun r => Nat.mul (oL c) (bR r)
/-- `[x = y]`, kernel form. -/
def ind (x y : ℕ) : ℕ := bif Nat.beq x y then 1 else 0
def jA (J i : ℕ) : ℕ := Nat.add (ind (ps i 0) J) (ind (ps i 1) J)
def jB (J i : ℕ) : ℕ := Nat.add (ind (ps i 2) J) (ind (ps i 3) J)
def JP (c : Cls) (J : ℕ) : ℕ :=
  16 * 2 ^ c.K * nsum 2080 fun i => Nat.add (Nat.mul (jA J i) (rP i)) (Nat.mul (jB J i) (rN i))
def JN (c : Cls) (J : ℕ) : ℕ :=
  16 * 2 ^ c.K * nsum 2080 fun i => Nat.add (Nat.mul (jA J i) (rN i)) (Nat.mul (jB J i) (rP i))
/-- `T⁺`. -/
def Tp (c : Cls) (J : ℕ) (s : Bool) : ℕ :=
  bif s then CP c + OL c + JP c J else CN c + LP c + JP c J
/-- `T⁻`. -/
def Tn (c : Cls) (J : ℕ) (s : Bool) : ℕ :=
  bif s then CN c + LP c + JN c J else CP c + OL c + JN c J
/-- `(a − b)²` in `ℕ`. -/
def sqd (a b : ℕ) : ℕ := Nat.mul (absd a b) (absd a b)
/-- `∑_t R_t²`. -/
def S2 (c : Cls) (J : ℕ) (s : Bool) : ℕ :=
  forceN (Tp c J s) fun A => forceN (Tn c J s) fun B => nsum 784 fun t => sqd (dig 56 A t) (dig 56 B t)
/-- `‖Nu‖₁`. -/
def l1N (c : Cls) : ℕ := nsum 784 fun a => absd (uq c a) (oU c)
/-- A bound for every digit of `T⁺` and `T⁻`. -/
def bnd (c : Cls) (J : ℕ) : ℕ :=
  32 * ((nsum 2080 fun i => Nat.add (Xc c i) (Yc c i)) + (nsum 64 fun r => Nat.add (lq c r) (oL c)) +
    2 ^ c.K * nsum 2080 fun i => Nat.add (jA J i) (jB J i))
def avgS (c : Cls) (r : ℕ) : ℕ := nsum 32 fun s => uv c (asl r s)
def avgJ (J r : ℕ) : ℕ := nsum 32 fun s => ind (asl r s) J
/-- (P1) `B ũ = g_j`, row by row. -/
def P1 (c : Cls) (J : ℕ) (s : Bool) : Bool :=
  allBelow 64 fun r => bif s
    then Nat.beq (avgS c r + 2 ^ c.K * avgJ J r) (32 * oU c)
    else Nat.beq (avgS c r) (32 * oU c + 2 ^ c.K * avgJ J r)

/-- **The certificate check for the exterior link `e`** with sign `s` and class `c`. -/
def linkOK (e : ℕ) (s : Bool) (c : Cls) : Bool :=
  Nat.blt e 1668 && Nat.ble 1 c.wU && Nat.ble 1 c.wL && P1 c (784 + e) s &&
    Nat.ble (100 * l1N c) (1248 * 2 ^ c.K) && Nat.blt (bnd c (784 + e)) (2 ^ 56) &&
    Nat.ble (38534297760000 * S2 c (784 + e) s)
      ((19968 * 2 ^ c.K - 1600 * l1N c) * (19968 * 2 ^ c.K - 1600 * l1N c) * 10000)

/-- All links of a batch pass. -/
def batchOK (L : List (ℕ × Bool × Cls)) : Bool := L.all fun x => linkOK x.1 x.2.1 x.2.2

theorem batchOK_mem {L : List (ℕ × Bool × Cls)} (h : batchOK L = true) :
    ∀ x ∈ L, linkOK x.1 x.2.1 x.2.2 = true := by
  unfold batchOK at h
  rw [List.all_eq_true] at h
  exact h

theorem forall_mem_append {P : ℕ × Bool × Cls → Prop} {L₁ L₂ : List (ℕ × Bool × Cls)}
    (h₁ : ∀ x ∈ L₁, P x) (h₂ : ∀ x ∈ L₂, P x) : ∀ x ∈ L₁ ++ L₂, P x := by
  intro x hx
  rcases List.mem_append.mp hx with h | h
  · exact h₁ x h
  · exact h₂ x h

/-! ### Soundness -/

/-- The numerators `Nu`. -/
def nuZ (c : Cls) (a : ℕ) : ℤ := (uq c a : ℤ) - oU c
/-- The numerators `Lam`. -/
def lamZ (c : Cls) (r : ℕ) : ℤ := (lq c r : ℤ) - oL c

theorem ind_eq (x y : ℕ) : ind x y = if x = y then 1 else 0 := by
  unfold ind
  by_cases h : x = y
  · rw [if_pos h, h, show Nat.beq y y = true from Nat.beq_refl y]; rfl
  · rw [if_neg h, beq_false h]; rfl

theorem uv_sub (c : Cls) (x : ℕ) :
    (uv c x : ℤ) - oU c = ∑ a ∈ range 784, if x = a then nuZ c a else 0 := by
  unfold uv
  by_cases hx : x < 784
  · rw [Nat.blt_eq.mpr hx, Finset.sum_ite_eq, if_pos (Finset.mem_range.mpr hx)]; rfl
  · rw [blt_false hx, Finset.sum_eq_zero fun a ha => if_neg (by
      have := Finset.mem_range.mp ha; omega)]
    show ((oU c : ℕ) : ℤ) - oU c = 0
    ring

theorem Dz_four (i t : ℕ) : Dz i t = (if ps i 0 = t then 1 else 0) + (if ps i 1 = t then 1 else 0) -
    (if ps i 2 = t then 1 else 0) - (if ps i 3 = t then 1 else 0) := by
  simp only [Dz, Fin.sum_univ_four]
  simp [plaqSign]
  split_ifs <;> norm_num

theorem XY_eq (c : Cls) (i : ℕ) :
    (Xc c i : ℤ) - Yc c i = ∑ a ∈ range 784, Dz i a * nuZ c a := by
  have h : ∑ a ∈ range 784, Dz i a * nuZ c a = ((uv c (ps i 0) : ℤ) - oU c) +
      ((uv c (ps i 1) : ℤ) - oU c) - ((uv c (ps i 2) : ℤ) - oU c) - ((uv c (ps i 3) : ℤ) - oU c) := by
    simp only [uv_sub, Dz_four, sub_mul, add_mul, ite_mul, one_mul, zero_mul, Finset.sum_sub_distrib,
      Finset.sum_add_distrib]
  rw [h]
  show ((uv c (ps i 0) + uv c (ps i 1) : ℕ) : ℤ) - ((uv c (ps i 2) + uv c (ps i 3) : ℕ) : ℤ) = _
  push_cast; ring

theorem jAB_eq (J i : ℕ) : (jA J i : ℤ) - jB J i = Dz i J := by
  rw [Dz_four]
  show ((ind (ps i 0) J + ind (ps i 1) J : ℕ) : ℤ) - ((ind (ps i 2) J + ind (ps i 3) J : ℕ) : ℤ) = _
  simp only [ind_eq]
  push_cast
  split_ifs <;> simp

theorem pw_pos (c : ℕ) : pw (pos c) = npk 56 785 (fun t => if pos c = t then 1 else 0) := by
  rw [pw, shl_one]; exact pow_pos_npk 56 c

theorem rP_eq (i : ℕ) : rP i = npk 56 785 (gPd i) := by
  show pw (pos (ps i 0)) + pw (pos (ps i 1)) = _
  rw [pw_pos, pw_pos, ← npk_add]; rfl

theorem rN_eq (i : ℕ) : rN i = npk 56 785 (gNd i) := by
  show pw (pos (ps i 2)) + pw (pos (ps i 3)) = _
  rw [pw_pos, pw_pos, ← npk_add]; rfl

theorem bR_eq (r : ℕ) : bR r = npk 56 785 (gBd r) := by
  rw [bR, nsum_eq]
  simp only [pw_pos]
  rw [← npk_sum]; rfl

/-- The digits of the class and link parts. -/
def CPd (c : Cls) (t : ℕ) : ℕ := ∑ i ∈ range 2080, 16 * (Xc c i * gPd i t + Yc c i * gNd i t)
def CNd (c : Cls) (t : ℕ) : ℕ := ∑ i ∈ range 2080, 16 * (Xc c i * gNd i t + Yc c i * gPd i t)
def LPd (c : Cls) (t : ℕ) : ℕ := ∑ r ∈ range 64, lq c r * gBd r t
def OLd (c : Cls) (t : ℕ) : ℕ := ∑ r ∈ range 64, oL c * gBd r t
def JPd (c : Cls) (J t : ℕ) : ℕ := 16 * 2 ^ c.K * ∑ i ∈ range 2080, (jA J i * gPd i t + jB J i * gNd i t)
def JNd (c : Cls) (J t : ℕ) : ℕ := 16 * 2 ^ c.K * ∑ i ∈ range 2080, (jA J i * gNd i t + jB J i * gPd i t)

theorem CP_eq (c : Cls) : CP c = npk 56 785 (CPd c) := by
  rw [CP, nsum_eq]
  have : ∀ i ∈ range 2080, Nat.mul 16 (Nat.add (Nat.mul (Xc c i) (rP i)) (Nat.mul (Yc c i) (rN i))) =
      npk 56 785 (fun t => 16 * (Xc c i * gPd i t + Yc c i * gNd i t)) := fun i _ => by
    show 16 * (Xc c i * rP i + Yc c i * rN i) = _
    rw [rP_eq, rN_eq, ← npk_mul, ← npk_mul, ← npk_add, ← npk_mul]
  rw [Finset.sum_congr rfl this, ← npk_sum]; rfl

theorem CN_eq (c : Cls) : CN c = npk 56 785 (CNd c) := by
  rw [CN, nsum_eq]
  have : ∀ i ∈ range 2080, Nat.mul 16 (Nat.add (Nat.mul (Xc c i) (rN i)) (Nat.mul (Yc c i) (rP i))) =
      npk 56 785 (fun t => 16 * (Xc c i * gNd i t + Yc c i * gPd i t)) := fun i _ => by
    show 16 * (Xc c i * rN i + Yc c i * rP i) = _
    rw [rP_eq, rN_eq, ← npk_mul, ← npk_mul, ← npk_add, ← npk_mul]
  rw [Finset.sum_congr rfl this, ← npk_sum]; rfl

theorem LP_eq (c : Cls) : LP c = npk 56 785 (LPd c) := by
  rw [LP, nsum_eq]
  have : ∀ r ∈ range 64, Nat.mul (lq c r) (bR r) = npk 56 785 (fun t => lq c r * gBd r t) :=
    fun r _ => by show lq c r * bR r = _; rw [bR_eq, ← npk_mul]
  rw [Finset.sum_congr rfl this, ← npk_sum]; rfl

theorem OL_eq (c : Cls) : OL c = npk 56 785 (OLd c) := by
  rw [OL, nsum_eq]
  have : ∀ r ∈ range 64, Nat.mul (oL c) (bR r) = npk 56 785 (fun t => oL c * gBd r t) :=
    fun r _ => by show oL c * bR r = _; rw [bR_eq, ← npk_mul]
  rw [Finset.sum_congr rfl this, ← npk_sum]; rfl

theorem JP_eq (c : Cls) (J : ℕ) : JP c J = npk 56 785 (JPd c J) := by
  rw [JP, nsum_eq]
  have : ∀ i ∈ range 2080, Nat.add (Nat.mul (jA J i) (rP i)) (Nat.mul (jB J i) (rN i)) =
      npk 56 785 (fun t => jA J i * gPd i t + jB J i * gNd i t) := fun i _ => by
    show jA J i * rP i + jB J i * rN i = _
    rw [rP_eq, rN_eq, ← npk_mul, ← npk_mul, ← npk_add]
  rw [Finset.sum_congr rfl this, ← npk_sum, ← npk_mul]; rfl

theorem JN_eq (c : Cls) (J : ℕ) : JN c J = npk 56 785 (JNd c J) := by
  rw [JN, nsum_eq]
  have : ∀ i ∈ range 2080, Nat.add (Nat.mul (jA J i) (rN i)) (Nat.mul (jB J i) (rP i)) =
      npk 56 785 (fun t => jA J i * gNd i t + jB J i * gPd i t) := fun i _ => by
    show jA J i * rN i + jB J i * rP i = _
    rw [rP_eq, rN_eq, ← npk_mul, ← npk_mul, ← npk_add]
  rw [Finset.sum_congr rfl this, ← npk_sum, ← npk_mul]; rfl

/-- The digits of `T⁺` and `T⁻`. -/
def Tpd (c : Cls) (J : ℕ) (s : Bool) (t : ℕ) : ℕ :=
  if s then CPd c t + OLd c t + JPd c J t else CNd c t + LPd c t + JPd c J t
def Tnd (c : Cls) (J : ℕ) (s : Bool) (t : ℕ) : ℕ :=
  if s then CNd c t + LPd c t + JNd c J t else CPd c t + OLd c t + JNd c J t

theorem Tp_true (c : Cls) (J : ℕ) : Tp c J true = CP c + OL c + JP c J := by rw [Tp, cond_true]
theorem Tp_false (c : Cls) (J : ℕ) : Tp c J false = CN c + LP c + JP c J := by
  rw [Tp, cond_false]
theorem Tn_true (c : Cls) (J : ℕ) : Tn c J true = CN c + LP c + JN c J := by rw [Tn, cond_true]
theorem Tn_false (c : Cls) (J : ℕ) : Tn c J false = CP c + OL c + JN c J := by
  rw [Tn, cond_false]

theorem Tp_eq (c : Cls) (J : ℕ) (s : Bool) : Tp c J s = npk 56 785 (Tpd c J s) := by
  cases s
  · rw [Tp_false, CN_eq, LP_eq, JP_eq, ← npk_add, ← npk_add]
    exact npk_congr fun t _ => by simp [Tpd]
  · rw [Tp_true, CP_eq, OL_eq, JP_eq, ← npk_add, ← npk_add]
    exact npk_congr fun t _ => by simp [Tpd]

theorem Tn_eq (c : Cls) (J : ℕ) (s : Bool) : Tn c J s = npk 56 785 (Tnd c J s) := by
  cases s
  · rw [Tn_false, CP_eq, OL_eq, JN_eq, ← npk_add, ← npk_add]
    exact npk_congr fun t _ => by simp [Tnd]
  · rw [Tn_true, CN_eq, LP_eq, JN_eq, ← npk_add, ← npk_add]
    exact npk_congr fun t _ => by simp [Tnd]

theorem bnd_eq (c : Cls) (J : ℕ) : bnd c J = 32 * ((∑ i ∈ range 2080, (Xc c i + Yc c i)) +
    (∑ r ∈ range 64, (lq c r + oL c)) + 2 ^ c.K * ∑ i ∈ range 2080, (jA J i + jB J i)) := by
  rw [bnd, nsum_eq, nsum_eq, nsum_eq]; rfl

theorem CPd_le (c : Cls) (t : ℕ) : CPd c t ≤ 32 * ∑ i ∈ range 2080, (Xc c i + Yc c i) := by
  rw [CPd, Finset.mul_sum]
  exact Finset.sum_le_sum fun i _ => by
    have h1 := Nat.mul_le_mul_left (Xc c i) (gPd_le i t)
    have h2 := Nat.mul_le_mul_left (Yc c i) (gNd_le i t)
    linarith

theorem CNd_le (c : Cls) (t : ℕ) : CNd c t ≤ 32 * ∑ i ∈ range 2080, (Xc c i + Yc c i) := by
  rw [CNd, Finset.mul_sum]
  exact Finset.sum_le_sum fun i _ => by
    have h1 := Nat.mul_le_mul_left (Xc c i) (gNd_le i t)
    have h2 := Nat.mul_le_mul_left (Yc c i) (gPd_le i t)
    linarith

theorem LOd_le (c : Cls) (t : ℕ) : LPd c t + OLd c t ≤ 32 * ∑ r ∈ range 64, (lq c r + oL c) := by
  rw [LPd, OLd, ← Finset.sum_add_distrib, Finset.mul_sum]
  exact Finset.sum_le_sum fun r _ => by
    have h1 := Nat.mul_le_mul_left (lq c r) (gBd_le r t)
    have h2 := Nat.mul_le_mul_left (oL c) (gBd_le r t)
    linarith

theorem JPd_le (c : Cls) (J t : ℕ) :
    JPd c J t ≤ 32 * (2 ^ c.K * ∑ i ∈ range 2080, (jA J i + jB J i)) := by
  have hs : ∑ i ∈ range 2080, (jA J i * gPd i t + jB J i * gNd i t) ≤
      2 * ∑ i ∈ range 2080, (jA J i + jB J i) := by
    rw [Finset.mul_sum]
    exact Finset.sum_le_sum fun i _ => by
      have h1 := Nat.mul_le_mul_left (jA J i) (gPd_le i t)
      have h2 := Nat.mul_le_mul_left (jB J i) (gNd_le i t)
      linarith
  rw [JPd]
  calc 16 * 2 ^ c.K * ∑ i ∈ range 2080, (jA J i * gPd i t + jB J i * gNd i t)
      ≤ 16 * 2 ^ c.K * (2 * ∑ i ∈ range 2080, (jA J i + jB J i)) := Nat.mul_le_mul_left _ hs
    _ = 32 * (2 ^ c.K * ∑ i ∈ range 2080, (jA J i + jB J i)) := by ring

theorem JNd_le (c : Cls) (J t : ℕ) :
    JNd c J t ≤ 32 * (2 ^ c.K * ∑ i ∈ range 2080, (jA J i + jB J i)) := by
  have hs : ∑ i ∈ range 2080, (jA J i * gNd i t + jB J i * gPd i t) ≤
      2 * ∑ i ∈ range 2080, (jA J i + jB J i) := by
    rw [Finset.mul_sum]
    exact Finset.sum_le_sum fun i _ => by
      have h1 := Nat.mul_le_mul_left (jA J i) (gNd_le i t)
      have h2 := Nat.mul_le_mul_left (jB J i) (gPd_le i t)
      linarith
  rw [JNd]
  calc 16 * 2 ^ c.K * ∑ i ∈ range 2080, (jA J i * gNd i t + jB J i * gPd i t)
      ≤ 16 * 2 ^ c.K * (2 * ∑ i ∈ range 2080, (jA J i + jB J i)) := Nat.mul_le_mul_left _ hs
    _ = 32 * (2 ^ c.K * ∑ i ∈ range 2080, (jA J i + jB J i)) := by ring

theorem digits_le (c : Cls) (J : ℕ) (s : Bool) (t : ℕ) :
    Tpd c J s t ≤ bnd c J ∧ Tnd c J s t ≤ bnd c J := by
  have h1 := CPd_le c t
  have h2 := CNd_le c t
  have h3 := LOd_le c t
  have h4 := JPd_le c J t
  have h5 := JNd_le c J t
  rw [bnd_eq]
  cases s
  · simp only [Tpd, Tnd, Bool.false_eq_true, if_false]
    constructor <;> linarith
  · simp only [Tpd, Tnd, if_true]
    constructor <;> linarith

end Link

section LinkSound

open Matrix

/-- **The residual identity**: for `t < 784`, the digit difference is
`σ (16 (Dᵀ D Nu)_t − ((16B)ᵀ Lam)_t) + 16 · 2^K (Dᵀ d_J)_t`, `σ = ±1` the sign. -/
theorem R_eq (c : Cls) (J : ℕ) (s : Bool) {t : ℕ} (ht : t < 784) :
    (Tpd c J s t : ℤ) - Tnd c J s t =
      (if s then 1 else -1) * (16 * ∑ i ∈ range 2080, Dz i t * ∑ a ∈ range 784, Dz i a * nuZ c a -
        ∑ r ∈ range 64, Bz r t * lamZ c r) +
      16 * 2 ^ c.K * ∑ i ∈ range 2080, Dz i t * Dz i J := by
  have hC : (CPd c t : ℤ) - CNd c t =
      16 * ∑ i ∈ range 2080, Dz i t * ∑ a ∈ range 784, Dz i a * nuZ c a := by
    have e : ∑ i ∈ range 2080, ((16 * (Xc c i * gPd i t + Yc c i * gNd i t) : ℕ) : ℤ) -
        ∑ i ∈ range 2080, ((16 * (Xc c i * gNd i t + Yc c i * gPd i t) : ℕ) : ℤ) =
        ∑ i ∈ range 2080, 16 * (Dz i t * ∑ a ∈ range 784, Dz i a * nuZ c a) := by
      rw [← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun i _ => ?_
      push_cast
      rw [← XY_eq, ← gPd_sub_gNd ht]; ring
    simp only [CPd, CNd, Nat.cast_sum]
    rw [e, Finset.mul_sum]
  have hL : (OLd c t : ℤ) - LPd c t = -∑ r ∈ range 64, Bz r t * lamZ c r := by
    simp only [OLd, LPd, lamZ, Nat.cast_sum, Nat.cast_mul, ← Finset.sum_sub_distrib,
      ← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl fun r _ => ?_
    rw [← gBd_eq ht]; ring
  have hJ : (JPd c J t : ℤ) - JNd c J t = 16 * 2 ^ c.K * ∑ i ∈ range 2080, Dz i t * Dz i J := by
    have e : ∑ i ∈ range 2080, ((jA J i * gPd i t + jB J i * gNd i t : ℕ) : ℤ) -
        ∑ i ∈ range 2080, ((jA J i * gNd i t + jB J i * gPd i t : ℕ) : ℤ) =
        ∑ i ∈ range 2080, Dz i t * Dz i J := by
      rw [← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun i _ => ?_
      push_cast
      rw [← gPd_sub_gNd ht, ← jAB_eq J i]; ring
    simp only [JPd, JNd, Nat.cast_mul, Nat.cast_pow, Nat.cast_ofNat, Nat.cast_sum]
    rw [← e]; ring
  cases s
  · simp only [Tpd, Tnd, Bool.false_eq_true, if_false]
    push_cast
    linear_combination (-1 : ℤ) * hC - hL + hJ
  · simp only [Tpd, Tnd, if_true]
    push_cast
    linear_combination hC + hL + hJ

/-- **(P1)**: `σ ((16 B) Nu)_r = −2^K (16 B)_{r J}`. -/
theorem P1_sound {c : Cls} {J : ℕ} {s : Bool} (h : P1 c J s = true) {r : ℕ} (hr : r < 64) :
    (if s then (1 : ℤ) else -1) * ∑ a ∈ range 784, Bz r a * nuZ c a = -(2 ^ c.K * Bz r J) := by
  have h1 := (allBelow_iff.mp h) r hr
  have hS : (avgS c r : ℤ) - 32 * oU c = ∑ a ∈ range 784, Bz r a * nuZ c a := by
    have e1 : (avgS c r : ℤ) - 32 * oU c = ∑ s ∈ range 32, ((uv c (asl r s) : ℤ) - oU c) := by
      rw [avgS, nsum_eq, Finset.sum_sub_distrib]
      push_cast
      simp
    rw [e1]
    simp only [uv_sub, Bz, Finset.sum_mul, ite_mul, one_mul, zero_mul]
    exact Finset.sum_comm
  have hJ : (avgJ J r : ℤ) = Bz r J := by
    rw [avgJ, nsum_eq, Bz]
    push_cast
    simp only [ind_eq]
    push_cast
    rfl
  cases s
  · simp only [cond_false, Nat.beq_eq] at h1
    have h1' : avgS c r = 32 * oU c + 2 ^ c.K * avgJ J r := h1
    have h1'' : (avgS c r : ℤ) = 32 * oU c + 2 ^ c.K * avgJ J r := by exact_mod_cast h1'
    rw [if_neg (by decide), ← hS, ← hJ]
    linarith
  · simp only [cond_true, Nat.beq_eq] at h1
    have h1' : avgS c r + 2 ^ c.K * avgJ J r = 32 * oU c := h1
    have h1'' : (avgS c r : ℤ) + 2 ^ c.K * avgJ J r = 32 * oU c := by exact_mod_cast h1'
    rw [if_pos rfl, ← hS, ← hJ]
    linarith

theorem l1N_eq (c : Cls) : (l1N c : ℤ) = ∑ a ∈ range 784, |nuZ c a| := by
  rw [l1N, nsum_eq]
  push_cast
  exact Finset.sum_congr rfl fun a _ => absd_eq _ _

theorem S2_eq (c : Cls) (J : ℕ) (s : Bool) (hb : bnd c J < 2 ^ 56) :
    (S2 c J s : ℤ) = ∑ t ∈ range 784, ((Tpd c J s t : ℤ) - Tnd c J s t) ^ 2 := by
  rw [S2, forceN_eq, forceN_eq, nsum_eq]
  push_cast
  refine Finset.sum_congr rfl fun t ht => ?_
  have ht' : t < 785 := by have := Finset.mem_range.mp ht; omega
  have hd1 : dig 56 (Tp c J s) t = Tpd c J s t := by
    rw [Tp_eq]; exact dig_npk (fun u _ => lt_of_le_of_lt (digits_le c J s u).1 hb) ht'
  have hd2 : dig 56 (Tn c J s) t = Tnd c J s t := by
    rw [Tn_eq]; exact dig_npk (fun u _ => lt_of_le_of_lt (digits_le c J s u).2 hb) ht'
  show ((absd _ _ * absd _ _ : ℕ) : ℤ) = _
  rw [hd1, hd2]
  push_cast
  rw [absd_eq, ← sq, sq_abs]

end LinkSound

section LinkBound

open Matrix

/-- The certified statement for the link `j`: the constrained minimiser exists, is unique and has
`ℓ¹` norm at most `1248/100`. -/
def LinkBound (j : Link) : Prop :=
  (∃! u, IsCubeMin j u) ∧ ∀ u, IsCubeMin j u → CubeCert.l1 u ≤ 1248 / 100

/-- **A passing link check certifies the link.** -/
theorem link_bound {e : ℕ} {s : Bool} {c : Cls} (h : linkOK e s c = true) :
    e < 1668 ∧ LinkBound (eLink e) := by
  unfold linkOK at h
  rw [Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true,
    Bool.and_eq_true] at h
  obtain ⟨⟨⟨⟨⟨⟨h1, -⟩, -⟩, h4⟩, h5⟩, h6⟩, h7⟩ := h
  have he : e < 1668 := Nat.blt_eq.mp h1
  have h4' : P1 c (784 + e) s = true := h4
  have hP2 : 100 * l1N c ≤ 1248 * 2 ^ c.K := Nat.ble_eq.mp h5
  have hb : bnd c (784 + e) < 2 ^ 56 := Nat.blt_eq.mp h6
  have hP3 : 38534297760000 * S2 c (784 + e) s ≤
      (19968 * 2 ^ c.K - 1600 * l1N c) * (19968 * 2 ^ c.K - 1600 * l1N c) * 10000 :=
    Nat.ble_eq.mp h7
  refine ⟨he, ?_⟩
  set sz : ℤ := if s then 1 else -1 with hsz
  have habs : |sz| = 1 := by rw [hsz]; split_ifs <;> norm_num
  have hK : (0 : ℝ) < 2 ^ c.K := by positivity
  set ut : Fin 784 → ℝ := fun a => (sz : ℝ) * nuZ c a / 2 ^ c.K with hut
  set lt : Fin 64 → ℝ := fun r => (sz : ℝ) * lamZ c r / 2 ^ c.K with hlt
  -- (P1): `B ũ = g_j`
  have hB : Bm *ᵥ ut = gv (eLink e) := by
    funext r
    have hp := P1_sound h4' r.2
    have hp' : (sz : ℝ) * ∑ a : Fin 784, (Bz r a : ℝ) * nuZ c a = -(2 ^ c.K * Bz r (784 + e)) := by
      rw [Fin.sum_univ_eq_sum_range (fun a => (Bz r a : ℝ) * nuZ c a)]
      exact_mod_cast hp
    have e1 : (Bm *ᵥ ut) r = (sz * ∑ a : Fin 784, (Bz r a : ℝ) * nuZ c a) / (16 * 2 ^ c.K) := by
      simp only [Matrix.mulVec, dotProduct, Bm_eq, hut]
      rw [Finset.mul_sum, Finset.sum_div]
      exact Finset.sum_congr rfl fun a _ => by field_simp
    rw [e1, hp', gv_ext he]
    field_simp
  -- the residual
  set rv : Fin 784 → ℝ := Hm *ᵥ ut + fv (eLink e) - Bmᵀ *ᵥ lt with hrv
  set R : Fin 784 → ℤ := fun t => (Tpd c (784 + e) s t : ℤ) - Tnd c (784 + e) s t with hR
  have hRt : ∀ t : Fin 784, ((16 * 2 ^ c.K : ℕ) : ℝ) * rv t = R t := by
    intro t
    have hr := R_eq c (784 + e) s t.2
    simp only [← Fin.sum_univ_eq_sum_range] at hr
    have hr' := congrArg (fun z : ℤ => (z : ℝ)) hr
    simp only [Int.cast_add, Int.cast_mul, Int.cast_sub, Int.cast_sum, Int.cast_pow,
      Int.cast_ofNat] at hr'
    have eH : (Hm *ᵥ ut) t = (sz : ℝ) / 2 ^ c.K *
        ∑ i : Fin 2080, (Dz i t : ℝ) * ∑ a : Fin 784, (Dz i a : ℝ) * nuZ c a := by
      simp only [Hm, Matrix.mulVec, dotProduct, Matrix.mul_apply, Matrix.transpose_apply, Dm_eq,
        hut, Finset.sum_mul, Finset.mul_sum]
      rw [Finset.sum_comm]
      exact Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun a _ => by ring
    have eF : fv (eLink e) t = ∑ i : Fin 2080, (Dz i t : ℝ) * Dz i (784 + e) := by
      simp only [fv, Matrix.mulVec, dotProduct, Matrix.transpose_apply, Dm_eq, dsrc_ext he]
    have eL : (Bmᵀ *ᵥ lt) t = (sz : ℝ) / (16 * 2 ^ c.K) * ∑ r : Fin 64, (Bz r t : ℝ) * lamZ c r := by
      simp only [Matrix.mulVec, dotProduct, Matrix.transpose_apply, Bm_eq, hlt, Finset.mul_sum]
      exact Finset.sum_congr rfl fun r _ => by field_simp
    have hcast : ((if s then (1 : ℤ) else -1 : ℤ) : ℝ) = (sz : ℝ) := by rw [hsz]
    simp only [hcast] at hr'
    simp only [hrv, Pi.add_apply, Pi.sub_apply, eH, eF, eL, hR, Int.cast_sub]
    rw [hr']
    push_cast
    field_simp
    ring
  -- the integer form of (P2), (P3)
  set U : Fin 784 → ℤ := fun a => 16 * sz * nuZ c a with hU
  have hUt : ∀ a, ((16 * 2 ^ c.K : ℕ) : ℝ) * ut a = U a := by
    intro a
    simp only [hut, hU]
    push_cast
    field_simp
  have hsumU : ∑ a : Fin 784, |U a| = 16 * l1N c := by
    rw [l1N_eq, Finset.mul_sum, ← Fin.sum_univ_eq_sum_range (fun a => 16 * |nuZ c a|)]
    refine Finset.sum_congr rfl fun a _ => ?_
    simp only [hU, abs_mul, habs]
    norm_num
  have hsumR : ∑ t : Fin 784, R t ^ 2 = S2 c (784 + e) s := by
    rw [S2_eq c _ s hb,
      ← Fin.sum_univ_eq_sum_range (fun t => ((Tpd c (784 + e) s t : ℤ) - Tnd c (784 + e) s t) ^ 2)]
  have hle : 1600 * l1N c ≤ 19968 * 2 ^ c.K := by linarith
  have hsub : ((19968 * 2 ^ c.K - 1600 * l1N c : ℕ) : ℤ) = 19968 * 2 ^ c.K - 1600 * l1N c := by
    push_cast [Nat.cast_sub hle]; ring
  have hP3' : (38534297760000 : ℤ) * S2 c (784 + e) s ≤
      ((19968 * 2 ^ c.K - 1600 * l1N c : ℕ) : ℤ) * ((19968 * 2 ^ c.K - 1600 * l1N c : ℕ) : ℤ) *
        10000 := by exact_mod_cast hP3
  rw [hsub] at hP3'
  have hh1 : ((100 : ℕ) : ℤ) * ∑ a, |U a| ≤ ((16 * 2 ^ c.K : ℕ) : ℤ) * 1248 := by
    rw [hsumU]; push_cast
    have : (100 : ℤ) * l1N c ≤ 1248 * 2 ^ c.K := by exact_mod_cast hP2
    linarith
  have hh2 : (Fintype.card (Fin 784) : ℤ) * (((100 : ℕ) : ℤ) * ((2217 : ℕ) : ℤ)) ^ 2 *
      ∑ t, R t ^ 2 ≤ (((16 * 2 ^ c.K : ℕ) : ℤ) * 1248 - ((100 : ℕ) : ℤ) * ∑ a, |U a|) ^ 2 * 100 ^ 2 := by
    rw [hsumR, hsumU, Fintype.card_fin]
    push_cast
    linarith [hP3']
  obtain ⟨hc, hcert⟩ := CubeCert.l1_hyps_of_int (ι := Fin 784) (ut := ut) (r := rv)
    (c := 1248 / 100) (γ := 100 / 2217) (S := 16 * 2 ^ c.K) (cd := 100) (γd := 2217) (cn := 1248)
    (γn := 100) (U := U) (R := R) (by positivity) (by norm_num) (by norm_num) hUt hRt
    (by norm_num) (by norm_num) hh1 hh2
  refine ⟨?_, fun u hu => ?_⟩
  · have hex := CubeCert.existsUnique_isConstrMin Hm_symm (by norm_num : (0 : ℝ) < 100 / 2217)
      cube_kerGap (fv (eLink e)) ⟨ut, hB⟩
    obtain ⟨u, hu, huniq⟩ := hex
    exact ⟨u, (isCubeMin_iff _ u).mpr hu, fun v hv => huniq v ((isCubeMin_iff _ v).mp hv)⟩
  · exact CubeCert.l1_le_of_certificate Hm_symm (by norm_num) cube_kerGap
      ((isCubeMin_iff _ u).mp hu) hB rfl hc hcert

end LinkBound

