/-- The face links `((1,0,0,0), 0)` (index 192) and `((1,1,0,0), 0)` (index 240) of `V` have
the same coefficients in all block averages. -/
theorem faceCheck : allBelow 64 (fun r => Nat.beq (avgJ 192 r) (avgJ 240 r)) = true := by
