/-- The uniform law on two points. -/
noncomputable def unif2 : Fin 2 → ℝ := fun _ => 1 / 2

/-- The uniform weights are nonnegative. -/
theorem unif2_nonneg (ω : Fin 2) : 0 ≤ unif2 ω := by unfold unif2; norm_num

/-- `fibre_identity` for the uniform law on two points and `f = (1, −1)`. -/
theorem fibre_identity_example :
    ∑ ω, unif2 ω * ((![1, -1] : Fin 2 → ℝ) ω -
        ∑ ω', unif2 ω' / (∑ ω'', unif2 ω'') * (![1, -1] : Fin 2 → ℝ) ω') ^ 2 =
      1 / 2 * (∑ ω'', unif2 ω'') * ∑ ω, ∑ ω', unif2 ω / (∑ ω'', unif2 ω'') *
        (unif2 ω' / (∑ ω'', unif2 ω'')) *
          ((![1, -1] : Fin 2 → ℝ) ω - (![1, -1] : Fin 2 → ℝ) ω') ^ 2 :=
  fibre_identity unif2 ![1, -1] unif2_nonneg

/-- `pair_representation` for full resampling of the two-point space. -/
theorem pair_representation_example (f : Fin 2 → ℝ) :
    ∑ ω, unif2 ω * (f ω - condExp unif2 (fun _ => ()) f ω) ^ 2 =
      1 / 2 * ∑ η : Unit, margW unif2 (fun _ => ()) η *
        ∑ u, ∑ v, condLaw unif2 (fun _ => ()) η u * condLaw unif2 (fun _ => ()) η v *
          (f u - f v) ^ 2 :=
  pair_representation unif2 unif2_nonneg (fun _ => ()) f

/-- `margW_nonneg` on the two-point space. -/
theorem margW_nonneg_example : 0 ≤ margW unif2 (fun _ => ()) () := margW_nonneg unif2_nonneg _ _

/-- `condLaw_nonneg` on the two-point space. -/
theorem condLaw_nonneg_example : 0 ≤ condLaw unif2 (fun _ => ()) () 0 :=
  condLaw_nonneg unif2_nonneg _ _ _

/-- `norm_pairVec_sq` for one cube (full resampling), `n = 1`. -/
theorem norm_pairVec_sq_example (f : Fin 2 → ℝ) :
    ‖pairVec (H := fun _ : Unit => Unit) 1 unif2 (fun _ _ => ()) f‖ ^ 2 =
      cubeEnergy (H := fun _ : Unit => Unit) 1 unif2 (fun _ _ => ()) f :=
  norm_pairVec_sq one_pos unif2_nonneg _ f

/-- `energy_factorization` with `𝒵 = 𝒱 ⊕ ℋ = ℝ ⊕ ℝ`, `A = I`, `K = 1`. -/
theorem energy_factorization_example (f : ℝ) : f ^ 2 + 0 ≤ 1 * ‖WithLp.toLp 2 (f, (0 : ℝ))‖ ^ 2 :=
  energy_factorization (fun f : ℝ => f ^ 2) (fun _ => 0) (fun f => ‖WithLp.toLp 2 (f, (0 : ℝ))‖ ^ 2)
    (fun f => f) (fun _ => (0 : ℝ)) (fun f => WithLp.toLp 2 (f, (0 : ℝ)))
    (ContinuousLinearMap.id ℝ _) (fun f => by rw [Real.norm_eq_abs, sq_abs])
