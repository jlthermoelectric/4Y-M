/-- `C* = 9` for `λ = 2/9`, `γ = 1`, `χ = 2`: `A = 17/2`, `B = 2`, `D = 1` and
`√(225/4 + 16) = 17/2`. -/
theorem cstar_example : cstar ((2 / 9)⁻¹ + 2 ^ 2 / 1) (2 / 1) 1⁻¹ = 9 := by
  unfold cstar
  rw [show ((2 : ℝ) / 9)⁻¹ + 2 ^ 2 / 1 - 1⁻¹ = 15 / 2 by norm_num,
    show (15 / 2 : ℝ) ^ 2 + 4 * (2 / 1) ^ 2 = (17 / 2) ^ 2 by norm_num,
    Real.sqrt_sq (by norm_num)]
  norm_num

/-- `expand_bridge` with `V = 4`, `H = 9`, `λ = 2/9`, `γ = 1`, `χ = 2`. -/
theorem expand_bridge_example :
    (2 / 9 : ℝ)⁻¹ * 4 + (1 : ℝ)⁻¹ * (√9 + 2 * √4) ^ 2 =
      ((2 / 9)⁻¹ + 2 ^ 2 / 1) * √4 ^ 2 + 2 * (2 / 1) * √4 * √9 + (1 : ℝ)⁻¹ * √9 ^ 2 :=
  expand_bridge (by norm_num)

/-- `√4 = 2`. -/
theorem sqrt_four : √(4 : ℝ) = 2 := by
  rw [show (4 : ℝ) = 2 ^ 2 by norm_num, Real.sqrt_sq (by norm_num)]

/-- `two_level_bound` with `λ = 2/9`, `γ = 1`, `χ = 2` (so `C* = 9`): `Var = 3 ≤ 9`. -/
theorem two_level_bound_example : (3 : ℝ) ≤ cstar ((2 / 9)⁻¹ + 2 ^ 2 / 1) (2 / 1) 1⁻¹ * (1 + 0) :=
  two_level_bound (vbar := 1) (varg := 2) (EB := 4) (by norm_num) (by norm_num) le_rfl
    (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    (by rw [sqrt_four, Real.sqrt_zero, Real.sqrt_one]; norm_num)

/-- Variance of the two-point space (full-resampling energy). -/
noncomputable def twoVar (f : Fin 2 → ℝ) : ℝ :=
  ∑ ω, unif2 ω * (f ω - condExp unif2 (fun _ => ()) f ω) ^ 2

/-- For one cube with trivial exterior and `n = 1`, `ℰ_1` is the variance. -/
theorem cubeEnergy_two (f : Fin 2 → ℝ) :
    cubeEnergy (H := fun _ : Unit => Unit) 1 unif2 (fun _ _ => ()) f = twoVar f := by
  simp [cubeEnergy, twoVar]

/-- `defect_absorption` on the two-point space: `V = H = Var/2`, `C* = 1`, `K = 1/2`, `δ = 1/2`,
so `C* δ = 1/2 < 1` and `ϖ = (1 − 1/2)/(1/2) = 1`. -/
theorem defect_absorption_example (f : Fin 2 → ℝ) :
    (1 - 1 * (1 / 2)) / (1 * (1 / 2)) * twoVar f ≤
      cubeEnergy (H := fun _ : Unit => Unit) 1 unif2 (fun _ _ => ()) f :=
  defect_absorption (V := twoVar f / 2) (H := twoVar f / 2) one_pos (by norm_num) (by linarith)
    (by rw [cubeEnergy_two]; linarith)

/-- `defect_absorption_pos` with `C* = 1`, `K = 1/2`, `δ = 1/2`. -/
