/-!
# The constrained cube coefficient at `n = 4`, kernel-checked

This file certifies, with no floating-point input, the constrained cube problem of
`thm:constrainedcube` (forest paper, `main.tex`) on the cube `n = 4`. A floating-point and exact
rational computation outside Lean proposes integer certificates; the Lean kernel checks them by
evaluating closed computations with `decide +kernel`, and theorems proved once for every valid
certificate turn the checks into statements about real fields on the links.

**The geometry** (Section 7, from `def:blockgauge` and the cube setup of `thm:constrainedcube`).
Sites are `ℤ⁴`. A link `(x, μ)` is a *tree link* if `x_ν` is even for `ν = μ` and every `ν > μ`
(offset `o = x mod 2`, `o_μ = 0` and `o_ν = 0` for `ν > μ`); the other links are *active*, and
fields vanish on tree links. `V` is the set of active links with base in `[0, 4)⁴` (784 links,
`V_spec`), `W = {0,1}⁴` its blocks, and for a block `y` and a direction `μ` the *block average* is
`V_{y,μ}(φ) = (1/16) ∑_{x ∈ 2y + {0,1}⁴} (φ(x, μ) + φ(x + e_μ, μ))` (`blockAvg`). For a plaquette
`(x; μ < ν)`, `(dφ)_p = φ(x,μ) + φ(x+e_μ,ν) − φ(x+e_ν,μ) − φ(x,ν)` (`dPlaq`), and
`Q(φ) = ∑_{p ∩ V ≠ ∅} (dφ)_p²` (`cubeQ`, a sum over the 2080 plaquettes meeting `V`, `plaq_spec`).
For a field `u ∈ ℝ^V` (`Fin 784 → ℝ`, via the enumeration `vList`) and an active link `j ∉ V`,
`IsCubeMin j u` says that `u` minimises `Q(u + δ_j)` among the `u` with `V_{y,μ}(u + δ_j) = 0` for
every `y ∈ W` and every `μ`.

**What is certified.**
* `cube_gap`: for every `e ∈ ℝ^V` with all block averages `V_{y,μ}(e)` zero (that is, `B e = 0`),
  `(100/2217) ∑_{a ∈ V} e_a² ≤ ∑_{p ∩ V ≠ ∅} (d_p|_V e)²`. Equivalently `cube_kerGap`:
  `⟨e, H e⟩ ≥ (100/2217) |e|²` on `ker B`, `H = Dᵀ D` the matrix of `Q` on `ℝ^V`.
* `cube_response`: for every active link `j ∉ V` there is exactly one minimiser `u_j` of
  `Q(u + δ_j)` subject to `V_{y,μ}(u + δ_j) = 0` (`y ∈ W`, all `μ`), and `‖u_j‖₁ ≤ 1248/100`.
  Every active link outside `V` is covered: the 1668 exterior links (`eLink`) by their
  certificates, and every other one because its `f_j` and `g_j` vanish, so `u_j = 0`. The file
  proves that the exterior links are active and outside `V` (`echeck`), and that every active link
  outside `V` in a plaquette meeting `V` or in a block average of `W` is one of them (`codeOK_ne`
  with the slot checks); the converse holds for the data but is neither proved nor needed.
* `cubeQ_eq`: `Q(u + δ_j) = ⟨u, H u⟩ + 2 ⟨f_j, u⟩ + Q(δ_j)`, so `Q(u + δ_j)` differs from
  `quadObj H f_j u` by a constant independent of `u`; `cubeConstr_iff`: the constraints are
  `B u = g_j`, `g_j` minus the coefficients of `j` in the averages.
* Non-vacuity (Section 17): `cube_response_worst` at the link `((2,3,3,−1), 3)` where `‖ũ_j‖₁` is
  largest, `cube_response_far` at a link away from the cube, and `cube_gap_example` at a concrete
  nonzero `e ∈ ker B`.

**What is not certified here.**
* Only `n = 4` is treated.
* The identification `C^c_{V,j} = ‖u_j‖₁` of `thm:constrainedcube` (i) (the Gaussian law and the
  translation argument) is not formalised; only the variational problem is.
* The value `12.48` used in the paper was a floating-point value from [Loc26]. The maximum of
  `‖u_j‖₁` over the exterior links is `12.4723…` in floating point; that value is not proved here,
  only the bound `1248/100`.

**The certificates.**
* *Gap* (Sections 12–13): an exact identity `M D + N B = I` on `ℝ^V` (`48 M` integer, `N` with
  entries `0, 1`), checked in packed form (`gapIdCheck`), and a weighted Schur test with positive
  integer plaquette weights `a_p` (at most `4096` in the data; the file checks `a_p ≥ 1`):
  `∑_e A_ep R_e ≤ (2217/100) a_p`, `A = |M|`,
  `R_e = ∑_p A_ep a_p` (`schurCheck`). The generic lemma `schur_gap` (Cauchy–Schwarz
  `(∑_p M_ep q_p)² ≤ R_e ∑_p A_ep q_p²/a_p`) turns them into the gap.
* *Per link* (Sections 14–16): rational `ũ_j = s Nu/2^K` with `B ũ_j = g_j` exactly, rational
  `λ̃_j = s Lam/2^K`, the residual `r_j = H ũ_j + f_j − Bᵀ λ̃_j`, and the checks
  `‖ũ_j‖₁ ≤ 1248/100`, `784 |r_j|² ≤ (1248/100 − ‖ũ_j‖₁)² (100/2217)²` (`linkOK`). The generic
  layer (Sections 2–4: `existsUnique_isConstrMin`, `gap_sq_mul_dist_le`, `l1_le_of_certificate`)
  gives `‖u_j‖₁ ≤ ‖ũ_j‖₁ + √784 |r_j|/γ ≤ 1248/100`. The sources `(f_j, g_j)` of the 1668 links
  fall into 1116 classes up to sign; the data are stored once per class.
* The geometry tables (Section 8) are checked against the definitions of Section 7: `vcheck`,
  `pcheck` (the lists are exactly the filters of all codes), `echeck`, and the slot codes of every
  plaquette and every average (`pslotCheck`, `aslotCheck`).

The certificate checks (`gapIdCheck`, `schurCheck`, the per-link batch checks and the coverage
checks) use natural numbers only (`Nat.add`, `Nat.shiftRight`, …), with packed vectors in base
`2^K` (`npk`) and lemmas in ordinary notation; the geometry checks also evaluate small `ℤ`,
`Fin`, `List` and `Bool` computations. The file imports Mathlib only; it
declares no axioms, sets no options, and every closed fact is checked by the kernel.
-/

namespace CubeCert

open Finset

/-! ## 1. Generic layer: Sections 2–4 (the constrained minimiser, the error bound, the `ℓ¹` step) -/


/-! ## 2. The constrained minimiser -/

section Minimiser

open Matrix

variable {ι κ : Type*} [Fintype ι]

/-- The objective `Q(u) = ⟨u, H u⟩ + 2 ⟨f, u⟩`. -/
def quadObj (H : Matrix ι ι ℝ) (f u : ι → ℝ) : ℝ := u ⬝ᵥ (H *ᵥ u) + 2 * (f ⬝ᵥ u)

/-- `u` minimises `quadObj H f` over the affine set `{v | B v = g}`. -/
def IsConstrMin (H : Matrix ι ι ℝ) (f : ι → ℝ) (B : Matrix κ ι ℝ) (g : κ → ℝ) (u : ι → ℝ) :
    Prop :=
  B *ᵥ u = g ∧ ∀ v, B *ᵥ v = g → quadObj H f u ≤ quadObj H f v

/-- The gap `γ` of `H` on `ker B`: `γ |e|² ≤ ⟨e, H e⟩` for every `e` with `B e = 0`. -/
def KerGap (H : Matrix ι ι ℝ) (B : Matrix κ ι ℝ) (γ : ℝ) : Prop :=
  ∀ e : ι → ℝ, B *ᵥ e = 0 → γ * (e ⬝ᵥ e) ≤ e ⬝ᵥ (H *ᵥ e)

variable {H : Matrix ι ι ℝ} {B : Matrix κ ι ℝ} {γ : ℝ}

/-- `|v|² ≥ 0`. -/
theorem dot_self_nonneg (v : ι → ℝ) : 0 ≤ v ⬝ᵥ v :=
  Finset.sum_nonneg fun i _ => mul_self_nonneg (v i)

/-- `⟨u, H e⟩ = ⟨e, H u⟩` for symmetric `H`. -/
theorem dotProduct_mulVec_symm (hH : Hᵀ = H) (u e : ι → ℝ) :
    u ⬝ᵥ (H *ᵥ e) = e ⬝ᵥ (H *ᵥ u) := by
  rw [dotProduct_mulVec, ← mulVec_transpose, hH, dotProduct_comm]

/-- **Expansion of the objective**: for symmetric `H`,
`Q(u + e) = Q(u) + 2 ⟨e, H u + f⟩ + ⟨e, H e⟩`. -/
theorem quadObj_add (hH : Hᵀ = H) (f u e : ι → ℝ) :
    quadObj H f (u + e) = quadObj H f u + 2 * (e ⬝ᵥ (H *ᵥ u + f)) + e ⬝ᵥ (H *ᵥ e) := by
  have h1 := dotProduct_mulVec_symm hH u e
  have h2 : f ⬝ᵥ e = e ⬝ᵥ f := dotProduct_comm f e
  simp only [quadObj, mulVec_add, dotProduct_add, add_dotProduct]
  rw [h1, h2]
  ring

/-- **Quadratic growth** away from a feasible stationary point: if `B u = g`,
`⟨e, H u + f⟩ = 0` on `ker B`, and `B v = g`, then `Q(u) + γ |v − u|² ≤ Q(v)`. -/
theorem quadObj_growth (hH : Hᵀ = H) (hgap : KerGap H B γ) {f : ι → ℝ} {g : κ → ℝ}
    {u v : ι → ℝ} (hu : B *ᵥ u = g) (hst : ∀ e, B *ᵥ e = 0 → e ⬝ᵥ (H *ᵥ u + f) = 0)
    (hv : B *ᵥ v = g) :
    quadObj H f u + γ * ((v - u) ⬝ᵥ (v - u)) ≤ quadObj H f v := by
  have he : B *ᵥ (v - u) = 0 := by rw [mulVec_sub, hu, hv, sub_self]
  have hv' : u + (v - u) = v := by abel
  have h := quadObj_add hH f u (v - u)
  rw [hv', hst _ he] at h
  rw [h]
  linarith [hgap _ he]

/-- **Existence of a stationary point** (Lax–Milgram in finite dimension). If `γ > 0` is a gap
of `H` on `ker B`, then for every `u₀` there is `e₀ ∈ ker B` with `⟨e, H (u₀ + e₀) + f⟩ = 0` for
every `e ∈ ker B`. (`H` need not be symmetric here.) -/
theorem exists_stationary (hγ : 0 < γ) (hgap : KerGap H B γ) (f u₀ : ι → ℝ) :
    ∃ e₀, B *ᵥ e₀ = 0 ∧ ∀ e, B *ᵥ e = 0 → e ⬝ᵥ (H *ᵥ (u₀ + e₀) + f) = 0 := by
  set W := LinearMap.ker (Matrix.mulVecLin B) with hW
  have memW : ∀ x : ι → ℝ, x ∈ W ↔ B *ᵥ x = 0 := fun x => by
    rw [hW, LinearMap.mem_ker, Matrix.mulVecLin_apply]
  let T : W →ₗ[ℝ] Module.Dual ℝ W := LinearMap.mk₂ ℝ
    (fun x y : W => (y : ι → ℝ) ⬝ᵥ (H *ᵥ (x : ι → ℝ)))
    (fun x₁ x₂ y => by simp only [Submodule.coe_add, mulVec_add, dotProduct_add])
    (fun c x y => by simp only [Submodule.coe_smul, mulVec_smul, dotProduct_smul, smul_eq_mul])
    (fun x y₁ y₂ => by simp only [Submodule.coe_add, add_dotProduct])
    (fun c x y => by simp only [Submodule.coe_smul, smul_dotProduct, smul_eq_mul])
  let ℓ : Module.Dual ℝ W :=
    { toFun := fun y => -((y : ι → ℝ) ⬝ᵥ (H *ᵥ u₀ + f))
      map_add' := fun y₁ y₂ => by simp only [Submodule.coe_add, add_dotProduct, neg_add]
      map_smul' := fun c y => by
        simp only [Submodule.coe_smul, smul_dotProduct, smul_eq_mul, RingHom.id_apply, mul_neg] }
  have hinj : Function.Injective T := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    have h0 : (x : ι → ℝ) ⬝ᵥ (H *ᵥ (x : ι → ℝ)) = 0 := by
      have := LinearMap.congr_fun hx x
      simpa [T] using this
    have hg := hgap (x : ι → ℝ) ((memW x).1 x.2)
    have hnn := dot_self_nonneg (x : ι → ℝ)
    have hle : (x : ι → ℝ) ⬝ᵥ (x : ι → ℝ) ≤ 0 := by nlinarith
    exact Subtype.ext (dotProduct_self_eq_zero.mp (le_antisymm hle hnn))
  have hsurj : Function.Surjective T :=
    (LinearMap.injective_iff_surjective_of_finrank_eq_finrank
      Subspace.dual_finrank_eq.symm).mp hinj
  obtain ⟨x, hx⟩ := hsurj ℓ
  refine ⟨x, (memW x).1 x.2, fun e he => ?_⟩
  have h : e ⬝ᵥ (H *ᵥ (x : ι → ℝ)) = -(e ⬝ᵥ (H *ᵥ u₀ + f)) := by
    have := LinearMap.congr_fun hx ⟨e, (memW e).2 he⟩
    simpa [T, ℓ] using this
  rw [dotProduct_add] at h
  rw [mulVec_add, dotProduct_add, dotProduct_add]
  linarith

/-- A feasible stationary point is a constrained minimiser (`γ ≥ 0`, `H` symmetric). -/
theorem isConstrMin_of_stationary (hH : Hᵀ = H) (hγ : 0 ≤ γ) (hgap : KerGap H B γ)
    {f : ι → ℝ} {g : κ → ℝ} {u : ι → ℝ} (hu : B *ᵥ u = g)
    (hst : ∀ e, B *ᵥ e = 0 → e ⬝ᵥ (H *ᵥ u + f) = 0) : IsConstrMin H f B g u :=
  ⟨hu, fun v hv => by
    have h1 := quadObj_growth hH hgap hu hst hv
    have h2 := mul_nonneg hγ (dot_self_nonneg (v - u))
    linarith⟩

/-- **Characterisation of the minimiser** (task (a), second half). For symmetric `H` with gap
`γ > 0` on `ker B`, `u` minimises `Q` on `{B u = g}` iff `B u = g` and `⟨e, H u + f⟩ = 0` for
every `e ∈ ker B`. -/
theorem isConstrMin_iff (hH : Hᵀ = H) (hγ : 0 < γ) (hgap : KerGap H B γ) {f : ι → ℝ}
    {g : κ → ℝ} {u : ι → ℝ} :
    IsConstrMin H f B g u ↔ B *ᵥ u = g ∧ ∀ e, B *ᵥ e = 0 → e ⬝ᵥ (H *ᵥ u + f) = 0 := by
  constructor
  · rintro ⟨hu, hmin⟩
    obtain ⟨e₀, he₀, hst⟩ := exists_stationary hγ hgap f u
    have hu' : B *ᵥ (u + e₀) = g := by rw [mulVec_add, hu, he₀, add_zero]
    have h1 := quadObj_growth hH hgap hu' hst hu
    have h2 := hmin _ hu'
    have hnn := dot_self_nonneg (u - (u + e₀))
    have hle : (u - (u + e₀)) ⬝ᵥ (u - (u + e₀)) ≤ 0 := by nlinarith
    have h0 : u - (u + e₀) = 0 := dotProduct_self_eq_zero.mp (le_antisymm hle hnn)
    have hue : u + e₀ = u := (sub_eq_zero.mp h0).symm
    refine ⟨hu, fun e he => ?_⟩
    have := hst e he
    rwa [hue] at this
  · rintro ⟨hu, hst⟩
    exact isConstrMin_of_stationary hH hγ.le hgap hu hst

/-- **Existence and uniqueness of the constrained minimiser** (task (a)). If `H` is symmetric,
`⟨e, H e⟩ ≥ γ |e|²` on `ker B` with `γ > 0`, and some `u₀` has `B u₀ = g`, then `Q` has exactly
one minimiser on `{u | B u = g}`. -/
theorem existsUnique_isConstrMin (hH : Hᵀ = H) (hγ : 0 < γ) (hgap : KerGap H B γ)
    (f : ι → ℝ) {g : κ → ℝ} (hfeas : ∃ u₀, B *ᵥ u₀ = g) : ∃! u, IsConstrMin H f B g u := by
  obtain ⟨u₀, hu₀⟩ := hfeas
  obtain ⟨e₀, he₀, hst⟩ := exists_stationary hγ hgap f u₀
  have hu : B *ᵥ (u₀ + e₀) = g := by rw [mulVec_add, hu₀, he₀, add_zero]
  refine ⟨u₀ + e₀, isConstrMin_of_stationary hH hγ.le hgap hu hst, fun v hv => ?_⟩
  have h1 := quadObj_growth hH hgap hu hst hv.1
  have h2 := hv.2 _ hu
  have hnn := dot_self_nonneg (v - (u₀ + e₀))
  have hle : (v - (u₀ + e₀)) ⬝ᵥ (v - (u₀ + e₀)) ≤ 0 := by nlinarith
  exact sub_eq_zero.mp (dotProduct_self_eq_zero.mp (le_antisymm hle hnn))

end Minimiser

/-! ## 3. The error bound -/

section ErrorBound

open Matrix

variable {ι κ : Type*} [Fintype ι] {H : Matrix ι ι ℝ} {B : Matrix κ ι ℝ} {γ : ℝ}

/-- `|γ e − r|² = γ² |e|² − 2 γ ⟨e, r⟩ + |r|²`. -/
theorem dot_smul_sub_self (γ : ℝ) (e r : ι → ℝ) :
    (γ • e - r) ⬝ᵥ (γ • e - r) = γ ^ 2 * (e ⬝ᵥ e) - 2 * γ * (e ⬝ᵥ r) + r ⬝ᵥ r := by
  simp only [sub_dotProduct, dotProduct_sub, smul_dotProduct, dotProduct_smul, smul_eq_mul,
    dotProduct_comm r e]
  ring

/-- **The error bound** (task (b)). Let `H` be symmetric with gap `γ > 0` on `ker B`, `u` the
constrained minimiser, `ũ` feasible (`B ũ = g`), and `r = H ũ + f − Bᵀ λ` for any multiplier
`λ`. Then `γ² |ũ − u|² ≤ |r|²`. (With `e = ũ − u ∈ ker B`: `γ |e|² ≤ ⟨e, H e⟩ = ⟨e, r⟩`.) -/
theorem gap_sq_mul_dist_le [Fintype κ] (hH : Hᵀ = H) (hγ : 0 < γ) (hgap : KerGap H B γ)
    {f : ι → ℝ} {g : κ → ℝ} {u ut r : ι → ℝ} {lam : κ → ℝ} (hu : IsConstrMin H f B g u)
    (hut : B *ᵥ ut = g) (hr : r = H *ᵥ ut + f - Bᵀ *ᵥ lam) :
    γ ^ 2 * ((ut - u) ⬝ᵥ (ut - u)) ≤ r ⬝ᵥ r := by
  obtain ⟨hBu, hst⟩ := (isConstrMin_iff hH hγ hgap).mp hu
  have he : B *ᵥ (ut - u) = 0 := by rw [mulVec_sub, hut, hBu, sub_self]
  have hlam : (ut - u) ⬝ᵥ (Bᵀ *ᵥ lam) = 0 := by
    rw [dotProduct_mulVec, vecMul_transpose, he, zero_dotProduct]
  have e1 : H *ᵥ ut + f = (H *ᵥ u + f) + H *ᵥ (ut - u) := by
    rw [mulVec_sub]; abel
  have her : (ut - u) ⬝ᵥ r = (ut - u) ⬝ᵥ (H *ᵥ (ut - u)) := by
    rw [hr, dotProduct_sub, hlam, sub_zero, e1, dotProduct_add, hst _ he, zero_add]
  have h3 : γ * ((ut - u) ⬝ᵥ (ut - u)) ≤ (ut - u) ⬝ᵥ r := by
    rw [her]; exact hgap _ he
  have hsq := dot_smul_sub_self γ (ut - u) r
  have hnn := dot_self_nonneg (γ • (ut - u) - r)
  have hm := mul_le_mul_of_nonneg_left h3 (by linarith : (0 : ℝ) ≤ 2 * γ)
  nlinarith

end ErrorBound

/-! ## 4. The `ℓ¹` step -/

section L1

open Matrix

variable {ι κ : Type*} [Fintype ι] {H : Matrix ι ι ℝ} {B : Matrix κ ι ℝ} {γ : ℝ}

/-- The `ℓ¹` norm `‖x‖₁ = ∑ᵢ |xᵢ|`. -/
def l1 (x : ι → ℝ) : ℝ := ∑ i, |x i|

theorem l1_nonneg (x : ι → ℝ) : 0 ≤ l1 x := Finset.sum_nonneg fun _ _ => abs_nonneg _

/-- **`ℓ¹` against `ℓ²`** (task (c)): `‖x‖₁² ≤ |ι| · |x|²`. -/
theorem l1_sq_le (x : ι → ℝ) : l1 x ^ 2 ≤ Fintype.card ι * (x ⬝ᵥ x) := by
  have h := sq_sum_le_card_mul_sum_sq (s := (Finset.univ : Finset ι)) (f := fun i => |x i|)
  simp only [Finset.card_univ, sq_abs] at h
  have e : x ⬝ᵥ x = ∑ i, x i ^ 2 := by simp [dotProduct, sq]
  rw [l1, e]
  exact h

/-- `‖x‖₁² ≤ m · |x|²` on `Fin m`. -/
theorem l1_sq_le_fin {m : ℕ} (x : Fin m → ℝ) : l1 x ^ 2 ≤ m * (x ⬝ᵥ x) := by
  simpa using l1_sq_le x

/-- `‖u‖₁ ≤ ‖ũ‖₁ + ‖ũ − u‖₁`. -/
theorem l1_le_add_l1_sub (u ut : ι → ℝ) : l1 u ≤ l1 ut + l1 (ut - u) := by
  unfold l1
  rw [← Finset.sum_add_distrib]
  refine Finset.sum_le_sum fun i _ => ?_
  have := abs_sub_abs_le_abs_sub (u i) (ut i)
  rw [Pi.sub_apply, abs_sub_comm]
  linarith

/-- **The `ℓ¹` step** from an error bound: if `γ > 0`, `γ² |ũ − u|² ≤ |r|²`, `‖ũ‖₁ ≤ c` and
`|ι| |r|² ≤ (c − ‖ũ‖₁)² γ²`, then `‖u‖₁ ≤ c`. -/
theorem l1_le_of_err (hγ : 0 < γ) {u ut r : ι → ℝ} {c : ℝ}
    (herr : γ ^ 2 * ((ut - u) ⬝ᵥ (ut - u)) ≤ r ⬝ᵥ r) (hc : l1 ut ≤ c)
    (hcert : Fintype.card ι * (r ⬝ᵥ r) ≤ (c - l1 ut) ^ 2 * γ ^ 2) : l1 u ≤ c := by
  have h1 := l1_sq_le (ut - u)
  have hd := l1_nonneg (ut - u)
  have hγ2 : 0 < γ ^ 2 := by positivity
  have hcard : (0 : ℝ) ≤ Fintype.card ι := Nat.cast_nonneg _
  have h2 : γ ^ 2 * l1 (ut - u) ^ 2 ≤ γ ^ 2 * (c - l1 ut) ^ 2 := by
    calc γ ^ 2 * l1 (ut - u) ^ 2
        ≤ γ ^ 2 * (Fintype.card ι * ((ut - u) ⬝ᵥ (ut - u))) :=
          mul_le_mul_of_nonneg_left h1 hγ2.le
      _ = Fintype.card ι * (γ ^ 2 * ((ut - u) ⬝ᵥ (ut - u))) := by ring
      _ ≤ Fintype.card ι * (r ⬝ᵥ r) := mul_le_mul_of_nonneg_left herr hcard
      _ ≤ (c - l1 ut) ^ 2 * γ ^ 2 := hcert
      _ = γ ^ 2 * (c - l1 ut) ^ 2 := by ring
  have h3 : l1 (ut - u) ^ 2 ≤ (c - l1 ut) ^ 2 := le_of_mul_le_mul_left h2 hγ2
  have h4 : l1 (ut - u) ≤ c - l1 ut := (sq_le_sq₀ hd (by linarith)).mp h3
  linarith [l1_le_add_l1_sub u ut]

/-- **The certified `ℓ¹` bound** (task (c), combined). Let `H` be symmetric with gap `γ > 0` on
`ker B`, `u` the constrained minimiser of `Q` on `{B u = g}`, `ũ` feasible, `r = H ũ + f − Bᵀ λ`.
If `‖ũ‖₁ ≤ c` and `|ι| |r|² ≤ (c − ‖ũ‖₁)² γ²`, then `‖u‖₁ ≤ c`. -/
theorem l1_le_of_certificate [Fintype κ] (hH : Hᵀ = H) (hγ : 0 < γ) (hgap : KerGap H B γ)
    {f : ι → ℝ} {g : κ → ℝ} {u ut r : ι → ℝ} {lam : κ → ℝ} {c : ℝ} (hu : IsConstrMin H f B g u)
    (hut : B *ᵥ ut = g) (hr : r = H *ᵥ ut + f - Bᵀ *ᵥ lam) (hc : l1 ut ≤ c)
    (hcert : Fintype.card ι * (r ⬝ᵥ r) ≤ (c - l1 ut) ^ 2 * γ ^ 2) : l1 u ≤ c :=
  l1_le_of_err hγ (gap_sq_mul_dist_le hH hγ hgap hu hut hr) hc hcert

/-- **The `ℓ¹` hypotheses from integer data.** Let `S ũ = U` and `S r = R` with integer vectors
`U, R` and `S > 0`, and `cd c = cn`, `γd γ = γn` with `cd, γd > 0`. Then the two integer
inequalities `cd ∑ |Uᵢ| ≤ S cn` and `|ι| (cd γd)² ∑ Rᵢ² ≤ (S cn − cd ∑ |Uᵢ|)² γn²` give the
hypotheses `‖ũ‖₁ ≤ c` and `|ι| |r|² ≤ (c − ‖ũ‖₁)² γ²` of `l1_le_of_certificate`. -/
theorem l1_hyps_of_int {ut r : ι → ℝ} {c : ℝ} {S cd γd : ℕ} {cn γn : ℤ} {U R : ι → ℤ}
    (hS : 0 < S) (hcd : 0 < cd) (hγd : 0 < γd)
    (hU : ∀ i, (S : ℝ) * ut i = U i) (hR : ∀ i, (S : ℝ) * r i = R i)
    (hcn : (cd : ℝ) * c = cn) (hγn : (γd : ℝ) * γ = γn)
    (h1 : (cd : ℤ) * ∑ i, |U i| ≤ S * cn)
    (h2 : (Fintype.card ι : ℤ) * (cd * γd) ^ 2 * ∑ i, R i ^ 2 ≤
      (S * cn - cd * ∑ i, |U i|) ^ 2 * γn ^ 2) :
    l1 ut ≤ c ∧ Fintype.card ι * (r ⬝ᵥ r) ≤ (c - l1 ut) ^ 2 * γ ^ 2 := by
  have hS' : (0 : ℝ) < S := by exact_mod_cast hS
  have hcd' : (0 : ℝ) < cd := by exact_mod_cast hcd
  have hγd' : (0 : ℝ) < γd := by exact_mod_cast hγd
  have hA : ∑ i, |(U i : ℝ)| = S * l1 ut := by
    rw [l1, Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [← hU i, abs_mul, abs_of_pos hS']
  have hB : ∑ i, (R i : ℝ) ^ 2 = S ^ 2 * (r ⬝ᵥ r) := by
    rw [dotProduct, Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [← hR i]
    ring
  have h1' := (Int.cast_le (R := ℝ)).mpr h1
  have h2' := (Int.cast_le (R := ℝ)).mpr h2
  push_cast at h1' h2'
  rw [hA, ← hcn] at h1'
  rw [hA, hB, ← hcn, ← hγn] at h2'
  have hpos : (0 : ℝ) < S * cd := mul_pos hS' hcd'
  refine ⟨le_of_mul_le_mul_left (by linarith) hpos, ?_⟩
  have hpos2 : (0 : ℝ) < (S * cd * γd) ^ 2 := by positivity
  refine le_of_mul_le_mul_left ?_ hpos2
  have e1 : ((S : ℝ) * cd * γd) ^ 2 * (Fintype.card ι * (r ⬝ᵥ r)) =
      Fintype.card ι * (cd * γd) ^ 2 * (S ^ 2 * (r ⬝ᵥ r)) := by ring
  have e2 : ((S : ℝ) * cd * γd) ^ 2 * ((c - l1 ut) ^ 2 * γ ^ 2) =
      (S * (cd * c) - cd * (S * l1 ut)) ^ 2 * (γd * γ) ^ 2 := by ring
  rw [e1, e2]
  exact h2'

end L1


end CubeCert

namespace CubeResp

open Finset

/-! ## 5. The gap from an identity and a weighted Schur test -/

section Schur

open Matrix

variable {ι π ρ : Type*} [Fintype ι] [Fintype π] [Fintype ρ] [DecidableEq ι]

/-- **Weighted Cauchy–Schwarz.** If `|m_p| ≤ A_p` and `a_p > 0`, then
`(∑ m_p q_p)² ≤ (∑ A_p a_p) (∑ A_p q_p² / a_p)`. -/
theorem weighted_cs (m A a q : π → ℝ) (hA : ∀ p, |m p| ≤ A p) (ha : ∀ p, 0 < a p) :
    (∑ p, m p * q p) ^ 2 ≤ (∑ p, A p * a p) * ∑ p, A p * q p ^ 2 / a p := by
  have hA0 : ∀ p, 0 ≤ A p := fun p => (abs_nonneg _).trans (hA p)
  have h1 : |∑ p, m p * q p| ≤ ∑ p, A p * |q p| := by
    refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun p _ => ?_)
    rw [abs_mul]
    exact mul_le_mul_of_nonneg_right (hA p) (abs_nonneg _)
  have h2 : (∑ p, A p * |q p|) ^ 2 ≤ (∑ p, A p * a p) * ∑ p, A p * q p ^ 2 / a p := by
    have key := Finset.sum_mul_sq_le_sq_mul_sq Finset.univ (fun p => Real.sqrt (A p * a p))
      (fun p => Real.sqrt (A p / a p) * |q p|)
    have e1 : ∀ p, Real.sqrt (A p * a p) * (Real.sqrt (A p / a p) * |q p|) = A p * |q p| := by
      intro p
      rw [← mul_assoc, ← Real.sqrt_mul (mul_nonneg (hA0 p) (ha p).le)]
      have hne := (ha p).ne'
      have : A p * a p * (A p / a p) = A p ^ 2 := by
        field_simp
      rw [this, Real.sqrt_sq (hA0 p)]
    have e2 : ∀ p, Real.sqrt (A p * a p) ^ 2 = A p * a p := fun p =>
      Real.sq_sqrt (mul_nonneg (hA0 p) (ha p).le)
    have e3 : ∀ p, (Real.sqrt (A p / a p) * |q p|) ^ 2 = A p * q p ^ 2 / a p := by
      intro p
      rw [mul_pow, Real.sq_sqrt (div_nonneg (hA0 p) (ha p).le), sq_abs]
      ring
    simp only [e1, e2, e3] at key
    exact key
  calc (∑ p, m p * q p) ^ 2 = |∑ p, m p * q p| ^ 2 := (sq_abs _).symm
    _ ≤ (∑ p, A p * |q p|) ^ 2 := pow_le_pow_left₀ (abs_nonneg _) h1 2
    _ ≤ _ := h2

/-- **The gap from an identity and a weighted Schur test.** Let `M D + N B = 1` on `ℝ^ι`, let
`A ≥ |M|` entrywise, `a > 0`, and `∑_e A_ep R_e ≤ C a_p` for every `p`, with `R_e = ∑_p A_ep a_p`.
Then `|x|² ≤ C |D x|²` for every `x` with `B x = 0`. -/
theorem schur_gap (D : Matrix π ι ℝ) (B : Matrix ρ ι ℝ) (M A : Matrix ι π ℝ) (N : Matrix ι ρ ℝ)
    (a : π → ℝ) {C : ℝ} (hid : M * D + N * B = 1) (hA : ∀ e p, |M e p| ≤ A e p)
    (ha : ∀ p, 0 < a p) (hcol : ∀ p, ∑ e, A e p * ∑ p', A e p' * a p' ≤ C * a p)
    (x : ι → ℝ) (hx : B *ᵥ x = 0) : x ⬝ᵥ x ≤ C * ((D *ᵥ x) ⬝ᵥ (D *ᵥ x)) := by
  set q := D *ᵥ x with hq
  have hxq : x = M *ᵥ q := by
    have h := congrArg (fun T => T *ᵥ x) hid
    simp only [Matrix.add_mulVec, Matrix.one_mulVec, ← Matrix.mulVec_mulVec, hx,
      Matrix.mulVec_zero, add_zero] at h
    exact h.symm
  have hrow : ∀ e, x e ^ 2 ≤ (∑ p, A e p * a p) * ∑ p, A e p * q p ^ 2 / a p := by
    intro e
    have h := weighted_cs (M e) (A e) a q (hA e) ha
    have hxe : x e = ∑ p, M e p * q p := by
      conv_lhs => rw [hxq]
      rfl
    rw [hxe]
    exact h
  set R : ι → ℝ := fun e => ∑ p', A e p' * a p' with hR
  calc x ⬝ᵥ x = ∑ e, x e ^ 2 := by simp [dotProduct, sq]
    _ ≤ ∑ e, R e * ∑ p, A e p * q p ^ 2 / a p :=
        Finset.sum_le_sum fun e _ => hrow e
    _ = ∑ p, q p ^ 2 / a p * ∑ e, A e p * R e := by
        simp only [Finset.mul_sum]
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl fun p _ => Finset.sum_congr rfl fun e _ => ?_
        ring
    _ ≤ ∑ p, q p ^ 2 / a p * (C * a p) :=
        Finset.sum_le_sum fun p _ =>
          mul_le_mul_of_nonneg_left (hcol p) (div_nonneg (sq_nonneg _) (ha p).le)
    _ = C * (q ⬝ᵥ q) := by
        simp only [dotProduct, Finset.mul_sum]
        refine Finset.sum_congr rfl fun p _ => ?_
        have hne := (ha p).ne'
        field_simp

end Schur

/-! ## 6. Kernel arithmetic on natural numbers

The functions evaluated by the kernel use the core operations (`Nat.add`, `Nat.shiftRight`, …);
each comes with a lemma in ordinary notation. Vectors are packed into one natural number in base
`2^K` (`npk`). -/

section NatPack

/-- `∑_{i<n} f i`, kernel form. -/
def nsum (n : ℕ) (f : ℕ → ℕ) : ℕ :=
  Nat.rec (motive := fun _ => ℕ) 0 (fun i acc => Nat.add acc (f i)) n

theorem nsum_eq (n : ℕ) (f : ℕ → ℕ) : nsum n f = ∑ i ∈ range n, f i := by
  induction n with
  | zero => rfl
  | succ n ih => rw [sum_range_succ, ← ih]; rfl

/-- `f i = true` for every `i < n`, kernel form. -/
def allBelow (n : ℕ) (f : ℕ → Bool) : Bool :=
  Nat.rec (motive := fun _ => Bool) true (fun i acc => f i && acc) n

theorem allBelow_iff {n : ℕ} {f : ℕ → Bool} : allBelow n f = true ↔ ∀ i < n, f i = true := by
  induction n with
  | zero => simp [allBelow]
  | succ n ih =>
    show (f n && allBelow n f) = true ↔ _
    rw [Bool.and_eq_true, ih]
    constructor
    · rintro ⟨h1, h2⟩ i hi
      rcases Nat.lt_succ_iff_lt_or_eq.mp hi with h | h
      · exact h2 i h
      · subst h; exact h1
    · intro h
      exact ⟨h n (Nat.lt_succ_self n), fun i hi => h i (Nat.lt_succ_of_lt hi)⟩

/-- Forces the evaluation of a natural number before passing it on (kernel evaluation). -/
def forceN {α : Sort*} (z : ℕ) (g : ℕ → α) : α :=
  Nat.casesOn (motive := fun _ => α) z (g 0) (fun k => g (Nat.add k 1))

theorem forceN_eq {α : Sort*} (z : ℕ) (g : ℕ → α) : forceN z g = g z := by
  cases z <;> rfl

theorem blt_false {a b : ℕ} (h : ¬ a < b) : Nat.blt a b = false := by
  cases h' : Nat.blt a b
  · rfl
  · exact absurd (Nat.blt_eq.mp h') h

theorem beq_false {a b : ℕ} (h : a ≠ b) : Nat.beq a b = false := by
  cases h' : Nat.beq a b
  · rfl
  · exact absurd (Nat.eq_of_beq_eq_true h') h

/-- Digit `t` of `P` in base `2^w`, kernel form. -/
def dig (w P t : ℕ) : ℕ := Nat.mod (Nat.shiftRight P (Nat.mul w t)) (Nat.pow 2 w)

theorem dig_eq (w P t : ℕ) : dig w P t = P / 2 ^ (w * t) % 2 ^ w := by
  show P >>> (w * t) % 2 ^ w = _
  rw [Nat.shiftRight_eq_div_pow]

/-- **Packing**: `npk K n v = ∑_{t<n} v t · 2^(K t)`. -/
def npk (K n : ℕ) (v : ℕ → ℕ) : ℕ := ∑ t ∈ range n, v t * 2 ^ (K * t)

theorem npk_succ (K n : ℕ) (v : ℕ → ℕ) : npk K (n + 1) v = npk K n v + v n * 2 ^ (K * n) :=
  sum_range_succ _ _

theorem npk_lt {K : ℕ} : ∀ {n : ℕ} {v : ℕ → ℕ}, (∀ t < n, v t < 2 ^ K) → npk K n v < 2 ^ (K * n)
  | 0, _, _ => by simp [npk]
  | n + 1, v, hv => by
    rw [npk_succ]
    have h1 := npk_lt (n := n) (v := v) (fun t ht => hv t (by omega))
    have h2 : v n + 1 ≤ 2 ^ K := hv n (by omega)
    calc npk K n v + v n * 2 ^ (K * n) < 2 ^ (K * n) + v n * 2 ^ (K * n) := by omega
      _ = (v n + 1) * 2 ^ (K * n) := by ring
      _ ≤ 2 ^ K * 2 ^ (K * n) := Nat.mul_le_mul_right _ h2
      _ = 2 ^ (K * (n + 1)) := by rw [← pow_add]; ring_nf

/-- **Digits of a packed vector**: if every entry is below `2^K`, digit `t` of `npk K n v` is
`v t`. -/
theorem npk_digit {K : ℕ} : ∀ {n : ℕ} {v : ℕ → ℕ}, (∀ t < n, v t < 2 ^ K) → ∀ {t : ℕ}, t < n →
    npk K n v / 2 ^ (K * t) % 2 ^ K = v t
  | 0, _, _, t, ht => absurd ht (Nat.not_lt_zero t)
  | n + 1, v, hv, t, ht => by
    rw [npk_succ]
    have hv' : ∀ s < n, v s < 2 ^ K := fun s hs => hv s (by omega)
    rcases Nat.lt_succ_iff_lt_or_eq.mp ht with h | h
    · obtain ⟨d, rfl⟩ : ∃ d, n = t + 1 + d := ⟨n - t - 1, by omega⟩
      have e : v (t + 1 + d) * 2 ^ (K * (t + 1 + d)) =
          2 ^ (K * t) * (2 ^ K * (v (t + 1 + d) * 2 ^ (K * d))) := by
        rw [show K * (t + 1 + d) = K * t + K + K * d by ring, pow_add, pow_add]
        ring
      rw [e, Nat.add_mul_div_left _ _ (by positivity), Nat.add_mul_mod_self_left]
      exact npk_digit hv' h
    · subst h
      rw [Nat.add_mul_div_right _ _ (by positivity),
        Nat.div_eq_of_lt (npk_lt hv'), zero_add]
      exact Nat.mod_eq_of_lt (hv t (by omega))

/-- **Truncation of a packed vector**: `npk K n v mod 2^(K m) = npk K m v` for `m ≤ n`. -/
theorem npk_mod {K : ℕ} : ∀ {n : ℕ} {v : ℕ → ℕ}, (∀ t < n, v t < 2 ^ K) → ∀ {m : ℕ}, m ≤ n →
    npk K n v % 2 ^ (K * m) = npk K m v
  | n, v, hv, m, hm => by
    induction n with
    | zero =>
      have : m = 0 := by omega
      subst this; simp [npk]
    | succ n ih =>
      rcases Nat.lt_succ_iff_lt_or_eq.mp (Nat.lt_succ_of_le hm) with h | h
      · have hm' : m ≤ n := by omega
        rw [npk_succ]
        have e : v n * 2 ^ (K * n) = 2 ^ (K * m) * (v n * 2 ^ (K * (n - m))) := by
          rw [show K * n = K * m + K * (n - m) by rw [← Nat.mul_add]; congr 1; omega, pow_add]
          ring
        rw [e, Nat.add_mul_mod_self_left]
        exact ih (fun t ht => hv t (by omega)) hm'
      · subst h
        exact Nat.mod_eq_of_lt (npk_lt hv)

theorem npk_add (K n : ℕ) (v w : ℕ → ℕ) : npk K n (fun t => v t + w t) = npk K n v + npk K n w := by
  simp only [npk, add_mul, sum_add_distrib]

theorem npk_mul (K n c : ℕ) (v : ℕ → ℕ) : npk K n (fun t => c * v t) = c * npk K n v := by
  simp only [npk, mul_sum, mul_assoc]

theorem npk_sum {α : Type*} (s : Finset α) (K n : ℕ) (w : α → ℕ → ℕ) :
    npk K n (fun t => ∑ i ∈ s, w i t) = ∑ i ∈ s, npk K n (w i) := by
  simp only [npk, sum_mul]
  exact sum_comm

theorem npk_single {K n t : ℕ} (ht : t < n) :
    npk K n (fun s => if t = s then 1 else 0) = 2 ^ (K * t) := by
  simp only [npk, ite_mul, one_mul, zero_mul]
  rw [sum_ite_eq]
  simp [ht]

theorem npk_congr {K n : ℕ} {v w : ℕ → ℕ} (h : ∀ t < n, v t = w t) : npk K n v = npk K n w :=
  sum_congr rfl fun t ht => by rw [h t (mem_range.mp ht)]

/-- `1 <<< n = 2^n`, kernel form. -/
theorem shl_one (n : ℕ) : Nat.shiftLeft 1 n = 2 ^ n := by
  show 1 <<< n = _
  rw [Nat.shiftLeft_eq, one_mul]

/-- `npk_mod` in kernel form. -/
theorem npk_mod' {K n : ℕ} {v : ℕ → ℕ} (hv : ∀ t < n, v t < 2 ^ K) {m : ℕ} (hm : m ≤ n) :
    Nat.mod (npk K n v) (Nat.shiftLeft 1 (Nat.mul K m)) = npk K m v := by
  rw [shl_one]; exact npk_mod hv hm

/-- Digit `t < n` of a packed vector, kernel form. -/
theorem dig_npk {K n : ℕ} {v : ℕ → ℕ} (hv : ∀ t < n, v t < 2 ^ K) {t : ℕ} (ht : t < n) :
    dig K (npk K n v) t = v t := by
  rw [dig_eq]; exact npk_digit hv ht

end NatPack

/-! ## 7. The geometry of the cube `n = 4` (`def:blockgauge`, `thm:constrainedcube`)

Sites are `ℤ⁴`, links are pairs `(x, μ)`, plaquettes are triples `(x; μ, ν)` with `μ < ν`. -/

section Geometry

/-- Sites of `ℤ⁴`. -/
abbrev Site := Fin 4 → ℤ

/-- Links `(x, μ)` from `x` to `x + e_μ`. -/
abbrev Link := Site × Fin 4

/-- Plaquettes `(x; μ, ν)` (used with `μ < ν`). -/
abbrev Plaq := Site × Fin 4 × Fin 4

/-- The four directions, as a list (for kernel evaluation). -/
def dirs : List (Fin 4) := [0, 1, 2, 3]

theorem mem_dirs (i : Fin 4) : i ∈ dirs := by fin_cases i <;> simp [dirs]

/-- The unit vector `e_μ`. -/
def unitVec (μ : Fin 4) : Site := fun i => if i = μ then 1 else 0

/-- **Tree links** (`def:blockgauge`): `(x, μ)` is a tree link if the offset `o = x mod 2` has
`o_μ = 0` and `o_ν = 0` for every `ν > μ`, that is, `x_ν` is even for every `ν ≥ μ`. Fields vanish
on tree links; the other links are *active*. -/
def isTree (l : Link) : Bool := dirs.all fun ν => !decide (l.2 ≤ ν) || decide (l.1 ν % 2 = 0)

theorem isTree_iff (l : Link) : isTree l = true ↔ ∀ ν, l.2 ≤ ν → l.1 ν % 2 = 0 := by
  simp only [isTree, List.all_eq_true, Bool.or_eq_true, Bool.not_eq_eq_eq_not, Bool.not_true,
    decide_eq_false_iff_not, decide_eq_true_eq]
  constructor
  · intro h ν hν
    rcases h ν (mem_dirs ν) with h | h
    · exact absurd hν h
    · exact h
  · intro h ν _
    by_cases hν : l.2 ≤ ν
    · exact Or.inr (h ν hν)
    · exact Or.inl hν

/-- `x ∈ [0, 4)⁴`. -/
def inCube (x : Site) : Bool := dirs.all fun i => decide (0 ≤ x i) && decide (x i < 4)

theorem inCube_iff (x : Site) : inCube x = true ↔ ∀ i, 0 ≤ x i ∧ x i < 4 := by
  simp only [inCube, List.all_eq_true, Bool.and_eq_true, decide_eq_true_eq]
  exact ⟨fun h i => h i (mem_dirs i), fun h i _ => h i⟩

/-- **`V`**: the active links with base in `[0, 4)⁴` (`thm:constrainedcube` with `n = 4`). -/
def inV (l : Link) : Bool := inCube l.1 && !isTree l

/-- The four links of the plaquette `(x; μ, ν)`: `(x, μ)`, `(x + e_μ, ν)`, `(x + e_ν, μ)`,
`(x, ν)`. -/
def plaqLink (p : Plaq) : Fin 4 → Link :=
  ![(p.1, p.2.1), (p.1 + unitVec p.2.1, p.2.2), (p.1 + unitVec p.2.2, p.2.1), (p.1, p.2.2)]

/-- The signs `+, +, −, −` of the four links in `(dφ)_p`. -/
def plaqSign : Fin 4 → ℤ := ![1, 1, -1, -1]

/-- **The plaquette field** `(dφ)_{x;μν} = φ(x,μ) + φ(x+e_μ,ν) − φ(x+e_ν,μ) − φ(x,ν)`. -/
def dPlaq (φ : Link → ℝ) (p : Plaq) : ℝ :=
  φ (p.1, p.2.1) + φ (p.1 + unitVec p.2.1, p.2.2) - φ (p.1 + unitVec p.2.2, p.2.1) - φ (p.1, p.2.2)

theorem dPlaq_eq_sum (φ : Link → ℝ) (p : Plaq) :
    dPlaq φ p = ∑ k, (plaqSign k : ℝ) * φ (plaqLink p k) := by
  simp [Fin.sum_univ_four, dPlaq, plaqLink, plaqSign]
  ring

/-- The plaquette `p` meets `V`: one of its links lies in `V`. -/
def meetsV (p : Plaq) : Bool := dirs.any fun k => inV (plaqLink p k)

/-- The block corner `y ∈ {0,1}⁴` whose binary digits are `yi < 16` (`y_0` the highest). -/
def blockOf (yi : ℕ) : Site := fun i => ((yi / 2 ^ (3 - (i : ℕ)) % 2 : ℕ) : ℤ)

/-- The site `2y + o` of the block `B(y) = 2y + {0,1}⁴`, where `o ∈ {0,1}⁴` has the binary digits
of `m < 16` (`o_0` the highest). -/
def blockSite (y : Site) (m : ℕ) : Site := fun i => 2 * y i + ((m / 2 ^ (3 - (i : ℕ)) % 2 : ℕ) : ℤ)

/-- **The block average** (`def:blockgauge`)
`V_{y,μ}(φ) = (1/16) ∑_{x ∈ B(y)} (φ(x,μ) + φ(x+e_μ,μ))`, the sixteen sites `x = 2y + o` of `B(y)`
indexed by `m < 16`. -/
noncomputable def blockAvg (y : Site) (μ : Fin 4) (φ : Link → ℝ) : ℝ :=
  (1 / 16) * ∑ m : Fin 16, (φ (blockSite y m, μ) + φ (blockSite y m + unitVec μ, μ))

/-- The link with code `n < 5184`: base digits of `n / 4` in base `6` (`x_0` the highest), each
minus `1`, so `x ∈ [-1, 4]⁴`; direction `n mod 4`. -/
def linkOfCode (n : ℕ) : Link :=
  (fun i => ((n / 4 / 6 ^ (3 - (i : ℕ)) % 6 : ℕ) : ℤ) - 1, ⟨n % 4, Nat.mod_lt _ (by norm_num)⟩)

/-- The plaquette with code `n < 10000`: base digits of `n / 16` in base `5`, each minus `1`, so
`x ∈ [-1, 3]⁴`; planes `μ = (n / 4) mod 4`, `ν = n mod 4`. -/
def plaqOfCode (n : ℕ) : Plaq :=
  (fun i => ((n / 16 / 5 ^ (3 - (i : ℕ)) % 5 : ℕ) : ℤ) - 1,
    ⟨n / 4 % 4, Nat.mod_lt _ (by norm_num)⟩, ⟨n % 4, Nat.mod_lt _ (by norm_num)⟩)

/-- Equality of links, kernel form. -/
def linkEq (l l' : Link) : Bool := decide (l.2 = l'.2) && dirs.all fun i => decide (l.1 i = l'.1 i)

theorem linkEq_iff (l l' : Link) : linkEq l l' = true ↔ l = l' := by
  simp only [linkEq, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true]
  constructor
  · rintro ⟨h2, h1⟩
    exact Prod.ext (funext fun i => h1 i (mem_dirs i)) h2
  · rintro rfl
    exact ⟨rfl, fun _ _ => rfl⟩

theorem linkOfCode_inj {n n' : ℕ} (hn : n < 5184) (hn' : n' < 5184)
    (h : linkOfCode n = linkOfCode n') : n = n' := by
  simp only [linkOfCode, Prod.mk.injEq, Fin.mk.injEq] at h
  obtain ⟨h1, h2⟩ := h
  have e0 := congrFun h1 0
  have e1 := congrFun h1 1
  have e2 := congrFun h1 2
  have e3 := congrFun h1 3
  simp at e0 e1 e2 e3
  omega

theorem plaqOfCode_inj {n n' : ℕ} (hn : n < 10000) (hn' : n' < 10000)
    (h : plaqOfCode n = plaqOfCode n') : n = n' := by
  simp only [plaqOfCode, Prod.mk.injEq, Fin.mk.injEq] at h
  obtain ⟨h1, h2, h3⟩ := h
  have e0 := congrFun h1 0
  have e1 := congrFun h1 1
  have e2 := congrFun h1 2
  have e3 := congrFun h1 3
  simp at e0 e1 e2 e3
  omega

/-- Every link with base in `[-1, 4]⁴` has a code. -/
theorem exists_linkCode (l : Link) (hl : ∀ i, -1 ≤ l.1 i ∧ l.1 i ≤ 4) :
    ∃ n < 5184, linkOfCode n = l := by
  obtain ⟨x, μ⟩ := l
  have hl' : ∀ i, -1 ≤ x i ∧ x i ≤ 4 := hl
  have hx : ∀ i, ∃ k : ℕ, x i = (k : ℤ) - 1 ∧ k ≤ 5 := fun i =>
    ⟨(x i + 1).toNat, by have := hl' i; have := Int.toNat_of_nonneg (show 0 ≤ x i + 1 by omega); omega⟩
  obtain ⟨a, ha, ha'⟩ := hx 0
  obtain ⟨b, hb, hb'⟩ := hx 1
  obtain ⟨c, hc, hc'⟩ := hx 2
  obtain ⟨d, hd, hd'⟩ := hx 3
  refine ⟨(((a * 6 + b) * 6 + c) * 6 + d) * 4 + μ, by omega, ?_⟩
  refine Prod.ext (funext fun i => ?_) (Fin.ext ?_)
  · fin_cases i <;> simp [linkOfCode, ha, hb, hc, hd] <;> omega
  · simp [linkOfCode]

/-- Every plaquette with base in `[-1, 3]⁴` and `μ < ν` has a code. -/
theorem exists_plaqCode (p : Plaq) (hp : ∀ i, -1 ≤ p.1 i ∧ p.1 i ≤ 3) :
    ∃ n < 10000, plaqOfCode n = p := by
  obtain ⟨x, μ, ν⟩ := p
  have hp' : ∀ i, -1 ≤ x i ∧ x i ≤ 3 := hp
  have hx : ∀ i, ∃ k : ℕ, x i = (k : ℤ) - 1 ∧ k ≤ 4 := fun i =>
    ⟨(x i + 1).toNat, by have := hp' i; have := Int.toNat_of_nonneg (show 0 ≤ x i + 1 by omega); omega⟩
  obtain ⟨a, ha, ha'⟩ := hx 0
  obtain ⟨b, hb, hb'⟩ := hx 1
  obtain ⟨c, hc, hc'⟩ := hx 2
  obtain ⟨d, hd, hd'⟩ := hx 3
  refine ⟨((((a * 5 + b) * 5 + c) * 5 + d) * 16 + 4 * μ + ν), by omega, ?_⟩
  refine Prod.ext (funext fun i => ?_) (Prod.ext (Fin.ext ?_) (Fin.ext ?_))
  · fin_cases i <;> simp [plaqOfCode, ha, hb, hc, hd] <;> omega
  · simp [plaqOfCode]; omega
  · simp [plaqOfCode]; omega

/-- A plaquette meeting `V` has its base in `[-1, 3]⁴`. -/
theorem base_of_meetsV {p : Plaq} (h : meetsV p = true) : ∀ i, -1 ≤ p.1 i ∧ p.1 i ≤ 3 := by
  simp only [meetsV, List.any_eq_true] at h
  obtain ⟨k, -, hk⟩ := h
  simp only [inV, Bool.and_eq_true, inCube_iff] at hk
  intro i
  have h1 := hk.1 i
  fin_cases k <;> simp [plaqLink, unitVec] at h1 <;> (try split_ifs at h1) <;> omega

/-- A link of `V` has its base in `[-1, 4]⁴` (a weak form of `inCube`). -/
theorem base_of_inV {l : Link} (h : inV l = true) : ∀ i, -1 ≤ l.1 i ∧ l.1 i ≤ 4 := by
  simp only [inV, Bool.and_eq_true, inCube_iff] at h
  intro i
  have := h.1 i
  omega

end Geometry

