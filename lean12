  defect_absorption_pos one_pos (by norm_num) (by norm_num)

/-- `bad_set_ratio` with `μ = (1/4, 3/4)` and `B = {0}`, `p = 1/4`. -/
theorem bad_set_ratio_example :
    ∑ ω, (![1 / 4, 3 / 4] : Fin 2 → ℝ) ω *
        ((if ω ∈ ({0} : Finset (Fin 2)) then 1 else 0) - 1 / 4) = 0 ∧
      ∑ ω, (![1 / 4, 3 / 4] : Fin 2 → ℝ) ω *
        ((if ω ∈ ({0} : Finset (Fin 2)) then 1 else 0) - 1 / 4) ^ 2 = 1 / 4 * (1 - 1 / 4) ∧
      ∑ ω ∈ ({0} : Finset (Fin 2)), (![1 / 4, 3 / 4] : Fin 2 → ℝ) ω *
        ((if ω ∈ ({0} : Finset (Fin 2)) then 1 else 0) - 1 / 4) ^ 2 = 1 / 4 * (1 - 1 / 4) ^ 2 :=
  bad_set_ratio _ (by simp [Fin.sum_univ_two]; norm_num) {0} (by simp)

/-- `bad_set_ratio_eq` at `p = 1/4`. -/
theorem bad_set_ratio_eq_example :
    1 / 4 * (1 - 1 / 4) ^ 2 / (1 / 4 * (1 - 1 / 4)) = (1 - 1 / 4 : ℝ) :=
  bad_set_ratio_eq (by norm_num) (by norm_num)

/-- `bridge_mono` with `λ = 1 ≥ 1/2`, `γ = 2 ≥ 1`, `χ = 1 ≤ 2`, `V = H = 1`. -/
theorem bridge_mono_example :
    (1 : ℝ)⁻¹ * 1 + (2 : ℝ)⁻¹ * (√1 + 1 * √1) ^ 2 ≤
      (1 / 2 : ℝ)⁻¹ * 1 + (1 : ℝ)⁻¹ * (√1 + 2 * √1) ^ 2 :=
  bridge_mono (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    (by norm_num)

/-- `uniform_bridge` for a family indexed by `p : ℕ` with `λ_p = 2/9 + p`, `γ_p = 1 + p`,
`χ_p = 2/(1 + p)`, `K_p = 1`, `δ_p = (1/18)/(1 + p)`, and the uniform constants
`λ₀ = 2/9`, `γ₀ = 1`, `χ₀ = 2`, `K₀ = 1`, `δ₀ = 1/18` (so `C₀ = 9`, `C₀ δ₀ = 1/2`). -/
theorem uniform_bridge_example :
    0 < (1 - cstar ((2 / 9)⁻¹ + 2 ^ 2 / 1) (2 / 1) 1⁻¹ * (1 / 18)) /
        (cstar ((2 / 9)⁻¹ + 2 ^ 2 / 1) (2 / 1) 1⁻¹ * 1) ∧
      ∀ (p : ℕ) (f : Fin 2 → ℝ), (1 - cstar ((2 / 9)⁻¹ + 2 ^ 2 / 1) (2 / 1) 1⁻¹ * (1 / 18)) /
        (cstar ((2 / 9)⁻¹ + 2 ^ 2 / 1) (2 / 1) 1⁻¹ * 1) * (f 0 ^ 2 + f 1 ^ 2) ≤
          (2 / 9 + p) * f 0 ^ 2 + (1 + p) * f 1 ^ 2 := by
  have hp : ∀ p : ℕ, (0 : ℝ) ≤ p := fun p => Nat.cast_nonneg p
  refine uniform_bridge (𝒟 := fun _ : ℕ => Fin 2 → ℝ)
    (fun _ f => f 0 ^ 2 + f 1 ^ 2) (fun _ f => f 0 ^ 2) (fun _ f => f 1 ^ 2)
    (fun p f => (2 / 9 + p) * f 0 ^ 2) (fun p f => (1 + p) * f 1 ^ 2)
    (fun p f => (1 + p) * f 1 ^ 2) (fun p f => (2 / 9 + p) * f 0 ^ 2 + (1 + p) * f 1 ^ 2)
    (fun p => 2 / 9 + p) (fun p => 1 + p) (fun p => 2 / (1 + p)) (fun _ => 1)
    (fun p => 1 / 18 / (1 + p)) (by norm_num) (by norm_num) (by norm_num)
    (fun p => by linarith [hp p]) (fun p => by linarith [hp p]) (fun p => ⟨?_, ?_⟩)
    (fun _ => le_rfl) (fun p => ?_) (fun _ f => by positivity) (fun p f => by positivity)
    (fun p f => by positivity) (fun p f => by positivity) (fun p f => by positivity)
    (fun _ _ => rfl) (fun p f => ?_) (fun p f => ?_) (fun p f => ?_) (fun p f => ?_) ?_
  · positivity
  · rw [div_le_iff₀ (by linarith [hp p])]; nlinarith [hp p]
  · rw [div_le_iff₀ (by linarith [hp p])]; nlinarith [hp p]
  · rw [inv_mul_cancel_left₀ (by linarith [hp p])]
  · rw [inv_mul_cancel_left₀ (by linarith [hp p])]
  · have : 0 ≤ 2 / (1 + (p : ℝ)) * √((2 / 9 + p) * f 0 ^ 2) := by positivity
    linarith
  · have : 0 ≤ 1 / 18 / (1 + (p : ℝ)) * (f 0 ^ 2 + f 1 ^ 2) := by positivity
    linarith
  · rw [cstar_example]; norm_num

/-- The BP constant of `uniform_bridge_example`: `ϖ₀ = (1 − 9/18)/(9 · 1) = 1/18`. -/
theorem varpi_example :
    (1 - cstar ((2 / 9)⁻¹ + 2 ^ 2 / 1) (2 / 1) 1⁻¹ * (1 / 18)) /
      (cstar ((2 / 9)⁻¹ + 2 ^ 2 / 1) (2 / 1) 1⁻¹ * 1) = 1 / 18 := by
  rw [cstar_example]; norm_num

