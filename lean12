/-- Example data for `inter_fibre_comparison`: `R_y = 2` on the fibre `ℝ`. -/
noncomputable def exR : (y : Fin 2) → ℝ →ₗ[ℝ] ℝ := fun _ => (2 : ℝ) • LinearMap.id
/-- Example data: `u_y = (1, −1)`. -/
def exU : (y : Fin 2) → ℝ := ![1, -1]
/-- Example data: `∇g(y) = u_y`. -/
def exG : Fin 2 → Fin 1 → ℝ := ![![1], ![-1]]

/-- `inter_fibre_comparison` on two coarse points of weight `1/2` with one-dimensional fibres, `s =
1`, `w = 1/2`, `R = 2`, `h = 0`, `χ = 1/2`; here it is an equality, `1 ≤ 0 + 1`. -/
theorem inter_fibre_example :
    √(∑ y : Fin 2, (1 / 2 : ℝ) *
        dotProduct (exG y) ((1 : Matrix (Fin 1) (Fin 1) ℝ).mulVec (exG y))) ≤
      √(∑ _y : Fin 2, (1 / 2 : ℝ) *
          dotProduct (0 : Fin 1 → ℝ) ((1 : Matrix (Fin 1) (Fin 1) ℝ).mulVec 0)) +
        1 / 2 * √(∑ y : Fin 2, (1 / 2 : ℝ) * ‖exR y (exU y)‖ ^ 2) := by
  have hw : ∀ (y : Fin 2) (_ : Fin 1) (u : ℝ),
      inner ℝ (1 : ℝ) u = inner ℝ (1 / 2 : ℝ) (exR y u) := by
    intro y _ u; simp [exR]; ring
  have hG : ∀ y : Fin 2,
      exG y = (fun _ => (0 : ℝ)) + fun (i : Fin 1) => inner ℝ (1 : ℝ) (exU y) := by
    intro y; ext i; fin_cases i; fin_cases y <;> simp [exG, exU]
  have hX : ∀ (y : Fin 2) (v : Fin 1 → ℝ), dotProduct v
      (((1 : Matrix (Fin 1) (Fin 1) ℝ) * Matrix.gram ℝ (fun _ : Fin 1 => (1 / 2 : ℝ)) *
        (1 : Matrix (Fin 1) (Fin 1) ℝ)ᵀ).mulVec v) ≤ (1 / 2) ^ 2 * dotProduct v v := by
    intro y v
    simp [Matrix.gram_apply, dotProduct, Matrix.mulVec]
