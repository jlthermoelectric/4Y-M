/-! ### §13.1: two blocks on `H = ℝ²`, `r = 2` -/

/-- `P₁ = diag(1, 0)`. -/
def blockP₁ : Matrix (Fin 2) (Fin 2) ℝ := !![1, 0; 0, 0]
/-- `P₂ = diag(0, 1)`. -/
def blockP₂ : Matrix (Fin 2) (Fin 2) ℝ := !![0, 0; 0, 1]
/-- The two block projections. -/
def blockP : Fin 2 → Matrix (Fin 2) (Fin 2) ℝ := ![blockP₁, blockP₂]
/-- Unit weights. -/
def wOne : Fin 2 → ℝ := fun _ => 1

/-- `P₁` is symmetric. -/
theorem blockP₁_symm : blockP₁ᵀ = blockP₁ := by
  ext i j; fin_cases i <;> fin_cases j <;> simp [blockP₁]

/-- `P₁` is idempotent. -/
theorem blockP₁_idem : blockP₁ * blockP₁ = blockP₁ := by
  ext i j; fin_cases i <;> fin_cases j <;> simp [blockP₁, Matrix.mul_apply, Fin.sum_univ_two]

/-- `P₂` is symmetric. -/
theorem blockP₂_symm : blockP₂ᵀ = blockP₂ := by
  ext i j; fin_cases i <;> fin_cases j <;> simp [blockP₂]

/-- `P₂` is idempotent. -/
theorem blockP₂_idem : blockP₂ * blockP₂ = blockP₂ := by
  ext i j; fin_cases i <;> fin_cases j <;> simp [blockP₂, Matrix.mul_apply, Fin.sum_univ_two]

/-- Both block projections are symmetric. -/
theorem blockP_symm (x : Fin 2) : (blockP x)ᵀ = blockP x := by
  fin_cases x
  · exact blockP₁_symm
  · exact blockP₂_symm

/-- Both block projections are idempotent. -/
theorem blockP_idem (x : Fin 2) : blockP x * blockP x = blockP x := by
  fin_cases x
  · exact blockP₁_idem
  · exact blockP₂_idem

/-- `A₁ = (I − P₁) + (I − P₂) = I`. -/
theorem blockA₁_eq : ∑ x, wOne x • (1 - blockP x) = (1 : Matrix (Fin 2) (Fin 2) ℝ) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [wOne, blockP, blockP₁, blockP₂, Fin.sum_univ_two, Matrix.sum_apply] <;> norm_num

/-- `A₁ ≥ 1`. -/
theorem blockA₁ (v : Fin 2 → ℝ) :
    1 * ∑ c, v c ^ 2 ≤ ∑ c, v c * ∑ a, (∑ x, wOne x • (1 - blockP x)) c a * v a := by
  rw [blockA₁_eq]
  simp [Matrix.one_apply, sq]

/-- `first_chaos_transfer_tensor`: `A₂ = ∑_x (I − P_x ⊗ P_x) ≥ 1` on `ℝ² ⊗ ℝ²`. -/
theorem first_chaos_transfer_tensor_example (F : Tens 2 2) :
    1 * ‖F‖ ^ 2 ≤ ∑ x, wOne x * inner ℝ F ((1 - tpow (blockP x)) F) :=
  first_chaos_transfer_tensor (by norm_num) wOne (fun _ => zero_le_one) blockP blockP_symm
    blockP_idem blockA₁ F

/-- `first_chaos_transfer_tensor_sym` for the two blocks. -/
theorem first_chaos_transfer_tensor_sym_example :
    ∀ F ∈ symTensors 2 2, 1 * ‖F‖ ^ 2 ≤ ∑ x, wOne x * inner ℝ F ((1 - tpow (blockP x)) F) :=
  first_chaos_transfer_tensor_sym (by norm_num) wOne (fun _ => zero_le_one) blockP blockP_symm
    blockP_idem blockA₁

/-- `posSeq_isOrthProj` for `P₁`. -/
theorem posSeq_isOrthProj_example (j : ℕ) : IsOrthProj (posSeq (r := 2) blockP₁ j) :=
  posSeq_isOrthProj blockP₁_symm blockP₁_idem j

/-- `posOp_isOrthProj` for `P₁` in position `0`. -/
theorem posOp_isOrthProj_example :
    (posOp (n := 2) (r := 2) 0 blockP₁).IsSymmetric ∧
      posOp (n := 2) (r := 2) 0 blockP₁ * posOp 0 blockP₁ = posOp 0 blockP₁ :=
  posOp_isOrthProj 0 blockP₁_symm blockP₁_idem

