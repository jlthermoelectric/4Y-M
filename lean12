section KappaSound

theorem site4_lt (a b c d : ℕ) : site4 a b c d < 256 := by unfold site4; omega

theorem coord_lt (s a : ℕ) : coord s a < 4 := by unfold coord; exact Nat.mod_lt _ (by norm_num)

theorem planeMu_lt (k : ℕ) : planeMu k < 4 := by
  unfold planeMu
  rcases k with _ | _ | _ | _ | _ | _ | k <;> simp

theorem planeNu_lt (k : ℕ) : planeNu k < 4 := by
  unfold planeNu
  rcases k with _ | _ | _ | _ | _ | _ | k <;> simp

theorem natpow_eq (m n : ℕ) : Nat.pow m n = m ^ n := rfl

theorem geom_facts (hg : geomCheck = true) :
    (∀ t < 16, ∀ s < 256, trSite t (trSite t s) = s ∧ trSite t s < 256 ∧
      ∀ a < 4, step (trSite t s) a = trSite t (step s a) ∧
        coord (trSite t s) a = (coord s a + 2 * bit t a) % 4) ∧
    (∀ t < 16, ∀ l < 1024, isTree (trL t l) = isTree l) ∧
    (∀ t < 16, ∀ Z < 16, ∀ o < 16, trSite t (blockSite Z o) = blockSite (Z ^^^ t) o) ∧
    (∀ b < 256, trSite (trOf b) (corner (clsOf b)) = b ∧ clsOf b < 16 ∧ trOf b < 16) ∧
    (∀ s < 256, ∀ a < 4, step s a < 256) ∧
    (∀ p < 1536, ∀ i < 4, p ∈ plaqsOf (plaqLink p i) ∧ plaqLink p i < 1024) := by
  unfold geomCheck at hg
  simp only [Bool.and_eq_true, allBelow_iff, beq_iff_eq, decide_eq_true_eq,
    List.contains_iff_mem] at hg
  obtain ⟨⟨⟨⟨⟨h1, h2⟩, h3⟩, h4⟩, h5⟩, h6⟩ := hg
  exact ⟨fun t ht s hs => ⟨(h1 t ht s hs).1.1, (h1 t ht s hs).1.2, (h1 t ht s hs).2⟩, h2, h3,
    fun b hb => ⟨(h4 b hb).1.1, (h4 b hb).1.2, (h4 b hb).2⟩, h5, h6⟩

theorem slot_facts (hs : slotCheck = true) {o : ℕ} (ho : o < 16) :
    (∀ s < 96, slotLink (corner o) s < 1024 ∧ touches (corner o) (slotLink (corner o) s) = true ∧
      slotOf (corner o) (slotLink (corner o) s) = s) ∧
    (∀ l < 1024, touches (corner o) l = true →
      slotOf (corner o) l < 96 ∧ slotLink (corner o) (slotOf (corner o) l) = l) ∧
    (∀ q < 216, patchPlaq (corner o) q < 1536 ∧ patchOf (corner o) (patchPlaq (corner o) q) = q) ∧
    (∀ s < 96, ∀ p ∈ plaqsOf (slotLink (corner o) s),
      patchOf (corner o) p < 216 ∧ patchPlaq (corner o) (patchOf (corner o) p) = p) := by
  have h := (allBelow_iff.mp hs) o ho
  simp only [Bool.and_eq_true, allBelow_iff, beq_iff_eq, decide_eq_true_eq, Bool.or_eq_true,
    Bool.not_eq_true', List.all_eq_true] at h
  obtain ⟨⟨⟨h1, h2⟩, h3⟩, h4⟩ := h
  refine ⟨fun s hs => ⟨(h1 s hs).1.1, (h1 s hs).1.2, (h1 s hs).2⟩, fun l hl ht => ?_, h3, h4⟩
  rcases h2 l hl with h | h
  · rw [ht] at h; exact absurd h (by decide)
  · exact h

/-- Values of a fibre field through the slots: a touching link is the link of its slot. -/
theorem phi_touch (hs : slotCheck = true) {o : ℕ} (ho : o < 16) {φ : Fin 1024 → ℝ} (n : ℕ)
    (hn : touches (corner o) (n % 1024) = true) :
    φ (fl n) = φ (fl (slotLink (corner o) (slotOf (corner o) (n % 1024)))) := by
  have := ((slot_facts hs ho).2.1 (n % 1024) (Nat.mod_lt _ (by norm_num)) hn).2
  rw [this]
  exact congrArg φ (Fin.ext (by simp [fl]))

theorem phi_untouch {o : ℕ} {φ : Fin 1024 → ℝ} (hφ : φ ∈ fibre (corner o)) (n : ℕ)
    (hn : touches (corner o) (n % 1024) = false) : φ (fl n) = 0 :=
  hφ.2 (fl n) hn

/-- The packed slot vector of a pin term `n`: `2^(K₂ s)` if `n` is a non-tree link touching the
box at the slot `s`, and `0` otherwise (kernel form). -/
def contrib (b K2 n : ℕ) : ℤ :=
  if (touches b (n % 1024) && !isTree (n % 1024)) = true then
    Int.ofNat (Nat.shiftLeft 1 (Nat.mul K2 (slotOf b (n % 1024)))) else 0

/-- The slot indicator of a pin term. -/
def cnt (b n s : ℕ) : ℤ :=
  if (touches b (n % 1024) && !isTree (n % 1024)) = true ∧ slotOf b (n % 1024) = s then 1 else 0

/-- The slot coefficients of the pin row `r` (non-tree links touching the box). -/
def pinA (b r s : ℕ) : ℤ :=
  ∑ o ∈ range 16, (cnt b (4 * blockSite (r % 16) o + r / 16) s +
    cnt b (4 * step (blockSite (r % 16) o) (r / 16) + r / 16) s)

/-- The pin row `r` packed over the slots (kernel form). -/
def pinPack (b K2 r : ℕ) : ℤ :=
  sumRange 16 fun o => Int.add (contrib b K2 (4 * blockSite (r % 16) o + r / 16))
    (contrib b K2 (4 * step (blockSite (r % 16) o) (r / 16) + r / 16))

theorem contrib_eq (hs : slotCheck = true) {o : ℕ} (ho : o < 16) (K2 n : ℕ) :
    contrib (corner o) K2 n = pk K2 96 (cnt (corner o) n) := by
  unfold contrib cnt
  by_cases h : (touches (corner o) (n % 1024) && !isTree (n % 1024)) = true
  · rw [if_pos h, shift_one_eq]
    have hlt : slotOf (corner o) (n % 1024) < 96 := by
      have ht : touches (corner o) (n % 1024) = true := by
        simp only [Bool.and_eq_true] at h; exact h.1
      exact ((slot_facts hs ho).2.1 _ (Nat.mod_lt _ (by norm_num)) ht).1
    have : (fun s => if (touches (corner o) (n % 1024) && !isTree (n % 1024)) = true ∧
        slotOf (corner o) (n % 1024) = s then (1 : ℤ) else 0) =
        fun s => if slotOf (corner o) (n % 1024) = s then 1 else 0 := by
      funext s; simp only [h, true_and]
    rw [this, pk_single _ _ _ hlt]
  · rw [if_neg h]
    simp [pk, h]

theorem pinPack_eq (hs : slotCheck = true) {o : ℕ} (ho : o < 16) (K2 r : ℕ) :
    pinPack (corner o) K2 r = pk K2 96 (pinA (corner o) r) := by
  unfold pinPack pinA
  rw [sumRange_eq, pk_sum]
  refine sum_congr rfl fun i _ => ?_
  rw [pk_add, ← contrib_eq hs ho, ← contrib_eq hs ho]; rfl

/-- A fibre field at a pin term, as a combination of its slot values. -/
theorem phi_cnt (hs : slotCheck = true) {o : ℕ} (ho : o < 16) {φ : Fin 1024 → ℝ}
    (hφ : φ ∈ fibre (corner o)) (n : ℕ) :
    φ (fl n) = ∑ s ∈ range 96, (cnt (corner o) n s : ℝ) * φ (fl (slotLink (corner o) s)) := by
  unfold cnt
  by_cases ht : touches (corner o) (n % 1024) = true
  · have hlt := ((slot_facts hs ho).2.1 _ (Nat.mod_lt _ (by norm_num)) ht).1
    by_cases htr : isTree (n % 1024) = true
    · have h0 : φ (fl n) = 0 := hφ.1.1 (fl n) (by simpa [fl] using htr)
      rw [h0]; symm; refine sum_eq_zero fun s _ => ?_
      simp [htr]
    · have hok : (touches (corner o) (n % 1024) && !isTree (n % 1024)) = true := by
        simp [ht, htr]
      simp only [hok, true_and]
      push_cast
      simp only [ite_mul, one_mul, zero_mul]
      rw [sum_ite_eq, if_pos (mem_range.mpr hlt)]
      exact phi_touch hs ho n ht
  · rw [Bool.not_eq_true] at ht
    rw [phi_untouch hφ n ht]; symm; refine sum_eq_zero fun s _ => ?_
    simp [ht]

theorem pinSum_slots (hs : slotCheck = true) {o : ℕ} (ho : o < 16) {φ : Fin 1024 → ℝ}
    (hφ : φ ∈ fibre (corner o)) (r : ℕ) (hr : r < 64) :
    pinSum ⟨r, hr⟩ φ =
      ∑ s ∈ range 96, (pinA (corner o) r s : ℝ) * φ (fl (slotLink (corner o) s)) := by
  unfold pinSum pinA
  rw [Fin.sum_univ_eq_sum_range (fun i => φ (fl (4 * blockSite (r % 16) i + r / 16)) +
    φ (fl (4 * step (blockSite (r % 16) i) (r / 16) + r / 16))) 16]
  have e : ∀ i ∈ range 16, φ (fl (4 * blockSite (r % 16) i + r / 16)) +
      φ (fl (4 * step (blockSite (r % 16) i) (r / 16) + r / 16)) =
      ∑ s ∈ range 96, ((cnt (corner o) (4 * blockSite (r % 16) i + r / 16) s : ℝ) +
        (cnt (corner o) (4 * step (blockSite (r % 16) i) (r / 16) + r / 16) s : ℝ)) *
          φ (fl (slotLink (corner o) s)) := by
    intro i _
    rw [phi_cnt hs ho hφ (4 * blockSite (r % 16) i + r / 16),
      phi_cnt hs ho hφ (4 * step (blockSite (r % 16) i) (r / 16) + r / 16), ← sum_add_distrib]
    exact sum_congr rfl fun s _ => by ring
  rw [sum_congr rfl e, sum_comm]
  refine sum_congr rfl fun s _ => ?_
  rw [← sum_mul]
  push_cast
  rfl

/-- The spanning row of the pivot `i`: `dW (e_{piv i} − ∑ⱼ C i j e_{free j})`. -/
def spanRow (c : KCert) (i s : ℕ) : ℤ :=
  c.dW * ((if c.piv.getD i 0 = s then 1 else 0) -
    ∑ j ∈ range c.free.length, ent c.wC (c.C.getD i 0) j * (if c.free.getD j 0 = s then 1 else 0))

/-- `∑ⱼ (C i j) 2^(K₂ free j)` (kernel form), from the index `j`. -/
def freeComb (w P K2 : ℕ) : List ℕ → ℕ → ℤ
  | [], _ => 0
  | f :: fs, j => Int.add (Int.mul (kent w P j) (Int.ofNat (Nat.shiftLeft 1 (Nat.mul K2 f))))
      (freeComb w P K2 fs (j + 1))

theorem freeComb_eq (w P K2 : ℕ) : ∀ (L : List ℕ) (j0 : ℕ), (∀ f ∈ L, f < 96) →
    freeComb w P K2 L j0 = pk K2 96 (fun s => ∑ j ∈ range L.length,
      ent w P (j0 + j) * (if L.getD j 0 = s then 1 else 0))
  | [], j0, _ => by simp [freeComb, pk]
  | f :: fs, j0, hL => by
    show kent w P j0 * Int.ofNat (Nat.shiftLeft 1 (Nat.mul K2 f)) + freeComb w P K2 fs (j0 + 1) = _
    rw [freeComb_eq w P K2 fs (j0 + 1) (fun f' hf' => hL f' (List.mem_cons_of_mem _ hf')),
      kent_eq, shift_one_eq, ← pk_single K2 96 f (hL f (List.mem_cons_self ..)), ← pk_smul,
      ← pk_add]
    refine pk_congr fun s _ => ?_
    rw [List.length_cons, sum_range_succ']
    simp only [List.getD_cons_zero, List.getD_cons_succ, add_zero]
    rw [add_comm]
    congr 1
    refine sum_congr rfl fun j _ => ?_
    rw [show j0 + 1 + j = j0 + (j + 1) by ring]

/-- The spanning row packed over the slots (kernel form). -/
def rowPack (c : KCert) (i : ℕ) : ℤ :=
  Int.mul (Int.ofNat c.dW) (Int.sub (Int.ofNat (Nat.shiftLeft 1 (Nat.mul c.K2 (c.piv.getD i 0))))
    (freeComb c.wC (c.C.getD i 0) c.K2 c.free 0))

theorem rowPack_eq (c : KCert) (i : ℕ) (hp : c.piv.getD i 0 < 96) (hf : ∀ f ∈ c.free, f < 96) :
    rowPack c i = pk c.K2 96 (spanRow c i) := by
  show (c.dW : ℤ) * (Int.ofNat (Nat.shiftLeft 1 (Nat.mul c.K2 (c.piv.getD i 0))) -
    freeComb c.wC (c.C.getD i 0) c.K2 c.free 0) = _
  rw [shift_one_eq, freeComb_eq _ _ _ _ _ hf, ← pk_single c.K2 96 _ hp, ← pk_sub, ← pk_smul]
  refine pk_congr fun s _ => ?_
  simp only [spanRow, zero_add]

/-- The total absolute weight of a list of multipliers. -/
def wsum (L : List (ℕ × ℤ)) : ℕ := (L.map fun e => e.2.natAbs).sum

theorem wsum_cons (e : ℕ × ℤ) (L : List (ℕ × ℤ)) : wsum (e :: L) = e.2.natAbs + wsum L := by
  simp [wsum]

/-- **The spanning check** for the pivot `i` (kernel form). -/
def spanOK (b : ℕ) (c : KCert) (i : ℕ) : Bool :=
  (c.W.getD i []).all (fun e => decide (e.1 < 64)) &&
  decide (32 * wsum (c.W.getD i []) + c.dW * (1 + c.free.length * Nat.pow 2 (c.wC - 1)) <
    Nat.pow 2 c.K2) &&
  decide (lcz (pinPack b c.K2) (c.W.getD i []) = rowPack c i)

/-- The kernel form of `βH`. -/
def KCert.βHk (c : KCert) : ℕ :=
  Nat.pow 2 c.sig * (3321 * 216 * (4 * Nat.pow 2 (c.wC - 1)) * (4 * Nat.pow 2 (c.wC - 1)) +
    500 * 96 * Nat.pow 2 (c.wC - 1) * Nat.pow 2 (c.wC - 1))

theorem KCert.βHk_eq (c : KCert) : c.βHk = c.βH := rfl

/-- Every slot is a free slot, a pivot slot, or a tree slot. -/
def kRoles (o : ℕ) (c : KCert) : Bool :=
  allBelow 96 fun s => c.free.contains s || c.piv.contains s || isTree (slotLink (corner o) s)

/-- Ranges and positivity of the parameters. -/
def kRanges (c : KCert) : Bool :=
  c.free.all (fun s => decide (s < 96)) && c.piv.all (fun s => decide (s < 96)) &&
  decide (0 < c.dW) && decide (1 ≤ c.wC) && decide (1 ≤ c.wM) && decide (1 ≤ c.K)

/-- The spanning checks of all pivots. -/
def kSpan (o : ℕ) (c : KCert) : Bool := allBelow c.piv.length (spanOK (corner o) c)

/-- The size condition of the packed PSD check. -/
def kBound (c : KCert) : Bool :=
  decide (2 * (c.βHk + c.M.length * Nat.pow 2 c.wd * Nat.pow 2 (c.wM - 1) * Nat.pow 2 (c.wM - 1))
    < Nat.pow 2 c.K)

/-- The packed PSD check. -/
def kPsd (o : ℕ) (c : KCert) : Bool :=
  psdScan c.K c.free.length c.free.length 0
    (Int.sub (c.Hpk (corner o)) (ldlSum c.K c.free.length c.wM c.wd c.d c.M 0))

/-- **Validity of a κ certificate** for the class box `o` (a closed Boolean computation). -/
def kappaCheck (o : ℕ) (c : KCert) : Bool :=
  kRoles o c && kRanges c && kSpan o c && kBound c && kPsd o c

theorem kappaCheck_parts {o : ℕ} {c : KCert} (h : kappaCheck o c = true) :
    kRoles o c = true ∧ kRanges c = true ∧ kSpan o c = true ∧ kBound c = true ∧
      kPsd o c = true := by
  unfold kappaCheck at h
  rw [Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true] at h
  exact ⟨h.1.1.1.1, h.1.1.1.2, h.1.1.2, h.1.2, h.2⟩

theorem kRanges_parts {c : KCert} (h : kRanges c = true) :
    (∀ s ∈ c.free, s < 96) ∧ (∀ s ∈ c.piv, s < 96) ∧ 0 < c.dW ∧ 1 ≤ c.wC ∧ 1 ≤ c.wM ∧
      1 ≤ c.K := by
  unfold kRanges at h
  simp only [Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true] at h
  exact ⟨h.1.1.1.1.1, h.1.1.1.1.2, h.1.1.1.2, h.1.1.2, h.1.2, h.2⟩

theorem pinA_bound (b r s : ℕ) : |pinA b r s| ≤ 32 := by
  unfold pinA
  refine (abs_sum_le_sum_abs _ _).trans ?_
  have : ∀ o ∈ range 16, |cnt b (4 * blockSite (r % 16) o + r / 16) s +
      cnt b (4 * step (blockSite (r % 16) o) (r / 16) + r / 16) s| ≤ 2 := by
    intro o _
    refine (abs_add_le _ _).trans ?_
    unfold cnt
    split_ifs <;> norm_num
  refine (sum_le_sum this).trans ?_
  simp

theorem lc_bound (L : List (ℕ × ℤ)) (f : ℕ → ℤ) (B : ℤ) (hB : ∀ n, |f n| ≤ B) :
    |(L.map fun e => e.2 * f e.1).sum| ≤ (wsum L : ℤ) * B := by
  induction L with
  | nil => simp [wsum]
  | cons e es ih =>
    rw [List.map_cons, List.sum_cons, wsum_cons]
    have h1 : |e.2 * f e.1| ≤ (e.2.natAbs : ℤ) * B := by
      rw [abs_mul, Int.abs_eq_natAbs e.2]
      exact mul_le_mul_of_nonneg_left (hB e.1) (Int.natCast_nonneg e.2.natAbs)
    have h2 := abs_add_le (e.2 * f e.1) (es.map fun e => e.2 * f e.1).sum
    rw [Nat.cast_add, add_mul]
    linarith

theorem abs_spanRow_le (c : KCert) (i s : ℕ) (hw : 1 ≤ c.wC) :
    |spanRow c i s| ≤ c.dW * (1 + c.free.length * 2 ^ (c.wC - 1)) := by
  unfold spanRow
  rw [abs_mul, abs_of_nonneg (Int.natCast_nonneg _)]
  refine mul_le_mul_of_nonneg_left ?_ (Int.natCast_nonneg _)
  refine (abs_sub _ _).trans (add_le_add ?_ ?_)
  · split_ifs <;> simp
  · refine (abs_sum_le_sum_abs _ _).trans ?_
    have : ∀ j ∈ range c.free.length, |ent c.wC (c.C.getD i 0) j *
        (if c.free.getD j 0 = s then 1 else 0)| ≤ 2 ^ (c.wC - 1) := by
      intro j _
      rw [abs_mul]
      have h1 := abs_ent_le hw (c.C.getD i 0) j
      have h2 : |(if c.free.getD j 0 = s then (1 : ℤ) else 0)| ≤ 1 := by split_ifs <;> simp
      nlinarith [abs_nonneg (ent c.wC (c.C.getD i 0) j)]
    refine (sum_le_sum this).trans ?_
    rw [sum_const, card_range, nsmul_eq_mul]

theorem sum_list_comm {n : ℕ} (L : List (ℕ × ℤ)) (g : ℕ → ℕ → ℤ) (v : ℕ → ℝ) :
    ∑ s ∈ range n, (((L.map fun e => e.2 * g e.1 s).sum : ℤ) : ℝ) * v s =
      (L.map fun e => (e.2 : ℝ) * ∑ s ∈ range n, (g e.1 s : ℝ) * v s).sum := by
  induction L with
  | nil => simp
  | cons e es ih =>
    simp only [List.map_cons, List.sum_cons]
    rw [← ih, mul_sum, ← sum_add_distrib]
    refine sum_congr rfl fun s _ => ?_
    push_cast
    ring

theorem spanRow_sum (c : KCert) (i : ℕ) (v : ℕ → ℝ) (hp : c.piv.getD i 0 < 96)
    (hf : ∀ j < c.free.length, c.free.getD j 0 < 96) :
    ∑ s ∈ range 96, (spanRow c i s : ℝ) * v s = c.dW * (v (c.piv.getD i 0) -
      ∑ j ∈ range c.free.length, (ent c.wC (c.C.getD i 0) j : ℝ) * v (c.free.getD j 0)) := by
  have hterm : ∀ s, (spanRow c i s : ℝ) * v s = (c.dW : ℝ) *
      ((if c.piv.getD i 0 = s then v s else 0) - ∑ j ∈ range c.free.length,
        (ent c.wC (c.C.getD i 0) j : ℝ) * (if c.free.getD j 0 = s then v s else 0)) := by
    intro s
    unfold spanRow
    push_cast
    rw [mul_assoc, sub_mul, sum_mul]
    congr 2
    · split_ifs <;> simp
    · exact sum_congr rfl fun j _ => by split_ifs <;> simp
  rw [sum_congr rfl fun s _ => hterm s, ← mul_sum, sum_sub_distrib, sum_ite_eq,
    if_pos (mem_range.mpr hp), sum_comm]
  congr 2
  refine sum_congr rfl fun j hj => ?_
  rw [← mul_sum, sum_ite_eq, if_pos (mem_range.mpr (hf j (mem_range.mp hj)))]

/-- The slot coefficients of a combination of pins. -/
def spanA (o : ℕ) (L : List (ℕ × ℤ)) (s : ℕ) : ℤ := (L.map fun e => e.2 * pinA (corner o) e.1 s).sum

theorem spanA_pk (hs : slotCheck = true) {o : ℕ} (ho : o < 16) (K2 : ℕ) (L : List (ℕ × ℤ)) :
    lcz (pinPack (corner o) K2) L = pk K2 96 (spanA o L) := by
  unfold spanA
  rw [lcz_eq, pk_lc]
  refine congrArg List.sum (List.map_congr_left fun e _ => ?_)
  rw [pinPack_eq hs ho]

theorem spanA_bound (o : ℕ) (L : List (ℕ × ℤ)) (s : ℕ) : |spanA o L s| ≤ (wsum L : ℤ) * 32 :=
  lc_bound L (fun n => pinA (corner o) n s) 32 fun _ => pinA_bound _ _ _

theorem spanA_sum (hs : slotCheck = true) {o : ℕ} (ho : o < 16) {φ : Fin 1024 → ℝ}
    (hφ : φ ∈ fibre (corner o)) (L : List (ℕ × ℤ)) (hL : ∀ e ∈ L, e.1 < 64) :
    ∑ s ∈ range 96, (spanA o L s : ℝ) * φ (fl (slotLink (corner o) s)) = 0 := by
  unfold spanA
  rw [sum_list_comm]
  refine List.sum_eq_zero fun x hx => ?_
  obtain ⟨e, he, rfl⟩ := List.mem_map.mp hx
  rw [← pinSum_slots hs ho hφ e.1 (hL e he), hφ.1.2 ⟨e.1, hL e he⟩, mul_zero]

/-- **Spanning.** If the check succeeds, every pivot value of a fibre field is the combination
`∑ⱼ C i j · (value at free slot j)`. -/
theorem pivot_value (hs : slotCheck = true) {o : ℕ} (ho : o < 16) {c : KCert}
    (hc : kappaCheck o c = true) {φ : Fin 1024 → ℝ} (hφ : φ ∈ fibre (corner o)) {i : ℕ}
    (hi : i < c.piv.length) :
    φ (fl (slotLink (corner o) (c.piv.getD i 0))) = ∑ j ∈ range c.free.length,
      (ent c.wC (c.C.getD i 0) j : ℝ) * φ (fl (slotLink (corner o) (c.free.getD j 0))) := by
  obtain ⟨_, hR, hspan, _, _⟩ := kappaCheck_parts hc
  obtain ⟨hfree, hpiv, hdW, hwC, _, _⟩ := kRanges_parts hR
  have hsp := (allBelow_iff.mp hspan) i hi
  unfold spanOK at hsp
  rw [Bool.and_eq_true, Bool.and_eq_true, decide_eq_true_eq, decide_eq_true_eq,
    List.all_eq_true] at hsp
  obtain ⟨⟨hr64, hbig⟩, heq⟩ := hsp
  have hL : ∀ e ∈ c.W.getD i [], e.1 < 64 := fun e he => of_decide_eq_true (hr64 e he)
  have hp96 : c.piv.getD i 0 < 96 := hpiv _ (by
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hi]; exact List.getElem_mem hi)
  have hpk : pk c.K2 96 (spanA o (c.W.getD i [])) = pk c.K2 96 (spanRow c i) := by
    rw [← spanA_pk hs ho, heq, rowPack_eq c i hp96 hfree]
  rw [natpow_eq, natpow_eq] at hbig
  have hbig' : ((32 * wsum (c.W.getD i []) + c.dW * (1 + c.free.length * 2 ^ (c.wC - 1)) : ℕ) : ℤ)
      < ((2 ^ c.K2 : ℕ) : ℤ) := by exact_mod_cast hbig
  push_cast at hbig'
  have hAR : ∀ s < 96, spanA o (c.W.getD i []) s = spanRow c i s := by
    have h0 : pk c.K2 96 (fun s => spanA o (c.W.getD i []) s - spanRow c i s) = 0 := by
      rw [pk_sub, hpk, sub_self]
    have hb : ∀ s < 96, |spanA o (c.W.getD i []) s - spanRow c i s| < 2 ^ c.K2 := by
      intro s _
      have h1 := spanA_bound o (c.W.getD i []) s
      have h2 := abs_spanRow_le c i s hwC
      calc |spanA o (c.W.getD i []) s - spanRow c i s|
          ≤ |spanA o (c.W.getD i []) s| + |spanRow c i s| := abs_sub _ _
        _ < 2 ^ c.K2 := by linarith
    intro s hs'
    exact sub_eq_zero.mp (eq_zero_of_pk hb h0 s hs')
  have h3 : ∑ s ∈ range 96, (spanRow c i s : ℝ) * φ (fl (slotLink (corner o) s)) = 0 := by
    rw [← spanA_sum hs ho hφ (c.W.getD i []) hL]
    exact sum_congr rfl fun s hs' => by rw [hAR s (mem_range.mp hs')]
  have hf96 : ∀ j < c.free.length, c.free.getD j 0 < 96 := fun j hj => hfree _ (by
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hj]; exact List.getElem_mem hj)
  rw [spanRow_sum c i _ hp96 hf96] at h3
  have hdW' : (0 : ℝ) < c.dW := by exact_mod_cast hdW
  have := (mul_eq_zero.mp h3).resolve_left hdW'.ne'
  linarith

end KappaSound

section KappaClass

/-- The plaquette with index `n` (reduced modulo `1536`). -/
def flp (n : ℕ) : Fin 1536 := ⟨n % 1536, Nat.mod_lt _ (by norm_num)⟩

theorem flp_val {n : ℕ} (h : n < 1536) : flp n = ⟨n, h⟩ := Fin.ext (Nat.mod_eq_of_lt h)

theorem KCert.zp_getD (c : KCert) (K' s : ℕ) (hs : s < 96) :
    ((List.range 96).map (c.zp K')).getD s 0 = pk K' c.free.length (c.Z s) := by
  rw [KCert.getD_map_range _ hs, c.zp_eq]

theorem dloc_slot (hs : slotCheck = true) {o : ℕ} (ho : o < 16) (q : ℕ) :
    ∀ e ∈ dlocOf (corner o) q, e.2 = 0 ∨ e.1 < 96 := by
  intro e he
  simp only [dlocOf, List.mem_map, List.mem_range] at he
  obtain ⟨i, _, rfl⟩ := he
  by_cases ht : touches (corner o) (plaqLink (patchPlaq (corner o) q) i % 1024) = true
  · right; exact ((slot_facts hs ho).2.1 _ (Nat.mod_lt _ (by norm_num)) ht).1
  · left; simp [ht]

theorem KCert.lc_pk (c : KCert) (K' : ℕ) {L : List (ℕ × ℤ)} (hL : ∀ e ∈ L, e.2 = 0 ∨ e.1 < 96) :
    lcz (fun s => ((List.range 96).map (c.zp K')).getD s 0) L =
      pk K' c.free.length (fun j => (L.map fun e => e.2 * c.Z e.1 j).sum) := by
  rw [pk_lc, lcz_eq]
  refine congrArg List.sum (List.map_congr_left fun e he => ?_)
  rcases hL e he with h | h
  · simp [h]
  · rw [c.zp_getD K' e.1 h]

theorem pk_gram (K n m : ℕ) (u : ℕ → ℕ → ℤ) :
    pk K (n * n) (fun t => ∑ q ∈ range m, u q (t % n) * u q (t / n)) =
      ∑ q ∈ range m, pk K n (u q) * pk (K * n) n (u q) := by
  rw [pk_sum]; exact sum_congr rfl fun q _ => (pk_mul K n (u q) (u q)).symm

theorem imul_eq (a b : ℤ) : Int.mul a b = a * b := rfl
theorem iadd_eq (a b : ℤ) : Int.add a b = a + b := rfl
theorem isub_eq (a b : ℤ) : Int.sub a b = a - b := rfl

theorem KCert.Hpk_eq (c : KCert) (hs : slotCheck = true) {o : ℕ} (ho : o < 16) :
    c.Hpk (corner o) = pk c.K (c.free.length * c.free.length)
      (fun t => c.H (corner o) (t % c.free.length) (t / c.free.length)) := by
  have hA : ∀ q ∈ range 216,
      lcz (fun s => ((List.range 96).map (c.zp c.K)).getD s 0) (dlocOf (corner o) q) *
        lcz (fun s => ((List.range 96).map (c.zp (c.K * c.free.length))).getD s 0)
          (dlocOf (corner o) q) =
      pk c.K c.free.length (c.Kq (corner o) q) *
        pk (c.K * c.free.length) c.free.length (c.Kq (corner o) q) := fun q _ => by
    rw [c.lc_pk _ (dloc_slot hs ho q), c.lc_pk _ (dloc_slot hs ho q)]; rfl
  have hB : ∀ s ∈ range 96,
      ((List.range 96).map (c.zp c.K)).getD s 0 *
        ((List.range 96).map (c.zp (c.K * c.free.length))).getD s 0 =
      pk c.K c.free.length (c.Z s) * pk (c.K * c.free.length) c.free.length (c.Z s) :=
    fun s hs' => by rw [c.zp_getD _ s (mem_range.mp hs'), c.zp_getD _ s (mem_range.mp hs')]
  have e1 : c.Hpk (corner o) = 2 ^ c.sig * (3321 * ∑ q ∈ range 216,
      pk c.K c.free.length (c.Kq (corner o) q) * pk (c.K * c.free.length) c.free.length
        (c.Kq (corner o) q) -
      500 * ∑ s ∈ range 96, pk c.K c.free.length (c.Z s) *
        pk (c.K * c.free.length) c.free.length (c.Z s)) := by
    unfold KCert.Hpk
    simp only [sumRange_eq, imul_eq, isub_eq, Int.ofNat_eq_natCast, natpow_eq, Nat.mul_eq]
    rw [sum_congr rfl hA, sum_congr rfl hB]
    push_cast
    rfl
  rw [e1]
  symm
  show pk c.K (c.free.length * c.free.length) (fun t => 2 ^ c.sig *
    (3321 * ∑ q ∈ range 216, c.Kq (corner o) q (t % c.free.length) *
      c.Kq (corner o) q (t / c.free.length) -
    500 * ∑ s ∈ range 96, c.Z s (t % c.free.length) * c.Z s (t / c.free.length))) = _
  rw [pk_smul, pk_sub, pk_smul, pk_smul, pk_gram, pk_gram]

theorem qf_gram (n m : ℕ) (u : ℕ → ℕ → ℝ) (y : ℕ → ℝ) :
    qf n (fun i j => ∑ t ∈ range m, u t i * u t j) y = ∑ t ∈ range m, (∑ i ∈ range n, u t i * y i) ^ 2 := by
  have := qf_ldl (n := n) (m := m) (H := fun i j => ∑ t ∈ range m, u t i * u t j)
    (R := fun _ _ => 0) (M := u) (d := fun _ => 1) (fun i _ j _ => by simp) y
  rw [this]
  simp [qf]

theorem qf_lin (n : ℕ) (a b1 b2 : ℝ) (A B : ℕ → ℕ → ℝ) (y : ℕ → ℝ) :
    qf n (fun i j => a * (b1 * A i j - b2 * B i j)) y = a * (b1 * qf n A y - b2 * qf n B y) := by
  simp only [qf, mul_sum, ← sum_sub_distrib]
  exact sum_congr rfl fun i _ => sum_congr rfl fun j _ => by ring

theorem slot_value (hs : slotCheck = true) {o : ℕ} (ho : o < 16) {c : KCert}
    (hc : kappaCheck o c = true) {φ : Fin 1024 → ℝ} (hφ : φ ∈ fibre (corner o)) {s : ℕ}
    (hs96 : s < 96) :
    φ (fl (slotLink (corner o) s)) = ∑ j ∈ range c.free.length,
      (c.Z s j : ℝ) * φ (fl (slotLink (corner o) (c.free.getD j 0))) := by
  obtain ⟨hroles, _, _, _, _⟩ := kappaCheck_parts hc
  unfold KCert.Z
  cases hf : pos s c.free with
  | some j' =>
    obtain ⟨hj', hget⟩ := pos_spec hf
    simp only
    push_cast
    simp only [ite_mul, one_mul, zero_mul]
    rw [sum_ite_eq, if_pos (mem_range.mpr hj'), hget]
  | none =>
    cases hp : pos s c.piv with
    | some i =>
      obtain ⟨hi, hget⟩ := pos_spec hp
      simp only
      rw [← hget]
      exact pivot_value hs ho hc hφ hi
    | none =>
      simp only [Int.cast_zero, zero_mul, sum_const_zero]
      have hr := (allBelow_iff.mp hroles) s hs96
      rw [Bool.or_eq_true, Bool.or_eq_true, List.contains_iff_mem, List.contains_iff_mem] at hr
      rcases hr with (h | h) | h
      · obtain ⟨j, hj⟩ := pos_of_mem h; rw [hf] at hj; exact absurd hj (by simp)
      · obtain ⟨j, hj⟩ := pos_of_mem h; rw [hp] at hj; exact absurd hj (by simp)
      · have hl := ((slot_facts hs ho).1 s hs96).1
        exact hφ.1.1 (fl (slotLink (corner o) s)) (by rw [fl_val hl]; exact h)

theorem phi_ind (hs : slotCheck = true) {o : ℕ} (ho : o < 16) {φ : Fin 1024 → ℝ}
    (hφ : φ ∈ fibre (corner o)) (n : ℕ) :
    φ (fl n) = (if touches (corner o) (n % 1024) = true then 1 else 0) *
      φ (fl (slotLink (corner o) (slotOf (corner o) (n % 1024)))) := by
  by_cases ht : touches (corner o) (n % 1024) = true
  · rw [if_pos ht, one_mul]; exact phi_touch hs ho n ht
  · rw [if_neg ht, zero_mul]; exact phi_untouch hφ n (by simpa using ht)

/-- **The κ bound on a class box**, from a valid certificate. -/
theorem kappa_class (hg : geomCheck = true) (hs : slotCheck = true) {o : ℕ} (ho : o < 16)
    {c : KCert} (hc : kappaCheck o c = true) {φ : Fin 1024 → ℝ} (hφ : φ ∈ fibre (corner o)) :
    500 * ∑ l, φ l ^ 2 ≤ 3321 * ∑ p, curl φ p ^ 2 := by
  have hsf := slot_facts hs ho
  have hgf := geom_facts hg
  obtain ⟨v, hv⟩ : ∃ v : ℕ → ℝ, v = fun s => φ (fl (slotLink (corner o) s)) := ⟨_, rfl⟩
  obtain ⟨w, hw⟩ : ∃ w : ℕ → ℝ, w = fun j => v (c.free.getD j 0) := ⟨_, rfl⟩
  have hv' : ∀ s, v s = φ (fl (slotLink (corner o) s)) := fun s => by rw [hv]
  have hw' : ∀ j, w j = v (c.free.getD j 0) := fun j => by rw [hw]
  -- the norm in slot coordinates
  have hnorm : ∑ l, φ l ^ 2 = ∑ s ∈ range 96, v s ^ 2 := by
    rw [show (∑ s ∈ range 96, v s ^ 2) = ∑ s ∈ range 96, φ (fl (slotLink (corner o) s)) ^ 2 from
      sum_congr rfl fun s _ => by rw [hv' s]]
    rw [sum_fin_eq_range (fun l => φ l ^ 2) (fun n => φ (fl n) ^ 2) (fun n h => by rw [fl_val h])]
    refine sum_range_eq_of_inj (slotLink (corner o)) (slotOf (corner o)) (touches (corner o)) (fun n => φ (fl n) ^ 2)
      (fun s hs' => ⟨(hsf.1 s hs').1, (hsf.1 s hs').2.2⟩) (fun n hn ht => hsf.2.1 n hn ht) ?_
    intro n hn ht
    show φ (fl n) ^ 2 = 0
    rw [phi_untouch hφ n (by rwa [Nat.mod_eq_of_lt hn])]; ring
  -- the curvature over the patch
  have hcurv : ∑ p, curl φ p ^ 2 = ∑ q ∈ range 216, curl φ (flp (patchPlaq (corner o) q)) ^ 2 := by
    rw [sum_fin_eq_range (fun p => curl φ p ^ 2) (fun n => curl φ (flp n) ^ 2)
      (fun n h => by rw [flp_val h])]
    refine sum_range_eq_of_inj (patchPlaq (corner o)) (patchOf (corner o))
      (fun p => touches (corner o) (plaqLink p 0 % 1024) || touches (corner o) (plaqLink p 1 % 1024) ||
        touches (corner o) (plaqLink p 2 % 1024) || touches (corner o) (plaqLink p 3 % 1024))
      (fun n => curl φ (flp n) ^ 2) (fun q hq => hsf.2.2.1 q hq) ?_ ?_
    · intro p hp hP
      have key : ∀ i < 4, touches (corner o) (plaqLink p i % 1024) = true →
          patchOf (corner o) p < 216 ∧ patchPlaq (corner o) (patchOf (corner o) p) = p := by
        intro i hi ht
        obtain ⟨hmem, hlt⟩ := hgf.2.2.2.2.2 p hp i hi
        rw [Nat.mod_eq_of_lt hlt] at ht
        obtain ⟨h1, h2⟩ := hsf.2.1 _ hlt ht
        exact hsf.2.2.2 _ h1 p (by rw [h2]; exact hmem)
      simp only [Bool.or_eq_true] at hP
      rcases hP with ((h | h) | h) | h
      · exact key 0 (by norm_num) h
      · exact key 1 (by norm_num) h
      · exact key 2 (by norm_num) h
      · exact key 3 (by norm_num) h
    · intro p hp hP
      simp only [Bool.or_eq_false_iff] at hP
      obtain ⟨⟨⟨h0, h1⟩, h2⟩, h3⟩ := hP
      show curl φ (flp p) ^ 2 = 0
      rw [flp_val hp]
      unfold curl
      simp only
      rw [phi_untouch hφ _ h0, phi_untouch hφ _ h1, phi_untouch hφ _ h2, phi_untouch hφ _ h3]
      ring
  -- the curvature at a patch slot is the local combination
  have hloc : ∀ q < 216, curl φ (flp (patchPlaq (corner o) q)) =
      ((dlocOf (corner o) q).map fun e => (e.2 : ℝ) * v e.1).sum := by
    intro q hq
    have hterm : ∀ i : ℕ, (((if touches (corner o) (plaqLink (patchPlaq (corner o) q) i % 1024) = true then
        (if i < 2 then 1 else -1) else 0 : ℤ)) : ℝ) *
          v (slotOf (corner o) (plaqLink (patchPlaq (corner o) q) i % 1024)) =
        (if i < 2 then 1 else -1) * φ (fl (plaqLink (patchPlaq (corner o) q) i)) := by
      intro i
      rw [phi_ind hs ho hφ, hv']
      split_ifs <;> simp
    rw [flp_val (hsf.2.2.1 q hq).1]
    unfold dlocOf
    rw [List.map_map, show List.range 4 = [0, 1, 2, 3] from rfl]
    simp only [List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, Function.comp_apply]
    rw [hterm 0, hterm 1, hterm 2, hterm 3]
    unfold curl
    norm_num
    ring
  -- the coordinates of the slot vector in the fibre basis
  have hvZ : ∀ s < 96, v s = ∑ j ∈ range c.free.length, (c.Z s j : ℝ) * w j :=
    fun s hs' => by
      rw [hv']; simp only [hw', hv']; exact slot_value hs ho hc hφ hs'
  have hKw : ∀ q < 216, ((dlocOf (corner o) q).map fun e => (e.2 : ℝ) * v e.1).sum =
      ∑ j ∈ range c.free.length, (c.Kq (corner o) q j : ℝ) * w j := by
    intro q _
    unfold KCert.Kq
    rw [sum_list_comm]
    refine congrArg List.sum (List.map_congr_left fun e he => ?_)
    rcases dloc_slot hs ho q e he with h | h
    · simp [h]
    · rw [hvZ e.1 h]
  -- positivity of the certified form
  obtain ⟨_, hR, _, hB, hP⟩ := kappaCheck_parts hc
  obtain ⟨_, _, _, hwC, hwM, hK⟩ := kRanges_parts hR
  unfold kBound at hB
  rw [decide_eq_true_eq, KCert.βHk_eq] at hB
  simp only [natpow_eq] at hB
  unfold kPsd at hP
  rw [c.Hpk_eq hs ho] at hP
  have hpsd := qf_nonneg_of_psdScan (H := c.H (corner o)) (βH := c.βH) hK hwM
    (fun i _ j _ => c.H_symm (corner o) i j) (fun i _ j _ => c.abs_H_le hwC (corner o) i j) hB hP w
  have hqf : qf c.free.length (fun i j => (c.H (corner o) i j : ℝ)) w = 2 ^ c.sig *
      (3321 * ∑ q ∈ range 216, (∑ j ∈ range c.free.length, (c.Kq (corner o) q j : ℝ) * w j) ^ 2 -
        500 * ∑ s ∈ range 96, (∑ j ∈ range c.free.length, (c.Z s j : ℝ) * w j) ^ 2) := by
    have e : (fun i j => (c.H (corner o) i j : ℝ)) = fun i j => (2 : ℝ) ^ c.sig *
        (3321 * (∑ q ∈ range 216, (c.Kq (corner o) q i : ℝ) * c.Kq (corner o) q j) -
          500 * ∑ s ∈ range 96, (c.Z s i : ℝ) * c.Z s j) := by
      funext i j; unfold KCert.H; push_cast; ring
    rw [e, qf_lin, qf_gram, qf_gram]
  rw [hqf] at hpsd
  have hsig : (0 : ℝ) < 2 ^ c.sig := by positivity
  have hmain : 500 * ∑ s ∈ range 96, (∑ j ∈ range c.free.length, (c.Z s j : ℝ) * w j) ^ 2 ≤
      3321 * ∑ q ∈ range 216, (∑ j ∈ range c.free.length, (c.Kq (corner o) q j : ℝ) * w j) ^ 2 := by
    have := (mul_nonneg_iff_of_pos_left hsig).mp hpsd
    linarith
  rw [hnorm, hcurv]
  have e1 : ∑ s ∈ range 96, v s ^ 2 = ∑ s ∈ range 96, (∑ j ∈ range c.free.length, (c.Z s j : ℝ) * w j) ^ 2 :=
    sum_congr rfl fun s hs' => by rw [hvZ s (mem_range.mp hs')]
  have e2 : ∑ q ∈ range 216, curl φ (flp (patchPlaq (corner o) q)) ^ 2 =
      ∑ q ∈ range 216, (∑ j ∈ range c.free.length, (c.Kq (corner o) q j : ℝ) * w j) ^ 2 :=
    sum_congr rfl fun q hq => by
      rw [hloc q (mem_range.mp hq), hKw q (mem_range.mp hq)]
  rw [e1, e2]
  exact hmain

end KappaClass

section KappaAll

theorem trL_lin (t y μ : ℕ) (hμ : μ < 4) : trL t (4 * y + μ) = 4 * trSite t y + μ := by
  unfold trL
  rw [show (4 * y + μ) / 4 = y by omega, show (4 * y + μ) % 4 = μ by omega]

theorem trL_lt (hg : geomCheck = true) {t l : ℕ} (ht : t < 16) (hl : l < 1024) : trL t l < 1024 := by
  have := ((geom_facts hg).1 t ht (l / 4) (by omega)).2.1
  unfold trL; omega

theorem trL_trL (hg : geomCheck = true) {t l : ℕ} (ht : t < 16) (hl : l < 1024) :
    trL t (trL t l) = l := by
  have h := ((geom_facts hg).1 t ht (l / 4) (by omega)).1
  unfold trL
  rw [show (4 * trSite t (l / 4) + l % 4) / 4 = trSite t (l / 4) by omega,
    show (4 * trSite t (l / 4) + l % 4) % 4 = l % 4 by omega, h]
  omega

theorem trP_lt (hg : geomCheck = true) {t p : ℕ} (ht : t < 16) (hp : p < 1536) : trP t p < 1536 := by
  have := ((geom_facts hg).1 t ht (p / 6) (by omega)).2.1
  unfold trP; omega

theorem trP_trP (hg : geomCheck = true) {t p : ℕ} (ht : t < 16) (hp : p < 1536) :
    trP t (trP t p) = p := by
  have h := ((geom_facts hg).1 t ht (p / 6) (by omega)).1
  unfold trP
  rw [show (6 * trSite t (p / 6) + p % 6) / 6 = trSite t (p / 6) by omega,
    show (6 * trSite t (p / 6) + p % 6) % 6 = p % 6 by omega, h]
  omega

theorem plaqLink_tr (hg : geomCheck = true) {t p : ℕ} (ht : t < 16) (hp : p < 1536) (i : ℕ) :
    plaqLink (trP t p) i = trL t (plaqLink p i) := by
  have hs : p / 6 < 256 := by omega
  have hst := (geom_facts hg).1 t ht (p / 6) hs
  have hμ := planeMu_lt (p % 6)
  have hν := planeNu_lt (p % 6)
  unfold plaqLink trP
  dsimp only
  rw [show (6 * trSite t (p / 6) + p % 6) / 6 = trSite t (p / 6) by omega,
    show (6 * trSite t (p / 6) + p % 6) % 6 = p % 6 by omega]
  split_ifs
  · rw [trL_lin _ _ _ hμ]
  · rw [trL_lin _ _ _ hν, (hst.2.2 _ hμ).1]
  · rw [trL_lin _ _ _ hμ, (hst.2.2 _ hν).1]
  · rw [trL_lin _ _ _ hν]

theorem inBox_tr (hg : geomCheck = true) {t c x : ℕ} (ht : t < 16) (hc : c < 256) (hx : x < 256) :
    inBox (trSite t c) (trSite t x) = inBox c x := by
  have hcx := (geom_facts hg).1 t ht x hx
  have hcc := (geom_facts hg).1 t ht c hc
  have hb : ∀ a, bit t a < 2 := fun a => by unfold bit; exact Nat.mod_lt _ (by norm_num)
  unfold inBox
  rw [(hcx.2.2 0 (by norm_num)).2, (hcx.2.2 1 (by norm_num)).2, (hcx.2.2 2 (by norm_num)).2,
    (hcx.2.2 3 (by norm_num)).2, (hcc.2.2 0 (by norm_num)).2, (hcc.2.2 1 (by norm_num)).2,
    (hcc.2.2 2 (by norm_num)).2, (hcc.2.2 3 (by norm_num)).2]
  have e : ∀ a, decide (((coord x a + 2 * bit t a) % 4 + 4 - (coord c a + 2 * bit t a) % 4) % 4 < 2)
      = decide ((coord x a + 4 - coord c a) % 4 < 2) := by
    intro a
    have h1 := coord_lt x a
    have h2 := coord_lt c a
    have h3 := hb a
    exact decide_eq_decide.mpr (by omega)
  rw [e 0, e 1, e 2, e 3]

theorem touches_tr (hg : geomCheck = true) {t c l : ℕ} (ht : t < 16) (hc : c < 256) (hl : l < 1024) :
    touches (trSite t c) (trL t l) = touches c l := by
  have hst := (geom_facts hg).1 t ht (l / 4) (by omega)
  have hstep := (geom_facts hg).2.2.2.2.1 (l / 4) (by omega) (l % 4) (Nat.mod_lt _ (by norm_num))
  unfold touches trL
  rw [show (4 * trSite t (l / 4) + l % 4) / 4 = trSite t (l / 4) by omega,
    show (4 * trSite t (l / 4) + l % 4) % 4 = l % 4 by omega,
    (hst.2.2 _ (Nat.mod_lt _ (by norm_num))).1, inBox_tr hg ht hc (by omega),
    inBox_tr hg ht hc hstep]

/-- The translation by `2t` as a permutation of the links. -/
def trLink (t : ℕ) (l : Fin 1024) : Fin 1024 := fl (trL t l)

/-- The translation by `2t` as a permutation of the plaquettes. -/
def trPlaq (t : ℕ) (p : Fin 1536) : Fin 1536 := flp (trP t p)

theorem trLink_val (hg : geomCheck = true) {t : ℕ} (ht : t < 16) (l : Fin 1024) :
    (trLink t l).val = trL t l := Nat.mod_eq_of_lt (trL_lt hg ht l.2)

theorem trLink_invol (hg : geomCheck = true) {t : ℕ} (ht : t < 16) :
    Function.Involutive (trLink t) := by
  intro l
  apply Fin.ext
  rw [trLink_val hg ht, trLink_val hg ht, trL_trL hg ht l.2]

theorem trPlaq_invol (hg : geomCheck = true) {t : ℕ} (ht : t < 16) :
    Function.Involutive (trPlaq t) := by
  intro p
  apply Fin.ext
  show trP t ((trP t p) % 1536) % 1536 = p
  rw [Nat.mod_eq_of_lt (trP_lt hg ht p.2), trP_trP hg ht p.2, Nat.mod_eq_of_lt p.2]

theorem curl_tr (hg : geomCheck = true) {t : ℕ} (ht : t < 16) (φ : Fin 1024 → ℝ) (p : Fin 1536) :
    curl (fun l => φ (trLink t l)) p = curl φ (trPlaq t p) := by
  have hp' : (trPlaq t p).val = trP t p := Nat.mod_eq_of_lt (trP_lt hg ht p.2)
  have key : ∀ i < 4, trLink t (fl (plaqLink p i)) = fl (plaqLink (trPlaq t p) i) := by
    intro i hi
    have hlt := ((geom_facts hg).2.2.2.2.2 p p.2 i hi).2
    apply Fin.ext
    rw [trLink_val hg ht]
    show trL t (plaqLink p i % 1024) = plaqLink (trPlaq t p) i % 1024
    rw [hp', plaqLink_tr hg ht p.2, Nat.mod_eq_of_lt hlt,
      Nat.mod_eq_of_lt (trL_lt hg ht hlt)]
  unfold curl
  beta_reduce
  rw [key 0 (by norm_num), key 1 (by norm_num), key 2 (by norm_num), key 3 (by norm_num)]

theorem fibre_tr (hg : geomCheck = true) {o t : ℕ} (ht : t < 16)
    {φ : Fin 1024 → ℝ} (hφ : φ ∈ fibre (trSite t (corner o))) :
    (fun l => φ (trLink t l)) ∈ fibre (corner o) := by
  have hc : corner o < 256 := site4_lt _ _ _ _
  refine ⟨⟨fun l hl => ?_, fun r => ?_⟩, fun l hl => ?_⟩
  · apply hφ.1.1
    rw [trLink_val hg ht, (geom_facts hg).2.1 t ht l l.2]; exact hl
  · -- the translated pin row
    have hr : (r : ℕ) / 16 < 4 := by omega
    have hZ : ((r : ℕ) % 16) ^^^ t < 16 :=
      Nat.xor_lt_two_pow (n := 4) (by omega) (by omega)
    have hr' : 16 * ((r : ℕ) / 16) + (((r : ℕ) % 16) ^^^ t) < 64 := by omega
    have e1 : (16 * ((r : ℕ) / 16) + (((r : ℕ) % 16) ^^^ t)) % 16 = ((r : ℕ) % 16) ^^^ t := by
      omega
    have e2 : (16 * ((r : ℕ) / 16) + (((r : ℕ) % 16) ^^^ t)) / 16 = (r : ℕ) / 16 := by omega
    rw [← hφ.1.2 ⟨_, hr'⟩]
    unfold pinSum
    simp only [e1, e2]
    refine sum_congr rfl fun i _ => ?_
    have hbs : blockSite ((r : ℕ) % 16) i < 256 := site4_lt _ _ _ _
    have htb := (geom_facts hg).2.2.1 t ht ((r : ℕ) % 16) (by omega) i i.2
    have hst := (geom_facts hg).1 t ht _ hbs
    have hstep := (geom_facts hg).2.2.2.2.1 _ hbs _ hr
    have ha : trLink t (fl (4 * blockSite ((r : ℕ) % 16) i + (r : ℕ) / 16)) =
        fl (4 * blockSite (((r : ℕ) % 16) ^^^ t) i + (r : ℕ) / 16) := by
      apply Fin.ext
      rw [trLink_val hg ht]
      show trL t ((4 * blockSite ((r : ℕ) % 16) i + (r : ℕ) / 16) % 1024) =
        (4 * blockSite (((r : ℕ) % 16) ^^^ t) i + (r : ℕ) / 16) % 1024
      rw [Nat.mod_eq_of_lt (by omega), trL_lin _ _ _ hr, htb]
      have := site4_lt (2 * bit (((r : ℕ) % 16) ^^^ t) 0 + bit i 0)
        (2 * bit (((r : ℕ) % 16) ^^^ t) 1 + bit i 1) (2 * bit (((r : ℕ) % 16) ^^^ t) 2 + bit i 2)
        (2 * bit (((r : ℕ) % 16) ^^^ t) 3 + bit i 3)
      unfold blockSite
      omega
    have hb' : trLink t (fl (4 * step (blockSite ((r : ℕ) % 16) i) ((r : ℕ) / 16) + (r : ℕ) / 16)) =
        fl (4 * step (blockSite (((r : ℕ) % 16) ^^^ t) i) ((r : ℕ) / 16) + (r : ℕ) / 16) := by
      apply Fin.ext
      rw [trLink_val hg ht]
      show trL t ((4 * step (blockSite ((r : ℕ) % 16) i) ((r : ℕ) / 16) + (r : ℕ) / 16) % 1024) =
        (4 * step (blockSite (((r : ℕ) % 16) ^^^ t) i) ((r : ℕ) / 16) + (r : ℕ) / 16) % 1024
      rw [Nat.mod_eq_of_lt (by omega), trL_lin _ _ _ hr, ← (hst.2.2 _ hr).1, htb]
      have := (geom_facts hg).2.2.2.2.1 (blockSite (((r : ℕ) % 16) ^^^ t) i) (site4_lt _ _ _ _) _ hr
      omega
    rw [ha, hb']
  · apply hφ.2
    rw [trLink_val hg ht, touches_tr hg ht hc l.2]; exact hl

/-- **The κ bound for every box**, from valid certificates for the sixteen class boxes. -/
theorem kappa_of_certs (hg : geomCheck = true) (hs : slotCheck = true) (cs : ℕ → KCert)
    (hk : ∀ o < 16, kappaCheck o (cs o) = true) (b : Fin 256) {φ : Fin 1024 → ℝ}
    (hφ : φ ∈ fibre b) : ∑ l, φ l ^ 2 ≤ 3321 / 500 * ∑ p, curl φ p ^ 2 := by
  obtain ⟨hb, ho, ht⟩ := (geom_facts hg).2.2.2.1 b b.2
  set o := clsOf b
  set t := trOf b
  rw [← hb] at hφ
  have h := kappa_class hg hs ho (hk o ho) (fibre_tr hg ht hφ)
  have e1 : ∑ l, (fun l => φ (trLink t l)) l ^ 2 = ∑ l, φ l ^ 2 :=
    Equiv.sum_comp (Function.Involutive.toPerm _ (trLink_invol hg ht)) (fun l => φ l ^ 2)
  have e2 : ∑ p, curl (fun l => φ (trLink t l)) p ^ 2 = ∑ p, curl φ p ^ 2 := by
    simp only [curl_tr hg ht]
    exact Equiv.sum_comp (Function.Involutive.toPerm _ (trPlaq_invol hg ht))
      (fun p => curl φ p ^ 2)
  rw [e1, e2] at h
  linarith

end KappaAll


