  one_sub_pprod_ge_avg _ posSeq_isOrthProj_example (posSeq_comm blockP₁) (by norm_num) F

/-- The zero projection on `ℝ` (one block, weight `1`, `g = 1`). -/
theorem zero_isOrthProj : IsOrthProj (0 : ℝ →ₗ[ℝ] ℝ) := ⟨fun u v => by simp, by simp⟩

/-- `first_chaos_transfer` on `ℝ` with one block, `Q = 0`, `w = 1`, `g = 1`, `r = 3`. -/
theorem first_chaos_transfer_example (u : ℝ) :
    1 * ‖u‖ ^ 2 ≤ ∑ _x : Unit, (1 : ℝ) * inner ℝ u ((1 - pprod (fun _ => (0 : ℝ →ₗ[ℝ] ℝ)) 3) u) :=
  first_chaos_transfer (fun _ => 1) (fun _ => zero_le_one) (fun _ _ => 0)
    (fun _ _ => zero_isOrthProj) (fun _ _ _ => rfl) (by norm_num)
    (fun _ _ u => by simp) u

/-- `first_chaos_transfer_restrict` with the same data and `W = ℝ`. -/
theorem first_chaos_transfer_restrict_example :
    ∀ u ∈ (⊤ : Submodule ℝ ℝ),
      1 * ‖u‖ ^ 2 ≤ ∑ _x : Unit, (1 : ℝ) * inner ℝ u ((1 - pprod (fun _ => (0 : ℝ →ₗ[ℝ] ℝ)) 3) u) :=
  first_chaos_transfer_restrict ⊤ (fun _ => 1) (fun _ => zero_le_one) (fun _ _ => 0)
    (fun _ _ => zero_isOrthProj) (fun _ _ _ => rfl) (by norm_num)
    (fun _ _ u => by simp)

end ClosedApplications

