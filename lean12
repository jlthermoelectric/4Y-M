    (fun i => EuclideanSpace.proj i)
    (fun i => ContinuousLinearMap.toSpanSingleton ℝ (EuclideanSpace.single i 1))
    (fun _ _ => ⊤) (fun p => p.1) ?_ ?_ ?_ ?_ ?_ ?_ c
  · intro c
    ext j
    fin_cases j <;> simp [Fin.sum_univ_two]
  · intro c
    rw [EuclideanSpace.real_norm_sq_eq, one_mul]
    simp
  · intro i
