    simp only [Matrix.mulVec, dotProduct_single, mul_one]
  rw [e1, Pi.zero_apply, Bm_eq, Bm_eq]
  have e2 : ((192 : Fin 784) : ℕ) = 192 := rfl
  have e3 : ((240 : Fin 784) : ℕ) = 240 := rfl
  rw [e2, e3, h', sub_self]

/-- **`cube_gap` at a concrete nonzero element of `ker B`.** -/
theorem cube_gap_example : cubeConstr (extV gapExample) ∧ gapExample ≠ 0 ∧
    100 / 2217 * ∑ a, gapExample a ^ 2 ≤ cubeQ (extV gapExample) := by
  have hc : cubeConstr (extV gapExample) := (cubeConstr_zero_iff _).mpr gapExample_kerB
  refine ⟨hc, fun h => ?_, cube_gap _ hc⟩
  have := congrFun h 192
