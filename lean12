/-! ## 16. The main theorems -/

section Main

open Matrix

/-- Every one of the 1668 exterior links is certified. -/
theorem exterior_bound {e : ℕ} (he : e < 1668) : LinkBound (eLink e) := by
  have h := (allBelow_iff.mp order_pos) e he
  rw [Bool.and_eq_true] at h
  obtain ⟨h1, h2⟩ := h
  have hm : dig 11 posPk e < 1668 := Nat.blt_eq.mp h1
  have hme : dig 11 orderPk (dig 11 posPk e) = e := Nat.eq_of_beq_eq_true h2
  have hmem : e ∈ allEntries.map (fun x => x.1) := by
    rw [allEntries_order]
    exact List.mem_map.mpr ⟨dig 11 posPk e, List.mem_range.mpr hm, hme⟩
  obtain ⟨x, hx, hxe⟩ := List.mem_map.mp hmem
  have h' := (link_bound (allEntries_ok x hx)).2
  rw [hxe] at h'
  exact h'

/-- An active link outside `V` that is not one of the 1668 exterior links lies in no plaquette
meeting `V` and in no block average of `W`, so `f_j = 0`, `g_j = 0`, and `u_j = 0`. -/
theorem other_bound {j : Link} (hjt : isTree j = false) (hjV : inV j = false)
    (hje : ∀ e < 1668, eLink e ≠ j) : LinkBound j := by
  have hf : fv j = 0 := by
    funext a
    simp [fv, Matrix.mulVec, dotProduct, dsrc_other hjt hjV hje]
  have hg : gv j = 0 := funext (gv_other hjt hjV hje)
  have hfeas : Bm *ᵥ (0 : Fin 784 → ℝ) = gv j := by rw [hg, Matrix.mulVec_zero]
  have h0 : CubeCert.IsConstrMin Hm (fv j) Bm (gv j) 0 :=
    CubeCert.isConstrMin_of_stationary Hm_symm (by norm_num : (0 : ℝ) ≤ 100 / 2217) cube_kerGap
      hfeas (fun e _ => by rw [hf, Matrix.mulVec_zero, zero_add, dotProduct_zero])
  obtain ⟨w, -, huniq⟩ := CubeCert.existsUnique_isConstrMin Hm_symm
    (by norm_num : (0 : ℝ) < 100 / 2217) cube_kerGap (fv j) ⟨0, hfeas⟩
  have hw0 : (0 : Fin 784 → ℝ) = w := huniq 0 h0
  refine ⟨⟨0, (isCubeMin_iff _ 0).mpr h0, fun v hv => ?_⟩, fun u hu => ?_⟩
  · rw [huniq v ((isCubeMin_iff _ v).mp hv), ← hw0]
  · rw [huniq u ((isCubeMin_iff _ u).mp hu), ← hw0]
    norm_num [CubeCert.l1]

/-- **The constrained cube coefficient at `n = 4`** (`thm:constrainedcube` with `n = 4`).
For every active link `j` outside `V`, there is a unique `u_j ∈ ℝ^V` that minimises
`Q(u + δ_j) = ∑_{p ∩ V ≠ ∅} (d(u + δ_j))_p²` subject to `V_{y,μ}(u + δ_j) = 0` for every block
`y ∈ W = {0,1}⁴` and every `μ` (that is, `B u = g_j`), and `‖u_j‖₁ ≤ 1248/100`. The 1668
exterior links (`eLink`) are certified by their class certificates; every other active link
outside `V` has `f_j = 0`, `g_j = 0` and `u_j = 0`. -/
theorem cube_response (j : Link) (hj : isTree j = false) (hjV : inV j = false) :
    (∃! u : Fin 784 → ℝ, IsCubeMin j u) ∧ ∀ u, IsCubeMin j u → CubeCert.l1 u ≤ 1248 / 100 := by
  by_cases h : ∃ e < 1668, eLink e = j
  · obtain ⟨e, he, rfl⟩ := h
    exact exterior_bound he
  · exact other_bound hj hjV (fun e he he' => h ⟨e, he, he'⟩)

end Main

