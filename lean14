/-! # Part XIII. `GaussianSchur4D`: an exact infrared certificate for the Gaussian-order split in four dimensions (new; uses Part XI) -/

/-!
# Exact infrared certificate for the Gaussian-order Schur split in four dimensions

## (a) Formal target

At Gaussian order (`β_W → ∞`, first chaos, abelian linearisation) in four dimensions (`d = 4`), with
fine and coarse cubes `x + {0,1}⁴` of side `n = n_c = 2` at every base point (weights `1/16`),
straight two-link blocking, `α = β = 1/20`, and the coarse form `G` replaced by the upper bound
`G⁺⁺ ≥ G⁺ ≥ G` (`G⁺` from the exact free fine box `[−2, 4]⁴`, 8232 links; `G⁺⁺` from a dyadic upper
bound of the inverse of its precision block), the split `D ≥ α (I − Π) + β G` holds at every Bloch
momentum in some punctured neighbourhood of `k = 0` (by the infrared reduction of the research notes,
not formalised; the neighbourhood is not quantified) if the `49 × 49` symmetric matrix `Φ₀` at
`k = 0` is positive definite (coordinates `(m, η)`: four coarse components and forty-five fibre components; the gauge
constraint on `m` is dropped, i.e. the unconstrained form, which only strengthens the condition).
This part checks `Φ₀ ⪰ (1/400) I` over `ℚ`.

## (b) What is proved

* `qf_ge_neg_rowsum`: a symmetric rational matrix whose absolute row sums are at most `ρ` has
  quadratic form at least `−ρ Σ xᵢ²`.
* `Cert.margin_of_certCheck` (generic: every size `n`, all data): if the Boolean checker
  `Cert.certCheck` accepts integer lists `P` (a matrix over the common denominator `N`), `L` (a
  lower-triangular factor over `B`) and `d` (pivots over `B`), then
  `(cn/cd − rn/rd) Σ xᵢ² ≤ Σᵢ Σⱼ xᵢ (P i j / N) xⱼ` for every `x : Fin n → ℚ`. The checker tests
  `d ≥ 0`, the symmetry of `P`, and the absolute row sums of the residual
  `R = P/N − (cn/cd) I − L diag(d) Lᵀ / B³` against `rn/rd`, all scaled to integers; the soundness
  proof combines `qf_ge_neg_rowsum` with `GaussianSchur3D.qf_nonneg_of_ldl` (Part XI).
* `Infrared.phi0_margin`: `(1/400) Σ xᵢ² ≤ Σᵢ Σⱼ xᵢ Φ₀ᵢⱼ xⱼ` for every `x : Fin 49 → ℚ`, where
  `Φ₀ = Infrared.Phi0` is stated exactly as `Infrared.Pdata / N` with the common denominator
  `N = 22858846741463040`. It instantiates the generic theorem with `B = 2^30`,
  `cn/cd = 2501/1000000 = 1/400 + 10⁻⁶` and `rn/rd = 1/1000000`, using one kernel evaluation of the checker
  (`Infrared.cert_ok`).

The statements quantify over rational vectors; the extension to real and complex vectors, by
density and continuity, is not formalised.

## (c) What is not proved here

The entries of `Φ₀` were produced from the lattice objects (the Bloch symbols of `D`, `Π` at
`k = 0` and `G⁺⁺`) by exact rational arithmetic outside Lean (research notes; the
matrix `Pdata / N` coincides entry by entry with the research notes' `InfraredSchur4D.json`, SHA-256 prefix
8fe38cdb35d6932d, checked by script). That identification, the bounds `G ≤ G⁺ ≤ G⁺⁺` and the infrared
reduction are not kernel-checked. No statement for `k ≠ 0`, no uniform-in-`k` statement and no
torus statement is made here. Nothing in this part concerns the interacting Wilson measure, higher
chaoses or a gap: at Gaussian order the coarse gap tends to zero in infinite volume.

## (d) Axioms and checks

The checker is evaluated once, by `decide +kernel`, on integer lists (`Infrared.cert_ok`). Every
declaration depends only on `propext`, `Classical.choice` and `Quot.sound`; this part contains no `sorry`, `admit`, `axiom` declarations, `native_decide`, `implemented_by` or `set_option`.

## (e) Scope

Arithmetic certificate for a Gaussian-order lattice model. This part is not a statement about the
Yang–Mills measure and not a proof of a mass gap.
-/

namespace GaussianSchur4D

open Finset

/-- Row-sum lower bound: a symmetric rational matrix with absolute row sums at most `ρ` has quadratic
form at least `−ρ Σ xᵢ²`. -/
theorem qf_ge_neg_rowsum {n : ℕ} (R : Fin n → Fin n → ℚ) (ρ : ℚ)
    (hsymm : ∀ i j, R i j = R j i) (hrow : ∀ i, ∑ j, |R i j| ≤ ρ) (x : Fin n → ℚ) :
    -(ρ * ∑ i, x i ^ 2) ≤ ∑ i, ∑ j, x i * R i j * x j := by
  have h1 : ∀ i j, -(|R i j| * (x i ^ 2 + x j ^ 2) / 2) ≤ x i * R i j * x j := by
    intro i j
    have hxy : |x i| * |x j| ≤ (x i ^ 2 + x j ^ 2) / 2 := by
      nlinarith [sq_nonneg (|x i| - |x j|), sq_abs (x i), sq_abs (x j)]
    have hR : 0 ≤ |R i j| := abs_nonneg _
    have habs : |x i * R i j * x j| = |R i j| * (|x i| * |x j|) := by
      rw [abs_mul, abs_mul]; ring
    have hm := mul_le_mul_of_nonneg_left hxy hR
    have hn := neg_abs_le (x i * R i j * x j)
    rw [habs] at hn
    linarith
  have hs : ∑ i, ∑ j, |R i j| * x j ^ 2 = ∑ i, ∑ j, |R i j| * x i ^ 2 := by
    rw [Finset.sum_comm]
    refine sum_congr rfl fun i _ => sum_congr rfl fun j _ => ?_
    rw [hsymm]
  have hrow' : ∑ i, ∑ j, |R i j| * x i ^ 2 ≤ ρ * ∑ i, x i ^ 2 := by
    rw [mul_sum]
    refine sum_le_sum fun i _ => ?_
    rw [← sum_mul]
    exact mul_le_mul_of_nonneg_right (hrow i) (sq_nonneg _)
  have e : ∑ i, ∑ j, |R i j| * (x i ^ 2 + x j ^ 2) / 2
      = (∑ i, ∑ j, |R i j| * x i ^ 2 + ∑ i, ∑ j, |R i j| * x j ^ 2) / 2 := by
    rw [← sum_add_distrib, sum_div]
    refine sum_congr rfl fun i _ => ?_
    rw [← sum_add_distrib, sum_div]
    refine sum_congr rfl fun j _ => ?_
    ring
  have h2 : -(ρ * ∑ i, x i ^ 2) ≤ -(∑ i, ∑ j, |R i j| * (x i ^ 2 + x j ^ 2) / 2) := by
    rw [e, hs]; linarith
  have h3 : -(∑ i, ∑ j, |R i j| * (x i ^ 2 + x j ^ 2) / 2) ≤ ∑ i, ∑ j, x i * R i j * x j := by
    rw [← sum_neg_distrib]
    refine sum_le_sum fun i _ => ?_
    rw [← sum_neg_distrib]
    exact sum_le_sum fun j _ => h1 i j
  exact h2.trans h3

namespace Cert

/-! ### A certificate checker on integer lists, and its soundness for every size -/

/-- Entry `k` of an integer list, `0` past the end (equal to `l.getD k 0`, `nthZ_eq`). -/
def nthZ : List ℤ → ℕ → ℤ
  | [], _ => 0
  | a :: _, 0 => a
  | _ :: l, k + 1 => nthZ l k

/-- Row `k` of a list of rows, `[]` past the end (equal to `l.getD k []`, `nthL_eq`). -/
def nthL : List (List ℤ) → ℕ → List ℤ
  | [], _ => []
  | a :: _, 0 => a
  | _ :: l, k + 1 => nthL l k

/-- `∑_{k < m} f k`, by recursion on `m`. -/
def sumTo (f : ℕ → ℕ) : ℕ → ℕ
  | 0 => 0
  | m + 1 => sumTo f m + f m

/-- `∀ k < m, p k`, as a Boolean, by recursion on `m`. -/
def allBelow (p : ℕ → Bool) : ℕ → Bool
  | 0 => true
  | m + 1 => allBelow p m && p m

/-- `∑_k a_k b_k c_k`, stopping at the end of the shortest list. -/
def dot3 : List ℤ → List ℤ → List ℤ → ℤ
  | [], _, _ => 0
  | _ :: _, [], _ => 0
  | _ :: _, _ :: _, [] => 0
  | a :: as, b :: bs, c :: cs => a * b * c + dot3 as bs cs

/-- The residual entry `(i, j)` scaled by `N·cd·B³`: the residual is
`R = P/N − (cn/cd) I − L diag(d) Lᵀ / B³` (see `margin_of_certCheck`). -/
def resEntry (N B cn cd : ℕ) (P Ls : List (List ℤ)) (d : List ℤ) (i j : ℕ) : ℤ :=
  ((cd * B ^ 3 : ℕ) : ℤ) * nthZ (nthL P i) j - (if i = j then ((cn * N * B ^ 3 : ℕ) : ℤ) else 0)
    - ((N * cd : ℕ) : ℤ) * dot3 (nthL Ls i) d (nthL Ls j)

/-- The certificate checker: positivity of the scales, `d ≥ 0`, rows of `L` of length at most `n`,
symmetry of `P`, and absolute row sums of the residual at most `rn/rd` (in integers). -/
def certCheck (n N B cn cd rn rd : ℕ) (P Ls : List (List ℤ)) (d : List ℤ) : Bool :=
  decide (0 < N) && decide (0 < B) && decide (0 < cd) && decide (0 < rd) &&
  allBelow (fun k => decide (0 ≤ nthZ d k)) n &&
  allBelow (fun i => decide ((nthL Ls i).length ≤ n)) n &&
  allBelow (fun i => allBelow (fun j => decide (nthZ (nthL P i) j = nthZ (nthL P j) i)) n) n &&
  allBelow (fun i => decide (rd * sumTo (fun j => (resEntry N B cn cd P Ls d i j).natAbs) n
    ≤ rn * (N * cd * B ^ 3))) n

theorem nthZ_eq (l : List ℤ) (k : ℕ) : nthZ l k = l.getD k 0 := by
  induction l generalizing k with
  | nil => simp [nthZ]
  | cons a l ih =>
    cases k with
    | zero => simp [nthZ]
    | succ k => simp [nthZ, ih]

theorem nthL_eq (l : List (List ℤ)) (k : ℕ) : nthL l k = l.getD k [] := by
  induction l generalizing k with
  | nil => simp [nthL]
  | cons a l ih =>
    cases k with
    | zero => simp [nthL]
    | succ k => simp [nthL, ih]

theorem sumTo_eq (f : ℕ → ℕ) (m : ℕ) : sumTo f m = ∑ k ∈ range m, f k := by
  induction m with
  | zero => rfl
  | succ m ih => rw [sumTo, ih, sum_range_succ]

theorem allBelow_iff (p : ℕ → Bool) (m : ℕ) : allBelow p m = true ↔ ∀ k < m, p k = true := by
  induction m with
  | zero => simp [allBelow]
  | succ m ih =>
    simp only [allBelow, Bool.and_eq_true, ih]
    constructor
    · rintro ⟨h1, h2⟩ k hk
      rcases Nat.lt_succ_iff_lt_or_eq.mp hk with hk | rfl
      · exact h1 k hk
      · exact h2
    · intro h
      exact ⟨fun k hk => h k (Nat.lt_succ_of_lt hk), h m (Nat.lt_succ_self m)⟩

theorem dot3_eq (a b c : List ℤ) (m : ℕ) (h : a.length ≤ m) :
    dot3 a b c = ∑ k ∈ range m, nthZ a k * nthZ b k * nthZ c k := by
  induction a generalizing b c m with
  | nil => simp [dot3, nthZ]
  | cons x a ih =>
    cases m with
    | zero => simp at h
    | succ m =>
      rw [sum_range_succ']
      cases b with
      | nil => simp [dot3, nthZ]
      | cons y b =>
        cases c with
        | nil => simp [dot3, nthZ]
        | cons z c =>
          simp only [dot3, nthZ]
          rw [ih b c m (by simpa using h)]
          ring

/-- The rational factor `L / B` on `Fin n`. -/
def lq (B : ℕ) (Ls : List (List ℤ)) (n : ℕ) : Fin n → Fin n → ℚ :=
  fun i k => (nthZ (nthL Ls i) k : ℚ) / B

/-- The rational pivots `d / B` on `Fin n`. -/
def dq (B : ℕ) (d : List ℤ) (n : ℕ) : Fin n → ℚ := fun k => (nthZ d k : ℚ) / B

/-- `(L/B) diag(d/B) (L/B)ᵀ` on `Fin n`. -/
def ldl (B : ℕ) (Ls : List (List ℤ)) (d : List ℤ) (n : ℕ) : Fin n → Fin n → ℚ :=
  fun i j => ∑ k, lq B Ls n i k * dq B d n k * lq B Ls n j k

/-- **Soundness of the checker** (generic, every size and all data). -/
theorem margin_of_certCheck {n N B cn cd rn rd : ℕ} {P Ls : List (List ℤ)} {d : List ℤ}
    (h : certCheck n N B cn cd rn rd P Ls d = true) (Φ : Fin n → Fin n → ℚ)
    (hΦ : ∀ i j, Φ i j = ((P.getD i []).getD j 0 : ℚ) / N) (x : Fin n → ℚ) :
    ((cn : ℚ) / cd - (rn : ℚ) / rd) * ∑ i, x i ^ 2 ≤ ∑ i, ∑ j, x i * Φ i j * x j := by
  simp only [certCheck, Bool.and_eq_true, decide_eq_true_eq, allBelow_iff] at h
  obtain ⟨⟨⟨⟨⟨⟨⟨hN, hB⟩, hcd⟩, hrd⟩, hD⟩, hlen⟩, hsym⟩, hrow⟩ := h
  have hNq : (0 : ℚ) < N := by exact_mod_cast hN
  have hBq : (0 : ℚ) < B := by exact_mod_cast hB
  have hcdq : (0 : ℚ) < cd := by exact_mod_cast hcd
  have hrdq : (0 : ℚ) < rd := by exact_mod_cast hrd
  have hN0 : (N : ℚ) ≠ 0 := hNq.ne'
  have hB0 : (B : ℚ) ≠ 0 := hBq.ne'
  have hcd0 : (cd : ℚ) ≠ 0 := hcdq.ne'
  have hS : (0 : ℚ) < (N : ℚ) * cd * B ^ 3 := by positivity
  -- the list dot product is the `Fin n` sum
  have hdot : ∀ i j : Fin n, ((dot3 (nthL Ls i) d (nthL Ls j) : ℤ) : ℚ)
      = (B : ℚ) ^ 3 * ldl B Ls d n i j := by
    intro i j
    rw [dot3_eq _ _ _ n (hlen i i.2), ← Fin.sum_univ_eq_sum_range]
    push_cast
    simp only [ldl, lq, dq, mul_sum]
    refine sum_congr rfl fun k _ => ?_
    field_simp
  -- the integer residual entry is the scaled rational residual
  have hres : ∀ i j : Fin n, ((resEntry N B cn cd P Ls d i j : ℤ) : ℚ)
      = ((N : ℚ) * cd * B ^ 3) * (Φ i j - (if i = j then (cn : ℚ) / cd else 0) - ldl B Ls d n i j) := by
    intro i j
    simp only [resEntry]
    push_cast
    rw [hdot, hΦ, nthZ_eq, nthL_eq]
    by_cases hij : i = j
    · subst hij
      simp only [if_true]
      field_simp
    · have hij' : (i : ℕ) ≠ j := fun e => hij (Fin.ext e)
      simp only [hij, hij', if_false]
      field_simp
      ring
  -- symmetry
  have hΦs : ∀ i j : Fin n, Φ i j = Φ j i := by
    intro i j
    have hs := hsym i i.2 j j.2
    simp only [nthZ_eq, nthL_eq] at hs
    rw [hΦ, hΦ, hs]
  have hLs : ∀ i j : Fin n, ldl B Ls d n i j = ldl B Ls d n j i := by
    intro i j
    simp only [ldl]
    exact sum_congr rfl fun k _ => by ring
  have hRs : ∀ i j : Fin n, (Φ i j - (if i = j then (cn : ℚ) / cd else 0) - ldl B Ls d n i j)
      = (Φ j i - (if j = i then (cn : ℚ) / cd else 0) - ldl B Ls d n j i) := by
    intro i j
    rw [hΦs i j, hLs i j]
    by_cases hij : i = j
    · subst hij; rfl
    · rw [if_neg hij, if_neg (Ne.symm hij)]
  -- absolute row sums
  have hRr : ∀ i : Fin n,
      ∑ j, |Φ i j - (if i = j then (cn : ℚ) / cd else 0) - ldl B Ls d n i j| ≤ (rn : ℚ) / rd := by
    intro i
    have h1 := hrow i i.2
    rw [sumTo_eq, ← Fin.sum_univ_eq_sum_range] at h1
    have h2 : (rd : ℚ) * ∑ j : Fin n, (((resEntry N B cn cd P Ls d i j).natAbs : ℕ) : ℚ)
        ≤ rn * ((N : ℚ) * cd * B ^ 3) := by
      exact_mod_cast h1
    have h3 : ∀ j : Fin n, (((resEntry N B cn cd P Ls d i j).natAbs : ℕ) : ℚ)
        = ((N : ℚ) * cd * B ^ 3)
          * |Φ i j - (if i = j then (cn : ℚ) / cd else 0) - ldl B Ls d n i j| := by
      intro j
      rw [Nat.cast_natAbs, Int.cast_abs, hres, abs_mul, abs_of_pos hS]
    simp only [h3] at h2
    rw [← mul_sum] at h2
    rw [le_div_iff₀ hrdq]
    have h4 : ((∑ j, |Φ i j - (if i = j then (cn : ℚ) / cd else 0) - ldl B Ls d n i j|) * rd)
        * ((N : ℚ) * cd * B ^ 3) ≤ rn * ((N : ℚ) * cd * B ^ 3) :=
      (le_of_eq (by ring)).trans h2
    exact le_of_mul_le_mul_right h4 hS
  -- assembly
  have hD' : ∀ k : Fin n, 0 ≤ dq B d n k := fun k => div_nonneg (by exact_mod_cast hD k k.2) hBq.le
  have hL : 0 ≤ ∑ i, ∑ j, x i * ldl B Ls d n i j * x j :=
    GaussianSchur3D.qf_nonneg_of_ldl (ldl B Ls d n) (lq B Ls n) (dq B d n) hD' (fun _ _ => rfl) x
  have hR : -((rn : ℚ) / rd * ∑ i, x i ^ 2)
      ≤ ∑ i, ∑ j, x i * (Φ i j - (if i = j then (cn : ℚ) / cd else 0) - ldl B Ls d n i j) * x j :=
    qf_ge_neg_rowsum _ _ hRs hRr x
  have hdec : ∀ i j, x i * Φ i j * x j
      = x i * (if i = j then (cn : ℚ) / cd else 0) * x j + x i * ldl B Ls d n i j * x j
        + x i * (Φ i j - (if i = j then (cn : ℚ) / cd else 0) - ldl B Ls d n i j) * x j := by
    intro i j
    ring
  have hdiag : ∑ i, ∑ j, x i * (if i = j then (cn : ℚ) / cd else 0) * x j
      = (cn : ℚ) / cd * ∑ i, x i ^ 2 := by
    simp only [mul_ite, ite_mul, mul_zero, zero_mul, sum_ite_eq, mem_univ, if_true, mul_sum]
    refine sum_congr rfl fun i _ => ?_
    ring
  have hsum : ∑ i, ∑ j, x i * Φ i j * x j
      = ∑ i, ∑ j, x i * (if i = j then (cn : ℚ) / cd else 0) * x j
        + ∑ i, ∑ j, x i * ldl B Ls d n i j * x j
        + ∑ i, ∑ j, x i * (Φ i j - (if i = j then (cn : ℚ) / cd else 0) - ldl B Ls d n i j) * x j := by
    simp only [hdec, sum_add_distrib]
  rw [hsum, hdiag, sub_mul]
  linarith

