/-! # Part XIV. `YangMills.StrongCoupling.SchurTower`: test-vector upper bounds on the split constants, "no compensation", and an obstruction instance (new; uses Parts I, II and IX) -/

/-!
# Upper bounds on the split constants of a tower, from test vectors

This part concerns **reversible heat-bath (cube-resampling) generators** `D_k` at scales
`k = 0, 1, 2, …`, composed by the splits of Part IX. It is not about transfer matrices and it is
**not a mass-gap statement**.

## (a) Formal target

Part IX (`gap_tower`, `gap_tower_closed`) turns splits `α_k (I − Π_k) + β_k J_k D_{k+1} J_k* ≤ D_k`
into a lower bound `towerBound` on `D_0`, and `towerBound_le_prod`, `gap_le_of_fixed` cap that bound by
`ϖ_K ∏ β` and `ϖ_K ≤ ∑_{x∈Z} wₓ`. This part bounds the `β_k` themselves from above by test vectors,
so that the cap becomes computable: it is the abstract half of an obstruction for straight blocking in
four dimensions at Gaussian order (the lattice half — the Gaussian infrared evaluation of the test
ratio, for split constants independent of the volume — is a paper proof and an exact rational
computation outside Lean, in the research notes).

## (b) What is proved

* `StepAt.test_upper`: at one scale, with `α_k ≥ 0`, for **every** `x` (not only `x = J y` as in
  `coarse_lower`): `β_k ⟪J* x, D_{k+1} J* x⟫ ≤ ⟪x, D_k x⟫`.
* `Jtcomp`, `tower_test_upper`, `tower_prod_le_ratio`: telescoped over `m` scales with the composed
  coarse-graining `𝒥* = J*_{k+m−1} ⋯ J*_k`: `(∏_{i<m} β_{k+i}) ⟪𝒥* x, D_{k+m} 𝒥* x⟫ ≤ ⟪x, D_k x⟫`, so
  `∏ β ≤ ⟪x, D_k x⟫ / ⟪𝒥* x, D_{k+m} 𝒥* x⟫` for every test vector with positive denominator. Only the
  bottom and the top generator enter; the intermediate ones cancel.
* `tower_conclusion_le`: if the top generator is a cube generator `∑_z w_z (I − P_z)` with
  `ϖ ≤ D_{k+m}`, and `f ≠ 0` is fixed by `P_z` for `z ∉ Z`, then
  `towerBound ≤ (∑_{z∈Z} w_z) · ⟪x, D_k x⟫ / ⟪𝒥* x, D_{k+m} 𝒥* x⟫` for every test vector `x`: an
  explicit limit on what any such tower can conclude, whatever the `α`s ≥ 0, `ϖ` and intermediate
  designs.
* `towerBound_le_alpha_prod` ("no compensation"): `towerBound m k ≤ α_{k+j} ∏_{i<j} β_{k+i}` for every
  `j < m`; with `StepAt.alpha_form`, `StepAt.alpha_le_of_fixed` (a cap on `α_k` from a local vector),
  scales after `j` cannot undo a small prefix product `∏_{i<j} β`.
* `towerBound_le_pow`: the abstract per-scale obstruction — if `0 ≤ β_{k+i} ≤ θ/4` for `i < m` and
  `ϖ ≥ 0`, then `towerBound m k ≤ ϖ (θ/4)^m`.
* Non-vacuity (toy towers on `ℝ`, not the Wilson model): `example_doubling_step` (`D_k = 8ᵏ`,
  `α_k = 8ᵏ`, `β = 1/8`), `example_beta_le_eighth` (for that tower, every admissible `β_k ≤ 1/8`: an
  obstruction instance obtained from `StepAt.test_upper`), `example_doubling_tower`,
  `example_doubling_tower_value` (the bound `ϖ (1/8)³` is attained at `ϖ = 8³`).

## (c) What remains open

The identification of the test ratio for the Wilson model: at Gaussian order the research notes evaluate
`⟪x, D_0 x⟫ / ⟪𝒥* x, D_K 𝒥* x⟫` on smooth transverse plane waves (infrared limit) and bound it by
exact rational test fields; that evaluation, the Gaussian conditional-variance formulas and the
identification of the matrices with the lattice objects are not formalised here. Nothing is proved
about the interacting (non-Gaussian) blocked laws.

## (d) Axioms and checks

Every declaration depends only on `propext`, `Classical.choice` and `Quot.sound`; there is no
`sorry`, `admit`, `axiom`, `native_decide`, `implemented_by` or `set_option`. The module axiom
audit covers every headline theorem.

## (e) Scope

This part is not a proof of a mass gap, of a transfer-matrix gap, or of any statement about the
continuum. It bounds from above what the heat-bath Schur tower of Part IX can deliver.
-/

namespace YangMills.StrongCoupling.SchurTower

open scoped InnerProductSpace

section TestUpper

variable {H : ℕ → Type*} [∀ k, NormedAddCommGroup (H k)] [∀ k, InnerProductSpace ℝ (H k)]
  {D : ∀ k, H k →ₗ[ℝ] H k} {pj : ∀ k, SchurSplit.OrthProj (H k)}
  {J : ∀ k, H (k + 1) →ₗ[ℝ] H k} {Jt : ∀ k, H k →ₗ[ℝ] H (k + 1)} {α β : ℕ → ℝ}

/-- The composed coarse-graining `J*_{k+m−1} ⋯ J*_k : H k → H (k+m)`, as a function. -/
def Jtcomp (Jt : ∀ k, H k →ₗ[ℝ] H (k + 1)) (k : ℕ) : ∀ m, H k → H (k + m)
  | 0 => fun x => x
  | m + 1 => fun x => Jt (k + m) (Jtcomp Jt k m x)

/-- **Test-vector bound at one scale.** With `α_k ≥ 0`, the split gives
`β_k ⟪J* x, D_{k+1} J* x⟫ ≤ ⟪x, D_k x⟫` for every `x` (`coarse_lower` is the case `x = J y`). -/
theorem StepAt.test_upper {k : ℕ} (hs : StepAt D pj J Jt α β k) (hα : 0 ≤ α k) (x : H k) :
    β k * ⟪Jt k x, D (k + 1) (Jt k x)⟫_ℝ ≤ ⟪x, D k x⟫_ℝ := by
  have h := hs.form x
  have h0 : 0 ≤ α k * ‖x - (pj k).P x‖ ^ 2 := mul_nonneg hα (sq_nonneg _)
  linarith

/-- **Telescoped test-vector bound.** Splits at the scales `k, …, k+m−1` with `α, β ≥ 0` give
`(∏_{i<m} β_{k+i}) ⟪𝒥* x, D_{k+m} 𝒥* x⟫ ≤ ⟪x, D_k x⟫` for every `x`. -/
theorem tower_test_upper (k : ℕ) :
    ∀ m, (∀ i < m, 0 ≤ α (k + i)) → (∀ i < m, 0 ≤ β (k + i)) →
      (∀ i < m, StepAt D pj J Jt α β (k + i)) → ∀ x : H k,
        (∏ i ∈ Finset.range m, β (k + i)) *
          ⟪Jtcomp Jt k m x, D (k + m) (Jtcomp Jt k m x)⟫_ℝ ≤ ⟪x, D k x⟫_ℝ := by
  intro m
  induction m with
  | zero => intro _ _ _ x; simp [Jtcomp]
  | succ m ih =>
    intro hα hβ hs x
    have h1 := ih (fun i hi => hα i (by omega)) (fun i hi => hβ i (by omega))
      (fun i hi => hs i (by omega)) x
    have h2 := (hs m (by omega)).test_upper (hα m (by omega)) (Jtcomp Jt k m x)
    have hp : 0 ≤ ∏ i ∈ Finset.range m, β (k + i) :=
      Finset.prod_nonneg fun i hi => hβ i (by have := Finset.mem_range.1 hi; omega)
    have h3 := mul_le_mul_of_nonneg_left h2 hp
    rw [Finset.prod_range_succ]
    show (∏ i ∈ Finset.range m, β (k + i)) * β (k + m) *
        ⟪Jt (k + m) (Jtcomp Jt k m x), D (k + m + 1) (Jt (k + m) (Jtcomp Jt k m x))⟫_ℝ ≤
      ⟪x, D k x⟫_ℝ
    rw [mul_assoc]
    linarith

/-- **The product of the split constants is at most a test ratio.** -/
theorem tower_prod_le_ratio (k m : ℕ) (hα : ∀ i < m, 0 ≤ α (k + i))
    (hβ : ∀ i < m, 0 ≤ β (k + i)) (hs : ∀ i < m, StepAt D pj J Jt α β (k + i)) (x : H k)
    (hpos : 0 < ⟪Jtcomp Jt k m x, D (k + m) (Jtcomp Jt k m x)⟫_ℝ) :
    ∏ i ∈ Finset.range m, β (k + i) ≤
      ⟪x, D k x⟫_ℝ / ⟪Jtcomp Jt k m x, D (k + m) (Jtcomp Jt k m x)⟫_ℝ := by
  rw [le_div_iff₀ hpos]
  exact tower_test_upper k m hα hβ hs x

/-- **What a tower can conclude, explicitly.** If the top generator is a cube generator
`∑_z w_z (I − P_z)` (orthogonal projections, `w ≥ 0`) with `ϖ • I ≤ D_{k+m}`, and `f ≠ 0` is fixed
by every `P_z` with `z ∉ Z`, then for every test vector `x`:
`towerBound m k ≤ (∑_{z∈Z} w_z) · ⟪x, D_k x⟫ / ⟪𝒥* x, D_{k+m} 𝒥* x⟫`. -/
theorem tower_conclusion_le {ϖ : ℝ} (k m : ℕ) {ι : Type*} [Fintype ι] (w : ι → ℝ)
    (P : ι → H (k + m) →ₗ[ℝ] H (k + m)) (hw : ∀ z, 0 ≤ w z) (hPs : ∀ z, (P z).IsSymmetric)
    (hPi : ∀ z y, P z (P z y) = P z y) (Z : Finset ι) {f : H (k + m)} (hf : f ≠ 0)
    (hfix : ∀ z ∉ Z, P z f = f) (htop : ϖ • LinearMap.id ≤ D (k + m))
    (hD : D (k + m) = CubeSplit.cubeGen w P) (hα : ∀ i < m, 0 ≤ α (k + i))
    (hβ : ∀ i < m, 0 ≤ β (k + i)) (hs : ∀ i < m, StepAt D pj J Jt α β (k + i)) (x : H k)
    (hpos : 0 < ⟪Jtcomp Jt k m x, D (k + m) (Jtcomp Jt k m x)⟫_ℝ) :
    towerBound α β ϖ m k ≤ (∑ z ∈ Z, w z) *
      (⟪x, D k x⟫_ℝ / ⟪Jtcomp Jt k m x, D (k + m) (Jtcomp Jt k m x)⟫_ℝ) := by
  have h1 := towerBound_le_prod (α := α) (ϖ := ϖ) m k hβ
  have htop' : ϖ • LinearMap.id ≤ CubeSplit.cubeGen w P := by rw [← hD]; exact htop
  have hϖ : ϖ ≤ ∑ z ∈ Z, w z := gap_le_of_fixed w P hw hPs hPi Z hf hfix htop'
  have hprod := tower_prod_le_ratio k m hα hβ hs x hpos
  have hp0 : 0 ≤ ∏ i ∈ Finset.range m, β (k + i) :=
    Finset.prod_nonneg fun i hi => hβ i (Finset.mem_range.1 hi)
  have hW : 0 ≤ ∑ z ∈ Z, w z := Finset.sum_nonneg fun z _ => hw z
  calc towerBound α β ϖ m k ≤ ϖ * ∏ i ∈ Finset.range m, β (k + i) := h1
    _ ≤ (∑ z ∈ Z, w z) * ∏ i ∈ Finset.range m, β (k + i) := mul_le_mul_of_nonneg_right hϖ hp0
    _ ≤ (∑ z ∈ Z, w z) *
        (⟪x, D k x⟫_ℝ / ⟪Jtcomp Jt k m x, D (k + m) (Jtcomp Jt k m x)⟫_ℝ) :=
      mul_le_mul_of_nonneg_left hprod hW

/-- The split controls `α_k` by the generator alone (for `β_k ≥ 0` and `D_{k+1} ≥ 0` as a form):
`α_k ‖x − Π_k x‖² ≤ ⟪x, D_k x⟫`. -/
theorem StepAt.alpha_form {k : ℕ} (hs : StepAt D pj J Jt α β k) (hβ : 0 ≤ β k)
    (hDc : ∀ y, 0 ≤ ⟪y, D (k + 1) y⟫_ℝ) (x : H k) :
    α k * ‖x - (pj k).P x‖ ^ 2 ≤ ⟪x, D k x⟫_ℝ := by
  have h := hs.form x
  have h0 := mul_nonneg hβ (hDc (Jt k x))
  linarith

/-- **A cap on `α_k` from a local vector.** If `D_k = ∑_z w_z (I − P_z)` (orthogonal projections,
`w ≥ 0`) and `x` is fixed by every `P_z` with `z ∉ Z`, then
`α_k ‖x − Π_k x‖² ≤ (∑_{z∈Z} w_z) ‖x‖²`. -/
theorem StepAt.alpha_le_of_fixed {k : ℕ} (hs : StepAt D pj J Jt α β k) (hβ : 0 ≤ β k)
    (hDc : ∀ y, 0 ≤ ⟪y, D (k + 1) y⟫_ℝ) {ι : Type*} [Fintype ι] (w : ι → ℝ)
    (P : ι → H k →ₗ[ℝ] H k) (hw : ∀ z, 0 ≤ w z) (hPs : ∀ z, (P z).IsSymmetric)
    (hPi : ∀ z y, P z (P z y) = P z y) (hD : D k = CubeSplit.cubeGen w P) (Z : Finset ι) (x : H k)
    (hfix : ∀ z ∉ Z, P z x = x) :
    α k * ‖x - (pj k).P x‖ ^ 2 ≤ (∑ z ∈ Z, w z) * ‖x‖ ^ 2 := by
  have h1 := hs.alpha_form hβ hDc x
  have h2 := form_le_of_fixed w P hw hPs hPi Z x hfix
  rw [← hD] at h2
  linarith

/-- **No compensation by later scales.** For `β ≥ 0` and every `j < m`:
`towerBound m k ≤ α_{k+j} ∏_{i<j} β_{k+i}`. -/
theorem towerBound_le_alpha_prod {ϖ : ℝ} :
    ∀ (m k : ℕ), (∀ i < m, 0 ≤ β (k + i)) → ∀ j < m,
      towerBound α β ϖ m k ≤ α (k + j) * ∏ i ∈ Finset.range j, β (k + i) := by
  intro m
  induction m with
  | zero => intro k _ j hj; exact absurd hj (Nat.not_lt_zero j)
  | succ m ih =>
    intro k hβ j hj
    have hβk : 0 ≤ β k := by simpa using hβ 0 (by omega)
    rcases j with _ | j
    · show min (α k) (β k * towerBound α β ϖ m (k + 1)) ≤
        α (k + 0) * ∏ i ∈ Finset.range 0, β (k + i)
      simp only [add_zero, Finset.prod_range_zero, mul_one]
      exact min_le_left _ _
    · have hβ' : ∀ i < m, 0 ≤ β (k + 1 + i) := fun i hi => by
        rw [show k + 1 + i = k + (i + 1) by omega]; exact hβ (i + 1) (by omega)
      have h1 := ih (k + 1) hβ' j (by omega)
      have h2 : towerBound α β ϖ (m + 1) k ≤ β k * towerBound α β ϖ m (k + 1) :=
        min_le_right _ _
      have h3 := mul_le_mul_of_nonneg_left h1 hβk
      rw [prod_shift, show k + (j + 1) = k + 1 + j by omega]
      calc towerBound α β ϖ (m + 1) k ≤ β k * towerBound α β ϖ m (k + 1) := h2
        _ ≤ β k * (α (k + 1 + j) * ∏ i ∈ Finset.range j, β (k + 1 + i)) := h3
        _ = α (k + 1 + j) * (β k * ∏ i ∈ Finset.range j, β (k + 1 + i)) := by ring

/-- **The abstract per-scale obstruction.** If `0 ≤ β_{k+i} ≤ θ/4` for `i < m` and `ϖ ≥ 0`, then
`towerBound m k ≤ ϖ (θ/4)^m`. -/
theorem towerBound_le_pow {ϖ θ : ℝ} (hϖ : 0 ≤ ϖ) (m k : ℕ) (hβ0 : ∀ i < m, 0 ≤ β (k + i))
    (hβ : ∀ i < m, β (k + i) ≤ θ / 4) : towerBound α β ϖ m k ≤ ϖ * (θ / 4) ^ m := by
  have h1 := towerBound_le_prod (α := α) (ϖ := ϖ) m k hβ0
  have h2 : ∏ i ∈ Finset.range m, β (k + i) ≤ ∏ _i ∈ Finset.range m, (θ / 4) :=
    Finset.prod_le_prod (fun i hi => hβ0 i (Finset.mem_range.1 hi))
      (fun i hi => hβ i (Finset.mem_range.1 hi))
  rw [Finset.prod_const, Finset.card_range] at h2
  exact h1.trans (mul_le_mul_of_nonneg_left h2 hϖ)

end TestUpper

/-! ## Non-vacuity (toy towers on `ℝ`, not the Wilson model) -/

section ScaleRatioExamples

/-- The "doubling" toy tower: `H k = ℝ`, `D_k = 8ᵏ` (diffusive `4ᵏ` times a per-scale speed-up `2ᵏ`,
the shape of the 4D Gaussian infrared constants `c_k ∝ 2ᵏ`), `Π_k = J_k = I`, `α_k = 8ᵏ`,
`β_k = 1/8`. -/
theorem example_doubling_step (k : ℕ) :
    StepAt (H := fun _ => ℝ) (fun k => SchurSplit.scal ((8 : ℝ) ^ k)) (fun _ => pjId)
      (fun _ => LinearMap.id) (fun _ => LinearMap.id) (fun k => (8 : ℝ) ^ k) (fun _ => 1 / 8) k where
  symm := SchurSplit.scal_isSymmetric _
  adj _ _ := rfl
  JJt _ := rfl
  le := by
    show pjId.splitOp LinearMap.id LinearMap.id (SchurSplit.scal ((8 : ℝ) ^ (k + 1))) ((8 : ℝ) ^ k)
      (1 / 8) ≤ SchurSplit.scal ((8 : ℝ) ^ k)
    rw [pjId.splitOp_le_iff (SchurSplit.scal_isSymmetric _) (fun _ _ => rfl)
      (SchurSplit.scal_isSymmetric _)]
    intro x
    show (8 : ℝ) ^ k * ‖x - x‖ ^ 2 + 1 / 8 * ⟪x, SchurSplit.scal ((8 : ℝ) ^ (k + 1)) x⟫_ℝ ≤
      ⟪x, SchurSplit.scal ((8 : ℝ) ^ k) x⟫_ℝ
    rw [sub_self, norm_zero, SchurSplit.scal_apply, SchurSplit.scal_apply, SchurSplit.inner_real,
      SchurSplit.inner_real]
    apply le_of_eq
    ring

/-- **An obstruction instance.** For the doubling toy tower, every split constant allowed at scale
`k` (with `α_k ≥ 0`) satisfies `β_k ≤ 1/8`, i.e. `4 β_k ≤ 1/2`: `StepAt.test_upper` at `x = 1`. -/
theorem example_beta_le_eighth (α β : ℕ → ℝ) (k : ℕ) (hα : 0 ≤ α k)
    (hs : StepAt (H := fun _ => ℝ) (fun k => SchurSplit.scal ((8 : ℝ) ^ k)) (fun _ => pjId)
      (fun _ => LinearMap.id) (fun _ => LinearMap.id) α β k) : β k ≤ 1 / 8 := by
  have h := hs.test_upper hα (1 : ℝ)
  have e1 : ⟪(LinearMap.id : ℝ →ₗ[ℝ] ℝ) 1, SchurSplit.scal ((8 : ℝ) ^ (k + 1))
      ((LinearMap.id : ℝ →ₗ[ℝ] ℝ) 1)⟫_ℝ = (8 : ℝ) ^ k * 8 := by
    rw [LinearMap.id_apply, SchurSplit.scal_apply, SchurSplit.inner_real, pow_succ]; ring
  have e2 : ⟪(1 : ℝ), SchurSplit.scal ((8 : ℝ) ^ k) 1⟫_ℝ = (8 : ℝ) ^ k := by
    rw [SchurSplit.scal_apply, SchurSplit.inner_real]; ring
  change β k * ⟪(LinearMap.id : ℝ →ₗ[ℝ] ℝ) 1, SchurSplit.scal ((8 : ℝ) ^ (k + 1))
      ((LinearMap.id : ℝ →ₗ[ℝ] ℝ) 1)⟫_ℝ ≤ ⟪(1 : ℝ), SchurSplit.scal ((8 : ℝ) ^ k) 1⟫_ℝ at h
  rw [e1, e2] at h
  have hp : (0 : ℝ) < 8 ^ k := by positivity
  by_contra hc
  have h4 := mul_lt_mul_of_pos_left (not_le.mp hc) hp
  nlinarith

/-- The tower bound of the doubling toy tower over `m` scales is at most `ϖ (1/8)^m`
(`towerBound_le_pow` with `θ = 1/2`). -/
theorem example_doubling_tower (ϖ : ℝ) (hϖ : 0 ≤ ϖ) (m : ℕ) :
    towerBound (fun k => (8 : ℝ) ^ k) (fun _ => (1 / 8 : ℝ)) ϖ m 0 ≤ ϖ * ((1 / 2 : ℝ) / 4) ^ m :=
  towerBound_le_pow hϖ m 0 (fun _ _ => by norm_num) (fun _ _ => by norm_num)

/-- The bound is attained: with `α_k = 8ᵏ`, `β = 1/8` and `ϖ = 8³`, the three-scale tower bound is
exactly `1 = ϖ (1/8)³` (and `D_0 = 1`). -/
theorem example_doubling_tower_value :
    towerBound (fun k => (8 : ℝ) ^ k) (fun _ => (1 / 8 : ℝ)) ((8 : ℝ) ^ 3) 3 0 = 1 := by
  show min ((8 : ℝ) ^ 0) (1 / 8 * min ((8 : ℝ) ^ (0 + 1)) (1 / 8 * min ((8 : ℝ) ^ (0 + 1 + 1))
    (1 / 8 * (8 : ℝ) ^ 3))) = 1
  norm_num

end ScaleRatioExamples

