/-! ## Part A. Abstract lemmas for orthogonal projections -/

section Abstract

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]

theorem norm_sub_P_sq (P : OrthProj H) (x : H) : ‖x - P.P x‖ ^ 2 = ‖x‖ ^ 2 - ⟪x, P.P x⟫_ℝ := by
  rw [P.inner_P_self, P.norm_sq_split x]
  ring

/-- Enlarging the range of an orthogonal projection decreases `‖u − P u‖`. -/
theorem norm_sub_le_of_le (P P' : OrthProj H) (hle : ∀ x, P'.P (P.P x) = P.P x) (u : H) :
    ‖u - P'.P u‖ ^ 2 ≤ ‖u - P.P u‖ ^ 2 := by
  rw [norm_sub_P_sq, norm_sub_P_sq, P.inner_P_self, P'.inner_P_self]
  have h1 : ‖P.P u‖ * ‖P.P u‖ ≤ ‖P'.P u‖ * ‖P.P u‖ := by
    rw [← sq, ← P.inner_P_self u]
    calc ⟪u, P.P u⟫_ℝ = ⟪u, P'.P (P.P u)⟫_ℝ := by rw [hle]
      _ = ⟪P'.P u, P.P u⟫_ℝ := (P'.symm u (P.P u)).symm
      _ ≤ ‖P'.P u‖ * ‖P.P u‖ := real_inner_le_norm _ _
  have h2 : ‖P.P u‖ ≤ ‖P'.P u‖ := by
    rcases (norm_nonneg (P.P u)).eq_or_lt with h | h
    · rw [← h]
      exact norm_nonneg _
    · exact le_of_mul_le_mul_right h1 h
  nlinarith [mul_le_mul h2 h2 (norm_nonneg _) (norm_nonneg _)]

/-- If `ran Π ⊆ ran P'`, then `Π P' = Π`; so `P'` maps `ker Π` into itself. -/
theorem proj_comp_eq_of_le (pj P' : OrthProj H) (hle : ∀ x, P'.P (pj.P x) = pj.P x) (x : H) :
    pj.P (P'.P x) = pj.P x := by
  refine ext_inner_right ℝ fun y => ?_
  rw [pj.symm (P'.P x) y, P'.symm x (pj.P y), hle y, pj.symm x y]

/-- The quadratic form of `cubeGen` of orthogonal projections: `∑ₓ wₓ ‖u − Pₓ u‖²`. -/
theorem inner_cubeGen_eq {ι : Type*} [Fintype ι] (w : ι → ℝ) (P : ι → OrthProj H) (u : H) :
    ⟪u, cubeGen w (fun x => (P x).P) u⟫_ℝ = ∑ x, w x * ‖u - (P x).P u‖ ^ 2 := by
  rw [cubeGen_apply, inner_sum]
  refine Finset.sum_congr rfl fun x _ => ?_
  rw [real_inner_smul_right, (P x).inner_sub_P_self]

/-- **Fibre reduction.** Let `Pₓ`, `P'ₓ` and `Π` be orthogonal projections with
`ran Pₓ ⊆ ran P'ₓ` and `ran Π ⊆ ran P'ₓ`, and let `wₓ ≥ 0`. Then every `P'ₓ` preserves `ker Π`. A
bound `λ ‖u‖² ≤ ∑ₓ wₓ ‖u − P'ₓ u‖²` on `ker Π` is `hFibre` for `D = cubeGen w P`. -/
theorem fibre_of_constrained {ι : Type*} [Fintype ι] (w : ι → ℝ) (hw : ∀ x, 0 ≤ w x)
    (P P' : ι → OrthProj H) (hle : ∀ x z, (P' x).P ((P x).P z) = (P x).P z) (pj : OrthProj H)
    (hcoarse : ∀ x z, (P' x).P (pj.P z) = pj.P z) {lam : ℝ}
    (hcons : ∀ u, pj.P u = 0 → lam * ‖u‖ ^ 2 ≤ ∑ x, w x * ‖u - (P' x).P u‖ ^ 2) :
    (∀ x u, pj.P u = 0 → pj.P ((P' x).P u) = 0) ∧
      ∀ u, pj.P u = 0 → lam * ‖u‖ ^ 2 ≤ ⟪u, cubeGen w (fun x => (P x).P) u⟫_ℝ := by
  refine ⟨fun x u hu => by rw [proj_comp_eq_of_le pj (P' x) (hcoarse x) u, hu], ?_⟩
  intro u hu
  calc lam * ‖u‖ ^ 2 ≤ ∑ x, w x * ‖u - (P' x).P u‖ ^ 2 := hcons u hu
    _ ≤ ∑ x, w x * ‖u - (P x).P u‖ ^ 2 :=
        Finset.sum_le_sum fun x _ =>
          mul_le_mul_of_nonneg_left (norm_sub_le_of_le (P x) (P' x) (hle x) u) (hw x)
    _ = ⟪u, cubeGen w (fun x => (P x).P) u⟫_ℝ := (inner_cubeGen_eq w P u).symm

/-- `fibre_of_constrained` with the constrained bound stated as a bound for the constrained
generator `cubeGen w P'` on `ker Π`. -/
theorem fibre_of_constrained_gen {ι : Type*} [Fintype ι] (w : ι → ℝ) (hw : ∀ x, 0 ≤ w x)
    (P P' : ι → OrthProj H) (hle : ∀ x z, (P' x).P ((P x).P z) = (P x).P z) (pj : OrthProj H)
    (hcoarse : ∀ x z, (P' x).P (pj.P z) = pj.P z) {lam : ℝ}
    (hcons : ∀ u, pj.P u = 0 → lam * ‖u‖ ^ 2 ≤ ⟪u, cubeGen w (fun x => (P' x).P) u⟫_ℝ) :
    ∀ u, pj.P u = 0 → lam * ‖u‖ ^ 2 ≤ ⟪u, cubeGen w (fun x => (P x).P) u⟫_ℝ :=
  (fibre_of_constrained w hw P P' hle pj hcoarse fun u hu =>
    (hcons u hu).trans (inner_cubeGen_eq w P' u).le).2

/-! ### Log-convexity -/

theorem sq_norm_pow_le (T : H →ₗ[ℝ] H) (hT : T.IsSymmetric) (g : H) (k : ℕ) :
    ‖(T ^ (k + 1)) g‖ ^ 2 ≤ ‖(T ^ k) g‖ * ‖(T ^ (k + 1 + 1)) g‖ := by
  have h1 : (T ^ (k + 1)) g = T ((T ^ k) g) := by
    rw [pow_succ', Module.End.mul_apply]
  have h2 : (T ^ (k + 1 + 1)) g = T (T ((T ^ k) g)) := by
    rw [pow_succ', Module.End.mul_apply, h1]
  rw [h1, h2, ← real_inner_self_eq_norm_sq, hT ((T ^ k) g) (T ((T ^ k) g))]
  exact real_inner_le_norm _ _

theorem ratio_chain (b : ℕ → ℝ) (hb : ∀ k, 0 ≤ b k)
    (hlc : ∀ k, b (k + 1) ^ 2 ≤ b k * b (k + 1 + 1)) :
    ∀ k, b 1 * b k ≤ b 0 * b (k + 1) := by
  intro k
  induction k with
  | zero =>
    show b 1 * b 0 ≤ b 0 * b 1
    exact le_of_eq (mul_comm _ _)
  | succ k ih =>
    rcases (hb (k + 1)).eq_or_lt with h | h
    · rw [← h, mul_zero]
      exact mul_nonneg (hb 0) (hb _)
    · have key : b (k + 1) * (b 1 * b (k + 1)) ≤ b (k + 1) * (b 0 * b (k + 1 + 1)) := by
        nlinarith [mul_le_mul_of_nonneg_left (hlc k) (hb 1),
          mul_le_mul_of_nonneg_right ih (hb (k + 1 + 1))]
      exact le_of_mul_le_mul_left key h

theorem pow_chain (b : ℕ → ℝ) (hb : ∀ k, 0 ≤ b k)
    (hr : ∀ k, b 1 * b k ≤ b 0 * b (k + 1)) :
    ∀ n : ℕ, b 1 ^ n * b 0 ≤ b 0 ^ n * b n := by
  intro n
  induction n with
  | zero => simp
  | succ n ih =>
    have h1 := mul_le_mul_of_nonneg_left ih (hb 1)
    have h2 := mul_le_mul_of_nonneg_left (hr n) (pow_nonneg (hb 0) n)
    calc b 1 ^ (n + 1) * b 0 = b 1 * (b 1 ^ n * b 0) := by ring
      _ ≤ b 1 * (b 0 ^ n * b n) := h1
      _ = b 0 ^ n * (b 1 * b n) := by ring
      _ ≤ b 0 ^ n * (b 0 * b (n + 1)) := h2
      _ = b 0 ^ (n + 1) * b (n + 1) := by ring

/-- **Log-convexity.** For a symmetric `T`, if `‖Tⁿ g‖ ≤ C θⁿ` for every `n` and `θ ≥ 0`, then
`‖T g‖ ≤ θ ‖g‖`. -/
theorem norm_apply_le_of_pow_decay (T : H →ₗ[ℝ] H) (hT : T.IsSymmetric) (g : H) {C θ : ℝ}
    (hθ : 0 ≤ θ) (hdec : ∀ n : ℕ, ‖(T ^ n) g‖ ≤ C * θ ^ n) : ‖T g‖ ≤ θ * ‖g‖ := by
  have hchain : ∀ n : ℕ, ‖T g‖ ^ n * ‖g‖ ≤ ‖g‖ ^ n * ‖(T ^ n) g‖ := by
    have h := pow_chain (fun k => ‖(T ^ k) g‖) (fun k => norm_nonneg _)
      (ratio_chain (fun k => ‖(T ^ k) g‖) (fun k => norm_nonneg _)
        (fun k => sq_norm_pow_le T hT g k))
    intro n
    have hn := h n
    simp only [pow_one, pow_zero, Module.End.one_apply] at hn
    exact hn
  by_contra hcon
  rw [not_le] at hcon
  have hx : 0 < ‖T g‖ := lt_of_le_of_lt (mul_nonneg hθ (norm_nonneg g)) hcon
  have hρ0 : 0 ≤ θ * ‖g‖ / ‖T g‖ := div_nonneg (mul_nonneg hθ (norm_nonneg g)) (norm_nonneg _)
  have hρ1 : θ * ‖g‖ / ‖T g‖ < 1 := (div_lt_one hx).2 hcon
  have hg0 : 0 < ‖g‖ := by
    rcases (norm_nonneg g).eq_or_lt with h | h
    · exfalso
      have hg : g = 0 := norm_eq_zero.1 h.symm
      rw [hg, map_zero, norm_zero] at hx
      exact lt_irrefl _ hx
    · exact h
  have hbound : ∀ n : ℕ, ‖g‖ ≤ C * (θ * ‖g‖ / ‖T g‖) ^ n := by
    intro n
    have h3 : ‖T g‖ ^ n * ‖g‖ ≤ C * (θ * ‖g‖) ^ n := by
      calc ‖T g‖ ^ n * ‖g‖ ≤ ‖g‖ ^ n * ‖(T ^ n) g‖ := hchain n
        _ ≤ ‖g‖ ^ n * (C * θ ^ n) :=
            mul_le_mul_of_nonneg_left (hdec n) (pow_nonneg (norm_nonneg g) n)
        _ = C * (θ * ‖g‖) ^ n := by ring
    have hpos : 0 < ‖T g‖ ^ n := pow_pos hx n
    rw [div_pow, mul_div_assoc', le_div_iff₀ hpos]
    linarith [h3]
  have htend : Tendsto (fun n : ℕ => C * (θ * ‖g‖ / ‖T g‖) ^ n) atTop (𝓝 (C * 0)) :=
    (tendsto_pow_atTop_nhds_zero_of_lt_one hρ0 hρ1).const_mul C
  have hle := ge_of_tendsto' htend hbound
  rw [mul_zero] at hle
  linarith

/-! ### The abstract Dobrushin bound -/

section Dobrushin

variable {ι : Type*} [Fintype ι] [DecidableEq ι] [Nonempty ι]

/-- The random-scan average `T = N⁻¹ ∑ᵢ Pᵢ`, `N = card ι`. -/
noncomputable def avgOp (P : ι → OrthProj H) : H →ₗ[ℝ] H :=
  ((Fintype.card ι : ℝ)⁻¹) • ∑ i, (P i).P

omit [DecidableEq ι] [Nonempty ι] in
theorem avgOp_apply (P : ι → OrthProj H) (f : H) :
    avgOp P f = ((Fintype.card ι : ℝ)⁻¹) • ∑ i, (P i).P f := by
  simp [avgOp]

omit [DecidableEq ι] [Nonempty ι] in
theorem avgOp_isSymmetric (P : ι → OrthProj H) : (avgOp P).IsSymmetric := fun x y => by
  rw [avgOp_apply, avgOp_apply, real_inner_smul_left, real_inner_smul_right, sum_inner, inner_sum]
  congr 1
  exact Finset.sum_congr rfl fun i _ => (P i).symm x y

theorem sum_delta_avg_le (P : ι → OrthProj H) (δ : ι → Seminorm ℝ H) (C : ι → ι → ℝ) (r : ℝ)
    (hN : (0 : ℝ) < Fintype.card ι)
    (f : H) (hself : ∀ i, δ i ((P i).P f) = 0)
    (hcross : ∀ i j, i ≠ j → δ j ((P i).P f) ≤ δ j f + C i j * δ i f)
    (hrow : ∀ i, ∑ j ∈ univ.erase i, C i j ≤ r) :
    ∑ j, δ j (avgOp P f) ≤
      (((Fintype.card ι : ℝ) - 1 + r) / Fintype.card ι) * ∑ j, δ j f := by
  have h1 : ∀ j, δ j (avgOp P f) ≤ (Fintype.card ι : ℝ)⁻¹ * ∑ i, δ j ((P i).P f) := by
    intro j
    rw [avgOp_apply, map_smul_eq_mul, Real.norm_eq_abs, abs_of_pos (inv_pos.2 hN)]
    exact mul_le_mul_of_nonneg_left
      (Finset.le_sum_of_subadditive (δ j) (map_zero (δ j)).le (map_add_le_add (δ j)) _ _)
      (inv_nonneg.2 hN.le)
  have h2 : ∀ i, ∑ j, δ j ((P i).P f) ≤ (∑ j, δ j f) - δ i f + r * δ i f := by
    intro i
    rw [← Finset.add_sum_erase _ _ (Finset.mem_univ i), hself i, zero_add]
    calc ∑ j ∈ univ.erase i, δ j ((P i).P f)
        ≤ ∑ j ∈ univ.erase i, (δ j f + C i j * δ i f) :=
          Finset.sum_le_sum fun j hj => hcross i j (Finset.ne_of_mem_erase hj).symm
      _ = (∑ j ∈ univ.erase i, δ j f) + (∑ j ∈ univ.erase i, C i j) * δ i f := by
          rw [Finset.sum_add_distrib, Finset.sum_mul]
      _ ≤ ((∑ j, δ j f) - δ i f) + r * δ i f := by
          rw [Finset.sum_erase_eq_sub (f := fun j => δ j f) (Finset.mem_univ i)]
          linarith [mul_le_mul_of_nonneg_right (hrow i) (apply_nonneg (δ i) f)]
  calc ∑ j, δ j (avgOp P f) ≤ ∑ j, (Fintype.card ι : ℝ)⁻¹ * ∑ i, δ j ((P i).P f) :=
        Finset.sum_le_sum fun j _ => h1 j
    _ = (Fintype.card ι : ℝ)⁻¹ * ∑ i, ∑ j, δ j ((P i).P f) := by
        rw [← Finset.mul_sum, Finset.sum_comm]
    _ ≤ (Fintype.card ι : ℝ)⁻¹ * ∑ i, ((∑ j, δ j f) - δ i f + r * δ i f) :=
        mul_le_mul_of_nonneg_left (Finset.sum_le_sum fun i _ => h2 i) (inv_nonneg.2 hN.le)
    _ = (((Fintype.card ι : ℝ) - 1 + r) / Fintype.card ι) * ∑ j, δ j f := by
        rw [Finset.sum_add_distrib, Finset.sum_sub_distrib, ← Finset.mul_sum]
        simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
        field_simp

/-- **Abstract Dobrushin bound.** Let `Pᵢ` be orthogonal projections indexed by a nonempty finite
type, and `H₀` a subspace invariant under every `Pᵢ`. Suppose seminorms `δⱼ` and an influence
matrix `C` satisfy, on `H₀`:
* `δᵢ (Pᵢ f) = 0`;
* `δⱼ (Pᵢ f) ≤ δⱼ f + C i j δᵢ f` for `j ≠ i`;
* row sums `∑_{j ≠ i} C i j ≤ r`, with `r ≥ 0`;
* `‖f‖ ≤ K ∑ⱼ δⱼ f`, with `K ≥ 0`.

Then `∑ᵢ ‖f − Pᵢ f‖² ≥ (1 − r) ‖f‖²` on `H₀`; `K` does not enter. -/
theorem dobrushin_gap (P : ι → OrthProj H) (H₀ : Submodule ℝ H)
    (hH₀ : ∀ i, ∀ f ∈ H₀, (P i).P f ∈ H₀)
    (δ : ι → Seminorm ℝ H) (C : ι → ι → ℝ) {r K : ℝ} (hr : 0 ≤ r) (hK : 0 ≤ K)
    (hself : ∀ i, ∀ f ∈ H₀, δ i ((P i).P f) = 0)
    (hcross : ∀ i j, i ≠ j → ∀ f ∈ H₀, δ j ((P i).P f) ≤ δ j f + C i j * δ i f)
    (hrow : ∀ i, ∑ j ∈ univ.erase i, C i j ≤ r)
    (hpoinc : ∀ f ∈ H₀, ‖f‖ ≤ K * ∑ j, δ j f) :
    ∀ f ∈ H₀, (1 - r) * ‖f‖ ^ 2 ≤ ∑ i, ‖f - (P i).P f‖ ^ 2 := by
  intro f hf
  have hN : (0 : ℝ) < Fintype.card ι := Nat.cast_pos.2 Fintype.card_pos
  have hN1 : (1 : ℝ) ≤ Fintype.card ι := Nat.one_le_cast.2 Fintype.card_pos
  have hθ : 0 ≤ ((Fintype.card ι : ℝ) - 1 + r) / Fintype.card ι :=
    div_nonneg (by linarith) hN.le
  have hmem : ∀ g ∈ H₀, avgOp P g ∈ H₀ := fun g hg => by
    rw [avgOp_apply]
    exact H₀.smul_mem _ (H₀.sum_mem fun i _ => hH₀ i g hg)
  have hpow : ∀ n : ℕ, (avgOp P ^ n) f ∈ H₀ ∧
      ∑ j, δ j ((avgOp P ^ n) f) ≤
        (((Fintype.card ι : ℝ) - 1 + r) / Fintype.card ι) ^ n * ∑ j, δ j f := by
    intro n
    induction n with
    | zero => simp [hf]
    | succ n ih =>
      have heq : (avgOp P ^ (n + 1)) f = avgOp P ((avgOp P ^ n) f) := by
        rw [pow_succ', Module.End.mul_apply]
      rw [heq]
      refine ⟨hmem _ ih.1, ?_⟩
      calc ∑ j, δ j (avgOp P ((avgOp P ^ n) f))
          ≤ (((Fintype.card ι : ℝ) - 1 + r) / Fintype.card ι) * ∑ j, δ j ((avgOp P ^ n) f) :=
            sum_delta_avg_le P δ C r hN _ (fun i => hself i _ ih.1)
              (fun i j hij => hcross i j hij _ ih.1) hrow
        _ ≤ (((Fintype.card ι : ℝ) - 1 + r) / Fintype.card ι) *
              ((((Fintype.card ι : ℝ) - 1 + r) / Fintype.card ι) ^ n * ∑ j, δ j f) :=
            mul_le_mul_of_nonneg_left ih.2 hθ
        _ = (((Fintype.card ι : ℝ) - 1 + r) / Fintype.card ι) ^ (n + 1) * ∑ j, δ j f := by
            ring
  have hdec : ∀ n : ℕ, ‖(avgOp P ^ n) f‖ ≤
      (K * ∑ j, δ j f) * (((Fintype.card ι : ℝ) - 1 + r) / Fintype.card ι) ^ n := by
    intro n
    calc ‖(avgOp P ^ n) f‖ ≤ K * ∑ j, δ j ((avgOp P ^ n) f) := hpoinc _ (hpow n).1
      _ ≤ K * ((((Fintype.card ι : ℝ) - 1 + r) / Fintype.card ι) ^ n * ∑ j, δ j f) :=
          mul_le_mul_of_nonneg_left (hpow n).2 hK
      _ = (K * ∑ j, δ j f) * (((Fintype.card ι : ℝ) - 1 + r) / Fintype.card ι) ^ n := by ring
  have hT := norm_apply_le_of_pow_decay (avgOp P) (avgOp_isSymmetric P) f hθ hdec
  have hin : ⟪f, avgOp P f⟫_ℝ ≤
      (((Fintype.card ι : ℝ) - 1 + r) / Fintype.card ι) * ‖f‖ ^ 2 := by
    calc ⟪f, avgOp P f⟫_ℝ ≤ ‖f‖ * ‖avgOp P f‖ := real_inner_le_norm _ _
      _ ≤ ‖f‖ * ((((Fintype.card ι : ℝ) - 1 + r) / Fintype.card ι) * ‖f‖) :=
          mul_le_mul_of_nonneg_left hT (norm_nonneg _)
      _ = (((Fintype.card ι : ℝ) - 1 + r) / Fintype.card ι) * ‖f‖ ^ 2 := by ring
  have hsum : ∑ i, ‖f - (P i).P f‖ ^ 2 =
      (Fintype.card ι : ℝ) * ‖f‖ ^ 2 - (Fintype.card ι : ℝ) * ⟪f, avgOp P f⟫_ℝ := by
    rw [avgOp_apply, real_inner_smul_right, inner_sum, mul_inv_cancel_left₀ hN.ne',
      Finset.sum_congr rfl fun i _ => norm_sub_P_sq (P i) f, Finset.sum_sub_distrib,
      Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
  have hθN : (((Fintype.card ι : ℝ) - 1 + r) / Fintype.card ι) * (Fintype.card ι : ℝ) =
      (Fintype.card ι : ℝ) - 1 + r := div_mul_cancel₀ _ hN.ne'
  have hmul := mul_le_mul_of_nonneg_left hin hN.le
  rw [hsum]
  nlinarith [hmul, hθN, sq_nonneg ‖f‖]

/-- **Dobrushin on the fibre gives `hFibre`.** Suppose the constrained projections `P'ₓ` (with
`ran Pₓ ⊆ ran P'ₓ ⊇ ran Π`) satisfy the hypotheses of `dobrushin_gap` on `ker Π` with row sums
`≤ r`, and `wₓ ≥ w_min ≥ 0`. Then `w_min (1 − r) ‖u‖² ≤ ⟪u, cubeGen w P u⟫` whenever `Π u = 0`. -/
theorem fibre_of_dobrushin (w : ι → ℝ) {wmin : ℝ} (hwmin : 0 ≤ wmin) (hw : ∀ x, wmin ≤ w x)
    (P P' : ι → OrthProj H) (hle : ∀ x z, (P' x).P ((P x).P z) = (P x).P z) (pj : OrthProj H)
    (hcoarse : ∀ x z, (P' x).P (pj.P z) = pj.P z)
    (δ : ι → Seminorm ℝ H) (C : ι → ι → ℝ) {r K : ℝ} (hr : 0 ≤ r) (hK : 0 ≤ K)
    (hself : ∀ i f, pj.P f = 0 → δ i ((P' i).P f) = 0)
    (hcross : ∀ i j, i ≠ j → ∀ f, pj.P f = 0 → δ j ((P' i).P f) ≤ δ j f + C i j * δ i f)
    (hrow : ∀ i, ∑ j ∈ univ.erase i, C i j ≤ r)
    (hpoinc : ∀ f, pj.P f = 0 → ‖f‖ ≤ K * ∑ j, δ j f) :
    ∀ u, pj.P u = 0 → wmin * (1 - r) * ‖u‖ ^ 2 ≤ ⟪u, cubeGen w (fun x => (P x).P) u⟫_ℝ := by
  have hinv : ∀ i, ∀ f ∈ pj.Hf, (P' i).P f ∈ pj.Hf := fun i f hf => by
    rw [OrthProj.mem_Hf] at hf ⊢
    rw [proj_comp_eq_of_le pj (P' i) (hcoarse i) f, hf]
  have hgap := dobrushin_gap P' pj.Hf hinv δ C hr hK
    (fun i f hf => hself i f ((OrthProj.mem_Hf pj).1 hf))
    (fun i j hij f hf => hcross i j hij f ((OrthProj.mem_Hf pj).1 hf)) hrow
    (fun f hf => hpoinc f ((OrthProj.mem_Hf pj).1 hf))
  refine (fibre_of_constrained w (fun x => hwmin.trans (hw x)) P P' hle pj hcoarse ?_).2
  intro u hu
  have h1 := hgap u ((OrthProj.mem_Hf pj).2 hu)
  calc wmin * (1 - r) * ‖u‖ ^ 2 = wmin * ((1 - r) * ‖u‖ ^ 2) := by ring
    _ ≤ wmin * ∑ x, ‖u - (P' x).P u‖ ^ 2 := mul_le_mul_of_nonneg_left h1 hwmin
    _ = ∑ x, wmin * ‖u - (P' x).P u‖ ^ 2 := by rw [Finset.mul_sum]
    _ ≤ ∑ x, w x * ‖u - (P' x).P u‖ ^ 2 :=
        Finset.sum_le_sum fun x _ => mul_le_mul_of_nonneg_right (hw x) (sq_nonneg _)

end Dobrushin

end Abstract

/-! ## Part B. Conditional expectations: monotonicity -/

section L2

variable {Ω : Type*} {m m1 m2 m0 : MeasurableSpace Ω} (μ : Measure Ω)

theorem mem_lpMeas_mono (h12 : m1 ≤ m2) {f : Lp ℝ 2 μ}
    (hf : f ∈ lpMeas ℝ ℝ m1 2 μ) : f ∈ lpMeas ℝ ℝ m2 2 μ := by
  rw [mem_lpMeas_iff_aestronglyMeasurable] at hf ⊢
  obtain ⟨g, hg, hfg⟩ := hf
  exact ⟨g, hg.mono h12, hfg⟩

theorem condL2_mem (hm : m ≤ m0) (f : Lp ℝ 2 μ) :
    condL2 μ hm f ∈ lpMeas ℝ ℝ m 2 μ := by
  have : Fact (m ≤ m0) := ⟨hm⟩
  exact Submodule.starProjection_apply_mem _ f

theorem condL2_eq_self (hm : m ≤ m0) {f : Lp ℝ 2 μ}
    (hf : f ∈ lpMeas ℝ ℝ m 2 μ) : condL2 μ hm f = f := by
  have : Fact (m ≤ m0) := ⟨hm⟩
  exact (Submodule.starProjection_eq_self_iff).2 hf

end L2

/-! ## Part C. The Wilson model: exterior σ-algebras, the skeleton and the constrained cubes -/

section Exterior

variable {S E G : Type*} [OrientedGraph S E] [Group G] [MeasurableSpace G] [MeasurableMul G]

omit [Group G] [MeasurableMul G] in
/-- `extSigma` is antitone: resampling fewer links conditions on more. -/
theorem extSigma_anti {V W : Set E} (hWV : W ⊆ V) : extSigma (G := G) V ≤ extSigma W := by
  simp only [extSigma]
  exact iSup₂_mono' fun e he => ⟨e, fun hw => he (hWV hw), le_rfl⟩

omit [Group G] [MeasurableMul G] in
/-- A link outside `V` is measurable for the exterior σ-algebra of `V`. -/
theorem measurable_eval_extSigma {V : Set E} {e : E} (he : e ∉ V) :
    Measurable[extSigma (G := G) V] (fun U : E → G => U e) := by
  rw [measurable_iff_comap_le, extSigma]
  exact le_iSup₂_of_le e he le_rfl

end Exterior

section Skeleton

variable {S E Sc Ec G : Type*} [OrientedGraph S E] [OrientedGraph Sc Ec]
  [Group G] [MeasurableSpace G] [MeasurableMul₂ G] [MeasurableInv G]
  (blk : Blocking S E Sc Ec)

/-- The skeleton: the fine links used by the blocking. -/
def skel : Set E := Set.range blk.a ∪ Set.range blk.b

theorem diff_skel_avoids (V : Set E) (ē : Ec) : blk.a ē ∉ V \ skel blk ∧ blk.b ē ∉ V \ skel blk :=
  ⟨fun hm => hm.2 (Or.inl ⟨ē, rfl⟩), fun hm => hm.2 (Or.inr ⟨ē, rfl⟩)⟩

omit [MeasurableInv G] in
/-- **`σ(c) ≤ 𝓔(V)`** when `V` contains no link of the skeleton. -/
theorem blockMap_measurable_extSigma {V : Set E} (hV : ∀ ē, blk.a ē ∉ V ∧ blk.b ē ∉ V) :
    Measurable[extSigma (G := G) V] (blockMap (G := G) blk) :=
  @measurable_pi_lambda _ _ _ (extSigma V) _ (blockMap blk) fun ē =>
    (measurable_eval_extSigma (hV ē).1).mul (measurable_eval_extSigma (hV ē).2)

/-- **The constrained σ-algebra.** If no coarse link has both of its fine links in `V`, then
`𝓔(V ∖ Sk) = 𝓔(V) ⊔ σ(c)`. So resampling `V` with the coarse field held fixed is the same as
resampling the non-skeleton links of `V`. -/
theorem extSigma_diff_skel_eq {V : Set E} (hV : ∀ ē, ¬ (blk.a ē ∈ V ∧ blk.b ē ∈ V)) :
    extSigma (G := G) (V \ skel blk) =
      extSigma V ⊔ MeasurableSpace.comap (blockMap (G := G) blk) MeasurableSpace.pi := by
  apply le_antisymm
  · refine iSup₂_le fun e he => ?_
    rw [← measurable_iff_comap_le]
    by_cases heV : e ∈ V
    · have hsk : e ∈ skel blk := by
        by_contra hns
        exact he ⟨heV, hns⟩
      have hc : Measurable[extSigma (G := G) V ⊔
          MeasurableSpace.comap (blockMap (G := G) blk) MeasurableSpace.pi] (blockMap (G := G) blk) :=
        (comap_measurable (blockMap blk)).mono le_sup_right le_rfl
      rcases hsk with ⟨ē, rfl⟩ | ⟨ē, rfl⟩
      · have hb : blk.b ē ∉ V := fun hb => hV ē ⟨heV, hb⟩
        have hfun : (fun U : E → G => U (blk.a ē)) =
            fun U => blockMap blk U ē * (U (blk.b ē))⁻¹ := by
          funext U
          simp [blockMap]
        rw [hfun]
        exact ((measurable_pi_apply ē).comp hc).mul
          (((measurable_eval_extSigma hb).inv).mono le_sup_left le_rfl)
      · have ha : blk.a ē ∉ V := fun ha => hV ē ⟨ha, heV⟩
        have hfun : (fun U : E → G => U (blk.b ē)) =
            fun U => (U (blk.a ē))⁻¹ * blockMap blk U ē := by
          funext U
          simp [blockMap]
        rw [hfun]
        exact (((measurable_eval_extSigma ha).inv).mono le_sup_left le_rfl).mul
          ((measurable_pi_apply ē).comp hc)
    · exact (measurable_eval_extSigma heV).mono le_sup_left le_rfl
  · exact sup_le (extSigma_anti Set.sdiff_subset)
      (measurable_iff_comap_le.1 (blockMap_measurable_extSigma blk (diff_skel_avoids blk V)))

end Skeleton

section Wilson

variable {S E Sc Ec G : Type*} [OrientedGraph S E] [Fintype E] [OrientedGraph Sc Ec]
  [Group G] [MeasurableSpace G] [MeasurableMul₂ G] [MeasurableInv G]
  {Pl : Type*} [Fintype Pl] (plaq : Pl → Plaq S E) (χ : ClassFn G) (κ : ℝ)
  (h : Measure G) [IsProbabilityMeasure h] [IsMulLeftInvariant h] [IsMulRightInvariant h]
  (blk : Blocking S E Sc Ec)

/-- The cube projection `Pₓ = E_μ[· | links outside V]` as an `OrthProj`. -/
noncomputable def wilsonPj (V : Set E) : OrthProj (wilsonH plaq χ κ h) where
  P := wilsonP plaq χ κ h V
  idem := cubeProj_idem _ _ (extSigma_le V) (extSigma_stable V)
  symm := cubeProj_isSymmetric _ _ (extSigma_le V) (extSigma_stable V)

theorem wilsonP_fix_of_mem {V : Set E} (z : wilsonH plaq χ κ h)
    (hz : (z : Lp ℝ 2 (wilsonMeasure plaq χ κ h)) ∈
      lpMeas ℝ ℝ (extSigma V) 2 (wilsonMeasure plaq χ κ h)) :
    wilsonP plaq χ κ h V z = z :=
  Subtype.ext (condL2_eq_self _ (extSigma_le V) hz)

/-- **`ran P_V ⊆ ran P_W` for `W ⊆ V`.** -/
theorem wilsonP_fixes_wilsonP {V W : Set E} (hWV : W ⊆ V) (z : wilsonH plaq χ κ h) :
    wilsonP plaq χ κ h W (wilsonP plaq χ κ h V z) = wilsonP plaq χ κ h V z := by
  apply wilsonP_fix_of_mem
  exact mem_lpMeas_mono _ (extSigma_anti hWV) (condL2_mem _ (extSigma_le V) _)

/-- `ran J ⊆ ran P_V` when `V` avoids the skeleton. -/
theorem wilsonP_fixes_wilsonJ {V : Set E} (hV : ∀ ē, blk.a ē ∉ V ∧ blk.b ē ∉ V)
    (g : coarseY plaq χ κ h blk) :
    wilsonP plaq χ κ h V (wilsonJ plaq χ κ h blk g) = wilsonJ plaq χ κ h blk g := by
  apply wilsonP_fix_of_mem
  rw [show ((wilsonJ plaq χ κ h blk g : wilsonH plaq χ κ h) :
      Lp ℝ 2 (wilsonMeasure plaq χ κ h)) =
      compL2 (wilsonMeasure plaq χ κ h) (measurePreserving_blockMap plaq χ κ h blk)
        (g : Lp ℝ 2 (coarseLaw plaq χ κ h blk)) from rfl, mem_lpMeas_iff_aestronglyMeasurable]
  obtain ⟨g', hg', hgg'⟩ := Lp.aestronglyMeasurable (g : Lp ℝ 2 (coarseLaw plaq χ κ h blk))
  exact ⟨g' ∘ blockMap blk, hg'.comp_measurable (blockMap_measurable_extSigma blk hV),
    (coeFn_compL2 _ _ _).trans
      ((measurePreserving_blockMap plaq χ κ h blk).quasiMeasurePreserving.ae_eq_comp hgg')⟩

/-- **`ran Π ⊆ ran P_V`** when `V` avoids the skeleton: `P_V Π = Π`. -/
theorem wilsonP_fixes_Pi {V : Set E} (hV : ∀ ē, blk.a ē ∉ V ∧ blk.b ē ∉ V)
    (z : wilsonH plaq χ κ h) :
    wilsonP plaq χ κ h V ((isoProj (wilsonJ plaq χ κ h blk)).P z) =
      (isoProj (wilsonJ plaq χ κ h blk)).P z := by
  rw [isoProj_apply]
  exact wilsonP_fixes_wilsonJ plaq χ κ h blk hV _

/-- **`hFibre` from the constrained bound, for the Wilson model.** For any finite family of link
sets `Vₓ` and weights `wₓ ≥ 0`, suppose the generator `∑ₓ wₓ (I − P_{Vₓ ∖ Sk})` satisfies
`λ ‖u‖² ≤ ∑ₓ wₓ ‖u − P_{Vₓ ∖ Sk} u‖²` on `ker Π` (`hcons`). Then `hFibre` holds for
`D = cubeGen w (P_{Vₓ})` with the same `λ`. -/
theorem hFibre_of_constrained {ι : Type*} [Fintype ι] (V : ι → Set E) (w : ι → ℝ)
    (hw : ∀ x, 0 ≤ w x) {lam : ℝ}
    (hcons : ∀ u, (isoProj (wilsonJ plaq χ κ h blk)).P u = 0 →
      lam * ‖u‖ ^ 2 ≤ ∑ x, w x * ‖u - wilsonP plaq χ κ h (V x \ skel blk) u‖ ^ 2) :
    ∀ u, (isoProj (wilsonJ plaq χ κ h blk)).P u = 0 →
      lam * ‖u‖ ^ 2 ≤ ⟪u, cubeGen w (fun x => wilsonP plaq χ κ h (V x)) u⟫_ℝ :=
  (fibre_of_constrained w hw (fun x => wilsonPj plaq χ κ h (V x))
    (fun x => wilsonPj plaq χ κ h (V x \ skel blk))
    (fun _ z => wilsonP_fixes_wilsonP plaq χ κ h Set.sdiff_subset z)
    (isoProj (wilsonJ plaq χ κ h blk))
    (fun x z => wilsonP_fixes_Pi plaq χ κ h blk (diff_skel_avoids blk (V x)) z) hcons).2

/-- `hFibre_of_constrained` with the constrained bound stated for the constrained generator
`cubeGen w (P_{Vₓ ∖ Sk})` (no explicit sum over the cubes). -/
theorem hFibre_of_constrained_gen {ι : Type*} [Fintype ι] (V : ι → Set E) (w : ι → ℝ)
    (hw : ∀ x, 0 ≤ w x) {lam : ℝ}
    (hcons : ∀ u, (isoProj (wilsonJ plaq χ κ h blk)).P u = 0 →
      lam * ‖u‖ ^ 2 ≤ ⟪u, cubeGen w (fun x => wilsonP plaq χ κ h (V x \ skel blk)) u⟫_ℝ) :
    ∀ u, (isoProj (wilsonJ plaq χ κ h blk)).P u = 0 →
      lam * ‖u‖ ^ 2 ≤ ⟪u, cubeGen w (fun x => wilsonP plaq χ κ h (V x)) u⟫_ℝ :=
  fibre_of_constrained_gen w hw (fun x => wilsonPj plaq χ κ h (V x))
    (fun x => wilsonPj plaq χ κ h (V x \ skel blk))
    (fun _ z => wilsonP_fixes_wilsonP plaq χ κ h Set.sdiff_subset z)
    (isoProj (wilsonJ plaq χ κ h blk))
    (fun x z => wilsonP_fixes_Pi plaq χ κ h blk (diff_skel_avoids blk (V x)) z) hcons

end Wilson

/-! ## Part D. SU(2) on `(ℤ/2Mℤ)⁴`: side-2 cubes and the reduction -/

section SU2

/-- The interior links of the side-2 cube `z + {0,1}⁴` of `(ℤ/2Mℤ)⁴`: the links `(z + a, μ)` with
`a ∈ {0,1}⁴` and `a_μ = 0`. -/
def cube2 (M : ℕ) (z : Site (2 * M)) : Set (Link (2 * M)) :=
  {e | ∃ a : Fin 4 → Fin 2, a e.2 = 0 ∧ e.1 = z + fun i => (((a i : ℕ) : ZMod (2 * M)))}

/-- **No side-2 cube contains both fine links of a coarse link** (every `M ≥ 1`, every base point).
-/
theorem cube2_not_both (M : ℕ) [NeZero M] (z : Site (2 * M)) (ē : Link M) :
    ¬ ((straightBlocking M).a ē ∈ cube2 M z ∧ (straightBlocking M).b ē ∈ cube2 M z) := by
  rintro ⟨⟨a1, ha1, h1⟩, ⟨a2, ha2, h2⟩⟩
  have e1 := congrFun h1 ē.2
  have e2 := congrFun h2 ē.2
  simp only [straightBlocking, Pi.add_apply] at ha1 ha2 e1 e2
  rw [ha1] at e1
  rw [ha2] at e2
  simp only [Fin.val_zero, Nat.cast_zero, add_zero, unitV, Pi.single_eq_same] at e1 e2
  have h10 : (1 : ZMod (2 * M)) = 0 := by linear_combination e2 - e1
  exact one_ne_zero h10

/-- The cube based at an even site `2y` contains the first fine link `(2y, μ)` of every coarse link
`(y, μ)`. -/
theorem a_mem_cube2 (M : ℕ) (y : Site M) (μ : Fin 4) :
    (straightBlocking M).a (y, μ) ∈ cube2 M (ιS M y) :=
  ⟨fun _ => 0, rfl, by funext i; simp [straightBlocking]⟩

/-- Every element of `ℤ/2Mℤ` is `2q` or `2q + 1`. -/
theorem even_or_odd (M : ℕ) [NeZero M] (t : ZMod (2 * M)) :
    ∃ q : ZMod M, t = dbl M q ∨ t = dbl M q + 1 := by
  obtain ⟨n, rfl⟩ : ∃ n : ℕ, t = (n : ZMod (2 * M)) := ⟨t.val, (ZMod.natCast_zmod_val t).symm⟩
  refine ⟨((n / 2 : ℕ) : ZMod M), ?_⟩
  have hd : dbl M ((n / 2 : ℕ) : ZMod M) = ((2 * (n / 2) : ℕ) : ZMod (2 * M)) := by
    have := dbl_intCast M ((n / 2 : ℕ) : ℤ)
    simp only [Int.cast_mul, Int.cast_natCast, Int.cast_ofNat] at this
    rw [this, Nat.cast_mul, Nat.cast_ofNat]
  rw [hd]
  rcases Nat.even_or_odd' n with ⟨k, rfl | rfl⟩
  · left
    congr 1
    omega
  · right
    rw [show (2 * k + 1) / 2 = k by omega]
    push_cast
    ring

/-- **Every side-2 cube meets the skeleton in every direction** (every `M ≥ 1`, every base point
`z`, every `μ`). So no cube projection of this geometry satisfies the sufficient condition
`Vₓ ∩ Sk = ∅` for commuting with `Π`. -/
theorem cube2_meets_skel (M : ℕ) [NeZero M] (z : Site (2 * M)) (μ : Fin 4) :
    ∃ ē : Link M, ē.2 = μ ∧
      ((straightBlocking M).a ē ∈ cube2 M z ∨ (straightBlocking M).b ē ∈ cube2 M z) := by
  choose q hq using fun i => even_or_odd M (z i)
  classical
  -- parity bit of each coordinate, and the even representative
  let par : Fin 4 → Fin 2 := fun i => if z i = dbl M (q i) then 0 else 1
  let y : Site M := fun i => if i = μ then q i else if z i = dbl M (q i) then q i else q i + 1
  have h0 : (((0 : Fin 2) : ℕ) : ZMod (2 * M)) = 0 := by simp
  have h1 : (((1 : Fin 2) : ℕ) : ZMod (2 * M)) = 1 := by simp
  have hy : ∀ i, i ≠ μ → dbl M (y i) = z i + (((par i : ℕ) : ZMod (2 * M))) := by
    intro i hi
    have hyi : y i = if z i = dbl M (q i) then q i else q i + 1 := if_neg hi
    have hpi : par i = if z i = dbl M (q i) then 0 else 1 := rfl
    rw [hyi, hpi]
    by_cases hz : z i = dbl M (q i)
    · rw [if_pos hz, if_pos hz, h0, add_zero, hz]
    · rw [if_neg hz, if_neg hz, h1, (hq i).resolve_left hz, map_add, dbl_one]
      ring
  rcases hq μ with hμ | hμ
  · refine ⟨(y, μ), rfl, Or.inl ⟨Function.update par μ 0, by show Function.update par μ 0 μ = 0; simp, ?_⟩⟩
    funext i
    show dbl M (y i) = z i + (((Function.update par μ 0 i : Fin 2) : ℕ) : ZMod (2 * M))
    by_cases hi : i = μ
    · rw [hi]
      have hyμ : y μ = q μ := if_pos rfl
      rw [hyμ, Function.update_self, h0, add_zero, hμ]
    · rw [hy i hi, Function.update_of_ne hi]
  · refine ⟨(y, μ), rfl, Or.inr ⟨Function.update par μ 0, by show Function.update par μ 0 μ = 0; simp, ?_⟩⟩
    funext i
    show dbl M (y i) + unitV μ i = z i + (((Function.update par μ 0 i : Fin 2) : ℕ) : ZMod (2 * M))
    by_cases hi : i = μ
    · rw [hi]
      have hyμ : y μ = q μ := if_pos rfl
      rw [hyμ, Function.update_self, h0, add_zero, hμ]
      simp [unitV]
    · rw [hy i hi, Function.update_of_ne hi]
