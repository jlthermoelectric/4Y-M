/-! # Part XII. `YangMills.StrongCoupling.ConstrainedFibre`: sweep criteria for the constrained fibre bound `hcons` (new; uses Parts I–IV, VI, X and XI) -/

/-!
# Sweep criteria for the constrained fibre bound `hcons`

## (a) Formal target

Part X reduces `hFibre` to the constrained bound
`hcons : λ ‖u‖² ≤ ∑ₓ wₓ ‖u − P'ₓ u‖²` for `Π u = 0`, with `P'ₓ = P_{Vₓ ∖ Sk}`.
This part gives abstract sufficient conditions for `hcons` in exactly that form.

## (b) What is proved

* `norm_sub_sweepProd_sq_le`: for ANY orthogonal projections `P₁, …, Pₙ` (no commutation needed),
  `‖u − P₁ ⋯ Pₙ u‖² ≤ ∑ᵢ ‖u − Pᵢ u‖²`.
* `sweepProd_isOrthProj` / `sweepProj`: if the projections commute pairwise, the product is an
  orthogonal projection, and `form_sweepProj_le_cubeGen` states `I − ∏ P ≤ ∑ (I − P)` as quadratic
  forms (`⟪u, u − Q u⟫ ≤ ⟪u, cubeGen 1 P u⟫`).
* `hcons_of_sweep_vanish`: if the ordered product of the `P'ₓ` along one duplicate-free list
  vanishes on `ker Π`, then `hcons` holds with `λ = w_min` (`0 ≤ w_min ≤ wₓ`).
* `hcons_of_sweeps`: if `m` pairwise disjoint duplicate-free lists each have a product with
  `‖Q_j u‖ ≤ θ ‖u‖` on `ker Π` (`θ ≤ 1`), then `hcons` holds with `λ = m · w_min · (1 − θ)²`.
* `fibre_of_sweeps`, `su2_hFibre_of_sweeps`: the same, fed into `fibre_of_constrained` and
  `su2_hFibre_of_constrained` of Part X, giving `hFibre` for `D = ∑ₓ wₓ (I − P_{Vₓ})`.
* `wilsonMeasure_zero`: at `κ = 0` the Wilson measure is the product measure.
* `GaussK0.k0_margin`: an exact `k = 0` sector certificate `Q0 ≥ (6/25) G0` for the Gaussian-order
  constrained generator in three dimensions (entries produced outside Lean).
* `mem_cube2_self`, `iUnion_cube2_diff_skel`: the constrained cubes `cube2 M x ∖ Sk` cover every
  non-skeleton link (the geometric step of the `β = 0` argument).

## (c) What remains open

The sweep hypotheses are not verified here for the Wilson measure. At `β = 0` they hold with
`θ = 0` and `m = 2^{d−1}` by the paper argument of the accompanying research notes (product measure:
the `P'ₓ` commute and multiply to `E[· | skeleton] = Π` on `H`); that measure theory is not formalised.
For SU(2), `d = 4`, `0 < |β| < 1/1824` the research notes give a paper proof (Dobrushin estimate for
one systematic sweep of the `2^{d−1}` complementary-parity families, whose blocks partition the
non-skeleton links) of the sweep hypothesis with `θ = r/(1 − r)`, `r = 912|β|`, uniformly in `M`;
it is not formalised here. `hResidual` and `hCoarseGap` are untouched.

## (d) Axioms and checks

Only `propext`, `Classical.choice`, `Quot.sound` (the module axiom audit covers every headline
theorem); no
unfinished-proof markers, no new axiom declarations, no native evaluation, no `set_option`.

## (e) Scope

This is not a proof of a mass gap. It gives abstract criteria for the constrained bound `hcons`.
-/

namespace YangMills.StrongCoupling.ConstrainedFibre

open scoped InnerProductSpace
open Finset SchurSplit YangMills.StrongCoupling.CubeSplit YangMills.StrongCoupling.CondExpInputs
  YangMills.StrongCoupling.WilsonCube YangMills.StrongCoupling.WilsonSU2
  YangMills.StrongCoupling.FibreReduction

section Abstract

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] {ι : Type*}

/-- The ordered product `P_{i₁} ⋯ P_{iₙ}` of the projections along a list `[i₁, …, iₙ]`
(a systematic-scan sweep; `P_{iₙ}` acts first). -/
def sweepProd (P : ι → OrthProj H) (l : List ι) : H →ₗ[ℝ] H := (l.map fun i => (P i).P).prod

theorem sweepProd_nil (P : ι → OrthProj H) (u : H) : sweepProd P [] u = u := rfl

theorem sweepProd_cons (P : ι → OrthProj H) (i : ι) (l : List ι) (u : H) :
    sweepProd P (i :: l) u = (P i).P (sweepProd P l u) := by
  simp [sweepProd, Module.End.mul_apply]

theorem norm_P_sq_le (P : OrthProj H) (x : H) : ‖P.P x‖ ^ 2 ≤ ‖x‖ ^ 2 := by
  have h := P.norm_sq_split x
  nlinarith [sq_nonneg ‖x - P.P x‖]

theorem inner_sub_P_P (P : OrthProj H) (u v : H) : ⟪u - P.P u, P.P v⟫_ℝ = 0 := by
  rw [← P.symm, map_sub, P.idem, sub_self, inner_zero_left]

/-- **The sweep inequality.** For any orthogonal projections (no commutation assumed),
`‖u − P_{i₁} ⋯ P_{iₙ} u‖² ≤ ∑ₖ ‖u − P_{iₖ} u‖²`. -/
theorem norm_sub_sweepProd_sq_le (P : ι → OrthProj H) (u : H) :
    ∀ l : List ι, ‖u - sweepProd P l u‖ ^ 2 ≤ (l.map fun i => ‖u - (P i).P u‖ ^ 2).sum
  | [] => by simp [sweepProd_nil]
  | i :: l => by
    have ih := norm_sub_sweepProd_sq_le P u l
    rw [sweepProd_cons, List.map_cons, List.sum_cons]
    have hdec : u - (P i).P (sweepProd P l u) =
        (u - (P i).P u) + (P i).P (u - sweepProd P l u) := by
      rw [map_sub]; abel
    rw [hdec, norm_add_sq_real, inner_sub_P_P, mul_zero, add_zero]
    have h2 := norm_P_sq_le (P i) (u - sweepProd P l u)
    linarith

/-- Weighted comparison: for a duplicate-free list, `w_min ∑_{x ∈ l} fₓ ≤ ∑ₓ wₓ fₓ` when
`0 ≤ w_min ≤ wₓ` and `fₓ ≥ 0`. -/
theorem wmin_mul_listSum_le [Fintype ι] [DecidableEq ι] (w f : ι → ℝ) {wmin : ℝ}
    (hwmin : 0 ≤ wmin) (hw : ∀ x, wmin ≤ w x) (hf : ∀ x, 0 ≤ f x) (l : List ι) (hl : l.Nodup) :
    wmin * (l.map f).sum ≤ ∑ x, w x * f x := by
  rw [← List.sum_toFinset f hl, Finset.mul_sum]
  calc ∑ x ∈ l.toFinset, wmin * f x ≤ ∑ x ∈ l.toFinset, w x * f x :=
        Finset.sum_le_sum fun x _ => mul_le_mul_of_nonneg_right (hw x) (hf x)
    _ ≤ ∑ x, w x * f x :=
        Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _)
          fun x _ _ => mul_nonneg (hwmin.trans (hw x)) (hf x)

/-- Several pairwise disjoint duplicate-free lists:
`w_min ∑_j ∑_{x ∈ L j} fₓ ≤ ∑ₓ wₓ fₓ`. -/
theorem wmin_mul_listsSum_le [Fintype ι] [DecidableEq ι] {κ : Type*} [Fintype κ]
    (w f : ι → ℝ) {wmin : ℝ} (hwmin : 0 ≤ wmin) (hw : ∀ x, wmin ≤ w x) (hf : ∀ x, 0 ≤ f x)
    (L : κ → List ι) (hnd : ∀ j, (L j).Nodup)
    (hdisj : ∀ j j', j ≠ j' → ∀ x ∈ L j, x ∉ L j') :
    ∑ j, wmin * ((L j).map f).sum ≤ ∑ x, w x * f x := by
  classical
  have hpd : ((Finset.univ : Finset κ) : Set κ).PairwiseDisjoint fun j => (L j).toFinset := by
    intro j _ j' _ hjj'
    rw [Function.onFun, Finset.disjoint_left]
    intro x hx hx'
    exact hdisj j j' hjj' x (List.mem_toFinset.1 hx) (List.mem_toFinset.1 hx')
  calc ∑ j, wmin * ((L j).map f).sum = ∑ j, ∑ x ∈ (L j).toFinset, wmin * f x := by
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [← List.sum_toFinset f (hnd j), Finset.mul_sum]
    _ = ∑ x ∈ Finset.univ.biUnion (fun j => (L j).toFinset), wmin * f x :=
        (Finset.sum_biUnion hpd).symm
    _ ≤ ∑ x ∈ Finset.univ.biUnion (fun j => (L j).toFinset), w x * f x :=
        Finset.sum_le_sum fun x _ => mul_le_mul_of_nonneg_right (hw x) (hf x)
    _ ≤ ∑ x, w x * f x :=
        Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _)
          fun x _ _ => mul_nonneg (hwmin.trans (hw x)) (hf x)

/-- **`hcons` from contracting sweeps.** Let `P'ₓ` and `Π` be orthogonal projections, `0 ≤ w_min ≤ wₓ`,
and `L j` (`j : κ`, `m = card κ`) pairwise disjoint duplicate-free lists of indices. If every sweep
`Q_j = ∏_{x ∈ L j} P'ₓ` satisfies `‖Q_j u‖ ≤ θ ‖u‖` on `ker Π` with `θ ≤ 1`, then
`m · w_min · (1 − θ)² · ‖u‖² ≤ ∑ₓ wₓ ‖u − P'ₓ u‖²` on `ker Π` (the form of `hcons` in Part X). -/
theorem hcons_of_sweeps [Fintype ι] [DecidableEq ι] {κ : Type*} [Fintype κ] (w : ι → ℝ)
    {wmin θ : ℝ} (hwmin : 0 ≤ wmin) (hw : ∀ x, wmin ≤ w x) (P' : ι → OrthProj H)
    (pj : OrthProj H) (L : κ → List ι) (hnd : ∀ j, (L j).Nodup)
    (hdisj : ∀ j j', j ≠ j' → ∀ x ∈ L j, x ∉ L j') (hθ1 : θ ≤ 1)
    (hsweep : ∀ j u, pj.P u = 0 → ‖sweepProd P' (L j) u‖ ≤ θ * ‖u‖) :
    ∀ u, pj.P u = 0 →
      ((Fintype.card κ : ℝ) * wmin * (1 - θ) ^ 2) * ‖u‖ ^ 2 ≤
        ∑ x, w x * ‖u - (P' x).P u‖ ^ 2 := by
  intro u hu
  have hj : ∀ j, wmin * ((1 - θ) ^ 2 * ‖u‖ ^ 2) ≤
      wmin * ((L j).map fun x => ‖u - (P' x).P u‖ ^ 2).sum := by
    intro j
    refine mul_le_mul_of_nonneg_left ?_ hwmin
    have h1 : (1 - θ) * ‖u‖ ≤ ‖u - sweepProd P' (L j) u‖ := by
      have ht := norm_sub_norm_le u (sweepProd P' (L j) u)
      linarith [hsweep j u hu]
    have h0 : 0 ≤ (1 - θ) * ‖u‖ := mul_nonneg (by linarith) (norm_nonneg u)
    calc (1 - θ) ^ 2 * ‖u‖ ^ 2 = ((1 - θ) * ‖u‖) ^ 2 := by ring
      _ ≤ ‖u - sweepProd P' (L j) u‖ ^ 2 := pow_le_pow_left₀ h0 h1 2
      _ ≤ _ := norm_sub_sweepProd_sq_le P' u (L j)
  calc ((Fintype.card κ : ℝ) * wmin * (1 - θ) ^ 2) * ‖u‖ ^ 2 =
        ∑ _j : κ, wmin * ((1 - θ) ^ 2 * ‖u‖ ^ 2) := by
        rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]; ring
    _ ≤ ∑ j, wmin * ((L j).map fun x => ‖u - (P' x).P u‖ ^ 2).sum :=
        Finset.sum_le_sum fun j _ => hj j
    _ ≤ ∑ x, w x * ‖u - (P' x).P u‖ ^ 2 :=
        wmin_mul_listsSum_le w (fun x => ‖u - (P' x).P u‖ ^ 2) hwmin hw (fun _ => sq_nonneg _)
          L hnd hdisj

/-- **`hcons` from one vanishing sweep** (the abstract form of the `β = 0` argument). If the
ordered product of the `P'ₓ` along one duplicate-free list vanishes on `ker Π`, then
`hcons` holds with `λ = w_min`. -/
theorem hcons_of_sweep_vanish [Fintype ι] [DecidableEq ι] (w : ι → ℝ) {wmin : ℝ}
    (hwmin : 0 ≤ wmin) (hw : ∀ x, wmin ≤ w x) (P' : ι → OrthProj H) (pj : OrthProj H)
    (l : List ι) (hl : l.Nodup) (hvan : ∀ u, pj.P u = 0 → sweepProd P' l u = 0) :
    ∀ u, pj.P u = 0 → wmin * ‖u‖ ^ 2 ≤ ∑ x, w x * ‖u - (P' x).P u‖ ^ 2 := by
  intro u hu
  have h := hcons_of_sweeps (κ := Unit) w hwmin hw P' pj (fun _ => l) (fun _ => hl)
    (fun j j' hjj' => absurd (Subsingleton.elim j j') hjj') zero_le_one
    (fun _ v hv => by rw [hvan v hv, norm_zero, zero_mul]) u hu
  simpa using h

/-- `hFibre` from contracting sweeps of the constrained projections: `hcons_of_sweeps` fed into
`fibre_of_constrained` (Part X). -/
theorem fibre_of_sweeps [Fintype ι] [DecidableEq ι] {κ : Type*} [Fintype κ] (w : ι → ℝ)
    {wmin θ : ℝ} (hwmin : 0 ≤ wmin) (hw : ∀ x, wmin ≤ w x) (P P' : ι → OrthProj H)
    (hle : ∀ x z, (P' x).P ((P x).P z) = (P x).P z) (pj : OrthProj H)
    (hcoarse : ∀ x z, (P' x).P (pj.P z) = pj.P z) (L : κ → List ι) (hnd : ∀ j, (L j).Nodup)
    (hdisj : ∀ j j', j ≠ j' → ∀ x ∈ L j, x ∉ L j') (hθ1 : θ ≤ 1)
    (hsweep : ∀ j u, pj.P u = 0 → ‖sweepProd P' (L j) u‖ ≤ θ * ‖u‖) :
    ∀ u, pj.P u = 0 → ((Fintype.card κ : ℝ) * wmin * (1 - θ) ^ 2) * ‖u‖ ^ 2 ≤
      ⟪u, cubeGen w (fun x => (P x).P) u⟫_ℝ :=
  (fibre_of_constrained w (fun x => hwmin.trans (hw x)) P P' hle pj hcoarse
    (hcons_of_sweeps w hwmin hw P' pj L hnd hdisj hθ1 hsweep)).2

/-! ### Commuting families: `I − ∏ P ≤ ∑ (I − P)` as forms -/

theorem sweepProd_commute (P : ι → OrthProj H) (hc : ∀ i j, Commute (P i).P (P j).P) (i : ι)
    (l : List ι) : Commute (P i).P (sweepProd P l) :=
  Commute.list_prod_right _ _ fun y hy => by
    obtain ⟨j, _, rfl⟩ := List.mem_map.1 hy
    exact hc i j

/-- For a pairwise commuting family the sweep product is idempotent and symmetric. -/
theorem sweepProd_isOrthProj (P : ι → OrthProj H) (hc : ∀ i j, Commute (P i).P (P j).P) :
    ∀ l : List ι, (∀ x, sweepProd P l (sweepProd P l x) = sweepProd P l x) ∧
      (sweepProd P l).IsSymmetric
  | [] => ⟨fun x => rfl, fun x y => rfl⟩
  | i :: l => by
    obtain ⟨hid, hsy⟩ := sweepProd_isOrthProj P hc l
    have hcom := sweepProd_commute P hc i l
    refine ⟨fun x => ?_, fun x y => ?_⟩
    · simp only [sweepProd_cons]
      have h1 : sweepProd P l ((P i).P (sweepProd P l x)) =
          (P i).P (sweepProd P l (sweepProd P l x)) := by
        have := congrArg (fun T : H →ₗ[ℝ] H => T (sweepProd P l x)) hcom.eq
        simpa [Module.End.mul_apply] using this.symm
      rw [h1, hid, (P i).idem]
    · simp only [sweepProd_cons]
      rw [(P i).symm, hsy]
      have h1 : (P i).P (sweepProd P l y) = sweepProd P l ((P i).P y) := by
        have := congrArg (fun T : H →ₗ[ℝ] H => T y) hcom.eq
        simpa [Module.End.mul_apply] using this
      rw [h1]

/-- The product of a pairwise commuting family along a list, as an orthogonal projection. -/
def sweepProj (P : ι → OrthProj H) (hc : ∀ i j, Commute (P i).P (P j).P) (l : List ι) :
    OrthProj H where
  P := sweepProd P l
  idem := (sweepProd_isOrthProj P hc l).1
  symm := (sweepProd_isOrthProj P hc l).2

/-- **`I − ∏ₓ Pₓ ≤ ∑ₓ (I − Pₓ)` as quadratic forms** for a pairwise commuting finite family of
orthogonal projections (product along any duplicate-free list of all indices, e.g.
`Finset.univ.toList`). -/
theorem form_sweepProj_le_cubeGen [Fintype ι] [DecidableEq ι] (P : ι → OrthProj H)
    (hc : ∀ i j, Commute (P i).P (P j).P) (l : List ι) (hl : l.Nodup) (u : H) :
    ⟪u, u - (sweepProj P hc l).P u⟫_ℝ ≤ ⟪u, cubeGen (fun _ => (1 : ℝ)) (fun x => (P x).P) u⟫_ℝ := by
  rw [(sweepProj P hc l).inner_sub_P_self, inner_cubeGen_eq]
  have h1 := norm_sub_sweepProd_sq_le P u l
  have h2 := wmin_mul_listSum_le (fun _ => (1 : ℝ)) (fun x => ‖u - (P x).P u‖ ^ 2) zero_le_one
    (fun _ => le_rfl) (fun _ => sq_nonneg _) l hl
  rw [one_mul] at h2
  exact h1.trans h2

end Abstract

