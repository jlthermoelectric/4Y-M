open Finset

/-- Generic LDL^T soundness: an exact factorisation with nonnegative pivots gives a nonnegative form. -/
theorem qf_nonneg_of_ldl {n : ℕ} (H Lm : Fin n → Fin n → ℚ) (D : Fin n → ℚ)
    (hD : ∀ k, 0 ≤ D k) (hH : ∀ i j, H i j = ∑ k, Lm i k * D k * Lm j k) (x : Fin n → ℚ) :
    0 ≤ ∑ i, ∑ j, x i * H i j * x j := by
  have key : ∑ i, ∑ j, x i * H i j * x j = ∑ k, D k * (∑ i, Lm i k * x i) ^ 2 := by
    calc ∑ i, ∑ j, x i * H i j * x j
        = ∑ i, ∑ j, ∑ k, D k * ((Lm i k * x i) * (Lm j k * x j)) := by
          refine sum_congr rfl fun i _ => sum_congr rfl fun j _ => ?_
          rw [hH, mul_sum, sum_mul]
          refine sum_congr rfl fun k _ => ?_
          ring
      _ = ∑ i, ∑ k, ∑ j, D k * ((Lm i k * x i) * (Lm j k * x j)) := by
          refine sum_congr rfl fun i _ => ?_
          rw [sum_comm]
      _ = ∑ k, ∑ i, ∑ j, D k * ((Lm i k * x i) * (Lm j k * x j)) := by
          rw [sum_comm]
      _ = ∑ k, D k * (∑ i, Lm i k * x i) ^ 2 := by
          refine sum_congr rfl fun k _ => ?_
          rw [sq, sum_mul_sum, mul_sum]
          refine sum_congr rfl fun i _ => ?_
          rw [mul_sum]
  rw [key]
  exact sum_nonneg fun k _ => mul_nonneg (hD k) (sq_nonneg _)

