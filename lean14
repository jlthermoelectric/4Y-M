/-- The SU(2) coarse embedding `J` on `(ℤ/2Mℤ)⁴`. -/
noncomputable abbrev su2J := wilsonJ (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (straightBlocking M)

/-- The SU(2) cube projection for a link set `V`. -/
noncomputable abbrev su2P (V : Set (Link (2 * M))) :=
  wilsonP (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 V

/-- **`hFibre` for SU(2) on `(ℤ/2Mℤ)⁴` from the constrained bound.** For every `M ≥ 1`, every real
`β`, any link sets `Vₓ` and weights `wₓ ≥ 0`, the constrained bound `hcons` for the projections
`P_{Vₓ ∖ Sk}` gives `hFibre` for `D = ∑ₓ wₓ (I − P_{Vₓ})` and `Π = J J*` of `su2_inputs`. -/
theorem su2_hFibre_of_constrained {ι : Type*} [Fintype ι] (V : ι → Set (Link (2 * M)))
    (w : ι → ℝ) (hw : ∀ x, 0 ≤ w x) {lam : ℝ}
    (hcons : ∀ u, (isoProj (su2J M β)).P u = 0 →
      lam * ‖u‖ ^ 2 ≤ ∑ x, w x * ‖u - su2P M β (V x \ skel (straightBlocking M)) u‖ ^ 2) :
    ∀ u, (isoProj (su2J M β)).P u = 0 →
      lam * ‖u‖ ^ 2 ≤ ⟪u, cubeGen w (fun x => su2P M β (V x)) u⟫_ℝ :=
  hFibre_of_constrained _ _ _ _ _ V w hw hcons

/-- `Π = J J*` for SU(2) on `(ℤ/2Mℤ)⁴`. -/
noncomputable abbrev su2Pi : OrthProj (wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2) :=
  isoProj (su2J M β)

/-- `J*` for SU(2) on `(ℤ/2Mℤ)⁴`, as a linear map. -/
noncomputable abbrev su2Jt : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 →ₗ[ℝ]
    coarseY (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (straightBlocking M) :=
  (isoAdj (su2J M β) : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 →L[ℝ]
    coarseY (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (straightBlocking M))

/-- The fine generator `D = ∑ₓ wₓ (I − P_{Vₓ})`. -/
noncomputable abbrev su2D {ι : Type*} [Fintype ι] (V : ι → Set (Link (2 * M))) (w : ι → ℝ) :
    wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 →ₗ[ℝ]
      wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 :=
  cubeGen w fun x => su2P M β (V x)

/-- The coarse generator `D_c = ∑_z w_z (I − Pᶜ_z)`. -/
noncomputable abbrev su2Dc {ιc : Type*} [Fintype ιc] (Vc : ιc → Set (Link M)) (wc : ιc → ℝ) :
    coarseY (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (straightBlocking M) →ₗ[ℝ]
      coarseY (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (straightBlocking M) :=
  cubeGen wc fun z => coarseP (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (straightBlocking M) (Vc z)

/-- **The reduction with `hFibre` replaced by the constrained bound.** This is
`CubeSplitInputs.gap_of_residual` for `su2_inputs`, with `hFibre` supplied by
`su2_hFibre_of_constrained`. The remaining inputs are `hcons`, `hResidual` and `hCoarseGap`, all
open. -/
theorem su2_gap_of_constrained {ι ιc : Type*} [Fintype ι] [Fintype ιc]
    (V : ι → Set (Link (2 * M))) (w : ι → ℝ) (hw : ∀ x, 0 ≤ w x) (Vc : ιc → Set (Link M))
    (wc : ιc → ℝ) {lam α β' ϖ : ℝ}
    (hcons : ∀ u, (su2Pi M β).P u = 0 →
      lam * ‖u‖ ^ 2 ≤ ∑ x, w x * ‖u - su2P M β (V x \ skel (straightBlocking M)) u‖ ^ 2)
    (hα : α < lam) (hβ : 0 ≤ β') (hCoarseGap : ϖ • LinearMap.id ≤ su2Dc M β Vc wc)
    (X : (su2Pi M β).Hc →ₗ[ℝ] (su2Pi M β).Hf)
    (hResidual : ∀ v : (su2Pi M β).Hc, β' * (su2Pi M β).gC (su2Jt M β) (su2Dc M β Vc wc) v +
      qForm (E := (su2Pi M β).Hf) (F := (su2Pi M β).Hc) ((su2Pi M β).blkA (su2D M β V w))
        ((su2Pi M β).blkB (su2D M β V w)) α X v +
      ‖resid (E := (su2Pi M β).Hf) (F := (su2Pi M β).Hc) ((su2Pi M β).blkA (su2D M β V w))
        ((su2Pi M β).blkB (su2D M β V w)) α X v‖ ^ 2 /
        (lam - α) ≤ ⟪v, (su2Pi M β).blkC (su2D M β V w) v⟫_ℝ) :
    min α (β' * ϖ) • LinearMap.id ≤ su2D M β V w :=
  (su2_inputs M β V w Vc wc).gap_of_residual (su2_hFibre_of_constrained M β V w hw hcons) hα hβ
    hCoarseGap X hResidual

end SU2

