/-- **Lemma I at block ratio 3, the constant chain.** Let `L > 0`. If `e² ≤ C_G L² Q` (the Poincaré
inequality for gauge-invariant fields), `e' ≤ e + 24√3 e` (tree integration), `g ≤ e'/L` (the
block-mean drift), `w² ≤ 768 L² g²` with `g ≥ 0` (the smooth correction), and `0 ≤ dist ≤ e' +
w`, then `dist² ≤ κ_I² C_G L² Q`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem lemmaI3_chain {e e' g w dist Q CG L : ℝ} (hL : 0 < L)
    (hPIG : e ^ 2 ≤ CG * L ^ 2 * Q)
    (he' : e' ≤ e + 24 * √3 * e)
    (hg : g ≤ e' / L) (hw : w ^ 2 ≤ 768 * L ^ 2 * g ^ 2) (hg0 : 0 ≤ g)
    (hdist : dist ≤ e' + w) (hdist0 : 0 ≤ dist) :
    dist ^ 2 ≤ kappaI3 ^ 2 * CG * L ^ 2 * Q := by
  have hs0 := Real.sqrt_nonneg 3
  have hw' : w ≤ 16 * √3 * e' := by
    have h1 : w ≤ 16 * √3 * L * g := by
      have hsq : (16 * √3 * L * g) ^ 2 = 768 * L ^ 2 * g ^ 2 := by
        rw [show (16 * √3 * L * g) ^ 2 = 256 * √3 ^ 2 * L ^ 2 * g ^ 2 by ring,
          Real.sq_sqrt (by norm_num)]; ring
      exact abs_le_of_sq_le_sq' (by rw [hsq]; exact hw) (by positivity) |>.2
    have h2 : L * g ≤ e' := by rw [le_div_iff₀ hL] at hg; linarith
    calc w ≤ 16 * √3 * L * g := h1
      _ = 16 * √3 * (L * g) := by ring
      _ ≤ 16 * √3 * e' := mul_le_mul_of_nonneg_left h2 (by positivity)
  have hd : dist ≤ kappaI3 * e := by
    unfold kappaI3
    have : e' + w ≤ (1 + 16 * √3) * e' := by linarith
    calc dist ≤ (1 + 16 * √3) * e' := hdist.trans this
      _ ≤ (1 + 16 * √3) * (e + 24 * √3 * e) := mul_le_mul_of_nonneg_left he' (by positivity)
      _ = (1 + 24 * √3) * (1 + 16 * √3) * e := by ring
  have hk0 : 0 ≤ kappaI3 := by unfold kappaI3; positivity
  calc dist ^ 2 ≤ (kappaI3 * e) ^ 2 := pow_le_pow_left₀ hdist0 hd 2
    _ = kappaI3 ^ 2 * e ^ 2 := by ring
    _ ≤ kappaI3 ^ 2 * (CG * L ^ 2 * Q) := mul_le_mul_of_nonneg_left hPIG (sq_nonneg _)
    _ = kappaI3 ^ 2 * CG * L ^ 2 * Q := by ring

/-- **Lemma J at block ratio 3, the norm.** If `Q(Jy) ≤ 9 · 256 · Q_k(y)`, `Q_k(y) ≤ 24 ‖y‖²` and
`‖Jy‖² ≤ 768 L² ‖y‖²` with `L > 0`, then `Q(Jy) + ‖Jy‖²/L² ≤ 56064 ‖y‖²`; so the lift constant
is `C_J = √56064`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem lemmaJ3_norm {QJ Qk n2 y2 L : ℝ} (hL : 0 < L) (hQJ : QJ ≤ 9 * 256 * Qk)
    (hQk : Qk ≤ 24 * y2) (hn : n2 ≤ 768 * L ^ 2 * y2) :
    QJ + n2 / L ^ 2 ≤ 56064 * y2 := by
  have : n2 / L ^ 2 ≤ 768 * y2 := by
    rw [div_le_iff₀ (by positivity)]; linarith
  linarith

