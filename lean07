/-- **Conjugation rate of the curvature form.** If `λ ≥ 0`, `L ≥ 3` and `0 ≤ δ ≤ √6 (λ/L) e^{λ/L}`,
then `2 δ L + (δ L)² ≤ 2√6 λ e^{λ/3} + 6 λ² e^{2λ/3}`. In the intended reading `δ` is the Schur
bound for the conjugated curvature matrix minus the curvature matrix (two shifted entries per
row, three per column) and the factor `L` converts the `ℓ²` norm into the energy norm.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem ctQ_rate {lam L δ : ℝ} (hlam : 0 ≤ lam) (hL : 3 ≤ L)
    (hδ : δ ≤ √6 * (lam / L) * Real.exp (lam / L)) (hδ0 : 0 ≤ δ) :
    2 * (δ * L) + (δ * L) ^ 2 ≤ 2 * √6 * lam * Real.exp (lam / 3) +
      6 * lam ^ 2 * Real.exp (2 * lam / 3) := by
  have hL0 : 0 < L := by linarith
  have hE : Real.exp (lam / L) ≤ Real.exp (lam / 3) :=
    Real.exp_le_exp.2 (div_le_div_of_nonneg_left hlam (by norm_num) hL)
  have h1 : δ * L ≤ √6 * lam * Real.exp (lam / 3) := by
    have : δ * L ≤ √6 * (lam / L) * Real.exp (lam / L) * L := mul_le_mul_of_nonneg_right hδ hL0.le
    have e : √6 * (lam / L) * Real.exp (lam / L) * L = √6 * lam * Real.exp (lam / L) := by
      field_simp
    rw [e] at this
    exact this.trans (mul_le_mul_of_nonneg_left hE (by positivity))
  have h0 : 0 ≤ δ * L := mul_nonneg hδ0 hL0.le
  have h2 : (δ * L) ^ 2 ≤ (√6 * lam * Real.exp (lam / 3)) ^ 2 := pow_le_pow_left₀ h0 h1 2
  have e2 : (√6 * lam * Real.exp (lam / 3)) ^ 2 = 6 * lam ^ 2 * Real.exp (2 * lam / 3) := by
    rw [mul_pow, mul_pow, Real.sq_sqrt (by norm_num), ← Real.exp_nat_mul]; push_cast; ring_nf
  linarith

/-- The total conjugation constant of Theorem CT′ at block ratio 3, as a function of the rate:
`c₁(λ) = 2√6 e^{λ/3} + 6 λ e^{2λ/3} + 2 e^λ + c_W(λ)` (curvature form, the two block-average
blocks, the projection term).

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
def c1CT (lam : ℝ) : ℝ :=
  2 * √6 * Real.exp (lam / 3) + 6 * lam * Real.exp (2 * lam / 3) + 2 * Real.exp lam + cW lam

/-- `c₁(λ) ≤ 1903007` for `0 ≤ λ ≤ λ_W`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem c1CT_le {lam : ℝ} (h0 : 0 ≤ lam) (h1 : lam ≤ lamW) : c1CT lam ≤ 1903007 := by
  unfold c1CT
  have hW := cW_le h0 h1
  have hl : lam ≤ 1 / 5000 := by rw [lamW_eq] at h1; linarith
  have s6 : √6 ≤ 24495 / 10000 := by
    rw [show (24495 / 10000 : ℝ) = √((24495 / 10000) ^ 2) by rw [Real.sqrt_sq (by norm_num)]]
    exact Real.sqrt_le_sqrt (by norm_num)
  have s60 := Real.sqrt_nonneg 6
  have e1 : Real.exp (lam / 3) ≤ 1 + 1 / 1000 := by
    have := exp_le_quad (x := lam / 3) (by positivity) (by linarith); nlinarith
  have e2 : Real.exp (2 * lam / 3) ≤ 1 + 1 / 1000 := by
    have := exp_le_quad (x := 2 * lam / 3) (by positivity) (by linarith); nlinarith
  have e3 : Real.exp lam ≤ 1 + 1 / 1000 := by
    have := exp_le_quad (x := lam) (by positivity) (by linarith); nlinarith
  have t1 : 2 * √6 * Real.exp (lam / 3) ≤ 2 * (24495 / 10000) * (1 + 1 / 1000) := by
    apply mul_le_mul (by linarith) e1 (by positivity) (by positivity)
  have t2 : 6 * lam * Real.exp (2 * lam / 3) ≤ 6 * (1 / 5000) * (1 + 1 / 1000) := by
    apply mul_le_mul (by linarith) e2 (by positivity) (by positivity)
  have : 2 * (24495 / 10000 : ℝ) * (1 + 1 / 1000) + 6 * (1 / 5000) * (1 + 1 / 1000) +
      2 * (1 + 1 / 1000) + 1903000 ≤ 1903007 := by norm_num
  linarith

/-- If `0 < 𝔐 ≤ 4.79·10¹²` and `0 < c ≤ 1903007`, then `min(λ_W, 1/(2 𝔐 c)) ≥ 5.48·10⁻²⁰`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem lam0_ge {M c : ℝ} (hM : 0 < M) (hM' : M ≤ 479 * 10 ^ 10) (hc : 0 < c) (hc' : c ≤ 1903007) :
    548 / 10 ^ 22 ≤ min lamW (1 / (2 * M * c)) := by
  apply le_min
  · rw [lamW_eq]; norm_num
  · rw [le_div_iff₀ (by positivity)]
    have : M * c ≤ 479 * 10 ^ 10 * 1903007 := mul_le_mul hM' hc' hc.le (by norm_num)
