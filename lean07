/-- Decay from a spectral gap on `ℝ`, with `A = (1/2) · id`, `q = 1/2`, `s = 1`, `u = 2`,
`b = 1`, `n = 0` (degenerate: no orthogonality condition is used). Conjuncts: the norm bound,
the equation `u = s + A u`, and the conclusion `|⟪1, 2⟫| ≤ 2`. -/
theorem example_neumann :
    (∀ x : ℝ, ‖((1 / 2 : ℝ) • LinearMap.id : ℝ →ₗ[ℝ] ℝ) x‖ ≤ 1 / 2 * ‖x‖) ∧
    (2 : ℝ) = 1 + ((1 / 2 : ℝ) • LinearMap.id : ℝ →ₗ[ℝ] ℝ) 2 ∧
    |inner ℝ (1 : ℝ) 2| ≤ (1 / 2 : ℝ) ^ 0 / (1 - 1 / 2) * ‖(1 : ℝ)‖ * ‖(1 : ℝ)‖ := by
  have hA : ∀ x : ℝ, ‖((1 / 2 : ℝ) • LinearMap.id : ℝ →ₗ[ℝ] ℝ) x‖ ≤ 1 / 2 * ‖x‖ := by
    intro x
    simp only [LinearMap.smul_apply, LinearMap.id_apply, norm_smul]
    norm_num
  have hu : (2 : ℝ) = 1 + ((1 / 2 : ℝ) • LinearMap.id : ℝ →ₗ[ℝ] ℝ) 2 := by
    simp only [LinearMap.smul_apply, LinearMap.id_apply, smul_eq_mul]; norm_num
  exact ⟨hA, hu, neumann_decay _ (1 / 2) (by norm_num) (by norm_num) hA 1 2 1 hu 0
    (fun j hj => absurd hj (Nat.not_lt_zero j))⟩

/-- Cauchy–Schwarz for a positive operator, the operator-norm bound, and decay from a gap, on `ℝ`
with `A = (1/2) · id` (`q = 1/2`) and `T = (3/2) · id` (`c = 1`, `m = 2`), `s = 3/4`, `u = 1`,
`b = 1`, `n = 0` (degenerate: one-dimensional, and no orthogonality condition is used). Conjuncts:
the hypotheses on `A` and `T`, then the three conclusions. -/
theorem example_gap :
    let A : ℝ →ₗ[ℝ] ℝ := (1 / 2 : ℝ) • LinearMap.id
    let T : ℝ →ₗ[ℝ] ℝ := (3 / 2 : ℝ) • LinearMap.id
    (∀ x y : ℝ, inner ℝ (A x) y = inner ℝ x (A y)) ∧ (∀ x : ℝ, 0 ≤ inner ℝ (A x) x) ∧
    (∀ x : ℝ, inner ℝ (A x) x ≤ 1 / 2 * ‖x‖ ^ 2) ∧
    (∀ x y : ℝ, inner ℝ (T x) y = inner ℝ x (T y)) ∧ (∀ x : ℝ, 1 * ‖x‖ ^ 2 ≤ inner ℝ (T x) x) ∧
    (∀ x : ℝ, inner ℝ (T x) x ≤ 2 * ‖x‖ ^ 2) ∧ T 1 = (2 : ℝ) • (3 / 4 : ℝ) ∧
    inner ℝ (A 1) 2 ^ 2 ≤ inner ℝ (A 1) 1 * inner ℝ (A 2) 2 ∧ ‖A 3‖ ≤ 1 / 2 * ‖(3 : ℝ)‖ ∧
    |inner ℝ (1 : ℝ) 1| ≤ (1 - 1 / 2) ^ 0 / (1 / 2) * ‖(1 : ℝ)‖ * ‖(3 / 4 : ℝ)‖ := by
  intro A T
  have hA : ∀ x : ℝ, A x = 1 / 2 * x := fun x => by simp [A]
  have hT : ∀ x : ℝ, T x = 3 / 2 * x := fun x => by simp [T]
  have hAsym : ∀ x y : ℝ, inner ℝ (A x) y = inner ℝ x (A y) := by
    intro x y; simp only [hA, RCLike.inner_apply, conj_trivial]; ring
  have hApos : ∀ x : ℝ, 0 ≤ inner ℝ (A x) x := by
    intro x; simp only [hA, RCLike.inner_apply, conj_trivial]; nlinarith [sq_nonneg x]
  have hAup : ∀ x : ℝ, inner ℝ (A x) x ≤ 1 / 2 * ‖x‖ ^ 2 := by
    intro x; simp only [hA, RCLike.inner_apply, conj_trivial, Real.norm_eq_abs, sq_abs]; nlinarith
  have hTsym : ∀ x y : ℝ, inner ℝ (T x) y = inner ℝ x (T y) := by
    intro x y; simp only [hT, RCLike.inner_apply, conj_trivial]; ring
  have hTlow : ∀ x : ℝ, 1 * ‖x‖ ^ 2 ≤ inner ℝ (T x) x := by
    intro x; simp only [hT, RCLike.inner_apply, conj_trivial, Real.norm_eq_abs, sq_abs]
    nlinarith [sq_nonneg x]
  have hTup : ∀ x : ℝ, inner ℝ (T x) x ≤ 2 * ‖x‖ ^ 2 := by
    intro x; simp only [hT, RCLike.inner_apply, conj_trivial, Real.norm_eq_abs, sq_abs]
    nlinarith [sq_nonneg x]
  have hTu : T 1 = (2 : ℝ) • (3 / 4 : ℝ) := by rw [hT, smul_eq_mul]; norm_num
  refine ⟨hAsym, hApos, hAup, hTsym, hTlow, hTup, hTu, psd_cauchy_schwarz A hAsym hApos 1 2,
    norm_le_of_form_bounds A hAsym (1 / 2) (by norm_num) hApos hAup 3, ?_⟩
  exact gap_decay T hTsym 1 2 one_pos (by norm_num) hTlow hTup (3 / 4) 1 1 hTu 0
    (fun j hj => absurd hj (Nat.not_lt_zero j))

/-- The transfer identity with two blocks, one index, `home = 0`, `Lift = 1`, `V = id` (as a map
to `Unit → ℝ`) and coefficients `ε 0 = 1`, `ε 1 = −1`. Conjuncts: the hypotheses `V(Lift) = δ`
and `∑_b ε b = 0`, then the two conclusions. -/
