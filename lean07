end CTprime

/-! ## Theorem U at ratio 3 -/

section TheoremU

/-- `C(r + 3, 3) · 6 = (r + 1)(r + 2)(r + 3)`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem choose_three_cast (r : ℕ) :
    (((r + 3).choose 3 : ℕ) : ℝ) * 6 = ((r : ℝ) + 1) * ((r : ℝ) + 2) * ((r : ℝ) + 3) := by
  have h1 : (r + 3) * (r + 2).choose 2 = (r + 3).choose 3 * 3 :=
    Nat.add_one_mul_choose_eq (r + 2) 2
  have h2 : (r + 2) * (r + 1).choose 1 = (r + 2).choose 2 * 2 :=
    Nat.add_one_mul_choose_eq (r + 1) 1
  rw [Nat.choose_one_right] at h2
  have h1' : ((r : ℝ) + 3) * (((r + 2).choose 2 : ℕ) : ℝ) = (((r + 3).choose 3 : ℕ) : ℝ) * 3 := by
    exact_mod_cast h1
  have h2' : ((r : ℝ) + 2) * ((r : ℝ) + 1) = (((r + 2).choose 2 : ℕ) : ℝ) * 2 := by
    exact_mod_cast h2
  linear_combination (-2 : ℝ) * h1' - ((r : ℝ) + 3) * h2'

/-- For `0 ≤ x < 1` and every `R`: `Σ_{t<R} (t + 1)³ x^t ≤ 6/(1 − x)⁴`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem annulus_series_le {x : ℝ} (hx0 : 0 ≤ x) (hx1 : x < 1) (R : ℕ) :
    ∑ t ∈ range R, ((t : ℝ) + 1) ^ 3 * x ^ t ≤ 6 / (1 - x) ^ 4 := by
  have hs := hasSum_choose_mul_geometric_of_norm_lt_one (𝕜 := ℝ) 3
    (by rwa [Real.norm_of_nonneg hx0])
  have hle : ∑ t ∈ range R, (((t + 3).choose 3 : ℕ) : ℝ) * x ^ t ≤ 1 / (1 - x) ^ 4 :=
    sum_le_hasSum (range R) (fun t _ => mul_nonneg (Nat.cast_nonneg _) (pow_nonneg hx0 t)) hs
  calc ∑ t ∈ range R, ((t : ℝ) + 1) ^ 3 * x ^ t
      ≤ ∑ t ∈ range R, 6 * ((((t + 3).choose 3 : ℕ) : ℝ) * x ^ t) := by
        refine Finset.sum_le_sum fun t _ => ?_
        have h := choose_three_cast t
        have ht : (0 : ℝ) ≤ t := Nat.cast_nonneg t
        have hxt : 0 ≤ x ^ t := pow_nonneg hx0 t
        have hpoly : ((t : ℝ) + 1) ^ 3 ≤ 6 * (((t + 3).choose 3 : ℕ) : ℝ) := by nlinarith
        calc ((t : ℝ) + 1) ^ 3 * x ^ t ≤ 6 * (((t + 3).choose 3 : ℕ) : ℝ) * x ^ t :=
              mul_le_mul_of_nonneg_right hpoly hxt
          _ = 6 * ((((t + 3).choose 3 : ℕ) : ℝ) * x ^ t) := by ring
    _ = 6 * ∑ t ∈ range R, (((t + 3).choose 3 : ℕ) : ℝ) * x ^ t := by rw [Finset.mul_sum]
    _ ≤ 6 * (1 / (1 - x) ^ 4) := mul_le_mul_of_nonneg_left hle (by norm_num)
    _ = 6 / (1 - x) ^ 4 := mul_one_div _ _

/-- **Weighted Cauchy–Schwarz.** `(Σ_i |x_i|)² ≤ (Σ_i e^{−2 g_i}) (Σ_i e^{2 g_i} x_i²)`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem weighted_l1_sq_le {ι : Type*} [Fintype ι] (x g : ι → ℝ) :
    (∑ i, |x i|) ^ 2 ≤ (∑ i, Real.exp (-(2 * g i))) * ∑ i, Real.exp (2 * g i) * x i ^ 2 :=
  Finset.sum_sq_le_sum_mul_sum_of_sq_le_mul _ (fun p _ => (Real.exp_pos _).le)
    (fun p _ => mul_nonneg (Real.exp_pos _).le (sq_nonneg _))
    (fun p _ => le_of_eq (by
      rw [sq_abs, ← mul_assoc, ← Real.exp_add, neg_add_cancel, Real.exp_zero, one_mul]))

/-- `√6144 = 32 √6`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem sqrt_6144 : √6144 = 32 * √6 := by
  rw [show (6144 : ℝ) = 32 ^ 2 * 6 by norm_num, Real.sqrt_mul (by norm_num), Real.sqrt_sq (by norm_num)]

/-- **Theorem U, the counting step.** Let `λ, L > 0` and `𝔐 ≥ 0`. If the weights satisfy the annulus
count `Σ_e e^{−2 f(e)} ≤ 256 L⁴ Σ_{t<R} (t + 1)³ e^{−2λt}` and the column satisfies `Σ_e e^{2
f(e)} u_e² ≤ (2𝔐)² L²`, then `‖u‖₁/L³ ≤ 32√6 𝔐/(1 − e^{−2λ})²`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem thmU_compose {ι : Type*} [Fintype ι] (u f : ι → ℝ) (R : ℕ) {lam L M : ℝ}
    (hlam : 0 < lam) (hL : 0 < L) (hM : 0 ≤ M)
    (hW : ∑ e, Real.exp (-(2 * f e)) ≤
      256 * L ^ 4 * ∑ t ∈ range R, ((t : ℝ) + 1) ^ 3 * Real.exp (-(2 * lam)) ^ t)
    (hE : ∑ e, Real.exp (2 * f e) * u e ^ 2 ≤ (2 * M) ^ 2 * L ^ 2) :
    (∑ e, |u e|) / L ^ 3 ≤ 32 * √6 * M / (1 - Real.exp (-(2 * lam))) ^ 2 := by
  set q := Real.exp (-(2 * lam)) with hq
  have hq0 : 0 ≤ q := (Real.exp_pos _).le
  have hq1 : q < 1 := Real.exp_lt_one_iff.2 (by linarith)
  have hd : 0 < 1 - q := by linarith
  have hS := annulus_series_le hq0 hq1 R
  have hW' : ∑ e, Real.exp (-(2 * f e)) ≤ 256 * L ^ 4 * (6 / (1 - q) ^ 4) :=
    hW.trans (mul_le_mul_of_nonneg_left hS (by positivity))
  have hE0 : 0 ≤ ∑ e, Real.exp (2 * f e) * u e ^ 2 :=
    Finset.sum_nonneg fun e _ => mul_nonneg (Real.exp_pos _).le (sq_nonneg _)
  have hprod : (∑ e, |u e|) ^ 2 ≤ (256 * L ^ 4 * (6 / (1 - q) ^ 4)) * ((2 * M) ^ 2 * L ^ 2) :=
    (weighted_l1_sq_le u f).trans (mul_le_mul hW' hE hE0 (by positivity))
  have hid : (256 * L ^ 4 * (6 / (1 - q) ^ 4)) * ((2 * M) ^ 2 * L ^ 2) =
      (32 * √6 * M / (1 - q) ^ 2 * L ^ 3) ^ 2 := by
    have h6 : √6 ^ 2 = 6 := Real.sq_sqrt (by norm_num)
    field_simp
    rw [h6]; ring
  have hrhs : 0 ≤ 32 * √6 * M / (1 - q) ^ 2 * L ^ 3 := by positivity
  rw [div_le_iff₀ (by positivity)]
  have := abs_le_of_sq_le_sq' (hprod.trans_eq hid) hrhs
  exact this.2

/-- `x (1 − x) ≤ 1 − e^{−x}` for `x ≥ 0`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem one_sub_exp_neg_ge {x : ℝ} (hx : 0 ≤ x) : x * (1 - x) ≤ 1 - Real.exp (-x) := by
  have h1 : x * Real.exp (-x) ≤ 1 - Real.exp (-x) := by
    have h := Real.add_one_le_exp x
    have h2 : Real.exp x * Real.exp (-x) = 1 := by rw [← Real.exp_add, add_neg_cancel, Real.exp_zero]
    have h3 := Real.exp_pos (-x)
    nlinarith [mul_le_mul_of_nonneg_right h (Real.exp_pos (-x)).le]
  have h2 : 1 - x ≤ Real.exp (-x) := by linarith [Real.add_one_le_exp (-x)]
  nlinarith

/-- If `0 ≤ 𝔐 ≤ 4.79·10¹²` and `5.48·10⁻²⁰ ≤ λ ≤ 10⁻⁴`, then `32√6 𝔐/(1 − e^{−2λ})² ≤ 3.2·10⁵²`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem U3_numeric {M lam : ℝ} (hM0 : 0 ≤ M) (hM : M ≤ 479 * 10 ^ 10) (hl : 548 / 10 ^ 22 ≤ lam)
    (hl' : lam ≤ 1 / 10000) :
    32 * √6 * M / (1 - Real.exp (-(2 * lam))) ^ 2 ≤ 32 * 10 ^ 51 := by
  have hlam : 0 < lam := lt_of_lt_of_le (by norm_num) hl
  have h1 := one_sub_exp_neg_ge (x := 2 * lam) (by positivity)
  have hpos : 0 < 2 * lam * (1 - 2 * lam) := by nlinarith
  have hsq : (2 * lam * (1 - 2 * lam)) ^ 2 ≤ (1 - Real.exp (-(2 * lam))) ^ 2 :=
    pow_le_pow_left₀ hpos.le h1 2
  have s6 : √6 ≤ 24495 / 10000 := by
    rw [show (24495 / 10000 : ℝ) = √((24495 / 10000) ^ 2) by rw [Real.sqrt_sq (by norm_num)]]
    exact Real.sqrt_le_sqrt (by norm_num)
  have hnum : 32 * √6 * M ≤ 32 * (24495 / 10000) * (479 * 10 ^ 10) := by
    have := Real.sqrt_nonneg 6; nlinarith
  have hden : (2 * (548 / 10 ^ 22) * (1 - 2 * (1 / 10000))) ^ 2 ≤ (2 * lam * (1 - 2 * lam)) ^ 2 := by
    apply pow_le_pow_left₀ (by norm_num)
    apply mul_le_mul (by linarith) (by linarith) (by norm_num) (by linarith)
  calc 32 * √6 * M / (1 - Real.exp (-(2 * lam))) ^ 2
      ≤ 32 * (24495 / 10000) * (479 * 10 ^ 10) / (2 * (548 / 10 ^ 22) * (1 - 2 * (1 / 10000))) ^ 2 :=
        div_le_div₀ (by positivity) hnum (by norm_num) (hden.trans hsq)
    _ ≤ 32 * 10 ^ 51 := by norm_num

end TheoremU

/-! ## Lemma TB at ratio 3: the tree-gauge loss -/

section TreeGauge

variable {ρ ι : Type*} [Fintype ρ] [Fintype ι]

/-- The `ℓ¹` norm `Σ_i |x_i|`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
def l1 {α : Type*} [Fintype α] (x : α → ℝ) : ℝ := ∑ i, |x i|

/-- The squared `ℓ²` norm `Σ_i x_i²`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
def sqNorm {α : Type*} [Fintype α] (x : α → ℝ) : ℝ := ∑ i, x i ^ 2

/-- The energy `Q(x) = ‖D x‖²` of a link field `x` for a curvature matrix `D`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
def energy (D : Matrix ρ ι ℝ) (x : ι → ℝ) : ℝ := ∑ p, (D *ᵥ x) p ^ 2

/-- The weighted field `e^f x`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
def weighted (f x : ι → ℝ) : ι → ℝ := fun e => Real.exp (f e) * x e

/-- **Commutator of a weight with the curvature.** If the rows of `|D|` sum to at most `m ≥ 0`, its
columns to at most `n`, and `|e^{g(p) − f(e)} − 1| ≤ η` wherever `D_{pe} ≠ 0`, then `Σ_p e^{2
g(p)} (D u)_p² ≤ 2 Q(e^f u) + 2 η² m n ‖e^f u‖²`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem commutator_energy_le (D : Matrix ρ ι ℝ) (f u : ι → ℝ) (g : ρ → ℝ) {η m n : ℝ}
    (hm : 0 ≤ m) (hrow : ∀ p, ∑ e, |D p e| ≤ m) (hcol : ∀ e, ∑ p, |D p e| ≤ n)
    (hη : ∀ p e, D p e ≠ 0 → |Real.exp (g p - f e) - 1| ≤ η) :
    ∑ p, Real.exp (2 * g p) * (D *ᵥ u) p ^ 2 ≤
      2 * energy D (weighted f u) + 2 * (η ^ 2 * m * n) * sqNorm (weighted f u) := by
  have hcomm : ∀ p, Real.exp (g p) * (D *ᵥ u) p - (D *ᵥ weighted f u) p =
      ∑ e, D p e * (Real.exp (g p - f e) - 1) * weighted f u e := by
    intro p
    simp only [Matrix.mulVec, dotProduct, weighted, Finset.mul_sum, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun e _ => ?_
    have hexp : Real.exp (g p) = Real.exp (g p - f e) * Real.exp (f e) := by
      rw [← Real.exp_add, sub_add_cancel]
    rw [hexp]
    ring
  have hpt : ∀ p, (Real.exp (g p) * (D *ᵥ u) p - (D *ᵥ weighted f u) p) ^ 2 ≤
      η ^ 2 * m * ∑ e, |D p e| * weighted f u e ^ 2 := by
    intro p
    rw [hcomm p]
    have h1 : |∑ e, D p e * (Real.exp (g p - f e) - 1) * weighted f u e| ≤
        η * ∑ e, |D p e| * |weighted f u e| := by
      rw [Finset.mul_sum]
      refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun e _ => ?_)
      rw [abs_mul, abs_mul]
      by_cases hD : D p e = 0
      · simp [hD]
      · calc |D p e| * |Real.exp (g p - f e) - 1| * |weighted f u e|
            ≤ |D p e| * η * |weighted f u e| := by
              gcongr
              exact hη p e hD
          _ = η * (|D p e| * |weighted f u e|) := by ring
    have h2 : (∑ e, |D p e| * |weighted f u e|) ^ 2 ≤
        (∑ e, |D p e|) * ∑ e, |D p e| * weighted f u e ^ 2 :=
      Finset.sum_sq_le_sum_mul_sum_of_sq_le_mul _ (fun e _ => abs_nonneg _)
        (fun e _ => mul_nonneg (abs_nonneg _) (sq_nonneg _))
        (fun e _ => le_of_eq (by rw [mul_pow, sq_abs (weighted f u e)]; ring))
    have h3 : 0 ≤ ∑ e, |D p e| * weighted f u e ^ 2 :=
      Finset.sum_nonneg fun e _ => mul_nonneg (abs_nonneg _) (sq_nonneg _)
    calc (∑ e, D p e * (Real.exp (g p - f e) - 1) * weighted f u e) ^ 2
        = |∑ e, D p e * (Real.exp (g p - f e) - 1) * weighted f u e| ^ 2 := (sq_abs _).symm
      _ ≤ (η * ∑ e, |D p e| * |weighted f u e|) ^ 2 := pow_le_pow_left₀ (abs_nonneg _) h1 2
      _ = η ^ 2 * (∑ e, |D p e| * |weighted f u e|) ^ 2 := by ring
      _ ≤ η ^ 2 * ((∑ e, |D p e|) * ∑ e, |D p e| * weighted f u e ^ 2) :=
          mul_le_mul_of_nonneg_left h2 (sq_nonneg η)
      _ ≤ η ^ 2 * (m * ∑ e, |D p e| * weighted f u e ^ 2) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right (hrow p) h3) (sq_nonneg η)
      _ = η ^ 2 * m * ∑ e, |D p e| * weighted f u e ^ 2 := by ring
  have hdouble : ∑ p, ∑ e, |D p e| * weighted f u e ^ 2 ≤ n * sqNorm (weighted f u) := by
    rw [Finset.sum_comm]
    unfold sqNorm
    rw [Finset.mul_sum]
    refine Finset.sum_le_sum fun e _ => ?_
    rw [← Finset.sum_mul]
    exact mul_le_mul_of_nonneg_right (hcol e) (sq_nonneg _)
  have hsplit : ∀ p, Real.exp (2 * g p) * (D *ᵥ u) p ^ 2 ≤
      2 * (D *ᵥ weighted f u) p ^ 2 + 2 * (η ^ 2 * m * ∑ e, |D p e| * weighted f u e ^ 2) := by
    intro p
    have hexp : Real.exp (2 * g p) = Real.exp (g p) ^ 2 := by
      rw [sq, ← Real.exp_add, two_mul]
    rw [hexp]
    nlinarith [hpt p, sq_nonneg (Real.exp (g p) * (D *ᵥ u) p - 2 * (D *ᵥ weighted f u) p),
      sq_nonneg (2 * (D *ᵥ weighted f u) p - Real.exp (g p) * (D *ᵥ u) p)]
  have hηm : 0 ≤ 2 * (η ^ 2 * m) := mul_nonneg (by norm_num) (mul_nonneg (sq_nonneg η) hm)
  calc ∑ p, Real.exp (2 * g p) * (D *ᵥ u) p ^ 2
      ≤ ∑ p, (2 * (D *ᵥ weighted f u) p ^ 2 +
          2 * (η ^ 2 * m * ∑ e, |D p e| * weighted f u e ^ 2)) :=
        Finset.sum_le_sum fun p _ => hsplit p
    _ = 2 * energy D (weighted f u) +
          2 * (η ^ 2 * m) * ∑ p, ∑ e, |D p e| * weighted f u e ^ 2 := by
        rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum, ← Finset.mul_sum]
        unfold energy
        ring
    _ ≤ 2 * energy D (weighted f u) + 2 * (η ^ 2 * m) * (n * sqNorm (weighted f u)) := by
        linarith [mul_le_mul_of_nonneg_left hdouble hηm]
    _ = 2 * energy D (weighted f u) + 2 * (η ^ 2 * m * n) * sqNorm (weighted f u) := by ring

/-- **Weighted curvature energy at block side `L`.** Let `L ≥ 1` and `λ ≥ 0` with `96 λ² ≤ 1`; let
the rows of `|D|` sum to at most 4 and its columns to at most 6, and `|g(p) − f(e)| ≤ λ/L`
wherever `D_{pe} ≠ 0`. If `Q(e^f u) + ‖e^f u‖²/L² ≤ (2𝔐)²`, then `Σ_p e^{2 g(p)} (D u)_p² ≤ 8
𝔐²`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem weighted_curvature_ratio (D : Matrix ρ ι ℝ) (f u : ι → ℝ) (g : ρ → ℝ) {L lam M : ℝ}
    (hL : 1 ≤ L) (hlam : 0 ≤ lam) (hlam96 : 96 * lam ^ 2 ≤ 1)
    (hrow : ∀ p, ∑ e, |D p e| ≤ 4) (hcol : ∀ e, ∑ p, |D p e| ≤ 6)
    (hlip : ∀ p e, D p e ≠ 0 → |g p - f e| ≤ lam / L)
    (hV : energy D (weighted f u) + sqNorm (weighted f u) / L ^ 2 ≤ (2 * M) ^ 2) :
    ∑ p, Real.exp (2 * g p) * (D *ᵥ u) p ^ 2 ≤ 8 * M ^ 2 := by
  have hL0 : 0 < L := by linarith
  have hlam1 : lam ≤ 1 := by nlinarith
  have hstep : lam / L ≤ 1 := (div_le_self hlam hL).trans hlam1
  have hη : ∀ p e, D p e ≠ 0 → |Real.exp (g p - f e) - 1| ≤ 2 * (lam / L) := by
    intro p e hD
    have h := hlip p e hD
    have := Real.abs_exp_sub_one_le (h.trans hstep)
    linarith
  have hmain := commutator_energy_le D f u g (by norm_num : (0 : ℝ) ≤ 4) hrow hcol hη
  have hN : 0 ≤ sqNorm (weighted f u) / L ^ 2 :=
    div_nonneg (Finset.sum_nonneg fun _ _ => sq_nonneg _) (by positivity)
  have hcoef : 2 * ((2 * (lam / L)) ^ 2 * 4 * 6) * sqNorm (weighted f u) =
      192 * lam ^ 2 * (sqNorm (weighted f u) / L ^ 2) := by
    field_simp; ring
  have h192 : 192 * lam ^ 2 * (sqNorm (weighted f u) / L ^ 2) ≤
      2 * (sqNorm (weighted f u) / L ^ 2) := mul_le_mul_of_nonneg_right (by linarith) hN
  have hM2 : (2 * M) ^ 2 = 4 * M ^ 2 := by ring
  linarith

/-- The leading constant `κ_lead = 24 √2 𝔐/λ²` of the curvature mass.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
def kappaLead (M lam : ℝ) : ℝ := 24 * √2 * M / lam ^ 2

/-- **Curvature mass at block side `L`.** Let `L > 0`, `𝔐 ≥ 0` and `s ≥ 0`. If `Σ_p e^{−2 g(p)} ≤
144 (L/λ)⁴ s²` and `Σ_p e^{2 g(p)} x_p² ≤ 8 𝔐²`, then `‖x‖₁/L² ≤ s κ_lead`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem curvature_mass_ratio (x g : ρ → ℝ) {L M lam s : ℝ} (hL : 0 < L) (hM : 0 ≤ M)
    (hs : 0 ≤ s)
    (hW : ∑ p, Real.exp (-(2 * g p)) ≤ 144 * (L / lam) ^ 4 * s ^ 2)
    (hE : ∑ p, Real.exp (2 * g p) * x p ^ 2 ≤ 8 * M ^ 2) :
    l1 x / L ^ 2 ≤ s * kappaLead M lam := by
  have hE0 : 0 ≤ ∑ p, Real.exp (2 * g p) * x p ^ 2 :=
    Finset.sum_nonneg fun p _ => mul_nonneg (Real.exp_pos _).le (sq_nonneg _)
  have hprod : l1 x ^ 2 ≤ (144 * (L / lam) ^ 4 * s ^ 2) * (8 * M ^ 2) :=
    (weighted_l1_sq_le x g).trans (mul_le_mul hW hE hE0 (by positivity))
  have hid : (144 * (L / lam) ^ 4 * s ^ 2) * (8 * M ^ 2) = (s * kappaLead M lam * L ^ 2) ^ 2 := by
    unfold kappaLead
    have h2 : √2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)
    rw [div_pow, mul_pow, mul_pow, div_pow, mul_pow, mul_pow, h2]
    ring
  have hrhs : 0 ≤ s * kappaLead M lam * L ^ 2 := by unfold kappaLead; positivity
  rw [div_le_iff₀ (by positivity)]
  exact (le_abs_self _).trans (abs_le_of_sq_le_sq (hprod.trans_eq hid) hrhs)

/-- **The shell series.** For `0 ≤ x < 1` and every `R`: `Σ_{r<R} (64 r³ + 16 r + 1) x^r ≤ 384/(1 −
x)⁴`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem shell_series_le {x : ℝ} (hx0 : 0 ≤ x) (hx1 : x < 1) (R : ℕ) :
    ∑ r ∈ range R, (64 * (r : ℝ) ^ 3 + 16 * r + 1) * x ^ r ≤ 384 / (1 - x) ^ 4 := by
  have hs := hasSum_choose_mul_geometric_of_norm_lt_one (𝕜 := ℝ) 3
    (by rwa [Real.norm_of_nonneg hx0])
  have hle : ∑ r ∈ range R, (((r + 3).choose 3 : ℕ) : ℝ) * x ^ r ≤ 1 / (1 - x) ^ 4 :=
    sum_le_hasSum (range R) (fun r _ => mul_nonneg (Nat.cast_nonneg _) (pow_nonneg hx0 r)) hs
  calc ∑ r ∈ range R, (64 * (r : ℝ) ^ 3 + 16 * r + 1) * x ^ r
      ≤ ∑ r ∈ range R, 384 * ((((r + 3).choose 3 : ℕ) : ℝ) * x ^ r) := by
        refine Finset.sum_le_sum fun r _ => ?_
        have h := choose_three_cast r
        have hr : (0 : ℝ) ≤ r := Nat.cast_nonneg r
        have hxr : 0 ≤ x ^ r := pow_nonneg hx0 r
        have hpoly : 64 * (r : ℝ) ^ 3 + 16 * r + 1 ≤ 384 * (((r + 3).choose 3 : ℕ) : ℝ) := by
          nlinarith
        calc (64 * (r : ℝ) ^ 3 + 16 * r + 1) * x ^ r
            ≤ 384 * (((r + 3).choose 3 : ℕ) : ℝ) * x ^ r :=
              mul_le_mul_of_nonneg_right hpoly hxr
          _ = 384 * ((((r + 3).choose 3 : ℕ) : ℝ) * x ^ r) := by ring
    _ = 384 * ∑ r ∈ range R, (((r + 3).choose 3 : ℕ) : ℝ) * x ^ r := by rw [Finset.mul_sum]
    _ ≤ 384 * (1 / (1 - x) ^ 4) := mul_le_mul_of_nonneg_left hle (by norm_num)
    _ = 384 / (1 - x) ^ 4 := mul_one_div _ _

/-- `b e^{−b} ≤ 1 − e^{−b}` for every real `b`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem mul_exp_neg_le_one_sub (b : ℝ) : b * Real.exp (-b) ≤ 1 - Real.exp (-b) := by
  have h1 := Real.add_one_le_exp b
  have h2 : Real.exp b * Real.exp (-b) = 1 := by
    rw [← Real.exp_add, add_neg_cancel, Real.exp_zero]
  have h3 := Real.exp_pos (-b)
  nlinarith [mul_le_mul_of_nonneg_right h1 h3.le]

/-- **Explicit shell bound.** For `b > 0` and every `R`: `Σ_{r<R} (64 r³ + 16 r + 1) e^{−br} ≤ 384
e^{4b}/b⁴`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem shell_weight_le {b : ℝ} (hb : 0 < b) (R : ℕ) :
    ∑ r ∈ range R, (64 * (r : ℝ) ^ 3 + 16 * r + 1) * Real.exp (-b) ^ r ≤
      384 * Real.exp b ^ 4 / b ^ 4 := by
  have hx1 : Real.exp (-b) < 1 := Real.exp_lt_one_iff.2 (by linarith)
  refine (shell_series_le (Real.exp_pos _).le hx1 R).trans ?_
  have hpos : 0 < b * Real.exp (-b) := mul_pos hb (Real.exp_pos _)
  have h4 : (b * Real.exp (-b)) ^ 4 ≤ (1 - Real.exp (-b)) ^ 4 :=
    pow_le_pow_left₀ hpos.le (mul_exp_neg_le_one_sub b) 4
  refine (div_le_div_of_nonneg_left (by norm_num) (by positivity) h4).trans (le_of_eq ?_)
  have hb0 : b ≠ 0 := hb.ne'
  have he : Real.exp b ≠ 0 := (Real.exp_pos b).ne'
  rw [Real.exp_neg]
  field_simp

/-- At `b = 2λ/L` with `L, λ > 0`: `6 · 384 e^{4b}/b⁴ = 144 (L/λ)⁴ (e^{2b})²`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem weight_bound_ratio {L lam : ℝ} (hL : 0 < L) (hlam : 0 < lam) :
    6 * (384 * Real.exp (2 * lam / L) ^ 4 / (2 * lam / L) ^ 4) =
      144 * (L / lam) ^ 4 * (Real.exp (2 * lam / L) ^ 2) ^ 2 := by
  have hl : lam ≠ 0 := hlam.ne'
  have hL' : L ≠ 0 := hL.ne'
  field_simp
  ring

/-- **Absorption of the excess factor.** For `L ≥ 1` and `λ ≤ 1/4`: `(1 − 1/L) e^{4λ/L} ≤ 1`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem absorb {L lam : ℝ} (hL : 1 ≤ L) (hlam4 : lam ≤ 1 / 4) :
    (1 - 1 / L) * Real.exp (4 * lam / L) ≤ 1 := by
  have hL0 : 0 < L := by linarith
  have hε : 1 - 1 / L ≤ Real.exp (-(1 / L)) := by linarith [Real.add_one_le_exp (-(1 / L))]
  have hε0 : 0 ≤ 1 - 1 / L := by
    have : 1 / L ≤ 1 := by rw [div_le_one hL0]; exact hL
    linarith
  calc (1 - 1 / L) * Real.exp (4 * lam / L) ≤ Real.exp (-(1 / L)) * Real.exp (4 * lam / L) :=
        mul_le_mul_of_nonneg_right hε (Real.exp_pos _).le
    _ = Real.exp (-(1 / L) + 4 * lam / L) := by rw [← Real.exp_add]
    _ ≤ Real.exp 0 := by
        apply Real.exp_le_exp.2
        have : 4 * lam / L ≤ 1 / L := div_le_div_of_nonneg_right (by linarith) hL0.le
        linarith
    _ = 1 := Real.exp_zero

/-- **From the `ℓ¹` inequality to the loss at block ratio 3.** Let `L ≥ 1`, `λ ≤ 1/4` and `C, κ ≥
0`. If `Φ ≤ L³ + C ((L − 1)/2) c` and `c/L² ≤ e^{4λ/L} κ`, then `Φ/L³ ≤ 1 + (C/2) κ`. In the
intended reading `L = 3^k`, `(L − 1)/2 = Σ_{i<k} 3^i` is the level sum of the tree-gauge `ℓ¹`
inequality and `c` the curvature mass.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem loss_ratio3 {L lam Φ c C κ : ℝ} (hL : 1 ≤ L) (hlam4 : lam ≤ 1 / 4)
    (hC : 0 ≤ C) (hκ : 0 ≤ κ) (hB : Φ ≤ L ^ 3 * 1 + C * ((L - 1) / 2) * c)
    (hmass : c / L ^ 2 ≤ Real.exp (4 * lam / L) * κ) : Φ / L ^ 3 ≤ 1 + C / 2 * κ := by
  have hL0 : 0 < L := by linarith
  have hc : c ≤ Real.exp (4 * lam / L) * κ * L ^ 2 := (div_le_iff₀ (by positivity)).1 hmass
  have hL1 : 0 ≤ L - 1 := by linarith
  have hab := absorb hL hlam4
  have hexp := (Real.exp_pos (4 * lam / L)).le
  rw [div_le_iff₀ (by positivity)]
  have h1 : C * ((L - 1) / 2) * c ≤ C * ((L - 1) / 2) * (Real.exp (4 * lam / L) * κ * L ^ 2) :=
    mul_le_mul_of_nonneg_left hc (by positivity)
  have h2 : C * ((L - 1) / 2) * (Real.exp (4 * lam / L) * κ * L ^ 2) =
      C / 2 * κ * L ^ 3 * ((1 - 1 / L) * Real.exp (4 * lam / L)) := by
    field_simp
  have h3 : C / 2 * κ * L ^ 3 * ((1 - 1 / L) * Real.exp (4 * lam / L)) ≤ C / 2 * κ * L ^ 3 * 1 :=
    mul_le_mul_of_nonneg_left hab (by positivity)
  nlinarith

/-- **The level sum at block ratio 3.** If `C ≥ 0`, `Φ ≤ s a + Σ_{i<k} C 27^i F_i` and `F_i ≤
F₀/9^i` for every `i < k`, then `Φ ≤ s a + C ((3^k − 1)/2) F₀`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem level_sum_ratio3 {k : ℕ} {C s a Φ F₀ : ℝ} (F : ℕ → ℝ) (hC : 0 ≤ C)
    (htel : Φ ≤ s * a + ∑ i ∈ range k, C * 27 ^ i * F i)
    (hcontr : ∀ i < k, F i ≤ F₀ / 9 ^ i) :
    Φ ≤ s * a + C * ((3 ^ k - 1) / 2) * F₀ := by
  have hterm : ∀ i ∈ range k, C * 27 ^ i * F i ≤ C * F₀ * 3 ^ i := by
    intro i hi
    have hpos : (0 : ℝ) < 9 ^ i := by positivity
    have h := hcontr i (mem_range.mp hi)
    rw [le_div_iff₀ hpos] at h
    have h27 : (27 : ℝ) ^ i = 9 ^ i * 3 ^ i := by rw [← mul_pow]; norm_num
    rw [h27]
    calc C * (9 ^ i * 3 ^ i) * F i = C * 3 ^ i * (F i * 9 ^ i) := by ring
      _ ≤ C * 3 ^ i * F₀ := mul_le_mul_of_nonneg_left h (by positivity)
      _ = C * F₀ * 3 ^ i := by ring
  have hgeom : ∑ i ∈ range k, (3 : ℝ) ^ i = (3 ^ k - 1) / 2 := by
    rw [geom_sum_eq (by norm_num : (3 : ℝ) ≠ 1) k]; norm_num
  calc Φ ≤ s * a + ∑ i ∈ range k, C * 27 ^ i * F i := htel
    _ ≤ s * a + ∑ i ∈ range k, C * F₀ * 3 ^ i := by linarith [sum_le_sum hterm]
    _ = s * a + C * F₀ * ∑ i ∈ range k, (3 : ℝ) ^ i := by rw [mul_sum]
    _ = s * a + C * ((3 ^ k - 1) / 2) * F₀ := by rw [hgeom]; ring

/-- The constant of the tree-gauge `ℓ¹` inequality at block ratio 3 in dimension 4: `C₄(3) = 2 · 4 ·
27 · c₂ + c₁ c_B` (box multiplicity `2d = 8`, `27` crossing children per coarse link).

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
def treeConst3 (c₁ c₂ cB : ℝ) : ℝ := 2 * 4 * 27 * c₂ + c₁ * cB

/-- `C₄(3) = 216 c₂ + c₁ c_B`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem treeConst3_eq (c₁ c₂ cB : ℝ) : treeConst3 c₁ c₂ cB = 216 * c₂ + c₁ * cB := by
  unfold treeConst3; ring

/-- `C₄(3) ≤ 1000` for `c₁ = 1`, `c_B = 136` and `c₂ ≤ 4`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem treeConst3_le {c₂ : ℝ} (hc₂ : c₂ ≤ 4) : treeConst3 1 c₂ 136 ≤ 1000 := by
  rw [treeConst3_eq]; linarith

/-- `C₄(3) ≤ 873` if `c₂ ≤ 4` and `c₁ c_B ≤ 9`. The input `c₁ c_B ≤ 9` (in the intended reading,
the filling multiplicity 9 of the inside chains of a side-3 block) is a hypothesis and is not proved
in this file; the composition (`tb3_bound`) uses `C ≤ 1000`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem treeConst3_le_873 {c₁ c₂ cB : ℝ} (hc₂ : c₂ ≤ 4) (hcB : c₁ * cB ≤ 9) :
    treeConst3 c₁ c₂ cB ≤ 873 := by
  rw [treeConst3_eq]; linarith

/-- The `ℓ¹` distance on the grid `{0,1,2}³`, its points encoded as `a < 27` by base-3 digits.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
def dist3 (a b : ℕ) : ℕ :=
  Nat.dist (a / 9) (b / 9) + Nat.dist (a / 3 % 3) (b / 3 % 3) + Nat.dist (a % 3) (b % 3)

/-- For every point `a` of `{0,1,2}³`, `Σ_b |a − b|₁ ≤ 81`: the mean distance to the 27 points is at
most 3. Checked by `decide`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem dist3_sum_le : ∀ a < 27, ∑ b ∈ range 27, dist3 a b ≤ 81 := by decide

/-- The `ℓ¹` diameter of `{0,1,2}³` is at most 6. Checked by `decide`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem dist3_le : ∀ a < 27, ∀ b < 27, dist3 a b ≤ 6 := by decide

/-- **Crossing links at block ratio 3 (`c₂ ≤ 4`).** Let `y_a`, `a ∈ {0,1,2}³`, satisfy `|y_a −
y_{a'}| ≤ |a − a'|₁ σ` with `σ ≥ 0`, and let `|S| ≤ σ`. Then `(1/27) Σ_a y_a + S` is within `4σ`
of every `y_a`. In the intended reading the `y_a` are the 27 crossing children of a coarse link,
the path bound comes from one face plaquette per grid edge, and `S` collects the inside links of
the parent's average.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem crossing_link3 (y : Fin 27 → ℝ) {S σ : ℝ} (hσ : 0 ≤ σ)
    (hpath : ∀ a a' : Fin 27, |y a - y a'| ≤ (dist3 a a' : ℝ) * σ) (hS : |S| ≤ σ) (a : Fin 27) :
    |y a - ((1 / 27) * ∑ a', y a' + S)| ≤ 4 * σ := by
  have hsumd : ∑ a' : Fin 27, (dist3 a a' : ℝ) ≤ 81 := by
    have h := dist3_sum_le a a.isLt
    have : ∑ a' : Fin 27, (dist3 a a' : ℝ) = ((∑ b ∈ range 27, dist3 a b : ℕ) : ℝ) := by
      rw [Nat.cast_sum, ← Fin.sum_univ_eq_sum_range (fun b => (dist3 a b : ℝ)) 27]
    rw [this]; exact_mod_cast h
  have hmean : y a - (1 / 27) * ∑ a', y a' = (1 / 27) * ∑ a', (y a - y a') := by
    rw [Finset.sum_sub_distrib, Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
    push_cast
    ring
  have h1 : |(1 / 27 : ℝ) * ∑ a', (y a - y a')| ≤ 3 * σ := by
    have hsum : ∑ a', |y a - y a'| ≤ ∑ a' : Fin 27, (dist3 a a' : ℝ) * σ :=
      Finset.sum_le_sum fun a' _ => hpath a a'
    rw [← Finset.sum_mul] at hsum
    have habs := (Finset.abs_sum_le_sum_abs _ _).trans hsum
    rw [abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 1 / 27)]
    have := mul_le_mul_of_nonneg_right hsumd hσ
    nlinarith
  calc |y a - ((1 / 27) * ∑ a', y a' + S)|
      = |(y a - (1 / 27) * ∑ a', y a') + -S| := by congr 1; ring
    _ ≤ |y a - (1 / 27) * ∑ a', y a'| + |-S| := abs_add_le _ _
    _ = |(1 / 27 : ℝ) * ∑ a', (y a - y a')| + |S| := by rw [hmean, abs_neg]
    _ ≤ 3 * σ + σ := add_le_add h1 hS
    _ = 4 * σ := by ring

/-- **Lemma TB at block side `L`, composed.** The hypothesis on `‖φ‖₁` is the ratio-3 form of the
tree-gauge `ℓ¹` inequality: value coefficient `L³ = 27^k` and level sum `(L − 1)/2 = Σ_{i<k} 3^i`
(the ratio-2 form has level sum `L − 1`). The curvature identity `D φ = D u` is a hypothesis; it is
not proved in this file. Let `L ≥ 1`, `𝔐 ≥ 0`, `0 < λ ≤ 10⁻⁴` and `C ≥ 0`.
Assume: the rows of `|D|` sum to at most 4 and its columns to at most 6; `|g(p) − f(e)| ≤ λ/L`
wherever `D_{pe} ≠ 0`; the shell count `Σ_p e^{−2 g(p)} ≤ 6 Σ_{r<R} (64 r³ + 16 r + 1)
e^{−(2λ/L) r}`; `Q(e^f u) + ‖e^f u‖²/L² ≤ (2𝔐)²`; `D φ = D u`; the `ℓ¹` inequality `‖φ‖₁ ≤ L³ ‖A
φ‖₁ + C ((L − 1)/2) ‖D φ‖₁`; and `‖A φ‖₁ = 1`. Then `‖D φ‖₁/L² ≤ e^{4λ/L} κ_lead` and `‖φ‖₁/L³ ≤
1 + (C/2) κ_lead`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem tb3_loss (D : Matrix ρ ι ℝ) {γ : Type*} [Fintype γ] (A : Matrix γ ι ℝ) (φ u f : ι → ℝ)
    (g : ρ → ℝ) (R : ℕ) {L M lam C : ℝ} (hL : 1 ≤ L) (hM : 0 ≤ M) (hlam : 0 < lam)
    (hlam' : lam ≤ 1 / 10000) (hC0 : 0 ≤ C)
    (hrow : ∀ p, ∑ e, |D p e| ≤ 4) (hcol : ∀ e, ∑ p, |D p e| ≤ 6)
    (hlip : ∀ p e, D p e ≠ 0 → |g p - f e| ≤ lam / L)
    (hshell : ∑ p, Real.exp (-(2 * g p)) ≤
      6 * ∑ r ∈ range R, (64 * (r : ℝ) ^ 3 + 16 * r + 1) * Real.exp (-(2 * lam / L)) ^ r)
    (hV : energy D (weighted f u) + sqNorm (weighted f u) / L ^ 2 ≤ (2 * M) ^ 2)
    (hcurv : D *ᵥ φ = D *ᵥ u)
    (hB : l1 φ ≤ L ^ 3 * l1 (A *ᵥ φ) + C * ((L - 1) / 2) * l1 (D *ᵥ φ))
    (hA : l1 (A *ᵥ φ) = 1) :
    l1 (D *ᵥ φ) / L ^ 2 ≤ Real.exp (4 * lam / L) * kappaLead M lam ∧
      l1 φ / L ^ 3 ≤ 1 + C / 2 * kappaLead M lam := by
  have hL0 : 0 < L := by linarith
  have hlam96 : 96 * lam ^ 2 ≤ 1 := by nlinarith
  have hE := weighted_curvature_ratio D f u g hL hlam.le hlam96 hrow hcol hlip hV
  have hb : 0 < 2 * lam / L := by positivity
  have hW : ∑ p, Real.exp (-(2 * g p)) ≤
      144 * (L / lam) ^ 4 * (Real.exp (2 * lam / L) ^ 2) ^ 2 := by
    calc ∑ p, Real.exp (-(2 * g p))
        ≤ 6 * ∑ r ∈ range R, (64 * (r : ℝ) ^ 3 + 16 * r + 1) * Real.exp (-(2 * lam / L)) ^ r :=
          hshell
      _ ≤ 6 * (384 * Real.exp (2 * lam / L) ^ 4 / (2 * lam / L) ^ 4) :=
          mul_le_mul_of_nonneg_left (shell_weight_le hb R) (by norm_num)
      _ = 144 * (L / lam) ^ 4 * (Real.exp (2 * lam / L) ^ 2) ^ 2 := weight_bound_ratio hL0 hlam
  have hs2 : Real.exp (2 * lam / L) ^ 2 = Real.exp (4 * lam / L) := by
    rw [← Real.exp_nat_mul]; congr 1; push_cast; ring
  rw [hs2] at hW
  have hκ : l1 (D *ᵥ φ) / L ^ 2 ≤ Real.exp (4 * lam / L) * kappaLead M lam := by
    rw [hcurv]
    exact curvature_mass_ratio (D *ᵥ u) g hL0 hM (Real.exp_pos _).le hW hE
  refine ⟨hκ, ?_⟩
  have hK0 : 0 ≤ kappaLead M lam := by unfold kappaLead; positivity
  rw [hA] at hB
  exact loss_ratio3 hL (by linarith) hC0 hK0 hB hκ

/-- If `0 ≤ 𝔐 ≤ 4.79·10¹²` and `λ ≥ 5.48·10⁻²⁰`, then `κ_lead ≤ 5.5·10⁵²`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem kappaLead3_le {M lam : ℝ} (hM0 : 0 ≤ M) (hM : M ≤ 479 * 10 ^ 10)
    (hlam : 548 / 10 ^ 22 ≤ lam) : kappaLead M lam ≤ 55 * 10 ^ 51 := by
  have h2 : √2 ≤ 14143 / 10000 := by
    rw [show (14143 / 10000 : ℝ) = √((14143 / 10000) ^ 2) by rw [Real.sqrt_sq (by norm_num)]]
    exact Real.sqrt_le_sqrt (by norm_num)
  have hl2 : (548 / 10 ^ 22 : ℝ) ^ 2 ≤ lam ^ 2 := pow_le_pow_left₀ (by norm_num) hlam 2
  have hnum : 24 * √2 * M ≤ 24 * (14143 / 10000) * (479 * 10 ^ 10) := by
    have := Real.sqrt_nonneg 2; nlinarith
  unfold kappaLead
  calc 24 * √2 * M / lam ^ 2 ≤ 24 * (14143 / 10000) * (479 * 10 ^ 10) / (548 / 10 ^ 22) ^ 2 :=
        div_le_div₀ (by norm_num) hnum (by norm_num) hl2
    _ ≤ 55 * 10 ^ 51 := by norm_num

/-- If `0 ≤ 𝔐 ≤ 4.79·10¹²` and `λ ≥ 5.48·10⁻²⁰`, then `1 + 500 κ_lead ≤ 2.8·10⁵⁵`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem tb3_numeric {M lam : ℝ} (hM0 : 0 ≤ M) (hM : M ≤ 479 * 10 ^ 10)
    (hlam : 548 / 10 ^ 22 ≤ lam) : 1 + 1000 / 2 * kappaLead M lam ≤ 28 * 10 ^ 54 := by
  have := kappaLead3_le hM0 hM hlam
  linarith

end TreeGauge

/-! ## The block gap at side 3: arithmetic and the centre comb -/

section BlockGap3

/-- **The block gap at side 3, assembly.** If `I ≤ 21 Q_in`, `X ≤ 3 Q_f + 11 I`, `Q_f ≥ 0` and `Q_in
+ Q_f ≤ Q`, then `I + X ≤ 252 Q`. In the intended reading `I` and `X` are the inside and
crossing parts of `Σ_e φ_e²`, 21 the load of the inside chains, and `Q_in`, `Q_f` the inside and
face parts of `Q`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem bg3_assembly {I X Qin Qf Q : ℝ} (hI : I ≤ 21 * Qin) (hX : X ≤ 3 * Qf + 11 * I)
    (hQf : 0 ≤ Qf) (hQ : Qin + Qf ≤ Q) : I + X ≤ 252 * Q := by
  nlinarith

/-- **The mean term of the block gap at side 3.** For weights `w ≥ 0` on a finite set with `Σ w ≤
162`: `27 ((1/81) Σ w φ)² ≤ (2/3) Σ w φ²`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem bg3_mean {ι : Type*} (s : Finset ι) (w φ : ι → ℝ) (hw : ∀ i ∈ s, 0 ≤ w i)
    (hW : ∑ i ∈ s, w i ≤ 162) :
    27 * ((1 / 81) * ∑ i ∈ s, w i * φ i) ^ 2 ≤ 2 / 3 * ∑ i ∈ s, w i * φ i ^ 2 := by
  have hcs : (∑ i ∈ s, w i * φ i) ^ 2 ≤ (∑ i ∈ s, w i) * ∑ i ∈ s, w i * φ i ^ 2 :=
    Finset.sum_sq_le_sum_mul_sum_of_sq_le_mul _ hw
      (fun i hi => mul_nonneg (hw i hi) (sq_nonneg _))
      (fun i hi => le_of_eq (by ring))
  have h0 : 0 ≤ ∑ i ∈ s, w i * φ i ^ 2 := Finset.sum_nonneg fun i hi => mul_nonneg (hw i hi) (sq_nonneg _)
  have := mul_le_mul_of_nonneg_right hW h0
  nlinarith

/-- `252/9 = 28`.

