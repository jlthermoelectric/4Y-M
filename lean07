/-! ## Abstract tools: the Brezzi a priori bound -/

section Brezzi

variable {V W : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V]
  [NormedAddCommGroup W] [InnerProductSpace ℝ W]

/-- **Brezzi a priori bound.** Let `V`, `W` be real inner-product spaces, `a` a bilinear form on `V`
with `|a(x, y)| ≤ ‖x‖ ‖y‖`, and `B : V → W`, `J : W → V` linear with `B (J q) = q` and `‖J q‖ ≤
C ‖q‖` (`C ≥ 0`). Suppose `α ‖x‖² ≤ a(x, x)` for `x ∈ ker B` (`α > 0`) and `|F v| ≤ F_n ‖v‖` for
a linear functional `F` and a number `F_n ≥ 0`. If `(u, p)` satisfies `a(u, v) + ⟪B v, p⟫ = F v`
for every `v` and `B u = G`, then `‖u‖ ≤ α⁻¹ F_n + (1 + α⁻¹) C ‖G‖` and `‖p‖ ≤ C (1 + α⁻¹) F_n +
C² (1 + α⁻¹) ‖G‖`. Existence of `(u, p)` is not asserted.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem brezzi_bound (a : V →ₗ[ℝ] V →ₗ[ℝ] ℝ) (B : V →ₗ[ℝ] W) (J : W →ₗ[ℝ] V) (F : V →ₗ[ℝ] ℝ)
    {α C Fn : ℝ} (hα : 0 < α) (hC : 0 ≤ C) (hFn : 0 ≤ Fn)
    (ha : ∀ x y, |a x y| ≤ ‖x‖ * ‖y‖)
    (hcoer : ∀ x, B x = 0 → α * ‖x‖ ^ 2 ≤ a x x)
    (hBJ : ∀ q, B (J q) = q) (hJ : ∀ q, ‖J q‖ ≤ C * ‖q‖)
    (hF : ∀ v, |F v| ≤ Fn * ‖v‖) (u : V) (p G : W)
    (h1 : ∀ v, a u v + ⟪B v, p⟫ = F v) (h2 : B u = G) :
    ‖u‖ ≤ α⁻¹ * Fn + (1 + α⁻¹) * C * ‖G‖ ∧
      ‖p‖ ≤ C * (1 + α⁻¹) * Fn + C ^ 2 * (1 + α⁻¹) * ‖G‖ := by
  set u₀ := u - J G with hu₀
  have hBu₀ : B u₀ = 0 := by rw [hu₀, map_sub, h2, hBJ, sub_self]
  have hJG : ‖J G‖ ≤ C * ‖G‖ := hJ G
  have hsplit : a u₀ u₀ = F u₀ - a (J G) u₀ := by
    have h := h1 u₀
    rw [hBu₀, inner_zero_left, add_zero] at h
    have e : a u₀ = a u - a (J G) := by rw [hu₀, map_sub]
    rw [e, LinearMap.sub_apply, h]
  have hup : a u₀ u₀ ≤ (Fn + C * ‖G‖) * ‖u₀‖ := by
    rw [hsplit]
    have e1 := (le_abs_self (F u₀)).trans (hF u₀)
    have e2 := (neg_abs_le (a (J G) u₀)).trans' (le_refl _)
    have e3 : |a (J G) u₀| ≤ C * ‖G‖ * ‖u₀‖ :=
      (ha _ _).trans (mul_le_mul_of_nonneg_right hJG (norm_nonneg _))
    have e4 := neg_abs_le (a (J G) u₀)
    nlinarith [e1, e3, e4]
  have hco := hcoer u₀ hBu₀
  have hu₀le : ‖u₀‖ ≤ α⁻¹ * (Fn + C * ‖G‖) := by
    rcases (norm_nonneg u₀).eq_or_lt with h0 | h0
    · rw [← h0]; positivity
    · have h3 : α * ‖u₀‖ ≤ Fn + C * ‖G‖ := by
        have := hco.trans hup
        nlinarith
      rw [le_inv_mul_iff₀ hα]
      exact h3
  have hu : ‖u‖ ≤ α⁻¹ * Fn + (1 + α⁻¹) * C * ‖G‖ := by
    have : u = u₀ + J G := by rw [hu₀, sub_add_cancel]
    calc ‖u‖ = ‖u₀ + J G‖ := by rw [← this]
      _ ≤ ‖u₀‖ + ‖J G‖ := norm_add_le _ _
      _ ≤ α⁻¹ * (Fn + C * ‖G‖) + C * ‖G‖ := add_le_add hu₀le hJG
      _ = α⁻¹ * Fn + (1 + α⁻¹) * C * ‖G‖ := by ring
  refine ⟨hu, ?_⟩
  have hp2 : ‖p‖ ^ 2 ≤ (Fn + ‖u‖) * (C * ‖p‖) := by
    have h := h1 (J p)
    rw [hBJ, real_inner_self_eq_norm_sq] at h
    have e1 := (le_abs_self (F (J p))).trans (hF (J p))
    have e2 : |a u (J p)| ≤ ‖u‖ * ‖J p‖ := ha _ _
    have e3 := neg_abs_le (a u (J p))
    have hJp := hJ p
    have hJp0 := norm_nonneg (J p)
    calc ‖p‖ ^ 2 = F (J p) - a u (J p) := by linarith
      _ ≤ Fn * ‖J p‖ + ‖u‖ * ‖J p‖ := by linarith
      _ = (Fn + ‖u‖) * ‖J p‖ := by ring
      _ ≤ (Fn + ‖u‖) * (C * ‖p‖) :=
          mul_le_mul_of_nonneg_left hJp (by positivity)
  have hp : ‖p‖ ≤ C * (Fn + ‖u‖) := by
    rcases (norm_nonneg p).eq_or_lt with h0 | h0
    · rw [← h0]; positivity
    · nlinarith
  calc ‖p‖ ≤ C * (Fn + ‖u‖) := hp
    _ ≤ C * (Fn + (α⁻¹ * Fn + (1 + α⁻¹) * C * ‖G‖)) := by gcongr
    _ = C * (1 + α⁻¹) * Fn + C ^ 2 * (1 + α⁻¹) * ‖G‖ := by ring

/-- **Row-sum bound for a symmetric nonnegative `2 × 2` majorant.** If `a, b, c ≥ 0`, `0 ≤ x ≤ a f +
b g`, `0 ≤ y ≤ b f + c g`, `a + b ≤ R` and `b + c ≤ R`, then `x² + y² ≤ R² (f² + g²)`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem two_by_two_le {a b c f g x y R : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 ≤ c)
    (hx0 : 0 ≤ x) (hy0 : 0 ≤ y)
    (hx : x ≤ a * f + b * g) (hy : y ≤ b * f + c * g) (hR1 : a + b ≤ R) (hR2 : b + c ≤ R) :
    x ^ 2 + y ^ 2 ≤ R ^ 2 * (f ^ 2 + g ^ 2) := by
  have hR : 0 ≤ R := le_trans (add_nonneg ha hb) hR1
  have cs1 : (a * f + b * g) ^ 2 ≤ (a + b) * (a * f ^ 2 + b * g ^ 2) := by
    nlinarith [mul_nonneg (mul_nonneg ha hb) (sq_nonneg (f - g))]
  have cs2 : (b * f + c * g) ^ 2 ≤ (b + c) * (b * f ^ 2 + c * g ^ 2) := by
    nlinarith [mul_nonneg (mul_nonneg hb hc) (sq_nonneg (f - g))]
  have hx2 : x ^ 2 ≤ (a * f + b * g) ^ 2 := pow_le_pow_left₀ hx0 hx 2
  have hy2 : y ^ 2 ≤ (b * f + c * g) ^ 2 := pow_le_pow_left₀ hy0 hy 2
  have t1 : (a + b) * (a * f ^ 2 + b * g ^ 2) ≤ R * (a * f ^ 2 + b * g ^ 2) :=
    mul_le_mul_of_nonneg_right hR1 (by positivity)
  have t2 : (b + c) * (b * f ^ 2 + c * g ^ 2) ≤ R * (b * f ^ 2 + c * g ^ 2) :=
    mul_le_mul_of_nonneg_right hR2 (by positivity)
  have t3 : R * ((a + b) * f ^ 2 + (b + c) * g ^ 2) ≤ R * (R * f ^ 2 + R * g ^ 2) := by
    apply mul_le_mul_of_nonneg_left _ hR
    exact add_le_add (mul_le_mul_of_nonneg_right hR1 (sq_nonneg f))
      (mul_le_mul_of_nonneg_right hR2 (sq_nonneg g))
  nlinarith [t1, t2, t3, cs1, cs2, hx2, hy2]

/-- **Brezzi bound in the product norm.** Under the hypotheses of `brezzi_bound`, with `C ≥ 1` in
place of `C ≥ 0`: `‖u‖² + ‖p‖² ≤ 𝔐² (F_n² + ‖G‖²)` with `𝔐 = (1 + α⁻¹)(C + C²)`, the larger row
sum of the Brezzi majorant.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem brezzi_euclid (a : V →ₗ[ℝ] V →ₗ[ℝ] ℝ) (B : V →ₗ[ℝ] W) (J : W →ₗ[ℝ] V) (F : V →ₗ[ℝ] ℝ)
    {α C Fn : ℝ} (hα : 0 < α) (hC : 1 ≤ C) (hFn : 0 ≤ Fn)
    (ha : ∀ x y, |a x y| ≤ ‖x‖ * ‖y‖)
    (hcoer : ∀ x, B x = 0 → α * ‖x‖ ^ 2 ≤ a x x)
    (hBJ : ∀ q, B (J q) = q) (hJ : ∀ q, ‖J q‖ ≤ C * ‖q‖)
    (hF : ∀ v, |F v| ≤ Fn * ‖v‖) (u : V) (p G : W)
    (h1 : ∀ v, a u v + ⟪B v, p⟫ = F v) (h2 : B u = G) :
    ‖u‖ ^ 2 + ‖p‖ ^ 2 ≤ ((1 + α⁻¹) * (C + C ^ 2)) ^ 2 * (Fn ^ 2 + ‖G‖ ^ 2) := by
  obtain ⟨hu, hp⟩ := brezzi_bound a B J F hα (by linarith) hFn ha hcoer hBJ hJ hF u p G h1 h2
  have hai : 0 ≤ α⁻¹ := inv_nonneg.2 hα.le
  have hC0 : 0 ≤ C := by linarith
  refine two_by_two_le (a := α⁻¹) (b := (1 + α⁻¹) * C) (c := C ^ 2 * (1 + α⁻¹)) hai
    (by positivity) (by positivity) (norm_nonneg _) (norm_nonneg _) hu ?_ ?_ ?_
  · calc ‖p‖ ≤ C * (1 + α⁻¹) * Fn + C ^ 2 * (1 + α⁻¹) * ‖G‖ := hp
      _ = (1 + α⁻¹) * C * Fn + C ^ 2 * (1 + α⁻¹) * ‖G‖ := by ring
  · have hC2 : 1 ≤ C ^ 2 := by nlinarith
    nlinarith [mul_le_mul_of_nonneg_left hC2 (by positivity : (0 : ℝ) ≤ 1 + α⁻¹)]
  · nlinarith

end Brezzi

/-! ## Abstract tools: perturbation bounds -/

section Perturbation

/-- **A priori bound under a small perturbation.** In seminormed groups, if `‖x‖ ≤ 𝔐 ‖y‖` with `𝔐 ≥
0`, `‖y' − y‖ ≤ ε ‖x‖` and `𝔐 ε ≤ 1/2`, then `‖x‖ ≤ 2 𝔐 ‖y'‖`. It is used with `y = K x` and `y'
= K' x` for an operator `K` with an a priori bound and a perturbation `K'` of relative size `ε`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem perturbed_apriori {X Y : Type*} [SeminormedAddCommGroup X] [SeminormedAddCommGroup Y]
    {M ε : ℝ} (hM : 0 ≤ M) (hε : M * ε ≤ 1 / 2) (x : X) (y y' : Y)
    (hK : ‖x‖ ≤ M * ‖y‖) (hpert : ‖y' - y‖ ≤ ε * ‖x‖) : ‖x‖ ≤ 2 * M * ‖y'‖ := by
  have hy : ‖y‖ ≤ ‖y'‖ + ‖y' - y‖ := by
    have := norm_sub_le y' (y' - y)
    rwa [sub_sub_cancel] at this
  have h1 : ‖x‖ ≤ M * ‖y'‖ + M * ε * ‖x‖ := by
    calc ‖x‖ ≤ M * ‖y‖ := hK
      _ ≤ M * (‖y'‖ + ε * ‖x‖) := mul_le_mul_of_nonneg_left (hy.trans (by linarith)) hM
      _ = M * ‖y'‖ + M * ε * ‖x‖ := by ring
  have h2 : M * ε * ‖x‖ ≤ 1 / 2 * ‖x‖ := mul_le_mul_of_nonneg_right hε (norm_nonneg _)
  linarith

/-- **Perturbation of a sandwiched operator.** For continuous linear maps `ι, δι : F → E`, `β, δβ :
E → F` and `X, Y : F → F` between real normed spaces, `‖(ι + δι) X (β + δβ) − ι Y β‖ ≤ ‖ι‖ ‖β‖
‖X − Y‖ + ‖X‖ (‖δι‖ ‖β‖ + ‖ι‖ ‖δβ‖ + ‖δι‖ ‖δβ‖)`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem sandwich_perturb {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F]
    (ι δι : F →L[ℝ] E) (β δβ : E →L[ℝ] F) (X Y : F →L[ℝ] F) :
    ‖(ι + δι).comp (X.comp (β + δβ)) - ι.comp (Y.comp β)‖ ≤
      ‖ι‖ * ‖β‖ * ‖X - Y‖ + ‖X‖ * (‖δι‖ * ‖β‖ + ‖ι‖ * ‖δβ‖ + ‖δι‖ * ‖δβ‖) := by
  have hid : (ι + δι).comp (X.comp (β + δβ)) - ι.comp (Y.comp β) =
      ι.comp ((X - Y).comp β) + δι.comp (X.comp β) + ι.comp (X.comp δβ) +
        δι.comp (X.comp δβ) := by
    ext v
    simp only [_root_.sub_apply, _root_.add_apply,
      ContinuousLinearMap.comp_apply, map_add, map_sub]
    abel
  rw [hid]
  have n1 : ‖ι.comp ((X - Y).comp β)‖ ≤ ‖ι‖ * ‖β‖ * ‖X - Y‖ := by
    calc ‖ι.comp ((X - Y).comp β)‖ ≤ ‖ι‖ * ‖(X - Y).comp β‖ := ContinuousLinearMap.opNorm_comp_le _ _
      _ ≤ ‖ι‖ * (‖X - Y‖ * ‖β‖) :=
          mul_le_mul_of_nonneg_left (ContinuousLinearMap.opNorm_comp_le _ _) (norm_nonneg _)
      _ = ‖ι‖ * ‖β‖ * ‖X - Y‖ := by ring
  have n2 : ‖δι.comp (X.comp β)‖ ≤ ‖X‖ * (‖δι‖ * ‖β‖) := by
    calc ‖δι.comp (X.comp β)‖ ≤ ‖δι‖ * ‖X.comp β‖ := ContinuousLinearMap.opNorm_comp_le _ _
      _ ≤ ‖δι‖ * (‖X‖ * ‖β‖) :=
          mul_le_mul_of_nonneg_left (ContinuousLinearMap.opNorm_comp_le _ _) (norm_nonneg _)
      _ = ‖X‖ * (‖δι‖ * ‖β‖) := by ring
  have n3 : ‖ι.comp (X.comp δβ)‖ ≤ ‖X‖ * (‖ι‖ * ‖δβ‖) := by
    calc ‖ι.comp (X.comp δβ)‖ ≤ ‖ι‖ * ‖X.comp δβ‖ := ContinuousLinearMap.opNorm_comp_le _ _
      _ ≤ ‖ι‖ * (‖X‖ * ‖δβ‖) :=
          mul_le_mul_of_nonneg_left (ContinuousLinearMap.opNorm_comp_le _ _) (norm_nonneg _)
      _ = ‖X‖ * (‖ι‖ * ‖δβ‖) := by ring
  have n4 : ‖δι.comp (X.comp δβ)‖ ≤ ‖X‖ * (‖δι‖ * ‖δβ‖) := by
    calc ‖δι.comp (X.comp δβ)‖ ≤ ‖δι‖ * ‖X.comp δβ‖ := ContinuousLinearMap.opNorm_comp_le _ _
      _ ≤ ‖δι‖ * (‖X‖ * ‖δβ‖) :=
          mul_le_mul_of_nonneg_left (ContinuousLinearMap.opNorm_comp_le _ _) (norm_nonneg _)
      _ = ‖X‖ * (‖δι‖ * ‖δβ‖) := by ring
  calc ‖ι.comp ((X - Y).comp β) + δι.comp (X.comp β) + ι.comp (X.comp δβ) +
        δι.comp (X.comp δβ)‖
      ≤ ‖ι.comp ((X - Y).comp β)‖ + ‖δι.comp (X.comp β)‖ + ‖ι.comp (X.comp δβ)‖ +
          ‖δι.comp (X.comp δβ)‖ := norm_add₄_le
    _ ≤ ‖ι‖ * ‖β‖ * ‖X - Y‖ + ‖X‖ * (‖δι‖ * ‖β‖) + ‖X‖ * (‖ι‖ * ‖δβ‖) +
          ‖X‖ * (‖δι‖ * ‖δβ‖) := by gcongr
    _ = ‖ι‖ * ‖β‖ * ‖X - Y‖ + ‖X‖ * (‖δι‖ * ‖β‖ + ‖ι‖ * ‖δβ‖ + ‖δι‖ * ‖δβ‖) := by ring

/-- **Perturbation of a sandwiched operator, relative form.** If in addition `‖ι‖ ‖β‖ ≤ 1`, `‖δι‖ ≤
ε ‖ι‖` and `‖δβ‖ ≤ ε ‖β‖` with `ε ≥ 0`, then `‖(ι + δι) X (β + δβ) − ι Y β‖ ≤ ‖X − Y‖ + ((1 +
ε)² − 1) ‖X‖`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem sandwich_perturb_rel {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F]
    (ι δι : F →L[ℝ] E) (β δβ : E →L[ℝ] F) (X Y : F →L[ℝ] F) {ε : ℝ} (hε : 0 ≤ ε)
    (hιβ : ‖ι‖ * ‖β‖ ≤ 1) (hδι : ‖δι‖ ≤ ε * ‖ι‖) (hδβ : ‖δβ‖ ≤ ε * ‖β‖) :
    ‖(ι + δι).comp (X.comp (β + δβ)) - ι.comp (Y.comp β)‖ ≤
      ‖X - Y‖ + ((1 + ε) ^ 2 - 1) * ‖X‖ := by
  refine (sandwich_perturb ι δι β δβ X Y).trans ?_
  have hιβ0 : 0 ≤ ‖ι‖ * ‖β‖ := by positivity
  have h1 : ‖ι‖ * ‖β‖ * ‖X - Y‖ ≤ ‖X - Y‖ := by
    have := mul_le_mul_of_nonneg_right hιβ (norm_nonneg (X - Y)); linarith
  have h2 : ‖δι‖ * ‖β‖ + ‖ι‖ * ‖δβ‖ + ‖δι‖ * ‖δβ‖ ≤ (1 + ε) ^ 2 - 1 := by
    have a1 : ‖δι‖ * ‖β‖ ≤ ε * (‖ι‖ * ‖β‖) := by
      have := mul_le_mul_of_nonneg_right hδι (norm_nonneg β); linarith
    have a2 : ‖ι‖ * ‖δβ‖ ≤ ε * (‖ι‖ * ‖β‖) := by
      have := mul_le_mul_of_nonneg_left hδβ (norm_nonneg ι); linarith
    have a3 : ‖δι‖ * ‖δβ‖ ≤ ε ^ 2 * (‖ι‖ * ‖β‖) := by
      have := mul_le_mul hδι hδβ (norm_nonneg _) (by positivity); nlinarith
    have b1 : ε * (‖ι‖ * ‖β‖) ≤ ε := by nlinarith
    have b2 : ε ^ 2 * (‖ι‖ * ‖β‖) ≤ ε ^ 2 := by nlinarith [sq_nonneg ε]
    nlinarith
  have h3 := mul_le_mul_of_nonneg_left h2 (norm_nonneg X)
  linarith

end Perturbation

/-! ## Abstract tools: the Schur test -/

section Schur

variable {m n : Type*} [Fintype m] [Fintype n]

/-- **Schur test.** For a real matrix `W` whose rows of `|W|` sum to at most `R ≥ 0` and whose
columns of `|W|` sum to at most `C`: `Σ_i ((W v)_i)² ≤ R C Σ_j v_j²`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem schur_sq_le (W : Matrix m n ℝ) (v : n → ℝ) {R C : ℝ} (hR0 : 0 ≤ R)
    (hR : ∀ i, ∑ j, |W i j| ≤ R) (hC : ∀ j, ∑ i, |W i j| ≤ C) :
    ∑ i, (W *ᵥ v) i ^ 2 ≤ R * C * ∑ j, v j ^ 2 := by
  have hpt : ∀ i, (W *ᵥ v) i ^ 2 ≤ R * ∑ j, |W i j| * v j ^ 2 := by
    intro i
    have h1 : |(W *ᵥ v) i| ≤ ∑ j, |W i j| * |v j| := by
      simp only [Matrix.mulVec, dotProduct]
      refine (Finset.abs_sum_le_sum_abs _ _).trans (le_of_eq ?_)
      exact Finset.sum_congr rfl fun j _ => abs_mul _ _
    have h2 : (∑ j, |W i j| * |v j|) ^ 2 ≤ (∑ j, |W i j|) * ∑ j, |W i j| * v j ^ 2 :=
      Finset.sum_sq_le_sum_mul_sum_of_sq_le_mul _ (fun j _ => abs_nonneg _)
        (fun j _ => mul_nonneg (abs_nonneg _) (sq_nonneg _))
        (fun j _ => le_of_eq (by rw [mul_pow, sq_abs (v j)]; ring))
    have h3 : 0 ≤ ∑ j, |W i j| * v j ^ 2 :=
      Finset.sum_nonneg fun j _ => mul_nonneg (abs_nonneg _) (sq_nonneg _)
    calc (W *ᵥ v) i ^ 2 = |(W *ᵥ v) i| ^ 2 := (sq_abs _).symm
      _ ≤ (∑ j, |W i j| * |v j|) ^ 2 := pow_le_pow_left₀ (abs_nonneg _) h1 2
      _ ≤ (∑ j, |W i j|) * ∑ j, |W i j| * v j ^ 2 := h2
      _ ≤ R * ∑ j, |W i j| * v j ^ 2 := mul_le_mul_of_nonneg_right (hR i) h3
  have hdouble : ∑ i, ∑ j, |W i j| * v j ^ 2 ≤ C * ∑ j, v j ^ 2 := by
    rw [Finset.sum_comm, Finset.mul_sum]
    refine Finset.sum_le_sum fun j _ => ?_
    rw [← Finset.sum_mul]
    exact mul_le_mul_of_nonneg_right (hC j) (sq_nonneg _)
  calc ∑ i, (W *ᵥ v) i ^ 2 ≤ ∑ i, R * ∑ j, |W i j| * v j ^ 2 := Finset.sum_le_sum fun i _ => hpt i
    _ = R * ∑ i, ∑ j, |W i j| * v j ^ 2 := by rw [Finset.mul_sum]
    _ ≤ R * (C * ∑ j, v j ^ 2) := mul_le_mul_of_nonneg_left hdouble hR0
    _ = R * C * ∑ j, v j ^ 2 := by ring

/-- **Schur test with an entrywise majorant.** If `|W_ij| ≤ ε A_ij` with `ε ≥ 0`, the rows of `A`
sum to at most `R ≥ 0` and its columns to at most `C`, then `Σ_i ((W v)_i)² ≤ ε² R C Σ_j v_j²`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem schur_majorant (W A : Matrix m n ℝ) (v : n → ℝ) {ε R C : ℝ} (hε : 0 ≤ ε) (hR0 : 0 ≤ R)
    (hW : ∀ i j, |W i j| ≤ ε * A i j) (hR : ∀ i, ∑ j, A i j ≤ R) (hC : ∀ j, ∑ i, A i j ≤ C) :
    ∑ i, (W *ᵥ v) i ^ 2 ≤ ε ^ 2 * (R * C) * ∑ j, v j ^ 2 := by
  have hR' : ∀ i, ∑ j, |W i j| ≤ ε * R := fun i => by
    calc ∑ j, |W i j| ≤ ∑ j, ε * A i j := Finset.sum_le_sum fun j _ => hW i j
      _ = ε * ∑ j, A i j := by rw [Finset.mul_sum]
      _ ≤ ε * R := mul_le_mul_of_nonneg_left (hR i) hε
  have hC' : ∀ j, ∑ i, |W i j| ≤ ε * C := fun j => by
    calc ∑ i, |W i j| ≤ ∑ i, ε * A i j := Finset.sum_le_sum fun i _ => hW i j
      _ = ε * ∑ i, A i j := by rw [Finset.mul_sum]
      _ ≤ ε * C := mul_le_mul_of_nonneg_left (hC j) hε
  have := schur_sq_le W v (mul_nonneg hε hR0) hR' hC'
  calc ∑ i, (W *ᵥ v) i ^ 2 ≤ ε * R * (ε * C) * ∑ j, v j ^ 2 := this
    _ = ε ^ 2 * (R * C) * ∑ j, v j ^ 2 := by ring

end Schur

/-! ## Elementary bounds for the exponential -/

section ExpBounds

/-- `e^x ≤ 1 + x + x²` for `0 ≤ x ≤ 1`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem exp_le_quad {x : ℝ} (h0 : 0 ≤ x) (h1 : x ≤ 1) : Real.exp x ≤ 1 + x + x ^ 2 := by
  have h := Real.abs_exp_sub_one_sub_id_le (x := x) (by rw [abs_of_nonneg h0]; exact h1)
  have := le_abs_self (Real.exp x - 1 - x)
  linarith

/-- `e^x − 1 ≤ x e^x` for every real `x`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem exp_sub_one_le_mul_exp (x : ℝ) : Real.exp x - 1 ≤ x * Real.exp x := by
  have h1 := Real.add_one_le_exp (-x)
  have h2 : Real.exp (-x) * Real.exp x = 1 := by rw [← Real.exp_add, neg_add_cancel, Real.exp_zero]
  have h3 := Real.exp_pos x
  nlinarith [mul_le_mul_of_nonneg_right h1 h3.le]

/-- `e^{1/12} ≤ 157/144`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem exp_twelfth_le : Real.exp (1 / 12) ≤ 157 / 144 := by
  have := exp_le_quad (x := 1 / 12) (by norm_num) (by norm_num); norm_num at this ⊢; linarith

/-- `e^{1/8} ≤ 73/64`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem exp_eighth_le : Real.exp (1 / 8) ≤ 73 / 64 := by
  have := exp_le_quad (x := 1 / 8) (by norm_num) (by norm_num); norm_num at this ⊢; linarith

end ExpBounds

/-! ## The scalar lift at odd block side -/

section Lift

/-- `65536/12⁴ + 262144/1728 = (112/9)²`: the bound `C_s ≤ 112/9` on the lift constant of the
scalar saddle problem, the same for every odd block side `M`. It is a bound, not the value of the lift
norm, which is smaller and increases towards `112/9` as `M` grows.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem lift_const_sq : (65536 : ℝ) / 12 ^ 4 + 262144 / 1728 = (112 / 9) ^ 2 := by norm_num

/-- **The scalar lift, `ℓ²` part.** For `M > 0`: `(256 M³/(M² + 1)⁴)² ((M³ + 2M)/12)⁴ ≤ (65536/12⁴)
M²`. In the intended reading `256 M³/(M² + 1)⁴` normalises the product of tents on a block of
odd side `M` and `(M³ + 2M)/12` is the sum of the squared tent values on one side; this reading
is not formalised.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem lift_l2_le {M : ℝ} (hM : 0 < M) :
    (256 * M ^ 3 / (M ^ 2 + 1) ^ 4) ^ 2 * ((M ^ 3 + 2 * M) / 12) ^ 4 ≤ 65536 / 12 ^ 4 * M ^ 2 := by
  have hb : M ^ 2 * (M ^ 2 + 2) ≤ (M ^ 2 + 1) ^ 2 := by nlinarith
  have h0 : 0 ≤ M ^ 2 * (M ^ 2 + 2) := by positivity
  have h4 : (M ^ 2 * (M ^ 2 + 2)) ^ 4 ≤ ((M ^ 2 + 1) ^ 2) ^ 4 := pow_le_pow_left₀ h0 hb 4
  have hD : 0 < (M ^ 2 + 1) ^ 8 := by positivity
  have hl : (256 * M ^ 3 / (M ^ 2 + 1) ^ 4) ^ 2 * ((M ^ 3 + 2 * M) / 12) ^ 4 =
      65536 / 12 ^ 4 * M ^ 2 * ((M ^ 2 * (M ^ 2 + 2)) ^ 4 / (M ^ 2 + 1) ^ 8) := by
    field_simp; ring
  rw [hl]
  have hq : (M ^ 2 * (M ^ 2 + 2)) ^ 4 / (M ^ 2 + 1) ^ 8 ≤ 1 := by
    rw [div_le_one hD]; calc (M ^ 2 * (M ^ 2 + 2)) ^ 4 ≤ ((M ^ 2 + 1) ^ 2) ^ 4 := h4
      _ = (M ^ 2 + 1) ^ 8 := by ring
  have hc : 0 ≤ 65536 / 12 ^ 4 * M ^ 2 := by positivity
  calc 65536 / 12 ^ 4 * M ^ 2 * ((M ^ 2 * (M ^ 2 + 2)) ^ 4 / (M ^ 2 + 1) ^ 8)
      ≤ 65536 / 12 ^ 4 * M ^ 2 * 1 := mul_le_mul_of_nonneg_left hq hc
    _ = 65536 / 12 ^ 4 * M ^ 2 := by ring

/-- **The scalar lift, energy part.** For `M > 0`: `4 M (256 M³/(M² + 1)⁴)² ((M³ + 2M)/12)³ ≤
262144/1728`; equivalently `M¹⁰ (M² + 2)³ ≤ (M² + 1)⁸`. In the intended reading the factor `M`
is the sum over one side of a block of odd side `M` of the squared tent differences, the two
boundary half-steps counted twice.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem lift_energy_le {M : ℝ} (hM : 0 < M) :
    4 * M * (256 * M ^ 3 / (M ^ 2 + 1) ^ 4) ^ 2 * ((M ^ 3 + 2 * M) / 12) ^ 3 ≤ 262144 / 1728 := by
  have hu : 0 ≤ M ^ 2 := sq_nonneg M
  have key : M ^ 10 * (M ^ 2 + 2) ^ 3 ≤ (M ^ 2 + 1) ^ 8 := by
    have e : (M ^ 2 + 1) ^ 8 - M ^ 10 * (M ^ 2 + 2) ^ 3 =
        2 * (M ^ 2) ^ 7 + 16 * (M ^ 2) ^ 6 + 48 * (M ^ 2) ^ 5 + 70 * (M ^ 2) ^ 4 +
          56 * (M ^ 2) ^ 3 + 28 * (M ^ 2) ^ 2 + 8 * M ^ 2 + 1 := by ring
    have : 0 ≤ 2 * (M ^ 2) ^ 7 + 16 * (M ^ 2) ^ 6 + 48 * (M ^ 2) ^ 5 + 70 * (M ^ 2) ^ 4 +
          56 * (M ^ 2) ^ 3 + 28 * (M ^ 2) ^ 2 + 8 * M ^ 2 + 1 := by positivity
    linarith
  have hD : 0 < (M ^ 2 + 1) ^ 8 := by positivity
  have hl : 4 * M * (256 * M ^ 3 / (M ^ 2 + 1) ^ 4) ^ 2 * ((M ^ 3 + 2 * M) / 12) ^ 3 =
      262144 / 1728 * (M ^ 10 * (M ^ 2 + 2) ^ 3 / (M ^ 2 + 1) ^ 8) := by
    field_simp; ring
  rw [hl]
  have hq : M ^ 10 * (M ^ 2 + 2) ^ 3 / (M ^ 2 + 1) ^ 8 ≤ 1 := by rw [div_le_one hD]; exact key
  calc 262144 / 1728 * (M ^ 10 * (M ^ 2 + 2) ^ 3 / (M ^ 2 + 1) ^ 8) ≤ 262144 / 1728 * 1 :=
        mul_le_mul_of_nonneg_left hq (by norm_num)
    _ = 262144 / 1728 := by ring

/-- **The scalar lift has unit block means.** For `M > 0`: `M⁻³ · (256 M³/(M² + 1)⁴) · ((M² + 1)/4)⁴
= 1`, where `(M² + 1)/4` is, in the intended reading, the sum of the tent values on one side of
a block of odd side `M`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem lift_mean (M : ℝ) (hM : 0 < M) :
    M⁻¹ ^ 3 * (256 * M ^ 3 / (M ^ 2 + 1) ^ 4) * ((M ^ 2 + 1) / 4) ^ 4 = 1 := by
  field_simp; ring

end Lift

/-! ## Lemma W at block ratio 3: the constants -/

section LemmaW

/-- The Brezzi constant of the scalar saddle problem at block ratio 3: `𝔐_s = (1 + 5/4)(C_s + C_s²)`
with the lift bound `C_s = 112/9` and coercivity constant `4/5`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
def scalarBrezzi : ℝ := (1 + 5 / 4) * (112 / 9 + (112 / 9) ^ 2)

/-- `𝔐_s = 3388/9`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem scalarBrezzi_eq : scalarBrezzi = 3388 / 9 := by unfold scalarBrezzi; norm_num

/-- The first row sum `5/4 + (1 + 5/4) C_s` of the scalar Brezzi majorant is at most `𝔐_s`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem scalarBrezzi_rows : (5 : ℝ) / 4 + (1 + 5 / 4) * (112 / 9) ≤ scalarBrezzi := by
  rw [scalarBrezzi_eq]; norm_num

/-- **Coercivity constant `4/5`.** If `M > 0` and `a ≤ M²/4`, then `1 + a/M² ≤ 5/4`. In the intended
reading `a = ‖H‖²/‖d₁H‖²` for `H` with zero block means, bounded by the block Poincaré
inequality `4 sin²(π/2M) ≥ 4/M²`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem block_poincare_coercive {M a : ℝ} (hM : 0 < M) (hpo : a ≤ M ^ 2 / 4 * 1) :
    1 + a / M ^ 2 ≤ 5 / 4 := by
  have : a / M ^ 2 ≤ 1 / 4 := by
    rw [div_le_iff₀ (by positivity)]; linarith
  linarith

/-- **Conjugation rate of the scalar saddle problem.** For `0 ≤ λ ≤ 1/4` and `M ≥ 3`: `4 λ e^{λ/M}
(1 + λ e^{λ/M}) + λ e^{λ/2} ≤ (67/10) λ`. In the intended reading the first term bounds the
change of the gradient form under conjugation by a weight of rate `λ/M` per site (one shifted
entry per row and four per column, converted with `‖H‖ ≤ M ‖H‖_s`), and `λ e^{λ/2}` the change
of the two block-mean blocks (the weight at a block centre and at a site of that block differ by
less than `λ/2`).

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem scalar_rate_le {lam M : ℝ} (hlam : 0 ≤ lam) (hlam4 : lam ≤ 1 / 4) (hM : 3 ≤ M) :
    4 * lam * Real.exp (lam / M) * (1 + lam * Real.exp (lam / M)) + lam * Real.exp (lam / 2) ≤
      67 / 10 * lam := by
  have hM0 : 0 < M := by linarith
  have hx : lam / M ≤ 1 / 12 := by
    rw [div_le_iff₀ hM0]; nlinarith
  have hE1 : Real.exp (lam / M) ≤ 157 / 144 :=
    (Real.exp_le_exp.2 hx).trans exp_twelfth_le
  have hE2 : Real.exp (lam / 2) ≤ 73 / 64 :=
    (Real.exp_le_exp.2 (by linarith)).trans exp_eighth_le
  have hE1p := Real.exp_pos (lam / M)
  have hE2p := Real.exp_pos (lam / 2)
  have h4 : 4 * lam ≤ 1 := by linarith
  have hsq : Real.exp (lam / M) ^ 2 ≤ (157 / 144) ^ 2 := pow_le_pow_left₀ hE1p.le hE1 2
  have hbig : 4 * Real.exp (lam / M) * (1 + lam * Real.exp (lam / M)) + Real.exp (lam / 2) ≤ 67 / 10 := by
    have : 4 * Real.exp (lam / M) * (lam * Real.exp (lam / M)) ≤ Real.exp (lam / M) ^ 2 := by
      nlinarith [sq_nonneg (Real.exp (lam / M))]
    nlinarith
  nlinarith [mul_le_mul_of_nonneg_left hbig hlam]

/-- The rate `λ_W = 1/(2 𝔐_s · 67/10)` up to which Lemma W at block ratio 3 is stated.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
def lamW : ℝ := 1 / (2 * scalarBrezzi * (67 / 10))

/-- `λ_W = 45/226996` (about `1.98·10⁻⁴`).

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem lamW_eq : lamW = 45 / 226996 := by unfold lamW; rw [scalarBrezzi_eq]; norm_num

/-- `𝔐_s · (67/10) · λ_W = 1/2`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem lamW_small : scalarBrezzi * (67 / 10) * lamW = 1 / 2 := by
  rw [lamW_eq, scalarBrezzi_eq]; norm_num

/-- **Lemma W, the scalar step.** Let `λ, E, 𝔐_s, c ≥ 0` with `𝔐_s c λ ≤ 1/2`. Suppose `X ≤ 𝔐_s (b +
2 λ E b) + 𝔐_s c λ X` (an a priori bound for the conjugated solution), `D ≤ 𝔐_s (2 λ E b + c λ
X)` (its distance from the unconjugated solution), `H_s ≤ X`, `D_s ≤ D`, `H_s ≥ 0` and `P_d ≤
D_s + 2 λ E H_s`. Then `P_d ≤ λ (2 𝔐_s E + (1 + 2 λ E)(2 𝔐_s² c + 4 𝔐_s E)) b`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem lemmaW_scalar_step {lam E Ms c b X D Hs Ds Pd : ℝ} (hlam : 0 ≤ lam) (hE : 0 ≤ E)
    (hMs : 0 ≤ Ms) (hc : 0 ≤ c) (hsmall : Ms * c * lam ≤ 1 / 2)
    (hX : X ≤ Ms * (b + 2 * lam * E * b) + Ms * c * lam * X)
    (hD : D ≤ Ms * (2 * lam * E * b + c * lam * X))
    (hHs : Hs ≤ X) (hDs : Ds ≤ D) (hHs0 : 0 ≤ Hs)
    (hP : Pd ≤ Ds + 2 * lam * E * Hs) :
    Pd ≤ lam * (2 * Ms * E + (1 + 2 * lam * E) * (2 * Ms ^ 2 * c + 4 * Ms * E)) * b := by
  have hX0 : 0 ≤ X := hHs0.trans hHs
  have hXb : X ≤ 2 * Ms * (1 + 2 * lam * E) * b := by
    have h1 : Ms * c * lam * X ≤ 1 / 2 * X := mul_le_mul_of_nonneg_right hsmall hX0
    nlinarith
  have hD' : D ≤ Ms * (2 * lam * E * b + c * lam * (2 * Ms * (1 + 2 * lam * E) * b)) := by
    have : c * lam * X ≤ c * lam * (2 * Ms * (1 + 2 * lam * E) * b) :=
      mul_le_mul_of_nonneg_left hXb (mul_nonneg hc hlam)
    nlinarith
  have hH' : 2 * lam * E * Hs ≤ 2 * lam * E * (2 * Ms * (1 + 2 * lam * E) * b) :=
    mul_le_mul_of_nonneg_left (hHs.trans hXb) (by positivity)
  nlinarith

/-- **Lemma W, the reduction to the coarser lattice.** Let `λ, c_{W1}, ε ≥ 0` with `ε ≤ e^{λ/9} −
1`, and let `d ≤ c_{W1} λ`, `x_n ≤ 1 + d` and `t ≤ d + ((1 + ε)² − 1) x_n`. Then `t ≤ c_{W1} λ +
(2λ/9) e^{2λ/9} (1 + c_{W1} λ)`. In the intended reading `t` is the norm of the conjugated fine
projection minus the projection, `d` the same for the projection on the coarser lattice, and
`x_n` the norm of its conjugate, combined by `sandwich_perturb_rel`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem lemmaW_final {lam cW1 ε d xn t : ℝ} (hlam : 0 ≤ lam) (hc : 0 ≤ cW1) (hε0 : 0 ≤ ε)
    (hε : ε ≤ Real.exp (lam / 9) - 1) (hd : d ≤ cW1 * lam) (hxn : xn ≤ 1 + d)
    (hT : t ≤ d + ((1 + ε) ^ 2 - 1) * xn) :
    t ≤ cW1 * lam + 2 * lam / 9 * Real.exp (2 * lam / 9) * (1 + cW1 * lam) := by
  have h1 : (1 + ε) ^ 2 ≤ Real.exp (2 * lam / 9) := by
    have h0 : 0 ≤ 1 + ε := by linarith
    have : (1 + ε) ^ 2 ≤ Real.exp (lam / 9) ^ 2 := pow_le_pow_left₀ h0 (by linarith) 2
    rw [← Real.exp_nat_mul] at this
    convert this using 2; push_cast; ring
  have h2 : Real.exp (2 * lam / 9) - 1 ≤ 2 * lam / 9 * Real.exp (2 * lam / 9) :=
    exp_sub_one_le_mul_exp _
  have h3 : 0 ≤ (1 + ε) ^ 2 - 1 := by nlinarith
  have h4 : ((1 + ε) ^ 2 - 1) * xn ≤ 2 * lam / 9 * Real.exp (2 * lam / 9) * (1 + cW1 * lam) := by
    calc ((1 + ε) ^ 2 - 1) * xn ≤ ((1 + ε) ^ 2 - 1) * (1 + cW1 * lam) :=
          mul_le_mul_of_nonneg_left (hxn.trans (by linarith)) h3
      _ ≤ 2 * lam / 9 * Real.exp (2 * lam / 9) * (1 + cW1 * lam) :=
          mul_le_mul_of_nonneg_right (by linarith) (by positivity)
  linarith

/-- The first-order constant of Lemma W at block ratio 3, as a function of the rate: `c_{W1}(λ) = 2
𝔐_s e^{1/12} + (1 + 2 λ e^{1/12})(2 𝔐_s² · 67/10 + 4 𝔐_s e^{1/12})`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
def cW1 (lam : ℝ) : ℝ :=
  2 * scalarBrezzi * Real.exp (1 / 12) +
    (1 + 2 * lam * Real.exp (1 / 12)) * (2 * scalarBrezzi ^ 2 * (67 / 10) +
      4 * scalarBrezzi * Real.exp (1 / 12))

/-- The constant of Lemma W at block ratio 3, as a function of the rate: `c_W(λ) = c_{W1}(λ) + (2/9)
e^{2λ/9} (1 + c_{W1}(λ) λ)`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
def cW (lam : ℝ) : ℝ := cW1 lam + 2 / 9 * Real.exp (2 * lam / 9) * (1 + cW1 lam * lam)

/-- `c_{W1}(λ) ≤ 1902300` for `λ ≤ λ_W`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem cW1_le {lam : ℝ} (h1 : lam ≤ lamW) : cW1 lam ≤ 1902300 := by
  unfold cW1
  rw [scalarBrezzi_eq]
  rw [lamW_eq] at h1
  have hE := exp_twelfth_le
  have hEp := (Real.exp_pos (1 / 12)).le
  have hl : 2 * lam * Real.exp (1 / 12) ≤ 2 * (45 / 226996) * (157 / 144) := by
    have := mul_le_mul h1 hE hEp (by norm_num); nlinarith
  have hA : 2 * (3388 / 9 : ℝ) ^ 2 * (67 / 10) + 4 * (3388 / 9) * Real.exp (1 / 12) ≤
      2 * (3388 / 9 : ℝ) ^ 2 * (67 / 10) + 4 * (3388 / 9) * (157 / 144) := by linarith
  have hA0 : 0 ≤ 2 * (3388 / 9 : ℝ) ^ 2 * (67 / 10) + 4 * (3388 / 9) * Real.exp (1 / 12) := by
    positivity
  have hB : (1 + 2 * lam * Real.exp (1 / 12)) * (2 * (3388 / 9 : ℝ) ^ 2 * (67 / 10) +
      4 * (3388 / 9) * Real.exp (1 / 12)) ≤ (1 + 2 * (45 / 226996) * (157 / 144)) *
      (2 * (3388 / 9 : ℝ) ^ 2 * (67 / 10) + 4 * (3388 / 9) * (157 / 144)) :=
    mul_le_mul (by linarith) hA hA0 (by norm_num)
  have hC : 2 * (3388 / 9 : ℝ) * Real.exp (1 / 12) ≤ 2 * (3388 / 9) * (157 / 144) := by linarith
  have : 2 * (3388 / 9 : ℝ) * (157 / 144) + (1 + 2 * (45 / 226996) * (157 / 144)) *
      (2 * (3388 / 9 : ℝ) ^ 2 * (67 / 10) + 4 * (3388 / 9) * (157 / 144)) ≤ 1902300 := by norm_num
  linarith

/-- `c_W(λ) ≤ 1903000` for `0 ≤ λ ≤ λ_W`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem cW_le {lam : ℝ} (h0 : 0 ≤ lam) (h1 : lam ≤ lamW) : cW lam ≤ 1903000 := by
  unfold cW
  have hc := cW1_le h1
  have hc0 : 0 ≤ cW1 lam := by
    unfold cW1
    have he := (Real.exp_pos (1 / 12)).le
    have hs : 0 ≤ scalarBrezzi := by rw [scalarBrezzi_eq]; norm_num
    have h2 : 0 ≤ 1 + 2 * lam * Real.exp (1 / 12) := by nlinarith
    exact add_nonneg (by positivity) (mul_nonneg h2 (by positivity))
  have hl : lam ≤ 45 / 226996 := by rw [← lamW_eq]; exact h1
  have he : Real.exp (2 * lam / 9) ≤ 1 + 1 / 10000 := by
    have hx : 2 * lam / 9 ≤ 1 / 20000 := by linarith
    have := exp_le_quad (x := 2 * lam / 9) (by positivity) (by linarith)
    nlinarith
  have hprod : cW1 lam * lam ≤ 1902300 * (45 / 226996) := mul_le_mul hc hl h0 (by norm_num)
  have hep := (Real.exp_pos (2 * lam / 9)).le
  have : 2 / 9 * Real.exp (2 * lam / 9) * (1 + cW1 lam * lam) ≤
      2 / 9 * (1 + 1 / 10000) * (1 + 1902300 * (45 / 226996)) := by
    apply mul_le_mul (by linarith) (by linarith) (by positivity) (by positivity)
  have : (2 / 9 : ℝ) * (1 + 1 / 10000) * (1 + 1902300 * (45 / 226996)) ≤ 700 := by norm_num
  linarith

end LemmaW

