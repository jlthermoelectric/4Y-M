/-! ## The ratio-3 chain: Lemma W, Theorem CT′, Theorem U and Lemma TB with explicit constants -/

section Chain

/-- **Lemma W at block ratio 3, with its constant.** Let `0 ≤ λ ≤ λ_W`, and write `E = e^{1/12}`,
`𝔐_s = 3388/9`, `c = 67/10`. Assume the inputs of the scalar step for a unit source, `X ≤ 𝔐_s (1
+ 2 λ E) + 𝔐_s c λ X`, `D ≤ 𝔐_s (2 λ E + c λ X)`, `H_s ≤ X`, `D_s ≤ D`, `H_s ≥ 0` and `P_d ≤ D_s
+ 2 λ E H_s`, and the inputs of the reduction, `0 ≤ ε ≤ e^{λ/9} − 1`, `x_n ≤ 1 + P_d` and `t ≤
P_d + ((1 + ε)² − 1) x_n`. Then `t ≤ c_W(λ) λ` and `t ≤ 1903000 λ`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem lemmaW3_chain {lam X D Hs Ds Pd ε xn t : ℝ} (hlam0 : 0 ≤ lam) (hlamW : lam ≤ lamW)
    (hX : X ≤ scalarBrezzi * (1 + 2 * lam * Real.exp (1 / 12) * 1) + scalarBrezzi * (67 / 10) * lam * X)
    (hD : D ≤ scalarBrezzi * (2 * lam * Real.exp (1 / 12) * 1 + 67 / 10 * lam * X))
    (hHs : Hs ≤ X) (hDs : Ds ≤ D) (hHs0 : 0 ≤ Hs)
    (hP : Pd ≤ Ds + 2 * lam * Real.exp (1 / 12) * Hs)
    (hε0 : 0 ≤ ε) (hε : ε ≤ Real.exp (lam / 9) - 1) (hxn : xn ≤ 1 + Pd)
    (hT : t ≤ Pd + ((1 + ε) ^ 2 - 1) * xn) :
    t ≤ cW lam * lam ∧ t ≤ 1903000 * lam := by
  have hMs : 0 ≤ scalarBrezzi := by rw [scalarBrezzi_eq]; norm_num
  have hsmall : scalarBrezzi * (67 / 10) * lam ≤ 1 / 2 := by
    have := lamW_small
    have h := mul_le_mul_of_nonneg_left hlamW (by positivity : (0 : ℝ) ≤ scalarBrezzi * (67 / 10))
    linarith
  have hstep := lemmaW_scalar_step (b := 1) hlam0 (Real.exp_pos _).le hMs (by norm_num) hsmall
    (by linarith) hD hHs hDs hHs0 hP
  have hPd : Pd ≤ cW1 lam * lam := by unfold cW1; linarith
  have hcW10 : 0 ≤ cW1 lam := by
    unfold cW1
    have he := (Real.exp_pos (1 / 12)).le
    have h2 : 0 ≤ 1 + 2 * lam * Real.exp (1 / 12) := by nlinarith
    exact add_nonneg (by positivity) (mul_nonneg h2 (by positivity))
  have hfin := lemmaW_final hlam0 hcW10 hε0 hε hPd hxn hT
  have hcW : t ≤ cW lam * lam := by unfold cW; nlinarith [hfin]
  exact ⟨hcW, hcW.trans (mul_le_mul_of_nonneg_right (cW_le hlam0 hlamW) hlam0)⟩

/-- The Brezzi constant of Theorem CT′ at block ratio 3 as a function of the constant `C_G` of the
Poincaré inequality for gauge-invariant fields: `𝔐(C_G) = (2 + κ_I² C_G)(C_J + C_J²)` with `C_J
= √56064`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
def brezziM3 (CG : ℝ) : ℝ := brezziM (kappaI3 ^ 2 * CG) (√56064)

/-- The decay rate of Theorem CT′ at block ratio 3: `λ₀(C_G) = min(λ_W, 1/(2 𝔐(C_G) · 1903007))`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
def lam0_3 (CG : ℝ) : ℝ := min lamW (1 / (2 * brezziM3 CG * 1903007))

/-- `𝔐(C_G) ≥ 112128` for `C_G ≥ 0`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem brezziM3_ge {CG : ℝ} (hCG0 : 0 ≤ CG) : 112128 ≤ brezziM3 CG := by
  unfold brezziM3 brezziM
  have hk : 0 ≤ kappaI3 ^ 2 * CG := mul_nonneg (sq_nonneg _) hCG0
  have hJ0 := Real.sqrt_nonneg 56064
  have hsq : √56064 ^ 2 = 56064 := Real.sq_sqrt (by norm_num)
  have : (2 : ℝ) * 56064 ≤ (2 + kappaI3 ^ 2 * CG) * (√56064 + √56064 ^ 2) := by
    rw [hsq]; nlinarith
  linarith

/-- **Theorem CT′ at block ratio 3, the constants.** If `0 ≤ C_G ≤ 56.94`, then `𝔐 ≤ 4.79·10¹²`,
`5.48·10⁻²⁰ ≤ λ₀ ≤ λ_W`, `λ₀ ≤ 10⁻⁴`, `c₁(λ₀) ≤ 1903007` and `𝔐 c₁(λ₀) λ₀ ≤ 1/2`, where `𝔐 =
𝔐(C_G)` and `λ₀ = λ₀(C_G)`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem ct3_chain {CG : ℝ} (hCG0 : 0 ≤ CG) (hCG : CG ≤ 5694 / 100) :
    brezziM3 CG ≤ 479 * 10 ^ 10 ∧ 548 / 10 ^ 22 ≤ lam0_3 CG ∧ lam0_3 CG ≤ lamW ∧
      lam0_3 CG ≤ 1 / 10000 ∧ c1CT (lam0_3 CG) ≤ 1903007 ∧
      brezziM3 CG * c1CT (lam0_3 CG) * lam0_3 CG ≤ 1 / 2 := by
  have hM := brezziM3_le (Cpp3_le hCG0 hCG)
  have hMge := brezziM3_ge hCG0
  have hMpos : 0 < brezziM3 CG := lt_of_lt_of_le (by norm_num) hMge
  have hl := lam0_ge hMpos hM (by norm_num : (0 : ℝ) < 1903007) le_rfl
  have hl0 : 0 ≤ lam0_3 CG := le_trans (by norm_num) hl
  have hlW : lam0_3 CG ≤ lamW := min_le_left _ _
  have hl2 : lam0_3 CG ≤ 1 / (2 * brezziM3 CG * 1903007) := min_le_right _ _
  have hsmall : 1 / (2 * brezziM3 CG * 1903007) ≤ 1 / 10000 := by
    rw [div_le_div_iff₀ (by positivity) (by norm_num)]; nlinarith
  have hc := c1CT_le hl0 hlW
  refine ⟨hM, hl, hlW, hl2.trans hsmall, hc, ?_⟩
  have h1 : brezziM3 CG * c1CT (lam0_3 CG) * lam0_3 CG ≤ brezziM3 CG * 1903007 * lam0_3 CG := by
    have := mul_le_mul_of_nonneg_left hc hMpos.le
    exact mul_le_mul_of_nonneg_right this hl0
  have h2 : brezziM3 CG * 1903007 * lam0_3 CG ≤ brezziM3 CG * 1903007 * (1 / (2 * brezziM3 CG * 1903007)) :=
    mul_le_mul_of_nonneg_left hl2 (by positivity)
  have h3 : brezziM3 CG * 1903007 * (1 / (2 * brezziM3 CG * 1903007)) = 1 / 2 := by
    field_simp
  linarith

/-- **Theorem CT′ at block ratio 3, the weighted bound.** Let `0 ≤ C_G ≤ 56.94`. If `‖x‖ ≤ 𝔐 ‖y‖`
(the Brezzi bound for the unweighted saddle operator) and `‖y' − y‖ ≤ c₁(λ₀) λ₀ ‖x‖` (the
conjugation estimate at rate `λ₀`), then `‖x‖ ≤ 2𝔐 ‖y'‖`, and `2𝔐 ≤ 9.58·10¹²`. In the intended
reading `x` is the weighted column with its weighted multiplier and `y'` the unchanged data `(0,
δ_w)`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem ct3_apriori {X Y : Type*} [SeminormedAddCommGroup X] [SeminormedAddCommGroup Y] {CG : ℝ}
    (hCG0 : 0 ≤ CG) (hCG : CG ≤ 5694 / 100) (x : X) (y y' : Y)
    (hK : ‖x‖ ≤ brezziM3 CG * ‖y‖) (hpert : ‖y' - y‖ ≤ c1CT (lam0_3 CG) * lam0_3 CG * ‖x‖) :
    ‖x‖ ≤ 2 * brezziM3 CG * ‖y'‖ ∧ 2 * brezziM3 CG ≤ 958 * 10 ^ 10 := by
  obtain ⟨hM, -, -, -, -, hs⟩ := ct3_chain hCG0 hCG
  have hM0 : 0 ≤ brezziM3 CG := le_trans (by norm_num) (brezziM3_ge hCG0)
  refine ⟨perturbed_apriori hM0 (by nlinarith [hs]) x y y' hK hpert, by linarith⟩

/-- **Theorem U at block ratio 3.** Let `0 ≤ C_G ≤ 56.94` and `L > 0`. If the annulus count holds at
rate `λ₀` and `Σ_e e^{2 f(e)} u_e² ≤ (2𝔐)² L²`, then `‖u‖₁/L³ ≤ 32√6 𝔐/(1 − e^{−2λ₀})² ≤
3.2·10⁵²`.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem thmU3_bound {ι : Type*} [Fintype ι] (u f : ι → ℝ) (R : ℕ) {L CG : ℝ} (hL : 0 < L)
    (hCG0 : 0 ≤ CG) (hCG : CG ≤ 5694 / 100)
    (hW : ∑ e, Real.exp (-(2 * f e)) ≤
      256 * L ^ 4 * ∑ t ∈ range R, ((t : ℝ) + 1) ^ 3 * Real.exp (-(2 * lam0_3 CG)) ^ t)
    (hE : ∑ e, Real.exp (2 * f e) * u e ^ 2 ≤ (2 * brezziM3 CG) ^ 2 * L ^ 2) :
    (∑ e, |u e|) / L ^ 3 ≤ 32 * √6 * brezziM3 CG / (1 - Real.exp (-(2 * lam0_3 CG))) ^ 2 ∧
      (∑ e, |u e|) / L ^ 3 ≤ 32 * 10 ^ 51 := by
  obtain ⟨hM, hl, -, hl4, -, -⟩ := ct3_chain hCG0 hCG
  have hl0 : 0 < lam0_3 CG := lt_of_lt_of_le (by norm_num) hl
  have hM0 : 0 ≤ brezziM3 CG := le_trans (by norm_num) (brezziM3_ge hCG0)
  have h1 := thmU_compose u f R hl0 hL hM0 hW hE
  exact ⟨h1, h1.trans (U3_numeric hM0 hM hl hl4)⟩

/-- **Lemma TB at block ratio 3.** Under the hypotheses of `tb3_loss` at `𝔐 = 𝔐(C_G)` and `λ =
λ₀(C_G)`, with `0 ≤ C_G ≤ 56.94` and `0 ≤ C ≤ 1000`: `‖φ‖₁/L³ ≤ 1 + 500 κ_lead(𝔐, λ₀) ≤
2.8·10⁵⁵`. As in `tb3_loss`, the `ℓ¹` inequality is assumed in its ratio-3 form (level sum
`(L − 1)/2`), and the curvature identity `D φ = D u` and the energy-norm bound are hypotheses.

Scope: a statement about one proof method at Gaussian order; lattice inputs enter only as
hypotheses; nothing about the Yang–Mills measure; (D), (E) and the mass gap remain open. -/
theorem tb3_bound {ρ ι γ : Type*} [Fintype ρ] [Fintype ι] [Fintype γ] (D : Matrix ρ ι ℝ)
    (A : Matrix γ ι ℝ) (φ u f : ι → ℝ) (g : ρ → ℝ) (R : ℕ) {L CG C : ℝ}
    (hL : 1 ≤ L) (hCG0 : 0 ≤ CG) (hCG : CG ≤ 5694 / 100) (hC0 : 0 ≤ C) (hC : C ≤ 1000)
    (hrow : ∀ p, ∑ e, |D p e| ≤ 4) (hcol : ∀ e, ∑ p, |D p e| ≤ 6)
    (hlip : ∀ p e, D p e ≠ 0 → |g p - f e| ≤ lam0_3 CG / L)
    (hshell : ∑ p, Real.exp (-(2 * g p)) ≤
      6 * ∑ r ∈ range R, (64 * (r : ℝ) ^ 3 + 16 * r + 1) * Real.exp (-(2 * lam0_3 CG / L)) ^ r)
    (hV : energy D (weighted f u) + sqNorm (weighted f u) / L ^ 2 ≤ (2 * brezziM3 CG) ^ 2)
    (hcurv : D *ᵥ φ = D *ᵥ u)
    (hB : l1 φ ≤ L ^ 3 * l1 (A *ᵥ φ) + C * ((L - 1) / 2) * l1 (D *ᵥ φ))
    (hA : l1 (A *ᵥ φ) = 1) :
    l1 φ / L ^ 3 ≤ 1 + 1000 / 2 * kappaLead (brezziM3 CG) (lam0_3 CG) ∧ l1 φ / L ^ 3 ≤ 28 * 10 ^ 54 := by
  obtain ⟨hM, hl, -, hl4, -, -⟩ := ct3_chain hCG0 hCG
  have hl0 : 0 < lam0_3 CG := lt_of_lt_of_le (by norm_num) hl
  have hM0 : 0 ≤ brezziM3 CG := le_trans (by norm_num) (brezziM3_ge hCG0)
  obtain ⟨-, h2⟩ := tb3_loss D A φ u f g R hL hM0 hl0 hl4 hC0 hrow hcol hlip hshell hV hcurv hB hA
  have hK0 : 0 ≤ kappaLead (brezziM3 CG) (lam0_3 CG) := by unfold kappaLead; positivity
  have h3 : l1 φ / L ^ 3 ≤ 1 + 1000 / 2 * kappaLead (brezziM3 CG) (lam0_3 CG) :=
    h2.trans (by nlinarith [mul_le_mul_of_nonneg_right hC hK0])
  exact ⟨h3, h3.trans (tb3_numeric hM0 hM hl)⟩

