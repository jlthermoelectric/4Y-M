  exact ⟨by norm_num, le_rfl, by norm_num, by norm_num, le_rfl, hrow, hcol, hlip, hshell, hV, rfl, hB, hA,
    tb3_bound tD tA tφ tφ (fun _ : Fin 2 => 0) (fun _ : Fin 1 => 0) 1 (by norm_num) le_rfl (by norm_num)
      (by norm_num) le_rfl hrow hcol hlip hshell hV rfl hB hA⟩

end Witnesses3

end OddBlockUV

end
end Part13_OddBlockUV

/-! # Part 14: half-pinned variance tensorisation -/
section Part14_HalfPinnedVT

/-!
# Part 14: half-pinned variance tensorisation, its constant chain, and a transfer identity

This file formalises the abstract and arithmetic parts of a result at Gaussian order about a
pinned multiscale section of lattice link fields: a block-dynamics Poincaré inequality
(variance tensorisation, first chaos) for a law whose top-scale data are pinned only on a time
window (the *half-pinned* law), with a cover made of one large block `Γ` (the unpinned region)
and local boxes.

## Setting

In the intended application the vectors are curvature fields (fine plaquette fields) of a
two-dimensional section, with the Euclidean norm, which is the energy. The relevant objects are:
* the fully pinned space `S` (top data pinned everywhere) and the half-pinned space `S⁺ ⊇ S`
  (top data pinned only on the window);
* the box fibres `K x` of the fully pinned space, which lie in the half-pinned box fibres
  `K⁺ x`;
* the fibre `K_Γ` of the large block `Γ`.

In the Lean statements all of these are submodules of an abstract real inner-product space `E`.
The lattice model itself is not formalised.

The proof of the half-pinned inequality has three steps.
1. **Extension.** Every `F ∈ S⁺` has a piece `F_Γ ∈ K_Γ` with `F − F_Γ ∈ S` and
   `‖F_Γ‖² ≤ C_E ‖F‖²`. In the application `F_Γ` is a combination of functions dual to the
   top-scale tents, supported in `Γ`; its constant `C_E ≤ 1 + g/λ < 3` comes from a
   one-dimensional Gram computation.
2. **Full decomposition.** `F − F_Γ` splits subordinate to the box fibres with the fully pinned
   constant `C₀`.
3. **Lions step.** Together these give a stable decomposition of `S⁺` with constant
   `C₊ = C_E + 2 C₀ (1 + C_E)`, hence `‖F‖² ≤ C₊ (‖P_Γ F‖² + ∑_x ‖P_{K⁺ x} F‖²)`.

## Main results

* **Lions step** (§1). `lions`: a stable decomposition of a subspace `S` with constant `C`, by
  pieces in submodules `K i`, gives `‖F‖² ≤ C ∑_i ‖P_{K i} F‖²` for `F ∈ S`.
* **Minimal splitting** (§1). `minimal_splitting`: if `∑_i ‖P_{K i} x‖² ≥ λ ‖x‖²` for all `x`
  and `c = ∑_i P_{K i} u`, then the pieces `c_i = P_{K i} u` satisfy `∑_i c_i = c` and
  `∑_i ‖c_i‖² ≤ ‖c‖²/λ`.
* **Half-pinned decomposition and inequality** (§2).
  * `halfPinned_stable`: extension (constant `C_E`) plus a full decomposition (constant
    `C₀ ≥ 0`) give a stable decomposition of `S⁺`, indexed by `Option ι` (`none` is `Γ`), with
    constant `halfPinnedConst C₀ C_E = C_E + 2 C₀ (1 + C_E)`.
  * `halfPinnedVT`: the resulting inequality
    `‖F‖² ≤ C₊ (‖P_Γ F‖² + ∑_x ‖P_{K⁺ x} F‖²)` for `F ∈ S⁺`, where `K x ≤ K⁺ x`.
  * `halfPinnedConst_le`: if `C_E ≤ 3` and `C₀ ≥ 0`, then `C₊ ≤ 3 + 8 C₀`.
  * `twoLevelConst_nineTenths`, `halfPinned_bound_nineTenths`: with `C₀ = 2 + 2048 (9/10 + 9/16)`,
    `3 + 8 C₀ = 119903/5`.
  * `twoLevelConst_T3`, `halfPinned_bound_T3`: with `C_coarse ≤ 2500/3317`,
    `C₀ ≤ 8947818/3317` and `3 + 8 C₀ ≤ 71592495/3317`.
* **The extension constant** (§3). `end_margin`, `interior_margin_ge`, `extension_ratio_lt_two`,
  `extension_const_lt_three`: for the one-dimensional tent Gram entries
  `d_end = (P+1)(2P+1)/(6P)`, `d_int = (2P²+1)/(3P)`, `o = (P²−1)/(6P)` and the outside entry
  `g = (P−1)(2P−1)/(6P)`, the Gershgorin margins are `d_end − o = (P²+3P+2)/(6P)` and
  `d_int − 2o ≥ d_end − o` (for `P ≥ 2`), and `1 + g/(d_end − o) < 3` for `P > 0`.
  `gershgorin_quadratic`: a symmetric quadratic form is at least `∑_i (G_ii − ∑_{j≠i} |G_ij|) x_i²`.
* **From the inequality to localisation** (§4).
  * `hloc_identity`: for submodules `K₂ ≤ K₁` and `h = P₁ G − P₂ G`, `⟪h, G⟫ = ‖h‖²`.
  * `hloc_orth`: `P₂ h = 0`.
  * `hloc_centred`: `⟪h, G − c⟫ = ‖h‖²` for every `c ∈ K₂`.
  * `hloc_bound`: if `|⟪h, G − c⟫| ≤ ε ‖h‖ ‖G − c‖` with `ε ≥ 0`, then `‖h‖ ≤ ε ‖G − c‖`.
* **Decay from a spectral gap, Gaussian order** (§4b). `pow_norm_le`, `neumann_expand`,
  `neumann_decay`: if `‖A x‖ ≤ q ‖x‖` with `0 ≤ q < 1`, `u = s + A u` and `⟪b, Aʲ s⟫ = 0` for
  `j < n`, then `|⟪b, u⟫| ≤ qⁿ/(1 − q) ‖b‖ ‖s‖`. `psd_cauchy_schwarz`, `norm_le_of_form_bounds`:
  the form bounds `0 ≤ ⟪A x, x⟫ ≤ q ‖x‖²` of a symmetric `A` give `‖A x‖ ≤ q ‖x‖`. `gap_decay`: for a
  symmetric `T` with `c ≤ T ≤ m` (as forms) and `T u = m s`, with `A = 1 − T/m`,
  `|⟪b, u⟫| ≤ (1 − c/m)ⁿ/(c/m) ‖b‖ ‖s‖` (decay of a Gaussian covariance from the first-chaos
  inequality, when `⟪b, Aʲ s⟫ = 0` for `j < n`; with the large block `Γ` in the cover, `n`
  counts the range steps from the support of `s` to the region of `Γ`).
* **The transfer identity** (§5). `transfer`, `transfer_sum_zero`, `transfer_image`: given
  coefficients `ε b ℓ` with `∑_b ε b ℓ = 0` for every `ℓ`, a home map `ℓ ↦ home ℓ`, lifts
  `Lift b ℓ` with `V (Lift b ℓ) = δ_ℓ` for a linear map `V`, the transferred pieces sum to zero
  and `V (transfer b) = ε b` for every `b`.
* **The constant chain of the four-dimensional two-level decomposition** (§6).
  * `twoLevel4D_bound`: ten bookkeeping inequalities give `∑_b ‖F_b‖² ≤ C04D CL κ C_c ‖F‖²`,
    `C04D CL κ C_c = 772 + 19136 CL (9/2 κ C_c + 3)`. The depth-dependent factors `h²` and
    `1/h²` cancel exactly.
  * `twoHalf_dual_norm`, `bump_norm_sq`, `bump_grad_sq`, `liftEnergy_le`: the one-dimensional
    norms of the lift profiles and the bound `CL ≤ 1024/3` on the lift energy, for every
    `r ≥ 1` at `h = 2r`.

## Hypotheses made explicit

* The vector space is an abstract real inner-product space whose squared norm is the energy;
  positive definiteness of the energy on the relevant spaces is part of this model.
* Orthogonal projections onto the fibres exist (`HasOrthogonalProjection`).
* The extension property, the full decomposition and the bookkeeping inequalities are
  hypotheses. Their lattice content (curvature descriptions of the fibres, supports, tents,
  dual functions, the exact coarse constants, Gaussian conditioning) is not formalised.

## Not formalised

* The lattice model, the curvature descriptions of the fibres and of the half-pinned space, the
  Gaussian identification of conditional variances with projections, and the higher chaoses.
* The minimal-norm formula behind the extension constant (operator monotonicity of the inverse
  of a Gram matrix); only its scalar arithmetic is proved here.
* The exact coarse constants, which come from exact finite computations.
* The lift-energy factorisation `‖dλ‖² = 3 ‖s‖² ‖∇g‖² ‖g‖⁴` and the one-dimensional sums fed into
  `twoHalf_dual_norm`, `bump_norm_sq` and `bump_grad_sq` (those three theorems are algebraic
  identities with the sums inserted).
* The finite-range (locality) step that turns the half-pinned inequality into decay of
  covariances, and any uniformity in the volume.

## Non-vacuity

Every theorem with real hypotheses is applied to concrete data in §7 (`Examples`). Several
instances are degenerate (one-dimensional spaces, identity projections, bookkeeping met with
equality); the example docstrings say which.

## Scope

Gaussian order, two dimensions unless stated; inputs as hypotheses; nothing about the Yang–Mills
measure; (D), (E) and the mass gap remain open.
-/

open Finset

namespace HalfPinnedVT

/-! ## 1. Stable decompositions, the Lions step and the minimal splitting -/

section Lions

variable {ι E : Type*} [Fintype ι] [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- **A stable decomposition of a subspace.** Every `F ∈ S` splits as `F = ∑_i f_i` with
`f_i ∈ K i` and `∑_i ‖f_i‖² ≤ C ‖F‖²`. -/
def StableDecompositionOn (K : ι → Submodule ℝ E) (S : Submodule ℝ E) (C : ℝ) : Prop :=
  ∀ F ∈ S, ∃ f : ι → E, (∀ i, f i ∈ K i) ∧ ∑ i, f i = F ∧ ∑ i, ‖f i‖ ^ 2 ≤ C * ‖F‖ ^ 2

/-- `⟪P u, u⟫ = ‖P u‖²` for the orthogonal projection `P` onto a submodule. -/
theorem inner_starProjection_self (K : Submodule ℝ E) [K.HasOrthogonalProjection] (u : E) :
    inner ℝ (K.starProjection u) u = ‖K.starProjection u‖ ^ 2 := by
  have h := Submodule.starProjection_inner_eq_zero u (K.starProjection u)
    (K.starProjection_apply_mem u)
  rw [inner_sub_left] at h
  rw [← real_inner_self_eq_norm_sq]
  linarith [real_inner_comm u (K.starProjection u)]

/-- **The Lions step.** If the vectors of `S` have a stable decomposition with constant `C` by
pieces in the submodules `K i`, then `‖F‖² ≤ C ∑_i ‖P_{K i} F‖²` for every `F ∈ S`.

The proof: `‖F‖² = ∑_i ⟪P_{K i} F, f_i⟫ ≤ (∑_i ‖P_{K i} F‖²)^{1/2} (C ‖F‖²)^{1/2}`. -/
theorem lions (K : ι → Submodule ℝ E) [∀ i, (K i).HasOrthogonalProjection] (S : Submodule ℝ E)
    (C : ℝ) (hdec : StableDecompositionOn K S C) {F : E} (hF : F ∈ S) :
    ‖F‖ ^ 2 ≤ C * ∑ i, ‖(K i).starProjection F‖ ^ 2 := by
  obtain ⟨f, hmem, hsum, hbound⟩ := hdec F hF
  rcases eq_or_ne F 0 with rfl | hne
  · simp
  have hinner : ‖F‖ ^ 2 = ∑ i, inner ℝ ((K i).starProjection F) (f i) := by
    have h1 : ‖F‖ ^ 2 = inner ℝ F (∑ i, f i) := by rw [hsum, real_inner_self_eq_norm_sq]
    rw [h1, inner_sum]
    refine sum_congr rfl fun i _ => ?_
    rw [Submodule.inner_starProjection_left_eq_right,
      Submodule.starProjection_eq_self_iff.mpr (hmem i)]
  have hle : ∑ i, inner ℝ ((K i).starProjection F) (f i) ≤
      ∑ i, ‖(K i).starProjection F‖ * ‖f i‖ :=
    sum_le_sum fun i _ => real_inner_le_norm _ _
  have hcs : (∑ i, ‖(K i).starProjection F‖ * ‖f i‖) ^ 2 ≤
      (∑ i, ‖(K i).starProjection F‖ ^ 2) * ∑ i, ‖f i‖ ^ 2 :=
    sum_mul_sq_le_sq_mul_sq _ _ _
  have hA : 0 ≤ ∑ i, ‖(K i).starProjection F‖ ^ 2 := sum_nonneg fun i _ => sq_nonneg _
  have hpos : 0 < ‖F‖ ^ 2 := by positivity
  have h4 : (‖F‖ ^ 2) ^ 2 ≤ (∑ i, ‖(K i).starProjection F‖ ^ 2) * (C * ‖F‖ ^ 2) := by
    calc (‖F‖ ^ 2) ^ 2 ≤ (∑ i, ‖(K i).starProjection F‖ * ‖f i‖) ^ 2 := by
          have h0 : 0 ≤ ∑ i, inner ℝ ((K i).starProjection F) (f i) := by
            rw [← hinner]
            exact hpos.le
          rw [hinner]
          exact pow_le_pow_left₀ h0 hle 2
      _ ≤ (∑ i, ‖(K i).starProjection F‖ ^ 2) * ∑ i, ‖f i‖ ^ 2 := hcs
      _ ≤ (∑ i, ‖(K i).starProjection F‖ ^ 2) * (C * ‖F‖ ^ 2) :=
          mul_le_mul_of_nonneg_left hbound hA
  nlinarith

/-- **Minimal splitting (additive Schwarz).** Suppose `∑_i ‖P_{K i} x‖² ≥ λ ‖x‖²` for every
`x`, with `λ > 0`, and `c = ∑_i P_{K i} u`. Then the pieces `c_i = P_{K i} u` lie in `K i`, sum
to `c`, and satisfy `∑_i ‖c_i‖² ≤ ‖c‖²/λ`. -/
theorem minimal_splitting (K : ι → Submodule ℝ E) [∀ i, (K i).HasOrthogonalProjection]
    (lam : ℝ) (hlam : 0 < lam) (hT : ∀ x : E, lam * ‖x‖ ^ 2 ≤ ∑ i, ‖(K i).starProjection x‖ ^ 2)
    (u c : E) (hc : ∑ i, (K i).starProjection u = c) :
    (∀ i, (K i).starProjection u ∈ K i) ∧ ∑ i, (K i).starProjection u = c ∧
      ∑ i, ‖(K i).starProjection u‖ ^ 2 ≤ ‖c‖ ^ 2 / lam := by
  refine ⟨fun i => (K i).starProjection_apply_mem u, hc, ?_⟩
  set Ssum := ∑ i, ‖(K i).starProjection u‖ ^ 2 with hS
  have hSc : Ssum = inner ℝ c u := by
    rw [← hc, sum_inner]
    exact sum_congr rfl fun i _ => (inner_starProjection_self (K i) u).symm
  have hlow : lam * ‖u‖ ^ 2 ≤ Ssum := hT u
  have hcs : inner ℝ c u ≤ ‖c‖ * ‖u‖ := real_inner_le_norm c u
  have hS0 : 0 ≤ Ssum := sum_nonneg fun i _ => sq_nonneg _
  rw [le_div_iff₀ hlam]
  have hsq : Ssum ^ 2 ≤ ‖c‖ ^ 2 * ‖u‖ ^ 2 := by
    have h1 : Ssum ≤ ‖c‖ * ‖u‖ := by rw [hSc]; exact hcs
    have h2 : Ssum ^ 2 ≤ (‖c‖ * ‖u‖) ^ 2 := pow_le_pow_left₀ hS0 h1 2
    nlinarith
  have p1 : Ssum ^ 2 * lam ≤ ‖c‖ ^ 2 * ‖u‖ ^ 2 * lam := mul_le_mul_of_nonneg_right hsq hlam.le
  have p2 : ‖c‖ ^ 2 * (lam * ‖u‖ ^ 2) ≤ ‖c‖ ^ 2 * Ssum :=
    mul_le_mul_of_nonneg_left hlow (sq_nonneg ‖c‖)
  have h5 : Ssum * (Ssum * lam) ≤ Ssum * ‖c‖ ^ 2 := by nlinarith
  rcases eq_or_lt_of_le hS0 with h0 | hpos
  · rw [← h0, zero_mul]; exact sq_nonneg _
  · exact le_of_mul_le_mul_left h5 hpos

end Lions

/-! ## 2. The half-pinned decomposition and the half-pinned inequality -/

section HalfPinned

variable {ι E : Type*} [Fintype ι] [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- The half-pinned constant `C₊ = C_E + 2 C₀ (1 + C_E)`. -/
def halfPinnedConst (C₀ CE : ℝ) : ℝ := CE + 2 * C₀ * (1 + CE)

omit [InnerProductSpace ℝ E] in
/-- `‖a − b‖² ≤ 2 ‖a‖² + 2 ‖b‖²`. -/
theorem norm_sub_sq_le_two (a b : E) : ‖a - b‖ ^ 2 ≤ 2 * ‖a‖ ^ 2 + 2 * ‖b‖ ^ 2 := by
  have h := norm_sub_le a b
  have h0 : 0 ≤ ‖a - b‖ := norm_nonneg _
  have h2 : ‖a - b‖ * ‖a - b‖ ≤ (‖a‖ + ‖b‖) * (‖a‖ + ‖b‖) := mul_self_le_mul_self h0 h
  nlinarith [sq_nonneg (‖a‖ - ‖b‖)]

/-- The family of blocks of the half-pinned cover, indexed by `Option ι`: `none` is the large
block `Γ`, `some x` is the box `x`. -/
def coverFamily (KΓ : Submodule ℝ E) (K : ι → Submodule ℝ E) : Option ι → Submodule ℝ E :=
  fun o => o.elim KΓ K

/-- **The half-pinned decomposition.** Suppose:
* the vectors of `S` have a stable decomposition by pieces in `K x` with constant `C₀ ≥ 0`;
* every `F ∈ S⁺` has an extension piece `F_Γ ∈ K_Γ` with `F − F_Γ ∈ S` and
  `‖F_Γ‖² ≤ C_E ‖F‖²`.

Then the vectors of `S⁺` have a stable decomposition by pieces in `K_Γ` and the `K x`, with
constant `C_E + 2 C₀ (1 + C_E)`. -/
theorem halfPinned_stable (K : ι → Submodule ℝ E) (KΓ S Sp : Submodule ℝ E) (C₀ CE : ℝ)
    (hC₀ : 0 ≤ C₀) (hfull : StableDecompositionOn K S C₀)
    (hext : ∀ F ∈ Sp, ∃ FΓ ∈ KΓ, F - FΓ ∈ S ∧ ‖FΓ‖ ^ 2 ≤ CE * ‖F‖ ^ 2) :
    StableDecompositionOn (coverFamily KΓ K) Sp (halfPinnedConst C₀ CE) := by
  intro F hF
  obtain ⟨FΓ, hΓmem, hrest, hΓ⟩ := hext F hF
  obtain ⟨f, hfmem, hfsum, hfbd⟩ := hfull (F - FΓ) hrest
  refine ⟨fun o => o.elim FΓ f, ?_, ?_, ?_⟩
  · intro o
    cases o with
    | none => exact hΓmem
    | some i => exact hfmem i
  · rw [Fintype.sum_option]
    simp only [Option.elim]
    rw [hfsum]
    abel
  · rw [Fintype.sum_option]
    simp only [Option.elim]
    have h2 := norm_sub_sq_le_two F FΓ
    have h3 : ‖F - FΓ‖ ^ 2 ≤ 2 * ‖F‖ ^ 2 + 2 * (CE * ‖F‖ ^ 2) := by linarith
    have h4 : C₀ * ‖F - FΓ‖ ^ 2 ≤ C₀ * (2 * ‖F‖ ^ 2 + 2 * (CE * ‖F‖ ^ 2)) :=
      mul_le_mul_of_nonneg_left h3 hC₀
    unfold halfPinnedConst
    nlinarith

/-- **The half-pinned inequality.** Under the hypotheses of `halfPinned_stable`, and with box
submodules `K x ≤ K⁺ x`, every `F ∈ S⁺` satisfies
`‖F‖² ≤ C₊ (‖P_Γ F‖² + ∑_x ‖P_{K⁺ x} F‖²)`, `C₊ = C_E + 2 C₀ (1 + C_E)`.

In the application, `S⁺` is the half-pinned curvature space, `K⁺ x` the half-pinned box fibres
and `K_Γ` the fibre of the unpinned region; read there, the inequality is variance tensorisation in
the first chaos for the half-pinned Gaussian law with the cover `{Γ} ∪ {boxes}` (that reading, i.e.
the identification with conditional variances, and the lattice hypotheses are not formalised). -/
theorem halfPinnedVT (K Kp : ι → Submodule ℝ E) (KΓ S Sp : Submodule ℝ E)
    [∀ i, (Kp i).HasOrthogonalProjection] [KΓ.HasOrthogonalProjection] (C₀ CE : ℝ)
    (hC₀ : 0 ≤ C₀) (hK : ∀ i, K i ≤ Kp i) (hfull : StableDecompositionOn K S C₀)
    (hext : ∀ F ∈ Sp, ∃ FΓ ∈ KΓ, F - FΓ ∈ S ∧ ‖FΓ‖ ^ 2 ≤ CE * ‖F‖ ^ 2) {F : E} (hF : F ∈ Sp) :
    ‖F‖ ^ 2 ≤ halfPinnedConst C₀ CE *
      (‖KΓ.starProjection F‖ ^ 2 + ∑ i, ‖(Kp i).starProjection F‖ ^ 2) := by
  have hfull' : StableDecompositionOn Kp S C₀ := by
    intro G hG
    obtain ⟨f, hm, hs, hb⟩ := hfull G hG
    exact ⟨f, fun i => hK i (hm i), hs, hb⟩
  have hdec := halfPinned_stable Kp KΓ S Sp C₀ CE hC₀ hfull' hext
  have : ∀ o, (coverFamily KΓ Kp o).HasOrthogonalProjection := by
    intro o
    cases o with
    | none => exact (inferInstance : KΓ.HasOrthogonalProjection)
    | some i => exact (inferInstance : (Kp i).HasOrthogonalProjection)
  have h := lions (coverFamily KΓ Kp) Sp _ hdec hF
  rw [Fintype.sum_option] at h
  exact h

/-- If `C_E ≤ 3` and `C₀ ≥ 0`, then `C₊ = C_E + 2 C₀ (1 + C_E) ≤ 3 + 8 C₀`. -/
theorem halfPinnedConst_le (C₀ CE : ℝ) (hC₀ : 0 ≤ C₀) (hE3 : CE ≤ 3) :
    halfPinnedConst C₀ CE ≤ 3 + 8 * C₀ := by
  unfold halfPinnedConst
  nlinarith

/-- The two-level constant `C₀(C) = 2 + 2048 (C + 9/16)` of the two-dimensional decomposition. -/
noncomputable def twoLevelConst (C : ℝ) : ℝ := 2 + 2048 * (C + 9 / 16)

/-- `C₀(9/10) = 14986/5`. -/
theorem twoLevelConst_nineTenths : twoLevelConst (9 / 10) = 14986 / 5 := by
  unfold twoLevelConst; norm_num

/-- With `C_coarse = 9/10`: `3 + 8 C₀ = 119903/5 = 23980.6`. -/
theorem halfPinned_bound_nineTenths : 3 + 8 * twoLevelConst (9 / 10) = 119903 / 5 := by
  unfold twoLevelConst; norm_num

/-- With `C_coarse ≤ 2500/3317`: `C₀ ≤ 8947818/3317`. -/
theorem twoLevelConst_T3 (C : ℝ) (hC : C ≤ 2500 / 3317) : twoLevelConst C ≤ 8947818 / 3317 := by
  unfold twoLevelConst; linarith

/-- With `C_coarse ≤ 2500/3317`: `3 + 8 C₀ ≤ 71592495/3317 ≈ 21583.5`. -/
theorem halfPinned_bound_T3 (C : ℝ) (hC : C ≤ 2500 / 3317) :
    3 + 8 * twoLevelConst C ≤ 71592495 / 3317 := by
  have := twoLevelConst_T3 C hC; linarith

end HalfPinned

/-! ## 3. The extension constant: one-dimensional Gram arithmetic -/

section Extension

/-- Margin of an end row of the restricted tent Gram matrix:
`(P+1)(2P+1)/(6P) − (P²−1)/(6P) = (P²+3P+2)/(6P)`. -/
theorem end_margin (P : ℝ) (hP : 0 < P) :
    (P + 1) * (2 * P + 1) / (6 * P) - (P ^ 2 - 1) / (6 * P) = (P ^ 2 + 3 * P + 2) / (6 * P) := by
  field_simp; ring

/-- Margin of an interior row: for `P ≥ 2`,
`(P²+3P+2)/(6P) ≤ (2P²+1)/(3P) − 2 (P²−1)/(6P)`. -/
theorem interior_margin_ge (P : ℝ) (hP : 2 ≤ P) :
    (P ^ 2 + 3 * P + 2) / (6 * P) ≤ (2 * P ^ 2 + 1) / (3 * P) - 2 * ((P ^ 2 - 1) / (6 * P)) := by
  have hP0 : 0 < P := by linarith
  rw [div_le_iff₀ (by positivity)]
  have e : ((2 * P ^ 2 + 1) / (3 * P) - 2 * ((P ^ 2 - 1) / (6 * P))) * (6 * P)
      = 2 * P ^ 2 + 4 := by field_simp; ring
  rw [e]
  nlinarith [mul_nonneg (sub_nonneg.mpr hP) (by linarith : (0 : ℝ) ≤ P - 1)]

/-- The outside entry over the Gershgorin margin is below `2`:
`(P−1)(2P−1)/(6P) / ((P²+3P+2)/(6P)) < 2` for `P > 0`. -/
theorem extension_ratio_lt_two (P : ℝ) (hP : 0 < P) :
    (P - 1) * (2 * P - 1) / (6 * P) / ((P ^ 2 + 3 * P + 2) / (6 * P)) < 2 := by
  have h6 : 0 < 6 * P := by positivity
  have hq : 0 < P ^ 2 + 3 * P + 2 := by positivity
  rw [div_div_div_cancel_right₀ h6.ne', div_lt_iff₀ hq]
  nlinarith

/-- **The extension constant.** `1 + g/m < 3`, with `g = (P−1)(2P−1)/(6P)` the outside Gram
entry and `m = (P²+3P+2)/(6P)` the Gershgorin margin, for every `P > 0`. -/
theorem extension_const_lt_three (P : ℝ) (hP : 0 < P) :
    1 + (P - 1) * (2 * P - 1) / (6 * P) / ((P ^ 2 + 3 * P + 2) / (6 * P)) < 3 := by
  have := extension_ratio_lt_two P hP; linarith

/-- **Gershgorin for quadratic forms.** For a symmetric real matrix `G` and any `x`,
`∑_{i,j} G_ij x_i x_j ≥ ∑_i (G_ii − ∑_{j ≠ i} |G_ij|) x_i²`. -/
theorem gershgorin_quadratic {n : Type*} [Fintype n] [DecidableEq n] (G : n → n → ℝ)
    (hsym : ∀ i j, G i j = G j i) (x : n → ℝ) :
    ∑ i, (G i i - ∑ j ∈ univ.erase i, |G i j|) * x i ^ 2 ≤ ∑ i, ∑ j, G i j * x i * x j := by
  set a : n → n → ℝ := fun i j => if i = j then 0 else |G i j| with ha
  have hrow : ∀ i, ∑ j ∈ univ.erase i, |G i j| = ∑ j, a i j := by
    intro i
    rw [← add_sum_erase univ (fun j => a i j) (mem_univ i)]
    simp only [ha, if_pos rfl, zero_add]
    refine sum_congr rfl fun j hj => ?_
    rw [if_neg (Ne.symm (ne_of_mem_erase hj))]
  have key : ∀ i j, -(|G i j| * (x i ^ 2 + x j ^ 2) / 2) ≤ G i j * x i * x j := by
    intro i j
    have h1 : -(|G i j| * |x i * x j|) ≤ G i j * (x i * x j) := by
      have := neg_abs_le (G i j * (x i * x j))
      rw [abs_mul] at this; linarith
    have h2 : |x i * x j| ≤ (x i ^ 2 + x j ^ 2) / 2 := by
      rw [abs_mul]
      nlinarith [sq_nonneg (|x i| - |x j|), sq_abs (x i), sq_abs (x j)]
    have h3 : |G i j| * |x i * x j| ≤ |G i j| * ((x i ^ 2 + x j ^ 2) / 2) :=
      mul_le_mul_of_nonneg_left h2 (abs_nonneg _)
    nlinarith
  have hpt : ∀ i j, (if i = j then G i i * x i ^ 2 else 0) - a i j * x i ^ 2 / 2
      - a i j * x j ^ 2 / 2 ≤ G i j * x i * x j := by
    intro i j
    by_cases h : i = j
    · subst h
      simp only [ha, ↓reduceIte, zero_mul, zero_div, sub_zero]
      exact le_of_eq (by ring)
    · simp only [ha, if_neg h]
      have := key i j
      linarith
  have hsum : ∑ i, ∑ j, ((if i = j then G i i * x i ^ 2 else 0) - a i j * x i ^ 2 / 2
      - a i j * x j ^ 2 / 2) ≤ ∑ i, ∑ j, G i j * x i * x j :=
    sum_le_sum fun i _ => sum_le_sum fun j _ => hpt i j
  have hdiag : ∑ i, ∑ j, (if i = j then G i i * x i ^ 2 else 0) = ∑ i, G i i * x i ^ 2 := by
    refine sum_congr rfl fun i _ => ?_
    rw [sum_ite_eq univ i (fun _ => G i i * x i ^ 2), if_pos (mem_univ i)]
  have hsym2 : ∑ i, ∑ j, a i j * x j ^ 2 = ∑ i, ∑ j, a i j * x i ^ 2 := by
    rw [sum_comm]
    refine sum_congr rfl fun i _ => sum_congr rfl fun j _ => ?_
    simp only [ha]
    by_cases h : i = j
    · subst h; rfl
    · rw [if_neg (Ne.symm h), if_neg h, hsym]
  have e1 : ∑ i, ∑ j, ((if i = j then G i i * x i ^ 2 else 0) - a i j * x i ^ 2 / 2
      - a i j * x j ^ 2 / 2) = ∑ i, ∑ j, (if i = j then G i i * x i ^ 2 else 0)
        - (∑ i, ∑ j, a i j * x i ^ 2) / 2 - (∑ i, ∑ j, a i j * x j ^ 2) / 2 := by
    simp only [sum_sub_distrib, sum_div]
  have e2 : ∑ i, (G i i - ∑ j ∈ univ.erase i, |G i j|) * x i ^ 2
      = ∑ i, G i i * x i ^ 2 - ∑ i, ∑ j, a i j * x i ^ 2 := by
    rw [← sum_sub_distrib]
    refine sum_congr rfl fun i _ => ?_
    rw [hrow i, sub_mul, sum_mul]
  rw [e2]
  rw [e1, hdiag, hsym2] at hsum
  linarith

end Extension

/-! ## 4. From the inequality to localisation: the variance identity -/

section Localisation

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- **The localisation identity.** For submodules `K₂ ≤ K₁` with orthogonal projections `P₁`,
`P₂`, put `h = P₁ G − P₂ G`. Then `⟪h, G⟫ = ‖h‖²`.

In the application `P₁` and `P₂` are conditional expectations onto the coarse σ-algebra and onto
its future part, `G` is a time-translated observable, and `h` is its localisation error; the
identity reads `‖h‖² = E[Cov(h, G | future)]`. -/
theorem hloc_identity (K₁ K₂ : Submodule ℝ E) [K₁.HasOrthogonalProjection]
    [K₂.HasOrthogonalProjection] (h12 : K₂ ≤ K₁) (G : E) :
    inner ℝ (K₁.starProjection G - K₂.starProjection G) G
      = ‖K₁.starProjection G - K₂.starProjection G‖ ^ 2 := by
  set p₁ := K₁.starProjection G
  set p₂ := K₂.starProjection G
  have hp₁ : p₁ ∈ K₁ := K₁.starProjection_apply_mem G
  have hp₂ : p₂ ∈ K₂ := K₂.starProjection_apply_mem G
  have hh : p₁ - p₂ ∈ K₁ := K₁.sub_mem hp₁ (h12 hp₂)
  have o1 : inner ℝ (G - p₁) (p₁ - p₂) = 0 := Submodule.starProjection_inner_eq_zero G _ hh
  have o2 : inner ℝ (G - p₁) p₂ = 0 := Submodule.starProjection_inner_eq_zero G _ (h12 hp₂)
  have o3 : inner ℝ (G - p₂) p₂ = 0 := Submodule.starProjection_inner_eq_zero G _ hp₂
  rw [← real_inner_self_eq_norm_sq]
  have e1 : inner ℝ (p₁ - p₂) G = inner ℝ (p₁ - p₂) p₁ := by
    have : inner ℝ (p₁ - p₂) (G - p₁) = 0 := by rw [real_inner_comm]; exact o1
    rw [inner_sub_right] at this; linarith
  have e2 : inner ℝ (p₁ - p₂) p₂ = 0 := by
    have a : inner ℝ (p₁ - p₂) p₂ = inner ℝ (G - p₂) p₂ - inner ℝ (G - p₁) p₂ := by
      rw [inner_sub_left, inner_sub_left, inner_sub_left]; ring
    rw [a, o2, o3]; ring
  rw [e1]
  have : inner ℝ (p₁ - p₂) p₁ = inner ℝ (p₁ - p₂) (p₁ - p₂) + inner ℝ (p₁ - p₂) p₂ := by
    rw [inner_sub_right]; ring
  rw [this, e2, add_zero]

/-- The localisation error is orthogonal to the smaller submodule: `P₂ h = 0`. -/
theorem hloc_orth (K₁ K₂ : Submodule ℝ E) [K₁.HasOrthogonalProjection]
    [K₂.HasOrthogonalProjection] (h12 : K₂ ≤ K₁) (G : E) :
    K₂.starProjection (K₁.starProjection G - K₂.starProjection G) = 0 := by
  apply Submodule.eq_starProjection_of_mem_of_inner_eq_zero (K := K₂) (Submodule.zero_mem _)
  intro w hw
  have h1 := Submodule.starProjection_inner_eq_zero G w (h12 hw)
  have h2 := Submodule.starProjection_inner_eq_zero G w hw
  rw [sub_zero]
  rw [inner_sub_left] at h1 h2 ⊢
  linarith

/-- **Centred form of the identity.** For every `c ∈ K₂`, `⟪h, G − c⟫ = ‖h‖²`. -/
theorem hloc_centred (K₁ K₂ : Submodule ℝ E) [K₁.HasOrthogonalProjection]
    [K₂.HasOrthogonalProjection] (h12 : K₂ ≤ K₁) (G c : E) (hc : c ∈ K₂) :
    inner ℝ (K₁.starProjection G - K₂.starProjection G) (G - c)
      = ‖K₁.starProjection G - K₂.starProjection G‖ ^ 2 := by
  have h0 := hloc_orth K₁ K₂ h12 G
  have horth : inner ℝ (K₁.starProjection G - K₂.starProjection G) c = 0 := by
    have := Submodule.inner_starProjection_left_eq_right K₂
      (K₁.starProjection G - K₂.starProjection G) c
    rw [h0, inner_zero_left, Submodule.starProjection_eq_self_iff.mpr hc] at this
    exact this.symm
  rw [inner_sub_right, horth, sub_zero]
  exact hloc_identity K₁ K₂ h12 G

/-- **Localisation from decorrelation.** If `|⟪h, G − c⟫| ≤ ε ‖h‖ ‖G − c‖` for some `c ∈ K₂`
and `ε ≥ 0`, then `‖h‖ ≤ ε ‖G − c‖`.

In the application the hypothesis is the decay of the conditional covariance of `h` and `G`
under the half-pinned law. At Gaussian order on a fixed torus it follows from the half-pinned
inequality together with the finite range of the block operator (not formalised); uniformity in
the volume is not proved. The conclusion is the localisation input, with the standard deviation
of `G` on the right. -/
theorem hloc_bound (K₁ K₂ : Submodule ℝ E) [K₁.HasOrthogonalProjection]
    [K₂.HasOrthogonalProjection] (h12 : K₂ ≤ K₁) (G c : E) (hc : c ∈ K₂) (ε : ℝ) (hε : 0 ≤ ε)
    (hdec : |inner ℝ (K₁.starProjection G - K₂.starProjection G) (G - c)| ≤
      ε * ‖K₁.starProjection G - K₂.starProjection G‖ * ‖G - c‖) :
    ‖K₁.starProjection G - K₂.starProjection G‖ ≤ ε * ‖G - c‖ := by
  set h := K₁.starProjection G - K₂.starProjection G
  have hid := hloc_centred K₁ K₂ h12 G c hc
  rw [hid, abs_of_nonneg (sq_nonneg _)] at hdec
  rcases eq_or_lt_of_le (norm_nonneg h) with h0 | hpos
  · rw [← h0]; exact mul_nonneg hε (norm_nonneg _)
  · have : ‖h‖ * ‖h‖ ≤ (ε * ‖G - c‖) * ‖h‖ := by nlinarith
    exact le_of_mul_le_mul_right this hpos

end Localisation

/-! ## 4b. Decay from a spectral gap, at Gaussian order (Neumann form) -/

section Decay

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- Powers of a linear map with `‖A x‖ ≤ q ‖x‖` satisfy `‖Aⁿ x‖ ≤ qⁿ ‖x‖`. -/
theorem pow_norm_le (A : E →ₗ[ℝ] E) (q : ℝ) (hq0 : 0 ≤ q) (hA : ∀ x, ‖A x‖ ≤ q * ‖x‖) (n : ℕ)
    (x : E) : ‖(A ^ n) x‖ ≤ q ^ n * ‖x‖ := by
  induction n generalizing x with
  | zero => simp
  | succ n ih =>
    rw [pow_succ, Module.End.mul_apply]
    calc ‖(A ^ n) (A x)‖ ≤ q ^ n * ‖A x‖ := ih (A x)
      _ ≤ q ^ n * (q * ‖x‖) := mul_le_mul_of_nonneg_left (hA x) (pow_nonneg hq0 n)
      _ = q ^ (n + 1) * ‖x‖ := by ring

/-- The Neumann expansion `u = ∑_{j<n} Aʲ s + Aⁿ u` of a solution of `u = s + A u`. -/
theorem neumann_expand (A : E →ₗ[ℝ] E) (s u : E) (hu : u = s + A u) (n : ℕ) :
    u = ∑ j ∈ range n, (A ^ j) s + (A ^ n) u := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [sum_range_succ, add_assoc]
    have : (A ^ n) u = (A ^ n) s + (A ^ (n + 1)) u := by
      conv_lhs => rw [hu]
      rw [map_add, pow_succ, Module.End.mul_apply]
    rw [← this]
    exact ih

/-- **Decay from a spectral gap (Neumann form).** Let `A` be linear with `‖A x‖ ≤ q ‖x‖`,
`0 ≤ q < 1`, and let `u = s + A u`. If `⟪b, Aʲ s⟫ = 0` for every `j < n`, then
`|⟪b, u⟫| ≤ qⁿ/(1 − q) · ‖b‖ ‖s‖`.

In the application `A = 1 − 𝒯/m`, where `𝒯 = ∑_y P_y` is the sum of the block projections,
`c ≤ 𝒯 ≤ m` (the first-chaos inequality with constant `c`), and `q = 1 − c/m`; `u = m 𝒯⁻¹ s`.
The orthogonality hypothesis says that `Aʲ s` does not reach the support of `b` for `j < n`.
For the boxes alone this is their finite range; with the large block `Γ` in the cover, whose
projection has no finite range, `n` counts the range steps from the support of `s` to the region
of `Γ` (and to the support of `b`). The conclusion is exponential decay of the Gaussian
covariance `⟪b, 𝒯⁻¹ s⟫`, at rate `q` per such step. -/
theorem neumann_decay (A : E →ₗ[ℝ] E) (q : ℝ) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hA : ∀ x, ‖A x‖ ≤ q * ‖x‖) (s u b : E) (hu : u = s + A u) (n : ℕ)
    (hloc : ∀ j < n, inner ℝ b ((A ^ j) s) = 0) :
    |inner ℝ b u| ≤ q ^ n / (1 - q) * ‖b‖ * ‖s‖ := by
  have hexp := neumann_expand A s u hu n
  have h1 : inner ℝ b u = inner ℝ b ((A ^ n) u) := by
    conv_lhs => rw [hexp]
    rw [inner_add_right, inner_sum]
    have : ∑ j ∈ range n, inner ℝ b ((A ^ j) s) = 0 :=
      sum_eq_zero fun j hj => hloc j (mem_range.mp hj)
    rw [this, zero_add]
  have hu_le : ‖u‖ ≤ ‖s‖ / (1 - q) := by
    have h2 : ‖u‖ ≤ ‖s‖ + q * ‖u‖ := by
      calc ‖u‖ = ‖s + A u‖ := by rw [← hu]
        _ ≤ ‖s‖ + ‖A u‖ := norm_add_le _ _
        _ ≤ ‖s‖ + q * ‖u‖ := by linarith [hA u]
    rw [le_div_iff₀ (by linarith)]
    linarith
  have h3 : |inner ℝ b ((A ^ n) u)| ≤ ‖b‖ * (q ^ n * ‖u‖) :=
    le_trans (abs_real_inner_le_norm _ _)
      (mul_le_mul_of_nonneg_left (pow_norm_le A q hq0 hA n u) (norm_nonneg _))
  rw [h1]
  calc |inner ℝ b ((A ^ n) u)| ≤ ‖b‖ * (q ^ n * ‖u‖) := h3
    _ ≤ ‖b‖ * (q ^ n * (‖s‖ / (1 - q))) :=
        mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hu_le (pow_nonneg hq0 n))
          (norm_nonneg _)
    _ = q ^ n / (1 - q) * ‖b‖ * ‖s‖ := by ring

/-- **Cauchy–Schwarz for a positive symmetric operator.** If `⟪A x, y⟫ = ⟪x, A y⟫` and
`⟪A x, x⟫ ≥ 0` for all `x, y`, then `⟪A x, y⟫² ≤ ⟪A x, x⟫ ⟪A y, y⟫`. -/
theorem psd_cauchy_schwarz (A : E →ₗ[ℝ] E) (hsym : ∀ x y, inner ℝ (A x) y = inner ℝ x (A y))
    (hpos : ∀ x, 0 ≤ inner ℝ (A x) x) (x y : E) :
    inner ℝ (A x) y ^ 2 ≤ inner ℝ (A x) x * inner ℝ (A y) y := by
  have hyx : inner ℝ (A y) x = inner ℝ (A x) y := by rw [hsym, real_inner_comm]
  have hq : ∀ t : ℝ, 0 ≤ inner ℝ (A y) y * (t * t) + 2 * inner ℝ (A x) y * t + inner ℝ (A x) x := by
    intro t
    have h := hpos (x + t • y)
    have e : inner ℝ (A (x + t • y)) (x + t • y)
        = inner ℝ (A y) y * (t * t) + 2 * inner ℝ (A x) y * t + inner ℝ (A x) x := by
      rw [map_add, map_smul, inner_add_left, inner_add_right, inner_add_right, real_inner_smul_left,
        real_inner_smul_right, real_inner_smul_left, real_inner_smul_right, hyx]
      ring
    rw [e] at h
    exact h
  have hd := discrim_le_zero hq
  unfold discrim at hd
  nlinarith

/-- **Operator-norm bound from form bounds.** If `A` is symmetric with `0 ≤ ⟪A x, x⟫ ≤ q ‖x‖²` for
all `x` and `q ≥ 0`, then `‖A x‖ ≤ q ‖x‖`. -/
theorem norm_le_of_form_bounds (A : E →ₗ[ℝ] E) (hsym : ∀ x y, inner ℝ (A x) y = inner ℝ x (A y))
    (q : ℝ) (hq : 0 ≤ q) (hpos : ∀ x, 0 ≤ inner ℝ (A x) x)
    (hup : ∀ x, inner ℝ (A x) x ≤ q * ‖x‖ ^ 2) (x : E) : ‖A x‖ ≤ q * ‖x‖ := by
  have hcs := psd_cauchy_schwarz A hsym hpos x (A x)
  have h1 : inner ℝ (A x) (A x) = ‖A x‖ ^ 2 := real_inner_self_eq_norm_sq _
  rw [h1] at hcs
  have h2 : inner ℝ (A x) x * inner ℝ (A (A x)) (A x) ≤ (q * ‖x‖ ^ 2) * (q * ‖A x‖ ^ 2) :=
    mul_le_mul (hup x) (hup (A x)) (hpos _) (by positivity)
  have h3 : (‖A x‖ ^ 2) ^ 2 ≤ (q * ‖x‖ * ‖A x‖) ^ 2 := by nlinarith
  have h4 : ‖A x‖ ^ 2 ≤ q * ‖x‖ * ‖A x‖ := (sq_le_sq₀ (by positivity) (by positivity)).mp h3
  rcases eq_or_lt_of_le (norm_nonneg (A x)) with h0 | hpos'
  · rw [← h0]; positivity
  · nlinarith

/-- **Decay from a spectral gap, stated with the gap.** Let `T` be symmetric with
`c ‖x‖² ≤ ⟪T x, x⟫ ≤ m ‖x‖²`, `0 < c ≤ m`, and let `T u = m s`. If `⟪b, Aʲ s⟫ = 0` for `j < n`,
where `A = 1 − T/m`, then `|⟪b, u⟫| ≤ (1 − c/m)ⁿ/(c/m) · ‖b‖ ‖s‖`.

In the application `T = ∑_y P_y` (the half-pinned blocks), `c` is the first-chaos constant and `m`
the block multiplicity; `⟪b, u⟫ = m ⟪b, T⁻¹ s⟫` is `m` times a Gaussian covariance. The
orthogonality hypothesis is read as in `neumann_decay`: with the large block `Γ` in the cover, `n`
counts the range steps from the support of `s` to the region of `Γ`, since its projection has no
finite range. -/
theorem gap_decay (T : E →ₗ[ℝ] E) (hsym : ∀ x y, inner ℝ (T x) y = inner ℝ x (T y)) (c m : ℝ)
    (hc : 0 < c) (hcm : c ≤ m) (hlow : ∀ x, c * ‖x‖ ^ 2 ≤ inner ℝ (T x) x)
    (hup : ∀ x, inner ℝ (T x) x ≤ m * ‖x‖ ^ 2) (s u b : E) (hu : T u = m • s) (n : ℕ)
    (hloc : ∀ j < n, inner ℝ b (((LinearMap.id - (1 / m) • T : E →ₗ[ℝ] E) ^ j) s) = 0) :
    |inner ℝ b u| ≤ (1 - c / m) ^ n / (c / m) * ‖b‖ * ‖s‖ := by
  have hm : 0 < m := lt_of_lt_of_le hc hcm
  set A : E →ₗ[ℝ] E := LinearMap.id - (1 / m) • T with hA
  have hAx : ∀ x, A x = x - (1 / m) • T x := fun x => rfl
  have hAsym : ∀ x y, inner ℝ (A x) y = inner ℝ x (A y) := by
    intro x y
    rw [hAx, hAx, inner_sub_left, inner_sub_right, real_inner_smul_left, real_inner_smul_right, hsym]
  have hform : ∀ x, inner ℝ (A x) x = ‖x‖ ^ 2 - (1 / m) * inner ℝ (T x) x := by
    intro x
    rw [hAx, inner_sub_left, real_inner_smul_left, real_inner_self_eq_norm_sq]
  have hApos : ∀ x, 0 ≤ inner ℝ (A x) x := by
    intro x
    rw [hform]
    have := hup x
    have h1 : (1 / m) * inner ℝ (T x) x ≤ (1 / m) * (m * ‖x‖ ^ 2) :=
      mul_le_mul_of_nonneg_left this (by positivity)
    have h2 : (1 / m) * (m * ‖x‖ ^ 2) = ‖x‖ ^ 2 := by field_simp
    linarith
  have hAup : ∀ x, inner ℝ (A x) x ≤ (1 - c / m) * ‖x‖ ^ 2 := by
    intro x
    rw [hform]
    have h1 : (1 / m) * (c * ‖x‖ ^ 2) ≤ (1 / m) * inner ℝ (T x) x :=
      mul_le_mul_of_nonneg_left (hlow x) (by positivity)
    have h2 : (1 / m) * (c * ‖x‖ ^ 2) = c / m * ‖x‖ ^ 2 := by field_simp
    nlinarith
  have hq0 : 0 ≤ 1 - c / m := by rw [sub_nonneg, div_le_one hm]; exact hcm
  have hq1 : 1 - c / m < 1 := by have : 0 < c / m := div_pos hc hm; linarith
  have hnorm := norm_le_of_form_bounds A hAsym (1 - c / m) hq0 hApos hAup
  have hu' : u = s + A u := by
    rw [hAx, hu, smul_smul, one_div, inv_mul_cancel₀ hm.ne', one_smul]
    abel
  have := neumann_decay A (1 - c / m) hq0 hq1 hnorm s u b hu' n hloc
  have e : 1 - (1 - c / m) = c / m := by ring
  rw [e] at this
  exact this

end Decay

/-! ## 5. The transfer identity -/

section Transfer

variable {β Λ E : Type*} [Fintype β] [DecidableEq β] [Fintype Λ] [DecidableEq Λ]
  [AddCommGroup E] [Module ℝ E]

/-- **Transferred piece of block `b`.** For every index `ℓ` (a coarse link, in the application)
whose home is not `b`, block `b` receives `ε b ℓ • Lift b ℓ`; for every `ℓ` whose home is `b`,
block `b` receives `−∑_{b' ≠ b} ε b' ℓ • Lift b' ℓ`. -/
def transfer (home : Λ → β) (Lift : β → Λ → E) (ε : β → Λ → ℝ) (b : β) : E :=
  ∑ ℓ, if home ℓ = b then -∑ b' ∈ univ.erase b, ε b' ℓ • Lift b' ℓ else ε b ℓ • Lift b ℓ

omit [DecidableEq Λ] in
/-- **The transferred pieces sum to zero.** Every term `ε b ℓ • Lift b ℓ` with `b ≠ home ℓ`
enters once with each sign. -/
theorem transfer_sum_zero (home : Λ → β) (Lift : β → Λ → E) (ε : β → Λ → ℝ) :
    ∑ b, transfer home Lift ε b = 0 := by
  unfold transfer
  rw [sum_comm]
  refine sum_eq_zero fun ℓ _ => ?_
  rw [← add_sum_erase _ _ (mem_univ (home ℓ))]
  simp only [↓reduceIte]
  have : ∑ b ∈ univ.erase (home ℓ),
      (if home ℓ = b then -∑ b' ∈ univ.erase b, ε b' ℓ • Lift b' ℓ else ε b ℓ • Lift b ℓ)
      = ∑ b ∈ univ.erase (home ℓ), ε b ℓ • Lift b ℓ := by
    refine sum_congr rfl fun b hb => ?_
    rw [if_neg (Ne.symm (ne_of_mem_erase hb))]
  rw [this, neg_add_cancel]

/-- **The coarse image of a transferred piece.** Let `V` be linear with `V (Lift b ℓ) = δ_ℓ`
(the indicator of `ℓ`), and suppose `∑_b ε b ℓ = 0` for every `ℓ`. Then
`V (transfer b) = ε b` for every block `b`. -/
theorem transfer_image (home : Λ → β) (Lift : β → Λ → E) (ε : β → Λ → ℝ)
    (V : E →ₗ[ℝ] (Λ → ℝ)) (hV : ∀ b ℓ, V (Lift b ℓ) = Pi.single ℓ 1)
    (hsum : ∀ ℓ, ∑ b, ε b ℓ = 0) (b : β) :
    V (transfer home Lift ε b) = ε b := by
  unfold transfer
  rw [map_sum]
  funext ℓ₀
  rw [Finset.sum_apply]
  have hterm : ∀ ℓ, (V (if home ℓ = b then -∑ b' ∈ univ.erase b, ε b' ℓ • Lift b' ℓ
      else ε b ℓ • Lift b ℓ)) ℓ₀
      = if ℓ = ℓ₀ then (if home ℓ = b then -∑ b' ∈ univ.erase b, ε b' ℓ else ε b ℓ) else 0 := by
    intro ℓ
    by_cases hb : home ℓ = b
    · rw [if_pos hb, if_pos hb, map_neg, map_sum]
      simp only [map_smul, hV, Pi.neg_apply, Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
      by_cases h : ℓ = ℓ₀
      · subst h; simp
      · rw [if_neg h]; simp [Ne.symm h]
    · rw [if_neg hb, if_neg hb, map_smul, hV]
      by_cases h : ℓ = ℓ₀
      · subst h; simp
      · rw [if_neg h]; simp [Ne.symm h]
  simp_rw [hterm]
  rw [sum_ite_eq' univ ℓ₀, if_pos (mem_univ ℓ₀)]
  by_cases hb : home ℓ₀ = b
  · rw [if_pos hb]
    have := hsum ℓ₀
    rw [← add_sum_erase _ _ (mem_univ b)] at this
    linarith
  · rw [if_neg hb]

end Transfer

/-! ## 6. The constant chain of the four-dimensional two-level decomposition -/

section FourD

/-- The four-dimensional two-level constant
`C04D CL κ C_c = 772 + 19136 CL (9/2 κ C_c + 3)`. -/
noncomputable def C04D (CL κ Cc : ℝ) : ℝ := 772 + 19136 * CL * (9 / 2 * κ * Cc + 3)

/-- **The bookkeeping of the four-dimensional two-level decomposition.** Write `X = ‖F‖²` and
let the remaining real numbers stand for:
* `A2 = ‖A‖²` (a primitive of `F`), `F1 = ∑_b ‖F_b⁽¹⁾‖²` (cut-off pieces);
* `c2 = |c|²` (coarse data), `cb = ∑_b |c_b|²` (coarse splitting), `phi = ∑_b |φ_b|²` (coarse
  primitives);
* `V = ∑_b |V⁽ᴹ⁾(χ_b A)|²` (coarse images of the cut-off pieces), `e0`, `e` (defects before and
  after the gradient correction);
* `lam = ∑_b ‖dλ_b‖²` (transfers), `Fb = ∑_b ‖F_b‖²`.

If they satisfy the ten bookkeeping inequalities below, with `h > 0` and non-negative constants,
then `Fb ≤ C04D CL κ C_c · X` (no sign condition on `X` is needed). The factors `h²` and
`1/h²` cancel exactly, so the constant does not depend on the depth. -/
theorem twoLevel4D_bound (h X A2 F1 c2 cb phi V e0 e lam Fb CL κ Cc : ℝ) (hh : 0 < h)
    (hCL : 0 ≤ CL) (hκ : 0 ≤ κ) (hCc : 0 ≤ Cc)
    (hA : A2 ≤ h ^ 2 * X) (hF1 : F1 ≤ 2 * X + 384 / h ^ 2 * A2) (hc : c2 ≤ 9 / 4 * X)
    (hcb : cb ≤ Cc * c2) (hphi : phi ≤ κ * cb) (hV : V ≤ 3 / 2 / h ^ 2 * A2)
    (he0 : e0 ≤ 2 * phi + 2 * V) (he : e ≤ 26 * e0) (hlam : lam ≤ 368 * CL * e)
    (hFb : Fb ≤ 2 * F1 + 2 * lam) :
    Fb ≤ C04D CL κ Cc * X := by
  have hh2 : 0 < h ^ 2 := by positivity
  have k1 : 384 / h ^ 2 * A2 ≤ 384 * X := by
    calc 384 / h ^ 2 * A2 ≤ 384 / h ^ 2 * (h ^ 2 * X) :=
          mul_le_mul_of_nonneg_left hA (by positivity)
      _ = 384 * X := by field_simp
  have k2 : 3 / 2 / h ^ 2 * A2 ≤ 3 / 2 * X := by
    calc 3 / 2 / h ^ 2 * A2 ≤ 3 / 2 / h ^ 2 * (h ^ 2 * X) :=
          mul_le_mul_of_nonneg_left hA (by positivity)
      _ = 3 / 2 * X := by field_simp
  have k3 : cb ≤ Cc * (9 / 4 * X) := le_trans hcb (mul_le_mul_of_nonneg_left hc hCc)
  have k4 : phi ≤ κ * (Cc * (9 / 4 * X)) := le_trans hphi (mul_le_mul_of_nonneg_left k3 hκ)
  have k5 : e0 ≤ (9 / 2 * κ * Cc + 3) * X := by nlinarith
  have k6 : e ≤ 26 * ((9 / 2 * κ * Cc + 3) * X) := by linarith
  have k7 : lam ≤ 368 * CL * (26 * ((9 / 2 * κ * Cc + 3) * X)) :=
    le_trans hlam (mul_le_mul_of_nonneg_left k6 (by positivity))
  unfold C04D
  nlinarith

/-- The dual norm of the two-hat lift profile on `h` points:
`((h−1)(2h−1)/(6h)) / ((h²−1)/12) = 2(2h−1)/(h(h+1))` for `h > 1`. -/
theorem twoHalf_dual_norm (h : ℝ) (hh : 1 < h) :
    (h - 1) * (2 * h - 1) / (6 * h) / ((h ^ 2 - 1) / 12) = 2 * (2 * h - 1) / (h * (h + 1)) := by
  have h0 : 0 < h := by linarith
  have h1 : h - 1 ≠ 0 := by linarith
  have h2 : h + 1 ≠ 0 := by linarith
  have h3 : h ^ 2 - 1 ≠ 0 := by
    have : h ^ 2 - 1 = (h - 1) * (h + 1) := by ring
    rw [this]; exact mul_ne_zero h1 h2
  field_simp
  ring

/-- The squared norm of the transverse bump `g = h w/∑w`, `w(t) = min(t+1, h−t)`, at `h = 2r`:
`(2r)² · (r(r+1)(2r+1)/3) / (r(r+1))² = 4r(2r+1)/(3(r+1))`. -/
theorem bump_norm_sq (r : ℝ) (hr : 0 < r) :
    (2 * r) ^ 2 * (r * (r + 1) * (2 * r + 1) / 3) / (r * (r + 1)) ^ 2
      = 4 * r * (2 * r + 1) / (3 * (r + 1)) := by
  have : r + 1 ≠ 0 := by linarith
  field_simp
  ring

/-- The squared norm of the discrete gradient of the bump (end jumps included), at `h = 2r`:
`(2r)² · 2r / (r(r+1))² = 8r/(r+1)²`. -/
theorem bump_grad_sq (r : ℝ) (hr : 0 < r) :
    (2 * r) ^ 2 * (2 * r) / (r * (r + 1)) ^ 2 = 8 * r / (r + 1) ^ 2 := by
  have : r + 1 ≠ 0 := by linarith
  field_simp
  ring

/-- **The lift energy is bounded uniformly in depth.** At `h = 2r`, `r ≥ 1`,
`3 · 2(2h−1)/(h(h+1)) · 8r/(r+1)² · (4r(2r+1)/(3(r+1)))² ≤ 1024/3`. -/
theorem liftEnergy_le (r : ℝ) (hr : 1 ≤ r) :
    3 * (2 * (2 * (2 * r) - 1) / ((2 * r) * (2 * r + 1))) * (8 * r / (r + 1) ^ 2)
      * (4 * r * (2 * r + 1) / (3 * (r + 1))) ^ 2 ≤ 1024 / 3 := by
  have r0 : 0 < r := by linarith
  have f1 : 2 * (2 * (2 * r) - 1) / ((2 * r) * (2 * r + 1)) ≤ 2 / r := by
    rw [div_le_div_iff₀ (by positivity) r0]; nlinarith
  have f2 : 8 * r / (r + 1) ^ 2 ≤ 8 / r := by
    rw [div_le_div_iff₀ (by positivity) r0]; nlinarith
  have f3 : 4 * r * (2 * r + 1) / (3 * (r + 1)) ≤ 8 * r / 3 := by
    rw [div_le_div_iff₀ (by positivity) (by norm_num)]; nlinarith
  have g1 : 0 ≤ 2 * (2 * (2 * r) - 1) / ((2 * r) * (2 * r + 1)) := by
    apply div_nonneg <;> nlinarith
  have g2 : 0 ≤ 8 * r / (r + 1) ^ 2 := by positivity
  have g3 : 0 ≤ 4 * r * (2 * r + 1) / (3 * (r + 1)) := by positivity
  have s3 : (4 * r * (2 * r + 1) / (3 * (r + 1))) ^ 2 ≤ (8 * r / 3) ^ 2 :=
    pow_le_pow_left₀ g3 f3 2
  calc 3 * (2 * (2 * (2 * r) - 1) / ((2 * r) * (2 * r + 1))) * (8 * r / (r + 1) ^ 2)
        * (4 * r * (2 * r + 1) / (3 * (r + 1))) ^ 2
      ≤ 3 * (2 / r) * (8 / r) * (8 * r / 3) ^ 2 := by
        apply mul_le_mul _ s3 (sq_nonneg _) (by positivity)
        apply mul_le_mul _ f2 g2 (by positivity)
        exact mul_le_mul_of_nonneg_left f1 (by norm_num)
    _ = 1024 / 3 := by field_simp; ring

end FourD

