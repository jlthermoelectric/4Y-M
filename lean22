end BoxLemmaIVCorollaries

/-- **`J ≠ 0` and `Π ≠ 0` for the connected box blocking** (every `M ≥ 1`, every real `β`, every
`V₀`): some nonzero `v ∈ H` satisfies `Π v = v`. -/
theorem boxPi_ne_zero (M : ℕ) [NeZero M] (β : ℝ) (V0 : SU2) :
    ∃ v : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2,
      (isoProj (aeJ (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
        (avgCoarseMap (boxPathBlocking M) (plaqOf (n := 2 * M)) (β / 2) V0
          (hnull_box_pos M)))).P v = v ∧ v ≠ 0 := by
  obtain ⟨g, hg, hne⟩ := boxY_ne_zero_pos M β V0
  set J := aeJ (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
    (avgCoarseMap (boxPathBlocking M) (plaqOf (n := 2 * M)) (β / 2) V0 (hnull_box_pos M))
  refine ⟨J ⟨g, hg⟩, ?_, fun h => hne ?_⟩
  · rw [isoProj_apply, isoAdj_apply_self]
  · have h1 := J.norm_map ⟨g, hg⟩
    rw [h, norm_zero] at h1
    have h0 := norm_eq_zero.1 h1.symm
    exact congrArg Subtype.val h0

/-!
## Lemma IV for everywhere covariant coarse maps: `Π = E_μ[· | σ(c)]` on `H`

**(a) Formal target.** For every everywhere covariant coarse map `c` of Part XIX, in particular
Part IV's two-link blocking `c = blockMap blk` (any finite oriented
lattice, any group `G` with a bi-invariant probability measure, any class function `χ`, every real
`κ`), and for SU(2) straight blocking on `(ℤ/2Mℤ)⁴` (every `M ≥ 1`, every real `β` in the
normalisation of Part VI): the conditional expectation given the coarse field, `E_μ[· | σ(c)]`, is
the coarse projection `Π = J J*` on `H`.

**(b) What is proved.** `map_condExp_eq_Pi`: `cubeProj_comap_eq_Pi` above for the Wilson measure and
any everywhere covariant coarse map of Part XIX. `blocking_condExp_eq_Pi`: the two-link blocking
case (`blockingCoarseMap`, Part IV's `wilsonJ`). `su2_straight_condExp_eq_Pi`,
`su2_straight_condExp_ae_eq_Pi`: SU(2) straight blocking, every `M ≥ 1`, every real `β`, as an
identity of operators on `H` and `μ`-almost everywhere for Mathlib's conditional expectation. Part
XVII proves `E_μ[· | σ(Sk)] = Π` for the skeleton σ-algebra, under two conditions on the
midpoints of the blocking (`wilsonP_skel_eq_Pi`); here the σ-algebra is `σ(c) ⊆ σ(Sk)`, generated by
the blocked field, and no condition on the blocking is needed.

**(c) What remains open.** Nothing here is a gap, split or residual bound; this is an exact
finite-volume identification.

**(d) Checks.** Every headline below depends only on `propext`, `Classical.choice` and
`Quot.sound` (see the `#print` lines at the end of this part).

**(e) Scope.** Not a proof of a mass gap.
-/

section StraightLemmaIV

variable {S E Sc Ec G : Type*} [OrientedGraph S E] [Fintype E] [OrientedGraph Sc Ec]
  [Group G] [MeasurableSpace G] [MeasurableMul₂ G] [MeasurableInv G]
  {Pl : Type*} [Fintype Pl] (plaq : Pl → Plaq S E) (χ : ClassFn G) (κ : ℝ)
  (h : Measure G) [IsProbabilityMeasure h] [IsMulLeftInvariant h] [IsMulRightInvariant h]

/-- **Lemma IV for an everywhere covariant coarse map of the Wilson model** (any finite oriented
lattice, every real `κ`): `E_μ[u | σ(c)] = Π u` for every `u ∈ H`, `Π = J J*`, `J g = g ∘ c`. -/
theorem map_condExp_eq_Pi (c : CoarseMap S E Sc Ec G) (u : wilsonH plaq χ κ h) :
    condL2 (wilsonMeasure plaq χ κ h) c.meas.comap_le (u : Lp ℝ 2 (wilsonMeasure plaq χ κ h)) =
      (((isoProj (mapJ plaq χ κ h c)).P u : wilsonH plaq χ κ h) :
        Lp ℝ 2 (wilsonMeasure plaq χ κ h)) :=
  congrArg Subtype.val (cubeProj_comap_eq_Pi (wilsonMeasure plaq χ κ h) (Gauge S G)
    (mapLaw plaq χ κ h c) (Gauge Sc G) (measurePreserving_mapLaw plaq χ κ h c) c.equiv c.surj u)

/-- **Lemma IV for Part IV's two-link blocking** (any finite oriented lattice, every real `κ`):
`E_μ[u | σ(c)] = Π u` on `H`, with `c = blockMap blk` and `Π = J J*` built from `wilsonJ`. -/
theorem blocking_condExp_eq_Pi (blk : Blocking S E Sc Ec) (u : wilsonH plaq χ κ h) :
    condL2 (wilsonMeasure plaq χ κ h) (measurable_blockMap (G := G) blk).comap_le
        (u : Lp ℝ 2 (wilsonMeasure plaq χ κ h)) =
      (((isoProj (wilsonJ plaq χ κ h blk)).P u : wilsonH plaq χ κ h) :
        Lp ℝ 2 (wilsonMeasure plaq χ κ h)) :=
  map_condExp_eq_Pi plaq χ κ h (blockingCoarseMap blk) u

end StraightLemmaIV

