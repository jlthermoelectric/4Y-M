section Flip

/-- Left multiplication by `−I` on the link `e` only: `(negAt e U) e = −U e`, other links unchanged. -/
noncomputable def negAt {n : ℕ} (e : Link n) (U : Link n → SU2) : Link n → SU2 :=
  fun l => (Function.update (1 : Link n → SU2) e negOne) l * U l

theorem negAt_of_ne {n : ℕ} {e l : Link n} (h : l ≠ e) (U : Link n → SU2) : negAt e U l = U l := by
  simp only [negAt, Function.update_of_ne h, Pi.one_apply, one_mul]

theorem negAt_self {n : ℕ} (e : Link n) (U : Link n → SU2) : negAt e U e = negOne * U e := by
  simp only [negAt, Function.update_self]

/-- `negAt e` preserves the product Haar measure. -/
theorem measurePreserving_negAt {n : ℕ} [NeZero n] (e : Link n) :
    MeasurePreserving (negAt e) (Measure.pi fun _ : Link n => haarSU2)
      (Measure.pi fun _ : Link n => haarSU2) :=
  measurePreserving_pi (fun _ => haarSU2) (fun _ => haarSU2)
    (f := fun l u => (Function.update (1 : Link n → SU2) e negOne) l * u)
    fun _ => measurePreserving_mul_left haarSU2 _

/-- `Re tr (−A) = −Re tr A`. -/
theorem reTr_negOne_mul (A : SU2) : reTr.toFun (negOne * A) = -reTr.toFun A := by
  show (((-1 : Matrix (Fin 2) (Fin 2) ℂ) * A.1).trace).re = -((A.1).trace).re
  rw [neg_one_mul, Matrix.trace_neg, Complex.neg_re]

variable (M : ℕ) [NeZero M]

/-- Flipping the non-skeleton link `(e₀, 1)` by `−I` flips the sign of `Re tr U_p` at `q0`. -/
theorem plaqObs_negAt (U : Link (2 * M) → SU2) :
    plaqObs (2 * M) (negAt (plaqOf (q0 (2 * M))).l2 U) = -plaqObs (2 * M) U := by
  rw [plaqObs, plaqObs, hol, hol, negAt_of_ne (q0_l1_ne_l2 M), negAt_self,
    negAt_of_ne (q0_l3_ne_l2 M), negAt_of_ne (q0_l4_ne_l2 M), ← reTr_negOne_mul]
  congr 1
  apply Subtype.ext
  have hn : ((negOne : SU2) : Matrix (Fin 2) (Fin 2) ℂ) = -1 := rfl
  simp only [coe_mul, coe_inv, hn, neg_one_mul, Matrix.mul_neg, Matrix.neg_mul]

end Flip

section KerPi

variable (M : ℕ) [NeZero M] (β : ℝ)

/-- The centred plaquette observable `F − μ(F)`, `F = Re tr U_p` at `q0`, as an element of `H`
(SU(2) Wilson measure `μ ∝ exp((β/2) ∑ₚ Re tr U_p) ∏ dU` on `(ℤ/2Mℤ)⁴`). -/
noncomputable def plaqH : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 :=
  ⟨(memLp_plaqObs (2 * M) (su2Wilson M β)).toLp (plaqObs (2 * M)) -
      (∫ U, plaqObs (2 * M) U ∂(su2Wilson M β)) • one2 (su2Wilson M β),
    centred_mem_cgL2 (su2Wilson M β) (Gauge (Site (2 * M)) SU2)
      (memLp_plaqObs (2 * M) (su2Wilson M β)) (plaqObs_smul _)⟩

theorem coeFn_plaqH :
    (((plaqH M β : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2) :
        Lp ℝ 2 (su2Wilson M β)) : (Link (2 * M) → SU2) → ℝ) =ᵐ[su2Wilson M β]
      fun U => plaqObs (2 * M) U - ∫ U, plaqObs (2 * M) U ∂(su2Wilson M β) := by
  have hF := memLp_plaqObs (2 * M) (su2Wilson M β)
  filter_upwards [Lp.coeFn_sub (hF.toLp (plaqObs (2 * M)))
      ((∫ U, plaqObs (2 * M) U ∂(su2Wilson M β)) • one2 (su2Wilson M β)),
    Lp.coeFn_smul (∫ U, plaqObs (2 * M) U ∂(su2Wilson M β)) (one2 (su2Wilson M β)),
    coeFn_one2 (su2Wilson M β), hF.coeFn_toLp] with U h1 h2 h3 h4
  show (⇑(hF.toLp (plaqObs (2 * M)) -
      (∫ U, plaqObs (2 * M) U ∂(su2Wilson M β)) • one2 (su2Wilson M β))) U = _
  rw [h1, Pi.sub_apply, h2, Pi.smul_apply, h3, h4, smul_eq_mul, mul_one]

/-- **`F − μ(F)` is not skeleton-measurable**: `Π (F − μ(F)) ≠ F − μ(F)` (every `M ≥ 1`, every
real `β`). By Lemma IV, `Π = E_μ[· | σ(Sk)]` on `H`; a skeleton-measurable version `g` would be
unchanged by flipping the non-skeleton link `(e₀, 1)` by `−I`, which preserves the product Haar
measure and flips the sign of `F`; so `F = 0` almost everywhere for the product Haar measure
(absolutely continuous with respect to `μ`), against continuity and `F(I) = 2`. -/
theorem su2Pi_plaqH_ne : (su2Pi M β).P (plaqH M β) ≠ plaqH M β := by
  intro hfix
  rw [← su2_skel_eq_Pi M β] at hfix
  have hmem : ((plaqH M β : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2) :
      Lp ℝ 2 (su2Wilson M β)) ∈
      lpMeas ℝ ℝ (extSigma (G := SU2) (skel (straightBlocking M))ᶜ) 2 (su2Wilson M β) := by
    rw [← hfix]
    exact condL2_mem _ (extSigma_le _) _
  rw [mem_lpMeas_iff_aestronglyMeasurable] at hmem
  obtain ⟨g, hg, hfg⟩ := hmem
  have hae : ∀ᵐ U ∂(su2Wilson M β),
      plaqObs (2 * M) U - ∫ U, plaqObs (2 * M) U ∂(su2Wilson M β) = g U :=
    (coeFn_plaqH M β).symm.trans hfg
  have hae1 := (absolutelyContinuous_tilted
    (integrable_exp_wilsonExp (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2)).ae_le hae
  have hae2 := (measurePreserving_negAt (plaqOf (q0 (2 * M))).l2).quasiMeasurePreserving.tendsto_ae.eventually
    hae1
  have hgS : Measurable[extSigma (G := SU2) (skel (straightBlocking M))ᶜ] g := hg.measurable
  have hg' : ∀ U, g (negAt (plaqOf (q0 (2 * M))).l2 U) = g U := fun U =>
    eq_of_extSigma_measurable hgS fun e he => by
      have he' : e ∈ skel (straightBlocking M) := not_not.1 he
      exact negAt_of_ne (fun h => q0_l2_not_mem_skel M (by rw [← h]; exact he')) U
  have h0 : ∀ᵐ U ∂(Measure.pi fun _ : Link (2 * M) => haarSU2), plaqObs (2 * M) U = 0 := by
    filter_upwards [hae1, hae2] with U h1 h2
    rw [hg', plaqObs_negAt] at h2
    linarith
  refine not_ae_const_pi (continuous_plaqObs (2 * M)) (U₁ := 1) (U₂ := flipU (2 * M)) ?_ 0 h0
  rw [plaqObs_one, plaqObs_flipU]
  norm_num

/-- The fibre vector `u = F̃ − Π F̃`, `F̃ = F − μ(F)`. -/
noncomputable def kerVec : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 :=
  plaqH M β - (su2Pi M β).P (plaqH M β)

theorem su2Pi_kerVec : (su2Pi M β).P (kerVec M β) = 0 :=
  ((su2Pi M β).P.map_sub _ _).trans (by rw [(su2Pi M β).idem, sub_self])

theorem kerVec_ne_zero : kerVec M β ≠ 0 := fun h =>
  su2Pi_plaqH_ne M β (sub_eq_zero.1 h).symm

/-- **`ker Π ≠ 0`** for SU(2) on `(ℤ/2Mℤ)⁴` with straight blocking, every `M ≥ 1`, every real
`β` (`μ ∝ exp((β/2) ∑ₚ Re tr U_p) ∏ dU`): some `u ∈ H` has `Π u = 0` and `u ≠ 0`. -/
theorem su2_kerPi_ne_zero :
    ∃ u : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2, (su2Pi M β).P u = 0 ∧ u ≠ 0 :=
  ⟨kerVec M β, su2Pi_kerVec M β, kerVec_ne_zero M β⟩

end KerPi

section CoarseOne

/-- The matrix `diag(i, −i)`. -/
def quatIMat : Matrix (Fin 2) (Fin 2) ℂ := !![Complex.I, 0; 0, -Complex.I]

/-- The matrix `[[0, 1], [−1, 0]]`. -/
def quatJMat : Matrix (Fin 2) (Fin 2) ℂ := !![0, 1; -1, 0]

theorem star_quatIMat : star quatIMat = !![-Complex.I, 0; 0, Complex.I] := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [quatIMat, Matrix.star_apply]

theorem star_quatJMat : star quatJMat = !![0, -1; 1, 0] := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [quatJMat, Matrix.star_apply]

/-- `diag(i, −i) ∈ SU(2)`. -/
def quatI : SU2 := ⟨quatIMat, by
  rw [Matrix.mem_specialUnitaryGroup_iff, Matrix.mem_unitaryGroup_iff, star_quatIMat]
  refine ⟨?_, ?_⟩
  · rw [quatIMat, Matrix.mul_fin_two, Matrix.one_fin_two]
    simp
  · rw [quatIMat, Matrix.det_fin_two_of]
    simp⟩

/-- `[[0, 1], [−1, 0]] ∈ SU(2)`. -/
def quatJ : SU2 := ⟨quatJMat, by
  rw [Matrix.mem_specialUnitaryGroup_iff, Matrix.mem_unitaryGroup_iff, star_quatJMat]
  refine ⟨?_, ?_⟩
  · rw [quatJMat, Matrix.mul_fin_two, Matrix.one_fin_two]
    simp
  · rw [quatJMat, Matrix.det_fin_two_of]
    simp⟩

/-- The commutator of `diag(i, −i)` and `[[0, 1], [−1, 0]]` has `Re tr = −2` (it is `−I`). -/
theorem reTr_quat_comm : reTr.toFun (quatI * quatJ * quatI⁻¹ * quatJ⁻¹) = -2 := by
  show ((quatIMat * quatJMat * star quatIMat * star quatJMat).trace).re = -2
  rw [star_quatIMat, star_quatJMat, quatIMat, quatJMat, Matrix.mul_fin_two, Matrix.mul_fin_two,
    Matrix.mul_fin_two, Matrix.trace_fin_two_of]
  simp
  norm_num

/-- The fine configuration on `(ℤ/2ℤ)⁴`: `diag(i, −i)` on the link `a(0, 0)`, `[[0, 1], [−1, 0]]` on
`a(0, 1)`, `I` on every other link. -/
noncomputable def quatConf : Link (2 * 1) → SU2 :=
  Function.update (Function.update 1 ((straightBlocking 1).a (0, 0)) quatI)
    ((straightBlocking 1).a (0, 1)) quatJ

theorem a00_ne_a01 : (straightBlocking 1).a (0, 0) ≠ (straightBlocking 1).a (0, 1) := fun h => by
  have := congrArg Prod.snd h
  simp [straightBlocking] at this

theorem b00_ne_a01 : (straightBlocking 1).b (0, 0) ≠ (straightBlocking 1).a (0, 1) := fun h => by
  have := congrArg Prod.snd h
  simp [straightBlocking] at this

theorem b01_ne_a00 : (straightBlocking 1).b (0, 1) ≠ (straightBlocking 1).a (0, 0) := fun h => by
  have := congrArg Prod.snd h
  simp [straightBlocking] at this

theorem b00_ne_a00 : (straightBlocking 1).b (0, 0) ≠ (straightBlocking 1).a (0, 0) := fun h => by
  have := congrArg (fun l : Link (2 * 1) => l.1 0) h
  simp [straightBlocking, unitV] at this

theorem b01_ne_a01 : (straightBlocking 1).b (0, 1) ≠ (straightBlocking 1).a (0, 1) := fun h => by
  have := congrArg (fun l : Link (2 * 1) => l.1 1) h
  simp [straightBlocking, unitV] at this

theorem blockQuat_00 : blockMap (straightBlocking 1) quatConf ((0 : Site 1), 0) = quatI := by
  show quatConf ((straightBlocking 1).a (0, 0)) * quatConf ((straightBlocking 1).b (0, 0)) = quatI
  simp only [quatConf, Function.update_of_ne a00_ne_a01, Function.update_of_ne b00_ne_a01,
    Function.update_of_ne b00_ne_a00, Function.update_self, Pi.one_apply, mul_one]

theorem blockQuat_01 : blockMap (straightBlocking 1) quatConf ((0 : Site 1), 1) = quatJ := by
  show quatConf ((straightBlocking 1).a (0, 1)) * quatConf ((straightBlocking 1).b (0, 1)) = quatJ
  simp only [quatConf, Function.update_of_ne b01_ne_a01, Function.update_of_ne b01_ne_a00,
    Function.update_self, Pi.one_apply, mul_one]

/-- `(ℤ/1ℤ)⁴` has a single site. -/
theorem site_one_eq (y z : Site 1) : y = z :=
  funext fun _ => @Subsingleton.elim _ (ZMod.subsingleton_iff.2 rfl) _ _

/-- On `(ℤ/1ℤ)⁴` (one site) the plaquette `q0` is the loop `(0, 0) (0, 1) (0, 0)⁻¹ (0, 1)⁻¹`. -/
theorem q0_one_l2 : (plaqOf (q0 1)).l2 = ((0 : Site 1), (1 : Fin 4)) :=
  Prod.ext (site_one_eq _ _) rfl

theorem q0_one_l3 : (plaqOf (q0 1)).l3 = ((0 : Site 1), (0 : Fin 4)) :=
  Prod.ext (site_one_eq _ _) rfl

/-- The blocked configuration on the coarse plaquette `q0` of `(ℤ/1ℤ)⁴` has `Re tr = −2`. -/
theorem plaqObs_blockQuat : plaqObs 1 (blockMap (straightBlocking 1) quatConf) = -2 := by
  rw [plaqObs, hol, q0_one_l2, q0_one_l3]
  rw [show (plaqOf (q0 1)).l1 = ((0 : Site 1), (0 : Fin 4)) from rfl,
    show (plaqOf (q0 1)).l4 = ((0 : Site 1), (1 : Fin 4)) from rfl, blockQuat_00, blockQuat_01]
  exact reTr_quat_comm

/-- **Non-vacuity of `Y` at `M = 1`** (every real `β`, straight blocking `(ℤ/2ℤ)⁴ → (ℤ/1ℤ)⁴`): the
coarse space contains the nonzero centred observable `G − μ_c(G)`, `G = Re tr V_p` on the single
coarse plaquette `q0` (the commutator of the coarse links `(0, 0)` and `(0, 1)`). At `M = 1` the
coarse link `U(0, μ) U(e_μ, μ)` is the holonomy of a loop winding once around the fine torus in
direction `μ`, so `G` is the trace of a commutator of two winding holonomies, not a local
plaquette variable (a degenerate case). -/
theorem coarseY_ne_zero_one (β : ℝ) :
    ∃ g ∈ coarseY (plaqOf (n := 2 * 1)) reTr (β / 2) haarSU2 (straightBlocking 1), g ≠ 0 := by
  have hG := memLp_plaqObs 1 (coarseLaw (plaqOf (n := 2 * 1)) reTr (β / 2) haarSU2
    (straightBlocking 1))
  refine ⟨_, centred_mem_cgL2 _ (Gauge (Site 1) SU2) hG (plaqObs_smul 1), fun h0 => ?_⟩
  have hae := ae_eq_const_of_centred_eq_zero _ hG h0
  have hae1 := (ae_map_iff (measurable_blockMap (G := SU2) (straightBlocking 1)).aemeasurable
    (measurableSet_eq_fun (measurable_plaqObs 1) measurable_const)).1 hae
  have hae2 := (absolutelyContinuous_tilted
    (integrable_exp_wilsonExp (plaqOf (n := 2 * 1)) reTr (β / 2) haarSU2)).ae_le hae1
  refine not_ae_const_pi ((continuous_plaqObs 1).comp (continuous_blockMap (straightBlocking 1)))
    (U₁ := 1) (U₂ := quatConf) ?_ _ hae2
  show plaqObs 1 (blockMap (straightBlocking 1) 1) ≠
    plaqObs 1 (blockMap (straightBlocking 1) quatConf)
  rw [blockMap_one, plaqObs_one, plaqObs_blockQuat]
  norm_num

/-- **`Y ≠ 0` for every `M ≥ 1`** (every real `β`, straight blocking): Part VI's
`coarseY_ne_zero` (`M ≥ 2`) and `coarseY_ne_zero_one` (`M = 1`). -/
theorem su2_coarseY_ne_zero (M : ℕ) [NeZero M] (β : ℝ) :
    ∃ g ∈ coarseY (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (straightBlocking M), g ≠ 0 := by
  rcases Nat.lt_or_ge M 2 with hM | hM
  · obtain rfl : M = 1 := by have := NeZero.ne M; omega
    exact coarseY_ne_zero_one β
  · exact coarseY_ne_zero M β hM

end CoarseOne

section Consequences

variable (M : ℕ) [NeZero M] (β : ℝ)

/-- The same vector in the form used by Part XXI's `SU2HeatBathInfluence`: `E_μ[u | σ(Sk)] = 0`,
`u ≠ 0` (every `M ≥ 1`, every real `β`; Lemma IV). -/
theorem su2_skelKer_ne_zero :
    ∃ u : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2,
      su2P M β (skel (straightBlocking M))ᶜ u = 0 ∧ u ≠ 0 :=
  ⟨kerVec M β, (su2_skel_eq_Pi M β _).trans (su2Pi_kerVec M β), kerVec_ne_zero M β⟩

/-- `H_f = ker Π` is not the zero subspace, and `Π ≠ I` on `H` (every `M ≥ 1`, every real `β`). -/
theorem su2_Hf_ne_bot : (su2Pi M β).Hf ≠ ⊥ ∧ (su2Pi M β).P ≠ LinearMap.id := by
  refine ⟨fun h => kerVec_ne_zero M β ?_, fun h => kerVec_ne_zero M β ?_⟩
  · have hm : kerVec M β ∈ (su2Pi M β).Hf := (su2Pi M β).mem_Hf.2 (su2Pi_kerVec M β)
    rw [h] at hm
    exact (Submodule.mem_bot ℝ).1 hm
  · have h0 := su2Pi_kerVec M β
    rw [h, LinearMap.id_apply] at h0
    exact h0

/-- **Non-vacuity of bounds on `ker Π`.** If `λ > 0` and `λ ‖u‖² ≤ Q u` for every `u ∈ H` with
`Π u = 0`, then `Q u > 0` for some nonzero `u` with `Π u = 0` (every `M ≥ 1`, every real `β`). So
each such bound (Part X's `hcons` and `hFibre`, Part XII's `hcons_of_sweeps`, Part XVII's
`su2_hcons_zero_half`, Part XXI's `su2_hcons_of_influence`) is a statement about a nonzero space.
This does not show that any such bound holds at `β ≠ 0`. -/
theorem exists_pos_of_ker_bound {Q : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 → ℝ}
    {lam : ℝ} (hlam : 0 < lam)
    (hQ : ∀ u, (su2Pi M β).P u = 0 → lam * ‖u‖ ^ 2 ≤ Q u) :
    ∃ u, (su2Pi M β).P u = 0 ∧ u ≠ 0 ∧ 0 < lam * ‖u‖ ^ 2 ∧ lam * ‖u‖ ^ 2 ≤ Q u := by
  refine ⟨kerVec M β, su2Pi_kerVec M β, kerVec_ne_zero M β, ?_, hQ _ (su2Pi_kerVec M β)⟩
  have := norm_pos_iff.2 (kerVec_ne_zero M β)
  positivity

/-- **Part XVII's `su2_hcons_zero_half` applies to a nonzero vector** (`β = 0`, every `M ≥ 1`,
side-2 cubes at every base point, weights `1/16`): some `u ≠ 0` with `Π u = 0` has
`0 < (1/2) ‖u‖² ≤ ∑ₓ (1/16) ‖u − P_{cube2 M x ∖ Sk} u‖²`. -/
theorem su2_hcons_zero_half_nonvacuous :
    ∃ u : wilsonH (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2,
      (su2Pi M 0).P u = 0 ∧ u ≠ 0 ∧ 0 < (1 / 2 : ℝ) * ‖u‖ ^ 2 ∧
      (1 / 2 : ℝ) * ‖u‖ ^ 2 ≤
        ∑ x, (1 / 16 : ℝ) * ‖u - su2P M 0 (cube2 M x \ skel (straightBlocking M)) u‖ ^ 2 :=
  exists_pos_of_ker_bound M 0 (by norm_num) (SkeletonCondExp.su2_hcons_zero_half M)

/-- **At `β = 0` the constrained sweep annihilates a nonzero vector of `ker Π`** (every `M ≥ 1`,
any list containing every base point): Part XVII's `su2_constrained_sweep_zero` is not vacuous on
`ker Π`. -/
theorem su2_constrained_sweep_zero_nonvacuous (l : List (Site (2 * M))) (hl : ∀ x, x ∈ l) :
    ∃ u : wilsonH (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2, (su2Pi M 0).P u = 0 ∧ u ≠ 0 ∧
      ConstrainedFibre.sweepProd (fun x => wilsonPj (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2)
        haarSU2 (cube2 M x \ skel (straightBlocking M))) l u = 0 :=
  ⟨kerVec M 0, su2Pi_kerVec M 0, kerVec_ne_zero M 0,
    (su2_constrained_sweep_zero M l hl _).trans (su2Pi_kerVec M 0)⟩

variable {M}

/-- **Part XXI's conclusion under its named hypothesis is not vacuous** (every `M ≥ 1`, every real
`β`, `0 ≤ θ < 1`): if `SU2HeatBathInfluence M β θ` holds, some `u ≠ 0` with `Π u = 0` has
`0 < (1/2)(1 − θ)² ‖u‖² ≤ ∑ₓ (1/16) ‖u − P_{cube2 M x ∖ Sk} u‖²`, and every parity sweep
strictly shortens it: `‖∏ P u‖ < ‖u‖` (from `‖∏ P u‖ ≤ θ ‖u‖`, Part XXI).
At `β = 0` the hypothesis holds with `θ = 0`
(`su2_influence_zero`). For `β ≠ 0` the statement is conditional: it does not show that the
hypothesis holds there. -/
theorem su2_influence_nonvacuous {θ : ℝ} (I : SweepContraction.SU2HeatBathInfluence M β θ)
    (hθ0 : 0 ≤ θ) (hθ1 : θ < 1) :
    ∃ u : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2, (su2Pi M β).P u = 0 ∧ u ≠ 0 ∧
      0 < ((1 / 2 : ℝ) * (1 - θ) ^ 2) * ‖u‖ ^ 2 ∧
      ((1 / 2 : ℝ) * (1 - θ) ^ 2) * ‖u‖ ^ 2 ≤
        ∑ x, (1 / 16 : ℝ) * ‖u - su2P M β (cube2 M x \ skel (straightBlocking M)) u‖ ^ 2 ∧
      ∀ j : Fin 3 → ZMod 2,
        ‖ConstrainedFibre.sweepProd (fun x => wilsonPj (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
          (cube2 M x \ skel (straightBlocking M))) (parFamily M j) u‖ < ‖u‖ := by
  have hpos : (0 : ℝ) < (1 / 2 : ℝ) * (1 - θ) ^ 2 := by
    have : (0 : ℝ) < 1 - θ := by linarith
    positivity
  obtain ⟨u, hu, hu0, h1, h2⟩ := exists_pos_of_ker_bound M β hpos
    (SweepContraction.su2_hcons_of_influence I hθ0 hθ1.le)
  refine ⟨u, hu, hu0, h1, h2, fun j => ?_⟩
  have hn := norm_pos_iff.2 hu0
  calc _ ≤ θ * ‖u‖ := SweepContraction.su2_hsweep_of_influence I hθ0 hθ1.le j u hu
    _ < 1 * ‖u‖ := mul_lt_mul_of_pos_right hθ1 hn
    _ = ‖u‖ := one_mul _

/-- **Part X's `hFibre` from Part XXI is not vacuous** (every `M ≥ 1`, every real `β`,
`0 ≤ θ < 1`): under `SU2HeatBathInfluence M β θ`, some `u ≠ 0` with `Π u = 0` has
`0 < (1/2)(1 − θ)² ‖u‖² ≤ ⟪u, D u⟫`, `D = ∑ₓ (1/16)(I − P_{cube2 M x})`, the heat-bath cube
generator in finite volume (not a transfer matrix). For `β ≠ 0` this is conditional on the
hypothesis. -/
theorem su2_hFibre_of_influence_nonvacuous {θ : ℝ}
    (I : SweepContraction.SU2HeatBathInfluence M β θ) (hθ0 : 0 ≤ θ) (hθ1 : θ < 1) :
    ∃ u : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2, (su2Pi M β).P u = 0 ∧ u ≠ 0 ∧
      0 < ((1 / 2 : ℝ) * (1 - θ) ^ 2) * ‖u‖ ^ 2 ∧
      ((1 / 2 : ℝ) * (1 - θ) ^ 2) * ‖u‖ ^ 2 ≤
        ⟪u, cubeGen (fun _ => (1 / 16 : ℝ)) (fun x => su2P M β (cube2 M x)) u⟫_ℝ := by
  have hpos : (0 : ℝ) < (1 / 2 : ℝ) * (1 - θ) ^ 2 := by
    have : (0 : ℝ) < 1 - θ := by linarith
    positivity
  exact exists_pos_of_ker_bound M β hpos (SweepContraction.su2_hFibre_of_influence I hθ0 hθ1.le)

variable (M)

/-- **Both subspaces of the split are nonzero** (every `M ≥ 1`, every real `β`): `ker Π` and
`ran Π` both contain nonzero vectors of `H` (`ran Π` from `su2_coarseY_ne_zero`, `J` being an
isometry). This concerns the subspaces only; the mixed block of the generator is not shown to be
nonzero at any `β ≠ 0`. -/
theorem su2_split_nontrivial :
    (∃ u : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2, (su2Pi M β).P u = 0 ∧ u ≠ 0) ∧
      ∃ v : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2, (su2Pi M β).P v = v ∧ v ≠ 0 := by
  refine ⟨su2_kerPi_ne_zero M β, ?_⟩
  obtain ⟨g, hg, hg0⟩ := su2_coarseY_ne_zero M β
  refine ⟨su2J M β ⟨g, hg⟩, ?_, fun h0 => hg0 ?_⟩
  · rw [isoProj_apply, isoAdj_apply_self]
  · have hn := (su2J M β).norm_map ⟨g, hg⟩
    rw [h0, norm_zero] at hn
    have h1 : (⟨g, hg⟩ : coarseY (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
        (straightBlocking M)) = 0 := norm_eq_zero.1 hn.symm
    exact congrArg Subtype.val h1

end Consequences

end YangMills.StrongCoupling.FibreNonVacuity

/-! # Part XXVIII. `YangMills.StrongCoupling.BoxBlockingInputs`: for the connected box blocking, `hWilson` at `M = 1`, `Y ≠ 0` and `Π = E_μ[· | σ(c)]` on `H` for every `M ≥ 1`, and the same identity for straight blocking (new; uses Parts II–IV, VI, XV, XIX and XXIII) -/

/-!
# The connected box blocking beyond `hWilson`: every `M ≥ 1`, `Y ≠ 0` and Lemma IV

## (a) Formal target

Part XXIII of this file proves `hWilson` (the fields of `CubeSplit.CubeSplitInputs`) for the
connected box path blocking `boxPathBlocking M` of SU(2), `(ℤ/2Mℤ)⁴ → (ℤ/Mℤ)⁴`, 16 paths per coarse
link with equal weights `1/16`, for `M ≥ 2`, through private links. Here: (1) the same at `M = 1`
(fine torus `(ℤ/2ℤ)⁴`, a single coarse site), hence for every `M ≥ 1`; (2) the coarse space `Y` of
the box path average `c(U)(ē) = Q_ē(U)/√det Q_ē(U)` (value `V₀` where `Q_ē(U) = 0`) is not zero, for
every `M ≥ 1`, every real `β` (in the normalisation of Part VI, `κ = β/2`) and every `V₀`; (3) the
analogue of Part XVII's Lemma IV for this map, `E_μ[· | σ(c)] = Π` on `H`.

## (b) What is proved

* `modOff`, `ofOff_eq_iff_modOff`, `count_map_modOff`: link counts on `(ℤ/nℤ)⁴`, every `n`, through
  the reduction of integer offsets modulo `n`. `SepOff`, `notMem_map_of_sep`: a decidable condition
  on integer offsets that excludes a link from a translated walk on every torus with `n ≥ 4`.
* `jOf`, `boxSteps_jOf`, `pathProd_boxPath_jOf`: the box path `ε = e_μ` of the coarse link `(y, μ)`
  is the straight path `ε = 0` followed by a backtrack along `μ`, so the two have the same holonomy
  (every `M`, every group).
* `box_once_one`, `box_out_one` (plain `decide` on offsets modulo `2`), `box_hasPrivateLink_one`: at
  `M = 1` the fine link `(2y + e_μ, μ)` is a private link of `(y, μ)` with `i₀` the straight path
  and `s = {0, 2^μ}` (the paths `ε = 0` and `ε = e_μ`). `box_hasPrivateLink_pos`, `hnull_box_pos`,
  `su2_inputs_box_pos`: private links, the null-set hypothesis and every field of
  `CubeSplitInputs` for the box blocking, every `M ≥ 1`, every real `β`, every `V₀`, arbitrary fine
  and coarse link sets and weights.
* `pathProd_const_one`, `continuousOn_avgMap_apply`, `isOpen_nzSet`, `qsum_eq_one`,
  `avgMap_eq_one_of_qsum`, `not_ae_const_pi_on`: the normalised path average is continuous on the
  open set where `Q_ē ≠ 0` (it is not continuous across the zero set); a function that is continuous
  on an open set and takes two values there is not almost everywhere constant for the product Haar
  measure.
* `gBox`, `qBox`, `qnorm_qBox`, `reTr_nrm_qBox_ne`, `fBox`, `UBox`, `box_sep_plaq` (plain
  `decide`), `qsum_l1`, `qsum_other`: the configuration `UBox` (the right-angle rotation `g` on the
  fine link `(e₀, 0)`, `I` elsewhere) has `Q = (1/16)(2g + 14 I)` on the coarse link `(0, 0)` (the
  fine link lies on the box paths `ε = 0` and `ε = e₀` of that link only) and `Q = I` on the other
  three links of the coarse plaquette at the origin in the `(0, 1)` plane; and
  `Re tr (Q/√det Q) = (7/4)/√(25/32) ≠ 2`.
* `stable_comap`, `cubeProj_comap_eq_Pi`: for a measure-preserving coarse map `c` that is gauge
  covariant everywhere (`c (γ • ω) = φ γ • c ω`, `φ` surjective), `σ(c)` is gauge stable and
  `E_μ[· | σ(c)] = Π = J J*` on the centred invariant space (Lemma IV for such maps, through Part XV's
  Doob–Dynkin step `exists_coarseJ_eq`). `qsum_smul_eq_zero_iff`, `avgMapC`, `avgMapC_smul`,
  `avgMapC_eq_of_notMem`, `measurable_avgMapC`, `avgCoarseMapC`: the covariant completion `c'` of the
  normalised path average (the holonomy of a fixed path `i₀` where `Q_ē = 0`) is an everywhere
  covariant coarse map and equals the path average off the zero set. `avgMapC_box_ae`,
  `box_condExpC_eq_Pi`: for the box blocking (every `M ≥ 1`, every real `β`, every `V₀`, `i₀` the
  straight path) `c' = c` `μ`-almost everywhere, and `E_μ[· | σ(c')] = Π' = J' J'*` on `H`, with
  `J' g = g ∘ c'` on the coarse space of the law `c'_* μ`.
* `coarseJae_eq_coarseJ_of_ae`, `lpMeas_comap_eq`, `box_condExp_eq_Pi`, `box_condExp_ae_eq_Pi`,
  `box_condExp_eq_zero_iff`: **Lemma IV for the box map itself** (every `M ≥ 1`, every real `β`,
  every `V₀`). Since `c' = c` almost everywhere, Part XIX's `J` for `c` (`aeJ`) equals the embedding
  built from `c'` over the same blocked law, and `σ(c)`, `σ(c')` have the same `L²` functions; hence
  `E_μ[u | σ(c)] = Π u` for every `u ∈ H` (also `μ`-a.e. for Mathlib's conditional expectation), and
  `E_μ[u | σ(c)] = 0 ↔ Π u = 0`.
* `boxY_ne_zero` (`M ≥ 2`; the centred coarse plaquette observable `Re tr V_p`),
  `boxY_ne_zero_one` (`M = 1`; `Re tr V_{(0, 0)}`, the coarse link being a closed loop that winds
  once around the fine torus `(ℤ/2ℤ)⁴`),
  `boxY_ne_zero_pos` (every `M ≥ 1`), `boxPi_ne_zero`: the coarse space `Y` contains a nonzero
  vector, so `J ≠ 0` and some nonzero `v ∈ H` has `Π v = v`, for every real `β` and every `V₀`.
* `map_condExp_eq_Pi`, `blocking_condExp_eq_Pi`, `su2_straight_condExp_eq_Pi`,
  `su2_straight_condExp_ae_eq_Pi`: the same identity `E_μ[· | σ(c)] = Π` on `H` for every
  everywhere covariant coarse map of Part XIX, for Part IV's two-link blockings (any finite
  oriented lattice, every real `κ`) and for SU(2) straight blocking (every `M ≥ 1`, every real
  `β`); Part XVII's Lemma IV concerns the skeleton σ-algebra `σ(Sk) ⊇ σ(c)` instead.

## (c) What remains open

`hFibre`, `hResidual` and `hCoarseGap` are not touched for this blocking: nothing here is a gap, a
split or a residual bound. Lemma IV here is an identification (an exact identity of operators in
finite volume), not an estimate. That `ker Π ≠ 0` and that the mixed block is nonzero are not shown
for this blocking. Unlike Part XVII's straight blocking, where `Π` is the conditional expectation
given a set of fine links (the skeleton), here `σ(c)` is generated by the nonlinear block
averages themselves, so the constrained cube projections of Parts X and XVII do not carry over
directly to this blocking, even at `β = 0`. The analytic inputs at `β ≠ 0` for this blocking
(influence or sweep bounds as in Parts XXI and XXII of this file) are not addressed. The items that
Part XXIII of this file lists as open for this blocking (`M = 1`, `Y ≠ 0` and `Π = E_μ[· | σ(c)]`
on `H`) are proved here.

## (d) Axioms and checks

The module axiom audit covers every headline: each depends only on `propext`, `Classical.choice`
and `Quot.sound`, and the source contains no `sorry`, `admit`, `axiom` declarations,
`native_decide`, `implemented_by` or `set_option`. The finite statements are closed by plain
`decide` on lists of integer offsets.

## (e) Scope

This is not a proof of a mass gap. It extends the finite-volume identification step `hWilson` for
the connected box blocking of SU(2) lattice gauge theory to `M = 1`, shows that the coarse space of
this blocking is not zero (non-vacuity) and identifies `Π` with the conditional expectation given the
coarse field (Lemma IV, an exact finite-volume identity); it proves no gap, no split and nothing about
a continuum limit for this blocking. Physically, Lemma IV says that the conditional expectation of a
gauge-invariant fine observable at fixed blocked field is a coarse-gauge-invariant function of the
blocked field; it says nothing about locality of the blocked law or an effective action. At `M = 1`
the coarse torus `(ℤ/1ℤ)⁴` is a single site and each coarse link is a smeared holonomy of loops
winding once around the fine torus `(ℤ/2ℤ)⁴`, a degenerate case covered for completeness. `β` is
the Wilson coupling `β_W = 4/g²` of Part VI.
-/

