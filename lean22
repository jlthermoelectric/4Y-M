section Holonomy

variable {S E : Type*} [OrientedGraph S E] {G : Type*} [Group G]

/-- The holonomy of any path in the trivial configuration is `1`. -/
theorem pathProd_const_one {x y : S} (p : FPath S E x y) : pathProd p (1 : E → G) = 1 := by
  induction p with
  | nil x => rfl
  | fwd e p ih => simp only [pathProd, ih, Pi.one_apply, one_mul]
  | bwd e p ih => simp only [pathProd, ih, Pi.one_apply, inv_one, one_mul]

