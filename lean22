section Factor

variable {E G : Type*} [MeasurableSpace G]

/-- The exterior σ-algebra of `V` is contained in the σ-algebra of the restriction to `Vᶜ`. -/
theorem extSigma_le_comap_restrict (V : Set E) :
    extSigma (G := G) V ≤
      MeasurableSpace.comap (fun U : E → G => fun e : (Vᶜ : Set E) => U e) MeasurableSpace.pi := by
  refine iSup₂_le fun e he => ?_
  have hc : (fun U : E → G => U e) =
      (fun W : (Vᶜ : Set E) → G => W ⟨e, he⟩) ∘ (fun U : E → G => fun e : (Vᶜ : Set E) => U e) :=
    rfl
  rw [hc, ← MeasurableSpace.comap_comp]
  exact MeasurableSpace.comap_mono (measurable_pi_apply _).comap_le

/-- **Factorisation.** A real function measurable for the exterior σ-algebra of `V` takes equal values
at two configurations that agree on every link outside `V`. -/
theorem eq_of_extSigma_measurable {V : Set E} {g : (E → G) → ℝ}
    (hg : Measurable[extSigma (G := G) V] g) {U U' : E → G} (hUU' : ∀ e, e ∉ V → U e = U' e) :
    g U = g U' := by
  have hs : MeasurableSet[extSigma (G := G) V] (g ⁻¹' {g U'}) := hg (measurableSet_singleton _)
  obtain ⟨t, -, ht⟩ := MeasurableSpace.measurableSet_comap.1 (extSigma_le_comap_restrict V _ hs)
  have hr : (fun e : (Vᶜ : Set E) => U e) = (fun e : (Vᶜ : Set E) => U' e) :=
    funext fun e => hUU' e e.2
  have h1 : U' ∈ (fun U : E → G => fun e : (Vᶜ : Set E) => U e) ⁻¹' t := by
    rw [ht]
    rfl
  have h2 : U ∈ (fun U : E → G => fun e : (Vᶜ : Set E) => U e) ⁻¹' t := by
    show (fun e : (Vᶜ : Set E) => U e) ∈ t
    rw [hr]
    exact h1
  rw [ht] at h2
  exact h2

/-- Each value of `Function.extend f (g x) j` depends measurably on `x` when every `g · i` does. -/
theorem measurable_extend_apply {α β ι γ : Type*} [MeasurableSpace α] [MeasurableSpace γ]
    (f : ι → β) (g : α → ι → γ) (j : β → γ) (hg : ∀ i, Measurable fun x => g x i) (b : β) :
    Measurable fun x => Function.extend f (g x) j b := by
  classical
  by_cases hb : ∃ i, f i = b
  · simp only [Function.extend_def, dif_pos hb]
    exact hg _
  · simp only [Function.extend_def, dif_neg hb]
    exact measurable_const

end Factor

section Mid

variable {S E Sc Ec G : Type*} [OrientedGraph S E] [OrientedGraph Sc Ec] [Group G]
  (blk : Blocking S E Sc Ec)

/-- The mid-site `m(ē) = tgt (a ē) = src (b ē)` of a coarse link `ē`. -/
def midSite (ē : Ec) : S := tgt (blk.a ē)

/-- The mid-site gauge transformation: `k ē` at the mid-site of `ē`, `1` at every other site. -/
noncomputable def midGauge (k : Ec → G) : Gauge S G := Function.extend (midSite blk) k 1

/-- A section of the blocking map on the skeleton: `y ē (k ē)⁻¹` on `a ē`, `k ē` on `b ē`, `1` elsewhere. -/
noncomputable def skelSect (y k : Ec → G) : E → G :=
  Function.extend (Sum.elim blk.a blk.b) (Sum.elim (fun ē => y ē * (k ē)⁻¹) k) 1

variable {blk}

/-- Distinct mid-sites that are not coarse sites force the fine links `a ē`, `b ē` to be pairwise
distinct. -/
theorem sumElim_injective_of_mid (hmid : Function.Injective (midSite blk))
    (hmc : ∀ ē y, midSite blk ē ≠ blk.emb y) : Function.Injective (Sum.elim blk.a blk.b) := by
  refine Function.Injective.sumElim ?_ ?_ ?_
  · intro x y hxy
    apply hmid
    simp only [midSite, hxy]
  · intro x y hxy
    apply hmid
    simp only [midSite]
    rw [blk.tgt_a, blk.tgt_a, hxy]
  · intro x y hxy
    exact hmc x (tgt y) (by rw [midSite, hxy, blk.tgt_b])

/-- `midGauge k` is `k ē` at the mid-site of `ē`. -/
theorem midGauge_mid (hmid : Function.Injective (midSite blk)) (k : Ec → G) (ē : Ec) :
    midGauge blk k (midSite blk ē) = k ē :=
  hmid.extend_apply k 1 ē

/-- `midGauge k` is `1` at every coarse site. -/
theorem midGauge_emb (hmc : ∀ ē y, midSite blk ē ≠ blk.emb y) (k : Ec → G) (y : Sc) :
    midGauge blk k (blk.emb y) = 1 :=
  Function.extend_apply' _ _ _ fun ⟨ē, hē⟩ => hmc ē y hē

/-- On the first fine link: `(midGauge k • U)(a ē) = U(a ē) (k ē)⁻¹`. -/
theorem midGauge_smul_a (hmid : Function.Injective (midSite blk))
    (hmc : ∀ ē y, midSite blk ē ≠ blk.emb y) (k : Ec → G) (U : E → G) (ē : Ec) :
    (midGauge blk k • U) (blk.a ē) = U (blk.a ē) * (k ē)⁻¹ := by
  rw [gauge_smul_apply, blk.src_a, midGauge_emb hmc]
  rw [show tgt (blk.a ē) = midSite blk ē from rfl, midGauge_mid hmid, one_mul]

/-- On the second fine link: `(midGauge k • U)(b ē) = k ē U(b ē)`. -/
theorem midGauge_smul_b (hmid : Function.Injective (midSite blk))
    (hmc : ∀ ē y, midSite blk ē ≠ blk.emb y) (k : Ec → G) (U : E → G) (ē : Ec) :
    (midGauge blk k • U) (blk.b ē) = k ē * U (blk.b ē) := by
  rw [gauge_smul_apply, blk.tgt_b, midGauge_emb hmc, ← blk.tgt_a,
    show tgt (blk.a ē) = midSite blk ē from rfl, midGauge_mid hmid, inv_one, mul_one]

/-- `skelSect y k (a ē) = y ē (k ē)⁻¹`. -/
theorem skelSect_a (hinj : Function.Injective (Sum.elim blk.a blk.b)) (y k : Ec → G) (ē : Ec) :
    skelSect blk y k (blk.a ē) = y ē * (k ē)⁻¹ :=
  hinj.extend_apply _ (1 : E → G) (Sum.inl ē)

/-- `skelSect y k (b ē) = k ē`. -/
theorem skelSect_b (hinj : Function.Injective (Sum.elim blk.a blk.b)) (y k : Ec → G) (ē : Ec) :
    skelSect blk y k (blk.b ē) = k ē :=
  hinj.extend_apply _ (1 : E → G) (Sum.inr ē)

variable (blk)
variable [MeasurableSpace G] [MeasurableMul₂ G] [MeasurableInv G]

/-- The section `(y, k) ↦ skelSect y k` is measurable. -/
theorem measurable_skelSect :
    Measurable fun q : (Ec → G) × (Ec → G) => skelSect blk q.1 q.2 := by
  refine measurable_pi_lambda _ fun e => ?_
  refine measurable_extend_apply (Sum.elim blk.a blk.b)
    (fun q : (Ec → G) × (Ec → G) => Sum.elim (fun ē => q.1 ē * (q.2 ē)⁻¹) q.2) 1 ?_ e
  intro i
  rcases i with ē | ē
  · exact ((measurable_pi_apply ē).comp measurable_fst).mul
      ((measurable_pi_apply ē).comp measurable_snd).inv
  · exact (measurable_pi_apply ē).comp measurable_snd

/-- The mid-site gauge action `(k, U) ↦ midGauge k • U` is jointly measurable. -/
theorem measurable_midGauge_smul :
    Measurable fun q : (Ec → G) × (E → G) => midGauge blk q.1 • q.2 := by
  refine measurable_pi_lambda _ fun e => ?_
  have hs : ∀ s : S, Measurable fun q : (Ec → G) × (E → G) => midGauge blk q.1 s := fun s =>
    measurable_extend_apply (midSite blk) (fun q : (Ec → G) × (E → G) => q.1) 1
      (fun i => (measurable_pi_apply i).comp measurable_fst) s
  exact ((hs (src e)).mul ((measurable_pi_apply e).comp measurable_snd)).mul (hs (tgt e)).inv

end Mid

section Average

variable {S E Sc Ec G : Type*} [OrientedGraph S E] [OrientedGraph Sc Ec] [Fintype Ec] [Group G]
  [MeasurableSpace G] [MeasurableMul₂ G] [MeasurableInv G]
  (blk : Blocking S E Sc Ec) (h : Measure G) [IsProbabilityMeasure h] [IsMulRightInvariant h]

/-- The mid-site gauge average of `g` as a function of the coarse field:
`ĝ y = ∫ g (skelSect y k) dk` over the Haar measure on `G^{Ec}`. -/
noncomputable def midAvg (g : (E → G) → ℝ) (y : Ec → G) : ℝ :=
  ∫ k, g (skelSect blk y k) ∂(Measure.pi fun _ : Ec => h)

omit [IsMulRightInvariant h] in
/-- `ĝ` is measurable when `g` is. -/
theorem stronglyMeasurable_midAvg {g : (E → G) → ℝ} (hg : Measurable g) :
    StronglyMeasurable (midAvg blk h g) :=
  StronglyMeasurable.integral_prod_right (f := fun y k => g (skelSect blk y k))
    (hg.comp (measurable_skelSect blk)).stronglyMeasurable

/-- **Gauge averaging at the mid-sites.** Let the mid-sites be pairwise distinct and not coarse sites,
`μ` any probability measure on `E → G`, and `g` measurable for `σ(U_e : e ∈ Sk)` with
`g ∘ (midGauge k • ·) = g` `μ`-a.e. for each `k` separately. Then `g = ĝ ∘ c` `μ`-a.e. -/
theorem gauge_average (hmid : Function.Injective (midSite blk))
    (hmc : ∀ ē y, midSite blk ē ≠ blk.emb y) (μ : Measure (E → G)) [IsProbabilityMeasure μ]
    {g : (E → G) → ℝ} (hg : StronglyMeasurable[extSigma (G := G) (skel blk)ᶜ] g)
    (hinv : ∀ k : Ec → G, (fun U => g (midGauge blk k • U)) =ᵐ[μ] g) :
    g =ᵐ[μ] midAvg blk h g ∘ blockMap blk := by
  have hinj := sumElim_injective_of_mid hmid hmc
  have hgm : Measurable g := (hg.mono (extSigma_le _)).measurable
  have hgS : Measurable[extSigma (G := G) (skel blk)ᶜ] g := hg.measurable
  have hp : MeasurableSet {x : (Ec → G) × (E → G) | g (midGauge blk x.1 • x.2) = g x.2} :=
    measurableSet_eq_fun (hgm.comp (measurable_midGauge_smul blk)) (hgm.comp measurable_snd)
  have h1 : ∀ᵐ k ∂(Measure.pi fun _ : Ec => h), ∀ᵐ U ∂μ, g (midGauge blk k • U) = g U :=
    ae_of_all _ fun k => hinv k
  have h2 := (ae_ae_comm hp).1 h1
  filter_upwards [h2] with U hU
  have hpt : ∀ k : Ec → G, g (skelSect blk (blockMap blk U) (k * fun ē => U (blk.b ē))) =
      g (midGauge blk k • U) := by
    intro k
    refine eq_of_extSigma_measurable hgS fun e he => ?_
    have he' : e ∈ skel blk := not_not.1 he
    rcases he' with ⟨ē, rfl⟩ | ⟨ē, rfl⟩
    · rw [skelSect_a hinj, midGauge_smul_a hmid hmc]
      simp only [blockMap, Pi.mul_apply]
      group
    · rw [skelSect_b hinj, midGauge_smul_b hmid hmc]
      rfl
  show g U = ∫ k, g (skelSect blk (blockMap blk U) k) ∂(Measure.pi fun _ : Ec => h)
  rw [← integral_mul_right_eq_self (fun k => g (skelSect blk (blockMap blk U) k))
    (fun ē => U (blk.b ē))]
  simp only [hpt]
  rw [integral_congr_ae hU]
  simp

end Average

section Wilson

variable {S E Sc Ec G : Type*} [OrientedGraph S E] [Fintype E] [OrientedGraph Sc Ec] [Fintype Ec]
  [Group G] [MeasurableSpace G] [MeasurableMul₂ G] [MeasurableInv G]
  {Pl : Type*} [Fintype Pl] (plaq : Pl → Plaq S E) (χ : ClassFn G) (κ : ℝ)
  (h : Measure G) [IsProbabilityMeasure h] [IsMulLeftInvariant h] [IsMulRightInvariant h]
  (blk : Blocking S E Sc Ec)

/-- **`E_μ[· | σ(Sk)]` maps `H` into `ran J`** (every real `κ`, mid-site conditions). -/
theorem wilsonP_skel_mem_range (hmid : Function.Injective (midSite blk))
    (hmc : ∀ ē y, midSite blk ē ≠ blk.emb y) (u : wilsonH plaq χ κ h) :
    ∃ y, wilsonJ plaq χ κ h blk y = wilsonP plaq χ κ h (skel blk)ᶜ u := by
  refine ProductEndpoint.exists_coarseJ_eq (wilsonMeasure plaq χ κ h) (Gauge S G)
    (coarseLaw plaq χ κ h blk) (Gauge Sc G) (measurePreserving_blockMap plaq χ κ h blk)
    (blockMap_smul blk) (coarseGauge_surjective blk) ?_
  have hf : ((wilsonP plaq χ κ h (skel blk)ᶜ u : wilsonH plaq χ κ h) :
      Lp ℝ 2 (wilsonMeasure plaq χ κ h)) ∈
      lpMeas ℝ ℝ (extSigma (G := G) (skel blk)ᶜ) 2 (wilsonMeasure plaq χ κ h) :=
    condL2_mem _ (extSigma_le _) _
  rw [mem_lpMeas_iff_aestronglyMeasurable] at hf ⊢
  obtain ⟨g, hg, hfg⟩ := hf
  have hinv : ∀ k : Ec → G,
      (fun U => g (midGauge blk k • U)) =ᵐ[wilsonMeasure plaq χ κ h] g := by
    intro k
    have hγ := ((mem_cgL2 (wilsonMeasure plaq χ κ h) (Gauge S G)).1
      (wilsonP plaq χ κ h (skel blk)ᶜ u).2).2 (midGauge blk k)
    have h1 : ((actL2 (wilsonMeasure plaq χ κ h) (Gauge S G) (midGauge blk k)
        ((wilsonP plaq χ κ h (skel blk)ᶜ u : wilsonH plaq χ κ h) :
          Lp ℝ 2 (wilsonMeasure plaq χ κ h)) : Lp ℝ 2 (wilsonMeasure plaq χ κ h)) :
          (E → G) → ℝ) =ᵐ[wilsonMeasure plaq χ κ h]
        (((wilsonP plaq χ κ h (skel blk)ᶜ u : wilsonH plaq χ κ h) :
          Lp ℝ 2 (wilsonMeasure plaq χ κ h)) : (E → G) → ℝ) ∘ (midGauge blk k • ·) :=
      coeFn_compL2 _ _ _
    rw [hγ] at h1
    have h2 := (measurePreserving_smul (midGauge blk k)
      (wilsonMeasure plaq χ κ h)).quasiMeasurePreserving.ae_eq_comp hfg
    exact (h2.symm.trans h1.symm).trans hfg
  exact ⟨midAvg blk h g ∘ blockMap blk,
    (stronglyMeasurable_midAvg blk h (hg.mono (extSigma_le _)).measurable).comp_measurable
      (comap_measurable _),
    hfg.trans (gauge_average blk h hmid hmc _ hg hinv)⟩

/-- **Lemma IV.** For the Wilson measure at every real `κ` and a blocking whose mid-sites are pairwise
distinct and not coarse sites: `E_μ[u | σ(U_e : e ∈ Sk)] = Π u` for every `u ∈ H`. -/
theorem wilsonP_skel_eq_Pi (hmid : Function.Injective (midSite blk))
    (hmc : ∀ ē y, midSite blk ē ≠ blk.emb y) (u : wilsonH plaq χ κ h) :
    wilsonP plaq χ κ h (skel blk)ᶜ u = (isoProj (wilsonJ plaq χ κ h blk)).P u := by
  have hnot : ∀ ē, blk.a ē ∉ (skel blk)ᶜ ∧ blk.b ē ∉ (skel blk)ᶜ := fun ē =>
    ⟨fun hc => hc (Or.inl ⟨ē, rfl⟩), fun hc => hc (Or.inr ⟨ē, rfl⟩)⟩
  obtain ⟨y, hy⟩ := wilsonP_skel_mem_range plaq χ κ h blk hmid hmc u
  have h1 : (isoProj (wilsonJ plaq χ κ h blk)).P (wilsonP plaq χ κ h (skel blk)ᶜ u) =
      wilsonP plaq χ κ h (skel blk)ᶜ u := by
    rw [← hy, isoProj_apply, isoAdj_apply_self]
  have h2 : (isoProj (wilsonJ plaq χ κ h blk)).P (wilsonP plaq χ κ h (skel blk)ᶜ u) =
      (isoProj (wilsonJ plaq χ κ h blk)).P u :=
    proj_comp_eq_of_le (isoProj (wilsonJ plaq χ κ h blk)) (wilsonPj plaq χ κ h (skel blk)ᶜ)
      (fun z => wilsonP_fixes_Pi plaq χ κ h blk hnot z) u
  rw [← h1, h2]

/-- Lemma IV for Mathlib's conditional expectation: `μ[u | σ(Sk)] = Π u` `μ`-a.e., for `u ∈ H`. -/
theorem condExp_skel_ae_eq_Pi (hmid : Function.Injective (midSite blk))
    (hmc : ∀ ē y, midSite blk ē ≠ blk.emb y) (u : wilsonH plaq χ κ h) :
    (wilsonMeasure plaq χ κ h)[((u : Lp ℝ 2 (wilsonMeasure plaq χ κ h)) : (E → G) → ℝ) |
        extSigma (G := G) (skel blk)ᶜ] =ᵐ[wilsonMeasure plaq χ κ h]
      ((((isoProj (wilsonJ plaq χ κ h blk)).P u : wilsonH plaq χ κ h) :
        Lp ℝ 2 (wilsonMeasure plaq χ κ h)) : (E → G) → ℝ) := by
  rw [← wilsonP_skel_eq_Pi plaq χ κ h blk hmid hmc u]
  exact (condL2_ae_eq_condExp _ (extSigma_le _) _).symm

/-- On `H`, `E_μ[u | σ(Sk)] = 0` if and only if `Π u = 0`. -/
theorem wilsonP_skel_eq_zero_iff (hmid : Function.Injective (midSite blk))
    (hmc : ∀ ē y, midSite blk ē ≠ blk.emb y) (u : wilsonH plaq χ κ h) :
    wilsonP plaq χ κ h (skel blk)ᶜ u = 0 ↔ (isoProj (wilsonJ plaq χ κ h blk)).P u = 0 := by
  rw [wilsonP_skel_eq_Pi plaq χ κ h blk hmid hmc u]

end Wilson

section SU2

open YangMills.StrongCoupling.WilsonSU2

/-- Even sites have parity `0`: `2q ↦ 0` under `ℤ/2Mℤ → ℤ/2ℤ`. -/
theorem castHom_dbl (M : ℕ) [NeZero M] (q : ZMod M) :
    ZMod.castHom (dvd_mul_right 2 M) (ZMod 2) (dbl M q) = 0 := by
  obtain ⟨z, rfl⟩ := ZMod.intCast_surjective q
  rw [dbl_intCast, map_intCast]
  push_cast
  rw [show (2 : ZMod 2) = 0 by decide, zero_mul]

/-- The mid-site of the straight blocking: `m(y, μ) = 2y + e_μ`. -/
theorem straight_midSite_apply (M : ℕ) (ē : Link M) :
    midSite (straightBlocking M) ē = ιS M ē.1 + unitV ē.2 := rfl

/-- No mid-site `2y + e_μ` of the straight blocking is a coarse site `2y'` (every `M ≥ 1`). -/
theorem straight_midSite_ne_emb (M : ℕ) [NeZero M] (ē : Link M) (y : Site M) :
    midSite (straightBlocking M) ē ≠ (straightBlocking M).emb y := by
  intro hē
  rw [straight_midSite_apply] at hē
  have h3 := congrFun hē ē.2
  simp only [straightBlocking, ιS, Pi.add_apply, unitV, Pi.single_eq_same] at h3
  have h4 := congrArg (ZMod.castHom (dvd_mul_right 2 M) (ZMod 2)) h3
  rw [map_add, castHom_dbl, castHom_dbl, map_one, zero_add] at h4
  exact one_ne_zero h4

/-- The mid-sites `2y + e_μ` of the straight blocking are pairwise distinct (every `M ≥ 1`). -/
theorem straight_midSite_injective (M : ℕ) [NeZero M] :
    Function.Injective (midSite (straightBlocking M)) := by
  intro l l' hl
  rw [straight_midSite_apply, straight_midSite_apply] at hl
  have hμ : l.2 = l'.2 := by
    by_contra hne
    have h3 := congrFun hl l.2
    simp only [ιS, Pi.add_apply, unitV, Pi.single_eq_same, Pi.single_eq_of_ne hne,
      add_zero] at h3
    have h4 := congrArg (ZMod.castHom (dvd_mul_right 2 M) (ZMod 2)) h3
    rw [map_add, castHom_dbl, castHom_dbl, map_one, zero_add] at h4
    exact one_ne_zero h4
  rw [hμ] at hl
  exact Prod.ext ((straightBlocking M).inj (add_right_cancel hl)) hμ

variable (M : ℕ) [NeZero M]

/-- **Lemma IV for SU(2)** on `(ℤ/2Mℤ)⁴` with straight blocking, every `M ≥ 1` and every real `β`:
`E_μ[u | σ(Sk)] = Π u` for every `u ∈ H`. -/
theorem su2_skel_eq_Pi (β : ℝ) (u : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2) :
    su2P M β (skel (straightBlocking M))ᶜ u = (su2Pi M β).P u :=
  wilsonP_skel_eq_Pi plaqOf reTr (β / 2) haarSU2 (straightBlocking M)
    (straight_midSite_injective M) (straight_midSite_ne_emb M) u

/-- At `β = 0`, the sweep of the constrained projections `P_{cube2 M x ∖ Sk}` along any list whose
cubes cover every link equals `Π` on `H` (every `M ≥ 1`). -/
theorem su2_constrained_sweep_cover_zero (l : List (Site (2 * M)))
    (hcov : ∀ e : Link (2 * M), ∃ x ∈ l, e ∈ cube2 M x)
    (u : wilsonH (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2) :
    ConstrainedFibre.sweepProd (fun x => wilsonPj (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2
      (cube2 M x \ skel (straightBlocking M))) l u = (su2Pi M 0).P u := by
  rw [ProductEndpoint.wilson_sweepProd_zero plaqOf reTr (zero_div 2) haarSU2]
  have hset : {e | ∃ x ∈ l, e ∈ cube2 M x \ skel (straightBlocking M)} =
      (skel (straightBlocking M))ᶜ := by
    ext e
    simp only [Set.mem_ofPred_eq, Set.mem_sdiff, Set.mem_compl_iff]
    refine ⟨fun ⟨_, _, _, hn⟩ => hn, fun hn => ?_⟩
    obtain ⟨x, hx, he⟩ := hcov e
    exact ⟨x, hx, he, hn⟩
  rw [hset]
  exact su2_skel_eq_Pi M 0 u

/-- At `β = 0`, the constrained sweep along any list containing every base point equals `Π` on `H`. -/
theorem su2_constrained_sweep_zero (l : List (Site (2 * M))) (hl : ∀ x, x ∈ l)
    (u : wilsonH (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2) :
    ConstrainedFibre.sweepProd (fun x => wilsonPj (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2
      (cube2 M x \ skel (straightBlocking M))) l u = (su2Pi M 0).P u :=
  su2_constrained_sweep_cover_zero M l
    (fun e => ⟨e.1, hl e.1, ConstrainedFibre.mem_cube2_self M e.1 e.2⟩) u

/-- **`hcons` at `β = 0` with `λ = 1/16`** for the side-2 cubes `cube2 M x` at every base point with
weights `1/16` (every `M ≥ 1`). -/
theorem su2_hcons_zero (u : wilsonH (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2)
    (hu : (su2Pi M 0).P u = 0) :
    (1 / 16 : ℝ) * ‖u‖ ^ 2 ≤
      ∑ x, (1 / 16 : ℝ) * ‖u - su2P M 0 (cube2 M x \ skel (straightBlocking M)) u‖ ^ 2 := by
  classical
  exact ConstrainedFibre.hcons_of_sweep_vanish (fun _ => (1 / 16 : ℝ)) (by norm_num)
    (fun _ => le_rfl)
    (fun x => wilsonPj plaqOf reTr ((0 : ℝ) / 2) haarSU2 (cube2 M x \ skel (straightBlocking M)))
    (su2Pi M 0) (Finset.univ : Finset (Site (2 * M))).toList (Finset.nodup_toList _)
    (fun v hv => by rw [su2_constrained_sweep_zero M _ (fun x => by simp) v, hv]) u hu

/-- **The constrained route of Part X closed at `β = 0`** (every `M ≥ 1`, every `α < 1/16`):
`su2_gap_of_constrained` with `hcons` (`λ = 1/16`), `hCoarseGap` (`ϖ_c = 1/16`) and `hResidual`
(`X = 0`, `β' = M⁻⁴`, volume dependent) all proved. The conclusion is the statement of Part XV's
`su2_gap_closed_zero`; the new content is the route through `hcons`. -/
theorem su2_gap_constrained_zero {α : ℝ} (hα : α < 1 / 16) :
    min α ((1 / (M : ℝ) ^ 4) * (1 / 16)) • LinearMap.id ≤
      su2D M 0 (cube2 M) (fun _ => 1 / 16) := by
  have hβ' : (0 : ℝ) ≤ 1 / (M : ℝ) ^ 4 := by positivity
  exact su2_gap_of_constrained M 0 (cube2 M) (fun _ => 1 / 16) (fun _ => by norm_num)
    (ProductEndpoint.sideTwoCube M) (fun _ => 1 / 16) (su2_hcons_zero M) hα hβ'
    (ProductEndpoint.su2_coarse_gap_zero M) 0 (ProductEndpoint.su2_hResidual_zero M α (1 / 16))

end SU2

section Families

open YangMills.StrongCoupling.WilsonSU2

/-- The parity vector `z mod 2` of a site of `(ℤ/2Mℤ)⁴`. -/
def siteParity (M : ℕ) (z : Site (2 * M)) : Fin 4 → ZMod 2 :=
  fun i => ZMod.castHom (dvd_mul_right 2 M) (ZMod 2) (z i)

/-- The parity vector `p = (0, j)` of family `j`. -/
def famVec (j : Fin 3 → ZMod 2) : Fin 4 → ZMod 2 := Fin.cons 0 j

/-- The parity family `j`: the base points `z` with `z ≡ p` or `z ≡ 1 + p (mod 2)`, `p = famVec j`. -/
noncomputable def parFamily (M : ℕ) [NeZero M] (j : Fin 3 → ZMod 2) : List (Site (2 * M)) :=
  (Finset.univ.filter fun z => siteParity M z = famVec j ∨ siteParity M z = famVec j + 1).toList

/-- In `ℤ/2ℤ`, `b ≠ c` gives `b − 1 = c`. -/
theorem zmod2_sub_one : ∀ b c : ZMod 2, ¬ b = c → b - 1 = c := by decide

/-- In `ℤ/2ℤ`, `b ≠ c` gives `b + 1 = c`. -/
theorem zmod2_add_one : ∀ b c : ZMod 2, ¬ b = c → b + 1 = c := by decide

/-- Distinct families have distinct parity vectors. -/
theorem famVec_inj {j j' : Fin 3 → ZMod 2} (hj : famVec j = famVec j') : j = j' :=
  funext fun i => by simpa [famVec] using congrFun hj i.succ

/-- `p ≠ 1 + p'` for parity vectors with first entry `0`. -/
theorem famVec_ne_add_one (j j' : Fin 3 → ZMod 2) : famVec j ≠ famVec j' + 1 := fun hj => by
  have h0 := congrFun hj 0
  rw [Pi.add_apply, Pi.one_apply] at h0
  simp only [famVec, Fin.cons_zero, zero_add] at h0
  exact zero_ne_one h0

/-- The `8` parity families are pairwise disjoint. -/
theorem parFamily_disjoint (M : ℕ) [NeZero M] (j j' : Fin 3 → ZMod 2) (hjj : j ≠ j')
    (x : Site (2 * M)) (hx : x ∈ parFamily M j) : x ∉ parFamily M j' := by
  intro hx'
  simp only [parFamily, Finset.mem_toList, Finset.mem_filter, Finset.mem_univ, true_and] at hx hx'
  rcases hx with h1 | h1 <;> rcases hx' with h2 | h2
  · exact hjj (famVec_inj (h1.symm.trans h2))
  · exact famVec_ne_add_one j j' (h1.symm.trans h2)
  · exact famVec_ne_add_one j' j (h2.symm.trans h1)
  · exact hjj (famVec_inj (add_right_cancel (h1.symm.trans h2)))

/-- Each parity family covers every link: every link lies in `cube2 M z` for some `z` in the family
(every `M ≥ 1`). -/
theorem parFamily_cover (M : ℕ) [NeZero M] (j : Fin 3 → ZMod 2) (e : Link (2 * M)) :
    ∃ z ∈ parFamily M j, e ∈ cube2 M z := by
  classical
  obtain ⟨x, μ⟩ := e
  let q : Fin 4 → ZMod 2 := if famVec j μ = siteParity M x μ then famVec j else famVec j + 1
  have hqμ : q μ = siteParity M x μ := by
    by_cases hp : famVec j μ = siteParity M x μ
    · show (if famVec j μ = siteParity M x μ then famVec j else famVec j + 1) μ = _
      rw [if_pos hp]
      exact hp
    · show (if famVec j μ = siteParity M x μ then famVec j else famVec j + 1) μ = _
      rw [if_neg hp, Pi.add_apply, Pi.one_apply]
      exact zmod2_add_one _ _ hp
  have hq : q = famVec j ∨ q = famVec j + 1 := by
    by_cases hp : famVec j μ = siteParity M x μ
    · exact Or.inl (if_pos hp)
    · exact Or.inr (if_neg hp)
  let a : Fin 4 → Fin 2 := fun i => if siteParity M x i = q i then 0 else 1
  let z : Site (2 * M) := x - fun i => (((a i : ℕ) : ZMod (2 * M)))
  have hz : siteParity M z = q := by
    funext i
    show ZMod.castHom (dvd_mul_right 2 M) (ZMod 2) (x i - (((a i : ℕ) : ZMod (2 * M)))) = q i
    rw [map_sub, map_natCast]
    show siteParity M x i - (((a i : ℕ) : ZMod 2)) = q i
    by_cases hi : siteParity M x i = q i
    · have ha : a i = 0 := if_pos hi
      rw [ha, Fin.val_zero, Nat.cast_zero, sub_zero]
      exact hi
    · have ha : a i = 1 := if_neg hi
      rw [ha, Fin.val_one, Nat.cast_one]
      exact zmod2_sub_one _ _ hi
  refine ⟨z, ?_, a, ?_, ?_⟩
  · simp only [parFamily, Finset.mem_toList, Finset.mem_filter, Finset.mem_univ, true_and]
    rw [hz]
    exact hq
  · show (if siteParity M x μ = q μ then (0 : Fin 2) else 1) = 0
    rw [if_pos hqμ.symm]
  · show x = z + fun i => (((a i : ℕ) : ZMod (2 * M)))
    exact (sub_add_cancel x _).symm

variable (M : ℕ) [NeZero M]

/-- **`hcons` at `β = 0` with `λ = 1/2`** (every `M ≥ 1`, side-2 cubes at every base point, weights
`1/16`): `8` disjoint covering families, each with a vanishing constrained sweep on `ker Π`. -/
theorem su2_hcons_zero_half (u : wilsonH (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2)
    (hu : (su2Pi M 0).P u = 0) :
    (1 / 2 : ℝ) * ‖u‖ ^ 2 ≤
      ∑ x, (1 / 16 : ℝ) * ‖u - su2P M 0 (cube2 M x \ skel (straightBlocking M)) u‖ ^ 2 := by
  classical
  have h := ConstrainedFibre.hcons_of_sweeps (κ := Fin 3 → ZMod 2) (fun _ => (1 / 16 : ℝ))
    (wmin := 1 / 16) (θ := 0) (by norm_num) (fun _ => le_rfl)
    (fun x => wilsonPj plaqOf reTr ((0 : ℝ) / 2) haarSU2 (cube2 M x \ skel (straightBlocking M)))
    (su2Pi M 0) (parFamily M) (fun _ => Finset.nodup_toList _)
    (fun j j' hjj x hx => parFamily_disjoint M j j' hjj x hx) zero_le_one
    (fun j v hv => by
      rw [su2_constrained_sweep_cover_zero M (parFamily M j) (parFamily_cover M j) v, hv,
        norm_zero, zero_mul]) u hu
  have hcard : (Fintype.card (Fin 3 → ZMod 2) : ℝ) = 8 := by
    simp only [Fintype.card_fun, ZMod.card, Fintype.card_fin]
    norm_num
  rw [hcard] at h
  calc (1 / 2 : ℝ) * ‖u‖ ^ 2 = (8 * (1 / 16) * (1 - 0) ^ 2) * ‖u‖ ^ 2 := by ring
    _ ≤ _ := h

/-- The constrained route at `β = 0` with `λ = 1/2`: `D ≥ min(α, M⁻⁴/16) I` for every `α < 1/2`
(every `M ≥ 1`). Since `min(α, M⁻⁴/16) ≤ M⁻⁴/16`, the best case `α ≥ M⁻⁴/16` gives
`D ≥ (M⁻⁴/16) I`, which Part XV's `su2_fine_gap_zero` (`D ≥ (1/16) I`) implies. -/
theorem su2_gap_constrained_zero_half {α : ℝ} (hα : α < 1 / 2) :
    min α ((1 / (M : ℝ) ^ 4) * (1 / 16)) • LinearMap.id ≤
      su2D M 0 (cube2 M) (fun _ => 1 / 16) := by
  have hβ' : (0 : ℝ) ≤ 1 / (M : ℝ) ^ 4 := by positivity
  exact su2_gap_of_constrained M 0 (cube2 M) (fun _ => 1 / 16) (fun _ => by norm_num)
    (ProductEndpoint.sideTwoCube M) (fun _ => 1 / 16) (su2_hcons_zero_half M) hα hβ'
    (ProductEndpoint.su2_coarse_gap_zero M) 0 (ProductEndpoint.su2_hResidual_zero M α (1 / 2))

/-- **The elementary bound at `β = 0`: `D ≥ (1/2) I` on `H`** (every `M ≥ 1`, side-2 cubes `cube2 M x`
at every base point, weights `1/16`). Every link lies in a cube of each of the `8` parity families; at
`β = 0` the sweep of the unconstrained cube projections over one family is `P` of all links, which is
`0` on `H` (Part XV's `wilson_sweepProd_zero`), so Part XII's `hcons_of_sweeps` with `θ = 0` gives
`8 · (1/16) = 1/2`. Neither Lemma IV nor the split is used. The closed routes of the interface give
`1/8` (`UniformEndpoint.su2_gap_constrained_zero_uniform`). -/
theorem su2_fine_gap_zero_half :
    (1 / 2 : ℝ) • LinearMap.id ≤ su2D M 0 (cube2 M) (fun _ => 1 / 16) := by
  classical
  refine SchurTower.smul_id_le_of_form
    (cubeGen_isSymmetric _ fun x => (wilsonPj (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2
      (cube2 M x)).symm) fun u => ?_
  have h := ConstrainedFibre.hcons_of_sweeps (κ := Fin 3 → ZMod 2) (fun _ => (1 / 16 : ℝ))
    (wmin := 1 / 16) (θ := 0) (by norm_num) (fun _ => le_rfl)
    (fun x => wilsonPj plaqOf reTr ((0 : ℝ) / 2) haarSU2 (cube2 M x))
    (wilsonPj plaqOf reTr ((0 : ℝ) / 2) haarSU2 Set.univ) (parFamily M)
    (fun _ => Finset.nodup_toList _)
    (fun j j' hjj x hx => parFamily_disjoint M j j' hjj x hx) zero_le_one
    (fun j v _ => by
      have hset : {e | ∃ x ∈ parFamily M j, e ∈ cube2 M x} = Set.univ :=
        Set.eq_univ_of_forall fun e => parFamily_cover M j e
      rw [ProductEndpoint.wilson_sweepProd_zero plaqOf reTr (zero_div 2) haarSU2, hset,
        ProductEndpoint.wilsonP_univ, norm_zero, zero_mul])
    u (ProductEndpoint.wilsonP_univ _ _ _ u)
  have hcard : (Fintype.card (Fin 3 → ZMod 2) : ℝ) = 8 := by
    simp only [Fintype.card_fun, ZMod.card, Fintype.card_fin]
    norm_num
  rw [hcard] at h
  rw [inner_cubeGen_eq (fun _ => (1 / 16 : ℝ))
    (fun x => wilsonPj (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2 (cube2 M x)) u]
  calc (1 / 2 : ℝ) * ‖u‖ ^ 2 = (8 * (1 / 16) * (1 - 0) ^ 2) * ‖u‖ ^ 2 := by ring
    _ ≤ _ := h

end Families

end YangMills.StrongCoupling.SkeletonCondExp

/-! # Part XVIII. `YangMills.StrongCoupling.UniformEndpoint`: the closed instance at `β = 0` with constants independent of the volume (new; uses Parts I–IV, VI, X, XII and XV–XVII) -/

/-!
# A volume-uniform closed instance of the split at the strong-coupling endpoint `β = 0`

## (a) Formal target

Part XV of this file proves every input of `CubeSplitInputs.gap_of_residual` (Part II) for the
SU(2) Wilson objects at `β = 0`, but its residual input `su2_hResidual_zero` uses the crude bound
`⟪y, D_c y⟫ ≤ (∑_z w_z) ‖y‖²`, so its coarse comparison constant `β' = M⁻⁴` depends on the volume.
The target here is a comparison `β' ⟪y, D_c y⟫ ≤ ⟪J y, D J y⟫` with `β'` independent of `M`, and the
resulting closed instance of the split with every constant independent of the volume.

## (b) What is proved

* Conditional expectations along maps (`condExp_comp_comap`, `extSigma_union_compl_range`,
  `condExp_shear_comp_eq`): for a measure-preserving `T`, `E_μ[g ∘ T | T⁻¹ m] = E_ν[g | m] ∘ T`; for
  a product measure and a coarse field `c U ē = φ (U (t ē)) (U (p ē))` given by an invertible
  shear (Part XV), `E_μ[g ∘ c | links outside V] = E_ν[g | coarse links outside t⁻¹ V] ∘ c` when
  `p ē ∈ V` forces `t ē ∈ V`.
* Each cube projection acts on `ran J` as a coarse conditional expectation at `κ = 0`
  (`wilsonP_wilsonJ_eq_of_shear`, `wilsonP_wilsonJ_eq`): for any blocking whose fine links `a ē`,
  `b ē` are pairwise distinct and any link set `V`, `P_V (J y) = J (Pᶜ_T y)` with
  `T = {ē : a ē ∈ V or b ē ∈ V}`. This is the explicit form of Part XV's
  `wilsonP_wilsonJ_mem_range`.
* For every `κ` (`blockMap_measurable_extSigma_ext`, `wilsonP_fixes_wilsonJ_coarseP`): if every
  coarse link outside `T` has both fine links outside `V`, then `P_V (J (Pᶜ_T y)) = J (Pᶜ_T y)`.
* Covers for a product measure (`extProj_norm_sub_le_of_subset`, `extProj_norm_sub_le_of_cover`):
  `V ⊆ ⋃_{x ∈ s} T x` gives `‖u − P_V u‖² ≤ ∑_{x ∈ s} ‖u − P_{T x} u‖²` (via the sweep inequality of
  Part XII).
* Geometry of straight blocking (`cubeTrace`, `fineSite`, `parity4`, `dbl_natCast`,
  `exists_parity4`, `mem_cubeTrace_fineSite`, `sideTwoCube_subset_cover`, `fineSite_injective`):
  with `T_x` the coarse links met by the fine cube `cube2 M x`, for every coarse base point `z` and
  each parity `p`, the sets `T_{2z+ε}` with `ε ∈ {0,1}⁴` of parity `p` cover the coarse cube
  `sideTwoCube M z`, and `(z, ε) ↦ 2z + ε` is injective.
* `hResidual_zero_of_form`: if the mixed block vanishes, `β' ⟪J* v, D_c J* v⟫ ≤ ⟪v, C v⟫` is the
  residual certificate with `X = 0`.
* SU(2) on `(ℤ/2Mℤ)⁴`, `β = 0`, every `M ≥ 1`, straight blocking, fine side-2 cubes `cube2 M x`
  and coarse side-2 cubes `sideTwoCube M z` at every base point, all weights `1/16`:
  `su2P_wilsonJ_zero` (`P_{cube2 M x} (J y) = J (Pᶜ_{T_x} y)`), `su2_fine_form_zero`
  (`⟪J y, D J y⟫ = ∑ₓ (1/16) ‖y − Pᶜ_{T_x} y‖²`), `su2_coarse_form_zero`,
  `su2_coarse_comparison_zero` (`2 ⟪y, D_c y⟫ ≤ ⟪J y, D J y⟫`), `su2_gC_le_zero`,
  `su2_hResidual_zero_uniform` (`hResidual` with `X = 0` and `β' = 2`) and
  `su2_gap_closed_zero_uniform`: `CubeSplitInputs.gap_of_residual` (through Part XVI's
  `gap_of_invariant`) for `su2_inputs` with `λ = 1/16`, `β' = 2` and `ϖ_c = 1/16`, giving
  `D ≥ min(α, 2 · (1/16)) I` for every `α < 1/16` (this minimum is `α`). No constant depends on
  `M`.
* `su2_gap_constrained_zero_uniform` (same setting, every `α < 1/2`): Part X's
  `su2_gap_of_constrained` with `hcons` from `SkeletonCondExp.su2_hcons_zero_half` (`λ = 1/2`,
  through Lemma IV), `hCoarseGap` (`ϖ_c = 1/16`) and `su2_hResidual_zero_uniform` (`β' = 2`):
  `D ≥ min(α, 1/8) I`, so `D ≥ (1/8) I` at `α = 1/8`, with no constant depending on `M` (Part XV's
  direct bound is `1/16`; the elementary product-measure bound `D ≥ (1/2) I` is four times larger:
  `SkeletonCondExp.su2_fine_gap_zero_half`).
* Single-link lift (`su2_poinc_of_lift`, every real `β`, every `M ≥ 1`): the range hypotheses
  `hout` and `hin` and the multiplicity bound of Part XVI's `poinc_of_lift` hold for the single-link
  projections `P_{e}` and `Pᶜ_{ē}` of the SU(2) model, so a single-link Poincaré inequality
  `c ‖J y‖² ≤ ∑ₑ ‖J y − P_{e} J y‖²` gives `c ‖y‖² ≤ 2 ∑_ē ‖y − Pᶜ_{ē} y‖²`;
  `su2_coarse_poinc_zero` is its instance at `β = 0` with `c = 1` (non-vacuity).

## (c) What remains open

At `β = 0` the bound of `su2_gap_closed_zero_uniform` equals `α < 1/16` and is weaker than Part XV's
`su2_fine_gap_zero` (`D ≥ 1/16`); its content is that every input of the interface is met by the
actual Wilson operators with constants independent of the volume. At `M = 1` the constant `2` is
valid but not sharp (the accompanying notes give `16`). The identity
`E_μ[· | σ(skeleton)] = Π` on `H` is not used by `su2_gap_closed_zero_uniform` (its `hFibre`
comes from the generator bound of Part XV); `su2_gap_constrained_zero_uniform` uses it through
`hcons`, and its bound `1/8` is decided by the coarse factor `β' ϖ_c`.
For `β ≠ 0` the mixed block no longer vanishes, and `hResidual`,
`hCoarseGap` and the single-link Poincaré inequality `hfine` of `su2_poinc_of_lift` remain open in
Lean. Nothing here concerns infinite volume or a continuum limit.

## (d) Axioms and checks

Every headline depends only on `propext`, `Classical.choice` and `Quot.sound` (the module axiom
audit covers every headline theorem); the part contains no `sorry`, `admit`, `axiom` declarations,
`native_decide`, `implemented_by` or `set_option`. The finite checks `exists_parity4` and the parity
lemmas inside `mem_cubeTrace_fineSite` and `fineSite_injective` are closed by `decide`.

## (e) Scope

This part is not a proof of a mass gap. Its statements about the Wilson model are finite-volume
statements; those about the split are at the single coupling `κ = 0` (`β = 0` for SU(2)), where the
Wilson measure is a product measure and the heat-bath gap is elementary. `su2_poinc_of_lift` holds
for every `β` but keeps the analytic single-link Poincaré inequality as a hypothesis. Nothing here
concerns weak coupling.
-/

namespace YangMills.StrongCoupling.UniformEndpoint

open scoped InnerProductSpace ENNReal
open MeasureTheory ProbabilityTheory
open YangMills.StrongCoupling.CondExpInputs YangMills.StrongCoupling.WilsonCube
  YangMills.StrongCoupling.FibreReduction YangMills.StrongCoupling.ProductEndpoint

section CondExpMap

/-- **Conditional expectation along a measure-preserving map.** If `T : Ω → Ω'` maps `μ` to `ν`
and `m` is a sub-σ-algebra of `Ω'`, then `E_μ[g ∘ T | T⁻¹ m] = E_ν[g | m] ∘ T` a.e. -/
theorem condExp_comp_comap {Ω Ω' : Type*} {m : MeasurableSpace Ω'} {m0 : MeasurableSpace Ω}
    {m0' : MeasurableSpace Ω'}
    {μ : Measure Ω} {ν : Measure Ω'} [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    {T : Ω → Ω'} (hT : MeasurePreserving T μ ν) (hm : m ≤ m0')
    {g : Ω' → ℝ} (hg : Integrable g ν) :
    μ[g ∘ T | m.comap T] =ᵐ[μ] ν[g | m] ∘ T := by
  have hmT : m.comap T ≤ m0 := (MeasurableSpace.comap_mono hm).trans hT.measurable.comap_le
  have hgT : Integrable (g ∘ T) μ := (hT.integrable_comp hg.aestronglyMeasurable).2 hg
  have hcT : Integrable (ν[g | m] ∘ T) μ :=
    (hT.integrable_comp integrable_condExp.aestronglyMeasurable).2 integrable_condExp
  refine (ae_eq_condExp_of_forall_setIntegral_eq hmT hgT (fun s _ _ => hcT.integrableOn)
    (fun s hs _ => ?_) ?_).symm
  · obtain ⟨B, hB, rfl⟩ := hs
    have hB' : MeasurableSet B := hm B hB
    rw [← hT.map_eq] at hg
    have e1 := setIntegral_map (μ := μ) (g := T) (f := ν[g | m]) hB'
      (by rw [hT.map_eq]; exact integrable_condExp.aestronglyMeasurable)
      hT.measurable.aemeasurable
    have e2 := setIntegral_map (μ := μ) (g := T) (f := g) hB' hg.aestronglyMeasurable
      hT.measurable.aemeasurable
    rw [hT.map_eq] at e1 e2
    simp only [Function.comp_apply]
    rw [← e1, ← e2, setIntegral_condExp hm (hT.map_eq ▸ hg) hB]
  · exact (stronglyMeasurable_condExp.comp_measurable (comap_measurable T)).aestronglyMeasurable

end CondExpMap

section ExtComap

variable {E Ec G : Type*} [MeasurableSpace G]

/-- The exterior σ-algebra of `V ∪ (range t)ᶜ` is the pull-back, under `U ↦ U ∘ t`, of the
exterior σ-algebra of `t⁻¹ V`. -/
theorem extSigma_union_compl_range (t : Ec → E) (V : Set E) :
    extSigma (G := G) (V ∪ (Set.range t)ᶜ) =
      (extSigma (G := G) (t ⁻¹' V)).comap (fun (U : E → G) (ē : Ec) => U (t ē)) := by
  refine le_antisymm ?_ ?_
  · refine iSup₂_le fun e he => ?_
    simp only [Set.compl_union, compl_compl, Set.mem_inter_iff, Set.mem_compl_iff,
      Set.mem_range] at he
    obtain ⟨heV, ē, rfl⟩ := he
    rw [← measurable_iff_comap_le]
    exact (measurable_eval_extSigma (G := G) (V := t ⁻¹' V) (e := ē) heV).comp
      (comap_measurable _)
  · rw [MeasurableSpace.comap_le_iff_le_map]
    refine iSup₂_le fun ē hē => ?_
    rw [← MeasurableSpace.comap_le_iff_le_map, MeasurableSpace.comap_comp,
      ← measurable_iff_comap_le]
    have hm : t ē ∉ V ∪ (Set.range t)ᶜ := by
      simp only [Set.mem_union, Set.mem_compl_iff, Set.mem_range, not_or, not_not]
      exact ⟨hē, ē, rfl⟩
    exact measurable_eval_extSigma (G := G) hm

end ExtComap

section ShearCondExp

variable {E Ec G : Type*} [Fintype E] [Fintype Ec] [MeasurableSpace G]

/-- **Explicit form of one exterior resampling of a sheared coarse field at `κ = 0`.** Let
`c U ē = φ (U (t ē)) (U (p ē))` for an invertible shear `(t, p, φ)` that preserves the product
measure, and let `p ē ∈ V` force `t ē ∈ V`. Then `E_μ[g ∘ c | links outside V]` is a.e.
`E_ν[g | coarse links outside t⁻¹ V] ∘ c`, where `μ = ∏ₑ h` and `ν = ∏_ē h`. -/
theorem condExp_shear_comp_eq (h : Measure G) [IsProbabilityMeasure h]
    (μ : Measure (E → G)) (hμ : μ = Measure.pi fun _ => h)
    (ν : Measure (Ec → G)) (hν : ν = Measure.pi fun _ => h)
    {t p : Ec → E} {φ φ' : G → G → G} (ht : Function.Injective t) (htp : ∀ x y, t x ≠ p y)
    (hφm : Measurable fun z : G × G => φ z.1 z.2) (hφ'm : Measurable fun z : G × G => φ' z.1 z.2)
    (hφ : ∀ y, MeasurePreserving (φ · y) h h) (hinv : ∀ x y, φ' (φ x y) y = x)
    (hinv' : ∀ x y, φ (φ' x y) y = x) {V : Set E} (hV : ∀ ē, p ē ∈ V → t ē ∈ V)
    {c : (E → G) → (Ec → G)} (hc : ∀ U ē, c U ē = φ (U (t ē)) (U (p ē)))
    {g : (Ec → G) → ℝ} (hg : StronglyMeasurable g) (hgi : Integrable g ν) :
    μ[g ∘ c | extSigma V] =ᵐ[μ] ν[g | extSigma (t ⁻¹' V)] ∘ c := by
  subst hμ hν
  let prj : (E → G) → (Ec → G) := fun U ē => U (t ē)
  have hcπ : c = prj ∘ shear t p φ := by
    funext U ē
    simp only [Function.comp_apply, prj, shear_apply_t ht, hc]
  have hΘ := measurePreserving_shear h ht htp hφm hφ
  have hΘ' : Measurable (shear t p φ') := measurable_shear ht hφ'm
  have hprj : MeasurePreserving prj (Measure.pi fun _ : E => h) (Measure.pi fun _ : Ec => h) :=
    map_comp_pi h t ht
  have hgπ : Integrable (g ∘ prj) (Measure.pi fun _ : E => h) :=
    (hprj.integrable_comp hgi.aestronglyMeasurable).2 hgi
  have hπm : Measurable[extSigma (G := G) (Set.range t)ᶜ, MeasurableSpace.pi] prj :=
    @measurable_pi_lambda _ _ _ (extSigma (G := G) (Set.range t)ᶜ) _ prj fun ē =>
      measurable_eval_extSigma (by simp)
  have step1 : (Measure.pi fun _ : E => h)[g ∘ c | extSigma V] =ᵐ[Measure.pi fun _ : E => h]
      (Measure.pi fun _ : E => h)[g ∘ prj | extSigma V] ∘ shear t p φ := by
    rw [hcπ, ← Function.comp_assoc]
    exact condExp_comp_eq (extSigma_le V) hΘ hΘ' (measurable_shear_extSigma ht hφm hV)
      (measurable_shear_extSigma ht hφ'm hV) (shear_shear ht htp hinv)
      (shear_shear ht htp hinv') hgπ
  have step2 := condExp_extSigma_of_meas (fun _ : E => h) V (Set.range t)ᶜ hgπ
    (hg.comp_measurable hπm)
  have step3 : (Measure.pi fun _ : E => h)[g ∘ prj | extSigma (V ∪ (Set.range t)ᶜ)]
      =ᵐ[Measure.pi fun _ : E => h] (Measure.pi fun _ : Ec => h)[g | extSigma (t ⁻¹' V)] ∘ prj := by
    rw [extSigma_union_compl_range t V]
    exact condExp_comp_comap hprj (extSigma_le _) hgi
  refine step1.trans ((hΘ.quasiMeasurePreserving.ae_eq_comp (step2.trans step3)).trans ?_)
  rw [hcπ]
  exact Filter.EventuallyEq.rfl

end ShearCondExp

/-! ## Each cube projection acts on `ran J` as a coarse conditional expectation at `κ = 0` -/

section CoarseAction

open SchurSplit YangMills.StrongCoupling.CubeSplit

variable {S E Sc Ec G : Type*} [OrientedGraph S E] [Fintype E] [OrientedGraph Sc Ec] [Fintype Ec]
  [Group G] [MeasurableSpace G] [MeasurableMul₂ G] [MeasurableInv G] {Pl : Type*} [Fintype Pl]
  (plaq : Pl → Plaq S E) (χ : ClassFn G) {κ : ℝ} (hκ : κ = 0) (h : Measure G)
  [IsProbabilityMeasure h] [Measure.IsMulLeftInvariant h] [Measure.IsMulRightInvariant h]

include hκ in
/-- One shear step of `wilsonP_wilsonJ_eq`: at `κ = 0`, if `c U ē = φ (U (t ē)) (U (p ē))` for a
measure-preserving invertible shear and `p ē ∈ V` forces `t ē ∈ V`, then
`P_V (J y) = J (Pᶜ_{t⁻¹ V} y)`. -/
theorem wilsonP_wilsonJ_eq_of_shear (blk : Blocking S E Sc Ec)
    (hinj : Function.Injective (Sum.elim blk.a blk.b)) {t p : Ec → E} {φ φ' : G → G → G}
    (ht : Function.Injective t) (htp : ∀ x y, t x ≠ p y)
    (hφm : Measurable fun z : G × G => φ z.1 z.2) (hφ'm : Measurable fun z : G × G => φ' z.1 z.2)
    (hφ : ∀ y, MeasurePreserving (φ · y) h h) (hinv : ∀ x y, φ' (φ x y) y = x)
    (hinv' : ∀ x y, φ (φ' x y) y = x) (hcφ : ∀ U ē, blockMap blk U ē = φ (U (t ē)) (U (p ē)))
    {V : Set E} (hV : ∀ ē, p ē ∈ V → t ē ∈ V) (y : coarseY plaq χ κ h blk) :
    wilsonP plaq χ κ h V (wilsonJ plaq χ κ h blk y) =
      wilsonJ plaq χ κ h blk (coarseP plaq χ κ h blk (t ⁻¹' V) y) := by
  have hc := measurePreserving_blockMap plaq χ κ h blk
  have e1 : ((wilsonP plaq χ κ h V (wilsonJ plaq χ κ h blk y) : wilsonH plaq χ κ h) :
      Lp ℝ 2 (wilsonMeasure plaq χ κ h)) = condL2 (wilsonMeasure plaq χ κ h) (extSigma_le V)
        (compL2 (wilsonMeasure plaq χ κ h) hc (y : Lp ℝ 2 (coarseLaw plaq χ κ h blk))) := rfl
  have e2 : ((wilsonJ plaq χ κ h blk (coarseP plaq χ κ h blk (t ⁻¹' V) y) : wilsonH plaq χ κ h) :
      Lp ℝ 2 (wilsonMeasure plaq χ κ h)) = compL2 (wilsonMeasure plaq χ κ h) hc
        (condL2 (coarseLaw plaq χ κ h blk) (extSigma_le (t ⁻¹' V))
          (y : Lp ℝ 2 (coarseLaw plaq χ κ h blk))) := rfl
  refine Subtype.ext (Lp.ext ?_)
  rw [e1, e2]
  have hgi : Integrable ((y : Lp ℝ 2 (coarseLaw plaq χ κ h blk)) : (Ec → G) → ℝ)
      (coarseLaw plaq χ κ h blk) := (Lp.memLp _).integrable one_le_two
  have hA := condExp_shear_comp_eq h (wilsonMeasure plaq χ κ h) (wilsonMeasure_eq_pi plaq χ hκ h)
    (coarseLaw plaq χ κ h blk) (coarseLaw_eq_pi plaq χ hκ h blk hinj) ht htp hφm hφ'm hφ hinv
    hinv' hV hcφ (Lp.stronglyMeasurable _) hgi
  refine (condL2_ae_eq_condExp _ (extSigma_le V) _).trans ?_
  refine (condExp_congr_ae (coeFn_compL2 _ hc _)).trans ?_
  refine hA.trans ?_
  refine Filter.EventuallyEq.trans ?_ (coeFn_compL2 _ hc _).symm
  exact (hc.quasiMeasurePreserving.ae_eq_comp
    (condL2_ae_eq_condExp _ (extSigma_le (t ⁻¹' V)) _)).symm

include hκ in
/-- **At `κ = 0` every cube projection acts on `ran J` as a coarse conditional expectation:**
for a blocking whose fine links `a ē`, `b ē` are pairwise distinct and any link set `V`,
`P_V (J y) = J (Pᶜ_T y)` with `T = {ē : a ē ∈ V or b ē ∈ V}`. -/
theorem wilsonP_wilsonJ_eq (blk : Blocking S E Sc Ec)
    (hinj : Function.Injective (Sum.elim blk.a blk.b)) (V : Set E) (y : coarseY plaq χ κ h blk) :
    wilsonP plaq χ κ h V (wilsonJ plaq χ κ h blk y) =
      wilsonJ plaq χ κ h blk (coarseP plaq χ κ h blk {ē | blk.a ē ∈ V ∨ blk.b ē ∈ V} y) := by
  classical
  have ha : Function.Injective blk.a := hinj.comp Sum.inl_injective
  have hb : Function.Injective blk.b := hinj.comp Sum.inr_injective
  have hab : ∀ x y, blk.a x ≠ blk.b y := fun x y hxy => Sum.inl_ne_inr (hinj hxy)
  have hba : ∀ x y, blk.b x ≠ blk.a y := fun x y hxy => hab y x hxy.symm
  let R : Set E := {e | ∃ ē, e = blk.b ē ∧ blk.a ē ∉ V}
  have hVa : ∀ ē, blk.b ē ∈ V \ R → blk.a ē ∈ V \ R := by
    rintro ē ⟨hbV, hbR⟩
    refine ⟨?_, ?_⟩
    · by_contra ha'
      exact hbR ⟨ē, rfl, ha'⟩
    · rintro ⟨ē', he, -⟩
      exact hab ē ē' he
  have hVb : ∀ ē, blk.a ē ∈ V ∩ R → blk.b ē ∈ V ∩ R := by
    rintro ē ⟨-, ē', he, -⟩
    exact absurd he (hab ē ē')
  have hsplit : wilsonP plaq χ κ h V (wilsonJ plaq χ κ h blk y) =
      wilsonP plaq χ κ h (V \ R) (wilsonP plaq χ κ h (V ∩ R) (wilsonJ plaq χ κ h blk y)) := by
    rw [wilsonP_comp_zero plaq χ hκ h, Set.sdiff_union_inter V R]
  have h2 := wilsonP_wilsonJ_eq_of_shear plaq χ hκ h blk hinj (t := blk.b) (p := blk.a)
    (φ := fun x y => y * x) (φ' := fun x y => y⁻¹ * x) hb hba
    (measurable_snd.mul measurable_fst) (measurable_snd.inv.mul measurable_fst)
    (fun y => measurePreserving_mul_left h y) (fun x y => inv_mul_cancel_left y x)
    (fun x y => mul_inv_cancel_left y x) (fun _ _ => rfl) hVb y
  have h1 := wilsonP_wilsonJ_eq_of_shear plaq χ hκ h blk hinj (t := blk.a) (p := blk.b)
    (φ := fun x y => x * y) (φ' := fun x y => x * y⁻¹) ha hab
    (measurable_fst.mul measurable_snd) (measurable_fst.mul measurable_snd.inv)
    (fun y => measurePreserving_mul_right h y) (fun x y => mul_inv_cancel_right x y)
    (fun x y => inv_mul_cancel_right x y) (fun _ _ => rfl) hVa
    (coarseP plaq χ κ h blk (blk.b ⁻¹' (V ∩ R)) y)
  have h3 : coarseP plaq χ κ h blk (blk.a ⁻¹' (V \ R))
      (coarseP plaq χ κ h blk (blk.b ⁻¹' (V ∩ R)) y) =
      coarseP plaq χ κ h blk (blk.a ⁻¹' (V \ R) ∪ blk.b ⁻¹' (V ∩ R)) y :=
    extProj_comp h (coarseLaw plaq χ κ h blk) (coarseLaw_eq_pi plaq χ hκ h blk hinj) _ _ y
  have hset : blk.a ⁻¹' (V \ R) ∪ blk.b ⁻¹' (V ∩ R) = {ē | blk.a ē ∈ V ∨ blk.b ē ∈ V} := by
    ext ē
    simp only [Set.mem_union, Set.mem_preimage, Set.mem_sdiff, Set.mem_inter_iff,
      Set.mem_ofPred_eq, R]
    constructor
    · rintro (⟨h1, -⟩ | ⟨h1, -⟩)
      · exact Or.inl h1
      · exact Or.inr h1
    · rintro (h1 | h1)
      · refine Or.inl ⟨h1, ?_⟩
        rintro ⟨ē', he, -⟩
        exact hab ē ē' he
      · by_cases ha' : blk.a ē ∈ V
        · refine Or.inl ⟨ha', ?_⟩
          rintro ⟨ē', he, -⟩
          exact hab ē ē' he
        · exact Or.inr ⟨h1, ē, rfl, ha'⟩
  rw [hsplit, h2, h1, h3, hset]

omit [Fintype E] [Fintype Ec] [MeasurableInv G] [IsProbabilityMeasure h]
  [Measure.IsMulLeftInvariant h] [Measure.IsMulRightInvariant h] in
/-- If every coarse link outside `T` has both fine links outside `V`, the blocking map is measurable
from the exterior σ-algebra of `V` to the coarse exterior σ-algebra of `T`. -/
theorem blockMap_measurable_extSigma_ext (blk : Blocking S E Sc Ec) {V : Set E} {T : Set Ec}
    (hV : ∀ ē, ē ∉ T → blk.a ē ∉ V ∧ blk.b ē ∉ V) :
    Measurable[extSigma (G := G) V, extSigma (G := G) T] (blockMap (G := G) blk) := by
  rw [measurable_iff_comap_le, MeasurableSpace.comap_le_iff_le_map]
  refine iSup₂_le fun ē hē => ?_
  rw [← MeasurableSpace.comap_le_iff_le_map, MeasurableSpace.comap_comp,
    ← measurable_iff_comap_le]
  exact (measurable_eval_extSigma (hV ē hē).1).mul (measurable_eval_extSigma (hV ē hē).2)

omit [Fintype Ec] in
/-- **`ran (J Pᶜ_T) ⊆ ran P_V`** (every `κ`): if every coarse link outside `T` has both fine links
outside `V`, then `P_V (J (Pᶜ_T y)) = J (Pᶜ_T y)`. -/
theorem wilsonP_fixes_wilsonJ_coarseP (blk : Blocking S E Sc Ec) {V : Set E} {T : Set Ec}
    (hV : ∀ ē, ē ∉ T → blk.a ē ∉ V ∧ blk.b ē ∉ V) (y : coarseY plaq χ κ h blk) :
    wilsonP plaq χ κ h V (wilsonJ plaq χ κ h blk (coarseP plaq χ κ h blk T y)) =
      wilsonJ plaq χ κ h blk (coarseP plaq χ κ h blk T y) := by
  apply wilsonP_fix_of_mem
  rw [show ((wilsonJ plaq χ κ h blk (coarseP plaq χ κ h blk T y) : wilsonH plaq χ κ h) :
      Lp ℝ 2 (wilsonMeasure plaq χ κ h)) =
      compL2 (wilsonMeasure plaq χ κ h) (measurePreserving_blockMap plaq χ κ h blk)
        ((coarseP plaq χ κ h blk T y : coarseY plaq χ κ h blk) :
          Lp ℝ 2 (coarseLaw plaq χ κ h blk)) from rfl, mem_lpMeas_iff_aestronglyMeasurable]
  have hmem : ((coarseP plaq χ κ h blk T y : coarseY plaq χ κ h blk) :
      Lp ℝ 2 (coarseLaw plaq χ κ h blk)) ∈
        lpMeas ℝ ℝ (extSigma T) 2 (coarseLaw plaq χ κ h blk) :=
    condL2_mem _ (extSigma_le T) _
  rw [mem_lpMeas_iff_aestronglyMeasurable] at hmem
  obtain ⟨g', hg', hgg'⟩ := hmem
  exact ⟨g' ∘ blockMap blk, hg'.comp_measurable (blockMap_measurable_extSigma_ext blk hV),
    (coeFn_compL2 _ _ _).trans
      ((measurePreserving_blockMap plaq χ κ h blk).quasiMeasurePreserving.ae_eq_comp hgg')⟩

end CoarseAction

/-! ## Covers of an exterior projection of a product measure -/

section ProductCover

open SchurSplit YangMills.StrongCoupling.CubeSplit YangMills.StrongCoupling.ConstrainedFibre

variable {S E G : Type*} [OrientedGraph S E] [Fintype E] [Group G] [MeasurableSpace G]
  [MeasurableMul₂ G] (h : Measure G) [IsProbabilityMeasure h]
  (μ : Measure (E → G)) [IsProbabilityMeasure μ] [SMulInvariantMeasure (Gauge S G) (E → G) μ]

/-- For a product measure and `V ⊆ W`: `‖u − P_V u‖² ≤ ‖u − P_W u‖²`. -/
theorem extProj_norm_sub_le_of_subset (hμ : μ = Measure.pi fun _ => h) {V W : Set E}
    (hVW : V ⊆ W) (u : cgL2 μ (Gauge S G)) :
    ‖u - (extProj μ V).P u‖ ^ 2 ≤ ‖u - (extProj μ W).P u‖ ^ 2 :=
  norm_sub_le_of_le (extProj μ W) (extProj μ V)
    (fun x => by rw [extProj_comp h μ hμ, Set.union_eq_right.2 hVW]) u

/-- **Covering bound for a product measure.** If `V ⊆ ⋃_{x ∈ s} T x`, then
`‖u − P_V u‖² ≤ ∑_{x ∈ s} ‖u − P_{T x} u‖²` on the centred gauge-invariant space. -/
theorem extProj_norm_sub_le_of_cover (hμ : μ = Measure.pi fun _ => h) {ι : Type*}
    (T : ι → Set E) (s : Finset ι) {V : Set E} (hV : V ⊆ {e | ∃ x ∈ s, e ∈ T x})
    (u : cgL2 μ (Gauge S G)) :
    ‖u - (extProj μ V).P u‖ ^ 2 ≤ ∑ x ∈ s, ‖u - (extProj μ (T x)).P u‖ ^ 2 := by
  have hV' : V ⊆ {e | ∃ x ∈ s.toList, e ∈ T x} := fun e he => by
    obtain ⟨x, hx, hex⟩ := hV he
    exact ⟨x, Finset.mem_toList.2 hx, hex⟩
  have h1 := extProj_norm_sub_le_of_subset h μ hμ hV' u
  rw [← sweepProd_extProj h μ hμ T s.toList u] at h1
  have h2 := norm_sub_sweepProd_sq_le (fun x => extProj μ (T x)) u s.toList
  rw [Finset.sum_map_toList] at h2
  exact h1.trans h2

end ProductCover

/-! ## Geometry of the straight blocking and side-2 cubes -/

section Geometry

open YangMills.StrongCoupling.WilsonSU2

/-- The coarse links met by the side-2 cube `cube2 M x`: those `ē` with `a ē` or `b ē` in the cube
(by `cube2_not_both` of Part X, never both). -/
def cubeTrace (M : ℕ) (x : Site (2 * M)) : Set (Link M) :=
  {ē | (straightBlocking M).a ē ∈ cube2 M x ∨ (straightBlocking M).b ē ∈ cube2 M x}

/-- The fine site `2z + ε` for a coarse site `z` and `ε ∈ {0,1}⁴`. -/
def fineSite (M : ℕ) (z : Site M) (ε : Fin 4 → Fin 2) : Site (2 * M) :=
  ιS M z + fun i => (((ε i : ℕ) : ZMod (2 * M)))

/-- The parity `∑ᵢ εᵢ mod 2` of `ε ∈ {0,1}⁴`. -/
def parity4 (ε : Fin 4 → Fin 2) : ZMod 2 := ∑ i, (((ε i : ℕ) : ZMod 2))

theorem dbl_natCast (M : ℕ) (k : ℕ) : dbl M (k : ZMod M) = 2 * (k : ZMod (2 * M)) := by
  have h := dbl_intCast M (k : ℤ)
  rw [Int.cast_natCast] at h
  rw [h]
  push_cast
  ring

/-- For `a ∈ {0,1}⁴` with `a_μ = 0` and each parity `p` there is `ε ∈ {0,1}⁴` of parity `p`
agreeing with `a` off `μ`. -/
theorem exists_parity4 : ∀ (a : Fin 4 → Fin 2) (μ : Fin 4), a μ = 0 → ∀ p : ZMod 2,
    ∃ ε : Fin 4 → Fin 2, parity4 ε = p ∧ ∀ i, i ≠ μ → ε i = a i := by
  unfold parity4
  decide +kernel

/-- If `ε` agrees with `a` off `μ` (and `a_μ = 0`), the coarse link `(z + a, μ)` of the coarse cube
at `z` is met by the fine cube at `2z + ε`. -/
theorem mem_cubeTrace_fineSite (M : ℕ) (z : Site M) (a : Fin 4 → Fin 2) {μ : Fin 4} (ha : a μ = 0)
    (ε : Fin 4 → Fin 2) (hε : ∀ i, i ≠ μ → ε i = a i) :
    ((z + fun i => (((a i : ℕ) : ZMod M))), μ) ∈ cubeTrace M (fineSite M z ε) := by
  have key : ∀ k : Fin 2, k = 0 ∨ k = 1 := by decide
  rcases key (ε μ) with h0 | h1
  · refine Or.inl ⟨a, ha, ?_⟩
    funext i
    simp only [straightBlocking, ιS, fineSite, Pi.add_apply, map_add, dbl_natCast]
    by_cases hi : i = μ
    · subst hi
      rw [ha, h0]
      simp
    · rw [hε i hi]
      ring
  · refine Or.inr ⟨a, ha, ?_⟩
    funext i
    simp only [straightBlocking, ιS, fineSite, Pi.add_apply, map_add, dbl_natCast, unitV]
    by_cases hi : i = μ
    · subst hi
      rw [ha, h1, Pi.single_eq_same]
      simp
    · rw [hε i hi, Pi.single_eq_of_ne hi]
      ring

/-- **Each parity class of fine cubes inside a coarse cube covers it:** for every parity `p`, the
side-2 coarse cube at `z` is covered by the sets `cubeTrace M (2z + ε)` with `parity4 ε = p`. -/
theorem sideTwoCube_subset_cover (M : ℕ) (z : Site M) (p : ZMod 2) :
    sideTwoCube M z ⊆ {e | ∃ ε ∈ Finset.univ.filter (fun ε => parity4 ε = p),
      e ∈ cubeTrace M (fineSite M z ε)} := by
  rintro ⟨w, μ⟩ ⟨a, ha, hw⟩
  obtain ⟨ε, hεp, hε⟩ := exists_parity4 a μ ha p
  refine ⟨ε, Finset.mem_filter.2 ⟨Finset.mem_univ _, hεp⟩, ?_⟩
  simp only at hw
  rw [hw]
  exact mem_cubeTrace_fineSite M z a ha ε hε

/-- `(z, ε) ↦ 2z + ε` is injective. -/
theorem fineSite_injective (M : ℕ) [NeZero M] :
    Function.Injective fun q : Site M × (Fin 4 → Fin 2) => fineSite M q.1 q.2 := by
  rintro ⟨z, ε⟩ ⟨z', ε'⟩ hq
  simp only at hq
  have key : ∀ q : ZMod M, ZMod.castHom (dvd_mul_right 2 M) (ZMod 2) (dbl M q) = 0 := by
    intro q
    obtain ⟨k, rfl⟩ := ZMod.intCast_surjective q
    rw [dbl_intCast, map_intCast]
    push_cast
    rw [show (2 : ZMod 2) = 0 by decide, zero_mul]
  have hk : ∀ k k' : Fin 2, ((k : ℕ) : ZMod 2) = ((k' : ℕ) : ZMod 2) → k = k' := by decide
  have hε : ε = ε' := by
    funext i
    have h1 := congrArg (ZMod.castHom (dvd_mul_right 2 M) (ZMod 2)) (congrFun hq i)
    simp only [fineSite, ιS, Pi.add_apply, map_add, key, zero_add, map_natCast] at h1
    exact hk _ _ h1
  subst hε
  have hz : ιS M z = ιS M z' := add_right_cancel hq
  exact Prod.ext ((straightBlocking M).inj hz) rfl

end Geometry

/-! ## `hResidual` with `X = 0` from a vanishing mixed block -/

section ResidualForm

open SchurSplit YangMills.StrongCoupling.CubeSplit

variable {H Y : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [NormedAddCommGroup Y]
  [InnerProductSpace ℝ Y] {D : H →ₗ[ℝ] H} {pj : OrthProj H} {Jt : H →ₗ[ℝ] Y} {Dc : Y →ₗ[ℝ] Y}

/-- If the mixed block vanishes and `β' ⟪J* v, D_c J* v⟫ ≤ ⟪v, C v⟫` on `H_c`, the certificate of
`CubeSplitInputs.gap_of_residual` holds with `X = 0`, for every `α` and `λ`. -/
theorem hResidual_zero_of_form (hB : ∀ v, pj.blkB D v = 0) {β' : ℝ}
    (hC : ∀ v : pj.Hc, β' * pj.gC Jt Dc v ≤ ⟪v, pj.blkC D v⟫_ℝ) (α lam : ℝ) (v : pj.Hc) :
    β' * pj.gC Jt Dc v + qForm (pj.blkA D) (pj.blkB D) α 0 v +
      ‖resid (pj.blkA D) (pj.blkB D) α 0 v‖ ^ 2 / (lam - α) ≤ ⟪v, pj.blkC D v⟫_ℝ := by
  rw [SmallCoupling.qForm_zero_trial, SmallCoupling.resid_zero_trial, hB v, norm_zero]
  simpa using hC v

end ResidualForm

/-! ## The SU(2) model at `β = 0`: a volume-uniform coarse comparison -/

section SU2Uniform

open SchurSplit YangMills.StrongCoupling.CubeSplit YangMills.StrongCoupling.WilsonSU2

variable (M : ℕ) [NeZero M]

/-- **At `β = 0` each fine cube projection acts on `ran J` as a coarse conditional expectation**
(SU(2) on `(ℤ/2Mℤ)⁴`, straight blocking, every `M ≥ 1`): `P_{cube2 M x} (J y) = J (Pᶜ_{T_x} y)`,
where `T_x = cubeTrace M x` is the set of coarse links one of whose two fine links lies in the
cube. -/
theorem su2P_wilsonJ_zero (x : Site (2 * M))
    (y : coarseY (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2 (straightBlocking M)) :
    su2P M 0 (cube2 M x) (su2J M 0 y) =
      su2J M 0 (coarseP (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2 (straightBlocking M)
        (cubeTrace M x) y) :=
  wilsonP_wilsonJ_eq plaqOf reTr (zero_div 2) haarSU2 (straightBlocking M)
    (straightBlocking_sumElim_injective M) (cube2 M x) y

/-- The fine form on `ran J` at `β = 0`:
`⟪J y, D J y⟫ = ∑ₓ (1/16) ‖y − Pᶜ_{T_x} y‖²`. -/
theorem su2_fine_form_zero
    (y : coarseY (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2 (straightBlocking M)) :
    ⟪su2J M 0 y, su2D M 0 (cube2 M) (fun _ => 1 / 16) (su2J M 0 y)⟫_ℝ =
      ∑ x, 1 / 16 * ‖y - coarseP (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2
        (straightBlocking M) (cubeTrace M x) y‖ ^ 2 := by
  have h := inner_cubeGen_eq (fun _ => (1 / 16 : ℝ))
    (fun x => wilsonPj (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2 (cube2 M x)) (su2J M 0 y)
  refine h.trans (Finset.sum_congr rfl fun x _ => ?_)
  have e := su2P_wilsonJ_zero M x y
  change (1 / 16 : ℝ) * ‖su2J M 0 y - su2P M 0 (cube2 M x) (su2J M 0 y)‖ ^ 2 = _
  rw [e, ← map_sub, LinearIsometry.norm_map]

/-- The coarse form at `β = 0`: `⟪y, D_c y⟫ = ∑_z (1/16) ‖y − Pᶜ_{V_z} y‖²` over the side-2
coarse cubes. -/
theorem su2_coarse_form_zero
    (y : coarseY (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2 (straightBlocking M)) :
    ⟪y, su2Dc M 0 (sideTwoCube M) (fun _ => 1 / 16) y⟫_ℝ =
      ∑ z, 1 / 16 * ‖y - coarseP (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2
        (straightBlocking M) (sideTwoCube M z) y‖ ^ 2 :=
  inner_cubeGen_eq (fun _ => (1 / 16 : ℝ))
    (fun z => extProj (coarseLaw (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2
      (straightBlocking M)) (sideTwoCube M z)) y

/-- **The volume-uniform coarse comparison at `β = 0`** (SU(2) on `(ℤ/2Mℤ)⁴`, straight blocking,
fine side-2 cubes `cube2 M x` at every base point and coarse side-2 cubes `sideTwoCube M z` at
every coarse base point, all weights `1/16`, every `M ≥ 1`):
`2 ⟪y, D_c y⟫ ≤ ⟪J y, D J y⟫` on the coarse space. The constant `2` does not depend on `M`. -/
theorem su2_coarse_comparison_zero
    (y : coarseY (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2 (straightBlocking M)) :
    2 * ⟪y, su2Dc M 0 (sideTwoCube M) (fun _ => 1 / 16) y⟫_ℝ ≤
      ⟪su2J M 0 y, su2D M 0 (cube2 M) (fun _ => 1 / 16) (su2J M 0 y)⟫_ℝ := by
  classical
  rw [su2_coarse_form_zero, su2_fine_form_zero]
  set f : Site (2 * M) → ℝ := fun x => ‖y - coarseP (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2)
    haarSU2 (straightBlocking M) (cubeTrace M x) y‖ ^ 2 with hf_def
  have hz : ∀ z, 2 * ‖y - coarseP (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2
      (straightBlocking M) (sideTwoCube M z) y‖ ^ 2 ≤ ∑ ε, f (fineSite M z ε) := by
    intro z
    have hp : ∀ p : ZMod 2, ‖y - coarseP (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2
        (straightBlocking M) (sideTwoCube M z) y‖ ^ 2 ≤
          ∑ ε ∈ Finset.univ.filter (fun ε => parity4 ε = p), f (fineSite M z ε) := fun p =>
      extProj_norm_sub_le_of_cover haarSU2 (coarseLaw (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2)
        haarSU2 (straightBlocking M)) (su2_coarseLaw_zero M)
        (fun ε => cubeTrace M (fineSite M z ε)) _ (sideTwoCube_subset_cover M z p) y
    calc 2 * ‖y - coarseP (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2
          (straightBlocking M) (sideTwoCube M z) y‖ ^ 2
        = ∑ _p : ZMod 2, ‖y - coarseP (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2
          (straightBlocking M) (sideTwoCube M z) y‖ ^ 2 := by
          rw [Finset.sum_const, Finset.card_univ, ZMod.card, nsmul_eq_mul]
          norm_num
      _ ≤ ∑ p : ZMod 2, ∑ ε ∈ Finset.univ.filter (fun ε => parity4 ε = p),
          f (fineSite M z ε) := Finset.sum_le_sum fun p _ => hp p
      _ = ∑ ε, f (fineSite M z ε) := Finset.sum_fiberwise _ _ _
  have hinj := fineSite_injective M
  calc 2 * ∑ z, 1 / 16 * ‖y - coarseP (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2
        (straightBlocking M) (sideTwoCube M z) y‖ ^ 2
      = ∑ z, 1 / 16 * (2 * ‖y - coarseP (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2
        (straightBlocking M) (sideTwoCube M z) y‖ ^ 2) := by
        rw [Finset.mul_sum]
        exact Finset.sum_congr rfl fun z _ => by ring
    _ ≤ ∑ z, 1 / 16 * ∑ ε, f (fineSite M z ε) :=
        Finset.sum_le_sum fun z _ => mul_le_mul_of_nonneg_left (hz z) (by norm_num)
    _ = ∑ q : Site M × (Fin 4 → Fin 2), 1 / 16 * f (fineSite M q.1 q.2) := by
        rw [Fintype.sum_prod_type]
        exact Finset.sum_congr rfl fun z _ => Finset.mul_sum _ _ _
    _ = ∑ x ∈ Finset.univ.image (fun q : Site M × (Fin 4 → Fin 2) => fineSite M q.1 q.2),
        1 / 16 * f x :=
        (Finset.sum_image (f := fun x => 1 / 16 * f x) (s := Finset.univ) hinj.injOn).symm
    _ ≤ ∑ x, 1 / 16 * f x :=
        Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _) fun x _ _ =>
          mul_nonneg (by norm_num) (sq_nonneg _)

/-- **The residual form bound with `β' = 2`** on `H_c` at `β = 0`:
`2 ⟪J* v, D_c J* v⟫ ≤ ⟪v, C v⟫` (every `M ≥ 1`). -/
theorem su2_gC_le_zero (v : (su2Pi M 0).Hc) :
    2 * (su2Pi M 0).gC (su2Jt M 0) (su2Dc M 0 (sideTwoCube M) (fun _ => 1 / 16)) v ≤
      ⟪v, (su2Pi M 0).blkC (su2D M 0 (cube2 M) (fun _ => 1 / 16)) v⟫_ℝ := by
  have hW := su2_inputs M 0 (cube2 M) (fun _ => 1 / 16) (sideTwoCube M) (fun _ => 1 / 16)
  have hv : su2J M 0 (su2Jt M 0 v) = (v : wilsonH (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2) :=
    (hW.JJt v).trans ((su2Pi M 0).P_of_mem_Hc v.2)
  rw [(su2Pi M 0).inner_blkC, OrthProj.gC]
  have h := su2_coarse_comparison_zero M (su2Jt M 0 v)
  rw [hv] at h
  exact h

/-- **`hResidual` for the SU(2) model at `β = 0` with a volume-independent constant**
(side-2 cubes `cube2 M x` with weights `1/16`, straight blocking, coarse cubes `sideTwoCube M z` with
weights `1/16`, every `M ≥ 1`): the certificate of `CubeSplitInputs.gap_of_residual` holds with the
trial operator `X = 0` and `β' = 2`, for every `α` and `λ`. -/
theorem su2_hResidual_zero_uniform (α lam : ℝ) (v : (su2Pi M 0).Hc) :
    (2 : ℝ) * (su2Pi M 0).gC (su2Jt M 0) (su2Dc M 0 (sideTwoCube M) (fun _ => 1 / 16)) v +
      qForm (E := (su2Pi M 0).Hf) (F := (su2Pi M 0).Hc)
        ((su2Pi M 0).blkA (su2D M 0 (cube2 M) (fun _ => 1 / 16)))
        ((su2Pi M 0).blkB (su2D M 0 (cube2 M) (fun _ => 1 / 16))) α
          (0 : (su2Pi M 0).Hc →ₗ[ℝ] (su2Pi M 0).Hf) v +
      ‖resid (E := (su2Pi M 0).Hf) (F := (su2Pi M 0).Hc)
        ((su2Pi M 0).blkA (su2D M 0 (cube2 M) (fun _ => 1 / 16)))
        ((su2Pi M 0).blkB (su2D M 0 (cube2 M) (fun _ => 1 / 16))) α
          (0 : (su2Pi M 0).Hc →ₗ[ℝ] (su2Pi M 0).Hf) v‖ ^ 2 / (lam - α) ≤
      ⟪v, (su2Pi M 0).blkC (su2D M 0 (cube2 M) (fun _ => 1 / 16)) v⟫_ℝ :=
  hResidual_zero_of_form (su2_blkB_zero M) (su2_gC_le_zero M) α lam v

/-- **A volume-uniform closed instance of the split at `β = 0`** (SU(2) on `(ℤ/2Mℤ)⁴`, every
`M ≥ 1`, straight blocking, fine side-2 cubes `cube2 M x` and coarse side-2 cubes `sideTwoCube M z`
at every base point, all weights `1/16`): `hWilson` is `su2_inputs`, `hFibre` holds with `λ = 1/16`,
every cube projection preserves `ran Π`, the residual input holds with `X = 0` and `β' = 2`, and
`hCoarseGap` holds with `ϖ_c = 1/16`; so `D ≥ min(α, 2 · (1/16)) I` for every `α < 1/16`. No
constant depends on `M`. Since `α < 1/16 < 1/8` the minimum is `α`: the bound is decided by
`λ = 1/16` and is implied by Part XV's `su2_fine_gap_zero`. -/
theorem su2_gap_closed_zero_uniform {α : ℝ} (hα : α < 1 / 16) :
    min α (2 * (1 / 16)) • LinearMap.id ≤ su2D M 0 (cube2 M) (fun _ => 1 / 16) :=
  SmallCoupling.gap_of_invariant
    (su2_inputs M 0 (cube2 M) (fun _ => 1 / 16) (sideTwoCube M) (fun _ => 1 / 16))
    (fun u hu => su2_hFibre_zero M u hu) hα (by norm_num) (su2_coarse_gap_zero M)
    (fun x z => wilsonP_mem_ranPi plaqOf reTr (zero_div 2) haarSU2 (straightBlocking M)
      (straightBlocking_sumElim_injective M) (cube2 M x) _ ((su2Pi M 0).idem z))
    (su2_gC_le_zero M)

/-- **The structural hypotheses of `poinc_of_lift` for single-link projections, discharged**
(SU(2) on `(ℤ/2Mℤ)⁴`, straight blocking, every `M ≥ 1`, every real `β`): with `R_e = P_{e}` the
single-link heat baths on the fine space and `Q_ē = Pᶜ_{ē}` those on the coarse space, a
single-link Poincaré inequality `c ‖J y‖² ≤ ∑ₑ ‖J y − P_{e} J y‖²` on `ran J` gives
`c ‖y‖² ≤ 2 ∑_ē ‖y − Pᶜ_{ē} y‖²` on the coarse space. Only the fine Poincaré inequality `hfine`
remains a hypothesis. -/
theorem su2_poinc_of_lift (β : ℝ) {c : ℝ}
    (hfine : ∀ y, c * ‖su2J M β y‖ ^ 2 ≤
      ∑ e, ‖su2J M β y - su2P M β {e} (su2J M β y)‖ ^ 2)
    (y : coarseY (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (straightBlocking M)) :
    c * ‖y‖ ^ 2 ≤ 2 * ∑ ē, ‖y - coarseP (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
      (straightBlocking M) {ē} y‖ ^ 2 := by
  classical
  have hinj := straightBlocking_sumElim_injective M
  have ha : Function.Injective (straightBlocking M).a := hinj.comp Sum.inl_injective
  have hb : Function.Injective (straightBlocking M).b := hinj.comp Sum.inr_injective
  have hab : ∀ x y, (straightBlocking M).a x ≠ (straightBlocking M).b y :=
    fun x y hxy => Sum.inl_ne_inr (hinj hxy)
  let S : Finset (Link (2 * M)) := Finset.univ.filter fun e =>
    ∃ ē, e = (straightBlocking M).a ē ∨ e = (straightBlocking M).b ē
  let φ : Link (2 * M) → Link M := fun e =>
    if hx : ∃ ē, e = (straightBlocking M).a ē ∨ e = (straightBlocking M).b ē then hx.choose
    else (0, 0)
  have hφ : ∀ e ∈ S, e = (straightBlocking M).a (φ e) ∨ e = (straightBlocking M).b (φ e) := by
    intro e he
    have hx : ∃ ē, e = (straightBlocking M).a ē ∨ e = (straightBlocking M).b ē :=
      (Finset.mem_filter.1 he).2
    simp only [φ, dif_pos hx]
    exact hx.choose_spec
  refine SmallCoupling.poinc_of_lift (su2J M β)
    (fun e => wilsonPj (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 {e})
    (fun j => SmallCoupling.su2CoarsePj M β {j}) S φ hfine ?_ ?_ ?_ y
  · intro e he y'
    refine wilsonP_fixes_wilsonJ _ _ _ _ (straightBlocking M) (fun ē => ⟨fun h1 => ?_, fun h1 => ?_⟩) y'
    · exact he (Finset.mem_filter.2 ⟨Finset.mem_univ _, ē, Or.inl (Set.mem_singleton_iff.1 h1).symm⟩)
    · exact he (Finset.mem_filter.2 ⟨Finset.mem_univ _, ē, Or.inr (Set.mem_singleton_iff.1 h1).symm⟩)
  · intro e he y'
    refine wilsonP_fixes_wilsonJ_coarseP _ _ _ (straightBlocking M)
      (fun ē hē => ⟨fun h1 => hē ?_, fun h1 => hē ?_⟩) y'
    · have h1' : (straightBlocking M).a ē = e := Set.mem_singleton_iff.1 h1
      rcases hφ e he with h2 | h2
      · exact Set.mem_singleton_iff.2 (ha (h1'.trans h2))
      · exact absurd (h1'.trans h2) (hab _ _)
    · have h1' : (straightBlocking M).b ē = e := Set.mem_singleton_iff.1 h1
      rcases hφ e he with h2 | h2
      · exact absurd (h1'.trans h2).symm (hab _ _)
      · exact Set.mem_singleton_iff.2 (hb (h1'.trans h2))
  · intro j
    have hsub : S.filter (fun e => φ e = j) ⊆
        {(straightBlocking M).a j, (straightBlocking M).b j} := by
      intro e he
      obtain ⟨heS, hej⟩ := Finset.mem_filter.1 he
      rcases hφ e heS with h2 | h2
      · rw [hej] at h2
        rw [h2]
        exact Finset.mem_insert_self _ _
      · rw [hej] at h2
        rw [h2]
        exact Finset.mem_insert_of_mem (Finset.mem_singleton_self _)
    have h3 := (Finset.card_le_card hsub).trans Finset.card_le_two
    exact_mod_cast h3

/-- **Non-vacuity of `su2_poinc_of_lift` at `β = 0`**: the product measure satisfies the fine
single-link Poincaré inequality with `c = 1` (Part XV's `extProj_gap_of_cover`), so the coarse
single-link Poincaré inequality `‖y‖² ≤ 2 ∑_ē ‖y − Pᶜ_{ē} y‖²` holds (every `M ≥ 1`). Applied
directly to the product coarse law, Part XV's `extProj_gap_of_cover` gives the stronger
`‖y‖² ≤ ∑_ē ‖y − Pᶜ_{ē} y‖²`; this instance only shows that `hfine` can be met. -/
theorem su2_coarse_poinc_zero
    (y : coarseY (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2 (straightBlocking M)) :
    ‖y‖ ^ 2 ≤ 2 * ∑ ē, ‖y - coarseP (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2
      (straightBlocking M) {ē} y‖ ^ 2 := by
  have h := su2_poinc_of_lift M 0 (c := 1) (fun y' => by
    have h1 := extProj_gap_of_cover haarSU2
      (wilsonMeasure (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2) (su2Wilson_zero M)
      (fun e : Link (2 * M) => ({e} : Set (Link (2 * M)))) (fun _ => (1 : ℝ)) zero_le_one
      (fun _ => le_rfl) (fun e => ⟨e, rfl⟩) (su2J M 0 y')
    rw [inner_cubeGen_eq (fun _ => (1 : ℝ)) (fun e => extProj
      (wilsonMeasure (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2)
      ({e} : Set (Link (2 * M)))) _] at h1
    simp only [one_mul] at h1 ⊢
    exact h1) y
  simpa only [one_mul] using h

end SU2Uniform

/-- **The constrained route of Part X at `β = 0` with volume-independent constants** (SU(2) on
`(ℤ/2Mℤ)⁴`, every `M ≥ 1`, straight blocking, fine side-2 cubes `cube2 M x` and coarse side-2
cubes `sideTwoCube M z` at every base point, all weights `1/16`, every `α < 1/2`): Part X's
`su2_gap_of_constrained` with `hcons` from `SkeletonCondExp.su2_hcons_zero_half` (`λ = 1/2`, through
Lemma IV), `hCoarseGap` from Part XV's `su2_coarse_gap_zero` (`ϖ_c = 1/16`) and `hResidual` from
`su2_hResidual_zero_uniform` (`X = 0`, `β' = 2`) gives `D ≥ min(α, 2 · (1/16)) I`; at `α = 1/8`
this is `D ≥ (1/8) I`; Part XV's direct bound `su2_fine_gap_zero` is `D ≥ (1/16) I`. No constant
depends on `M`; the coarse factor `β' ϖ_c = 1/8` is the bottleneck. For the product measure at
`β = 0` the elementary bound is `D ≥ (1/2) I`, four times larger, since every link lies in `8` of
the cubes (`SkeletonCondExp.su2_fine_gap_zero_half`). The content of this theorem is that the actual Wilson
operators meet every input of Part X's route with constants independent of `M`, not a better
gap. -/
theorem su2_gap_constrained_zero_uniform (M : ℕ) [NeZero M] {α : ℝ} (hα : α < 1 / 2) :
    min α (2 * (1 / 16)) • LinearMap.id ≤ su2D M 0 (cube2 M) (fun _ => 1 / 16) :=
  su2_gap_of_constrained M 0 (cube2 M) (fun _ => 1 / 16) (fun _ => by norm_num)
    (sideTwoCube M) (fun _ => 1 / 16) (SkeletonCondExp.su2_hcons_zero_half M) hα (by norm_num)
    (su2_coarse_gap_zero M) 0 (su2_hResidual_zero_uniform M α (1 / 2))

end YangMills.StrongCoupling.UniformEndpoint

/-! # Part XIX. `YangMills.StrongCoupling.GeneralBlocking`: the identification step for general gauge-covariant blockings (new; uses Parts II–IV and VI) -/

/-!
# General gauge-covariant coarse maps in the identification step `hWilson`

## (a) Formal target

Extend the identification step `hWilson` (the fields of `CubeSplit.CubeSplitInputs`) for the
finite-volume Wilson measure from Part IV's two-link `Blocking` to (1) any measurable coarse map
`c : (E → G) → (Ec → G)` with `c (g • U) = φ g • c U` for a surjective `φ` from fine to coarse
gauge transformations; (2) maps for which this covariance holds only almost everywhere for each
fixed `g`; (3) for `G = SU(2)`, the normalised path average `c(U)(ē) = Q_ē(U) / √det Q_ē(U)`,
`Q_ē(U) = ∑ᵢ wᵢ U(pᵢ)`, over finitely many fine paths `pᵢ` between the images of the endpoints of
each coarse link (the staple and connected box blockings can be written in this form; their path
families are not constructed here).

## (b) What is proved

* `compL2_mem_cgL2_ae`, `coarseJae`, `coarseJae_eq_coarseJ`, `condExp_inputs_ae`,
  `smulInvariant_map_ae`: Part III's coarse embedding, its identification inputs and the
  invariance of the pushforward law, with `c (γ • ω) = φ γ • c ω` assumed only `μ`-almost
  everywhere for each `γ`; with everywhere covariance `coarseJae` is Part III's `coarseJ`.
* `CoarseMap`, `AECoarseMap`, `CoarseMap.toAE`, `blockingCoarseMap`: gauge-covariant coarse
  maps (everywhere, or almost everywhere for a given measure); Part IV's two-link blocking is one.
* `mapLaw`, `mapY`, `mapJ`, `lawP`, `wilson_inputs_of_map` (Part III's `condExp_inputs` for the
  Wilson measure): for every such `c`, arbitrary link sets `Vₓ`, `V_z` and real weights, `D = ∑ₓ wₓ (I − Pₓ)`, `Pₓ = E_μ[· | outside Vₓ]`,
  `J g = g ∘ c`, `Π = J J*`, `J*` and `D_c = ∑_z w_z (I − E_{c_* μ}[· | outside V_z])` satisfy
  `CubeSplitInputs`. `mapLaw_blocking`, `mapJ_blocking`: for a two-link blocking these are
  Part IV's `coarseLaw` and `wilsonJ`.
* `aeLaw`, `aeY`, `aeJ`, `wilson_inputs_of_aeMap`: the same for almost-everywhere covariant maps.
* `FPath`, `pathProd`, `pathProd_smul`, `continuous_pathProd`: fine paths (links traversed forwards
  or backwards), their holonomies, which are transformed by `g` at the two endpoints.
* `quatSub`, `su2_mem_quatSub`, `quat_mul`, `qnorm`, `det_quat`, `eq_zero_of_qnorm`,
  `mul_star_of_quat`, `normalise_mem`, `nrmSU2`, `nrmSU2_coe`, `smul_nrmSU2`, `nrmSU2_conj`,
  `nrmSU2_su2`: SU(2) matrices have quaternion form `[[a, −b̄], [b, ā]]`, real combinations keep it,
  `det Q = |a|² + |b|² ≥ 0`, `Q = 0` iff `det Q = 0`, a nonzero `Q` is `√det Q` times an SU(2)
  matrix, and `nrm (a Q b⁻¹) = a · nrm Q · b⁻¹` for `a, b ∈ SU(2)`.
* `PathBlocking`, `qsum`, `avgMap`, `zeroSet`, `avgMap_smul_of_notMem`, `avgMap_ae_equiv`,
  `measurable_avgMap`, `avgCoarseMap`, `su2_inputs_of_paths`: the normalised path average (value
  `V₀` where `Q_ē = 0`) is measurable, covariant off the zero set `{U : some Q_ē(U) = 0}`, hence
  almost everywhere when that set is null for the product Haar measure, and then the SU(2) Wilson
  measure on any finite oriented lattice, at any coupling, satisfies `CubeSplitInputs` for it.
* `wsum_ne_zero_of_dominant`, `zeroSet_eq_empty_of_dominant`, `hnull_of_dominant`,
  `avgCoarseMapDom`, `su2_inputs_of_dominant`: if on every coarse link one weight exceeds the sum
  of the absolute values of the others, the zero set is empty, the map is covariant everywhere and
  `CubeSplitInputs` holds with no null-set hypothesis; in particular the null-set hypothesis of
  `su2_inputs_of_paths` is satisfiable, but only in this dominant case, where
  `su2_inputs_of_dominant` already applies without it; for non-dominant weights it is not proved.
* `twoLinkPath`, `blockingPathBlocking`, `avgMap_blocking`: a two-link blocking is a
  one-path blocking, and its normalised path average is Part IV's `blockMap`.

## (c) What remains open

`hFibre`, `hResidual` and `hCoarseGap` are not touched for any of these blockings: nothing here
is a gap, a split or a residual bound. For equal or otherwise non-dominant weights (for instance
the connected box blocking) the null-set hypothesis `hnull` of `su2_inputs_of_paths` (the zero
set of the real-analytic map `U ↦ Q_ē(U)` is Haar-null) is assumed, not proved, and the concrete
box paths on the periodic lattice are not constructed here. For signed weights `hnull` can fail
(one path taken twice with weights `1` and `−1` gives `Q_ē ≡ 0`). As in Part IV, the fields of
`CubeSplitInputs` are algebraic and hold for every such coarse map; that the coarse space `Y` is
nonzero is not shown for these maps (Part VI shows it for straight blocking, `M ≥ 2`).
`Π = E_μ[· | σ(c)]` on `H` is not formalised for these maps.

## (d) Axioms and checks

The module axiom audit covers every headline: each depends only on `propext`, `Classical.choice`
and `Quot.sound`, and the source contains no `sorry`, `admit`, `axiom` declarations,
`native_decide`, `implemented_by` or `set_option`.

## (e) Scope

This is not a proof of a mass gap. It extends the finite-volume identification step `hWilson` to
general gauge-covariant coarse maps; it proves no gap, no split and nothing about a continuum limit
for any of them.
-/

namespace YangMills.StrongCoupling.GeneralBlocking

open scoped InnerProductSpace
open MeasureTheory MeasureTheory.Measure SchurSplit YangMills.StrongCoupling.CubeSplit
