/-! ## Coarse maps that are equivariant only almost everywhere (abstract) -/

section AE

variable {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ]
  (Γ : Type*) [Group Γ] [MulAction Γ Ω] [MeasurableConstSMul Γ Ω] [SMulInvariantMeasure Γ Ω μ]
  {Ωc : Type*} [MeasurableSpace Ωc] (μc : Measure Ωc) [IsProbabilityMeasure μc]
  (Γc : Type*) [Group Γc] [MulAction Γc Ωc] [MeasurableConstSMul Γc Ωc]
  [SMulInvariantMeasure Γc Ωc μc]
  {c : Ω → Ωc} (hc : MeasurePreserving c μ μc)

include hc in
/-- **`J` maps coarse observables to fine ones under almost-everywhere equivariance.** If for each
`γ` the identity `c (γ • ω) = φ γ • c ω` holds for `μ`-almost every `ω`, composition with `c` maps
the centred `Γc`-invariant space of `μc` into the centred `Γ`-invariant space of `μ`. -/
theorem compL2_mem_cgL2_ae {φ : Γ → Γc} (hφ : ∀ γ, ∀ᵐ ω ∂μ, c (γ • ω) = φ γ • c ω)
    {g : Lp ℝ 2 μc} (hg : g ∈ cgL2 μc Γc) : compL2 μ hc g ∈ cgL2 μ Γ := by
  rw [cgL2, mem_invSub] at hg ⊢
  refine ⟨?_, fun γ => ?_⟩
  · rw [← compL2_one2 μ μc hc, LinearIsometry.inner_map_map]
    exact hg.1
  · conv_rhs => rw [← hg.2 (φ γ)]
    refine Lp.ext ?_
    have h1 := coeFn_compL2 μ (measurePreserving_smul γ μ) (compL2 μ hc g)
    have h2 := (measurePreserving_smul γ μ).quasiMeasurePreserving.ae_eq_comp
      (coeFn_compL2 μ hc g)
    have h3 := coeFn_compL2 μ hc (actL2 μc Γc (φ γ) g)
    have h4 := hc.quasiMeasurePreserving.ae_eq_comp
      (coeFn_compL2 μc (measurePreserving_smul (φ γ) μc) g)
    refine h1.trans (h2.trans (Filter.EventuallyEq.trans ?_ (h3.trans h4).symm))
    filter_upwards [hφ γ] with ω hω
    simp [Function.comp, hω]

/-- **The coarse embedding for an almost-everywhere equivariant map**: `J g = g ∘ c`, a linear
isometry from the centred `Γc`-invariant space of `μc` into the centred `Γ`-invariant space of
`μ`. -/
noncomputable def coarseJae {φ : Γ → Γc} (hφ : ∀ γ, ∀ᵐ ω ∂μ, c (γ • ω) = φ γ • c ω) :
    cgL2 μc Γc →ₗᵢ[ℝ] cgL2 μ Γ where
  toLinearMap := ((compL2 μ hc : Lp ℝ 2 μc →ₗ[ℝ] Lp ℝ 2 μ).comp (cgL2 μc Γc).subtype).codRestrict
    (cgL2 μ Γ) fun g => compL2_mem_cgL2_ae μ Γ μc Γc hc hφ g.2
  norm_map' g := (compL2 μ hc).norm_map (g : Lp ℝ 2 μc)

theorem coarseJae_coe {φ : Γ → Γc} (hφ : ∀ γ, ∀ᵐ ω ∂μ, c (γ • ω) = φ γ • c ω)
    (g : cgL2 μc Γc) : ((coarseJae μ Γ μc Γc hc hφ g : cgL2 μ Γ) : Lp ℝ 2 μ) = compL2 μ hc g :=
  rfl

/-- With everywhere equivariance, `coarseJae` is Part III's `coarseJ`. -/
theorem coarseJae_eq_coarseJ {φ : Γ → Γc} (hφ : ∀ γ ω, c (γ • ω) = φ γ • c ω) :
    coarseJae μ Γ μc Γc hc (fun γ => Eventually.of_forall (hφ γ)) = coarseJ μ Γ μc Γc hc hφ :=
  rfl

/-- **The identification inputs for an almost-everywhere equivariant coarse map.** As Part III's
`condExp_inputs`, with `c (γ • ω) = φ γ • c ω` required only `μ`-almost everywhere for each `γ`. -/
theorem condExp_inputs_ae {φ : Γ → Γc} (hφ : ∀ γ, ∀ᵐ ω ∂μ, c (γ • ω) = φ γ • c ω)
    {ι ιc : Type*} [Fintype ι] [Fintype ιc] (w : ι → ℝ) (mx : ι → MeasurableSpace Ω)
    (hmx : ∀ x, mx x ≤ ‹MeasurableSpace Ω›) (hstx : ∀ x, Stable Γ (mx x)) (wc : ιc → ℝ)
    (mz : ιc → MeasurableSpace Ωc) (hmz : ∀ z, mz z ≤ ‹MeasurableSpace Ωc›)
    (hstz : ∀ z, Stable Γc (mz z)) :
    CubeSplitInputs (cubeGen w fun x => cubeProj μ Γ (hmx x) (hstx x)) w
      (fun x => cubeProj μ Γ (hmx x) (hstx x)) (isoProj (coarseJae μ Γ μc Γc hc hφ))
      (coarseJae μ Γ μc Γc hc hφ : cgL2 μc Γc →ₗ[ℝ] cgL2 μ Γ)
      (isoAdj (coarseJae μ Γ μc Γc hc hφ) : cgL2 μ Γ →ₗ[ℝ] cgL2 μc Γc)
      (cubeGen wc fun z => cubeProj μc Γc (hmz z) (hstz z)) :=
  inputs_of_isometry w (fun x => cubeProj_isSymmetric μ Γ (hmx x) (hstx x)) _
    (cubeGen_isSymmetric wc fun z => cubeProj_isSymmetric μc Γc (hmz z) (hstz z))

end AE

section PushforwardAE

variable {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
  {Γ : Type*} [Group Γ] [MulAction Γ Ω] [SMulInvariantMeasure Γ Ω μ]
  {Ωc : Type*} [MeasurableSpace Ωc] {Γc : Type*} [Group Γc] [MulAction Γc Ωc]
  [MeasurableConstSMul Γc Ωc]

/-- **The blocked law is invariant under almost-everywhere equivariance.** If `c` is measurable,
`c (γ • ω) = φ γ • c ω` for `μ`-almost every `ω` (for each `γ`) and `φ` is surjective, then
`c_* μ` is `Γc`-invariant. -/
theorem smulInvariant_map_ae {c : Ω → Ωc} (hcm : Measurable c) {φ : Γ → Γc}
    (hφ : ∀ γ, ∀ᵐ ω ∂μ, c (γ • ω) = φ γ • c ω) (hsurj : Function.Surjective φ) :
    SMulInvariantMeasure Γc Ωc (μ.map c) where
  measure_preimage_smul h s hs := by
    obtain ⟨γ, rfl⟩ := hsurj h
    have hpre : c ⁻¹' ((φ γ • ·) ⁻¹' s) =ᵐ[μ] (γ • ·) ⁻¹' (c ⁻¹' s) := by
      filter_upwards [hφ γ] with ω hω
      show (φ γ • c ω ∈ s) = (c (γ • ω) ∈ s)
      rw [hω]
    rw [Measure.map_apply hcm (measurable_const_smul (φ γ) hs), Measure.map_apply hcm hs,
      measure_congr hpre, measure_preimage_smul]

end PushforwardAE

/-! ## General coarse maps for the Wilson model -/

open OrientedGraph

/-- **A gauge-covariant coarse map**: a measurable map `c` from fine to coarse link
configurations with `c (g • U) = φ g • c U` for every `g` and `U`, where `φ` from fine to coarse
gauge transformations is surjective. Part IV's two-link `Blocking` is one example
(`blockingCoarseMap`). -/
structure CoarseMap (S E Sc Ec G : Type*) [OrientedGraph S E] [OrientedGraph Sc Ec] [Group G]
    [MeasurableSpace G] where
  /-- The map on configurations. -/
  toFun : (E → G) → (Ec → G)
  meas : Measurable toFun
  /-- The induced coarse gauge transformation. -/
  φ : Gauge S G → Gauge Sc G
  surj : Function.Surjective φ
  equiv : ∀ g U, toFun (g • U) = φ g • toFun U

/-- **A coarse map that is gauge covariant almost everywhere**: for each fine gauge
transformation `g`, `c (g • U) = φ g • c U` holds for `μ`-almost every `U`. -/
structure AECoarseMap {S E G : Type*} [OrientedGraph S E] [Group G] [MeasurableSpace G]
    (μ : Measure (E → G)) (Sc Ec : Type*) [OrientedGraph Sc Ec] where
  /-- The map on configurations. -/
  toFun : (E → G) → (Ec → G)
  meas : Measurable toFun
  /-- The induced coarse gauge transformation. -/
  φ : Gauge S G → Gauge Sc G
  surj : Function.Surjective φ
  ae_equiv : ∀ g, ∀ᵐ U ∂μ, toFun (g • U) = φ g • toFun U

section Maps

variable {S E Sc Ec G : Type*} [OrientedGraph S E] [OrientedGraph Sc Ec] [Group G]
  [MeasurableSpace G]

/-- An everywhere covariant coarse map is covariant almost everywhere for every measure. -/
def CoarseMap.toAE (c : CoarseMap S E Sc Ec G) (μ : Measure (E → G)) : AECoarseMap μ Sc Ec where
  toFun := c.toFun
  meas := c.meas
  φ := c.φ
  surj := c.surj
  ae_equiv g := Eventually.of_forall (c.equiv g)

variable [MeasurableMul₂ G]

/-- **Part IV's two-link blocking is a coarse map**, with `φ g = g ∘ emb`. -/
def blockingCoarseMap
    (blk : Blocking S E Sc Ec) : CoarseMap S E Sc Ec G where
  toFun := blockMap blk
  meas := measurable_blockMap blk
  φ := coarseGauge blk
  surj := coarseGauge_surjective blk
  equiv := blockMap_smul blk

end Maps

/-! ## The coarse cube projections of any gauge-invariant coarse law -/

section CoarseCube

variable {Sc Ec G : Type*} [OrientedGraph Sc Ec] [Group G] [MeasurableSpace G]
  [MeasurableMul₂ G] [MeasurableInv G]
  (ν : Measure (Ec → G)) [IsProbabilityMeasure ν] [SMulInvariantMeasure (Gauge Sc G) (Ec → G) ν]

/-- The coarse cube projection `Pᶜ_z = E_ν[· | coarse links outside V_z]` on the centred
coarse-gauge-invariant `L²(ν)` space, for any coarse-gauge-invariant probability law `ν`. -/
noncomputable def lawP (V : Set Ec) : cgL2 ν (Gauge Sc G) →ₗ[ℝ] cgL2 ν (Gauge Sc G) :=
  cubeProj ν (Gauge Sc G) (extSigma_le V) (extSigma_stable V)

end CoarseCube

/-! ## `hWilson` for a general coarse map -/

section Inputs

variable {S E Sc Ec G : Type*} [OrientedGraph S E] [Fintype E] [OrientedGraph Sc Ec]
  [Group G] [MeasurableSpace G] [MeasurableMul₂ G] [MeasurableInv G]
  {Pl : Type*} [Fintype Pl] (plaq : Pl → Plaq S E) (χ : ClassFn G) (κ : ℝ)
  (h : Measure G) [IsProbabilityMeasure h] [IsMulLeftInvariant h] [IsMulRightInvariant h]

section Everywhere

variable (c : CoarseMap S E Sc Ec G)

/-- **The blocked law** `μ_c = c_* μ` of a general coarse map. -/
noncomputable def mapLaw : Measure (Ec → G) := (wilsonMeasure plaq χ κ h).map c.toFun

instance : IsProbabilityMeasure (mapLaw plaq χ κ h c) :=
  isProbabilityMeasure_map c.meas.aemeasurable

instance : SMulInvariantMeasure (Gauge Sc G) (Ec → G) (mapLaw plaq χ κ h c) :=
  smulInvariant_map (wilsonMeasure plaq χ κ h) c.meas c.equiv c.surj

omit [MeasurableMul₂ G] [MeasurableInv G] [IsProbabilityMeasure h] [IsMulLeftInvariant h]
  [IsMulRightInvariant h] in
theorem measurePreserving_mapLaw :
    MeasurePreserving c.toFun (wilsonMeasure plaq χ κ h) (mapLaw plaq χ κ h c) :=
  ⟨c.meas, rfl⟩

/-- **The coarse space** for `c`: centred, coarse-gauge-invariant `L²(c_* μ)`. -/
noncomputable abbrev mapY : Submodule ℝ (Lp ℝ 2 (mapLaw plaq χ κ h c)) :=
  cgL2 (mapLaw plaq χ κ h c) (Gauge Sc G)

/-- **The coarse embedding** `J g = g ∘ c` for a general coarse map (Part III's `coarseJ`). -/
noncomputable def mapJ : mapY plaq χ κ h c →ₗᵢ[ℝ] wilsonH plaq χ κ h :=
  coarseJ (wilsonMeasure plaq χ κ h) (Gauge S G) (mapLaw plaq χ κ h c) (Gauge Sc G)
    (measurePreserving_mapLaw plaq χ κ h c) c.equiv

/-- **`hWilson` for a general gauge-covariant coarse map.** For any measurable `c` with
`c (g • U) = φ g • c U` and `φ` surjective, arbitrary fine link sets `Vₓ`, real weights `wₓ`,
coarse link sets `V_z` and coarse weights `w_z`: `D = ∑ₓ wₓ (I − Pₓ)` with
`Pₓ = E_μ[· | outside Vₓ]` on `H`, `J g = g ∘ c`, `Π = J J*`, `J*` and
`D_c = ∑_z w_z (I − E_{c_* μ}[· | outside V_z])` satisfy every field of `CubeSplitInputs`. -/
theorem wilson_inputs_of_map {ι ιc : Type*} [Fintype ι] [Fintype ιc] (V : ι → Set E)
    (w : ι → ℝ) (Vc : ιc → Set Ec) (wc : ιc → ℝ) :
    CubeSplitInputs (cubeGen w fun x => wilsonP plaq χ κ h (V x)) w
      (fun x => wilsonP plaq χ κ h (V x)) (isoProj (mapJ plaq χ κ h c))
      (mapJ plaq χ κ h c : mapY plaq χ κ h c →ₗ[ℝ] wilsonH plaq χ κ h)
      (isoAdj (mapJ plaq χ κ h c) : wilsonH plaq χ κ h →ₗ[ℝ] mapY plaq χ κ h c)
      (cubeGen wc fun z => lawP (mapLaw plaq χ κ h c) (Vc z)) :=
  condExp_inputs (wilsonMeasure plaq χ κ h) (Gauge S G) (mapLaw plaq χ κ h c) (Gauge Sc G)
    (measurePreserving_mapLaw plaq χ κ h c) c.equiv w (fun x => extSigma (V x))
    (fun x => extSigma_le (V x)) (fun x => extSigma_stable (V x)) wc (fun z => extSigma (Vc z))
    (fun z => extSigma_le (Vc z)) (fun z => extSigma_stable (Vc z))

omit [MeasurableInv G] [IsProbabilityMeasure h] [IsMulLeftInvariant h] [IsMulRightInvariant h] in
/-- For Part IV's two-link blocking the blocked law and the embedding are those of Part IV, so
`wilson_inputs_of_map` contains Part IV's `wilson_inputs`. -/
theorem mapLaw_blocking (blk : Blocking S E Sc Ec) :
    mapLaw plaq χ κ h (blockingCoarseMap (G := G) blk) = coarseLaw plaq χ κ h blk := rfl

theorem mapJ_blocking (blk : Blocking S E Sc Ec) :
    mapJ plaq χ κ h (blockingCoarseMap (G := G) blk) = wilsonJ plaq χ κ h blk := rfl

end Everywhere

/-! ## `hWilson` for an almost-everywhere covariant coarse map -/

section AlmostEverywhere

variable (c : AECoarseMap (wilsonMeasure plaq χ κ h) Sc Ec)

/-- **The blocked law** `μ_c = c_* μ` of an almost-everywhere covariant coarse map. -/
noncomputable def aeLaw : Measure (Ec → G) := (wilsonMeasure plaq χ κ h).map c.toFun

instance : IsProbabilityMeasure (aeLaw plaq χ κ h c) :=
  isProbabilityMeasure_map c.meas.aemeasurable

instance : SMulInvariantMeasure (Gauge Sc G) (Ec → G) (aeLaw plaq χ κ h c) :=
  smulInvariant_map_ae c.meas c.ae_equiv c.surj

omit [MeasurableMul₂ G] [MeasurableInv G] [IsProbabilityMeasure h] [IsMulLeftInvariant h]
  [IsMulRightInvariant h] in
theorem measurePreserving_aeLaw :
    MeasurePreserving c.toFun (wilsonMeasure plaq χ κ h) (aeLaw plaq χ κ h c) :=
  ⟨c.meas, rfl⟩

/-- **The coarse space** for `c`: centred, coarse-gauge-invariant `L²(c_* μ)`. -/
noncomputable abbrev aeY : Submodule ℝ (Lp ℝ 2 (aeLaw plaq χ κ h c)) :=
  cgL2 (aeLaw plaq χ κ h c) (Gauge Sc G)

/-- **The coarse embedding** `J g = g ∘ c` for an almost-everywhere covariant coarse map. -/
noncomputable def aeJ : aeY plaq χ κ h c →ₗᵢ[ℝ] wilsonH plaq χ κ h :=
  coarseJae (wilsonMeasure plaq χ κ h) (Gauge S G) (aeLaw plaq χ κ h c) (Gauge Sc G)
    (measurePreserving_aeLaw plaq χ κ h c) c.ae_equiv

/-- **`hWilson` for an almost-everywhere covariant coarse map.** As `wilson_inputs_of_map`, with
`c (g • U) = φ g • c U` required only for `μ`-almost every `U` (for each `g`). -/
theorem wilson_inputs_of_aeMap {ι ιc : Type*} [Fintype ι] [Fintype ιc] (V : ι → Set E)
    (w : ι → ℝ) (Vc : ιc → Set Ec) (wc : ιc → ℝ) :
    CubeSplitInputs (cubeGen w fun x => wilsonP plaq χ κ h (V x)) w
      (fun x => wilsonP plaq χ κ h (V x)) (isoProj (aeJ plaq χ κ h c))
      (aeJ plaq χ κ h c : aeY plaq χ κ h c →ₗ[ℝ] wilsonH plaq χ κ h)
      (isoAdj (aeJ plaq χ κ h c) : wilsonH plaq χ κ h →ₗ[ℝ] aeY plaq χ κ h c)
      (cubeGen wc fun z => lawP (aeLaw plaq χ κ h c) (Vc z)) :=
  condExp_inputs_ae (wilsonMeasure plaq χ κ h) (Gauge S G) (aeLaw plaq χ κ h c) (Gauge Sc G)
    (measurePreserving_aeLaw plaq χ κ h c) c.ae_equiv w (fun x => extSigma (V x))
    (fun x => extSigma_le (V x)) (fun x => extSigma_stable (V x)) wc (fun z => extSigma (Vc z))
    (fun z => extSigma_le (Vc z)) (fun z => extSigma_stable (Vc z))

end AlmostEverywhere

end Inputs

/-! ## Fine paths and their holonomies -/

section Paths

universe u v

/-- A fine path from `x` to `y`: a finite sequence of links, each traversed forwards (`fwd`) or
backwards (`bwd`). -/
inductive FPath (S : Type u) (E : Type v) [OrientedGraph S E] : S → S → Type (max u v)
  | nil (x : S) : FPath S E x x
  | fwd (e : E) {y : S} (p : FPath S E (tgt e) y) : FPath S E (src e) y
  | bwd (e : E) {y : S} (p : FPath S E (src e) y) : FPath S E (tgt e) y

variable {S : Type u} {E : Type v} [OrientedGraph S E] {G : Type*} [Group G]

/-- The holonomy `U(p)` of a fine path: the ordered product of `U e` along forward links and
`(U e)⁻¹` along backward links. -/
def pathProd {x y : S} : FPath S E x y → (E → G) → G
  | .nil _, _ => 1
  | .fwd e p, U => U e * pathProd p U
  | .bwd e p, U => (U e)⁻¹ * pathProd p U

/-- **Gauge covariance of path holonomies**: `U(p)` is transformed by `g` at its two endpoints,
`(g • U)(p) = g x · U(p) · (g y)⁻¹`. -/
theorem pathProd_smul (g : Gauge S G) {x y : S} (p : FPath S E x y) (U : E → G) :
    pathProd p (g • U) = g x * pathProd p U * (g y)⁻¹ := by
  induction p with
  | nil x => simp [pathProd]
  | fwd e p ih =>
      simp only [pathProd]
      rw [ih, gauge_smul_apply]
      group
  | bwd e p ih =>
      simp only [pathProd]
      rw [ih, gauge_smul_apply]
      group

theorem continuous_pathProd [TopologicalSpace G] [IsTopologicalGroup G] {x y : S}
    (p : FPath S E x y) : Continuous (pathProd p : (E → G) → G) := by
  induction p with
  | nil x =>
      exact (continuous_const : Continuous fun _ : E → G => (1 : G)).congr fun U => by
        simp only [pathProd]
  | fwd e p ih =>
      exact ((continuous_apply e).mul ih).congr fun U => by
        simp only [pathProd, Pi.mul_apply]
  | bwd e p ih =>
      exact ((continuous_apply e).inv.mul ih).congr fun U => by
        simp only [pathProd, Pi.mul_apply, Pi.inv_apply]

/-- Transport of a path along equalities of its endpoints. -/
def FPath.cast {x y x' y' : S} (hx : x = x') (hy : y = y') (p : FPath S E x y) :
    FPath S E x' y' :=
  hx ▸ hy ▸ p

theorem pathProd_cast {x y x' y' : S} (hx : x = x') (hy : y = y') (p : FPath S E x y)
    (U : E → G) : pathProd (p.cast hx hy) U = pathProd p U := by
  subst hx
  subst hy
  rfl

end Paths

/-! ## Real combinations of SU(2) matrices (quaternion structure) -/

section Quaternion

open WilsonSU2

/-- The real subspace of quaternion-type `2 × 2` complex matrices `[[a, −b̄], [b, ā]]`. -/
def quatSub : Submodule ℝ (Matrix (Fin 2) (Fin 2) ℂ) where
  carrier := {Q | Q 1 1 = star (Q 0 0) ∧ Q 0 1 = -star (Q 1 0)}
  add_mem' {P Q} hP hQ := by
    obtain ⟨hP1, hP2⟩ := hP
    obtain ⟨hQ1, hQ2⟩ := hQ
    show (P + Q) 1 1 = star ((P + Q) 0 0) ∧ (P + Q) 0 1 = -star ((P + Q) 1 0)
    simp only [Matrix.add_apply, hP1, hQ1, hP2, hQ2, star_add, neg_add, and_self]
  zero_mem' := by simp
  smul_mem' r Q hQ := by
    obtain ⟨hQ1, hQ2⟩ := hQ
    show (r • Q) 1 1 = star ((r • Q) 0 0) ∧ (r • Q) 0 1 = -star ((r • Q) 1 0)
    simp only [Matrix.smul_apply, hQ1, hQ2, star_smul, star_trivial, smul_neg, and_self]

theorem mem_quatSub {Q : Matrix (Fin 2) (Fin 2) ℂ} :
    Q ∈ quatSub ↔ Q 1 1 = star (Q 0 0) ∧ Q 0 1 = -star (Q 1 0) := Iff.rfl

theorem det_su2 (a : SU2) : (a : Matrix (Fin 2) (Fin 2) ℂ).det = 1 :=
  (Matrix.mem_specialUnitaryGroup_iff.1 a.2).2

/-- **Every SU(2) matrix has quaternion form** `[[a, −b̄], [b, ā]]`: `U* = U⁻¹ = adj U`. -/
theorem su2_mem_quatSub (a : SU2) : (a : Matrix (Fin 2) (Fin 2) ℂ) ∈ quatSub := by
  have hstar : star (a : Matrix (Fin 2) (Fin 2) ℂ) = (a : Matrix (Fin 2) (Fin 2) ℂ).adjugate := by
    have h1 : (a : Matrix (Fin 2) (Fin 2) ℂ)⁻¹ = star (a : Matrix (Fin 2) (Fin 2) ℂ) :=
      Matrix.inv_eq_left_inv (Matrix.mem_unitaryGroup_iff'.1 (mem_unitary a))
    rw [← h1, Matrix.inv_def, det_su2 a, Ring.inverse_one, one_smul]
  have h00 := congrFun (congrFun hstar 0) 0
  have h01 := congrFun (congrFun hstar 0) 1
  rw [Matrix.star_apply, Matrix.adjugate_fin_two] at h00 h01
  simp only [Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.empty_val', Matrix.cons_val_fin_one] at h00 h01
  refine mem_quatSub.2 ⟨h00.symm, ?_⟩
  rw [h01, neg_neg]

/-- **Quaternion-type matrices are closed under products.** -/
theorem quat_mul {P Q : Matrix (Fin 2) (Fin 2) ℂ} (hP : P ∈ quatSub) (hQ : Q ∈ quatSub) :
    P * Q ∈ quatSub := by
  obtain ⟨hP1, hP2⟩ := mem_quatSub.1 hP
  obtain ⟨hQ1, hQ2⟩ := mem_quatSub.1 hQ
  refine mem_quatSub.2 ⟨?_, ?_⟩ <;>
    simp only [Matrix.mul_apply, Fin.sum_univ_two, hP1, hP2, hQ1, hQ2, star_add, star_mul',
      star_neg, star_star] <;> ring

/-- `|a|² + |b|²` for `Q = [[a, −b̄], [b, ā]]`; it equals `det Q` (`det_quat`). -/
noncomputable def qnorm (Q : Matrix (Fin 2) (Fin 2) ℂ) : ℝ :=
  Complex.normSq (Q 0 0) + Complex.normSq (Q 1 0)

theorem qnorm_nonneg (Q : Matrix (Fin 2) (Fin 2) ℂ) : 0 ≤ qnorm Q :=
  add_nonneg (Complex.normSq_nonneg _) (Complex.normSq_nonneg _)

theorem continuous_qnorm : Continuous qnorm :=
  (Complex.continuous_normSq.comp (continuous_id.matrix_elem 0 0)).add
    (Complex.continuous_normSq.comp (continuous_id.matrix_elem 1 0))

/-- **`det Q = |a|² + |b|²`** for a quaternion-type matrix; in particular `det Q` is real and
nonnegative. -/
theorem det_quat {Q : Matrix (Fin 2) (Fin 2) ℂ} (hQ : Q ∈ quatSub) :
    Q.det = (qnorm Q : ℂ) := by
  obtain ⟨hQ1, hQ2⟩ := mem_quatSub.1 hQ
  rw [Matrix.det_fin_two, hQ1, hQ2, qnorm, Complex.ofReal_add, ← Complex.mul_conj,
    ← Complex.mul_conj]
  simp only [Complex.star_def]
  ring

theorem eq_zero_of_qnorm {Q : Matrix (Fin 2) (Fin 2) ℂ} (hQ : Q ∈ quatSub) (h : qnorm Q = 0) :
    Q = 0 := by
  obtain ⟨hQ1, hQ2⟩ := mem_quatSub.1 hQ
  have ha := Complex.normSq_nonneg (Q 0 0)
  have hb := Complex.normSq_nonneg (Q 1 0)
  unfold qnorm at h
  have h0 : Q 0 0 = 0 := Complex.normSq_eq_zero.1 (by linarith)
  have h1 : Q 1 0 = 0 := Complex.normSq_eq_zero.1 (by linarith)
  ext i j
  fin_cases i <;> fin_cases j <;> simp [hQ1, hQ2, h0, h1]

theorem star_eq_adjugate_of_quat {Q : Matrix (Fin 2) (Fin 2) ℂ} (hQ : Q ∈ quatSub) :
    star Q = Q.adjugate := by
  obtain ⟨hQ1, hQ2⟩ := mem_quatSub.1 hQ
  ext i j
  fin_cases i <;> fin_cases j <;> simp [Matrix.adjugate_fin_two, hQ1, hQ2]

/-- `Q Q* = det Q · I = (|a|² + |b|²) I` for a quaternion-type matrix. -/
theorem mul_star_of_quat {Q : Matrix (Fin 2) (Fin 2) ℂ} (hQ : Q ∈ quatSub) :
    Q * star Q = (qnorm Q : ℂ) • (1 : Matrix (Fin 2) (Fin 2) ℂ) := by
  rw [star_eq_adjugate_of_quat hQ, Matrix.mul_adjugate, det_quat hQ]

theorem mem_SU2_of_quat {Q : Matrix (Fin 2) (Fin 2) ℂ} (hQ : Q ∈ quatSub) (h1 : qnorm Q = 1) :
    Q ∈ Matrix.specialUnitaryGroup (Fin 2) ℂ := by
  rw [Matrix.mem_specialUnitaryGroup_iff, Matrix.mem_unitaryGroup_iff]
  refine ⟨?_, ?_⟩
  · rw [mul_star_of_quat hQ, h1, Complex.ofReal_one, one_smul]
  · rw [det_quat hQ, h1, Complex.ofReal_one]

theorem qnorm_smul (r : ℝ) (Q : Matrix (Fin 2) (Fin 2) ℂ) : qnorm (r • Q) = r ^ 2 * qnorm Q := by
  simp only [qnorm, Matrix.smul_apply, Complex.real_smul, Complex.normSq_mul,
    Complex.normSq_ofReal]
  ring

theorem qnorm_pos {Q : Matrix (Fin 2) (Fin 2) ℂ} (hQ : Q ∈ quatSub) (h0 : Q ≠ 0) :
    0 < qnorm Q :=
  lt_of_le_of_ne (qnorm_nonneg Q) fun h => h0 (eq_zero_of_qnorm hQ h.symm)

/-- **A nonzero real combination of SU(2) matrices, divided by `√det`, lies in SU(2).** -/
theorem normalise_mem {Q : Matrix (Fin 2) (Fin 2) ℂ} (hQ : Q ∈ quatSub) (h0 : Q ≠ 0) :
    (Real.sqrt (qnorm Q))⁻¹ • Q ∈ Matrix.specialUnitaryGroup (Fin 2) ℂ := by
  have hpos := qnorm_pos hQ h0
  refine mem_SU2_of_quat (quatSub.smul_mem _ hQ) ?_
  rw [qnorm_smul, inv_pow, Real.sq_sqrt hpos.le, inv_mul_cancel₀ hpos.ne']

open Classical in
/-- **The SU(2) projection** `Q ↦ Q / √det Q` of a nonzero quaternion-type matrix, with the fixed
value `V₀` otherwise. -/
noncomputable def nrmSU2 (V0 : SU2) (Q : Matrix (Fin 2) (Fin 2) ℂ) : SU2 :=
  if hQ : Q ∈ quatSub ∧ Q ≠ 0 then ⟨(Real.sqrt (qnorm Q))⁻¹ • Q, normalise_mem hQ.1 hQ.2⟩
  else V0

theorem nrmSU2_coe (V0 : SU2) {Q : Matrix (Fin 2) (Fin 2) ℂ} (hQ : Q ∈ quatSub) (h0 : Q ≠ 0) :
    ((nrmSU2 V0 Q : SU2) : Matrix (Fin 2) (Fin 2) ℂ) = (Real.sqrt (qnorm Q))⁻¹ • Q := by
  unfold nrmSU2
  rw [dif_pos ⟨hQ, h0⟩]

theorem nrmSU2_zero (V0 : SU2) : nrmSU2 V0 0 = V0 := by
  unfold nrmSU2
  rw [dif_neg fun h => h.2 rfl]

/-- **`Q = √det Q · nrm Q`** for a nonzero quaternion-type matrix. -/
theorem smul_nrmSU2 (V0 : SU2) {Q : Matrix (Fin 2) (Fin 2) ℂ} (hQ : Q ∈ quatSub) (h0 : Q ≠ 0) :
    Real.sqrt (qnorm Q) • ((nrmSU2 V0 Q : SU2) : Matrix (Fin 2) (Fin 2) ℂ) = Q := by
  rw [nrmSU2_coe V0 hQ h0, smul_smul, mul_inv_cancel₀ (Real.sqrt_pos.2 (qnorm_pos hQ h0)).ne',
    one_smul]

/-- **Covariance of the SU(2) projection**: `nrm (a Q b⁻¹) = a · nrm Q · b⁻¹` for `a, b ∈ SU(2)`
and a nonzero quaternion-type `Q`. -/
theorem nrmSU2_conj (V0 : SU2) {Q : Matrix (Fin 2) (Fin 2) ℂ} (hQ : Q ∈ quatSub) (h0 : Q ≠ 0)
    (a b : SU2) :
    nrmSU2 V0 ((a : Matrix (Fin 2) (Fin 2) ℂ) * Q * ((b⁻¹ : SU2) : Matrix (Fin 2) (Fin 2) ℂ)) =
      a * nrmSU2 V0 Q * b⁻¹ := by
  have hQ' : (a : Matrix (Fin 2) (Fin 2) ℂ) * Q * ((b⁻¹ : SU2) : Matrix (Fin 2) (Fin 2) ℂ) ∈
      quatSub := quat_mul (quat_mul (su2_mem_quatSub a) hQ) (su2_mem_quatSub _)
  have hdet : ((a : Matrix (Fin 2) (Fin 2) ℂ) * Q *
      ((b⁻¹ : SU2) : Matrix (Fin 2) (Fin 2) ℂ)).det = Q.det := by
    rw [Matrix.det_mul, Matrix.det_mul, det_su2 a, det_su2 b⁻¹, one_mul, mul_one]
  have hn : qnorm ((a : Matrix (Fin 2) (Fin 2) ℂ) * Q *
      ((b⁻¹ : SU2) : Matrix (Fin 2) (Fin 2) ℂ)) = qnorm Q := by
    rw [det_quat hQ', det_quat hQ] at hdet
    exact_mod_cast hdet
  have h0' : (a : Matrix (Fin 2) (Fin 2) ℂ) * Q * ((b⁻¹ : SU2) : Matrix (Fin 2) (Fin 2) ℂ) ≠ 0 :=
    fun h => (qnorm_pos hQ h0).ne' (by rw [← hn, h]; simp [qnorm])
  apply Subtype.ext
  rw [nrmSU2_coe V0 hQ' h0', coe_mul, coe_mul, nrmSU2_coe V0 hQ h0, hn, Matrix.mul_smul,
    Matrix.smul_mul]

theorem nrmSU2_su2 (V0 A : SU2) : nrmSU2 V0 (A : Matrix (Fin 2) (Fin 2) ℂ) = A := by
  have hq : qnorm (A : Matrix (Fin 2) (Fin 2) ℂ) = 1 := by
    have h := det_quat (su2_mem_quatSub A)
    rw [det_su2] at h
    exact_mod_cast h.symm
  have h0 : (A : Matrix (Fin 2) (Fin 2) ℂ) ≠ 0 := fun h => by
    rw [h] at hq
    simp [qnorm] at hq
  apply Subtype.ext
  rw [nrmSU2_coe V0 (su2_mem_quatSub A) h0, hq, Real.sqrt_one, inv_one, one_smul]

/-- **A dominant path rules out `Q = 0`.** If one weight exceeds the sum of the absolute values of
the others, the real combination `∑ᵢ wᵢ Aᵢ` of SU(2) matrices is nonzero, since
`Re tr(A_{i₀}⁻¹ ∑ᵢ wᵢ Aᵢ) ≥ 2 w_{i₀} − 2 ∑_{i ≠ i₀} |wᵢ| > 0`. -/
theorem wsum_ne_zero_of_dominant {ι : Type*} [Fintype ι] [DecidableEq ι] (A : ι → SU2)
    (w : ι → ℝ) (i0 : ι) (hdom : ∑ i ∈ Finset.univ.erase i0, |w i| < w i0) :
    ∑ i, w i • (A i : Matrix (Fin 2) (Fin 2) ℂ) ≠ 0 := by
  intro hQ
  have key : ∑ i, w i * reTr.toFun ((A i0)⁻¹ * A i) = 0 := by
    have h1 : ((((A i0)⁻¹ : SU2) : Matrix (Fin 2) (Fin 2) ℂ) *
        ∑ i, w i • (A i : Matrix (Fin 2) (Fin 2) ℂ)).trace.re = 0 := by
      rw [hQ, Matrix.mul_zero, Matrix.trace_zero, Complex.zero_re]
    rw [Finset.mul_sum, Matrix.trace_sum, Complex.re_sum] at h1
    rw [← h1]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Matrix.mul_smul, Matrix.trace_smul, Complex.smul_re, smul_eq_mul]
    rfl
  have hsplit := Finset.add_sum_erase Finset.univ
    (fun i => w i * reTr.toFun ((A i0)⁻¹ * A i)) (Finset.mem_univ i0)
  simp only [inv_mul_cancel, reTr_one] at hsplit
  have hb : |∑ i ∈ Finset.univ.erase i0, w i * reTr.toFun ((A i0)⁻¹ * A i)| ≤
      ∑ i ∈ Finset.univ.erase i0, |w i| * 2 := by
    refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun i _ => ?_)
    rw [abs_mul]
    exact mul_le_mul_of_nonneg_left (reTr.abs_le _) (abs_nonneg _)
  rw [← Finset.sum_mul] at hb
  have hn := neg_abs_le (∑ i ∈ Finset.univ.erase i0, w i * reTr.toFun ((A i0)⁻¹ * A i))
  linarith

end Quaternion

/-! ## The normalised path average for SU(2) -/

section PathAverage

open WilsonSU2

/-- **A path blocking**: coarse sites embed by `emb`, and each coarse link `ē` carries a finite
family `i ↦ path ē i` of fine paths from `emb (src ē)` to `emb (tgt ē)` with real weights
`wt ē i` (for instance nonnegative weights summing to one). -/
structure PathBlocking (S E Sc Ec ι : Type*) [OrientedGraph S E] [OrientedGraph Sc Ec] where
  /-- The embedding of coarse sites. -/
  emb : Sc → S
  inj : Function.Injective emb
  /-- The fine paths of a coarse link. -/
  path : (e : Ec) → ι → FPath S E (emb (src e)) (emb (tgt e))
  /-- Their weights. -/
  wt : Ec → ι → ℝ

variable {S E Sc Ec ι : Type*} [OrientedGraph S E] [OrientedGraph Sc Ec] [Fintype ι]
  (pb : PathBlocking S E Sc Ec ι)

/-- The weighted sum `Q_ē(U) = ∑ᵢ wᵢ U(pᵢ)` of the path holonomies, a `2 × 2` complex matrix. -/
noncomputable def qsum (U : E → SU2) (e : Ec) : Matrix (Fin 2) (Fin 2) ℂ :=
  ∑ i, pb.wt e i • ((pathProd (pb.path e i) U : SU2) : Matrix (Fin 2) (Fin 2) ℂ)

theorem qsum_mem (U : E → SU2) (e : Ec) : qsum pb U e ∈ quatSub :=
  Submodule.sum_mem _ fun _ _ => Submodule.smul_mem _ _ (su2_mem_quatSub _)

/-- The induced coarse gauge transformation `g ↦ g ∘ emb`. -/
def pbGauge (g : Gauge S SU2) : Gauge Sc SU2 := fun y => g (pb.emb y)

omit [Fintype ι] in
theorem pbGauge_surjective : Function.Surjective (pbGauge pb) := fun hc =>
  ⟨Function.extend pb.emb hc 1, funext fun y => pb.inj.extend_apply hc 1 y⟩

/-- **Covariance of the weighted sum**: `Q_ē(g • U) = g(x) Q_ē(U) g(y)⁻¹` with
`x = emb (src ē)`, `y = emb (tgt ē)`. -/
theorem qsum_smul (g : Gauge S SU2) (U : E → SU2) (e : Ec) :
    qsum pb (g • U) e = ((g (pb.emb (src e)) : SU2) : Matrix (Fin 2) (Fin 2) ℂ) * qsum pb U e *
      (((g (pb.emb (tgt e)))⁻¹ : SU2) : Matrix (Fin 2) (Fin 2) ℂ) := by
  simp only [qsum, pathProd_smul, coe_mul, Finset.mul_sum, Finset.sum_mul, Matrix.mul_smul,
    Matrix.smul_mul]

/-- **The normalised path average** `c(U)(ē) = Q_ē(U) / √det Q_ē(U)` (the SU(2) projection of the
weighted sum of the path holonomies), with the fixed value `V₀` where `Q_ē(U) = 0`. -/
noncomputable def avgMap (V0 : SU2) (U : E → SU2) : Ec → SU2 := fun e => nrmSU2 V0 (qsum pb U e)

/-- The configurations at which some weighted sum `Q_ē` vanishes. -/
def zeroSet : Set (E → SU2) := {U | ∃ e, qsum pb U e = 0}

/-- **Covariance off the zero set**: `c(g • U) = (g ∘ emb) • c(U)` whenever no `Q_ē(U)` vanishes. -/
theorem avgMap_smul_of_notMem (V0 : SU2) (g : Gauge S SU2) {U : E → SU2} (hU : U ∉ zeroSet pb) :
    avgMap pb V0 (g • U) = pbGauge pb g • avgMap pb V0 U := by
  funext e
  have h0 : qsum pb U e ≠ 0 := fun h => hU ⟨e, h⟩
  rw [gauge_smul_apply]
  simp only [avgMap]
  rw [qsum_smul, nrmSU2_conj V0 (qsum_mem pb U e) h0]
  rfl

/-- **No zero set for dominant weights.** If on every coarse link one path weight exceeds the
sum of the absolute values of the others, no `Q_ē(U)` vanishes. -/
theorem zeroSet_eq_empty_of_dominant [DecidableEq ι]
    (hdom : ∀ e, ∃ i0, ∑ i ∈ Finset.univ.erase i0, |pb.wt e i| < pb.wt e i0) :
    zeroSet pb = ∅ := by
  ext U
  simp only [zeroSet, Set.mem_ofPred_eq, Set.mem_empty_iff_false, iff_false, not_exists]
  intro e
  obtain ⟨i0, hi0⟩ := hdom e
  exact wsum_ne_zero_of_dominant (fun i => pathProd (pb.path e i) U) (pb.wt e) i0 hi0

/-- **Almost-everywhere covariance**: if the zero set is `μ`-null, then for each `g`,
`c(g • U) = (g ∘ emb) • c(U)` for `μ`-almost every `U`. -/
theorem avgMap_ae_equiv (V0 : SU2) {μ : Measure (E → SU2)} (hnull : μ (zeroSet pb) = 0)
    (g : Gauge S SU2) : ∀ᵐ U ∂μ, avgMap pb V0 (g • U) = pbGauge pb g • avgMap pb V0 U := by
  filter_upwards [measure_eq_zero_iff_ae_notMem.1 hnull] with U hU
  exact avgMap_smul_of_notMem pb V0 g hU

theorem continuous_qsum (e : Ec) : Continuous fun U : E → SU2 => qsum pb U e := by
  unfold qsum
  refine continuous_finsetSum _ fun i _ => ?_
  have h1 : Continuous fun U : E → SU2 =>
      ((pathProd (pb.path e i) U : SU2) : Matrix (Fin 2) (Fin 2) ℂ) :=
    continuous_subtype_val.comp (continuous_pathProd _)
  exact h1.const_smul (pb.wt e i)

/-- The configurations at which `Q_ē` does not vanish, an open set. -/
def nzSet (e : Ec) : Set (E → SU2) := {U | qsum pb U e ≠ 0}

variable [Fintype E]

/-- **The normalised path average is measurable**: it is continuous on the open set where
`Q_ē ≠ 0` and constant on its complement. -/
theorem measurable_avgMap (V0 : SU2) : Measurable (avgMap pb V0 : (E → SU2) → Ec → SU2) := by
  classical
  refine measurable_pi_lambda _ fun e => ?_
  have hs : IsOpen (nzSet pb e) := isOpen_ne_fun (continuous_qsum pb e) continuous_const
  let F : nzSet pb e → SU2 := fun U =>
    ⟨(Real.sqrt (qnorm (qsum pb U.1 e)))⁻¹ • qsum pb U.1 e, normalise_mem (qsum_mem pb U.1 e) U.2⟩
  have hF : Continuous F := by
    refine Continuous.subtype_mk ?_ _
    have hq : Continuous fun U : nzSet pb e => qsum pb U.1 e :=
      (continuous_qsum pb e).comp continuous_subtype_val
    refine Continuous.smul
      (f := fun U : nzSet pb e => (Real.sqrt (qnorm (qsum pb U.1 e)))⁻¹) ?_ hq
    exact (Real.continuous_sqrt.comp (continuous_qnorm.comp hq)).inv₀ fun U =>
      (Real.sqrt_pos.2 (qnorm_pos (qsum_mem pb U.1 e) U.2)).ne'
  have heq : (fun U => avgMap pb V0 U e) =
      fun U => if hU : U ∈ nzSet pb e then F ⟨U, hU⟩ else
        (fun _ : ((nzSet pb e)ᶜ : Set (E → SU2)) => V0) ⟨U, hU⟩ := by
    funext U
    by_cases hU : U ∈ nzSet pb e
    · rw [dif_pos hU]
      exact Subtype.ext (nrmSU2_coe V0 (qsum_mem pb U e) hU)
    · rw [dif_neg hU]
      have h0 : qsum pb U e = 0 := not_not.1 hU
      simp only [avgMap, h0, nrmSU2_zero]
  rw [heq]
  exact Measurable.dite hF.measurable measurable_const hs.measurableSet

/-- **The normalised path average with dominant weights is an everywhere covariant coarse map**
(so `wilson_inputs_of_map` applies to it directly, see `su2_inputs_of_dominant`). -/
noncomputable def avgCoarseMapDom [DecidableEq ι] (V0 : SU2)
    (hdom : ∀ e, ∃ i0, ∑ i ∈ Finset.univ.erase i0, |pb.wt e i| < pb.wt e i0) :
    CoarseMap S E Sc Ec SU2 where
  toFun := avgMap pb V0
  meas := measurable_avgMap pb V0
  φ := pbGauge pb
  surj := pbGauge_surjective pb
  equiv g U := avgMap_smul_of_notMem pb V0 g (by
    rw [zeroSet_eq_empty_of_dominant pb hdom]
    exact Set.notMem_empty U)

/-- **The zero-set hypothesis `hnull` is satisfiable**: it holds whenever the weights are
dominant on every coarse link (the zero set is then empty, and `su2_inputs_of_dominant` applies
without `hnull`). -/
theorem hnull_of_dominant [DecidableEq ι]
    (hdom : ∀ e, ∃ i0, ∑ i ∈ Finset.univ.erase i0, |pb.wt e i| < pb.wt e i0) :
    Measure.pi (fun _ : E => haarSU2) (zeroSet pb) = 0 := by
  rw [zeroSet_eq_empty_of_dominant pb hdom, measure_empty]

/-- **The normalised path average as an almost-everywhere covariant coarse map** for the SU(2)
Wilson measure (any finite oriented lattice with plaquettes `plaq`, any coupling `κ`), given that
the zero set `{U : some Q_ē(U) = 0}` is null for the product Haar measure (`hnull`). -/
noncomputable def avgCoarseMap {Pl : Type*} [Fintype Pl] (plaq : Pl → Plaq S E) (κ : ℝ)
    (V0 : SU2) (hnull : Measure.pi (fun _ : E => haarSU2) (zeroSet pb) = 0) :
    AECoarseMap (wilsonMeasure plaq reTr κ haarSU2) Sc Ec where
  toFun := avgMap pb V0
  meas := measurable_avgMap pb V0
  φ := pbGauge pb
  surj := pbGauge_surjective pb
  ae_equiv := avgMap_ae_equiv pb V0 (tilted_absolutelyContinuous _ _ hnull)

/-- **`hWilson` for the SU(2) normalised path-average blocking.** For the SU(2) Wilson measure
`Z⁻¹ exp(κ ∑ₚ Re tr U_p) ∏ₑ h(dUₑ)` on any finite oriented lattice, any path blocking `pb`
(finitely many fine paths between the images of the endpoints of each coarse link, real weights),
the coarse map `c(U)(ē) = Q_ē(U) / √det Q_ē(U)` (value `V₀` where `Q_ē(U) = 0`), and assuming the
zero set is Haar-null (`hnull`): for arbitrary fine and coarse link sets and weights, the operators
`D = ∑ₓ wₓ (I − Pₓ)`, `Pₓ`, `Π = J J*`, `J g = g ∘ c`, `J*` and `D_c = ∑_z w_z (I − Pᶜ_z)` satisfy
every field of `CubeSplitInputs`. -/
theorem su2_inputs_of_paths {Pl : Type*} [Fintype Pl] (plaq : Pl → Plaq S E) (κ : ℝ) (V0 : SU2)
    (hnull : Measure.pi (fun _ : E => haarSU2) (zeroSet pb) = 0) {ιx ιc : Type*} [Fintype ιx]
    [Fintype ιc] (V : ιx → Set E) (w : ιx → ℝ) (Vc : ιc → Set Ec) (wc : ιc → ℝ) :
    CubeSplitInputs (cubeGen w fun x => wilsonP plaq reTr κ haarSU2 (V x)) w
      (fun x => wilsonP plaq reTr κ haarSU2 (V x))
      (isoProj (aeJ plaq reTr κ haarSU2 (avgCoarseMap pb plaq κ V0 hnull)))
      (aeJ plaq reTr κ haarSU2 (avgCoarseMap pb plaq κ V0 hnull) :
        aeY plaq reTr κ haarSU2 (avgCoarseMap pb plaq κ V0 hnull) →ₗ[ℝ]
          wilsonH plaq reTr κ haarSU2)
      (isoAdj (aeJ plaq reTr κ haarSU2 (avgCoarseMap pb plaq κ V0 hnull)) :
        wilsonH plaq reTr κ haarSU2 →ₗ[ℝ]
          aeY plaq reTr κ haarSU2 (avgCoarseMap pb plaq κ V0 hnull))
      (cubeGen wc fun z => lawP (aeLaw plaq reTr κ haarSU2 (avgCoarseMap pb plaq κ V0 hnull))
        (Vc z)) :=
  wilson_inputs_of_aeMap plaq reTr κ haarSU2 (avgCoarseMap pb plaq κ V0 hnull) V w Vc wc

/-- **`hWilson` for the SU(2) normalised path average with dominant weights**, with no null-set
hypothesis: if on every coarse link one path weight exceeds the sum of the absolute values of the
others (for instance a single path, or the straight path with weight `1 − s` and staples of total
weight `s < 1/2`), the coarse map is covariant everywhere and every field of `CubeSplitInputs`
holds, for arbitrary fine and coarse link sets and weights. -/
theorem su2_inputs_of_dominant {Pl : Type*} [Fintype Pl] (plaq : Pl → Plaq S E) (κ : ℝ)
    [DecidableEq ι] (V0 : SU2)
    (hdom : ∀ e, ∃ i0, ∑ i ∈ Finset.univ.erase i0, |pb.wt e i| < pb.wt e i0) {ιx ιc : Type*}
    [Fintype ιx] [Fintype ιc] (V : ιx → Set E) (w : ιx → ℝ) (Vc : ιc → Set Ec) (wc : ιc → ℝ) :
    CubeSplitInputs (cubeGen w fun x => wilsonP plaq reTr κ haarSU2 (V x)) w
      (fun x => wilsonP plaq reTr κ haarSU2 (V x))
      (isoProj (mapJ plaq reTr κ haarSU2 (avgCoarseMapDom pb V0 hdom)))
      (mapJ plaq reTr κ haarSU2 (avgCoarseMapDom pb V0 hdom) :
        mapY plaq reTr κ haarSU2 (avgCoarseMapDom pb V0 hdom) →ₗ[ℝ] wilsonH plaq reTr κ haarSU2)
      (isoAdj (mapJ plaq reTr κ haarSU2 (avgCoarseMapDom pb V0 hdom)) :
        wilsonH plaq reTr κ haarSU2 →ₗ[ℝ] mapY plaq reTr κ haarSU2 (avgCoarseMapDom pb V0 hdom))
      (cubeGen wc fun z => lawP (mapLaw plaq reTr κ haarSU2 (avgCoarseMapDom pb V0 hdom))
        (Vc z)) :=
  wilson_inputs_of_map plaq reTr κ haarSU2 (avgCoarseMapDom pb V0 hdom) V w Vc wc

end PathAverage

/-! ## Part IV's two-link blocking as a one-path blocking -/

section TwoLink

open WilsonSU2

variable {S E Sc Ec : Type*} [OrientedGraph S E] [OrientedGraph Sc Ec]

/-- The fine path `a ē` followed by `b ē` of a two-link blocking. -/
def twoLinkPath (blk : Blocking S E Sc Ec) (e : Ec) :
    FPath S E (blk.emb (src e)) (blk.emb (tgt e)) :=
  (FPath.fwd (blk.a e) ((FPath.fwd (blk.b e) (FPath.nil _)).cast (blk.tgt_a e).symm rfl)).cast
    (blk.src_a e) (blk.tgt_b e)

theorem pathProd_twoLinkPath {G : Type*} [Group G] (blk : Blocking S E Sc Ec) (e : Ec)
    (U : E → G) : pathProd (twoLinkPath blk e) U = U (blk.a e) * U (blk.b e) := by
  simp only [twoLinkPath, pathProd_cast, pathProd, mul_one]

/-- A two-link blocking as a path blocking with one path of weight one per coarse link. -/
def blockingPathBlocking
    (blk : Blocking S E Sc Ec) : PathBlocking S E Sc Ec Unit where
  emb := blk.emb
  inj := blk.inj
  path e _ := twoLinkPath blk e
  wt _ _ := 1

/-- **For a two-link blocking the normalised path average is Part IV's `blockMap`.** -/
theorem avgMap_blocking (blk : Blocking S E Sc Ec) (V0 : SU2) :
    avgMap (blockingPathBlocking blk) V0 = blockMap blk := by
  funext U e
  simp only [avgMap, qsum, blockingPathBlocking, Finset.univ_unique, Finset.sum_singleton,
    one_smul, pathProd_twoLinkPath, nrmSU2_su2]
  rfl

end TwoLink

end YangMills.StrongCoupling.GeneralBlocking

/-! # Part XXI. `YangMills.StrongCoupling.SweepContraction`: a sweep contraction on `ker Π` and the constrained fibre bound `hcons` at small `|β|`, conditional on one named influence hypothesis (new; uses Parts I–IV, VI, X, XII, XV and XVII) -/

/-!
# Sweep contraction for the constrained heat baths at small coupling

## (a) Formal target

Part XII's `hcons_of_sweeps` and `su2_hFibre_of_sweeps` turn a contraction
`‖Q_j u‖ ≤ θ ‖u‖` on `H ∩ ker Π` (the hypothesis `hsweep`) into `hcons` and `hFibre`. Here
`Q_j` is the sweep of the constrained cube projections `P'ₓ = E_μ[· | links outside cube2 M x ∖ Sk]`
along the parity family `j` (Part XVII). The target is `hsweep` for the SU(2) Wilson measure
`μ(dU) = Z⁻¹ exp((β/2) ∑ₚ Re tr U_p) ∏ₑ dUₑ` on `(ℤ/2Mℤ)⁴` at `β ≠ 0`. Here `β` is the Wilson coupling
`β_W` of Part VI, with `κ = β/2`, straight blocking and every `M ≥ 1`. The route is a Dobrushin-type
influence bound for the block heat baths, with the analytic estimate isolated as one named
hypothesis.

## (b) What is proved

* Abstract, for orthogonal projections `Pᵢ` that resample blocks `Bᵢ` of a finite coordinate set `J`
  (`InfluenceBound`: a domain `D`, functionals `δⱼ ≥ 0` killed by `Pᵢ` on `Bᵢ`, influences
  `δⱼ(Pᵢ f) ≤ δⱼ f + c j i ∑_{k ∈ Bᵢ} δₖ f`, column sums `∑_{j ∉ Bᵢ} c j i ≤ θ` and
  `‖f‖ ≤ K ∑ⱼ δⱼ f` on `D`):
  - `oscPot_step`, `InfluenceBound.oscPot_sweep`: a weighted potential (weight `1` on resampled
    coordinates, `θ` elsewhere) does not increase along a sweep when `0 ≤ θ ≤ 1`;
  - `InfluenceBound.osc_sweep_le`: a sweep whose blocks cover `J` contracts `∑ⱼ δⱼ` by `θ`
    itself (an earlier recursion in the research notes gave only `θ/(1 − θ)`);
  - `sweepProd_append`, `inner_sweepProd_reverse`: the adjoint of a sweep is the reversed sweep;
  - `InfluenceBound.norm_sweep_le`: `‖Q f‖ ≤ θ ‖f‖` on `D`, from `T = Q* Q` and log-convexity
    (Part X's `norm_apply_le_of_pow_decay`);
  - `norm_sweep_le_of_closure`, `InfluenceBound.hsweep`: the bound extends to the closure of `D`. Hence
    it holds on `ker Π` when `ker Π ⊆ closure D`, in exactly the form of `hsweep`;
  - `norm_sub_sweepProd_le`: `‖u − Q u‖ ≤ ∑ᵢ ‖u − Pᵢ u‖`;
  - `tilt_tv_core`: the real inequality behind `TV(μ, e^h μ / Z) ≤ tanh(osc h / 4)`.
* SU(2), `μ ∝ exp((β/2) ∑ₚ Re tr U_p)`, `(ℤ/2Mℤ)⁴`, every `M ≥ 1`, every real `β`:
  - `NSk`, `su2Block`, `su2ConstrPj`: the non-skeleton links, the blocks `cube2 M x ∖ Sk` and the
    constrained projections;
  - `SU2HeatBathInfluence M β θ`, **the one named analytic hypothesis**: an `InfluenceBound` for the
    constrained heat baths, with column sums `≤ θ`, on a domain inside `H ∩ ker E_μ[· | σ(Sk)]` that
    is dense there;
  - `su2_hsweep_of_influence`: `hsweep` with constant `θ` for each of the `8` parity families. Lemma IV
    (`su2_skel_eq_Pi`) turns `Π u = 0` into `E_μ[u | σ(Sk)] = 0`;
  - `su2_hcons_of_influence`, `su2_hFibre_of_influence`: `hcons` and `hFibre` with
    `λ = (1/2)(1 − θ)²` for `0 ≤ θ ≤ 1`, for the side-2 cubes at every base point with weights `1/16`;
  - `su2_gap_of_influence`: Part X's `su2_gap_of_constrained` with this `hcons`;
  - `su2_hcons_small_beta`: the same with `θ = 228 |β|` and `|β| ≤ 1/228`, still conditional
    on the named hypothesis;
  - `su2_influence_zero`, `su2_influence_zero_nonempty`: the named hypothesis holds at `β = 0` with
    `θ = 0` (`δₑ f = ‖f − P_{{e}} f‖`, `c = 0`, `K = 1`), so it is not vacuous.

## (c) What remains open

`SU2HeatBathInfluence M β θ` is not proved here for any `β ≠ 0`, so `hcons` at `β ≠ 0` is conditional
on it. The research notes give an unrefereed paper proof of `SU2HeatBathInfluence M β (228 |β|)` for
every
`M ≥ 1` and every real `β`; `θ = 228 |β| ≤ 1` needs `|β| ≤ 1/228` (deep strong coupling; `λ > 0`
needs `|β| < 1/228`), and no constant depends on `M` (uniform in the size of the periodic torus
`(ℤ/2Mℤ)⁴`; no infinite-volume statement).
Its ingredients are:
- the domain of continuous versions;
- `δₑ` = oscillation in `Uₑ`;
- `c e x = tanh(|β| kₑₓ)`, where `kₑₓ` counts the plaquettes that contain `e` and meet the block;
- an exact column-sum count `228`, which is `84` at `M = 1`;
- `K = 1`.
That measure theory is not formalised. Nor is the count: `su2_hcons_small_beta` only names the
constant. `hResidual` and `hCoarseGap` at `β ≠ 0` are untouched. Nothing here concerns weak coupling.

## (d) Axioms and checks

Only `propext`, `Classical.choice` and `Quot.sound` (the module axiom audit covers every headline);
no sorry, admit, axiom declarations, native_decide or implemented_by, and no `set_option`. Uses Parts
I–IV, VI, X, XII, XV and XVII of this file.

## (e) Scope

This is not a proof of a mass gap. It is a finite-volume statement about heat-bath generators
(not the transfer matrix) at deep strong coupling: an abstract
sweep criterion, and its SU(2) instance conditional on one named influence hypothesis. In this
range of couplings, volume-uniform functional inequalities and exponential decay of correlations
are already known for lattice Yang–Mills with the Langevin dynamics when `|β| < 1/12` in `d = 4`,
in the normalisation of this part (Shen, Zhu and Zhu, Commun. Math. Phys. 400 (2023) 805–851);
for heat-bath dynamics of spin systems at high temperature see Caputo, Menz and Tetali, Ann. Fac.
Sci. Toulouse Math. (6) 24 (2015) 691–716. The new content is the constrained heat-bath sweep form
that Part XII needs, with `θ` independent of `M`.
-/

namespace YangMills.StrongCoupling.SweepContraction

open scoped InnerProductSpace
open Finset SchurSplit YangMills.StrongCoupling.CubeSplit YangMills.StrongCoupling.ConstrainedFibre
  YangMills.StrongCoupling.FibreReduction

section Abstract

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] {ι J : Type*}
  [Fintype J] [DecidableEq J]

/-- The coordinates resampled by a sweep along `l`: the union of the blocks `B i`, `i ∈ l`. -/
def sweepSet (B : ι → Finset J) : List ι → Finset J
  | [] => ∅
  | i :: l => B i ∪ sweepSet B l

omit [Fintype J] in
theorem mem_sweepSet (B : ι → Finset J) (j : J) :
    ∀ l : List ι, j ∈ sweepSet B l ↔ ∃ i ∈ l, j ∈ B i
  | [] => by simp [sweepSet]
  | i :: l => by simp [sweepSet, mem_sweepSet B j l]

/-- The weighted oscillation potential `∑ⱼ wⱼ δⱼ g` with `wⱼ = 1` for `j ∈ W` and `wⱼ = θ` otherwise. -/
def oscPot (δ : J → H → ℝ) (θ : ℝ) (W : Finset J) (g : H) : ℝ :=
  ∑ j, (if j ∈ W then 1 else θ) * δ j g

/-- **One block step of the potential argument.** If `Pᵢ` kills `δⱼ` for `j ∈ Bᵢ`, raises `δⱼ` for
`j ∉ Bᵢ` by at most `c j i · ∑_{k ∈ Bᵢ} δₖ`, the column sum `∑_{j ∉ Bᵢ} c j i` is at most `θ`, and
`0 ≤ θ ≤ 1`, then the potential does not increase when `Bᵢ` joins the resampled set. -/
theorem oscPot_step (P : ι → OrthProj H) (B : ι → Finset J) (δ : J → H → ℝ) (c : J → ι → ℝ)
    {θ : ℝ} (hθ0 : 0 ≤ θ) (hθ1 : θ ≤ 1) (i : ι) (W : Finset J) (g : H)
    (hδ0 : ∀ j, 0 ≤ δ j g) (hself : ∀ j ∈ B i, δ j ((P i).P g) = 0)
    (hinfl : ∀ j, j ∉ B i → δ j ((P i).P g) ≤ δ j g + c j i * ∑ k ∈ B i, δ k g)
    (hc0 : ∀ j, 0 ≤ c j i) (hcol : ∑ j ∈ (B i)ᶜ, c j i ≤ θ) :
    oscPot δ θ (B i ∪ W) ((P i).P g) ≤ oscPot δ θ W g := by
  have hσ0 : 0 ≤ ∑ k ∈ B i, δ k g := Finset.sum_nonneg fun k _ => hδ0 k
  have hw0 : ∀ j, 0 ≤ (if j ∈ W then (1 : ℝ) else θ) := fun j => by split_ifs <;> linarith
  have hw1 : ∀ j, (if j ∈ W then (1 : ℝ) else θ) ≤ 1 := fun j => by split_ifs <;> linarith
  have hwθ : ∀ j, θ ≤ (if j ∈ W then (1 : ℝ) else θ) := fun j => by split_ifs <;> linarith
  unfold oscPot
  rw [← Finset.sum_add_sum_compl (B i),
    ← Finset.sum_add_sum_compl (B i) (fun j => (if j ∈ W then (1 : ℝ) else θ) * δ j g)]
  have h1 : ∑ j ∈ B i, (if j ∈ B i ∪ W then (1 : ℝ) else θ) * δ j ((P i).P g) = 0 :=
    Finset.sum_eq_zero fun j hj => by rw [hself j hj, mul_zero]
  have h3 : ∑ j ∈ (B i)ᶜ, (if j ∈ W then (1 : ℝ) else θ) * c j i ≤ θ :=
    (Finset.sum_le_sum fun j _ => by
      have := hw1 j
      have := hc0 j
      nlinarith).trans hcol
  have h2 : ∑ j ∈ (B i)ᶜ, (if j ∈ B i ∪ W then (1 : ℝ) else θ) * δ j ((P i).P g) ≤
      ∑ j ∈ (B i)ᶜ, (if j ∈ W then (1 : ℝ) else θ) * δ j g + θ * ∑ k ∈ B i, δ k g := by
    calc ∑ j ∈ (B i)ᶜ, (if j ∈ B i ∪ W then (1 : ℝ) else θ) * δ j ((P i).P g)
        ≤ ∑ j ∈ (B i)ᶜ, ((if j ∈ W then (1 : ℝ) else θ) * δ j g +
            (∑ k ∈ B i, δ k g) * ((if j ∈ W then (1 : ℝ) else θ) * c j i)) := by
          refine Finset.sum_le_sum fun j hj => ?_
          have hjB : j ∉ B i := Finset.mem_compl.1 hj
          have hw : (if j ∈ B i ∪ W then (1 : ℝ) else θ) = (if j ∈ W then 1 else θ) := by
            simp [Finset.mem_union, hjB]
          rw [hw]
          have h := mul_le_mul_of_nonneg_left (hinfl j hjB) (hw0 j)
          have he : (if j ∈ W then (1 : ℝ) else θ) * (δ j g + c j i * ∑ k ∈ B i, δ k g) =
              (if j ∈ W then (1 : ℝ) else θ) * δ j g +
                (∑ k ∈ B i, δ k g) * ((if j ∈ W then (1 : ℝ) else θ) * c j i) := by ring
          linarith
      _ = ∑ j ∈ (B i)ᶜ, (if j ∈ W then (1 : ℝ) else θ) * δ j g +
            (∑ k ∈ B i, δ k g) * ∑ j ∈ (B i)ᶜ, (if j ∈ W then (1 : ℝ) else θ) * c j i := by
          rw [Finset.sum_add_distrib, Finset.mul_sum]
      _ ≤ _ := by nlinarith [mul_le_mul_of_nonneg_left h3 hσ0]
  have h4 : θ * ∑ k ∈ B i, δ k g ≤ ∑ j ∈ B i, (if j ∈ W then (1 : ℝ) else θ) * δ j g := by
    rw [Finset.mul_sum]
    exact Finset.sum_le_sum fun j _ => mul_le_mul_of_nonneg_right (hwθ j) (hδ0 j)
  linarith

theorem sweepProd_mem (P : ι → OrthProj H) (D : Set H) (hD : ∀ i, ∀ f ∈ D, (P i).P f ∈ D) :
    ∀ (l : List ι), ∀ f ∈ D, sweepProd P l f ∈ D
  | [], f, hf => by rw [sweepProd_nil]; exact hf
  | i :: l, f, hf => by rw [sweepProd_cons]; exact hD i _ (sweepProd_mem P D hD l f hf)

/-- **Dobrushin-type influence data** for orthogonal projections `Pᵢ` that resample blocks `Bᵢ` of a
finite set `J` of coordinates, on a domain `D`: seminorm-like functionals `δⱼ ≥ 0` (the oscillation
in coordinate `j`), an influence matrix `c j i ≥ 0` with column sums `∑_{j ∉ Bᵢ} c j i ≤ θ`, and a
comparison `‖f‖ ≤ K ∑ⱼ δⱼ f` on `D`. -/
structure InfluenceBound (P : ι → OrthProj H) (B : ι → Finset J) (θ : ℝ) where
  /-- The domain (for the Wilson model: continuous versions). -/
  D : Set H
  /-- The oscillation functionals. -/
  δ : J → H → ℝ
  /-- The influence matrix. -/
  c : J → ι → ℝ
  /-- The comparison constant. -/
  K : ℝ
  mem : ∀ i, ∀ f ∈ D, (P i).P f ∈ D
  nonneg : ∀ j, ∀ f ∈ D, 0 ≤ δ j f
  self : ∀ i, ∀ j ∈ B i, ∀ f ∈ D, δ j ((P i).P f) = 0
  infl : ∀ i j, j ∉ B i → ∀ f ∈ D, δ j ((P i).P f) ≤ δ j f + c j i * ∑ k ∈ B i, δ k f
  c_nonneg : ∀ j i, 0 ≤ c j i
  col : ∀ i, ∑ j ∈ (B i)ᶜ, c j i ≤ θ
  K_nonneg : 0 ≤ K
  poinc : ∀ f ∈ D, ‖f‖ ≤ K * ∑ j, δ j f

variable {P : ι → OrthProj H} {B : ι → Finset J} {θ : ℝ}

/-- The potential along a whole sweep. -/
theorem InfluenceBound.oscPot_sweep (I : InfluenceBound P B θ) (hθ0 : 0 ≤ θ) (hθ1 : θ ≤ 1) :
    ∀ (l : List ι) (W : Finset J), ∀ f ∈ I.D,
      oscPot I.δ θ (sweepSet B l ∪ W) (sweepProd P l f) ≤ oscPot I.δ θ W f := by
  intro l
  induction l with
  | nil => intro W f _; simp [sweepSet, sweepProd_nil]
  | cons i l ih =>
    intro W f hf
    have hm := sweepProd_mem P I.D I.mem l f hf
    rw [sweepProd_cons]
    calc oscPot I.δ θ (sweepSet B (i :: l) ∪ W) ((P i).P (sweepProd P l f))
        = oscPot I.δ θ (B i ∪ (sweepSet B l ∪ W)) ((P i).P (sweepProd P l f)) := by
          simp only [sweepSet, Finset.union_assoc]
      _ ≤ oscPot I.δ θ (sweepSet B l ∪ W) (sweepProd P l f) :=
          oscPot_step P B I.δ I.c hθ0 hθ1 i _ _ (fun j => I.nonneg j _ hm)
            (fun j hj => I.self i j hj _ hm) (fun j hj => I.infl i j hj _ hm)
            (fun j => I.c_nonneg j i) (I.col i)
      _ ≤ oscPot I.δ θ W f := ih W f hf

/-- **Oscillation contraction of one covering sweep**: `∑ⱼ δⱼ(Q f) ≤ θ ∑ⱼ δⱼ f` for
`Q = ∏_{i ∈ l} Pᵢ`, if the blocks of `l` cover `J`. -/
theorem InfluenceBound.osc_sweep_le (I : InfluenceBound P B θ) (hθ0 : 0 ≤ θ) (hθ1 : θ ≤ 1)
    (l : List ι) (hcov : ∀ j, ∃ i ∈ l, j ∈ B i) (f : H) (hf : f ∈ I.D) :
    ∑ j, I.δ j (sweepProd P l f) ≤ θ * ∑ j, I.δ j f := by
  have h := I.oscPot_sweep hθ0 hθ1 l ∅ f hf
  have e1 : oscPot I.δ θ (sweepSet B l ∪ ∅) (sweepProd P l f) = ∑ j, I.δ j (sweepProd P l f) := by
    unfold oscPot
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [if_pos (by rw [Finset.union_empty]; exact (mem_sweepSet B j l).2 (hcov j)), one_mul]
  have e2 : oscPot I.δ θ ∅ f = θ * ∑ j, I.δ j f := by
    unfold oscPot
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun j _ => by simp
  linarith

theorem sweepProd_append (P : ι → OrthProj H) (l₁ l₂ : List ι) (u : H) :
    sweepProd P (l₁ ++ l₂) u = sweepProd P l₁ (sweepProd P l₂ u) := by
  induction l₁ with
  | nil => rw [List.nil_append, sweepProd_nil]
  | cons i l ih => rw [List.cons_append, sweepProd_cons, sweepProd_cons, ih]

/-- The adjoint of a sweep is the reversed sweep: `⟪Q_l u, v⟫ = ⟪u, Q_{reverse l} v⟫`. -/
theorem inner_sweepProd_reverse (P : ι → OrthProj H) (l : List ι) (u v : H) :
    ⟪sweepProd P l u, v⟫_ℝ = ⟪u, sweepProd P l.reverse v⟫_ℝ := by
  induction l generalizing v with
  | nil => simp only [List.reverse_nil, sweepProd_nil]
  | cons i l ih =>
    rw [sweepProd_cons, (P i).symm (sweepProd P l u) v, ih, List.reverse_cons, sweepProd_append,
      sweepProd_cons, sweepProd_nil]

theorem norm_P_le (Q : OrthProj H) (x : H) : ‖Q.P x‖ ≤ ‖x‖ := by
  have h := norm_P_sq_le Q x
  nlinarith [norm_nonneg (Q.P x), norm_nonneg x]

theorem sweepProd_norm_le (P : ι → OrthProj H) : ∀ (l : List ι) (x : H), ‖sweepProd P l x‖ ≤ ‖x‖
  | [], x => le_of_eq (by rw [sweepProd_nil])
  | i :: l, x => by
    rw [sweepProd_cons]
    exact (norm_P_le (P i) _).trans (sweepProd_norm_le P l x)

/-- `‖u − Q_l u‖ ≤ ∑_{i ∈ l} ‖u − Pᵢ u‖` for any orthogonal projections (telescoping). -/
theorem norm_sub_sweepProd_le (P : ι → OrthProj H) (u : H) :
    ∀ l : List ι, ‖u - sweepProd P l u‖ ≤ (l.map fun i => ‖u - (P i).P u‖).sum
  | [] => by simp [sweepProd_nil]
  | i :: l => by
    rw [sweepProd_cons, List.map_cons, List.sum_cons]
    have hdec : u - (P i).P (sweepProd P l u) =
        (u - (P i).P u) + (P i).P (u - sweepProd P l u) := by
      rw [map_sub]; abel
    rw [hdec]
    calc ‖(u - (P i).P u) + (P i).P (u - sweepProd P l u)‖
        ≤ ‖u - (P i).P u‖ + ‖(P i).P (u - sweepProd P l u)‖ := norm_add_le _ _
      _ ≤ ‖u - (P i).P u‖ + (l.map fun i => ‖u - (P i).P u‖).sum := by
          linarith [norm_P_le (P i) (u - sweepProd P l u), norm_sub_sweepProd_le P u l]

/-- **From oscillations to norms on the domain.** With `T = Q_{reverse l} Q_l = Q_l* Q_l` (symmetric),
`∑ δ(Tⁿ f) ≤ θ^{2n} ∑ δ f` and `‖g‖ ≤ K ∑ δ g` give `‖Tⁿ f‖ ≤ C θ^{2n}`; log-convexity (Part X's
`norm_apply_le_of_pow_decay`) gives `‖T f‖ ≤ θ² ‖f‖`, hence `‖Q_l f‖ ≤ θ ‖f‖` for `f ∈ D`. -/
theorem InfluenceBound.norm_sweep_le (I : InfluenceBound P B θ) (hθ0 : 0 ≤ θ) (hθ1 : θ ≤ 1)
    (l : List ι) (hcov : ∀ j, ∃ i ∈ l, j ∈ B i) (f : H) (hf : f ∈ I.D) :
    ‖sweepProd P l f‖ ≤ θ * ‖f‖ := by
  have hcovr : ∀ j, ∃ i ∈ l.reverse, j ∈ B i := fun j => by
    obtain ⟨i, hi, hj⟩ := hcov j
    exact ⟨i, List.mem_reverse.2 hi, hj⟩
  let T : H →ₗ[ℝ] H := sweepProd P (l.reverse ++ l)
  have hTapp : ∀ x, T x = sweepProd P l.reverse (sweepProd P l x) := fun x =>
    sweepProd_append P _ _ x
  have hTx : ∀ x y, ⟪T x, y⟫_ℝ = ⟪sweepProd P l x, sweepProd P l y⟫_ℝ := fun x y => by
    rw [hTapp, inner_sweepProd_reverse, List.reverse_reverse]
  have hT : T.IsSymmetric := fun x y =>
    calc ⟪T x, y⟫_ℝ = ⟪sweepProd P l x, sweepProd P l y⟫_ℝ := hTx x y
      _ = ⟪sweepProd P l y, sweepProd P l x⟫_ℝ := real_inner_comm _ _
      _ = ⟪T y, x⟫_ℝ := (hTx y x).symm
      _ = ⟪x, T y⟫_ℝ := real_inner_comm _ _
  have hstep : ∀ g ∈ I.D, T g ∈ I.D ∧ ∑ j, I.δ j (T g) ≤ θ ^ 2 * ∑ j, I.δ j g := by
    intro g hg
    have hg1 := sweepProd_mem P I.D I.mem l g hg
    rw [hTapp]
    refine ⟨sweepProd_mem P I.D I.mem _ _ hg1, ?_⟩
    calc ∑ j, I.δ j (sweepProd P l.reverse (sweepProd P l g))
        ≤ θ * ∑ j, I.δ j (sweepProd P l g) := I.osc_sweep_le hθ0 hθ1 l.reverse hcovr _ hg1
      _ ≤ θ * (θ * ∑ j, I.δ j g) :=
          mul_le_mul_of_nonneg_left (I.osc_sweep_le hθ0 hθ1 l hcov g hg) hθ0
      _ = θ ^ 2 * ∑ j, I.δ j g := by ring
  have hpow : ∀ n : ℕ, (T ^ n) f ∈ I.D ∧
      ∑ j, I.δ j ((T ^ n) f) ≤ (θ ^ 2) ^ n * ∑ j, I.δ j f := by
    intro n
    induction n with
    | zero => simp [hf]
    | succ n ih =>
      rw [pow_succ' T n, Module.End.mul_apply]
      obtain ⟨h1, h2⟩ := hstep _ ih.1
      refine ⟨h1, h2.trans ?_⟩
      rw [pow_succ' (θ ^ 2) n, mul_assoc]
      exact mul_le_mul_of_nonneg_left ih.2 (sq_nonneg θ)
  have hdec : ∀ n : ℕ, ‖(T ^ n) f‖ ≤ (I.K * ∑ j, I.δ j f) * (θ ^ 2) ^ n := fun n =>
    calc ‖(T ^ n) f‖ ≤ I.K * ∑ j, I.δ j ((T ^ n) f) := I.poinc _ (hpow n).1
      _ ≤ I.K * ((θ ^ 2) ^ n * ∑ j, I.δ j f) :=
          mul_le_mul_of_nonneg_left (hpow n).2 I.K_nonneg
      _ = (I.K * ∑ j, I.δ j f) * (θ ^ 2) ^ n := by ring
  have hTf := norm_apply_le_of_pow_decay T hT f (sq_nonneg θ) hdec
  have hsq : ‖sweepProd P l f‖ ^ 2 ≤ (θ * ‖f‖) ^ 2 :=
    calc ‖sweepProd P l f‖ ^ 2 = ⟪sweepProd P l f, sweepProd P l f⟫_ℝ :=
          (real_inner_self_eq_norm_sq _).symm
      _ = ⟪T f, f⟫_ℝ := (hTx f f).symm
      _ ≤ ‖T f‖ * ‖f‖ := real_inner_le_norm _ _
      _ ≤ (θ ^ 2 * ‖f‖) * ‖f‖ := mul_le_mul_of_nonneg_right hTf (norm_nonneg _)
      _ = (θ * ‖f‖) ^ 2 := by ring
  have h0 : 0 ≤ θ * ‖f‖ := mul_nonneg hθ0 (norm_nonneg f)
  nlinarith [norm_nonneg (sweepProd P l f)]

/-- A sweep bound on a set `D` extends to its closure (a sweep of orthogonal projections is
`1`-Lipschitz). -/
theorem norm_sweep_le_of_closure (P : ι → OrthProj H) (l : List ι) {θ' : ℝ} (D : Set H)
    (hD : ∀ f ∈ D, ‖sweepProd P l f‖ ≤ θ' * ‖f‖) :
    ∀ u ∈ closure D, ‖sweepProd P l u‖ ≤ θ' * ‖u‖ := by
  have hcont : Continuous (sweepProd P l) :=
    AddMonoidHomClass.continuous_of_bound (sweepProd P l) 1 fun x => by
      rw [one_mul]
      exact sweepProd_norm_le P l x
  have hclosed : IsClosed {u : H | ‖sweepProd P l u‖ ≤ θ' * ‖u‖} :=
    isClosed_le hcont.norm (continuous_const.mul continuous_norm)
  exact closure_minimal hD hclosed

/-- **The sweep contraction in the form of Part XII's `hsweep`.** Influence data on a domain `D` whose
closure contains `ker Π`, with column sums `≤ θ ∈ [0, 1]`, and a list `l` whose blocks cover `J`, give
`‖Q_l u‖ ≤ θ ‖u‖` whenever `Π u = 0`. -/
theorem InfluenceBound.hsweep (I : InfluenceBound P B θ) (hθ0 : 0 ≤ θ) (hθ1 : θ ≤ 1)
    (pj : OrthProj H) (hdense : ∀ u, pj.P u = 0 → u ∈ closure I.D) (l : List ι)
    (hcov : ∀ j, ∃ i ∈ l, j ∈ B i) :
    ∀ u, pj.P u = 0 → ‖sweepProd P l u‖ ≤ θ * ‖u‖ := fun u hu =>
  norm_sweep_le_of_closure P l I.D (fun f hf => I.norm_sweep_le hθ0 hθ1 l hcov f hf) u
    (hdense u hu)

end Abstract

/-! ### The algebraic core of the total-variation bound for a tilted measure -/

/-- For `p ≥ 0` (in the application `p = μ(A) ∈ [0, 1]`) and `q ≥ 1`:
`p q² / (p q² + (1 − p)) − p ≤ (q − 1)/(q + 1)`. With `q = e^{L/2}`
this is the step `ν(A) − μ(A) ≤ tanh(L/4)` for `ν ∝ e^h μ`, `osc h ≤ L`, `μ(A) = p` (the measure
theory for it is on paper). -/
theorem tilt_tv_core {p q : ℝ} (hp0 : 0 ≤ p) (hq : 1 ≤ q) :
    p * q ^ 2 / (p * q ^ 2 + (1 - p)) - p ≤ (q - 1) / (q + 1) := by
  have hq2 : 1 ≤ q ^ 2 := by nlinarith
  have hden : 0 < p * q ^ 2 + (1 - p) := by nlinarith [mul_le_mul_of_nonneg_left hq2 hp0]
  have hq1 : 0 < q + 1 := by linarith
  have e : (p * q ^ 2 - p * (p * q ^ 2 + (1 - p))) / (p * q ^ 2 + (1 - p)) =
      p * q ^ 2 / (p * q ^ 2 + (1 - p)) - p := by
    rw [sub_div, mul_div_cancel_right₀ _ (ne_of_gt hden)]
  rw [← e, div_le_div_iff₀ hden hq1]
  have key : (q - 1) * (p * q ^ 2 + (1 - p)) -
      (p * q ^ 2 - p * (p * q ^ 2 + (1 - p))) * (q + 1) = (q - 1) * (1 - p * (1 + q)) ^ 2 := by
    ring
  nlinarith [mul_nonneg (sub_nonneg.2 hq) (sq_nonneg (1 - p * (1 + q)))]

/-! ### SU(2) on `(ℤ/2Mℤ)⁴`, straight blocking, `μ ∝ exp((β/2) ∑ₚ Re tr U_p) ∏ dU` -/

section SU2

open YangMills.StrongCoupling.CondExpInputs YangMills.StrongCoupling.WilsonCube
  YangMills.StrongCoupling.WilsonSU2 YangMills.StrongCoupling.SkeletonCondExp

variable (M : ℕ) [NeZero M]

/-- The non-skeleton links of `(ℤ/2Mℤ)⁴` for the straight blocking. -/
abbrev NSk : Type := {e : Link (2 * M) // e ∉ skel (straightBlocking M)}

noncomputable instance : Fintype (NSk M) := Fintype.ofFinite _

/-- The block of base point `x`: the non-skeleton links of `cube2 M x`. -/
noncomputable def su2Block (x : Site (2 * M)) : Finset (NSk M) := by
  classical
  exact Finset.univ.filter fun e => (e : Link (2 * M)) ∈ cube2 M x

theorem mem_su2Block {x : Site (2 * M)} {e : NSk M} :
    e ∈ su2Block M x ↔ (e : Link (2 * M)) ∈ cube2 M x := by
  classical
  unfold su2Block
  simp

/-- The constrained cube projection `P'ₓ = E_μ[· | links outside cube2 M x ∖ Sk]` on `H`, for the
SU(2) Wilson measure `μ ∝ exp((β/2) ∑ₚ Re tr U_p) ∏ dU`. -/
noncomputable abbrev su2ConstrPj (β : ℝ) (x : Site (2 * M)) :
    OrthProj (wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2) :=
  wilsonPj (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (cube2 M x \ skel (straightBlocking M))

/-- **The analytic input, as one named hypothesis.** Dobrushin influence data for the constrained
heat baths `P'ₓ` (`x ∈ (ℤ/2Mℤ)⁴`) of the SU(2) Wilson measure `μ ∝ exp((β/2) ∑ₚ Re tr U_p) ∏ dU` on
`(ℤ/2Mℤ)⁴`, straight blocking: on a domain `D ⊆ H ∩ ker E_μ[· | σ(Sk)]` that is dense in
`H ∩ ker E_μ[· | σ(Sk)]`, functionals `δₑ` (`e` a non-skeleton link), an influence matrix with column
sums `≤ θ`, and `‖f‖ ≤ K ∑ₑ δₑ f`. Intended instance (paper): `D` = the elements with a continuous
version `f` and `∫ f(s, ξ) μ(dξ | s) = 0` for every skeleton configuration `s`, `δₑ` = oscillation in
`Uₑ`, `c e x = tanh(|β| kₑₓ)`, `θ = 228 |β|`, `K = 1`, for every `M ≥ 1` and every real `β`.
That instance is not formalised; the Lean instance is `su2_influence_zero` (`β = 0`, `θ = 0`). -/
structure SU2HeatBathInfluence (β θ : ℝ) extends
    InfluenceBound (su2ConstrPj M β) (su2Block M) θ where
  /-- The domain lies in `ker E_μ[· | σ(Sk)]`. -/
  ker_skel : ∀ f ∈ D, su2P M β (skel (straightBlocking M))ᶜ f = 0
  /-- The domain is dense in `H ∩ ker E_μ[· | σ(Sk)]`. -/
  dense : ∀ u, su2P M β (skel (straightBlocking M))ᶜ u = 0 → u ∈ closure D

variable {M}

/-- **`hsweep` from the analytic input** (SU(2), `μ ∝ exp((β/2) ∑ₚ Re tr U_p) ∏ dU` on
`(ℤ/2Mℤ)⁴`, every `M ≥ 1`, every real `β`): for every parity family `j`, the constrained sweep along
`parFamily M j` contracts by `θ` on `H ∩ ker Π`. Lemma IV (`su2_skel_eq_Pi`) turns `Π u = 0` into
`E_μ[u | σ(Sk)] = 0`. -/
theorem su2_hsweep_of_influence {β θ : ℝ} (I : SU2HeatBathInfluence M β θ) (hθ0 : 0 ≤ θ)
    (hθ1 : θ ≤ 1) :
    ∀ (j : Fin 3 → ZMod 2) u, (su2Pi M β).P u = 0 →
      ‖sweepProd (fun x => wilsonPj (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
        (cube2 M x \ skel (straightBlocking M))) (parFamily M j) u‖ ≤ θ * ‖u‖ := by
  intro j u hu
  refine I.toInfluenceBound.hsweep hθ0 hθ1 (su2Pi M β)
    (fun v hv => I.dense v ((su2_skel_eq_Pi M β v).trans hv)) (parFamily M j) ?_ u hu
  intro e
  obtain ⟨z, hz, he⟩ := parFamily_cover M j e.1
  exact ⟨z, hz, (mem_su2Block M).2 he⟩

/-- **`hcons` from the analytic input, `λ = (1/2)(1 − θ)²`** (side-2 cubes at every base point,
weights `1/16`, every `M ≥ 1`, `μ ∝ exp((β/2) ∑ₚ Re tr U_p) ∏ dU`). -/
theorem su2_hcons_of_influence {β θ : ℝ} (I : SU2HeatBathInfluence M β θ) (hθ0 : 0 ≤ θ)
    (hθ1 : θ ≤ 1) (u : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2)
    (hu : (su2Pi M β).P u = 0) :
    ((1 / 2 : ℝ) * (1 - θ) ^ 2) * ‖u‖ ^ 2 ≤
      ∑ x, (1 / 16 : ℝ) * ‖u - su2P M β (cube2 M x \ skel (straightBlocking M)) u‖ ^ 2 := by
  classical
  have h := ConstrainedFibre.hcons_of_sweeps (κ := Fin 3 → ZMod 2) (fun _ => (1 / 16 : ℝ))
    (wmin := 1 / 16) (θ := θ) (by norm_num) (fun _ => le_rfl)
    (fun x => wilsonPj plaqOf reTr (β / 2) haarSU2 (cube2 M x \ skel (straightBlocking M)))
    (su2Pi M β) (parFamily M) (fun _ => Finset.nodup_toList _)
    (fun j j' hjj x hx => parFamily_disjoint M j j' hjj x hx) hθ1
    (su2_hsweep_of_influence I hθ0 hθ1) u hu
  have hcard : (Fintype.card (Fin 3 → ZMod 2) : ℝ) = 8 := by
    simp only [Fintype.card_fun, ZMod.card, Fintype.card_fin]
    norm_num
  rw [hcard] at h
  calc ((1 / 2 : ℝ) * (1 - θ) ^ 2) * ‖u‖ ^ 2 = (8 * (1 / 16) * (1 - θ) ^ 2) * ‖u‖ ^ 2 := by ring
    _ ≤ _ := h

/-- **`hFibre` from the analytic input, `λ = (1/2)(1 − θ)²`**, through Part XII's
`su2_hFibre_of_sweeps`: `D = ∑ₓ (1/16)(I − P_{cube2 M x})` on `H`. -/
theorem su2_hFibre_of_influence {β θ : ℝ} (I : SU2HeatBathInfluence M β θ) (hθ0 : 0 ≤ θ)
    (hθ1 : θ ≤ 1) :
    ∀ u, (su2Pi M β).P u = 0 →
      ((1 / 2 : ℝ) * (1 - θ) ^ 2) * ‖u‖ ^ 2 ≤
        ⟪u, cubeGen (fun _ => (1 / 16 : ℝ)) (fun x => su2P M β (cube2 M x)) u⟫_ℝ := by
  classical
  intro u hu
  have h := ConstrainedFibre.su2_hFibre_of_sweeps M β (cube2 M) (fun _ => (1 / 16 : ℝ))
    (wmin := 1 / 16) (by norm_num) (fun _ => le_rfl) (parFamily M)
    (fun _ => Finset.nodup_toList _) (fun j j' hjj x hx => parFamily_disjoint M j j' hjj x hx) hθ1
    (su2_hsweep_of_influence I hθ0 hθ1) u hu
  have hcard : (Fintype.card (Fin 3 → ZMod 2) : ℝ) = 8 := by
    simp only [Fintype.card_fun, ZMod.card, Fintype.card_fin]
    norm_num
  rw [hcard] at h
  calc ((1 / 2 : ℝ) * (1 - θ) ^ 2) * ‖u‖ ^ 2 = (8 * (1 / 16) * (1 - θ) ^ 2) * ‖u‖ ^ 2 := by ring
    _ ≤ _ := h

/-- **The Part X generator bound from the analytic input** (heat-bath generator, finite volume,
not a mass gap): Part X's `su2_gap_of_constrained` with
`hcons = su2_hcons_of_influence` (`λ = (1/2)(1 − θ)²`). `hCoarseGap` and `hResidual` stay inputs. -/
theorem su2_gap_of_influence {β θ : ℝ} (I : SU2HeatBathInfluence M β θ) (hθ0 : 0 ≤ θ)
    (hθ1 : θ ≤ 1) {ιc : Type*} [Fintype ιc] (Vc : ιc → Set (Link M)) (wc : ιc → ℝ)
    {α β' ϖ : ℝ} (hα : α < (1 / 2 : ℝ) * (1 - θ) ^ 2) (hβ' : 0 ≤ β')
    (hCoarseGap : ϖ • LinearMap.id ≤ su2Dc M β Vc wc)
    (X : (su2Pi M β).Hc →ₗ[ℝ] (su2Pi M β).Hf)
    (hResidual : ∀ v : (su2Pi M β).Hc, β' * (su2Pi M β).gC (su2Jt M β) (su2Dc M β Vc wc) v +
      qForm (E := (su2Pi M β).Hf) (F := (su2Pi M β).Hc)
        ((su2Pi M β).blkA (su2D M β (cube2 M) (fun _ => 1 / 16)))
        ((su2Pi M β).blkB (su2D M β (cube2 M) (fun _ => 1 / 16))) α X v +
      ‖resid (E := (su2Pi M β).Hf) (F := (su2Pi M β).Hc)
        ((su2Pi M β).blkA (su2D M β (cube2 M) (fun _ => 1 / 16)))
        ((su2Pi M β).blkB (su2D M β (cube2 M) (fun _ => 1 / 16))) α X v‖ ^ 2 /
        ((1 / 2 : ℝ) * (1 - θ) ^ 2 - α) ≤
        ⟪v, (su2Pi M β).blkC (su2D M β (cube2 M) (fun _ => 1 / 16)) v⟫_ℝ) :
    min α (β' * ϖ) • LinearMap.id ≤ su2D M β (cube2 M) (fun _ => 1 / 16) :=
  su2_gap_of_constrained M β (cube2 M) (fun _ => 1 / 16) (fun _ => by norm_num) Vc wc
    (su2_hcons_of_influence I hθ0 hθ1) hα hβ' hCoarseGap X hResidual

/-- **Explicit small coupling**: if the analytic input holds with `θ = 228 |β|` and `|β| ≤ 1/228`,
then `hcons` holds with `λ = (1/2)(1 − 228 |β|)²` (every `M ≥ 1`,
`μ ∝ exp((β/2) ∑ₚ Re tr U_p) ∏ dU`, side-2 cubes, weights `1/16`). -/
theorem su2_hcons_small_beta {β : ℝ} (I : SU2HeatBathInfluence M β (228 * |β|))
    (hβ : |β| ≤ 1 / 228) (u : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2)
    (hu : (su2Pi M β).P u = 0) :
    ((1 / 2 : ℝ) * (1 - 228 * |β|) ^ 2) * ‖u‖ ^ 2 ≤
      ∑ x, (1 / 16 : ℝ) * ‖u - su2P M β (cube2 M x \ skel (straightBlocking M)) u‖ ^ 2 :=
  su2_hcons_of_influence I (by positivity) (by linarith) u hu

/-! #### Non-vacuity of the named hypothesis at `β = 0` -/

variable (M)

/-- If `e ∈ V`, the single-link projection `P_{{e}}` fixes `ran P_V` (every `β`). -/
theorem single_fixes (β : ℝ) {V : Set (Link (2 * M))} {e : Link (2 * M)} (he : e ∈ V)
    (f : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2) :
    ‖wilsonP (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 V f -
        wilsonP (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 {e}
          (wilsonP (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 V f)‖ = 0 := by
  rw [wilsonP_fixes_wilsonP _ _ _ _ (Set.singleton_subset_iff.2 he) f, sub_self, norm_zero]

/-- At `β = 0` the projections commute, so `‖P_V f − P_{{e}} P_V f‖ ≤ ‖f − P_{{e}} f‖`. -/
theorem single_infl_zero (V : Set (Link (2 * M))) (e : Link (2 * M))
    (f : wilsonH (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2) :
    ‖wilsonP (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2 V f -
        wilsonP (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2 {e}
          (wilsonP (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2 V f)‖ ≤
      ‖f - wilsonP (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2 {e} f‖ := by
  have hc : wilsonP (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2 {e}
      (wilsonP (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2 V f) =
      wilsonP (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2 V
        (wilsonP (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2 {e} f) := by
    rw [ProductEndpoint.wilsonP_comp_zero plaqOf reTr (zero_div 2) haarSU2,
      ProductEndpoint.wilsonP_comp_zero plaqOf reTr (zero_div 2) haarSU2, Set.union_comm]
  rw [hc, ← map_sub]
  exact norm_P_le (wilsonPj (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2 V) _

/-- **The named hypothesis holds at `β = 0` with `θ = 0`** (every `M ≥ 1`): `D = H ∩ ker E_μ[· | σ(Sk)]`,
`δₑ f = ‖f − P_{{e}} f‖`, `c = 0`, `K = 1`. So `SU2HeatBathInfluence` is not vacuous, and at `β = 0`
`su2_hcons_of_influence` returns `λ = 1/2` (Part XVII's `su2_hcons_zero_half`). -/
noncomputable def su2_influence_zero : SU2HeatBathInfluence M 0 0 where
  D := {f | su2P M 0 (skel (straightBlocking M))ᶜ f = 0}
  δ e f := ‖f - su2P M 0 {e.1} f‖
  c _ _ := 0
  K := 1
  mem x f hf :=
    (proj_comp_eq_of_le
      (wilsonPj (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2 (skel (straightBlocking M))ᶜ)
      (wilsonPj (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2
        (cube2 M x \ skel (straightBlocking M)))
      (fun z => wilsonP_fixes_wilsonP _ _ _ _ (fun _ he => he.2) z) f).trans hf
  nonneg _ _ _ := norm_nonneg _
  self x e he f _ := single_fixes M 0 (V := cube2 M x \ skel (straightBlocking M)) (e := e.1)
    ⟨(mem_su2Block M).1 he, e.2⟩ f
  infl x e _ f _ := by
    simp only [zero_mul, add_zero]
    exact single_infl_zero M _ e.1 f
  c_nonneg _ _ := le_rfl
  col _ := by simp
  K_nonneg := zero_le_one
  poinc f hf := by
    have hS := ProductEndpoint.wilson_sweepProd_zero plaqOf reTr (zero_div (2 : ℝ)) haarSU2
      (fun e : NSk M => ({e.1} : Set (Link (2 * M)))) (Finset.univ : Finset (NSk M)).toList f
    have hset : {a | ∃ e ∈ (Finset.univ : Finset (NSk M)).toList, a ∈ ({e.1} : Set (Link (2 * M)))} =
        (skel (straightBlocking M))ᶜ := by
      ext a
      constructor
      · rintro ⟨e, -, he⟩
        rw [Set.mem_singleton_iff] at he
        rw [he]
        exact e.2
      · intro ha
        exact ⟨⟨a, ha⟩, Finset.mem_toList.2 (Finset.mem_univ _), rfl⟩
    rw [hset] at hS
    have h0 := hS.trans hf
    have h1 := norm_sub_sweepProd_le
      (fun e : NSk M => wilsonPj (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2 {e.1}) f
      (Finset.univ : Finset (NSk M)).toList
    rw [h0, sub_zero, ← List.sum_toFinset _ (Finset.nodup_toList _), Finset.toList_toFinset] at h1
    rw [one_mul]
    exact h1
  ker_skel _ hf := hf
  dense _ hu := subset_closure hu

/-- `SU2HeatBathInfluence M 0 0` is inhabited (every `M ≥ 1`). -/
theorem su2_influence_zero_nonempty : Nonempty (SU2HeatBathInfluence M 0 0) :=
  ⟨su2_influence_zero M⟩

end SU2

end YangMills.StrongCoupling.SweepContraction

/-! # Part XXII. `YangMills.StrongCoupling.SmallCouplingInputs`: cover counts and the small-`|β|` coarse-gap and generator bounds from named analytic inputs (new; uses Parts II–IV, VI, IX, X, XV–XVIII and XXI) -/

/-!
# Small coupling: cover counts, the coarse gap from a single-link Poincaré inequality, and a conditional bound for the cube generator

## (a) Formal target

Part XVI of this file assembles `D ≥ min(α, β' ϖ_c) I` from covers and local bounds, and Part XVIII
lifts a fine single-link Poincaré inequality to the coarse space (`su2_poinc_of_lift`). The coupling
is that of Part VI's `su2Wilson`: `μ(dU) = Z⁻¹ exp[(β/2) ∑ₚ Re tr U_p] ∏ₑ h(dUₑ)`, and `b = |β|`. The
setting is SU(2) on `(ℤ/2Mℤ)⁴` (`d = 4`), straight blocking, fine side-2 cubes `cube2 M x` and coarse
side-2 cubes `sideTwoCube M z` at every base point, all weights `1/16`. The target is: the cover
counts of the coarse cubes needed by Part XVI's `cubeGen_gap_of_cover`; the analytic single-link
Poincaré inequality as one named hypothesis; `hCoarseGap` with a constant independent of `M`; and a
bound for the cube generator at `|β| ≤ 1/1000` with every constant explicit and independent of `M`.

## (b) What is proved

* Cover counts (`cubeLinkFinset`, `mem_cubeLinkFinset`, `card_cubeLinkFinset`, `cubesContaining`,
  `card_cubesContaining`, `cover_weight`): for every `M ≥ 2` each coarse cube `sideTwoCube M z` has
  exactly `32` links and each coarse link lies in exactly `8` coarse cubes, so with weights `1/16`
  the cover constants are `N = 32` and `m = 1/2`. At `M = 1` (`card_cubeLinkFinset_one`,
  `card_cubesContaining_one`) the one coarse cube contains all `4` coarse links: `N = 4`,
  `m = 1/16`, and the ratio `m / N = 1/64` is the same. The counts are stated per cube and per link;
  no statement sums over the sites of a concrete lattice.
* `coarseP_fixes_coarseP`: `ran Pᶜ_V ⊆ ran Pᶜ_W` for `W ⊆ V`.
* `SingleLinkPoincare M β c`: `c ‖u‖² ≤ ∑ₑ ‖u − P_{e} u‖²` on the centred gauge-invariant space `H`.
  `singleLinkPoincare_zero`: it holds at `β = 0` with `c = 1`, so the hypothesis is satisfiable.
* `coarse_poinc_of_singleLink`, `su2_coarse_gap_of_singleLink` (every `M ≥ 1`, every real `β`):
  `SingleLinkPoincare M β c` gives `(c/2) ‖y‖² ≤ ∑_ē ‖y − Pᶜ_ē y‖²` and `D_c ≥ (c/128) I` for
  `D_c = ∑_z (1/16)(I − Pᶜ_{sideTwoCube M z})`. `su2_coarse_gap_small_beta` is the case
  `c = 1 − 72|β|`, i.e. `ϖ_c = (1 − 72|β|)/128`; `su2_coarse_gap_zero_of_singleLink` is the closed
  case `β = 0` (`ϖ_c = 1/128`, weaker than Part XV's `su2_coarse_gap_zero`).
* `budget_small_beta`: for `0 ≤ b ≤ 1/1000`, `β' = 3/5` and `α = 1/230`,
  `β' e^{576b}/2 + ε_B / ((1 − 72b)/56 − α) ≤ 1 − ((e^{36b} − 1) e^{18b})²` with
  `ε_B = (63/2)(e^{12b} − 1)² e^{108b} / (1 − 72b)`; the exponentials are bounded through
  `e^{6b} ≤ 1/(1 − 6b) ≤ 500/497`.
* `su2_gap_small_beta_of_estimates` (every `M ≥ 1`, `|β| ≤ 1/1000`): conditional on
  `SingleLinkPoincare M β (1 − 72|β|)`, on `hcons` with `λ = (1 − 72|β|)/56` and on the three local
  residual bounds of Part XVI's `cert_zero_of_local` with `ε_B`, `K_g = e^{576|β|}/2` and
  `c = 1 − ((e^{36|β|} − 1) e^{18|β|})²`, the cube generator satisfies `D ≥ (1/230) I`.
  `su2_gap_small_beta_zero`: at `β = 0` every hypothesis is discharged by Parts XV, XVII and XVIII,
  so the conditional theorem is not vacuous.
* `su2_gap_small_beta_of_influence`: the same bound `D ≥ (1/230) I`, with `hcons` supplied by the influence
  hypothesis of Part XXI of this file (`λ = (1/2)(1 − 228|β|)² ≥ (1 − 72|β|)/56` for `|β| ≤ 1/1000`).

## (c) What remains open

The analytic inputs at `β ≠ 0` are hypotheses here: the single-link Poincaré inequality with
`c = 1 − 72|β|` (the single-link Dobrushin bound of the accompanying notes, for `|β| < 1/72`), the
fibre bound `hcons` with `λ = (1 − 72|β|)/56`, and the local bounds `‖B v‖² ≤ ε_B Γ v`,
`⟪J* v, D_c J* v⟫ ≤ K_g Γ v` and `c Γ v ≤ ⟪v, C v⟫`. The accompanying notes give
unrefereed paper proofs of all
of them for `|β| < 1/72` and every `M ≥ 1` (at `M = 1` the notes' coarse-form bound
`(1/16) e^{72|β|} Γ v` implies the one assumed here); they are not formalised.
The constant `1/230` is below
the value `0.0044375…` that the same inputs give with the optimal `α` and exact exponentials, and
below the direct single-link bound `(1 − 72|β|)/64` of the notes. Weak coupling, infinite volume and
the continuum are not addressed.

## (d) Axioms and checks

Every headline depends only on `propext`, `Classical.choice` and `Quot.sound` (the module axiom
audit covers every headline); the part contains no `sorry`, `admit`, `axiom` declarations,
`native_decide`, `implemented_by` or `set_option`. The finite counts `card_coarseOffsets` (over
64 pairs) and `card_dirOffsets` (over 16 vectors per direction) are closed by `decide`. It uses Parts II–IV, VI,
IX, X, XV–XVIII and (for `su2_gap_small_beta_of_influence`) XXI of this file.

## (e) Scope

This is not a proof of a mass gap. Volume-uniform gaps of local dynamics at strong coupling are
known (Dobrushin-uniqueness regime, for example Caputo, Menz and Tetali, Ann. Fac. Sci. Toulouse
Math. (6) 24 (2015) 691–716, for heat-bath dynamics; for lattice Yang–Mills, Shen, Zhu and Zhu,
Commun. Math. Phys. 400 (2023) 805–851, Langevin dynamics, `|β| < 1/12` in `d = 4` in this
normalisation), and `|β| ≤ 1/1000` lies deep inside that regime.
`D` and `D_c` are heat-bath (cube-resampling) generators: their lower bounds are dynamical
statements in finite volume, not bounds on a transfer-matrix (mass) gap. The statements
are finite-volume implications whose Wilson-specific analytic inputs are hypotheses for `β ≠ 0`;
the closed instances at `β = 0` are weaker than the elementary product-measure bounds and only show
that the hypotheses can be met. Nothing here concerns weak coupling or a continuum limit.
-/

namespace YangMills.StrongCoupling.SmallCouplingInputs

open scoped InnerProductSpace
open Finset SchurSplit YangMills.StrongCoupling.CubeSplit YangMills.StrongCoupling.CondExpInputs
  YangMills.StrongCoupling.WilsonCube YangMills.StrongCoupling.WilsonSU2
  YangMills.StrongCoupling.FibreReduction YangMills.StrongCoupling.ProductEndpoint

section Counts

/-- The offsets `(a, μ)` with `a ∈ {0,1}⁴` and `a_μ = 0`: the links of a side-2 cube relative to
its base point. -/
def coarseOffsets : Finset ((Fin 4 → Fin 2) × Fin 4) :=
  Finset.univ.filter fun q => q.1 q.2 = 0

/-- The offsets `a ∈ {0,1}⁴` with `a_μ = 0`. -/
def dirOffsets (μ : Fin 4) : Finset (Fin 4 → Fin 2) :=
  Finset.univ.filter fun a => a μ = 0

/-- There are `32` offsets `(a, μ)` with `a_μ = 0`. -/
theorem card_coarseOffsets : coarseOffsets.card = 32 := by decide

/-- For each direction `μ` there are `8` offsets `a` with `a_μ = 0`. -/
theorem card_dirOffsets : ∀ μ : Fin 4, (dirOffsets μ).card = 8 := by decide

/-- The vector `a ∈ {0,1}⁴` as a site of `(ℤ/Mℤ)⁴`. -/
def offsetVec (M : ℕ) (a : Fin 4 → Fin 2) : Site M := fun i => (((a i : ℕ) : ZMod M))

/-- The links of the side-2 coarse cube at `z`, as a finset. -/
def cubeLinkFinset (M : ℕ) (z : Site M) : Finset (Link M) :=
  coarseOffsets.image fun q => (z + offsetVec M q.1, q.2)

/-- `cubeLinkFinset M z` is the finset of the links of `sideTwoCube M z` (every `M`). -/
theorem mem_cubeLinkFinset (M : ℕ) (z : Site M) (j : Link M) :
    j ∈ cubeLinkFinset M z ↔ j ∈ sideTwoCube M z := by
  constructor
  · intro hj
    obtain ⟨⟨a, μ⟩, hq, hqj⟩ := Finset.mem_image.1 hj
    subst hqj
    exact ⟨a, (Finset.mem_filter.1 hq).2, rfl⟩
  · rintro ⟨a, ha, he⟩
    exact Finset.mem_image.2 ⟨(a, j.2), Finset.mem_filter.2 ⟨Finset.mem_univ _, ha⟩,
      Prod.ext he.symm rfl⟩

/-- A side-2 coarse cube has at most `32` links (every `M`). -/
theorem card_cubeLinkFinset_le (M : ℕ) (z : Site M) : (cubeLinkFinset M z).card ≤ 32 :=
  card_coarseOffsets ▸ Finset.card_image_le

/-- For `M ≥ 2`, distinct `a ∈ {0,1}⁴` give distinct sites of `(ℤ/Mℤ)⁴`. -/
theorem offsetVec_injective {M : ℕ} (hM : 2 ≤ M) : Function.Injective (offsetVec M) := by
  intro a a' h
  funext i
  have h1 := congrFun h i
  simp only [offsetVec] at h1
  rw [ZMod.natCast_eq_natCast_iff'] at h1
  have ha := (a i).isLt
  have ha' := (a' i).isLt
  rw [Nat.mod_eq_of_lt (by omega), Nat.mod_eq_of_lt (by omega)] at h1
  exact Fin.ext h1

/-- For `M ≥ 2` every side-2 coarse cube has exactly `32` links. -/
theorem card_cubeLinkFinset {M : ℕ} (hM : 2 ≤ M) (z : Site M) : (cubeLinkFinset M z).card = 32 := by
  rw [cubeLinkFinset, Finset.card_image_of_injective _ ?_, card_coarseOffsets]
  rintro ⟨a, μ⟩ ⟨a', μ'⟩ h
  simp only [Prod.mk.injEq] at h
  exact Prod.ext (offsetVec_injective hM (add_left_cancel h.1)) h.2

variable (M : ℕ) [NeZero M]

/-- The base points of the side-2 coarse cubes that contain the coarse link `j`. -/
def cubesContaining (j : Link M) : Finset (Site M) :=
  Finset.univ.filter fun z => j ∈ cubeLinkFinset M z

/-- The coarse cubes containing `j = (y, μ)` are based at `y − a` with `a_μ = 0`. -/
theorem cubesContaining_eq (j : Link M) :
    cubesContaining M j = (dirOffsets j.2).image fun a => j.1 - offsetVec M a := by
  ext z
  simp only [cubesContaining, Finset.mem_filter, Finset.mem_univ, true_and, mem_cubeLinkFinset,
    Finset.mem_image, dirOffsets]
  constructor
  · rintro ⟨a, ha, he⟩
    exact ⟨a, ha, by rw [sub_eq_iff_eq_add]; exact he⟩
  · rintro ⟨a, ha, he⟩
    refine ⟨a, ha, ?_⟩
    rw [← he]
    exact (sub_add_cancel j.1 (offsetVec M a)).symm

/-- **Each coarse link lies in exactly `8` side-2 coarse cubes** (every `M ≥ 2`). -/
theorem card_cubesContaining (hM : 2 ≤ M) (j : Link M) : (cubesContaining M j).card = 8 := by
  have hinj : Function.Injective fun a : Fin 4 → Fin 2 => j.1 - offsetVec M a :=
    fun a a' h => offsetVec_injective hM (sub_right_injective (b := j.1) h)
  rw [cubesContaining_eq, Finset.card_image_of_injective _ hinj, card_dirOffsets]

/-- The cover weight of `j` is `(1/16)` times the number of coarse cubes containing `j`. -/
theorem sum_cover_eq (j : Link M) :
    (∑ z, if j ∈ cubeLinkFinset M z then (1 / 16 : ℝ) else 0) =
      (cubesContaining M j).card * (1 / 16) := by
  rw [Finset.sum_ite, Finset.sum_const_zero, add_zero, Finset.sum_const, nsmul_eq_mul]
  rfl

/-- **The cover weight of a coarse link is `8 · (1/16) = 1/2`** (every `M ≥ 2`). -/
theorem cover_weight (hM : 2 ≤ M) (j : Link M) :
    (∑ z, if j ∈ cubeLinkFinset M z then (1 / 16 : ℝ) else 0) = 1 / 2 := by
  rw [sum_cover_eq, card_cubesContaining M hM]
  norm_num

/-- Every coarse link lies in the coarse cube based at its source (every `M ≥ 1`). -/
theorem cover_weight_ge (j : Link M) :
    (1 / 16 : ℝ) ≤ ∑ z, if j ∈ cubeLinkFinset M z then (1 / 16 : ℝ) else 0 := by
  have hj : j ∈ cubeLinkFinset M j.1 := (mem_cubeLinkFinset M j.1 j).2 (mem_sideTwoCube_self M j.1 j.2)
  have h := Finset.single_le_sum (f := fun z => if j ∈ cubeLinkFinset M z then (1 / 16 : ℝ) else 0)
    (fun z _ => by positivity) (Finset.mem_univ j.1)
  simpa [hj] using h

/-- At `M = 1` the single coarse cube contains all `4` coarse links. -/
theorem cubeLinkFinset_one (z : Site 1) : cubeLinkFinset 1 z = Finset.univ := by
  ext j
  simp only [Finset.mem_univ, iff_true]
  exact (mem_cubeLinkFinset 1 z j).2 ⟨fun _ => 0, rfl, Subsingleton.elim _ _⟩

/-- At `M = 1` the coarse cube has `4` links. -/
theorem card_cubeLinkFinset_one (z : Site 1) : (cubeLinkFinset 1 z).card = 4 := by
  rw [cubeLinkFinset_one, Finset.card_univ]
  simp [Fintype.card_prod]

/-- At `M = 1` each coarse link lies in exactly one coarse cube. -/
theorem card_cubesContaining_one (j : Link 1) : (cubesContaining 1 j).card = 1 := by
  have h : cubesContaining 1 j = Finset.univ := by
    ext z
    simp [cubesContaining, cubeLinkFinset_one]
  rw [h, Finset.card_univ]
  simp

end Counts

section CoarseGap

variable (M : ℕ) [NeZero M] (β : ℝ)

/-- `ran Pᶜ_V ⊆ ran Pᶜ_W` for `W ⊆ V` on the SU(2) coarse space. -/
theorem coarseP_fixes_coarseP {V W : Set (Link M)} (hWV : W ⊆ V)
    (y : coarseY (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (straightBlocking M)) :
    coarseP (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (straightBlocking M) W
        (coarseP (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (straightBlocking M) V y) =
      coarseP (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (straightBlocking M) V y :=
  Subtype.ext (condL2_eq_self _ (extSigma_le W)
    (mem_lpMeas_mono _ (extSigma_anti hWV) (condL2_mem _ (extSigma_le V) _)))

/-- **The single-link Poincaré inequality** with constant `c` for the SU(2) Wilson measure on
`(ℤ/2Mℤ)⁴` at coupling `β` (normalisation of Part VI's `su2Wilson`), on the centred
gauge-invariant space: `c ‖u‖² ≤ ∑ₑ ‖u − P_{e} u‖²`, where `P_{e}` resamples the link `e`. The
accompanying notes prove it on paper with `c = 1 − 72|β|` for `|β| < 1/72` (single-link Dobrushin
bound) on all centred `L²` functions, a space that contains `H`; here it is a hypothesis. -/
def SingleLinkPoincare (c : ℝ) : Prop :=
  ∀ u : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2,
    c * ‖u‖ ^ 2 ≤ ∑ e, ‖u - su2P M β {e} u‖ ^ 2

/-- **Non-vacuity of `SingleLinkPoincare`**: at `β = 0` (product Haar measure) it holds with `c = 1`
for every `M ≥ 1` (Part XV's `extProj_gap_of_cover`). -/
theorem singleLinkPoincare_zero : SingleLinkPoincare M 0 1 := fun u => by
  have h1 := extProj_gap_of_cover haarSU2
    (wilsonMeasure (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2) (su2Wilson_zero M)
    (fun e : Link (2 * M) => ({e} : Set (Link (2 * M)))) (fun _ => (1 : ℝ)) zero_le_one
    (fun _ => le_rfl) (fun e => ⟨e, rfl⟩) u
  rw [inner_cubeGen_eq (fun _ => (1 : ℝ)) (fun e => extProj
    (wilsonMeasure (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2)
    ({e} : Set (Link (2 * M)))) _] at h1
  simp only [one_mul] at h1 ⊢
  exact h1

/-- **The coarse single-link Poincaré inequality from the fine one** (every `M ≥ 1`, every real `β`,
conditional on `SingleLinkPoincare M β c`): `(c/2) ‖y‖² ≤ ∑_ē ‖y − Pᶜ_ē y‖²` (Part XVIII's
`su2_poinc_of_lift`). -/
theorem coarse_poinc_of_singleLink {c : ℝ} (hfine : SingleLinkPoincare M β c)
    (y : coarseY (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (straightBlocking M)) :
    c / 2 * ‖y‖ ^ 2 ≤ ∑ j, ‖y - (SmallCoupling.su2CoarsePj M β {j}).P y‖ ^ 2 := by
  have h := UniformEndpoint.su2_poinc_of_lift M β (fun y' => hfine (su2J M β y')) y
  change c * ‖y‖ ^ 2 ≤ 2 * ∑ j, ‖y - (SmallCoupling.su2CoarsePj M β {j}).P y‖ ^ 2 at h
  linarith

/-- `hCoarseGap` from the single-link Poincaré inequality for `M ≥ 2` (`N = 32`, `m = 1/2`;
conditional on `SingleLinkPoincare M β c`). -/
theorem su2_coarse_gap_of_singleLink_two (hM : 2 ≤ M) {c : ℝ} (hfine : SingleLinkPoincare M β c) :
    (c / 128) • LinearMap.id ≤ su2Dc M β (sideTwoCube M) (fun _ => 1 / 16) := by
  have h : ((1 / 2 : ℝ) / 32 * (c / 2)) • LinearMap.id ≤ su2Dc M β (sideTwoCube M) (fun _ => 1 / 16) :=
    SmallCoupling.cubeGen_gap_of_cover (fun _ => 1 / 16) (fun _ => by norm_num)
      (fun z => SmallCoupling.su2CoarsePj M β (sideTwoCube M z))
      (fun j => SmallCoupling.su2CoarsePj M β {j}) (cubeLinkFinset M) (by norm_num) (by norm_num)
      (fun z => by exact_mod_cast card_cubeLinkFinset_le M z)
      (fun z j hj y => coarseP_fixes_coarseP M β
        (Set.singleton_subset_iff.2 ((mem_cubeLinkFinset M z j).1 hj)) y)
      (fun j => (cover_weight M hM j).ge) (coarse_poinc_of_singleLink M β hfine)
  have e : (1 / 2 : ℝ) / 32 * (c / 2) = c / 128 := by ring
  calc (c / 128) • LinearMap.id = ((1 / 2 : ℝ) / 32 * (c / 2)) • LinearMap.id :=
        congrArg (· • LinearMap.id) e.symm
    _ ≤ _ := h

/-- `hCoarseGap` from the single-link Poincaré inequality for `M = 1` (`N = 4`, `m = 1/16`;
conditional on `SingleLinkPoincare 1 β c`). -/
theorem su2_coarse_gap_of_singleLink_one {c : ℝ} (hfine : SingleLinkPoincare 1 β c) :
    (c / 128) • LinearMap.id ≤ su2Dc 1 β (sideTwoCube 1) (fun _ => 1 / 16) := by
  have h : ((1 / 16 : ℝ) / 4 * (c / 2)) • LinearMap.id ≤ su2Dc 1 β (sideTwoCube 1) (fun _ => 1 / 16) :=
    SmallCoupling.cubeGen_gap_of_cover (fun _ => 1 / 16) (fun _ => by norm_num)
      (fun z => SmallCoupling.su2CoarsePj 1 β (sideTwoCube 1 z))
      (fun j => SmallCoupling.su2CoarsePj 1 β {j}) (cubeLinkFinset 1) (by norm_num) (by norm_num)
      (fun z => by rw [card_cubeLinkFinset_one]; norm_num)
      (fun z j hj y => coarseP_fixes_coarseP 1 β
        (Set.singleton_subset_iff.2 ((mem_cubeLinkFinset 1 z j).1 hj)) y)
      (fun j => cover_weight_ge 1 j) (coarse_poinc_of_singleLink 1 β hfine)
  have e : (1 / 16 : ℝ) / 4 * (c / 2) = c / 128 := by ring
  calc (c / 128) • LinearMap.id = ((1 / 16 : ℝ) / 4 * (c / 2)) • LinearMap.id :=
        congrArg (· • LinearMap.id) e.symm
    _ ≤ _ := h

/-- **`hCoarseGap` from the single-link Poincaré inequality, uniformly in `M`** (SU(2) on
`(ℤ/2Mℤ)⁴`, every `M ≥ 1`, every real `β`, straight blocking, coarse side-2 cubes at every coarse
base point with weights `1/16`; conditional on `SingleLinkPoincare M β c`):
`D_c ≥ (c/128) I`. For `M ≥ 2` this is Part XVI's `cubeGen_gap_of_cover` with `N = 32`, `m = 1/2`
and `c_c = c/2`; for `M = 1` with `N = 4`, `m = 1/16`. -/
theorem su2_coarse_gap_of_singleLink {c : ℝ} (hfine : SingleLinkPoincare M β c) :
    (c / 128) • LinearMap.id ≤ su2Dc M β (sideTwoCube M) (fun _ => 1 / 16) := by
  by_cases hM : 2 ≤ M
  · exact su2_coarse_gap_of_singleLink_two M β hM hfine
  · obtain rfl : M = 1 := by have := NeZero.ne M; omega
    exact su2_coarse_gap_of_singleLink_one β hfine

/-- **`hCoarseGap` at small coupling** (every `M ≥ 1`, every real `β`; conditional on
`SingleLinkPoincare M β (1 − 72|β|)`): `D_c ≥ ((1 − 72|β|)/128) I`. -/
theorem su2_coarse_gap_small_beta (hfine : SingleLinkPoincare M β (1 - 72 * |β|)) :
