open scoped InnerProductSpace
open Finset SchurSplit YangMills.StrongCoupling.CubeSplit YangMills.StrongCoupling.CondExpInputs
  YangMills.StrongCoupling.WilsonCube YangMills.StrongCoupling.WilsonSU2
  YangMills.StrongCoupling.FibreReduction

/-! ## Part A. The certificate with the zero trial operator -/

section ZeroTrial

variable {E F : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [NormedAddCommGroup F] [InnerProductSpace ℝ F]

/-- For the zero trial operator the form `Q` vanishes. -/
theorem qForm_zero_trial (A : E →ₗ[ℝ] E) (B : F →ₗ[ℝ] E) (α : ℝ) (v : F) :
    qForm A B α 0 v = 0 := by
  simp [qForm]

/-- For the zero trial operator the residual is the mixed block: `R v = B v`. -/
theorem resid_zero_trial (A : E →ₗ[ℝ] E) (B : F →ₗ[ℝ] E) (α : ℝ) (v : F) :
    resid A B α 0 v = B v := by
  simp [resid_apply]

/-- **The certificate with `X = 0` from local bounds.** Let `Γ ≥ 0` be a functional on `F` with
`‖B v‖² ≤ ε_B Γ v`, `g v ≤ K_g Γ v` and `c Γ v ≤ ⟪v, C v⟫`. If `α < λ`, `β' ≥ 0` and
`β' K_g + ε_B / (λ − α) ≤ c`, then `β' g v + Q v + ‖R v‖² / (λ − α) ≤ ⟪v, C v⟫` for `X = 0`. -/
theorem cert_zero_of_local (A : E →ₗ[ℝ] E) {B : F →ₗ[ℝ] E} {C : F →ₗ[ℝ] F} {g Γ : F → ℝ}
    {lam α β' εB Kg c : ℝ} (hα : α < lam) (hβ : 0 ≤ β') (hΓ : ∀ v, 0 ≤ Γ v)
    (hB : ∀ v, ‖B v‖ ^ 2 ≤ εB * Γ v) (hg : ∀ v, g v ≤ Kg * Γ v)
    (hC : ∀ v, c * Γ v ≤ ⟪v, C v⟫_ℝ) (hbud : β' * Kg + εB / (lam - α) ≤ c) (v : F) :
    β' * g v + qForm A B α 0 v + ‖resid A B α 0 v‖ ^ 2 / (lam - α) ≤ ⟪v, C v⟫_ℝ := by
  rw [qForm_zero_trial, resid_zero_trial, add_zero]
  have hl : 0 < lam - α := sub_pos.2 hα
  have h1 : β' * g v ≤ β' * (Kg * Γ v) := mul_le_mul_of_nonneg_left (hg v) hβ
  have h2 : ‖B v‖ ^ 2 / (lam - α) ≤ εB * Γ v / (lam - α) :=
    div_le_div_of_nonneg_right (hB v) hl.le
  have h3 : (β' * Kg + εB / (lam - α)) * Γ v ≤ c * Γ v :=
    mul_le_mul_of_nonneg_right hbud (hΓ v)
  calc β' * g v + ‖B v‖ ^ 2 / (lam - α) ≤ β' * (Kg * Γ v) + εB * Γ v / (lam - α) :=
        add_le_add h1 h2
    _ = (β' * Kg + εB / (lam - α)) * Γ v := by ring
    _ ≤ c * Γ v := h3
    _ ≤ ⟪v, C v⟫_ℝ := hC v

end ZeroTrial

/-! ## Part B. The cube split with `X = 0` -/

section Split

variable {H Y : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
  [NormedAddCommGroup Y] [InnerProductSpace ℝ Y] {ι : Type*} [Fintype ι]
  {D : H →ₗ[ℝ] H} {w : ι → ℝ} {P : ι → H →ₗ[ℝ] H} {pj : OrthProj H}
  {J : Y →ₗ[ℝ] H} {Jt : H →ₗ[ℝ] Y} {Dc : Y →ₗ[ℝ] Y}

/-- **The mixed block vanishes when every cube projection preserves `ran Π`.** This is the block
form of `resampling_offdiag_eq_zero` of Part I. -/
theorem blkB_eq_zero_of_invariant (hWilson : CubeSplitInputs D w P pj J Jt Dc)
    (hinv : ∀ x z, pj.P (P x (pj.P z)) = P x (pj.P z)) (v : pj.Hc) :
    pj.blkB D v = 0 := by
  apply Subtype.ext
  rw [hWilson.blkB_eq v]
  have hv : pj.P v = v := pj.P_of_mem_Hc v.2
  have hz : ∀ x, P x v - pj.P (P x v) = 0 := by
    intro x
    have h := hinv x v
    rw [hv] at h
    rw [h, sub_self]
  simp [hz]

/-- **The split when the cube projections preserve `ran Π`.** Then `B = 0`, and the residual input
reduces to `β' ⟪J* v, D_c J* v⟫ ≤ ⟪v, C v⟫` on `H_c`. -/
theorem gap_of_invariant (hWilson : CubeSplitInputs D w P pj J Jt Dc) {lam α β' ϖ : ℝ}
    (hFibre : ∀ u, pj.P u = 0 → lam * ‖u‖ ^ 2 ≤ ⟪u, D u⟫_ℝ) (hα : α < lam) (hβ : 0 ≤ β')
    (hCoarseGap : ϖ • LinearMap.id ≤ Dc)
    (hinv : ∀ x z, pj.P (P x (pj.P z)) = P x (pj.P z))
    (hC : ∀ v : pj.Hc, β' * pj.gC Jt Dc v ≤ ⟪v, pj.blkC D v⟫_ℝ) :
    min α (β' * ϖ) • LinearMap.id ≤ D :=
  hWilson.gap_of_residual hFibre hα hβ hCoarseGap 0 fun v => by
    rw [qForm_zero_trial, resid_zero_trial, blkB_eq_zero_of_invariant hWilson hinv v, norm_zero]
    simpa using hC v

/-- **The split from local bounds with `X = 0`.** `hWilson`, `hFibre`, `hCoarseGap` and the local
bounds of `cert_zero_of_local` for the blocks of `D` give `D ≥ min(α, β' ϖ) I`. -/
theorem gap_of_local_residual (hWilson : CubeSplitInputs D w P pj J Jt Dc)
    {lam α β' ϖ εB Kg c : ℝ}
    (hFibre : ∀ u, pj.P u = 0 → lam * ‖u‖ ^ 2 ≤ ⟪u, D u⟫_ℝ) (hα : α < lam) (hβ : 0 ≤ β')
    (hCoarseGap : ϖ • LinearMap.id ≤ Dc) (Γ : pj.Hc → ℝ) (hΓ : ∀ v, 0 ≤ Γ v)
    (hB : ∀ v, ‖pj.blkB D v‖ ^ 2 ≤ εB * Γ v) (hg : ∀ v, pj.gC Jt Dc v ≤ Kg * Γ v)
    (hC : ∀ v, c * Γ v ≤ ⟪v, pj.blkC D v⟫_ℝ) (hbud : β' * Kg + εB / (lam - α) ≤ c) :
    min α (β' * ϖ) • LinearMap.id ≤ D :=
  hWilson.gap_of_residual hFibre hα hβ hCoarseGap 0
    (cert_zero_of_local (pj.blkA D) hα hβ hΓ hB hg hC hbud)

end Split

/-! ## Part C. Projections: best approximation, lifts and covers -/

section Projections

variable {H Y : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
  [NormedAddCommGroup Y] [InnerProductSpace ℝ Y]

/-- **Best approximation.** If `P z = z`, then `‖x − P x‖ ≤ ‖x − z‖`. -/
theorem norm_sub_P_le_of_fix (P : OrthProj H) (x z : H) (hz : P.P z = z) :
    ‖x - P.P x‖ ^ 2 ≤ ‖x - z‖ ^ 2 := by
  have h0 : ⟪x - P.P x, P.P x - z⟫_ℝ = 0 := by
    have e : P.P x - z = P.P (x - z) := by rw [map_sub, hz]
    rw [e, ← P.symm (x - P.P x) (x - z), map_sub, P.idem, sub_self, inner_zero_left]
  have h := norm_add_sq_real (x - P.P x) (P.P x - z)
  rw [show x - P.P x + (P.P x - z) = x - z by abel, h0, mul_zero, add_zero] at h
  nlinarith [sq_nonneg ‖P.P x - z‖]

/-- **Lifting a projection defect.** If the isometry `J` maps `ran Q` into `ran P`, then
`‖J y − P J y‖ ≤ ‖y − Q y‖`. -/
theorem norm_sub_le_of_lift (J : Y →ₗᵢ[ℝ] H) (P : OrthProj H) (Q : OrthProj Y)
    (hfix : ∀ y, P.P (J (Q.P y)) = J (Q.P y)) (y : Y) :
    ‖J y - P.P (J y)‖ ^ 2 ≤ ‖y - Q.P y‖ ^ 2 := by
  have h := norm_sub_P_le_of_fix P (J y) (J (Q.P y)) (hfix y)
  rwa [← map_sub J y (Q.P y), J.norm_map] at h

/-- **Poincaré inequalities lift through an isometry.** Let `R_e` be projections on `H` and `Q_j`
projections on `Y`. Suppose `c ‖J y‖² ≤ ∑_e ‖J y − R_e J y‖²`, that `R_e` fixes `ran J` for
`e ∉ S`, that `J` maps `ran Q_{φ e}` into `ran R_e` for `e ∈ S`, and that each fibre of `φ` on `S`
has at most `mult` elements. Then `c ‖y‖² ≤ mult ∑_j ‖y − Q_j y‖²`. -/
theorem poinc_of_lift {κf κc : Type*} [Fintype κf] [Fintype κc] [DecidableEq κc]
    (J : Y →ₗᵢ[ℝ] H) (R : κf → OrthProj H) (Q : κc → OrthProj Y) (S : Finset κf)
    (φ : κf → κc) {c mult : ℝ}
    (hfine : ∀ y, c * ‖J y‖ ^ 2 ≤ ∑ e, ‖J y - (R e).P (J y)‖ ^ 2)
    (hout : ∀ e ∉ S, ∀ y, (R e).P (J y) = J y)
    (hin : ∀ e ∈ S, ∀ y, (R e).P (J ((Q (φ e)).P y)) = J ((Q (φ e)).P y))
    (hmult : ∀ j, ((S.filter fun e => φ e = j).card : ℝ) ≤ mult) (y : Y) :
    c * ‖y‖ ^ 2 ≤ mult * ∑ j, ‖y - (Q j).P y‖ ^ 2 := by
  have h1 : ∑ e, ‖J y - (R e).P (J y)‖ ^ 2 = ∑ e ∈ S, ‖J y - (R e).P (J y)‖ ^ 2 :=
    (Finset.sum_subset (Finset.subset_univ S) fun e _ he => by
      rw [hout e he y, sub_self, norm_zero]; ring).symm
  have h2 : ∑ e ∈ S, ‖J y - (R e).P (J y)‖ ^ 2 ≤ ∑ e ∈ S, ‖y - (Q (φ e)).P y‖ ^ 2 :=
    Finset.sum_le_sum fun e he => norm_sub_le_of_lift J (R e) (Q (φ e)) (hin e he) y
  have hfib : ∀ j, ∑ e ∈ S.filter (fun e => φ e = j), ‖y - (Q (φ e)).P y‖ ^ 2 =
      ((S.filter fun e => φ e = j).card : ℝ) * ‖y - (Q j).P y‖ ^ 2 := by
    intro j
    calc ∑ e ∈ S.filter (fun e => φ e = j), ‖y - (Q (φ e)).P y‖ ^ 2
        = ∑ _e ∈ S.filter (fun e => φ e = j), ‖y - (Q j).P y‖ ^ 2 :=
          Finset.sum_congr rfl fun e he => by rw [(Finset.mem_filter.1 he).2]
      _ = _ := by rw [Finset.sum_const, nsmul_eq_mul]
  have h3 : ∑ e ∈ S, ‖y - (Q (φ e)).P y‖ ^ 2 =
      ∑ j, ((S.filter fun e => φ e = j).card : ℝ) * ‖y - (Q j).P y‖ ^ 2 := by
    rw [← Finset.sum_fiberwise_of_maps_to (s := S) (t := Finset.univ) (g := φ)
      (fun _ _ => Finset.mem_univ _)]
    exact Finset.sum_congr rfl fun j _ => hfib j
  have h4 : ∑ j, ((S.filter fun e => φ e = j).card : ℝ) * ‖y - (Q j).P y‖ ^ 2 ≤
      mult * ∑ j, ‖y - (Q j).P y‖ ^ 2 := by
    rw [Finset.mul_sum]
    exact Finset.sum_le_sum fun j _ => mul_le_mul_of_nonneg_right (hmult j) (sq_nonneg _)
  have h5 := hfine y
  rw [J.norm_map] at h5
  linarith [h1, h2, h3, h4, h5]

/-- **Covers.** Let `ran Pₓ ⊆ ran Q_j` for every `j ∈ sₓ`, with `card sₓ ≤ N`, and let every `j` be
covered with weight `m ≤ ∑_{x : j ∈ sₓ} wₓ`. Then
`(m / N) ∑_j ‖u − Q_j u‖² ≤ ∑ₓ wₓ ‖u − Pₓ u‖²`. -/
theorem sum_ge_of_cover {ι κ : Type*} [Fintype ι] [Fintype κ] [DecidableEq κ] (w : ι → ℝ)
    (hw : ∀ x, 0 ≤ w x) (P : ι → OrthProj H) (Q : κ → OrthProj H) (s : ι → Finset κ) {N m : ℝ}
    (hN : 0 < N) (hcard : ∀ x, ((s x).card : ℝ) ≤ N)
    (hle : ∀ x, ∀ j ∈ s x, ∀ z, (Q j).P ((P x).P z) = (P x).P z)
    (hcov : ∀ j, m ≤ ∑ x, if j ∈ s x then w x else 0) (u : H) :
    m / N * ∑ j, ‖u - (Q j).P u‖ ^ 2 ≤ ∑ x, w x * ‖u - (P x).P u‖ ^ 2 := by
  have hloc : ∀ x, ∑ j ∈ s x, ‖u - (Q j).P u‖ ^ 2 ≤ N * ‖u - (P x).P u‖ ^ 2 := by
    intro x
    calc ∑ j ∈ s x, ‖u - (Q j).P u‖ ^ 2 ≤ ∑ _j ∈ s x, ‖u - (P x).P u‖ ^ 2 :=
          Finset.sum_le_sum fun j hj => norm_sub_le_of_le (P x) (Q j) (hle x j hj) u
      _ = ((s x).card : ℝ) * ‖u - (P x).P u‖ ^ 2 := by rw [Finset.sum_const, nsmul_eq_mul]
      _ ≤ N * ‖u - (P x).P u‖ ^ 2 := mul_le_mul_of_nonneg_right (hcard x) (sq_nonneg _)
  have hswap : ∑ j, (∑ x, if j ∈ s x then w x else 0) * ‖u - (Q j).P u‖ ^ 2 =
      ∑ x, w x * ∑ j ∈ s x, ‖u - (Q j).P u‖ ^ 2 := by
    simp only [Finset.sum_mul, ite_mul, zero_mul]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun x _ => ?_
    rw [Finset.sum_ite_mem, Finset.univ_inter, Finset.mul_sum]
  have hmain : m * ∑ j, ‖u - (Q j).P u‖ ^ 2 ≤ (∑ x, w x * ‖u - (P x).P u‖ ^ 2) * N := by
    calc m * ∑ j, ‖u - (Q j).P u‖ ^ 2 = ∑ j, m * ‖u - (Q j).P u‖ ^ 2 := by rw [Finset.mul_sum]
      _ ≤ ∑ j, (∑ x, if j ∈ s x then w x else 0) * ‖u - (Q j).P u‖ ^ 2 :=
          Finset.sum_le_sum fun j _ => mul_le_mul_of_nonneg_right (hcov j) (sq_nonneg _)
      _ = ∑ x, w x * ∑ j ∈ s x, ‖u - (Q j).P u‖ ^ 2 := hswap
      _ ≤ ∑ x, w x * (N * ‖u - (P x).P u‖ ^ 2) :=
          Finset.sum_le_sum fun x _ => mul_le_mul_of_nonneg_left (hloc x) (hw x)
      _ = (∑ x, w x * ‖u - (P x).P u‖ ^ 2) * N := by
          rw [Finset.sum_mul]
          exact Finset.sum_congr rfl fun x _ => by ring
  rw [div_mul_eq_mul_div, div_le_iff₀ hN]
  exact hmain

/-- **A gap of a cube generator from a cover and a Poincaré inequality** for the covering
projections: `D ≥ (m / N) c I` when `c ‖y‖² ≤ ∑_j ‖y − Q_j y‖²`. -/
theorem cubeGen_gap_of_cover {ι κ : Type*} [Fintype ι] [Fintype κ] [DecidableEq κ]
    (w : ι → ℝ) (hw : ∀ x, 0 ≤ w x) (P : ι → OrthProj Y) (Q : κ → OrthProj Y) (s : ι → Finset κ)
    {N m c : ℝ} (hN : 0 < N) (hm : 0 ≤ m) (hcard : ∀ x, ((s x).card : ℝ) ≤ N)
    (hle : ∀ x, ∀ j ∈ s x, ∀ z, (Q j).P ((P x).P z) = (P x).P z)
    (hcov : ∀ j, m ≤ ∑ x, if j ∈ s x then w x else 0)
    (hpoinc : ∀ y, c * ‖y‖ ^ 2 ≤ ∑ j, ‖y - (Q j).P y‖ ^ 2) :
    (m / N * c) • LinearMap.id ≤ cubeGen w (fun x => (P x).P) :=
  SchurTower.smul_id_le_of_form (cubeGen_isSymmetric w fun x => (P x).symm) fun y => by
    rw [inner_cubeGen_eq]
    calc m / N * c * ‖y‖ ^ 2 = m / N * (c * ‖y‖ ^ 2) := by ring
      _ ≤ m / N * ∑ j, ‖y - (Q j).P y‖ ^ 2 :=
          mul_le_mul_of_nonneg_left (hpoinc y) (div_nonneg hm hN.le)
      _ ≤ ∑ x, w x * ‖y - (P x).P y‖ ^ 2 := sum_ge_of_cover w hw P Q s hN hcard hle hcov y

end Projections

/-! ## Part D. Assembly -/

section Assembly

variable {H Y : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
  [NormedAddCommGroup Y] [InnerProductSpace ℝ Y]

/-- **Assembly from covers.** Under `hWilson` for `D = ∑ₓ wₓ (I − Pₓ)` and
`D_c = ∑_z w_z (I − Pᶜ_z)`, suppose:
* fibre: `P'ₓ` with `ran Pₓ ⊆ ran P'ₓ ⊇ ran Π`, covered by projections `R_e`
  (`ran P'ₓ ⊆ ran R_e` for `e ∈ sₓ`, `card sₓ ≤ N_f`, weight `≥ m_f`), and
  `c_f ‖u‖² ≤ ∑_e ‖u − R_e u‖²` on `ker Π`;
* coarse: `Pᶜ_z` covered by projections `Q_j` in the same way (`N_c`, `m_c`), and
  `c_c ‖y‖² ≤ ∑_j ‖y − Q_j y‖²`;
* residual: the local bounds of `cert_zero_of_local` with `λ = (m_f / N_f) c_f`.
Then `D ≥ min(α, β' (m_c / N_c) c_c) I`. -/
theorem gap_of_covers {ι ιc κ κc : Type*} [Fintype ι] [Fintype ιc] [Fintype κ] [Fintype κc]
    [DecidableEq κ] [DecidableEq κc]
    {D : H →ₗ[ℝ] H} {w : ι → ℝ} {P : ι → OrthProj H} {pj : OrthProj H}
    {J : Y →ₗ[ℝ] H} {Jt : H →ₗ[ℝ] Y} {wc : ιc → ℝ} {Pc : ιc → OrthProj Y}
    (hWilson : CubeSplitInputs D w (fun x => (P x).P) pj J Jt (cubeGen wc fun z => (Pc z).P))
    (hw : ∀ x, 0 ≤ w x) (hwc : ∀ z, 0 ≤ wc z)
    (P' : ι → OrthProj H) (hle : ∀ x z, (P' x).P ((P x).P z) = (P x).P z)
    (hcoarse : ∀ x z, (P' x).P (pj.P z) = pj.P z)
    (R : κ → OrthProj H) (s : ι → Finset κ) {Nf mf cf : ℝ} (hNf : 0 < Nf) (hmf : 0 ≤ mf)
    (hcardf : ∀ x, ((s x).card : ℝ) ≤ Nf)
    (hlef : ∀ x, ∀ e ∈ s x, ∀ z, (R e).P ((P' x).P z) = (P' x).P z)
    (hcovf : ∀ e, mf ≤ ∑ x, if e ∈ s x then w x else 0)
    (hpoincF : ∀ u, pj.P u = 0 → cf * ‖u‖ ^ 2 ≤ ∑ e, ‖u - (R e).P u‖ ^ 2)
    (Q : κc → OrthProj Y) (sc : ιc → Finset κc) {Nc mc cc : ℝ} (hNc : 0 < Nc) (hmc : 0 ≤ mc)
    (hcardc : ∀ z, ((sc z).card : ℝ) ≤ Nc)
    (hlec : ∀ z, ∀ j ∈ sc z, ∀ y, (Q j).P ((Pc z).P y) = (Pc z).P y)
    (hcovc : ∀ j, mc ≤ ∑ z, if j ∈ sc z then wc z else 0)
    (hpoincC : ∀ y, cc * ‖y‖ ^ 2 ≤ ∑ j, ‖y - (Q j).P y‖ ^ 2)
    {α β' εB Kg cΓ : ℝ} (hα : α < mf / Nf * cf) (hβ : 0 ≤ β') (Γ : pj.Hc → ℝ)
    (hΓ : ∀ v, 0 ≤ Γ v) (hB : ∀ v, ‖pj.blkB D v‖ ^ 2 ≤ εB * Γ v)
    (hg : ∀ v, pj.gC Jt (cubeGen wc fun z => (Pc z).P) v ≤ Kg * Γ v)
    (hC : ∀ v, cΓ * Γ v ≤ ⟪v, pj.blkC D v⟫_ℝ)
    (hbud : β' * Kg + εB / (mf / Nf * cf - α) ≤ cΓ) :
    min α (β' * (mc / Nc * cc)) • LinearMap.id ≤ D := by
  have hcons : ∀ u, pj.P u = 0 → mf / Nf * cf * ‖u‖ ^ 2 ≤ ∑ x, w x * ‖u - (P' x).P u‖ ^ 2 :=
    fun u hu =>
      calc mf / Nf * cf * ‖u‖ ^ 2 = mf / Nf * (cf * ‖u‖ ^ 2) := by ring
        _ ≤ mf / Nf * ∑ e, ‖u - (R e).P u‖ ^ 2 :=
            mul_le_mul_of_nonneg_left (hpoincF u hu) (div_nonneg hmf hNf.le)
        _ ≤ ∑ x, w x * ‖u - (P' x).P u‖ ^ 2 := sum_ge_of_cover w hw P' R s hNf hcardf hlef hcovf u
  have hF := (fibre_of_constrained w hw P P' hle pj hcoarse hcons).2
  have hFibre : ∀ u, pj.P u = 0 → mf / Nf * cf * ‖u‖ ^ 2 ≤ ⟪u, D u⟫_ℝ := by
    intro u hu
    rw [hWilson.gen_eq]
    exact hF u hu
  exact gap_of_local_residual hWilson hFibre hα hβ
    (cubeGen_gap_of_cover wc hwc Pc Q sc hNc hmc hcardc hlec hcovc hpoincC) Γ hΓ hB hg hC hbud

/-- **Assembly from Dobrushin criteria.** As `gap_of_covers`, with the fibre bound supplied by
`fibre_of_dobrushin` applied to the constrained projections `P'ₓ` themselves (`λ = w_min (1 − r)`)
and the coarse Poincaré inequality by `dobrushin_gap` for single-site coarse projections `Q_j`
(`c_c = 1 − r_c`). The seminorms are real-valued on the whole of `ker Π` and of the coarse space;
these hypotheses are not verified for the Wilson model. -/
theorem gap_of_dobrushin_inputs {ι ιc κc : Type*} [Fintype ι] [DecidableEq ι] [Nonempty ι]
    [Fintype ιc] [Fintype κc] [DecidableEq κc] [Nonempty κc]
    {D : H →ₗ[ℝ] H} {w : ι → ℝ} {P : ι → OrthProj H} {pj : OrthProj H}
    {J : Y →ₗ[ℝ] H} {Jt : H →ₗ[ℝ] Y} {wc : ιc → ℝ} {Pc : ιc → OrthProj Y}
    (hWilson : CubeSplitInputs D w (fun x => (P x).P) pj J Jt (cubeGen wc fun z => (Pc z).P))
    {wmin : ℝ} (hwmin : 0 ≤ wmin) (hw : ∀ x, wmin ≤ w x) (hwc : ∀ z, 0 ≤ wc z)
    (P' : ι → OrthProj H) (hle : ∀ x z, (P' x).P ((P x).P z) = (P x).P z)
    (hcoarse : ∀ x z, (P' x).P (pj.P z) = pj.P z)
    (δ : ι → Seminorm ℝ H) (C : ι → ι → ℝ) {r K : ℝ} (hr : 0 ≤ r) (hK : 0 ≤ K)
    (hself : ∀ i f, pj.P f = 0 → δ i ((P' i).P f) = 0)
    (hcross : ∀ i j, i ≠ j → ∀ f, pj.P f = 0 → δ j ((P' i).P f) ≤ δ j f + C i j * δ i f)
    (hrow : ∀ i, ∑ j ∈ univ.erase i, C i j ≤ r)
    (hpoinc : ∀ f, pj.P f = 0 → ‖f‖ ≤ K * ∑ j, δ j f)
    (Q : κc → OrthProj Y) (δc : κc → Seminorm ℝ Y) (Cc : κc → κc → ℝ) {rc Kc : ℝ}
    (hrc : 0 ≤ rc) (hKc : 0 ≤ Kc) (hselfc : ∀ i y, δc i ((Q i).P y) = 0)
    (hcrossc : ∀ i j, i ≠ j → ∀ y, δc j ((Q i).P y) ≤ δc j y + Cc i j * δc i y)
    (hrowc : ∀ i, ∑ j ∈ univ.erase i, Cc i j ≤ rc)
    (hpoincc : ∀ y, ‖y‖ ≤ Kc * ∑ j, δc j y)
    (sc : ιc → Finset κc) {Nc mc : ℝ} (hNc : 0 < Nc) (hmc : 0 ≤ mc)
    (hcardc : ∀ z, ((sc z).card : ℝ) ≤ Nc)
    (hlec : ∀ z, ∀ j ∈ sc z, ∀ y, (Q j).P ((Pc z).P y) = (Pc z).P y)
    (hcovc : ∀ j, mc ≤ ∑ z, if j ∈ sc z then wc z else 0)
    {α β' εB Kg cΓ : ℝ} (hα : α < wmin * (1 - r)) (hβ : 0 ≤ β') (Γ : pj.Hc → ℝ)
    (hΓ : ∀ v, 0 ≤ Γ v) (hB : ∀ v, ‖pj.blkB D v‖ ^ 2 ≤ εB * Γ v)
    (hg : ∀ v, pj.gC Jt (cubeGen wc fun z => (Pc z).P) v ≤ Kg * Γ v)
    (hC : ∀ v, cΓ * Γ v ≤ ⟪v, pj.blkC D v⟫_ℝ)
    (hbud : β' * Kg + εB / (wmin * (1 - r) - α) ≤ cΓ) :
    min α (β' * (mc / Nc * (1 - rc))) • LinearMap.id ≤ D := by
  have hF := fibre_of_dobrushin w hwmin hw P P' hle pj hcoarse δ C hr hK hself hcross hrow hpoinc
  have hFibre : ∀ u, pj.P u = 0 → wmin * (1 - r) * ‖u‖ ^ 2 ≤ ⟪u, D u⟫_ℝ := by
    intro u hu
    rw [hWilson.gen_eq]
    exact hF u hu
  have hgapc := dobrushin_gap Q ⊤ (fun _ _ _ => Submodule.mem_top) δc Cc hrc hKc
    (fun i y _ => hselfc i y) (fun i j hij y _ => hcrossc i j hij y) hrowc
    (fun y _ => hpoincc y)
  have hpoincC : ∀ y, (1 - rc) * ‖y‖ ^ 2 ≤ ∑ j, ‖y - (Q j).P y‖ ^ 2 :=
    fun y => hgapc y Submodule.mem_top
  exact gap_of_local_residual hWilson hFibre hα hβ
    (cubeGen_gap_of_cover wc hwc Pc Q sc hNc hmc hcardc hlec hcovc hpoincC) Γ hΓ hB hg hC hbud

end Assembly

/-! ## Part E. SU(2) on `(ℤ/2Mℤ)⁴` -/

section SU2

variable (M : ℕ) [NeZero M] (β : ℝ)

/-- The SU(2) coarse cube projection `Pᶜ_V = E_{c_* μ}[· | coarse links outside V]` on the coarse
space, as an orthogonal projection. -/
noncomputable def su2CoarsePj (V : Set (Link M)) :
    OrthProj (coarseY (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (straightBlocking M)) where
  P := coarseP (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (straightBlocking M) V
  idem := cubeProj_idem _ _ (extSigma_le V) (extSigma_stable V)
  symm := cubeProj_isSymmetric _ _ (extSigma_le V) (extSigma_stable V)

/-- **SU(2): the split with `X = 0` from local bounds.** For every `M ≥ 1` and every real `β`:
`hcons`, `hCoarseGap` and the local bounds of `cert_zero_of_local` for the blocks of
`D = ∑ₓ wₓ (I − P_{Vₓ})` give `D ≥ min(α, β' ϖ) I` on the centred gauge-invariant space. -/
theorem su2_gap_of_local_residual {ι ιc : Type*} [Fintype ι] [Fintype ιc]
    (V : ι → Set (Link (2 * M))) (w : ι → ℝ) (hw : ∀ x, 0 ≤ w x) (Vc : ιc → Set (Link M))
    (wc : ιc → ℝ) {lam α β' ϖ εB Kg c : ℝ}
    (hcons : ∀ u, (su2Pi M β).P u = 0 →
      lam * ‖u‖ ^ 2 ≤ ∑ x, w x * ‖u - su2P M β (V x \ skel (straightBlocking M)) u‖ ^ 2)
    (hα : α < lam) (hβ : 0 ≤ β') (hCoarseGap : ϖ • LinearMap.id ≤ su2Dc M β Vc wc)
    (Γ : (su2Pi M β).Hc → ℝ) (hΓ : ∀ v, 0 ≤ Γ v)
    (hB : ∀ v, ‖(su2Pi M β).blkB (su2D M β V w) v‖ ^ 2 ≤ εB * Γ v)
    (hg : ∀ v, (su2Pi M β).gC (su2Jt M β) (su2Dc M β Vc wc) v ≤ Kg * Γ v)
    (hC : ∀ v, c * Γ v ≤ ⟪v, (su2Pi M β).blkC (su2D M β V w) v⟫_ℝ)
    (hbud : β' * Kg + εB / (lam - α) ≤ c) :
    min α (β' * ϖ) • LinearMap.id ≤ su2D M β V w :=
  su2_gap_of_constrained M β V w hw Vc wc hcons hα hβ hCoarseGap 0
    (cert_zero_of_local _ hα hβ hΓ hB hg hC hbud)

/-- **SU(2): the split from covers.** For every `M ≥ 1` and every real `β`, with fine projections
`R_e` covering the constrained cubes `P_{Vₓ ∖ Sk}` and coarse projections `Q_j` covering the coarse
cubes, Poincaré inequalities for the `R_e` on `ker Π` and for the `Q_j` on the coarse space, and the
local residual bounds, `D ≥ min(α, β' (m_c / N_c) c_c) I` with `α < (m_f / N_f) c_f`. -/
theorem su2_gap_of_covers {ι ιc κ κc : Type*} [Fintype ι] [Fintype ιc] [Fintype κ] [Fintype κc]
    [DecidableEq κ] [DecidableEq κc]
    (V : ι → Set (Link (2 * M))) (w : ι → ℝ) (hw : ∀ x, 0 ≤ w x) (Vc : ιc → Set (Link M))
    (wc : ιc → ℝ) (hwc : ∀ z, 0 ≤ wc z)
    (R : κ → OrthProj (wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2))
    (s : ι → Finset κ) {Nf mf cf : ℝ} (hNf : 0 < Nf) (hmf : 0 ≤ mf)
    (hcardf : ∀ x, ((s x).card : ℝ) ≤ Nf)
    (hlef : ∀ x, ∀ e ∈ s x, ∀ z, (R e).P (su2P M β (V x \ skel (straightBlocking M)) z) =
      su2P M β (V x \ skel (straightBlocking M)) z)
    (hcovf : ∀ e, mf ≤ ∑ x, if e ∈ s x then w x else 0)
    (hpoincF : ∀ u, (su2Pi M β).P u = 0 → cf * ‖u‖ ^ 2 ≤ ∑ e, ‖u - (R e).P u‖ ^ 2)
    (Q : κc → OrthProj (coarseY (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (straightBlocking M)))
    (sc : ιc → Finset κc) {Nc mc cc : ℝ} (hNc : 0 < Nc) (hmc : 0 ≤ mc)
    (hcardc : ∀ z, ((sc z).card : ℝ) ≤ Nc)
    (hlec : ∀ z, ∀ j ∈ sc z, ∀ y, (Q j).P ((su2CoarsePj M β (Vc z)).P y) =
      (su2CoarsePj M β (Vc z)).P y)
    (hcovc : ∀ j, mc ≤ ∑ z, if j ∈ sc z then wc z else 0)
    (hpoincC : ∀ y, cc * ‖y‖ ^ 2 ≤ ∑ j, ‖y - (Q j).P y‖ ^ 2)
    {α β' εB Kg cΓ : ℝ} (hα : α < mf / Nf * cf) (hβ : 0 ≤ β') (Γ : (su2Pi M β).Hc → ℝ)
    (hΓ : ∀ v, 0 ≤ Γ v) (hB : ∀ v, ‖(su2Pi M β).blkB (su2D M β V w) v‖ ^ 2 ≤ εB * Γ v)
    (hg : ∀ v, (su2Pi M β).gC (su2Jt M β) (su2Dc M β Vc wc) v ≤ Kg * Γ v)
    (hC : ∀ v, cΓ * Γ v ≤ ⟪v, (su2Pi M β).blkC (su2D M β V w) v⟫_ℝ)
    (hbud : β' * Kg + εB / (mf / Nf * cf - α) ≤ cΓ) :
    min α (β' * (mc / Nc * cc)) • LinearMap.id ≤ su2D M β V w := by
  have hcons : ∀ u, (su2Pi M β).P u = 0 → mf / Nf * cf * ‖u‖ ^ 2 ≤
      ∑ x, w x * ‖u - su2P M β (V x \ skel (straightBlocking M)) u‖ ^ 2 :=
    fun u hu =>
      calc mf / Nf * cf * ‖u‖ ^ 2 = mf / Nf * (cf * ‖u‖ ^ 2) := by ring
        _ ≤ mf / Nf * ∑ e, ‖u - (R e).P u‖ ^ 2 :=
            mul_le_mul_of_nonneg_left (hpoincF u hu) (div_nonneg hmf hNf.le)
        _ ≤ ∑ x, w x * ‖u - su2P M β (V x \ skel (straightBlocking M)) u‖ ^ 2 :=
            sum_ge_of_cover w hw (fun x => wilsonPj (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
              (V x \ skel (straightBlocking M))) R s hNf hcardf hlef hcovf u
  have hCG : (mc / Nc * cc) • LinearMap.id ≤ su2Dc M β Vc wc :=
    cubeGen_gap_of_cover wc hwc (fun z => su2CoarsePj M β (Vc z)) Q sc hNc hmc hcardc hlec
      hcovc hpoincC
  exact su2_gap_of_local_residual M β V w hw Vc wc hcons hα hβ hCG Γ hΓ hB hg hC hbud

end SU2

end YangMills.StrongCoupling.SmallCoupling

/-! # Part XVII. `YangMills.StrongCoupling.SkeletonCondExp`: Lemma IV, the conditional expectation onto the skeleton links is `Π` on `H` (new; uses Parts III, IV, VI, X, XII and XV) -/

/-!
# Lemma IV: the skeleton conditional expectation is the coarse projection `Π` on `H`

## (a) Formal target

Let `μ` be the Wilson measure of Part IV (any finite oriented lattice, any group `G` with a
bi-invariant probability measure `h`, any class function `χ`, every real `κ`) and `blk` a two-link
blocking whose mid-sites `m(ē) = tgt (a ē) = src (b ē)` are pairwise distinct and are not coarse sites.
The target is Lemma IV of the accompanying research notes: on the centred gauge-invariant space
`H = wilsonH`, the conditional expectation given the skeleton links,
`E_μ[· | σ(U_e : e ∈ Sk)] = wilsonP (Skᶜ)` (the exterior σ-algebra of `Skᶜ`), equals the coarse
projection `Π = isoProj (wilsonJ …) = J J*`; and its consequences for the constrained route of
Part X at `β = 0`.

## (b) What is proved

* Factorisation (`extSigma_le_comap_restrict`, `eq_of_extSigma_measurable`): a function that is
  measurable for the exterior σ-algebra of `V` takes equal values at configurations that agree
  outside `V`.
* Mid-site gauge transformations and a section of the blocking map (`midSite`, `midGauge`,
  `skelSect`, `sumElim_injective_of_mid`, `midGauge_smul_a`, `midGauge_smul_b`, `skelSect_a`,
  `skelSect_b`, `measurable_skelSect`, `measurable_midGauge_smul`): `midGauge k` is `k ē` at `m(ē)`
  and `1` elsewhere; it acts on the skeleton by `U(a ē) ↦ U(a ē) (k ē)⁻¹`, `U(b ē) ↦ k ē U(b ē)`,
  and leaves the blocked field `c(U)` unchanged; `skelSect y k` puts `y ē (k ē)⁻¹` on `a ē`, `k ē`
  on `b ē` and `1` elsewhere. Distinct mid-sites that are not coarse sites force the fine links
  `a ē`, `b ē` to be pairwise distinct.
* Gauge averaging (`midAvg`, `stronglyMeasurable_midAvg`, `gauge_average`): under the two
  mid-site conditions, for every probability measure `μ` on `E → G` (no invariance of `μ` is used in
  this step) and every skeleton-measurable `g` with `g ∘ (midGauge k • ·) = g` `μ`-a.e. for each `k`
  separately, `g = ĝ ∘ c` `μ`-a.e., where `ĝ y = ∫ g (skelSect y k) dk` (the product of `h` on
  `G^{Ec}`; only right invariance of `h` is used) is measurable. The proof is Tonelli over `(k, U)`
  (`Measure.ae_ae_comm`), the substitution `k ↦ k U(b ·)` (right invariance) and the factorisation
  above.
* Lemma IV, general (`wilsonP_skel_mem_range`, `wilsonP_skel_eq_Pi`, `condExp_skel_ae_eq_Pi`,
  `wilsonP_skel_eq_zero_iff`): under the two mid-site conditions, for every real `κ` and every
  `u ∈ H`, `E_μ[u | σ(Sk)] = J y` for some `y`, hence `E_μ[u | σ(Sk)] = Π u` (in `H`, and a.e. for
  Mathlib's conditional expectation), and `E_μ[u | σ(Sk)] = 0 ↔ Π u = 0`. The steps are Part III's
  `condL2_mem_cgL2` (the skeleton σ-algebra is gauge stable), `gauge_average`, Part XV's Doob–Dynkin
  step `exists_coarseJ_eq`, Part X's `wilsonP_fixes_Pi` and `proj_comp_eq_of_le`.
* SU(2) on `(ℤ/2Mℤ)⁴`, straight blocking, every `M ≥ 1` (`straight_midSite_injective`,
  `straight_midSite_ne_emb`, `su2_skel_eq_Pi`): the mid-sites `2y + e_μ` are distinct and odd in
  direction `μ`, so Lemma IV holds for every real `β`: `su2P M β Skᶜ = Π` on `H`.
* `β = 0`, side-2 cubes `cube2 M x` at every base point, weights `1/16`, every `M ≥ 1`:
  - `su2_constrained_sweep_cover_zero`, `su2_constrained_sweep_zero`: a sweep of the constrained
    projections `P_{cube2 M x ∖ Sk}` along any list whose cubes cover every link equals `Π` on `H`
    (Part XV's `wilson_sweepProd_zero` and Lemma IV), so it vanishes on `ker Π`;
  - `su2_hcons_zero`: `hcons` of Part X with `λ = w_min = 1/16` (Part XII's `hcons_of_sweep_vanish`);
  - `parFamily`, `parFamily_disjoint`, `parFamily_cover`, `su2_hcons_zero_half`: the `8` families
    `{z : z ≡ p or z ≡ 1 + p (mod 2)}`, `p = (0, j)` with `j ∈ (ℤ/2ℤ)³`, are pairwise disjoint and
    each covers every link,
    so Part XII's `hcons_of_sweeps` with `θ = 0` gives `hcons` with `λ = 8 · (1/16) = 1/2`;
  - `su2_gap_constrained_zero` (`α < 1/16`) and `su2_gap_constrained_zero_half` (`α < 1/2`): Part X's
    `su2_gap_of_constrained` with `hcons` from above, `hCoarseGap` from Part XV's
    `su2_coarse_gap_zero` (`ϖ_c = 1/16`) and `hResidual` from Part XV's `su2_hResidual_zero`
    (`X = 0`, `β' = M⁻⁴`): `D ≥ min(α, M⁻⁴/16) I`. The constrained route of Part X is closed at
    `β = 0` with no hypothesis left. The conclusion of `su2_gap_constrained_zero` is the
    statement of Part XV's `su2_gap_closed_zero`, now reached through `hcons` instead of the direct
    `hFibre`. Since `min(α, M⁻⁴/16) ≤ M⁻⁴/16`, the larger `λ = 1/2` does not improve the bound: it
    is decided by the coarse factor `β' ϖ_c = M⁻⁴/16`.
  - `su2_fine_gap_zero_half`: the elementary bound `D ≥ (1/2) I` on `H` at `β = 0` from the parity
    families and Part XII's `hcons_of_sweeps` for the unconstrained cube projections (no Lemma IV).

## (c) What remains open

At `β ≠ 0` Lemma IV is proved here, but `hcons` is not: it needs a contraction of the constrained
sweeps on `ker Π` (Part XII's `hsweep`), which is not proved for the interacting measure, and
`hResidual` and `hCoarseGap` at `β ≠ 0` are not addressed here. The sharp
`β = 0` constant `λ = 3/4` of the research notes (ANOVA decomposition) is not formalised; `1/2` is.
The comparison constant `β' = M⁻⁴` of `hResidual` depends on the volume, so the gap bounds above are
not uniform in `M`; they are implied by Part XV's direct `su2_fine_gap_zero` (`D ≥ (1/16) I`) and,
for `M ≥ 2`, strictly weaker. Nothing
here concerns uniformity in the spacing, infinite volume or a continuum limit.

## (d) Axioms and checks

Every headline depends only on `propext`, `Classical.choice` and `Quot.sound` (the module axiom
audit covers every headline); the part contains no `sorry`, `admit`, `axiom` declarations,
`native_decide`, `implemented_by` or `set_option`.

## (e) Scope

This part is not a proof of a mass gap. Lemma IV is an exact identity of conditional expectations
in finite volume, for every coupling; the bounds on generators are finite-volume statements at the
single coupling `β = 0`, where the Wilson measure is a product measure.
-/

