/-! ### Assembly: the mixed-block bound, and Part X's bound with every input proved -/

section AbstractMixed

open scoped InnerProductSpace
open SchurSplit YangMills.StrongCoupling.CubeSplit

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] {ι κ : Type*} [Fintype ι]
  [Fintype κ]

/-- A cube generator of orthogonal projections is continuous: `‖D z‖ ≤ (∑ₓ 2|wₓ|) ‖z‖`. -/
theorem continuous_cubeGen_orth (w : ι → ℝ) (P : ι → OrthProj E) :
    Continuous (cubeGen w (fun x => (P x).P)) :=
  AddMonoidHomClass.continuous_of_bound _ (∑ x, |w x| * 2) fun z => by
    rw [cubeGen_apply, Finset.sum_mul]
    refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun x _ => ?_)
    rw [norm_smul, Real.norm_eq_abs, mul_assoc]
    refine mul_le_mul_of_nonneg_left ?_ (abs_nonneg _)
    have h1 := SweepContraction.norm_P_le (P x) z
    have h2 := norm_sub_le z ((P x).P z)
    linarith

/-- `w ↦ ‖g w − Π g w‖²` is continuous when `g` is (`‖x − Π x‖² = ‖x‖² − ‖Π x‖²`). -/
theorem continuous_norm_sub_P_sq {X : Type*} [TopologicalSpace X] (pj : OrthProj E) {g : X → E}
    (hg : Continuous g) : Continuous fun y => ‖g y - pj.P (g y)‖ ^ 2 := by
  have h : (fun y => ‖g y - pj.P (g y)‖ ^ 2) = fun y => ‖g y‖ ^ 2 - ‖pj.P (g y)‖ ^ 2 :=
    funext fun y => by have := pj.norm_sq_split (g y); linarith
  rw [h]
  exact (hg.norm.pow 2).sub (((CoarseComparison.continuous_orthProj pj).comp hg).norm.pow 2)

/-- If `Q` fixes `u` and `ran Π`, then `f − Q f = ∑ₓ wₓ (Q Pₓ u − Pₓ u)` for `f = (I − Π) D u`. -/
theorem sub_proj_mixed (w : ι → ℝ) (P : ι → OrthProj E) (pj Q : OrthProj E) (u : E)
    (hu : Q.P u = u) (hQ : ∀ z, Q.P (pj.P z) = pj.P z) :
    (cubeGen w (fun x => (P x).P) u - pj.P (cubeGen w (fun x => (P x).P) u)) -
      Q.P (cubeGen w (fun x => (P x).P) u - pj.P (cubeGen w (fun x => (P x).P) u)) =
      ∑ x, w x • (Q.P ((P x).P u) - (P x).P u) := by
  rw [map_sub, hQ, sub_sub_sub_cancel_right, cubeGen_apply, map_sum, ← Finset.sum_sub_distrib]
  refine Finset.sum_congr rfl fun x _ => ?_
  rw [map_smul, map_sub, hu, ← smul_sub]
  congr 1
  abel

/-- **The mixed-block estimate, abstract form.** Let `D = ∑ₓ wₓ (I − Pₓ)` (orthogonal projections
`Pₓ`, `wₓ ≥ 0`), `Π` an orthogonal projection and `Q_e` orthogonal projections that fix `ran Π`,
with a Poincaré inequality `c ‖f‖² ≤ ∑ₑ ‖f − Q_e f‖²` on `ker Π` (`c > 0`). If `u` is fixed by every
`Q_e` and `‖Pₓ u − Q_e Pₓ u‖ ≤ a_{ex} ‖u − Pₓ u‖` with `a ≥ 0`, `0 ≤ ∑ₓ wₓ a_{ex} ≤ A₁` and
`∑ₑ a_{ex} ≤ A₂`, then `‖(I − Π) D u‖² ≤ (A₁ A₂ / c) ⟪u, D u⟫` (Schur test). -/
theorem mixed_sq_le_abstract (w : ι → ℝ) (hw : ∀ x, 0 ≤ w x) (P : ι → OrthProj E)
    (pj : OrthProj E) (Q : κ → OrthProj E) (a : κ → ι → ℝ) (ha : ∀ e x, 0 ≤ a e x)
    {c A1 A2 : ℝ} (hc : 0 < c) (hA1 : 0 ≤ A1) (h1 : ∀ e, ∑ x, w x * a e x ≤ A1) (h2 : ∀ x, ∑ e, a e x ≤ A2)
    (hpoinc : ∀ f, pj.P f = 0 → c * ‖f‖ ^ 2 ≤ ∑ e, ‖f - (Q e).P f‖ ^ 2)
    (hQ : ∀ e z, (Q e).P (pj.P z) = pj.P z) (u : E) (hu : ∀ e, (Q e).P u = u)
    (hdef : ∀ x e, ‖(P x).P u - (Q e).P ((P x).P u)‖ ≤ a e x * ‖u - (P x).P u‖) :
    ‖cubeGen w (fun x => (P x).P) u - pj.P (cubeGen w (fun x => (P x).P) u)‖ ^ 2 ≤
      A1 * A2 / c * ⟪u, cubeGen w (fun x => (P x).P) u⟫_ℝ := by
  have hlink : ∀ e, ‖(cubeGen w (fun x => (P x).P) u - pj.P (cubeGen w (fun x => (P x).P) u)) -
      (Q e).P (cubeGen w (fun x => (P x).P) u - pj.P (cubeGen w (fun x => (P x).P) u))‖ ^ 2 ≤
      (∑ x, w x * a e x * ‖u - (P x).P u‖) ^ 2 := by
    intro e
    refine pow_le_pow_left₀ (norm_nonneg _) ?_ 2
    rw [sub_proj_mixed w P pj (Q e) u (hu e) (hQ e)]
    refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun x _ => ?_)
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (hw x), norm_sub_rev, mul_assoc]
    exact mul_le_mul_of_nonneg_left (hdef x e) (hw x)
  have hS := schur_sq_le_of_nonneg w a (fun x => ‖u - (P x).P u‖) hw ha hA1 h1 h2
  have hPf : pj.P (cubeGen w (fun x => (P x).P) u - pj.P (cubeGen w (fun x => (P x).P) u)) = 0 := by
    rw [map_sub, pj.idem, sub_self]
  have hP := hpoinc _ hPf
  have hsum := Finset.sum_le_sum fun (e : κ) (_ : e ∈ Finset.univ) => hlink e
  rw [div_mul_eq_mul_div, le_div_iff₀ hc, FibreReduction.inner_cubeGen_eq w P u]
  nlinarith [hP, hsum, hS]

/-- `‖B v‖²` on `ran Π` from the same bound on the range of `J`, `Π = J J*`. -/
theorem blkB_sq_le_of_range {Y : Type*} [NormedAddCommGroup Y] [InnerProductSpace ℝ Y]
    [CompleteSpace Y] [CompleteSpace E] (J : Y →ₗᵢ[ℝ] E) (D : E →ₗ[ℝ] E) {ε : ℝ}
    (h : ∀ y, ‖D (J y) - (CondExpInputs.isoProj J).P (D (J y))‖ ^ 2 ≤ ε * ⟪J y, D (J y)⟫_ℝ)
    (v : (CondExpInputs.isoProj J).Hc) :
    ‖(CondExpInputs.isoProj J).blkB D v‖ ^ 2 ≤ ε * ⟪v, (CondExpInputs.isoProj J).blkC D v⟫_ℝ := by
  have hv : J (CondExpInputs.isoAdj J v) = v := by
    rw [← CondExpInputs.isoProj_apply]
    exact (CondExpInputs.isoProj J).P_of_mem_Hc v.2
  have hy := h (CondExpInputs.isoAdj J v)
  rw [hv] at hy
  rw [OrthProj.inner_blkC]
  exact hy

end AbstractMixed

section Assembly

open MeasureTheory
open scoped InnerProductSpace
open SchurSplit YangMills.StrongCoupling.CubeSplit YangMills.StrongCoupling.CondExpInputs
  YangMills.StrongCoupling.WilsonCube YangMills.StrongCoupling.WilsonSU2
  YangMills.StrongCoupling.FibreReduction YangMills.StrongCoupling.ContinuousVersions

variable (M : ℕ) [NeZero M] (β : ℝ)

omit [NeZero M] in
/-- A non-skeleton link is used by no coarse link of the straight blocking. -/
theorem skel_avoid_single {e : Link (2 * M)} (he : e ∉ skel (straightBlocking M)) :
    ∀ ē, (straightBlocking M).a ē ∉ ({e} : Set (Link (2 * M))) ∧
      (straightBlocking M).b ē ∉ ({e} : Set (Link (2 * M))) := fun ē =>
  ⟨fun h => he (Or.inl ⟨ē, Set.mem_singleton_iff.1 h⟩),
    fun h => he (Or.inr ⟨ē, Set.mem_singleton_iff.1 h⟩)⟩

/-- The sum over the non-skeleton links of a nonnegative function is at most the sum over all
links. -/
theorem sum_nsk_le (g : Link (2 * M) → ℝ) (hg : ∀ l, 0 ≤ g l) :
    ∑ e : SweepContraction.NSk M, g e.1 ≤ ∑ l, g l := by
  classical
  rw [← Finset.sum_subtype (Finset.univ.filter fun l => l ∉ skel (straightBlocking M))
    (fun l => by simp) g]
  exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _) fun l _ _ => hg l

/-- The column count of the Schur test (every `M ≥ 1`, side-2 cubes `cube2 M x`): `∑ₓ (1/16) τ kₑ(x) ≤ 12 τ`. -/
theorem col_bound {τ : ℝ} (hτ0 : 0 ≤ τ) (e : Link (2 * M)) :
    ∑ x : Site (2 * M), (1 / 16 : ℝ) * (τ * (kMeet (cube2 M x) e : ℝ)) ≤ 12 * τ := by
  have hc : (∑ x : Site (2 * M), (kMeet (cube2 M x) e : ℝ)) ≤ 192 := by
    exact_mod_cast kMeet_col M e
  rw [← Finset.mul_sum, ← Finset.mul_sum]
  nlinarith

/-- The row count of the Schur test (every `M ≥ 1`, side-2 cubes `cube2 M x`, straight blocking):
`∑_{e ∉ Sk} τ kₑ(x) ≤ 768 τ`. -/
theorem row_bound {τ : ℝ} (hτ0 : 0 ≤ τ) (x : Site (2 * M)) :
    ∑ e : SweepContraction.NSk M, τ * (kMeet (cube2 M x) e.1 : ℝ) ≤ 768 * τ := by
  have hr : (∑ l : Link (2 * M), (kMeet (cube2 M x) l : ℝ)) ≤ 768 := by
    exact_mod_cast kMeet_row M x
  have hs := sum_nsk_le M (fun l => (kMeet (cube2 M x) l : ℝ)) fun _ => Nat.cast_nonneg _
  rw [← Finset.mul_sum]
  nlinarith

/-- **The mixed-block estimate for one coarse observable with a continuous version** (SU(2) on `(ℤ/2Mℤ)⁴`,
`β = β_W`, every `M ≥ 1`, `|β| < 1/18`, straight blocking, fine side-2 cubes `cube2 M x`, weights `1/16`), stated with
the constant `τ = 4|β| e^{24|β|}` as a parameter: `‖(I − Π) D J y‖² ≤ ε_B ⟪J y, D J y⟫`,
`ε_B = (12τ)(768τ)/(1 − 18|β|) = epsB β`. -/
theorem mixed_sq_le_of_version (hβ : |β| < 1 / 18) (τ : ℝ) (hτ : τ = 4 * |β| * Real.exp (24 * |β|))
    (y : coarseY (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (straightBlocking M))
    {Y0 : (Link M → SU2) → ℝ} (hY0 : Continuous Y0)
    (hy : ((y : Lp ℝ 2 (coarseLaw (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (straightBlocking M))) :
      (Link M → SU2) → ℝ) =ᵐ[coarseLaw (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (straightBlocking M)] Y0) :
    ‖su2D M β (cube2 M) (fun _ => 1 / 16) (su2J M β y) -
        (su2Pi M β).P (su2D M β (cube2 M) (fun _ => 1 / 16) (su2J M β y))‖ ^ 2 ≤
      epsB β * ⟪su2J M β y, su2D M β (cube2 M) (fun _ => 1 / 16) (su2J M β y)⟫_ℝ := by
  have hτ0 : 0 ≤ τ := hτ ▸ by positivity
  have hε : 12 * τ * (768 * τ) / (1 - 18 * |β|) = epsB β := by rw [hτ, epsB]; ring
  refine (mixed_sq_le_abstract (fun _ : Site (2 * M) => (1 / 16 : ℝ)) (fun _ => by norm_num)
    (fun x => wilsonPj (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (cube2 M x)) (su2Pi M β)
    (fun e : SweepContraction.NSk M => SingleLinkInfluence.su2LinkPj M β e.1)
    (fun e x => τ * (kMeet (cube2 M x) e.1 : ℝ)) (fun _ _ => mul_nonneg hτ0 (Nat.cast_nonneg _))
    (by linarith) (by positivity) (fun e => col_bound M hτ0 e.1) (row_bound M hτ0)
    (fun f hf => su2_fibrePoincare_Pi M β f hf)
    (fun e z => wilsonP_fixes_Pi (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (straightBlocking M)
      (skel_avoid_single M e.2) z)
    (su2J M β y)
    (fun e => wilsonP_fixes_wilsonJ (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
      (straightBlocking M) (skel_avoid_single M e.2) y)
    (fun x e => (su2_local_defect M β x e.2 y hY0 hy).trans (mul_le_mul_of_nonneg_right
      (hτ ▸ exp_sub_one_le_kMeet β (kMeet_le_six (cube2 M x) e.1)) (norm_nonneg _)))).trans
    (le_of_eq (by rw [hε]; rfl))

/-- **The mixed-block bound on the range of `J`** (SU(2) on `(ℤ/2Mℤ)⁴`, `μ ∝ exp((β/2) ∑ₚ Re tr U_p) ∏ dU`,
`β = β_W`, every `M ≥ 1`, `|β| < 1/18`, straight blocking, fine side-2 cubes `cube2 M x`, weights `1/16`): for every
`y ∈ Y`, `‖(I − Π) D J y‖² ≤ ε_B ⟪J y, D J y⟫`. First for `y` with a continuous version
(`mixed_sq_le_of_version`), then for every `y` by density (Part XXXI). -/
theorem su2_mixed_block_J (hβ : |β| < 1 / 18)
    (y : coarseY (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (straightBlocking M)) :
    ‖su2D M β (cube2 M) (fun _ => 1 / 16) (su2J M β y) -
        (su2Pi M β).P (su2D M β (cube2 M) (fun _ => 1 / 16) (su2J M β y))‖ ^ 2 ≤
      epsB β * ⟪su2J M β y, su2D M β (cube2 M) (fun _ => 1 / 16) (su2J M β y)⟫_ℝ := by
  have hD := continuous_cubeGen_orth (fun _ : Site (2 * M) => (1 / 16 : ℝ))
    (fun x => wilsonPj (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (cube2 M x))
  have hDJ : Continuous fun y' : coarseY (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
      (straightBlocking M) => su2D M β (cube2 M) (fun _ => 1 / 16) (su2J M β y') :=
    hD.comp (su2J M β).continuous
  exact closure_minimal (s := ContVer (coarseLaw (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
      (straightBlocking M)) (coarseY (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (straightBlocking M)))
    (fun y' hy' => mixed_sq_le_of_version M β hβ _ rfl y' (Exists.choose_spec hy').1
      (Exists.choose_spec hy').2)
    (isClosed_le (continuous_norm_sub_P_sq (su2Pi M β) hDJ)
      (continuous_const.mul ((su2J M β).continuous.inner hDJ)))
    (dense_ContVer _ (Measure.pi fun _ : Site M => haarSU2) y)

/-- **The mixed-block bound** (SU(2) on `(ℤ/2Mℤ)⁴`, `μ ∝ exp((β/2) ∑ₚ Re tr U_p) ∏ dU`, `β = β_W`, every
`M ≥ 1`, `|β| < 1/18`, straight blocking, fine side-2 cubes `cube2 M x`, weights `1/16`): `‖B v‖² ≤ ε_B ⟪v, C v⟫` on
`H_c`, with `ε_B = epsB β = 9216 τ²/(1 − 18|β|)` and `τ = 4|β| e^{24|β|}`. This is the hypothesis `hB` of Part XXXV's
`su2_hResidual_of_mixed`. Finite volume; not a mass gap. -/
theorem su2_mixed_block (hβ : |β| < 1 / 18) (v : (su2Pi M β).Hc) :
    ‖(su2Pi M β).blkB (su2D M β (cube2 M) (fun _ => 1 / 16)) v‖ ^ 2 ≤
      epsB β * ⟪v, (su2Pi M β).blkC (su2D M β (cube2 M) (fun _ => 1 / 16)) v⟫_ℝ :=
  blkB_sq_le_of_range (su2J M β) (su2D M β (cube2 M) (fun _ => 1 / 16))
    (su2_mixed_block_J M β hβ) v

/-- **`hResidual` with no hypothesis at small coupling** (SU(2) on `(ℤ/2Mℤ)⁴`, `β = β_W`, every `M ≥ 1`,
`|β| ≤ 1/2000`, straight blocking, fine side-2 cubes `cube2 M x` and coarse side-2 cubes `sideTwoCube M z`, weights
`1/16`): the residual certificate of `CubeSplitInputs.gap_of_residual` holds with the trial operator `X = 0`,
`λ = (1/2)(1 − 228|β|)²`, `α = λ/2` and `β' = 1/2` (Part XXXV's `su2_hResidual_of_mixed` with `su2_mixed_block` and
`budget_mixed`). -/
theorem su2_hResidual_closed (hβ : |β| ≤ 1 / 2000) (v : (su2Pi M β).Hc) :
    (1 / 2 : ℝ) * (su2Pi M β).gC (su2Jt M β)
        (su2Dc M β (ProductEndpoint.sideTwoCube M) (fun _ => 1 / 16)) v +
      qForm (E := (su2Pi M β).Hf) (F := (su2Pi M β).Hc)
        ((su2Pi M β).blkA (su2D M β (cube2 M) (fun _ => 1 / 16)))
        ((su2Pi M β).blkB (su2D M β (cube2 M) (fun _ => 1 / 16)))
          (1 / 2 * ((1 / 2 : ℝ) * (1 - 228 * |β|) ^ 2))
          (0 : (su2Pi M β).Hc →ₗ[ℝ] (su2Pi M β).Hf) v +
      ‖resid (E := (su2Pi M β).Hf) (F := (su2Pi M β).Hc)
        ((su2Pi M β).blkA (su2D M β (cube2 M) (fun _ => 1 / 16)))
        ((su2Pi M β).blkB (su2D M β (cube2 M) (fun _ => 1 / 16)))
          (1 / 2 * ((1 / 2 : ℝ) * (1 - 228 * |β|) ^ 2))
          (0 : (su2Pi M β).Hc →ₗ[ℝ] (su2Pi M β).Hf) v‖ ^ 2 /
        ((1 / 2 : ℝ) * (1 - 228 * |β|) ^ 2 - 1 / 2 * ((1 / 2 : ℝ) * (1 - 228 * |β|) ^ 2)) ≤
      ⟪v, (su2Pi M β).blkC (su2D M β (cube2 M) (fun _ => 1 / 16)) v⟫_ℝ := by
  have hb0 := abs_nonneg β
  have hl : 0 < (1 / 2 : ℝ) * (1 - 228 * |β|) ^ 2 := by
    have : 0 < 1 - 228 * |β| := by linarith
    positivity
  exact CoarseComparison.su2_hResidual_of_mixed M β (by linarith) (by norm_num)
    (su2_mixed_block M β (by linarith)) (budget_mixed β hβ) v

/-- **Part X's bound with every input proved, at small coupling** (SU(2) on `(ℤ/2Mℤ)⁴`,
`μ ∝ exp((β/2) ∑ₚ Re tr U_p) ∏ dU`, `β = β_W`, every `M ≥ 1`, `|β| ≤ 1/2000`, straight blocking, fine side-2 cubes
`cube2 M x` and coarse side-2 cubes `sideTwoCube M z`, weights `1/16`): `D ≥ ((1 − 18|β|)/256) I`. This is Part XXXV's
`su2_gap_of_mixed_small_beta` (whose `hWilson`, `hFibre` and `hCoarseGap` are proved in Parts VI, XXXIV and XXXII)
with the mixed-block bound `su2_mixed_block`, `α = λ/2` and `β' = 1/2`. It closes the Schur-split route at small
nonzero coupling, uniformly in `M`; it is not a new lower bound (Part XXXII's `su2_gap` gives
`D ≥ ((1 − 18|β|)/64) I`). A finite-volume bound for the heat-bath (Gibbs-sampler) generator, not a transfer-matrix
(mass) gap. -/
theorem su2_gap_closed_small_beta (hβ : |β| ≤ 1 / 2000) :
    ((1 - 18 * |β|) / 256) • LinearMap.id ≤ su2D M β (cube2 M) (fun _ => 1 / 16) := by
  have hb0 := abs_nonneg β
  have h1 : (443 / 500 : ℝ) ≤ 1 - 228 * |β| := by linarith
  have h2 : (443 / 500 : ℝ) ^ 2 ≤ (1 - 228 * |β|) ^ 2 := pow_le_pow_left₀ (by norm_num) h1 2
  have hl : 0 < (1 / 2 : ℝ) * (1 - 228 * |β|) ^ 2 := by nlinarith
  have h := CoarseComparison.su2_gap_of_mixed_small_beta M β (by linarith)
    (α := 1 / 2 * ((1 / 2 : ℝ) * (1 - 228 * |β|) ^ 2)) (β' := 1 / 2) (by linarith) (by norm_num)
    (su2_mixed_block M β (by linarith)) (budget_mixed β hβ)
  have hmin : min (1 / 2 * ((1 / 2 : ℝ) * (1 - 228 * |β|) ^ 2)) (1 / 2 * ((1 - 18 * |β|) / 128)) =
      (1 - 18 * |β|) / 256 := by
    rw [min_eq_right (by nlinarith)]
    ring
  rw [hmin] at h
  exact h

end Assembly

