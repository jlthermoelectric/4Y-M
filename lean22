/-! ### The influence step at the level of block kernels, from a tilt total-variation bound -/

section KernelInfluence

open MeasureTheory

/-- **The tilt total-variation bound, as a named statement** (expectation form): for a probability
measure `μ`, a measurable `h` with values in `[m, m + L]` and a measurable `g` with values in
`[a, a + s]`, `|∫ g d(μ.tilted h) − ∫ g dμ| ≤ tanh(L/4) · s`. Known on paper (Cohen and Fausti,
arXiv:2309.02413, Cor. 5.2.1, preprint); it is proved in Part XXV of this file
(`tilt_integral_abs_le_window`; see `tiltTVBound_holds`). -/
def TiltTVBound : Prop :=
  ∀ {α : Type} [MeasurableSpace α] (μ : Measure α) [IsProbabilityMeasure μ] (h g : α → ℝ),
    Measurable h → Measurable g → ∀ m L a s : ℝ, (∀ x, m ≤ h x ∧ h x ≤ m + L) →
      (∀ x, a ≤ g x ∧ g x ≤ a + s) → |∫ x, g x ∂(μ.tilted h) - ∫ x, g x ∂μ| ≤ Real.tanh (L / 4) * s

theorem integrable_exp_of_abs_le {Ξ : Type} [MeasurableSpace Ξ] (ν0 : Measure Ξ)
    [IsProbabilityMeasure ν0] {h : Ξ → ℝ} (hh : Measurable h) {C : ℝ} (hC : ∀ ξ, |h ξ| ≤ C) :
    Integrable (fun ξ => Real.exp (h ξ)) ν0 :=
  (integrable_const (Real.exp C)).mono' hh.exp.aestronglyMeasurable
    (ae_of_all _ fun ξ => by
      rw [Real.norm_eq_abs, Real.abs_exp]
      exact Real.exp_le_exp.2 ((le_abs_self _).trans (hC ξ)))

/-- **The one-step influence inequality for block heat-bath kernels.** Let `ν = ν₀.tilted h` and
`ν' = ν₀.tilted h'` be two tilts of a probability measure `ν₀` (in the application: the conditional
laws of the block given two outside configurations that differ at one link `e`, `ν₀` the Haar
measure of the block) with `h − h'` taking values in `[m, m + L]`, and let `F, F'` be bounded
measurable with `|F − F'| ≤ a` and `F'` taking values in `[b, b + s]` (in the application: the
function at the two outside configurations, `a` = its oscillation in `Uₑ`, `s` = its oscillation
over the block). Then, given the tilt bound,
`|∫ F dν − ∫ F' dν'| ≤ a + tanh(L/4) · s`. With `L = 4 |β| kₑₓ` this is the influence step of
`SU2HeatBathOsc` with coefficient `tanh(|β| kₑₓ)`. -/
theorem kernel_infl (hTV : TiltTVBound) {Ξ : Type} [MeasurableSpace Ξ] (ν0 : Measure Ξ)
    [IsProbabilityMeasure ν0] {h h' F F' : Ξ → ℝ} (hh : Measurable h) (hh' : Measurable h')
    (hF : Measurable F) (hF' : Measurable F') {C m L a b s : ℝ} (hhC : ∀ ξ, |h ξ| ≤ C)
    (hh'C : ∀ ξ, |h' ξ| ≤ C) (hdiff : ∀ ξ, m ≤ h ξ - h' ξ ∧ h ξ - h' ξ ≤ m + L)
    (hFF : ∀ ξ, |F ξ - F' ξ| ≤ a) (hF'b : ∀ ξ, b ≤ F' ξ ∧ F' ξ ≤ b + s) :
    |∫ ξ, F ξ ∂(ν0.tilted h) - ∫ ξ, F' ξ ∂(ν0.tilted h')| ≤ a + Real.tanh (L / 4) * s := by
  have hi := integrable_exp_of_abs_le ν0 hh hhC
  have hi' := integrable_exp_of_abs_le ν0 hh' hh'C
  have : IsProbabilityMeasure (ν0.tilted h) := isProbabilityMeasure_tilted hi
  have : IsProbabilityMeasure (ν0.tilted h') := isProbabilityMeasure_tilted hi'
  have htt : (ν0.tilted h').tilted (h - h') = ν0.tilted h := by
    rw [tilted_tilted hi']
    congr 1
    funext ξ
    simp only [Pi.add_apply, Pi.sub_apply]
    ring
  have hT := hTV (ν0.tilted h') (h - h') F' (hh.sub hh') hF' m L b s hdiff hF'b
  rw [htt] at hT
  have hF'bd : ∀ ξ, ‖F' ξ‖ ≤ |b| + |s| := fun ξ => by
    rw [Real.norm_eq_abs, abs_le]
    obtain ⟨h1, h2⟩ := hF'b ξ
    constructor <;> cases abs_cases b <;> cases abs_cases s <;> linarith
  have hFF' : ∀ ξ, ‖F ξ - F' ξ‖ ≤ a := fun ξ => by rw [Real.norm_eq_abs]; exact hFF ξ
  have iF' : Integrable F' (ν0.tilted h) :=
    Integrable.of_bound hF'.aestronglyMeasurable _ (ae_of_all _ hF'bd)
  have hFb : ∀ ξ, ‖F ξ‖ ≤ a + (|b| + |s|) := fun ξ =>
    calc ‖F ξ‖ = ‖(F ξ - F' ξ) + F' ξ‖ := by ring_nf
      _ ≤ ‖F ξ - F' ξ‖ + ‖F' ξ‖ := norm_add_le _ _
      _ ≤ a + (|b| + |s|) := add_le_add (hFF' ξ) (hF'bd ξ)
  have iF : Integrable F (ν0.tilted h) :=
    Integrable.of_bound hF.aestronglyMeasurable _ (ae_of_all _ hFb)
  have h1 : |∫ ξ, F ξ ∂(ν0.tilted h) - ∫ ξ, F' ξ ∂(ν0.tilted h)| ≤ a := by
    rw [← integral_sub iF iF']
    have := norm_integral_le_of_norm_le_const (μ := ν0.tilted h) (ae_of_all _ hFF')
    rw [Real.norm_eq_abs, probReal_univ, mul_one] at this
    exact this
  calc |∫ ξ, F ξ ∂(ν0.tilted h) - ∫ ξ, F' ξ ∂(ν0.tilted h')|
      = |(∫ ξ, F ξ ∂(ν0.tilted h) - ∫ ξ, F' ξ ∂(ν0.tilted h)) +
          (∫ ξ, F' ξ ∂(ν0.tilted h) - ∫ ξ, F' ξ ∂(ν0.tilted h'))| := by congr 1; ring
    _ ≤ |∫ ξ, F ξ ∂(ν0.tilted h) - ∫ ξ, F' ξ ∂(ν0.tilted h)| +
          |∫ ξ, F' ξ ∂(ν0.tilted h) - ∫ ξ, F' ξ ∂(ν0.tilted h')| := abs_add_le _ _
    _ ≤ a + Real.tanh (L / 4) * s := add_le_add h1 hT

end KernelInfluence

end YangMills.StrongCoupling.HeatBathInfluence

