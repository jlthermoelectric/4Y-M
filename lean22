residual bounds of that theorem, `D ≥ (1/230) I`; no constant depends on `M`. This is an implication
between named hypotheses: none of them is proved here for `β ≠ 0`. -/
theorem su2_gap_small_beta_of_influence (M : ℕ) [NeZero M] (β : ℝ) (hβ : |β| ≤ 1 / 1000)
    (I : SweepContraction.SU2HeatBathInfluence M β (228 * |β|))
    (hfine : SingleLinkPoincare M β (1 - 72 * |β|))
    (Γ : (su2Pi M β).Hc → ℝ) (hΓ : ∀ v, 0 ≤ Γ v)
    (hB : ∀ v, ‖(su2Pi M β).blkB (su2D M β (cube2 M) (fun _ => 1 / 16)) v‖ ^ 2 ≤
      63 / 2 * (Real.exp (12 * |β|) - 1) ^ 2 * Real.exp (108 * |β|) / (1 - 72 * |β|) * Γ v)
    (hg : ∀ v, (su2Pi M β).gC (su2Jt M β) (su2Dc M β (sideTwoCube M) (fun _ => 1 / 16)) v ≤
      Real.exp (576 * |β|) / 2 * Γ v)
    (hC : ∀ v, (1 - ((Real.exp (36 * |β|) - 1) * Real.exp (18 * |β|)) ^ 2) * Γ v ≤
      ⟪v, (su2Pi M β).blkC (su2D M β (cube2 M) (fun _ => 1 / 16)) v⟫_ℝ) :
    (1 / 230 : ℝ) • LinearMap.id ≤ su2D M β (cube2 M) (fun _ => 1 / 16) := by
  have hb0 : 0 ≤ |β| := abs_nonneg β
  have h1 : (772 / 1000 : ℝ) ≤ 1 - 228 * |β| := by linarith
  have h2 : (772 / 1000 : ℝ) ^ 2 ≤ (1 - 228 * |β|) ^ 2 := pow_le_pow_left₀ (by norm_num) h1 2
  have hlam : (1 - 72 * |β|) / 56 ≤ (1 / 2 : ℝ) * (1 - 228 * |β|) ^ 2 := by nlinarith
  refine su2_gap_small_beta_of_estimates M β hβ hfine (fun u hu => ?_) Γ hΓ hB hg hC
  calc (1 - 72 * |β|) / 56 * ‖u‖ ^ 2 ≤ ((1 / 2 : ℝ) * (1 - 228 * |β|) ^ 2) * ‖u‖ ^ 2 :=
        mul_le_mul_of_nonneg_right hlam (sq_nonneg _)
    _ ≤ _ := SweepContraction.su2_hcons_small_beta I (by linarith) u hu

