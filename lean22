/-- On a probability space, `(∫ g)² ≤ ∫ g²` for `g ∈ L²` (the variance is nonnegative). -/
theorem defect_sq_integral_le {Ξ : Type*} [MeasurableSpace Ξ] (ν : Measure Ξ)
    [IsProbabilityMeasure ν] {g : Ξ → ℝ} (hg : MemLp g 2 ν) :
    (∫ ξ, g ξ ∂ν) ^ 2 ≤ ∫ ξ, g ξ ^ 2 ∂ν := by
  have h := ProbabilityTheory.variance_nonneg g ν
  rw [ProbabilityTheory.variance_eq_sub hg] at h
  have e : ∫ ξ, (g ^ 2) ξ ∂ν = ∫ ξ, g ξ ^ 2 ∂ν := rfl
  linarith

/-- **Tilted means in `L²` form.** Let `ν` be a probability measure, `ψ` a.e. strongly measurable
with values in `[m₀, m₀ + L]` everywhere and `F` bounded measurable. Then
`(∫ F d(ν tilted by ψ) − ∫ F dν)² ≤ (e^L − 1)² ∫ (F − ∫ F dν)² dν`. (The density
`ρ = e^ψ / ∫ e^ψ dν` lies in `[e^{-L}, e^L]`, so `|ρ − 1| ≤ e^L − 1`; the difference of the means is
`∫ (ρ − 1)(F − ∫ F dν) dν`.) -/
theorem defect_tilted_sq_le {Ξ : Type*} [MeasurableSpace Ξ] (ν : Measure Ξ)
    [IsProbabilityMeasure ν] {ψ F : Ξ → ℝ} (hψ : AEStronglyMeasurable ψ ν) {m0 L : ℝ}
    (hwin : ∀ ξ, m0 ≤ ψ ξ ∧ ψ ξ ≤ m0 + L) (hF : Measurable F) {C : ℝ}
    (hC : ∀ ξ, |F ξ| ≤ C) :
    (∫ ξ, F ξ ∂(ν.tilted ψ) - ∫ ξ, F ξ ∂ν) ^ 2 ≤
      (Real.exp L - 1) ^ 2 * ∫ ξ, (F ξ - ∫ ξ', F ξ' ∂ν) ^ 2 ∂ν := by
  rw [integral_tilted]
  have hE : Integrable (fun ξ => Real.exp (ψ ξ)) ν :=
    (integrable_const (Real.exp (m0 + L))).mono' (Real.continuous_exp.comp_aestronglyMeasurable hψ)
      (ae_of_all _ fun ξ => by
        rw [Real.norm_eq_abs, Real.abs_exp]
        exact Real.exp_le_exp.2 (hwin ξ).2)
  set Z := ∫ ξ, Real.exp (ψ ξ) ∂ν with hZ
  set c := ∫ ξ', F ξ' ∂ν with hc
  have hZlo : Real.exp m0 ≤ Z := by
    have h1 := integral_mono (integrable_const (Real.exp m0)) hE fun ξ =>
      Real.exp_le_exp.2 (hwin ξ).1
    rwa [integral_const, probReal_univ, one_smul] at h1
  have hZhi : Z ≤ Real.exp (m0 + L) := by
    have h1 := integral_mono hE (integrable_const (Real.exp (m0 + L))) fun ξ =>
      Real.exp_le_exp.2 (hwin ξ).2
    rwa [integral_const, probReal_univ, one_smul] at h1
  have hZpos : 0 < Z := (Real.exp_pos m0).trans_le hZlo
  have hρb : ∀ ξ, |Real.exp (ψ ξ) / Z - 1| ≤ Real.exp L - 1 := by
    intro ξ
    have h1 : Real.exp (ψ ξ) / Z ≤ Real.exp L := by
      rw [div_le_iff₀ hZpos]
      calc Real.exp (ψ ξ) ≤ Real.exp (m0 + L) := Real.exp_le_exp.2 (hwin ξ).2
        _ = Real.exp L * Real.exp m0 := by rw [Real.exp_add, mul_comm]
        _ ≤ Real.exp L * Z := mul_le_mul_of_nonneg_left hZlo (Real.exp_pos L).le
    have h2 : Real.exp (-L) ≤ Real.exp (ψ ξ) / Z := by
      rw [le_div_iff₀ hZpos]
      calc Real.exp (-L) * Z ≤ Real.exp (-L) * Real.exp (m0 + L) :=
            mul_le_mul_of_nonneg_left hZhi (Real.exp_pos _).le
        _ = Real.exp m0 := by rw [← Real.exp_add, add_comm m0 L, neg_add_cancel_left]
        _ ≤ Real.exp (ψ ξ) := Real.exp_le_exp.2 (hwin ξ).1
    have h3 := Real.add_one_le_exp L
    have h4 := Real.add_one_le_exp (-L)
    rw [abs_le]
    constructor <;> linarith
  have hFi : Integrable F ν := Integrable.of_bound hF.aestronglyMeasurable C
    (ae_of_all _ fun ξ => by rw [Real.norm_eq_abs]; exact hC ξ)
  have hρi : Integrable (fun ξ => Real.exp (ψ ξ) / Z) ν := hE.div_const Z
  have hρ1 : ∫ ξ, Real.exp (ψ ξ) / Z ∂ν = 1 := by rw [integral_div, div_self hZpos.ne']
  have hFc : ∀ ξ, |F ξ - c| ≤ C + |c| := fun ξ =>
    (abs_sub _ _).trans (add_le_add (hC ξ) le_rfl)
  have hgm : AEStronglyMeasurable (fun ξ => (Real.exp (ψ ξ) / Z - 1) * (F ξ - c)) ν :=
    (hρi.aestronglyMeasurable.sub aestronglyMeasurable_const).mul
      (hF.aestronglyMeasurable.sub aestronglyMeasurable_const)
  have hg2 : MemLp (fun ξ => (Real.exp (ψ ξ) / Z - 1) * (F ξ - c)) 2 ν :=
    MemLp.of_bound hgm (|Real.exp L - 1| * (C + |c|))
      (ae_of_all _ fun ξ => by
        rw [Real.norm_eq_abs, abs_mul]
        exact mul_le_mul ((hρb ξ).trans (le_abs_self _)) (hFc ξ) (abs_nonneg _) (abs_nonneg _))
  have hgi : Integrable (fun ξ => (Real.exp (ψ ξ) / Z - 1) * (F ξ - c)) ν :=
    hg2.integrable one_le_two
  have hlin : Integrable (fun ξ => c * (Real.exp (ψ ξ) / Z - 1)) ν :=
    (hρi.sub (integrable_const 1)).const_mul c
  have hmain : ∫ ξ, (Real.exp (ψ ξ) / Z) • F ξ ∂ν - c =
      ∫ ξ, (Real.exp (ψ ξ) / Z - 1) * (F ξ - c) ∂ν := by
    have e : ∀ ξ, (Real.exp (ψ ξ) / Z) • F ξ = (Real.exp (ψ ξ) / Z - 1) * (F ξ - c) +
        (F ξ + c * (Real.exp (ψ ξ) / Z - 1)) := fun ξ => by
      rw [smul_eq_mul]
      ring
    have hsum : Integrable (fun ξ => F ξ + c * (Real.exp (ψ ξ) / Z - 1)) ν := hFi.add hlin
    rw [integral_congr_ae (ae_of_all _ e), integral_add hgi hsum,
      integral_add hFi hlin, integral_const_mul, integral_sub hρi (integrable_const 1), hρ1,
      integral_const, probReal_univ, one_smul]
    ring
  have hFc2 : Integrable (fun ξ => (F ξ - c) ^ 2) ν :=
    (MemLp.of_bound (hF.aestronglyMeasurable.sub aestronglyMeasurable_const) (C + |c|)
      (ae_of_all _ fun ξ => by rw [Real.norm_eq_abs]; exact hFc ξ)).integrable_sq
  have hpt : ∀ ξ, ((Real.exp (ψ ξ) / Z - 1) * (F ξ - c)) ^ 2 ≤
      (Real.exp L - 1) ^ 2 * (F ξ - c) ^ 2 := fun ξ => by
    rw [mul_pow]
    exact mul_le_mul_of_nonneg_right
      (sq_le_sq' (abs_le.1 (hρb ξ)).1 (abs_le.1 (hρb ξ)).2) (sq_nonneg _)
  rw [hmain]
  calc (∫ ξ, (Real.exp (ψ ξ) / Z - 1) * (F ξ - c) ∂ν) ^ 2
      ≤ ∫ ξ, ((Real.exp (ψ ξ) / Z - 1) * (F ξ - c)) ^ 2 ∂ν := defect_sq_integral_le ν hg2
    _ ≤ ∫ ξ, (Real.exp L - 1) ^ 2 * (F ξ - c) ^ 2 ∂ν :=
        integral_mono hg2.integrable_sq (hFc2.const_mul _) hpt
    _ = (Real.exp L - 1) ^ 2 * ∫ ξ, (F ξ - c) ^ 2 ∂ν := integral_const_mul _ _

/-- **The window of the Wilson exponent for a single-link change and a block `V`** (SU(2) on
`(ℤ/nℤ)⁴`, every `n ≥ 1`, `κ = β/2`, `χ = Re tr`, every real `β = β_W`, any link set `V`). If the
configurations `F ξ` and `F' ξ` agree off the link `e`, and `F ξ = U`, `F' ξ = U'` off `V`, then
`ξ ↦ wilsonExp(F ξ) − wilsonExp(F' ξ)` takes values in `[m, m + 4 |β| kₑ(V)]` for some `m`, where
`kₑ(V) = kMeet V e` counts the plaquettes that contain `e` and meet `V`. (For `V = cube2 M x ∖ Sk`
and `e ∉ V` this is Part XXXIII's `wilsonExp_block_window`.) -/
theorem defect_window {n : ℕ} [NeZero n] (β : ℝ) (V : Set (Link n)) {e : Link n}
    {Ξ : Type*} (F F' : Ξ → Link n → SU2) (U U' : Link n → SU2)
    (hFF : ∀ ξ l, l ≠ e → F ξ l = F' ξ l) (hF : ∀ ξ l, l ∉ V → F ξ l = U l)
    (hF' : ∀ ξ l, l ∉ V → F' ξ l = U' l) :
    ∃ m : ℝ, ∀ ξ, m ≤ wilsonExp plaqOf reTr (β / 2) (F ξ) - wilsonExp plaqOf reTr (β / 2) (F' ξ) ∧
      wilsonExp plaqOf reTr (β / 2) (F ξ) - wilsonExp plaqOf reTr (β / 2) (F' ξ) ≤
        m + 4 * |β| * (kMeet V e : ℝ) := by
  classical
  set Pq : PlaqIdx n → Prop := fun q => e ∈ pLinks (plaqOf q) ∧ ∃ l ∈ pLinks (plaqOf q), l ∈ V
  have hk0 : (Finset.univ.filter Pq).card = kMeet V e := by
    unfold kMeet
    exact congrArg Finset.card (Finset.filter_congr fun q _ => Iff.rfl)
  have hk : ((Finset.univ.filter Pq).card : ℝ) = kMeet V e := by rw [hk0]
  obtain ⟨c, hc⟩ : ∃ c : PlaqIdx n → ℝ, c = fun q =>
      if e ∈ pLinks (plaqOf q) then reTr.toFun (hol (plaqOf q) U) - reTr.toFun (hol (plaqOf q) U')
      else 0 := ⟨_, rfl⟩
  obtain ⟨d, hd⟩ : ∃ d : Ξ → PlaqIdx n → ℝ, d = fun ξ q =>
      reTr.toFun (hol (plaqOf q) (F ξ)) - reTr.toFun (hol (plaqOf q) (F' ξ)) := ⟨_, rfl⟩
  have hd_off : ∀ ξ q, ¬ Pq q → d ξ q = c q := by
    intro ξ q hq
    by_cases he : e ∈ pLinks (plaqOf q)
    · have hnB : ∀ l ∈ pLinks (plaqOf q), l ∉ V := fun l hl hlB => hq ⟨he, l, hl, hlB⟩
      simp only [hd, hc, if_pos he]
      rw [hol_congr (plaqOf q) (fun l hl => hF ξ l (hnB l hl)),
        hol_congr (plaqOf q) (fun l hl => hF' ξ l (hnB l hl))]
    · simp only [hd, hc, if_neg he]
      rw [hol_congr (plaqOf q) (fun l hl => hFF ξ l (fun hle => he (hle ▸ hl))), sub_self]
  have hd_bd : ∀ ξ q, |d ξ q| ≤ 4 := by
    intro ξ q
    have h1 := reTr.abs_le (hol (plaqOf q) (F ξ))
    have h2 := reTr.abs_le (hol (plaqOf q) (F' ξ))
    have hb : reTr.bound = 2 := rfl
    rw [hb] at h1 h2
    rw [hd]
    exact (abs_sub _ _).trans (by linarith only [h1, h2])
  have hsplit : ∀ ξ, wilsonExp plaqOf reTr (β / 2) (F ξ) - wilsonExp plaqOf reTr (β / 2) (F' ξ) =
      β / 2 * (∑ q ∈ Finset.univ.filter Pq, d ξ q) +
        β / 2 * ∑ q ∈ Finset.univ.filter (fun q => ¬ Pq q), c q := by
    intro ξ
    have h1 : wilsonExp plaqOf reTr (β / 2) (F ξ) - wilsonExp plaqOf reTr (β / 2) (F' ξ) =
        β / 2 * ∑ q, d ξ q := by
      rw [wilsonExp, wilsonExp, ← mul_sub, ← Finset.sum_sub_distrib, hd]
    have h2 : ∑ q ∈ Finset.univ.filter (fun q => ¬ Pq q), d ξ q =
        ∑ q ∈ Finset.univ.filter (fun q => ¬ Pq q), c q :=
      Finset.sum_congr rfl fun q hq => hd_off ξ q (Finset.mem_filter.1 hq).2
    rw [h1, ← Finset.sum_filter_add_sum_filter_not Finset.univ Pq, h2, mul_add]
  refine ⟨β / 2 * ∑ q ∈ Finset.univ.filter (fun q => ¬ Pq q), c q -
    2 * |β| * kMeet V e, fun ξ => ?_⟩
  rw [hsplit ξ, ← hk]
  have hS : |∑ q ∈ Finset.univ.filter Pq, d ξ q| ≤ 4 * (Finset.univ.filter Pq).card := by
    calc |∑ q ∈ Finset.univ.filter Pq, d ξ q| ≤ ∑ q ∈ Finset.univ.filter Pq, |d ξ q| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ q ∈ Finset.univ.filter Pq, (4 : ℝ) := Finset.sum_le_sum fun q _ => hd_bd ξ q
      _ = 4 * (Finset.univ.filter Pq).card := by rw [Finset.sum_const, nsmul_eq_mul, mul_comm]
  have hT : |β / 2 * ∑ q ∈ Finset.univ.filter Pq, d ξ q| ≤
      2 * |β| * (Finset.univ.filter Pq).card := by
    rw [abs_mul, abs_div, abs_two]
    calc |β| / 2 * |∑ q ∈ Finset.univ.filter Pq, d ξ q| ≤
          |β| / 2 * (4 * (Finset.univ.filter Pq).card) :=
          mul_le_mul_of_nonneg_left hS (div_nonneg (abs_nonneg β) zero_le_two)
      _ = 2 * |β| * (Finset.univ.filter Pq).card := by ring
  obtain ⟨h1, h2⟩ := abs_le.1 hT
  exact ⟨by linarith only [h1], by linarith only [h2]⟩

/-- The blocking map of the straight blocking does not see a link outside the skeleton: if `A`
and `B` agree off a link `e ∉ Sk`, then `c(A) = c(B)` (every `M`). -/
theorem defect_blockMap_congr (M : ℕ) {e : Link (2 * M)}
    (he : e ∉ FibreReduction.skel (straightBlocking M)) {A B : Link (2 * M) → SU2}
    (hAB : ∀ l, l ≠ e → A l = B l) :
    blockMap (straightBlocking M) A = blockMap (straightBlocking M) B := by
  funext ē
  have ha : (straightBlocking M).a ē ≠ e := fun h => he (by rw [← h]; exact Or.inl ⟨ē, rfl⟩)
  have hb : (straightBlocking M).b ē ≠ e := fun h => he (by rw [← h]; exact Or.inr ⟨ē, rfl⟩)
  show A ((straightBlocking M).a ē) * A ((straightBlocking M).b ē) =
    B ((straightBlocking M).a ē) * B ((straightBlocking M).b ē)
  rw [hAB _ ha, hAB _ hb]

/-- **The block kernel under a single-link change, pointwise** (SU(2) on `(ℤ/2Mℤ)⁴`,
`μ ∝ exp((β/2) ∑ₚ Re tr U_p) ∏ dU`, every `M ≥ 1`, every real `β = β_W`, any link set `V`). Let
`φ` be continuous and insensitive to the link `e`, and let `U'` agree with `U` off `e`. Then, with
`m = kerAvgV V φ` and `L = 4 |β| kMeet V e`,
`(m(U') − m(U))² ≤ (e^L − 1)² · kerAvgV V ((φ − m)²) (U)`. -/
theorem defect_kerAvgV_sq_le (M : ℕ) [NeZero M] (β : ℝ) (V : Set (Link (2 * M)))
    (e : Link (2 * M)) {φ : (Link (2 * M) → SU2) → ℝ} (hφ : Continuous φ)
    (hφe : ∀ A B : Link (2 * M) → SU2, (∀ l, l ≠ e → A l = B l) → φ A = φ B)
    {U U' : Link (2 * M) → SU2} (hUU : ∀ l, l ≠ e → U' l = U l) :
    (kerAvgV (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 V φ U' -
        kerAvgV (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 V φ U) ^ 2 ≤
      (Real.exp (4 * |β| * (kMeet V e : ℝ)) - 1) ^ 2 *
        kerAvgV (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 V
          (fun U'' => (φ U'' - kerAvgV (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 V φ U'') ^ 2)
          U := by
  have hψm : Measurable fun W => wilsonExp (plaqOf (n := 2 * M)) reTr (β / 2) (blockUpd V W U) :=
    (measurable_wilsonExp _ _ _).comp (measurable_blockUpd_left V U)
  have hψ'm : Measurable fun W =>
      wilsonExp (plaqOf (n := 2 * M)) reTr (β / 2) (blockUpd V W U') :=
    (measurable_wilsonExp _ _ _).comp (measurable_blockUpd_left V U')
  have hE : Integrable (fun W => Real.exp (wilsonExp (plaqOf (n := 2 * M)) reTr (β / 2)
      (blockUpd V W U))) (Measure.pi fun _ : Link (2 * M) => haarSU2) :=
    integrable_exp_of_bound _ hψm (fun W => abs_wilsonExp_le _ _ _ (blockUpd V W U))
  have : NeZero (Measure.pi fun _ : Link (2 * M) => haarSU2) := IsProbabilityMeasure.neZero _
  have : IsProbabilityMeasure ((Measure.pi fun _ : Link (2 * M) => haarSU2).tilted fun W =>
      wilsonExp (plaqOf (n := 2 * M)) reTr (β / 2) (blockUpd V W U)) :=
    isProbabilityMeasure_tilted hE
  have htt : ((Measure.pi fun _ : Link (2 * M) => haarSU2).tilted fun W =>
      wilsonExp (plaqOf (n := 2 * M)) reTr (β / 2) (blockUpd V W U)).tilted (fun W =>
        wilsonExp (plaqOf (n := 2 * M)) reTr (β / 2) (blockUpd V W U') -
          wilsonExp (plaqOf (n := 2 * M)) reTr (β / 2) (blockUpd V W U)) =
      (Measure.pi fun _ : Link (2 * M) => haarSU2).tilted fun W =>
        wilsonExp (plaqOf (n := 2 * M)) reTr (β / 2) (blockUpd V W U') := by
    rw [tilted_tilted hE]
    congr 1
    funext W
    simp only [Pi.add_apply]
    ring
  have hagree : ∀ W l, l ≠ e → blockUpd V W U' l = blockUpd V W U l := fun W l hl => by
    by_cases hlV : l ∈ V
    · rw [blockUpd_of_mem hlV, blockUpd_of_mem hlV]
    · rw [blockUpd_of_not_mem hlV, blockUpd_of_not_mem hlV, hUU l hl]
  obtain ⟨m0, hm0⟩ := defect_window β V (fun W => blockUpd V W U') (fun W => blockUpd V W U) U' U
    hagree (fun W l hl => blockUpd_of_not_mem hl W U') (fun W l hl => blockUpd_of_not_mem hl W U)
  obtain ⟨C, hC⟩ := exists_abs_le_of_continuous hφ
  have key := defect_tilted_sq_le ((Measure.pi fun _ : Link (2 * M) => haarSU2).tilted fun W =>
      wilsonExp (plaqOf (n := 2 * M)) reTr (β / 2) (blockUpd V W U))
    (ψ := fun W => wilsonExp (plaqOf (n := 2 * M)) reTr (β / 2) (blockUpd V W U') -
      wilsonExp (plaqOf (n := 2 * M)) reTr (β / 2) (blockUpd V W U))
    (F := fun W => φ (blockUpd V W U))
    (hψ'm.aestronglyMeasurable.sub hψm.aestronglyMeasurable) (m0 := m0)
    (L := 4 * |β| * (kMeet V e : ℝ)) hm0 (hφ.measurable.comp (measurable_blockUpd_left V U))
    (fun W => hC (blockUpd V W U))
  rw [htt] at key
  have e1 : kerAvgV (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 V φ U' =
      ∫ W, φ (blockUpd V W U) ∂((Measure.pi fun _ : Link (2 * M) => haarSU2).tilted fun W =>
        wilsonExp (plaqOf (n := 2 * M)) reTr (β / 2) (blockUpd V W U')) :=
    integral_congr_ae (ae_of_all _ fun W => hφe _ _ (hagree W))
  have e2 : kerAvgV (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 V
      (fun U'' => (φ U'' - kerAvgV (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 V φ U'') ^ 2) U =
      ∫ W, (φ (blockUpd V W U) - kerAvgV (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 V φ U) ^ 2
        ∂((Measure.pi fun _ : Link (2 * M) => haarSU2).tilted fun W =>
          wilsonExp (plaqOf (n := 2 * M)) reTr (β / 2) (blockUpd V W U)) :=
    integral_congr_ae (ae_of_all _ fun W => by
      simp only [kerAvgV_blockUpd])
  rw [e1, e2]
  exact key

/-- **Best approximation by an `m`-measurable competitor, in integral form.** Let `μ` be a
probability measure, `m ≤ m₀`, `u, w ∈ L²(μ)` with versions `f_u, f_w`, and `z₀ ∈ L²` strongly
`m`-measurable. If `(f_w − z₀)² ≤ c² K` pointwise (`c ≥ 0`) with `∫ K dμ = ∫ (f_u − f_w)² dμ`,
then `‖w − E[w | m]‖ ≤ c ‖u − w‖`. -/
theorem defect_condL2_le {Ω : Type*} {m m0 : MeasurableSpace Ω} (μ : Measure Ω)
    [IsProbabilityMeasure μ] (hm : m ≤ m0) (u w : Lp ℝ 2 μ) {fu fw z0 K : Ω → ℝ}
    (hu : (u : Ω → ℝ) =ᵐ[μ] fu) (hw : (w : Ω → ℝ) =ᵐ[μ] fw) (hz : MemLp z0 2 μ)
    (hzm : StronglyMeasurable[m] z0) {c : ℝ} (hc : 0 ≤ c)
    (hpt : ∀ ω, (fw ω - z0 ω) ^ 2 ≤ c ^ 2 * K ω)
    (hi : Integrable (fun ω => (fw ω - z0 ω) ^ 2) μ) (hK : Integrable K μ)
    (hKe : ∫ ω, K ω ∂μ = ∫ ω, (fu ω - fw ω) ^ 2 ∂μ) :
    ‖w - condL2 μ hm w‖ ≤ c * ‖u - w‖ := by
  have hfix : (condOrth μ hm).P (hz.toLp z0) = hz.toLp z0 :=
    FibreReduction.condL2_eq_self μ hm
      ((mem_lpMeas_iff_aestronglyMeasurable).2 ⟨z0, hzm, hz.coeFn_toLp⟩)
  have key : ‖w - condL2 μ hm w‖ ^ 2 ≤ ‖w - hz.toLp z0‖ ^ 2 :=
    SmallCoupling.norm_sub_P_le_of_fix (condOrth μ hm) w _ hfix
  have h1 : ‖w - hz.toLp z0‖ ^ 2 = ∫ ω, (fw ω - z0 ω) ^ 2 ∂μ :=
    norm_sq_eq_integral _ ((Lp.coeFn_sub _ _).trans (hw.sub hz.coeFn_toLp))
  have h2 : ‖u - w‖ ^ 2 = ∫ ω, (fu ω - fw ω) ^ 2 ∂μ :=
    norm_sq_eq_integral _ ((Lp.coeFn_sub _ _).trans (hu.sub hw))
  have hsq : ‖w - condL2 μ hm w‖ ^ 2 ≤ (c * ‖u - w‖) ^ 2 :=
    calc ‖w - condL2 μ hm w‖ ^ 2 ≤ ∫ ω, (fw ω - z0 ω) ^ 2 ∂μ := key.trans h1.le
      _ ≤ ∫ ω, c ^ 2 * K ω ∂μ := integral_mono hi (hK.const_mul _) hpt
      _ = (c * ‖u - w‖) ^ 2 := by rw [integral_const_mul, hKe, ← h2, mul_pow]
  have hn0 : 0 ≤ ‖w - condL2 μ hm w‖ := ENNReal.toReal_nonneg
  have hn1 : 0 ≤ ‖u - w‖ := ENNReal.toReal_nonneg
  exact (sq_le_sq₀ hn0 (mul_nonneg hc hn1)).1 hsq

/-- **The local defect bound for a block `V` and an observable insensitive to `e`** (SU(2) on
`(ℤ/2Mℤ)⁴`, `μ ∝ exp((β/2) ∑ₚ Re tr U_p) ∏ dU`, every `M ≥ 1`, every real `β = β_W`, any link set
`V`). If `u ∈ H` has a continuous version `φ` that does not depend on the variable of the link `e`,
then `‖P_V u − P_e P_V u‖ ≤ (e^{4|β| kₑ(V)} − 1) ‖u − P_V u‖`, `kₑ(V) = kMeet V e`. Finite volume. -/
theorem defect_local_of_version (M : ℕ) [NeZero M] (β : ℝ) (V : Set (Link (2 * M)))
    (e : Link (2 * M)) {φ : (Link (2 * M) → SU2) → ℝ} (hφ : Continuous φ)
    (hφe : ∀ A B : Link (2 * M) → SU2, (∀ l, l ≠ e → A l = B l) → φ A = φ B)
    (u : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2)
    (hu : ((u : Lp ℝ 2 (su2Wilson M β)) : (Link (2 * M) → SU2) → ℝ) =ᵐ[su2Wilson M β] φ) :
    ‖FibreReduction.su2P M β V u - FibreReduction.su2P M β {e} (FibreReduction.su2P M β V u)‖ ≤
      (Real.exp (4 * |β| * (kMeet V e : ℝ)) - 1) * ‖u - FibreReduction.su2P M β V u‖ := by
  have hCφ := (exists_abs_le_of_continuous hφ).choose_spec
  have hP := wilsonP_kerAvgV (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 V hφ.measurable hCφ u hu
  have hmc := su2_continuous_kerAvgV M β V hφ
  have hzc : Continuous fun U => kerAvgV (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 V φ
      (blockUpd ({e} : Set (Link (2 * M))) 1 U) :=
    hmc.comp ((continuous_blockUpd _).comp (continuous_id.prodMk continuous_const))
  have hzm := hmc.measurable.comp
    (measurable_blockUpd_extSigma (G := SU2) ({e} : Set (Link (2 * M))))
  have hCz := (exists_abs_le_of_continuous hzc).choose_spec
  have hz2 : MemLp (fun U => kerAvgV (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 V φ
      (blockUpd ({e} : Set (Link (2 * M))) 1 U)) 2 (su2Wilson M β) :=
    MemLp.of_bound hzc.aestronglyMeasurable _
      (ae_of_all _ fun U => by rw [Real.norm_eq_abs]; exact hCz U)
  have hg2c : Continuous fun U =>
      (φ U - kerAvgV (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 V φ U) ^ 2 :=
    (hφ.sub hmc).pow 2
  have hC2 := (exists_abs_le_of_continuous hg2c).choose_spec
  have hK := integral_kerAvgV (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 V hg2c.measurable hC2
  have hKc := su2_continuous_kerAvgV M β V hg2c
  have hpt : ∀ U, (kerAvgV (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 V φ U -
      kerAvgV (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 V φ
        (blockUpd ({e} : Set (Link (2 * M))) 1 U)) ^ 2 ≤
      (Real.exp (4 * |β| * (kMeet V e : ℝ)) - 1) ^ 2 *
        kerAvgV (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 V
          (fun U => (φ U - kerAvgV (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 V φ U) ^ 2) U :=
    fun U => by
      have hUU : ∀ l, l ≠ e → blockUpd ({e} : Set (Link (2 * M))) 1 U l = U l := fun l hl =>
        blockUpd_of_not_mem (fun h => hl (Set.mem_singleton_iff.1 h)) 1 U
      rw [← neg_sub, neg_sq]
      exact defect_kerAvgV_sq_le M β V e hφ hφe hUU
  have hc0 : 0 ≤ Real.exp (4 * |β| * (kMeet V e : ℝ)) - 1 :=
    sub_nonneg.2 (Real.one_le_exp (by positivity))
  have hmain := defect_condL2_le (su2Wilson M β) (extSigma_le (G := SU2) ({e} : Set (Link (2 * M))))
    _ _ hu hP hz2 hzm.stronglyMeasurable hc0 hpt
    (integrable_of_cont ((hmc.sub hzc).pow 2)) (integrable_of_cont hKc) hK
  exact hmain

/-- **The local defect bound** (SU(2) on `(ℤ/2Mℤ)⁴`, `μ ∝ exp((β/2) ∑ₚ Re tr U_p) ∏ dU`, every
`M ≥ 1`, every real `β = β_W`, straight blocking, the fine side-2 cube `V = cube2 M x` at any base
point). For a coarse observable `y ∈ Y` with a continuous version and a link `e` outside the
skeleton, the single-link heat bath `P_e` moves `P_V J y` by at most
`(e^{4|β| kₑ} − 1) ‖J y − P_V J y‖`, where `kₑ = kMeet V e` counts the plaquettes that contain
`e` and meet `V`. An exact finite-volume inequality; no novelty is claimed (a local comparison of
the densities of conditional laws). Not a mass gap. -/
theorem su2_local_defect (M : ℕ) [NeZero M] (β : ℝ) (x : Site (2 * M)) {e : Link (2 * M)}
    (he : e ∉ FibreReduction.skel (straightBlocking M))
    (y : coarseY (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (straightBlocking M))
    {Y0 : (Link M → SU2) → ℝ} (hY0 : Continuous Y0)
    (hy : ((y : Lp ℝ 2 (coarseLaw (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (straightBlocking M))) :
      (Link M → SU2) → ℝ) =ᵐ[coarseLaw (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (straightBlocking M)] Y0) :
    ‖FibreReduction.su2P M β (FibreReduction.cube2 M x) (FibreReduction.su2J M β y) -
        FibreReduction.su2P M β {e} (FibreReduction.su2P M β (FibreReduction.cube2 M x) (FibreReduction.su2J M β y))‖ ≤
      (Real.exp (4 * |β| * (kMeet (FibreReduction.cube2 M x) e : ℝ)) - 1) *
        ‖FibreReduction.su2J M β y - FibreReduction.su2P M β (FibreReduction.cube2 M x) (FibreReduction.su2J M β y)‖ :=
  defect_local_of_version M β (FibreReduction.cube2 M x) e
    (φ := fun U => Y0 (blockMap (straightBlocking M) U)) (hY0.comp (continuous_blockMap_of _))
    (fun _ _ hAB => congrArg Y0 (defect_blockMap_congr M he hAB))
    (FibreReduction.su2J M β y)
    (wilsonJ_ae_eq (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (straightBlocking M) y hy)

end LocalDefect

