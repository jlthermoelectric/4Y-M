section FibrePoincareNSk

open YangMills.StrongCoupling.WilsonCube YangMills.StrongCoupling.WilsonSU2
  YangMills.StrongCoupling.FibreReduction YangMills.StrongCoupling.SingleLinkInfluence
  YangMills.StrongCoupling.SingleLinkDobrushin

/-- `scan_poincare` (Part XXIX) on an abstract space when the domain is `C ∩ ker Q` for a linear map
`Q`, `C` closed under `0`, `+` and real scalars, and `δⱼ` subadditive and positively homogeneous
on `C`. -/
theorem fib_scan_ker {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    {J : Type*} [Fintype J] [DecidableEq J] [Nonempty J] {P : J → SchurSplit.OrthProj H} {θ : ℝ}
    (I : SweepContraction.InfluenceBound P (fun j => ({j} : Finset J)) θ) (hθ0 : 0 ≤ θ)
    (C : Set H) (Q : H →ₗ[ℝ] H) (hD : I.D = {f | f ∈ C ∧ Q f = 0}) (hC0 : (0 : H) ∈ C)
    (hCadd : ∀ f ∈ C, ∀ g ∈ C, f + g ∈ C) (hCsmul : ∀ (a : ℝ), ∀ f ∈ C, a • f ∈ C)
    (hδadd : ∀ j, ∀ f ∈ C, ∀ g ∈ C, I.δ j (f + g) ≤ I.δ j f + I.δ j g)
    (hδsmul : ∀ j (a : ℝ), 0 ≤ a → ∀ f ∈ C, I.δ j (a • f) ≤ a * I.δ j f)
    (u : H) (hu : u ∈ closure {f | f ∈ C ∧ Q f = 0}) :
    (1 - θ) * ‖u‖ ^ 2 ≤ ∑ j, ‖u - (P j).P u‖ ^ 2 := by
  refine scan_poincare I hθ0 ?_ ?_ ?_ ?_ ?_ u (hD ▸ hu) <;> rw [hD]
  · exact ⟨hC0, Q.map_zero⟩
  · exact fun f hf g hg => ⟨hCadd f hf.1 g hg.1, by rw [Q.map_add, hf.2, hg.2, add_zero]⟩
  · exact fun a f hf => ⟨hCsmul a f hf.1, by rw [Q.map_smul, hf.2, smul_zero]⟩
  · exact fun j f hf g hg => hδadd j f hf.1 g hg.1
  · exact fun j a ha f hf => hδsmul j a ha f hf.1

/-- **Dobrushin influence data for the non-skeleton single-link heat baths on
`ker E_μ[· | σ(Sk)]`** (SU(2) on `(ℤ/2Mℤ)⁴`, `μ ∝ exp((β/2) ∑ₚ Re tr U_p) ∏ dU`, every `M ≥ 1`,
every real `β = β_W`, straight blocking; finite volume): Part XXI's `InfluenceBound` for the
projections `P_{e} = E_μ[· | links ≠ e]`, `e ∉ Sk`, one block `{e}` per non-skeleton link, with
domain the elements of `H` with a continuous version and `E_μ[f | σ(Sk)] = 0`, `δₑ` the
oscillation in `Uₑ` (`linkOsc`), influence matrix `c j e = |β| k j e` (`kPair`: plaquettes
containing `j` and `e`), column sums `≤ 18 |β|` (`su2_col_count`, restricted to `e, j ∉ Sk`) and
`K = 1` (Part XXXIII's `norm_le_sum_nsk`). The fields `mem`, `self`, `infl` restrict Part XXXII's
`su2_singleLinkInfluence` to the non-skeleton links; `P_{e}`, `e ∉ Sk`, maps `ker E_μ[· | σ(Sk)]`
into itself since `{e} ⊆ Skᶜ` (`proj_comp_eq_of_le`, `wilsonP_fixes_wilsonP`). -/
noncomputable def su2_nskInfluence (M : ℕ) [NeZero M] (β : ℝ) :
    SweepContraction.InfluenceBound (fun e : SweepContraction.NSk M => su2LinkPj M β e.1)
      (fun e => ({e} : Finset (SweepContraction.NSk M))) (18 * |β|) where
  D := {f | f ∈ ContinuousVersions.contVer M β ∧ su2P M β (skel (straightBlocking M))ᶜ f = 0}
  δ e f := ContinuousVersions.linkOsc M β e.1 f
  c j e := |β| * (kPair (plaqOf (n := 2 * M)) j.1 e.1 : ℝ)
  K := 1
  mem e f hf := ⟨(su2_singleLinkInfluence M β).mem e.1 f hf.1,
    (proj_comp_eq_of_le
      (wilsonPj (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (skel (straightBlocking M))ᶜ)
      (su2LinkPj M β e.1)
      (fun z => wilsonP_fixes_wilsonP _ _ _ _ (Set.singleton_subset_iff.2 e.2) z) f).trans hf.2⟩
  nonneg j f _ := ContinuousVersions.linkOsc_nonneg M β j.1 f
  self e j hj f hf := by
    have hje : j = e := Finset.mem_singleton.1 hj
    subst hje
    exact (su2_singleLinkInfluence M β).self j.1 j.1 (Finset.mem_singleton_self _) f hf.1
  infl e j hj f hf := by
    have h := (su2_singleLinkInfluence M β).infl e.1 j.1
      (fun h => hj (Finset.mem_singleton.2 (Subtype.ext (Finset.mem_singleton.1 h)))) f hf.1
    simp only [Finset.sum_singleton] at h ⊢
    exact h
  c_nonneg _ _ := mul_nonneg (abs_nonneg _) (Nat.cast_nonneg _)
  col e := by
    rw [← Finset.mul_sum, mul_comm]
    refine mul_le_mul_of_nonneg_right ((le_of_eq (Finset.sum_map _
      (Function.Embedding.subtype _) fun j => (kPair (plaqOf (n := 2 * M)) j e.1 : ℝ)).symm).trans
      ((Finset.sum_le_sum_of_subset_of_nonneg ?_ fun _ _ _ => Nat.cast_nonneg _).trans
        (su2_col_count_real (2 * M) e.1))) (abs_nonneg β)
    intro x hx
    obtain ⟨a, ha, rfl⟩ := Finset.mem_map.1 hx
    exact Finset.mem_compl.2 fun h => Finset.mem_compl.1 ha
      (Finset.mem_singleton.2 (Subtype.ext (Finset.mem_singleton.1 h)))
  K_nonneg := zero_le_one
  poinc _ hf := BlockHeatBathOsc.norm_le_sum_nsk (BlockHeatBathOsc.blockKernelLaws_holds M β)
    (BlockHeatBathOsc.versionLaws_holds M β) hf.1 hf.2

/-- **The fibre Poincaré inequality for the non-skeleton single-link heat baths** (SU(2) on
`(ℤ/2Mℤ)⁴`, `μ ∝ exp((β/2) ∑ₚ Re tr U_p) ∏ dU`, every `M ≥ 1`, every real `β = β_W`, straight
blocking; no hypothesis; non-trivial for `|β| < 1/18`): for `f ∈ H` (centred gauge-invariant
`L²`) with `E_μ[f | σ(Sk)] = 0`, `(1 − 18|β|) ‖f‖² ≤ ∑_{e ∉ Sk} ‖f − P_{e} f‖²`, where
`P_{e} = E_μ[· | links ≠ e]`. A finite-volume lower bound, independent of `M`, for the
non-skeleton single-link heat-bath (Gibbs-sampler) generator `∑_{e ∉ Sk} (I − P_{e})` on
`ker E_μ[· | σ(Sk)]`; not a mass gap. Proof: Part XXIX's `scan_poincare` applied to
`su2_nskInfluence`, with density from Part XXXIII's `dense_ker`. This is Dobrushin's comparison
(Dobrushin, Theory Probab. Appl. 15 (1970) 458–486; random-scan spectral-gap form: L. Wu, Ann.
Probab. 34 (2006) 1960–1989, Thm 2.1); no novelty is claimed. -/
theorem su2_fibrePoincare (M : ℕ) [NeZero M] (β : ℝ)
    (f : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2)
    (hf : FibreReduction.su2P M β (FibreReduction.skel (straightBlocking M))ᶜ f = 0) :
    (1 - 18 * |β|) * ‖f‖ ^ 2 ≤
      ∑ e : SweepContraction.NSk M, ‖f - FibreReduction.su2P M β {e.1} f‖ ^ 2 := by
  have : Nonempty (SweepContraction.NSk M) := ⟨⟨_, FibreNonVacuity.q0_l2_not_mem_skel M⟩⟩
  exact fib_scan_ker (su2_nskInfluence M β) (mul_nonneg (by norm_num) (abs_nonneg β))
    (ContinuousVersions.contVer M β) (su2P M β (skel (straightBlocking M))ᶜ) rfl
    (ContinuousVersions.zero_mem_contVer M β) (ContinuousVersions.add_mem_contVer M β)
    (ContinuousVersions.smul_mem_contVer M β)
    (fun j => ContinuousVersions.linkOsc_add M β j.1)
    (fun j => ContinuousVersions.linkOsc_smul M β j.1)
    f (BlockHeatBathOsc.dense_ker (BlockHeatBathOsc.blockKernelLaws_holds M β)
      (BlockHeatBathOsc.versionLaws_holds M β) f hf)

/-- **The fibre Poincaré inequality on `ker Π`** (SU(2) on `(ℤ/2Mℤ)⁴`,
`μ ∝ exp((β/2) ∑ₚ Re tr U_p) ∏ dU`, every `M ≥ 1`, every real `β = β_W`, straight blocking; no
hypothesis; non-trivial for `|β| < 1/18`): for `f ∈ H` with `Π f = 0`,
`(1 − 18|β|) ‖f‖² ≤ ∑_{e ∉ Sk} ‖f − P_{e} f‖²`. `su2_fibrePoincare` through Lemma IV
(`su2_skel_eq_Pi`: `E_μ[· | σ(Sk)] = Π` on `H`). A finite-volume lower bound for the non-skeleton
single-link heat-bath generator on `ker E_μ[· | σ(Sk)] = ker Π`; not a mass gap. -/
theorem su2_fibrePoincare_Pi (M : ℕ) [NeZero M] (β : ℝ)
    (f : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2)
    (hf : (FibreReduction.su2Pi M β).P f = 0) :
    (1 - 18 * |β|) * ‖f‖ ^ 2 ≤
      ∑ e : SweepContraction.NSk M, ‖f - FibreReduction.su2P M β {e.1} f‖ ^ 2 :=
  su2_fibrePoincare M β f ((SkeletonCondExp.su2_skel_eq_Pi M β f).trans hf)

end FibrePoincareNSk

