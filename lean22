theorem su2_coarse_gap_zero_of_singleLink :
    (1 / 128 : ℝ) • LinearMap.id ≤ su2Dc M 0 (sideTwoCube M) (fun _ => 1 / 16) :=
  su2_coarse_gap_of_singleLink M 0 (singleLinkPoincare_zero M)

end CoarseGap

section Assembly

/-- **The budget at small coupling.** For `0 ≤ b ≤ 1/1000`, with `β' = 3/5`, `α = 1/230`,
`λ = (1 − 72b)/56`, `K_g = e^{576b}/2`, `ε_B = (63/2)(e^{12b} − 1)² e^{108b}/(1 − 72b)` and
`c = 1 − ((e^{36b} − 1) e^{18b})²`: `β' K_g + ε_B/(λ − α) ≤ c`. -/
theorem budget_small_beta {b : ℝ} (hb0 : 0 ≤ b) (hb : b ≤ 1 / 1000) :
    3 / 5 * (Real.exp (576 * b) / 2) +
        63 / 2 * (Real.exp (12 * b) - 1) ^ 2 * Real.exp (108 * b) / (1 - 72 * b) /
          ((1 - 72 * b) / 56 - 1 / 230) ≤
      1 - ((Real.exp (36 * b) - 1) * Real.exp (18 * b)) ^ 2 := by
  set u := Real.exp (6 * b) with hu
  have hu1 : 1 ≤ u := Real.one_le_exp (by positivity)
  have huU : u ≤ 500 / 497 := by
    have h := Real.exp_bound_div_one_sub_of_interval (x := 6 * b) (by positivity) (by linarith)
    have h2 : 1 / (1 - 6 * b) ≤ 500 / 497 := by
      rw [div_le_div_iff₀ (by linarith) (by norm_num)]
      linarith
    exact h.trans h2
  have hpow : ∀ n : ℕ, Real.exp ((n : ℝ) * (6 * b)) = u ^ n := fun n => Real.exp_nat_mul _ n
  have e12 : Real.exp (12 * b) = u ^ 2 := by rw [← hpow]; congr 1; push_cast; ring
  have e18 : Real.exp (18 * b) = u ^ 3 := by rw [← hpow]; congr 1; push_cast; ring
  have e36 : Real.exp (36 * b) = u ^ 6 := by rw [← hpow]; congr 1; push_cast; ring
  have e108 : Real.exp (108 * b) = u ^ 18 := by rw [← hpow]; congr 1; push_cast; ring
  have e576 : Real.exp (576 * b) = u ^ 96 := by rw [← hpow]; congr 1; push_cast; ring
  rw [e12, e18, e36, e108, e576]
  have hu0 : 0 ≤ u := by linarith
  have h96 : u ^ 96 ≤ (500 / 497 : ℝ) ^ 96 := pow_le_pow_left₀ hu0 huU 96
  have h18 : u ^ 18 ≤ (500 / 497 : ℝ) ^ 18 := pow_le_pow_left₀ hu0 huU 18
  have hu2 : 1 ≤ u ^ 2 := one_le_pow₀ hu1
  have hu6 : 1 ≤ u ^ 6 := one_le_pow₀ hu1
  have hsq : u ^ 2 - 1 ≤ (500 / 497 : ℝ) ^ 2 - 1 := by
    have := pow_le_pow_left₀ hu0 huU 2
    linarith
  have hsq2 : (u ^ 2 - 1) ^ 2 ≤ ((500 / 497 : ℝ) ^ 2 - 1) ^ 2 :=
    pow_le_pow_left₀ (by linarith) hsq 2
  have hA : 63 / 2 * (u ^ 2 - 1) ^ 2 * u ^ 18 ≤
      63 / 2 * ((500 / 497 : ℝ) ^ 2 - 1) ^ 2 * (500 / 497 : ℝ) ^ 18 :=
    mul_le_mul (mul_le_mul_of_nonneg_left hsq2 (by norm_num)) h18 (by positivity) (by positivity)
  have hd : (116 / 125 : ℝ) ≤ 1 - 72 * b := by linarith
  have hden : (116 / 125 : ℝ) * ((116 / 125) / 56 - 1 / 230) ≤
      (1 - 72 * b) * ((1 - 72 * b) / 56 - 1 / 230) := by nlinarith
  have hE : 63 / 2 * (u ^ 2 - 1) ^ 2 * u ^ 18 / (1 - 72 * b) / ((1 - 72 * b) / 56 - 1 / 230) ≤
      63 / 2 * ((500 / 497 : ℝ) ^ 2 - 1) ^ 2 * (500 / 497 : ℝ) ^ 18 /
        ((116 / 125) * ((116 / 125) / 56 - 1 / 230)) := by
    rw [div_div]
    exact div_le_div₀ (by norm_num) hA (by norm_num) hden
  have hθ : (u ^ 6 - 1) * u ^ 3 ≤ ((500 / 497 : ℝ) ^ 6 - 1) * (500 / 497 : ℝ) ^ 3 := by
    have h6 := pow_le_pow_left₀ hu0 huU 6
    exact mul_le_mul (by linarith) (pow_le_pow_left₀ hu0 huU 3) (by positivity) (by norm_num)
  have hθ2 : ((u ^ 6 - 1) * u ^ 3) ^ 2 ≤ (((500 / 497 : ℝ) ^ 6 - 1) * (500 / 497 : ℝ) ^ 3) ^ 2 :=
    pow_le_pow_left₀ (mul_nonneg (by linarith) (by positivity)) hθ 2
  have hnum : 3 / 5 * ((500 / 497 : ℝ) ^ 96 / 2) +
      63 / 2 * ((500 / 497 : ℝ) ^ 2 - 1) ^ 2 * (500 / 497 : ℝ) ^ 18 /
        ((116 / 125) * ((116 / 125) / 56 - 1 / 230)) ≤
      1 - (((500 / 497 : ℝ) ^ 6 - 1) * (500 / 497 : ℝ) ^ 3) ^ 2 := by norm_num
  linarith

variable (M : ℕ) [NeZero M] (β : ℝ)

/-- **The cube generator at small coupling, conditional on the single-link Poincaré inequality,
`hcons` and the local residual bounds** (SU(2) on `(ℤ/2Mℤ)⁴`, `d = 4`, every `M ≥ 1`,
`|β| ≤ 1/1000` in the normalisation of Part VI's `su2Wilson`, straight blocking, fine side-2 cubes
`cube2 M x` and coarse side-2 cubes `sideTwoCube M z` at every base point, all weights `1/16`).
