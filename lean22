section Independent

/-- For `Indep m_B m_A` and an `m_B`-measurable integrable `g`: `∫_t g = μ(t) ∫ g` for `t ∈ m_A`. -/
theorem setIntegral_eq_of_indep {Ω : Type*} {mA mB m0 : MeasurableSpace Ω} {μ : Measure Ω}
    [IsProbabilityMeasure μ] (hA : mA ≤ m0) (hB : mB ≤ m0) (hind : Indep mB mA μ)
    {g : Ω → ℝ} (hgi : Integrable g μ) (hg : StronglyMeasurable[mB] g) {t : Set Ω}
    (ht : MeasurableSet[mA] t) : ∫ x in t, g x ∂μ = μ.real t * ∫ x, g x ∂μ := by
  rw [← setIntegral_condExp hA hgi ht,
    setIntegral_congr_ae (hA t ht) ((condExp_indep_eq hB hA hg hind).mono fun x hx _ => hx),
    setIntegral_const, smul_eq_mul]

/-- **Conditioning on an independent σ-algebra changes nothing.** If `m_C ≤ m_B`, `m_A` is
independent of `m_B` and `g` is `m_B`-measurable and integrable, then
`E[g | m_C ⊔ m_A] = E[g | m_C]` a.e. -/
theorem condExp_sup_indep_eq {Ω : Type*} {mC mA mB m0 : MeasurableSpace Ω} {μ : Measure Ω}
    [IsProbabilityMeasure μ] (hC : mC ≤ mB) (hA : mA ≤ m0) (hB : mB ≤ m0)
    (hind : Indep mB mA μ) {g : Ω → ℝ} (hgi : Integrable g μ) (hg : StronglyMeasurable[mB] g) :
    μ[g | mC ⊔ mA] =ᵐ[μ] μ[g | mC] := by
  have hmC : mC ≤ m0 := hC.trans hB
  have hCA : mC ⊔ mA ≤ m0 := sup_le hmC hA
  let P : Set (Set Ω) :=
    {u | ∃ s t, MeasurableSet[mC] s ∧ MeasurableSet[mA] t ∧ u = s ∩ t}
  have hP : IsPiSystem P := by
    rintro _ ⟨s1, t1, hs1, ht1, rfl⟩ _ ⟨s2, t2, hs2, ht2, rfl⟩ _
    refine ⟨s1 ∩ s2, t1 ∩ t2, hs1.inter hs2, ht1.inter ht2, ?_⟩
    ext x
    simp only [Set.mem_inter_iff]
    tauto
  have hgen : mC ⊔ mA = MeasurableSpace.generateFrom P := by
    apply le_antisymm
    · refine sup_le (fun s hs => ?_) (fun t ht => ?_)
      · exact MeasurableSpace.measurableSet_generateFrom
          ⟨s, Set.univ, hs, MeasurableSet.univ, (Set.inter_univ s).symm⟩
      · exact MeasurableSpace.measurableSet_generateFrom
          ⟨Set.univ, t, MeasurableSet.univ, ht, (Set.univ_inter t).symm⟩
    · refine MeasurableSpace.generateFrom_le ?_
      rintro _ ⟨s, t, hs, ht, rfl⟩
      exact MeasurableSet.inter (le_sup_left (a := mC) (b := mA) s hs)
        (le_sup_right (a := mC) (b := mA) t ht)
  have key : ∀ s, MeasurableSet[mC ⊔ mA] s →
      ∫ x in s, (μ[g | mC]) x ∂μ = ∫ x in s, g x ∂μ := by
    intro s hs
    induction s, hs using MeasurableSpace.induction_on_inter hgen hP with
    | empty => simp
    | basic u hu =>
      obtain ⟨s, t, hs, ht, rfl⟩ := hu
      have h1 : ∫ x in s ∩ t, g x ∂μ = μ.real t * ∫ x in s, g x ∂μ := by
        rw [Set.inter_comm, ← setIntegral_indicator (hmC s hs),
          setIntegral_eq_of_indep hA hB hind (hgi.indicator (hmC s hs))
            (hg.indicator (hC s hs)) ht, integral_indicator (hmC s hs)]
      have h2 : ∫ x in s ∩ t, (μ[g | mC]) x ∂μ = μ.real t * ∫ x in s, (μ[g | mC]) x ∂μ := by
        rw [Set.inter_comm, ← setIntegral_indicator (hmC s hs),
          setIntegral_eq_of_indep hA hB hind (integrable_condExp.indicator (hmC s hs))
            ((stronglyMeasurable_condExp.mono hC).indicator (hC s hs)) ht,
          integral_indicator (hmC s hs)]
      rw [h1, h2, setIntegral_condExp hmC hgi hs]
    | compl t htm ht =>
      rw [setIntegral_compl (hCA t htm) integrable_condExp, setIntegral_compl (hCA t htm) hgi, ht,
        integral_condExp hmC]
    | iUnion f hf hfm ih =>
      rw [integral_iUnion (fun n => hCA _ (hfm n)) hf integrable_condExp.integrableOn,
        integral_iUnion (fun n => hCA _ (hfm n)) hf hgi.integrableOn]
      exact tsum_congr fun n => ih n
  exact (ae_eq_condExp_of_forall_setIntegral_eq hCA hgi
    (fun s _ _ => integrable_condExp.integrableOn) (fun s hs _ => key s hs)
    (StronglyMeasurable.mono (stronglyMeasurable_condExp (m := mC) (μ := μ) (f := g))
      (le_sup_left : mC ≤ mC ⊔ mA)).aestronglyMeasurable).symm

end Independent

section Product

variable {E G : Type*} [Fintype E] [MeasurableSpace G] (ν : E → Measure G)
  [∀ e, IsProbabilityMeasure (ν e)]

/-- The coordinate σ-algebras of a product of probability measures are independent. -/
theorem iIndep_coord :
    iIndep (fun e => MeasurableSpace.comap (fun U : E → G => U e) ‹MeasurableSpace G›)
      (Measure.pi ν) :=
  (iIndepFun_iff_iIndep _ _ _).1 (iIndepFun_pi (μ := ν) (X := fun _ => id)
    fun _ => aemeasurable_id)

omit [Fintype E] in
/-- `𝓔(V) = 𝓔(V ∪ W) ⊔ σ(links in Vᶜ ∖ Wᶜ)`. -/
theorem extSigma_split (V W : Set E) :
    extSigma (G := G) V = extSigma (V ∪ W) ⊔
      ⨆ e ∈ Vᶜ \ Wᶜ, MeasurableSpace.comap (fun U : E → G => U e) ‹MeasurableSpace G› := by
  have hs : Vᶜ = (V ∪ W)ᶜ ∪ (Vᶜ \ Wᶜ) := by
    ext e
    simp only [Set.mem_compl_iff, Set.mem_union, Set.mem_sdiff]
    tauto
  simp only [extSigma]
  rw [hs, iSup_union]
  simp only [← hs]

/-- For a product measure and `g` measurable for the exterior of `W`:
`E[g | ext V] = E[g | ext (V ∪ W)]` a.e. -/
theorem condExp_extSigma_of_meas (V W : Set E) {g : (E → G) → ℝ}
    (hgi : Integrable g (Measure.pi ν)) (hg : StronglyMeasurable[extSigma W] g) :
    (Measure.pi ν)[g | extSigma V] =ᵐ[Measure.pi ν] (Measure.pi ν)[g | extSigma (V ∪ W)] := by
  rw [extSigma_split V W]
  have hle : ∀ e, MeasurableSpace.comap (fun U : E → G => U e) ‹MeasurableSpace G› ≤
      MeasurableSpace.pi := fun e => (measurable_pi_apply e).comap_le
  have hind := indep_iSup_of_disjoint hle (iIndep_coord ν)
    (S := Wᶜ) (T := Vᶜ \ Wᶜ) Set.disjoint_sdiff_right
  exact condExp_sup_indep_eq (extSigma_anti Set.subset_union_right)
    (iSup₂_le fun e _ => hle e) (extSigma_le W) hind hgi hg

/-- **Exterior conditional expectations of a product measure compose:**
`E[E[f | ext W] | ext V] = E[f | ext (V ∪ W)]` a.e. -/
theorem condExp_extSigma_comp (V W : Set E) (f : (E → G) → ℝ) :
    (Measure.pi ν)[(Measure.pi ν)[f | extSigma W] | extSigma V] =ᵐ[Measure.pi ν]
      (Measure.pi ν)[f | extSigma (V ∪ W)] :=
  (condExp_extSigma_of_meas ν V W integrable_condExp stronglyMeasurable_condExp).trans
    (condExp_condExp_of_le (extSigma_anti Set.subset_union_right) (extSigma_le W))

/-- **The product-measure lemma in `L²`.** For any measure `μ` equal to a product of probability
measures, `E[· | ext V] ∘ E[· | ext W] = E[· | ext (V ∪ W)]` on `L²(μ)`. -/
theorem condL2_extSigma_comp (μ : Measure (E → G)) (hμ : μ = Measure.pi ν) (V W : Set E)
    (f : Lp ℝ 2 μ) :
    condL2 μ (extSigma_le V) (condL2 μ (extSigma_le W) f) = condL2 μ (extSigma_le (V ∪ W)) f := by
  subst hμ
  refine Lp.ext ?_
  refine (condL2_ae_eq_condExp _ (extSigma_le V) _).trans ?_
  refine (condExp_congr_ae (condL2_ae_eq_condExp _ (extSigma_le W) f)).trans ?_
  exact (condExp_extSigma_comp ν V W _).trans
    (condL2_ae_eq_condExp _ (extSigma_le (V ∪ W)) f).symm

/-- `condL2_extSigma_comp` as an identity of continuous linear maps. -/
theorem condL2_extSigma_comp_eq (μ : Measure (E → G)) (hμ : μ = Measure.pi ν) (V W : Set E) :
    (condL2 μ (extSigma_le V)).comp (condL2 μ (extSigma_le W)) = condL2 μ (extSigma_le (V ∪ W)) :=
  ContinuousLinearMap.ext fun f => condL2_extSigma_comp ν μ hμ V W f

/-- For a product measure the exterior conditional expectations commute. -/
theorem condL2_extSigma_commute (μ : Measure (E → G)) (hμ : μ = Measure.pi ν) (V W : Set E) :
    Commute (condL2 μ (extSigma_le V)) (condL2 μ (extSigma_le W)) := by
  show (condL2 μ (extSigma_le V)).comp (condL2 μ (extSigma_le W)) =
    (condL2 μ (extSigma_le W)).comp (condL2 μ (extSigma_le V))
  rw [condL2_extSigma_comp_eq ν μ hμ, condL2_extSigma_comp_eq ν μ hμ, Set.union_comm]

end Product


/-! ## Cube projections of a product measure -/

section Cube

open SchurSplit YangMills.StrongCoupling.CubeSplit YangMills.StrongCoupling.ConstrainedFibre

variable {S E G : Type*} [OrientedGraph S E] [Fintype E] [Group G] [MeasurableSpace G]
  [MeasurableMul₂ G] (h : Measure G) [IsProbabilityMeasure h]
  (μ : Measure (E → G)) [IsProbabilityMeasure μ] [SMulInvariantMeasure (Gauge S G) (E → G) μ]

/-- The cube projection `E_μ[· | links outside V]` on the centred gauge-invariant space, as an
orthogonal projection. -/
noncomputable def extProj (V : Set E) : OrthProj (cgL2 μ (Gauge S G)) where
  P := cubeProj μ (Gauge S G) (extSigma_le V) (extSigma_stable V)
  idem := cubeProj_idem _ _ (extSigma_le V) (extSigma_stable V)
  symm := cubeProj_isSymmetric _ _ (extSigma_le V) (extSigma_stable V)

/-- For a product measure, `P_V P_W = P_{V ∪ W}` on the centred gauge-invariant space. -/
theorem extProj_comp (hμ : μ = Measure.pi fun _ => h) (V W : Set E) (u : cgL2 μ (Gauge S G)) :
    (extProj μ V).P ((extProj μ W).P u) = (extProj μ (V ∪ W)).P u :=
  Subtype.ext (condL2_extSigma_comp (fun _ => h) μ hμ V W u)

omit [Fintype E] [Group G] [MeasurableMul₂ G] in
/-- The exterior σ-algebra of `∅` is the whole product σ-algebra. -/
theorem extSigma_empty : extSigma (G := G) (∅ : Set E) = MeasurableSpace.pi := by
  refine le_antisymm (extSigma_le ∅) ?_
  exact iSup_le fun e => le_iSup₂_of_le e (Set.notMem_empty e) le_rfl

omit [Fintype E] in
/-- `P_∅ = I`. -/
theorem extProj_empty (u : cgL2 μ (Gauge S G)) : (extProj μ (∅ : Set E)).P u = u := by
  refine Subtype.ext (condL2_eq_self μ (extSigma_le ∅) ?_)
  rw [extSigma_empty]
  exact (mem_lpMeas_iff_aestronglyMeasurable).2 (Lp.aestronglyMeasurable _)

omit [Fintype E] in
/-- `P_E = 0` on the centred space (for every invariant probability measure). -/
theorem extProj_univ (u : cgL2 μ (Gauge S G)) : (extProj μ (Set.univ : Set E)).P u = 0 := by
  have hbot : extSigma (G := G) (Set.univ : Set E) = ⊥ := by simp [extSigma]
  have hint : ∫ ω, (u : Lp ℝ 2 μ) ω ∂μ = 0 := ((mem_cgL2 μ (Gauge S G)).1 u.2).1
  refine Subtype.ext (Lp.ext ?_)
  show (condL2 μ (extSigma_le Set.univ) (u : Lp ℝ 2 μ) : (E → G) → ℝ) =ᵐ[μ] ((0 : Lp ℝ 2 μ) : (E → G) → ℝ)
  refine (condL2_ae_eq_condExp μ (extSigma_le Set.univ) (u : Lp ℝ 2 μ)).trans ?_
  rw [hbot, condExp_bot, hint]
  exact (Lp.coeFn_zero ℝ 2 μ).symm

/-- For a product measure the sweep along a list is the projection for the union of its link sets. -/
theorem sweepProd_extProj (hμ : μ = Measure.pi fun _ => h) {ι : Type*} (V : ι → Set E) :
    ∀ (l : List ι) (u : cgL2 μ (Gauge S G)),
      sweepProd (fun x => extProj μ (V x)) l u = (extProj μ {e | ∃ x ∈ l, e ∈ V x}).P u
  | [], u => by
    rw [sweepProd_nil]
    have : {e : E | ∃ x ∈ ([] : List ι), e ∈ V x} = ∅ := by simp
    rw [this, extProj_empty]
  | i :: l, u => by
    rw [sweepProd_cons, sweepProd_extProj hμ V l u, extProj_comp h μ hμ]
    have : V i ∪ {e | ∃ x ∈ l, e ∈ V x} = {e | ∃ x ∈ i :: l, e ∈ V x} := by
      ext e
      simp
    rw [this]

/-- **The heat-bath bound of a product measure.** If the link sets cover every link and
`0 ≤ w_min ≤ wₓ`, then `w_min ‖u‖² ≤ ⟪u, ∑ₓ wₓ (I − P_{Vₓ}) u⟫` on the centred gauge-invariant space. -/
theorem extProj_gap_of_cover (hμ : μ = Measure.pi fun _ => h) {ι : Type*} [Fintype ι] (V : ι → Set E)
    (w : ι → ℝ) {wmin : ℝ} (hwmin : 0 ≤ wmin) (hw : ∀ x, wmin ≤ w x)
    (hcov : ∀ e, ∃ x, e ∈ V x) (u : cgL2 μ (Gauge S G)) :
    wmin * ‖u‖ ^ 2 ≤ ⟪u, cubeGen w (fun x => (extProj μ (V x)).P) u⟫_ℝ := by
  classical
  have hset : {e | ∃ x ∈ (Finset.univ : Finset ι).toList, e ∈ V x} = Set.univ := by
    ext e
    obtain ⟨x, hx⟩ := hcov e
    simp only [Finset.mem_toList, Finset.mem_univ, true_and, Set.mem_ofPred_eq, Set.mem_univ,
      iff_true]
    exact ⟨x, hx⟩
  have h0 : sweepProd (fun x => extProj μ (V x)) (Finset.univ : Finset ι).toList u = 0 := by
    rw [sweepProd_extProj h μ hμ V, hset, extProj_univ]
  have h1 := norm_sub_sweepProd_sq_le (fun x => extProj μ (V x)) u (Finset.univ : Finset ι).toList
  rw [h0, sub_zero] at h1
  have h2 := wmin_mul_listSum_le w (fun x => ‖u - (extProj μ (V x)).P u‖ ^ 2) hwmin hw
    (fun _ => sq_nonneg _) (Finset.univ : Finset ι).toList (Finset.nodup_toList _)
  rw [inner_cubeGen_eq w (fun x => extProj μ (V x)) u]
  exact (mul_le_mul_of_nonneg_left h1 hwmin).trans h2

end Cube


/-! ## The Wilson model at `κ = 0` -/

section WilsonZero

open SchurSplit YangMills.StrongCoupling.CubeSplit YangMills.StrongCoupling.ConstrainedFibre

variable {S E G : Type*} [OrientedGraph S E] [Fintype E] [Group G] [MeasurableSpace G]
  [MeasurableMul₂ G] [MeasurableInv G] {Pl : Type*} [Fintype Pl] (plaq : Pl → Plaq S E)
  (χ : ClassFn G) {κ : ℝ} (hκ : κ = 0) (h : Measure G) [IsProbabilityMeasure h]
  [Measure.IsMulLeftInvariant h] [Measure.IsMulRightInvariant h]

include hκ in
omit [MeasurableMul₂ G] [MeasurableInv G] [Measure.IsMulLeftInvariant h] [Measure.IsMulRightInvariant h] in
/-- At `κ = 0` the Wilson measure is the product measure (Part XII's `wilsonMeasure_zero`). -/
theorem wilsonMeasure_eq_pi : wilsonMeasure plaq χ κ h = Measure.pi fun _ : E => h := by
  subst hκ
  exact wilsonMeasure_zero plaq χ h

/-- The Wilson cube projections of Part X are the projections `extProj` of the Wilson measure. -/
theorem wilsonPj_eq_extProj (V : Set E) :
    wilsonPj plaq χ κ h V = extProj (wilsonMeasure plaq χ κ h) V := rfl

include hκ in
/-- **At `κ = 0` the Wilson cube projections compose:** `P_V P_W = P_{V ∪ W}`. -/
theorem wilsonP_comp_zero (V W : Set E) (u : wilsonH plaq χ κ h) :
    wilsonP plaq χ κ h V (wilsonP plaq χ κ h W u) = wilsonP plaq χ κ h (V ∪ W) u :=
  extProj_comp h _ (wilsonMeasure_eq_pi plaq χ hκ h) V W u

include hκ in
/-- At `κ = 0` the Wilson cube projections commute. -/
theorem wilsonP_commute_zero (V W : Set E) :
    Commute (wilsonP plaq χ κ h V) (wilsonP plaq χ κ h W) := by
  refine LinearMap.ext fun u => ?_
  rw [Module.End.mul_apply, Module.End.mul_apply, wilsonP_comp_zero plaq χ hκ h,
    wilsonP_comp_zero plaq χ hκ h, Set.union_comm]

include hκ in
/-- At `κ = 0` the sweep of Part XII along a list is `P` of the union of the link sets. -/
theorem wilson_sweepProd_zero {ι : Type*} (V : ι → Set E) (l : List ι)
    (u : wilsonH plaq χ κ h) :
    sweepProd (fun x => wilsonPj plaq χ κ h (V x)) l u =
      wilsonP plaq χ κ h {e | ∃ x ∈ l, e ∈ V x} u :=
  sweepProd_extProj h _ (wilsonMeasure_eq_pi plaq χ hκ h) V l u

/-- Resampling every link gives `0` on the centred space (every `κ`). -/
theorem wilsonP_univ (u : wilsonH plaq χ κ h) : wilsonP plaq χ κ h Set.univ u = 0 :=
  extProj_univ _ u

include hκ in
/-- **The fine generator at `κ = 0`:** for link sets covering every link and `wₓ ≥ w_min ≥ 0`,
`w_min • I ≤ D = ∑ₓ wₓ (I − Pₓ)` on `H`. -/
theorem wilson_gap_zero {ι : Type*} [Fintype ι] (V : ι → Set E) (w : ι → ℝ) {wmin : ℝ}
    (hwmin : 0 ≤ wmin) (hw : ∀ x, wmin ≤ w x) (hcov : ∀ e, ∃ x, e ∈ V x) :
    wmin • LinearMap.id ≤ cubeGen w (fun x => wilsonP plaq χ κ h (V x)) :=
  SchurTower.smul_id_le_of_form
    (cubeGen_isSymmetric w fun x => cubeProj_isSymmetric _ _ (extSigma_le (V x))
      (extSigma_stable (V x)))
    (extProj_gap_of_cover h _ (wilsonMeasure_eq_pi plaq χ hκ h) V w hwmin hw hcov)

end WilsonZero

/-! ## The blocked law at `κ = 0` -/

section CoarseZero

variable {S E Sc Ec G : Type*} [OrientedGraph S E] [Fintype E] [OrientedGraph Sc Ec] [Fintype Ec]
  [Group G] [MeasurableSpace G] [MeasurableMul₂ G] [MeasurableInv G]
  (h : Measure G) [IsProbabilityMeasure h] [Measure.IsMulLeftInvariant h]

omit [Group G] [MeasurableMul₂ G] [MeasurableInv G] [Measure.IsMulLeftInvariant h] in
/-- Restriction to an injective family of links pushes the product of probability measures to the
product measure. -/
theorem map_comp_pi {J : Type*} [Fintype J] (ι : J → E) (hι : Function.Injective ι) :
    MeasurePreserving (fun (U : E → G) (j : J) => U (ι j)) (Measure.pi fun _ : E => h)
      (Measure.pi fun _ : J => h) := by
  refine ⟨measurable_pi_lambda _ fun j => measurable_pi_apply (ι j), ?_⟩
  have hind : iIndepFun (fun (j : J) (U : E → G) => U (ι j)) (Measure.pi fun _ : E => h) :=
    (iIndepFun_pi (μ := fun _ : E => h) (X := fun _ => id) fun _ => aemeasurable_id).precomp hι
  rw [(iIndepFun_iff_map_fun_eq_pi_map
    (fun j => (measurable_pi_apply (ι j)).aemeasurable)).1 hind]
  congr 1
  funext j
  exact (measurePreserving_eval (fun _ : E => h) (ι j)).map_eq

omit [Fintype E] [MeasurableInv G] in
/-- The pointwise product of two independent Haar-distributed fields is Haar distributed. -/
theorem measurePreserving_mul_pi :
    MeasurePreserving (fun z : (Ec → G) × (Ec → G) => z.1 * z.2)
      ((Measure.pi fun _ : Ec => h).prod (Measure.pi fun _ : Ec => h))
      (Measure.pi fun _ : Ec => h) := by
  have h1 := measurePreserving_prod_mul (Measure.pi fun _ : Ec => h) (Measure.pi fun _ : Ec => h)
  have h2 : MeasurePreserving (Prod.snd : (Ec → G) × (Ec → G) → (Ec → G))
      ((Measure.pi fun _ : Ec => h).prod (Measure.pi fun _ : Ec => h))
      (Measure.pi fun _ : Ec => h) := measurePreserving_snd
  exact h2.comp h1

omit [MeasurableInv G] in
/-- **The blocked law of the product measure.** If the two fine links `a ē`, `b ē` of the coarse
links are pairwise distinct (`Sum.elim a b` injective), then `c_* (∏ₑ h) = ∏_ē h`. -/
theorem map_blockMap_pi (blk : Blocking S E Sc Ec) (hinj : Function.Injective (Sum.elim blk.a blk.b)) :
    (Measure.pi fun _ : E => h).map (blockMap blk) = Measure.pi fun _ : Ec => h := by
  have hR := map_comp_pi h (Sum.elim blk.a blk.b) hinj
  have hS := measurePreserving_sumPiEquivProdPi (ι := Ec) (ι' := Ec) (X := fun _ => G)
    (fun _ => h)
  have hM := measurePreserving_mul_pi (Ec := Ec) h
  have hc : blockMap (G := G) blk =
      (fun z : (Ec → G) × (Ec → G) => z.1 * z.2) ∘ (MeasurableEquiv.sumPiEquivProdPi fun _ => G) ∘
        (fun (U : E → G) (j : Ec ⊕ Ec) => U (Sum.elim blk.a blk.b j)) := by
    funext U e
    rfl
  rw [hc]
  exact (hM.comp (hS.comp hR)).map_eq

end CoarseZero


section CoarseWilsonZero

open SchurSplit YangMills.StrongCoupling.CubeSplit

variable {S E Sc Ec G : Type*} [OrientedGraph S E] [Fintype E] [OrientedGraph Sc Ec] [Fintype Ec]
  [Group G] [MeasurableSpace G] [MeasurableMul₂ G] [MeasurableInv G] {Pl : Type*} [Fintype Pl]
  (plaq : Pl → Plaq S E) (χ : ClassFn G) {κ : ℝ} (hκ : κ = 0) (h : Measure G)
  [IsProbabilityMeasure h] [Measure.IsMulLeftInvariant h] [Measure.IsMulRightInvariant h]

include hκ in
omit [MeasurableInv G] [Measure.IsMulRightInvariant h] in
/-- **At `κ = 0` the blocked law is the product measure** on the coarse links, for any blocking
whose fine links `a ē`, `b ē` are pairwise distinct. -/
theorem coarseLaw_eq_pi (blk : Blocking S E Sc Ec)
    (hinj : Function.Injective (Sum.elim blk.a blk.b)) :
    coarseLaw plaq χ κ h blk = Measure.pi fun _ : Ec => h := by
  rw [coarseLaw, wilsonMeasure_eq_pi plaq χ hκ h]
  exact map_blockMap_pi h blk hinj

include hκ in
/-- **`hCoarseGap` at `κ = 0`.** For a blocking with pairwise distinct fine links and any family
of coarse link sets `V_z` covering every coarse link, with weights `w_z ≥ ϖ ≥ 0`:
`ϖ • I ≤ D_c = ∑_z w_z (I − Pᶜ_z)` on the coarse space `Y`. -/
theorem coarse_gap_zero (blk : Blocking S E Sc Ec)
    (hinj : Function.Injective (Sum.elim blk.a blk.b)) {ιc : Type*} [Fintype ιc]
    (Vc : ιc → Set Ec) (wc : ιc → ℝ) {ϖ : ℝ} (hϖ : 0 ≤ ϖ) (hw : ∀ z, ϖ ≤ wc z)
    (hcov : ∀ e, ∃ z, e ∈ Vc z) :
    ϖ • LinearMap.id ≤ cubeGen wc (fun z => coarseP plaq χ κ h blk (Vc z)) :=
  SchurTower.smul_id_le_of_form
    (cubeGen_isSymmetric wc fun z => cubeProj_isSymmetric _ _ (extSigma_le (Vc z))
      (extSigma_stable (Vc z)))
    (extProj_gap_of_cover h _ (coarseLaw_eq_pi plaq χ hκ h blk hinj) Vc wc hϖ hw hcov)

end CoarseWilsonZero

/-! ## SU(2) on `(ℤ/2Mℤ)⁴` at `β = 0` -/

section SU2Zero

open SchurSplit YangMills.StrongCoupling.CubeSplit YangMills.StrongCoupling.WilsonSU2
  YangMills.StrongCoupling.ConstrainedFibre

/-- The links of the side-2 cube `z + {0,1}⁴` of `(ℤ/nℤ)⁴`: the links `(z + a, μ)` with
`a ∈ {0,1}⁴` and `a_μ = 0`. For `n ≤ 2` the cube wraps around the torus and this is the set of
links of the unwrapped cube, as in Part VII (for `n = 1` it is the set of all four links). -/
def sideTwoCube (n : ℕ) (z : Site n) : Set (Link n) :=
  {e | ∃ a : Fin 4 → Fin 2, a e.2 = 0 ∧ e.1 = z + fun i => (((a i : ℕ) : ZMod n))}

theorem cube2_eq_sideTwoCube (M : ℕ) (z : Site (2 * M)) : cube2 M z = sideTwoCube (2 * M) z := rfl

theorem coarseCubeLinks_eq_sideTwoCube (z : Site 2) : coarseCubeLinks z = sideTwoCube 2 z := rfl

/-- The side-2 cube based at the source of a link contains that link. -/
theorem mem_sideTwoCube_self (n : ℕ) (x : Site n) (μ : Fin 4) : (x, μ) ∈ sideTwoCube n x :=
  ⟨fun _ => 0, rfl, by funext i; simp⟩

/-- The two fine links `(2y, μ)`, `(2y + e_μ, μ)` of the straight blocking are pairwise distinct
over all coarse links `(y, μ)`. -/
theorem straightBlocking_sumElim_injective (M : ℕ) [NeZero M] :
    Function.Injective (Sum.elim (straightBlocking M).a (straightBlocking M).b) := by
  refine Function.Injective.sumElim ?_ ?_ ?_
  · intro l l' hl
    simp only [straightBlocking, Prod.mk.injEq] at hl
    exact Prod.ext ((straightBlocking M).inj hl.1) hl.2
  · intro l l' hl
    simp only [straightBlocking, Prod.mk.injEq] at hl
    obtain ⟨h1, h2⟩ := hl
    rw [h2] at h1
    exact Prod.ext ((straightBlocking M).inj (add_right_cancel h1)) h2
  · intro l l' hl
    simp only [straightBlocking, Prod.mk.injEq] at hl
    obtain ⟨h1, h2⟩ := hl
    have h3 := congrFun h1 l'.2
    simp only [ιS, Pi.add_apply, unitV, Pi.single_eq_same] at h3
    have key : ∀ q : ZMod M, ZMod.castHom (dvd_mul_right 2 M) (ZMod 2) (dbl M q) = 0 := by
      intro q
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective q
      rw [dbl_intCast, map_intCast]
      push_cast
      rw [show (2 : ZMod 2) = 0 by decide, zero_mul]
    have h4 := congrArg (ZMod.castHom (dvd_mul_right 2 M) (ZMod 2)) h3
    rw [map_add, key, key, map_one, zero_add] at h4
    exact zero_ne_one h4

variable (M : ℕ) [NeZero M]

/-- At `β = 0` the SU(2) Wilson measure on `(ℤ/2Mℤ)⁴` is the product Haar measure. -/
theorem su2Wilson_zero : su2Wilson M 0 = Measure.pi fun _ : Link (2 * M) => haarSU2 :=
  wilsonMeasure_eq_pi plaqOf reTr (zero_div 2) haarSU2

/-- At `β = 0` the blocked law of straight blocking is the product Haar measure on `(ℤ/Mℤ)⁴`. -/
theorem su2_coarseLaw_zero :
    coarseLaw (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2 (straightBlocking M) =
      Measure.pi fun _ : Link M => haarSU2 :=
  coarseLaw_eq_pi plaqOf reTr (zero_div 2) haarSU2 (straightBlocking M)
    (straightBlocking_sumElim_injective M)

/-- At `β = 0` the SU(2) cube projections compose: `P_V P_W = P_{V ∪ W}`. -/
theorem su2P_comp_zero (V W : Set (Link (2 * M)))
    (u : wilsonH (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2) :
    FibreReduction.su2P M 0 V (FibreReduction.su2P M 0 W u) = FibreReduction.su2P M 0 (V ∪ W) u :=
  wilsonP_comp_zero plaqOf reTr (zero_div 2) haarSU2 V W u

/-- At `β = 0` the sweep over the side-2 cubes `cube2 M x` along any list that contains every base
point (repetitions allowed) is zero on the centred gauge-invariant space. -/
theorem su2_sweep_cube2_zero (l : List (Site (2 * M))) (hl : ∀ x, x ∈ l)
    (u : wilsonH (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2) :
    sweepProd (fun x => FibreReduction.wilsonPj (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2
      (FibreReduction.cube2 M x)) l u = 0 := by
  rw [wilson_sweepProd_zero plaqOf reTr (zero_div 2) haarSU2]
  have hset : {e | ∃ x ∈ l, e ∈ FibreReduction.cube2 M x} = Set.univ :=
    Set.eq_univ_of_forall fun e => ⟨e.1, hl e.1, ConstrainedFibre.mem_cube2_self M e.1 e.2⟩
  rw [hset]
  exact wilsonP_univ _ _ _ _

/-- **The fine generator at `β = 0`**: `D = ∑ₓ (1/16)(I − P_{cube2 M x}) ≥ (1/16) I` on `H`
(every `M ≥ 1`). -/
theorem su2_fine_gap_zero :
    (1 / 16 : ℝ) • LinearMap.id ≤ FibreReduction.su2D M 0 (FibreReduction.cube2 M) (fun _ => 1 / 16) :=
  wilson_gap_zero plaqOf reTr (zero_div 2) haarSU2 (FibreReduction.cube2 M) (fun _ => 1 / 16)
    (by norm_num) (fun _ => le_rfl) fun e => ⟨e.1, ConstrainedFibre.mem_cube2_self M e.1 e.2⟩

/-- **`hFibre` at `β = 0`** for `D = ∑ₓ (1/16)(I − P_{cube2 M x})` and `Π = J J*`, with
`λ = 1/16` (every `M ≥ 1`). -/
theorem su2_hFibre_zero (u : wilsonH (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2)
    (_hu : (FibreReduction.su2Pi M 0).P u = 0) :
    (1 / 16 : ℝ) * ‖u‖ ^ 2 ≤
      ⟪u, FibreReduction.su2D M 0 (FibreReduction.cube2 M) (fun _ => 1 / 16) u⟫_ℝ :=
  SchurTower.form_of_smul_id_le (su2_fine_gap_zero M) u

/-- **`hCoarseGap` at `β = 0`**: the coarse generator `D_c = ∑_z (1/16)(I − Pᶜ_z)` over the side-2
coarse cubes at every coarse base point satisfies `D_c ≥ (1/16) I` on `Y` (every `M ≥ 1`). -/
theorem su2_coarse_gap_zero :
    (1 / 16 : ℝ) • LinearMap.id ≤ FibreReduction.su2Dc M 0 (sideTwoCube M) (fun _ => 1 / 16) :=
  coarse_gap_zero plaqOf reTr (zero_div 2) haarSU2 (straightBlocking M)
    (straightBlocking_sumElim_injective M) (sideTwoCube M) (fun _ => 1 / 16) (by norm_num)
    (fun _ => le_rfl) fun e => ⟨e.1, mem_sideTwoCube_self M e.1 e.2⟩

end SU2Zero


/-! ## Shears of the product measure -/

section Shear

variable {E Ec G : Type*} (t p : Ec → E) (φ : G → G → G)

/-- The shear `U ↦ U'` with `U' (t ē) = φ (U (t ē)) (U (p ē))` and `U' e = U e` off the range of
`t`. -/
noncomputable def shear (U : E → G) : E → G := Function.extend t (fun ē => φ (U (t ē)) (U (p ē))) U

variable {t p φ}

/-- The shear on the links `t ē`. -/
theorem shear_apply_t (ht : Function.Injective t) (U : E → G) (ē : Ec) :
    shear t p φ U (t ē) = φ (U (t ē)) (U (p ē)) :=
  ht.extend_apply _ _ _

/-- The shear leaves the links outside the range of `t` unchanged. -/
theorem shear_apply_of_notMem (U : E → G) {e : E} (he : ∀ ē, t ē ≠ e) : shear t p φ U e = U e :=
  Function.extend_apply' _ _ _ fun ⟨ē, hē⟩ => he ē hē

/-- The shear leaves the partner links `p ē` unchanged. -/
theorem shear_apply_p (htp : ∀ x y, t x ≠ p y) (U : E → G) (ē : Ec) :
    shear t p φ U (p ē) = U (p ē) :=
  shear_apply_of_notMem U fun x => htp x ē

/-- The shear is measurable. -/
theorem measurable_shear [MeasurableSpace G] (ht : Function.Injective t) (hφ : Measurable fun z : G × G => φ z.1 z.2) :
    Measurable (shear t p φ) := by
  classical
  refine measurable_pi_lambda _ fun e => ?_
  by_cases he : ∃ ē, t ē = e
  · obtain ⟨ē, rfl⟩ := he
    have hfun : (fun U : E → G => shear t p φ U (t ē)) = fun U => φ (U (t ē)) (U (p ē)) :=
      funext fun U => shear_apply_t ht U ē
    rw [hfun]
    have h1 : Measurable fun U : E → G => U (t ē) := measurable_pi_apply (t ē)
    have h2 : Measurable fun U : E → G => U (p ē) := measurable_pi_apply (p ē)
    exact hφ.comp (h1.prodMk h2)
  · push Not at he
    have hfun : (fun U : E → G => shear t p φ U e) = fun U => U e :=
      funext fun U => shear_apply_of_notMem U he
    rw [hfun]
    exact measurable_pi_apply e

/-- The shear with an inverse map `φ'` undoes the shear with `φ`. -/
theorem shear_shear {φ' : G → G → G} (ht : Function.Injective t) (htp : ∀ x y, t x ≠ p y)
    (hinv : ∀ x y, φ' (φ x y) y = x) (U : E → G) : shear t p φ' (shear t p φ U) = U := by
  classical
  funext e
  by_cases he : ∃ ē, t ē = e
  · obtain ⟨ē, rfl⟩ := he
    rw [shear_apply_t ht, shear_apply_t ht, shear_apply_p htp, hinv]
  · push Not at he
    rw [shear_apply_of_notMem _ he, shear_apply_of_notMem _ he]

/-- **The shear preserves the product measure** when every `x ↦ φ x y` preserves `h`. -/
theorem measurePreserving_shear [MeasurableSpace G] [Fintype E] [Fintype Ec] (h : Measure G) [IsProbabilityMeasure h]
    (ht : Function.Injective t) (htp : ∀ x y, t x ≠ p y)
    (hφm : Measurable fun z : G × G => φ z.1 z.2) (hφ : ∀ y, MeasurePreserving (φ · y) h h) :
    MeasurePreserving (shear t p φ) (Measure.pi fun _ : E => h) (Measure.pi fun _ : E => h) := by
  classical
  let T : Finset E := Finset.univ.image t
  have hpre : ∀ i : T, ∃ ē, t ē = i := fun i => by
    obtain ⟨ē, -, hē⟩ := Finset.mem_image.1 i.2
    exact ⟨ē, hē⟩
  choose pre hpre using hpre
  have hpT : ∀ ē, p ē ∉ T := fun ē hm => by
    obtain ⟨x, -, hx⟩ := Finset.mem_image.1 hm
    exact htp x ē hx
  have hcomp : ∀ (x : E → G) (y : ∀ i : T, G),
      shear t p φ (Function.updateFinset x T y) =
        Function.updateFinset x T (fun i => φ (y i) (x (p (pre i)))) := by
    intro x y
    funext e
    by_cases he : e ∈ T
    · obtain ⟨ē, -, rfl⟩ := Finset.mem_image.1 he
      have hē : pre ⟨t ē, he⟩ = ē := ht (hpre ⟨t ē, he⟩)
      rw [shear_apply_t ht]
      simp only [Function.updateFinset_def, dif_pos he, dif_neg (hpT ē), hē]
    · have hne : ∀ ē, t ē ≠ e := fun ē hē => he (hē ▸ Finset.mem_image_of_mem t (Finset.mem_univ ē))
      rw [shear_apply_of_notMem _ hne]
      simp only [Function.updateFinset_def, dif_neg he]
  have key : ∀ f : (E → G) → ℝ≥0∞, Measurable f →
      ∫⁻ U, f (shear t p φ U) ∂(Measure.pi fun _ : E => h) =
        ∫⁻ U, f U ∂(Measure.pi fun _ : E => h) := by
    intro f hf
    refine lintegral_eq_of_lmarginal_eq (μ := fun _ : E => h) T (hf.comp (measurable_shear ht hφm)) hf ?_
    funext x
    simp only [lmarginal]
    simp_rw [hcomp x]
    have hΦ : MeasurePreserving (fun (y : ∀ i : T, G) (i : T) => φ (y i) (x (p (pre i))))
        (Measure.pi fun _ : T => h) (Measure.pi fun _ : T => h) :=
      measurePreserving_pi (fun _ : T => h) (fun _ : T => h) fun i => hφ _
    exact hΦ.lintegral_comp (f := fun y => f (Function.updateFinset x T y))
      (hf.comp measurable_updateFinset)
  refine ⟨measurable_shear ht hφm, Measure.ext fun s hs => ?_⟩
  rw [Measure.map_apply (measurable_shear ht hφm) hs]
  have h1 := key (s.indicator 1) (measurable_one.indicator hs)
  have h2 : (fun U => s.indicator (1 : (E → G) → ℝ≥0∞) (shear t p φ U)) =
      (shear t p φ ⁻¹' s).indicator 1 := by
    funext U
    simp [Set.indicator_apply]
  rw [h2, lintegral_indicator_one (measurable_shear ht hφm hs), lintegral_indicator_one hs] at h1
  exact h1

/-- If `p ē ∈ V` forces `t ē ∈ V`, the shear maps the exterior σ-algebra of `V` into itself. -/
theorem measurable_shear_extSigma [MeasurableSpace G] (ht : Function.Injective t)
    (hφm : Measurable fun z : G × G => φ z.1 z.2) {V : Set E} (hV : ∀ ē, p ē ∈ V → t ē ∈ V) :
    Measurable[extSigma (G := G) V, extSigma V] (shear t p φ) := by
  classical
  rw [measurable_iff_comap_le, extSigma]
  simp only [MeasurableSpace.comap_iSup, MeasurableSpace.comap_comp]
  refine iSup₂_le fun e he => ?_
  rw [← measurable_iff_comap_le]
  by_cases hr : ∃ ē, t ē = e
  · obtain ⟨ē, rfl⟩ := hr
    have hp : p ē ∉ V := fun hp => he (hV ē hp)
    have hfun : ((fun U : E → G => U (t ē)) ∘ shear t p φ) = fun U => φ (U (t ē)) (U (p ē)) :=
      funext fun U => shear_apply_t ht U ē
    rw [hfun]
    exact hφm.comp ((measurable_eval_extSigma he).prodMk (measurable_eval_extSigma hp))
  · push Not at hr
    have hfun : ((fun U : E → G => U e) ∘ shear t p φ) = fun U => U e :=
      funext fun U => shear_apply_of_notMem U hr
    rw [hfun]
    exact measurable_eval_extSigma he

end Shear

section CondExpComp

/-- Conditional expectation commutes with a measure-preserving bijection that maps `m` into itself
in both directions. -/
theorem condExp_comp_eq {Ω : Type*} {m m0 : MeasurableSpace Ω} {μ : Measure Ω}
    [IsProbabilityMeasure μ] (hm : m ≤ m0) {T T' : Ω → Ω} (hT : MeasurePreserving T μ μ)
    (hT' : Measurable T') (hTm : Measurable[m, m] T) (hT'm : Measurable[m, m] T')
    (hT'T : ∀ ω, T' (T ω) = ω) (hTT' : ∀ ω, T (T' ω) = ω) {F : Ω → ℝ} (hF : Integrable F μ) :
    μ[F ∘ T | m] =ᵐ[μ] μ[F | m] ∘ T := by
  let e : Ω ≃ᵐ Ω := ⟨⟨T, T', hT'T, hTT'⟩, hT.measurable, hT'⟩
  have hemb : MeasurableEmbedding T := e.measurableEmbedding
  refine (ae_eq_condExp_of_forall_setIntegral_eq hm ((hT.integrable_comp_emb hemb).2 hF)
    (fun s _ _ => ((hT.integrable_comp_emb hemb).2 integrable_condExp).integrableOn)
    (fun s hs _ => ?_)
    (stronglyMeasurable_condExp.comp_measurable hTm).aestronglyMeasurable).symm
  have hs' : MeasurableSet[m] (T' ⁻¹' s) := hT'm hs
  have hss : s = T ⁻¹' (T' ⁻¹' s) := by
    ext ω
    simp [hT'T]
  rw [hss]
  simp only [Function.comp_apply]
  rw [hT.setIntegral_preimage_emb hemb, hT.setIntegral_preimage_emb hemb,
    setIntegral_condExp hm hF hs']

end CondExpComp


/-! ## The coarse field after one exterior resampling -/

section MixedBlockMeasure

variable {E Ec G : Type*} [Fintype E] [Fintype Ec] [MeasurableSpace G]

/-- **Resampling preserves coarse measurability at `κ = 0`.** Let `c U ē = φ (U (t ē)) (U (p ē))`
with a shear `(t, p, φ)` that preserves the product measure, and let `p ē ∈ V` force `t ē ∈ V`.
Then `E_μ[g ∘ c | links outside V]` is a.e. a function of `c`. -/
theorem condExp_comp_aestronglyMeasurable_comap (h : Measure G) [IsProbabilityMeasure h]
    (μ : Measure (E → G)) (hμ : μ = Measure.pi fun _ => h)
    {t p : Ec → E} {φ φ' : G → G → G} (ht : Function.Injective t) (htp : ∀ x y, t x ≠ p y)
    (hφm : Measurable fun z : G × G => φ z.1 z.2) (hφ'm : Measurable fun z : G × G => φ' z.1 z.2)
    (hφ : ∀ y, MeasurePreserving (φ · y) h h) (hinv : ∀ x y, φ' (φ x y) y = x)
    (hinv' : ∀ x y, φ (φ' x y) y = x) {V : Set E} (hV : ∀ ē, p ē ∈ V → t ē ∈ V)
    {c : (E → G) → (Ec → G)} (hc : ∀ U ē, c U ē = φ (U (t ē)) (U (p ē)))
    {g : (Ec → G) → ℝ} (hg : StronglyMeasurable g) (hgi : Integrable (g ∘ c) μ) :
    AEStronglyMeasurable[MeasurableSpace.comap c MeasurableSpace.pi] (μ[g ∘ c | extSigma V]) μ := by
  subst hμ
  let prj : (E → G) → (Ec → G) := fun U ē => U (t ē)
  have hcπ : c = prj ∘ shear t p φ := by
    funext U ē
    simp only [Function.comp_apply, prj, shear_apply_t ht, hc]
  have hΘ := measurePreserving_shear h ht htp hφm hφ
  have hΘ' : Measurable (shear t p φ') := measurable_shear ht hφ'm
  let e : (E → G) ≃ᵐ (E → G) :=
    ⟨⟨shear t p φ, shear t p φ', shear_shear ht htp hinv, shear_shear ht htp hinv'⟩,
      hΘ.measurable, hΘ'⟩
  have hemb : MeasurableEmbedding (shear t p φ) := e.measurableEmbedding
  have hπm : Measurable[extSigma (G := G) (Set.range t)ᶜ, MeasurableSpace.pi] prj :=
    @measurable_pi_lambda _ _ _ (extSigma (G := G) (Set.range t)ᶜ) _ prj fun ē =>
      measurable_eval_extSigma (by simp)
  have hgπ : Integrable (g ∘ prj) (Measure.pi fun _ : E => h) := by
    have h1 : Integrable ((g ∘ prj) ∘ shear t p φ) (Measure.pi fun _ : E => h) := by
      rw [Function.comp_assoc, ← hcπ]
      exact hgi
    exact (hΘ.integrable_comp_emb hemb).1 h1
  have step1 : (Measure.pi fun _ : E => h)[g ∘ c | extSigma V] =ᵐ[Measure.pi fun _ : E => h]
      (Measure.pi fun _ : E => h)[g ∘ prj | extSigma V] ∘ shear t p φ := by
    rw [hcπ, ← Function.comp_assoc]
    exact condExp_comp_eq (extSigma_le V) hΘ hΘ' (measurable_shear_extSigma ht hφm hV)
      (measurable_shear_extSigma ht hφ'm hV) (shear_shear ht htp hinv)
      (shear_shear ht htp hinv') hgπ
  have step2 := condExp_extSigma_of_meas (fun _ : E => h) V (Set.range t)ᶜ hgπ
    (hg.comp_measurable hπm)
  have hle : extSigma (G := G) (V ∪ (Set.range t)ᶜ) ≤
      MeasurableSpace.comap prj MeasurableSpace.pi := by
    refine (extSigma_anti Set.subset_union_right).trans ?_
    refine iSup₂_le fun e he => ?_
    rw [compl_compl] at he
    obtain ⟨ē, rfl⟩ := he
    exact measurable_iff_comap_le.1 ((measurable_pi_apply ē).comp (comap_measurable prj))
  have hΘc : Measurable[MeasurableSpace.comap c MeasurableSpace.pi,
      MeasurableSpace.comap prj MeasurableSpace.pi] (shear t p φ) := by
    rw [measurable_iff_comap_le, MeasurableSpace.comap_comp, ← hcπ]
  exact ⟨(Measure.pi fun _ : E => h)[g ∘ prj | extSigma (V ∪ (Set.range t)ᶜ)] ∘ shear t p φ,
    (stronglyMeasurable_condExp.mono hle).comp_measurable hΘc,
    step1.trans (hΘ.quasiMeasurePreserving.ae_eq_comp step2)⟩

end MixedBlockMeasure

/-! ## From coarse measurability to the range of `J` -/

section Transfer

variable {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ]
  (Γ : Type*) [Group Γ] [MulAction Γ Ω] [MeasurableConstSMul Γ Ω] [SMulInvariantMeasure Γ Ω μ]
  {Ωc : Type*} [MeasurableSpace Ωc] (μc : Measure Ωc) [IsProbabilityMeasure μc]
  (Γc : Type*) [Group Γc] [MulAction Γc Ωc] [MeasurableConstSMul Γc Ωc]
  [SMulInvariantMeasure Γc Ωc μc] {c : Ω → Ωc} (hc : MeasurePreserving c μ μc)

omit [IsProbabilityMeasure μ] [IsProbabilityMeasure μc] in
/-- `J g = g ∘ c` intertwines the two gauge actions. -/
theorem compL2_actL2 {φ : Γ → Γc} (hφ : ∀ γ ω, c (γ • ω) = φ γ • c ω) (γ : Γ)
    (g : Lp ℝ 2 μc) :
    compL2 μ hc (actL2 μc Γc (φ γ) g) = actL2 μ Γ γ (compL2 μ hc g) := by
  refine Lp.ext ?_
  have h1 := coeFn_compL2 μ (measurePreserving_smul γ μ) (compL2 μ hc g)
  have h2 := (measurePreserving_smul γ μ).quasiMeasurePreserving.ae_eq_comp (coeFn_compL2 μ hc g)
  have h3 := coeFn_compL2 μ hc (actL2 μc Γc (φ γ) g)
  have h4 := hc.quasiMeasurePreserving.ae_eq_comp
    (coeFn_compL2 μc (measurePreserving_smul (φ γ) μc) g)
  refine (h3.trans h4).trans (Filter.EventuallyEq.trans ?_ (h1.trans h2).symm)
  exact Filter.Eventually.of_forall fun ω => by simp [Function.comp, hφ]

/-- A coarse observable whose lift is centred and gauge invariant is itself centred and
coarse-gauge invariant. -/
theorem mem_cgL2_of_compL2 {φ : Γ → Γc} (hφ : ∀ γ ω, c (γ • ω) = φ γ • c ω)
    (hsurj : Function.Surjective φ) {g : Lp ℝ 2 μc} (hg : compL2 μ hc g ∈ cgL2 μ Γ) :
    g ∈ cgL2 μc Γc := by
  rw [cgL2, mem_invSub] at hg ⊢
  refine ⟨?_, fun γc => ?_⟩
  · rw [← (compL2 μ hc).inner_map_map, compL2_one2 μ μc hc]
    exact hg.1
  · obtain ⟨γ, rfl⟩ := hsurj γc
    apply (compL2 μ hc).injective
    rw [compL2_actL2 μ Γ μc Γc hc hφ, hg.2 γ]

/-- **Doob–Dynkin for `J`.** A centred gauge-invariant observable that is a.e. a function of `c`
is `J y` for a centred coarse-gauge-invariant `y`. -/
theorem exists_coarseJ_eq {φ : Γ → Γc} (hφ : ∀ γ ω, c (γ • ω) = φ γ • c ω)
    (hsurj : Function.Surjective φ) {f : cgL2 μ Γ}
    (hf : (f : Lp ℝ 2 μ) ∈ lpMeas ℝ ℝ (MeasurableSpace.comap c ‹MeasurableSpace Ωc›) 2 μ) :
    ∃ y, coarseJ μ Γ μc Γc hc hφ y = f := by
  rw [mem_lpMeas_iff_aestronglyMeasurable] at hf
  obtain ⟨f', hf'm, hff'⟩ := hf
  obtain ⟨k, hk, hkf⟩ := hf'm.exists_eq_measurable_comp
  have hkL : MemLp k 2 μc := by
    rw [← hc.map_eq, memLp_map_measure_iff hk.aestronglyMeasurable hc.measurable.aemeasurable,
      ← hkf]
    exact MemLp.ae_eq hff' (Lp.memLp _)
  have hcomp : compL2 μ hc (hkL.toLp k) = (f : Lp ℝ 2 μ) := by
    refine Lp.ext ?_
    refine (coeFn_compL2 μ hc _).trans ?_
    refine (hc.quasiMeasurePreserving.ae_eq_comp hkL.coeFn_toLp).trans ?_
    rw [← hkf]
    exact hff'.symm
  refine ⟨⟨hkL.toLp k, mem_cgL2_of_compL2 μ Γ μc Γc hc hφ hsurj (hcomp ▸ f.2)⟩, ?_⟩
  exact Subtype.ext hcomp

end Transfer

/-! ## The mixed block vanishes at `κ = 0` -/

section MixedBlock

open SchurSplit YangMills.StrongCoupling.CubeSplit

variable {S E Sc Ec G : Type*} [OrientedGraph S E] [Fintype E] [OrientedGraph Sc Ec] [Fintype Ec]
  [Group G] [MeasurableSpace G] [MeasurableMul₂ G] [MeasurableInv G] {Pl : Type*} [Fintype Pl]
  (plaq : Pl → Plaq S E) (χ : ClassFn G) {κ : ℝ} (hκ : κ = 0) (h : Measure G)
  [IsProbabilityMeasure h] [Measure.IsMulLeftInvariant h] [Measure.IsMulRightInvariant h]

include hκ in
/-- One shear step of `wilsonP_wilsonJ_mem_range`: if `c U ē = φ (U (t ē)) (U (p ē))` for a
measure-preserving, invertible shear `(t, p, φ)` and `p ē ∈ V` forces `t ē ∈ V`, then at `κ = 0`
`P_V (J y) = J y'` for some `y'`. -/
theorem wilsonP_wilsonJ_of_shear (blk : Blocking S E Sc Ec) {t p : Ec → E} {φ φ' : G → G → G}
    (ht : Function.Injective t) (htp : ∀ x y, t x ≠ p y)
    (hφm : Measurable fun z : G × G => φ z.1 z.2) (hφ'm : Measurable fun z : G × G => φ' z.1 z.2)
    (hφ : ∀ y, MeasurePreserving (φ · y) h h) (hinv : ∀ x y, φ' (φ x y) y = x)
    (hinv' : ∀ x y, φ (φ' x y) y = x) (hcφ : ∀ U ē, blockMap blk U ē = φ (U (t ē)) (U (p ē)))
    {V : Set E} (hV : ∀ ē, p ē ∈ V → t ē ∈ V) (y : coarseY plaq χ κ h blk) :
    ∃ y', wilsonJ plaq χ κ h blk y' = wilsonP plaq χ κ h V (wilsonJ plaq χ κ h blk y) := by
  have hc := measurePreserving_blockMap plaq χ κ h blk
  refine exists_coarseJ_eq (wilsonMeasure plaq χ κ h) (Gauge S G) (coarseLaw plaq χ κ h blk)
    (Gauge Sc G) hc (blockMap_smul blk) (coarseGauge_surjective blk) ?_
  rw [mem_lpMeas_iff_aestronglyMeasurable]
  obtain ⟨g, hg, hyg⟩ := Lp.aestronglyMeasurable (y : Lp ℝ 2 (coarseLaw plaq χ κ h blk))
  have hJ : (((wilsonJ plaq χ κ h blk y : wilsonH plaq χ κ h) :
      Lp ℝ 2 (wilsonMeasure plaq χ κ h)) : (E → G) → ℝ) =ᵐ[wilsonMeasure plaq χ κ h]
        g ∘ blockMap blk :=
    (coeFn_compL2 _ hc _).trans (hc.quasiMeasurePreserving.ae_eq_comp hyg)
  have hint : Integrable (g ∘ blockMap blk) (wilsonMeasure plaq χ κ h) :=
    ((Lp.memLp _).integrable one_le_two).congr hJ
  have hA := condExp_comp_aestronglyMeasurable_comap h (wilsonMeasure plaq χ κ h)
    (wilsonMeasure_eq_pi plaq χ hκ h) ht htp hφm hφ'm hφ hinv hinv' hV hcφ hg hint
  refine hA.congr ?_
  exact (condExp_congr_ae hJ).symm.trans
    (condL2_ae_eq_condExp _ (extSigma_le V) _).symm

include hκ in
/-- **At `κ = 0` every cube projection maps `ran J` into itself**, for any link set `V` and any
blocking whose fine links are pairwise distinct. -/
theorem wilsonP_wilsonJ_mem_range (blk : Blocking S E Sc Ec)
    (hinj : Function.Injective (Sum.elim blk.a blk.b)) (V : Set E) (y : coarseY plaq χ κ h blk) :
    ∃ y', wilsonJ plaq χ κ h blk y' = wilsonP plaq χ κ h V (wilsonJ plaq χ κ h blk y) := by
  classical
  have ha : Function.Injective blk.a := hinj.comp Sum.inl_injective
  have hb : Function.Injective blk.b := hinj.comp Sum.inr_injective
  have hab : ∀ x y, blk.a x ≠ blk.b y := fun x y hxy => Sum.inl_ne_inr (hinj hxy)
  have hba : ∀ x y, blk.b x ≠ blk.a y := fun x y hxy => hab y x hxy.symm
  let R : Set E := {e | ∃ ē, e = blk.b ē ∧ blk.a ē ∉ V}
  have hVa : ∀ ē, blk.b ē ∈ V \ R → blk.a ē ∈ V \ R := by
    rintro ē ⟨hbV, hbR⟩
    refine ⟨?_, ?_⟩
    · by_contra ha'
      exact hbR ⟨ē, rfl, ha'⟩
    · rintro ⟨ē', he, -⟩
      exact hab ē ē' he
  have hVb : ∀ ē, blk.a ē ∈ V ∩ R → blk.b ē ∈ V ∩ R := by
    rintro ē ⟨-, ē', he, -⟩
    exact absurd he (hab ē ē')
  have hsplit : (V \ R) ∪ (V ∩ R) = V := Set.sdiff_union_inter V R
  obtain ⟨y2, hy2⟩ := wilsonP_wilsonJ_of_shear plaq χ hκ h blk (t := blk.b) (p := blk.a)
    (φ := fun x y => y * x) (φ' := fun x y => y⁻¹ * x) hb hba
    (measurable_snd.mul measurable_fst) (measurable_snd.inv.mul measurable_fst)
    (fun y => measurePreserving_mul_left h y) (fun x y => inv_mul_cancel_left y x)
    (fun x y => mul_inv_cancel_left y x) (fun _ _ => rfl) hVb y
  obtain ⟨y1, hy1⟩ := wilsonP_wilsonJ_of_shear plaq χ hκ h blk (t := blk.a) (p := blk.b)
    (φ := fun x y => x * y) (φ' := fun x y => x * y⁻¹) ha hab
    (measurable_fst.mul measurable_snd) (measurable_fst.mul measurable_snd.inv)
    (fun y => measurePreserving_mul_right h y) (fun x y => mul_inv_cancel_right x y)
    (fun x y => inv_mul_cancel_right x y) (fun _ _ => rfl) hVa y2
  refine ⟨y1, ?_⟩
  rw [hy1, hy2, wilsonP_comp_zero plaq χ hκ h, hsplit]

include hκ in
/-- At `κ = 0`, for a blocking whose fine links `a ē`, `b ē` are pairwise distinct, `P_V` maps
`ran Π` into itself. -/
theorem wilsonP_mem_ranPi (blk : Blocking S E Sc Ec)
    (hinj : Function.Injective (Sum.elim blk.a blk.b)) (V : Set E) (z : wilsonH plaq χ κ h)
    (hz : (isoProj (wilsonJ plaq χ κ h blk)).P z = z) :
    (isoProj (wilsonJ plaq χ κ h blk)).P (wilsonP plaq χ κ h V z) = wilsonP plaq χ κ h V z := by
  obtain ⟨y', hy'⟩ := wilsonP_wilsonJ_mem_range plaq χ hκ h blk hinj V
    (isoAdj (wilsonJ plaq χ κ h blk) z)
  have hz' : wilsonJ plaq χ κ h blk (isoAdj (wilsonJ plaq χ κ h blk) z) = z := by
    rw [← isoProj_apply]
    exact hz
  rw [hz'] at hy'
  rw [← hy', isoProj_apply, isoAdj_apply_self]

include hκ in
/-- **The mixed block vanishes at `κ = 0`**: for a blocking whose fine links `a ē`, `b ē` are
pairwise distinct, `B = (I − Π) D Π = 0` on `H_c` for every finite family of link sets `Vₓ` and
weights `wₓ`. -/
theorem wilson_blkB_zero (blk : Blocking S E Sc Ec)
    (hinj : Function.Injective (Sum.elim blk.a blk.b)) {ι : Type*} [Fintype ι] (V : ι → Set E)
    (w : ι → ℝ) (v : (isoProj (wilsonJ plaq χ κ h blk)).Hc) :
    (isoProj (wilsonJ plaq χ κ h blk)).blkB (cubeGen w fun x => wilsonP plaq χ κ h (V x)) v = 0 := by
  have hW := wilson_inputs plaq χ κ h blk V w (fun _ : Unit => (∅ : Set Ec)) (fun _ => 0)
  have hv : (isoProj (wilsonJ plaq χ κ h blk)).P v = v :=
    (isoProj (wilsonJ plaq χ κ h blk)).P_of_mem_Hc v.2
  have hx : ∀ x, wilsonP plaq χ κ h (V x) v -
      (isoProj (wilsonJ plaq χ κ h blk)).P (wilsonP plaq χ κ h (V x) v) = 0 := fun x => by
    rw [wilsonP_mem_ranPi plaq χ hκ h blk hinj (V x) v hv, sub_self]
  refine Subtype.ext ?_
  rw [hW.blkB_eq v]
  simp only [hx, smul_zero, Finset.sum_const_zero, neg_zero, ZeroMemClass.coe_zero]

end MixedBlock

/-! ## `hResidual` with the trial operator `X = 0` -/

section Residual

open SchurSplit YangMills.StrongCoupling.CubeSplit

variable {H Y : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [NormedAddCommGroup Y]
  [InnerProductSpace ℝ Y] {ι : Type*} [Fintype ι] {D : H →ₗ[ℝ] H} {w : ι → ℝ}
  {P : ι → H →ₗ[ℝ] H} {pj : OrthProj H} {J : Y →ₗ[ℝ] H} {Jt : H →ₗ[ℝ] Y} {Dc : Y →ₗ[ℝ] Y}

/-- If the mixed block vanishes, `D ≥ w_min` and `⟪y, D_c y⟫ ≤ c_D ‖y‖²`, then `hResidual` holds
with `X = 0` for every `β' ≥ 0` with `β' c_D ≤ w_min`. -/
theorem hResidual_zero_of_blkB (hW : CubeSplitInputs D w P pj J Jt Dc)
    (hB : ∀ v, pj.blkB D v = 0) {wmin cD β' : ℝ} (hD : ∀ u, wmin * ‖u‖ ^ 2 ≤ ⟪u, D u⟫_ℝ)
    (hDc : ∀ y, ⟪y, Dc y⟫_ℝ ≤ cD * ‖y‖ ^ 2) (hβ' : 0 ≤ β') (hβc : β' * cD ≤ wmin) (α lam : ℝ)
    (v : pj.Hc) :
    β' * pj.gC Jt Dc v + qForm (pj.blkA D) (pj.blkB D) α 0 v +
      ‖resid (pj.blkA D) (pj.blkB D) α 0 v‖ ^ 2 / (lam - α) ≤ ⟪v, pj.blkC D v⟫_ℝ := by
  have hq : qForm (pj.blkA D) (pj.blkB D) α 0 v = 0 := by simp [qForm]
  have hr : resid (pj.blkA D) (pj.blkB D) α 0 v = 0 := by
    rw [resid_apply, hB]
    simp
  rw [hq, hr, norm_zero, zero_pow two_ne_zero, zero_div, add_zero, add_zero, pj.inner_blkC]
  have hJt : ‖Jt v‖ ^ 2 = ‖(v : H)‖ ^ 2 := by
    rw [← real_inner_self_eq_norm_sq, ← real_inner_self_eq_norm_sq, ← hW.adj, hW.JJt,
      pj.P_of_mem_Hc v.2]
  have h1 : pj.gC Jt Dc v ≤ cD * ‖(v : H)‖ ^ 2 := by
    rw [← hJt]
    exact hDc (Jt v)
  calc β' * pj.gC Jt Dc v ≤ β' * (cD * ‖(v : H)‖ ^ 2) := mul_le_mul_of_nonneg_left h1 hβ'
    _ = (β' * cD) * ‖(v : H)‖ ^ 2 := by ring
    _ ≤ wmin * ‖(v : H)‖ ^ 2 := mul_le_mul_of_nonneg_right hβc (sq_nonneg _)
    _ ≤ ⟪(v : H), D v⟫_ℝ := hD v

/-- `CubeSplitInputs.gap_of_residual` when the mixed block vanishes: `hFibre` from `D ≥ w_min`,
`hResidual` with `X = 0`. -/
theorem gap_of_blkB_zero (hW : CubeSplitInputs D w P pj J Jt Dc) (hB : ∀ v, pj.blkB D v = 0)
    {wmin cD β' ϖ α : ℝ} (hD : ∀ u, wmin * ‖u‖ ^ 2 ≤ ⟪u, D u⟫_ℝ)
    (hDc : ∀ y, ⟪y, Dc y⟫_ℝ ≤ cD * ‖y‖ ^ 2) (hβ' : 0 ≤ β') (hβc : β' * cD ≤ wmin)
    (hCoarseGap : ϖ • LinearMap.id ≤ Dc) (hα : α < wmin) :
    min α (β' * ϖ) • LinearMap.id ≤ D :=
  hW.gap_of_residual (fun u _ => hD u) hα hβ' hCoarseGap 0
    (hResidual_zero_of_blkB hW hB hD hDc hβ' hβc α wmin)

/-- `⟪y, ∑_z w_z (I − P_z) y⟫ ≤ (∑_z w_z) ‖y‖²` for orthogonal projections and `w_z ≥ 0`. -/
theorem inner_cubeGen_le_sum {κ : Type*} [Fintype κ] (wc : κ → ℝ) (hw : ∀ z, 0 ≤ wc z)
    (Q : κ → OrthProj Y) (y : Y) :
    ⟪y, cubeGen wc (fun z => (Q z).P) y⟫_ℝ ≤ (∑ z, wc z) * ‖y‖ ^ 2 := by
  rw [inner_cubeGen_eq, Finset.sum_mul]
  refine Finset.sum_le_sum fun z _ => mul_le_mul_of_nonneg_left ?_ (hw z)
  rw [norm_sub_P_sq, (Q z).inner_P_self]
  linarith [sq_nonneg ‖(Q z).P y‖]

end Residual

/-! ## The closed SU(2) instance at `β = 0` -/

section SU2Closed

open SchurSplit YangMills.StrongCoupling.CubeSplit YangMills.StrongCoupling.WilsonSU2

variable (M : ℕ) [NeZero M]

/-- **The mixed block of the SU(2) model vanishes at `β = 0`** (side-2 cubes at every base point,
weights `1/16`, straight blocking, every `M ≥ 1`). -/
theorem su2_blkB_zero (v : (FibreReduction.su2Pi M 0).Hc) :
    (FibreReduction.su2Pi M 0).blkB
      (FibreReduction.su2D M 0 (FibreReduction.cube2 M) (fun _ => 1 / 16)) v = 0 :=
  wilson_blkB_zero plaqOf reTr (zero_div 2) haarSU2 (straightBlocking M)
    (straightBlocking_sumElim_injective M) (FibreReduction.cube2 M) (fun _ => 1 / 16) v

/-- `(ℤ/nℤ)⁴` has `n⁴` sites. -/
theorem card_site (n : ℕ) [NeZero n] : Fintype.card (Site n) = n ^ 4 := by
  simp [Site, ZMod.card]

/-- **`hResidual` for the SU(2) model at `β = 0`** (side-2 cubes `cube2 M x` with weights `1/16`,
straight blocking, coarse cubes `sideTwoCube M z` with weights `1/16`, every `M ≥ 1`): the certificate
of `CubeSplitInputs.gap_of_residual` holds with the trial operator `X = 0` and `β' = M⁻⁴` (volume
dependent), for every `α` and `λ`. -/
theorem su2_hResidual_zero (α lam : ℝ) (v : (FibreReduction.su2Pi M 0).Hc) :
    (1 / (M : ℝ) ^ 4) * (FibreReduction.su2Pi M 0).gC (FibreReduction.su2Jt M 0)
        (FibreReduction.su2Dc M 0 (sideTwoCube M) (fun _ => 1 / 16)) v +
      qForm (E := (FibreReduction.su2Pi M 0).Hf) (F := (FibreReduction.su2Pi M 0).Hc)
        ((FibreReduction.su2Pi M 0).blkA
          (FibreReduction.su2D M 0 (FibreReduction.cube2 M) (fun _ => 1 / 16)))
        ((FibreReduction.su2Pi M 0).blkB
          (FibreReduction.su2D M 0 (FibreReduction.cube2 M) (fun _ => 1 / 16))) α
          (0 : (FibreReduction.su2Pi M 0).Hc →ₗ[ℝ] (FibreReduction.su2Pi M 0).Hf) v +
      ‖resid (E := (FibreReduction.su2Pi M 0).Hf) (F := (FibreReduction.su2Pi M 0).Hc)
        ((FibreReduction.su2Pi M 0).blkA
          (FibreReduction.su2D M 0 (FibreReduction.cube2 M) (fun _ => 1 / 16)))
        ((FibreReduction.su2Pi M 0).blkB
          (FibreReduction.su2D M 0 (FibreReduction.cube2 M) (fun _ => 1 / 16))) α
          (0 : (FibreReduction.su2Pi M 0).Hc →ₗ[ℝ] (FibreReduction.su2Pi M 0).Hf) v‖ ^ 2 /
        (lam - α) ≤
      ⟪v, (FibreReduction.su2Pi M 0).blkC
        (FibreReduction.su2D M 0 (FibreReduction.cube2 M) (fun _ => 1 / 16)) v⟫_ℝ := by
  have hW := su2_inputs M 0 (FibreReduction.cube2 M) (fun _ => 1 / 16) (sideTwoCube M)
    (fun _ => 1 / 16)
  have hM : (0 : ℝ) < (M : ℝ) ^ 4 := by
    have : (0 : ℝ) < M := Nat.cast_pos.2 (Nat.pos_of_ne_zero (NeZero.ne M))
    positivity
  have hsum : ∑ _z : Site M, (1 / 16 : ℝ) = (M : ℝ) ^ 4 * (1 / 16) := by
    rw [Finset.sum_const, Finset.card_univ, card_site, nsmul_eq_mul]
    push_cast
    ring
  have hβ' : (0 : ℝ) ≤ 1 / (M : ℝ) ^ 4 := by positivity
  have hβc : (1 / (M : ℝ) ^ 4) * (∑ _z : Site M, (1 / 16 : ℝ)) ≤ 1 / 16 := by
    rw [hsum]
    exact (show (1 / (M : ℝ) ^ 4) * ((M : ℝ) ^ 4 * (1 / 16)) = 1 / 16 by
      rw [one_div, ← mul_assoc, inv_mul_cancel₀ hM.ne', one_mul]).le
  exact hResidual_zero_of_blkB hW (su2_blkB_zero M) (wmin := 1 / 16)
    (cD := ∑ _z : Site M, (1 / 16 : ℝ)) (β' := 1 / (M : ℝ) ^ 4)
    (fun u => SchurTower.form_of_smul_id_le (su2_fine_gap_zero M) u)
    (fun y => inner_cubeGen_le_sum (fun _ => 1 / 16) (fun _ => by norm_num)
      (fun z => extProj (coarseLaw (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2
        (straightBlocking M)) (sideTwoCube M z)) y)
    hβ' hβc α lam v

/-- **A closed instance of `CubeSplitInputs.gap_of_residual` for the SU(2) Wilson objects at
`β = 0`** (finite volume `(ℤ/2Mℤ)⁴`, every `M ≥ 1`): `hWilson` is `su2_inputs`, `hFibre` holds with
`λ = 1/16`, the mixed block vanishes so `hResidual` holds with `X = 0` and `β' = M⁻⁴` (volume
dependent), and
`hCoarseGap` holds with `ϖ_c = 1/16`; so `D ≥ min(α, M⁻⁴/16) I` for every `α < 1/16`. The bound is
weaker than `su2_fine_gap_zero`; its point is that every input of the interface is met. -/
theorem su2_gap_closed_zero {α : ℝ} (hα : α < 1 / 16) :
    min α ((1 / (M : ℝ) ^ 4) * (1 / 16)) • LinearMap.id ≤
      FibreReduction.su2D M 0 (FibreReduction.cube2 M) (fun _ => 1 / 16) := by
  have hW := su2_inputs M 0 (FibreReduction.cube2 M) (fun _ => 1 / 16) (sideTwoCube M)
    (fun _ => 1 / 16)
  have hM : (0 : ℝ) < (M : ℝ) ^ 4 := by
    have : (0 : ℝ) < M := Nat.cast_pos.2 (Nat.pos_of_ne_zero (NeZero.ne M))
    positivity
  have hsum : ∑ _z : Site M, (1 / 16 : ℝ) = (M : ℝ) ^ 4 * (1 / 16) := by
    rw [Finset.sum_const, Finset.card_univ, card_site, nsmul_eq_mul]
    push_cast
    ring
  have hβ' : (0 : ℝ) ≤ 1 / (M : ℝ) ^ 4 := by positivity
  refine gap_of_blkB_zero hW (su2_blkB_zero M) (wmin := 1 / 16)
    (cD := ∑ _z : Site M, (1 / 16 : ℝ)) (β' := 1 / (M : ℝ) ^ 4) (ϖ := 1 / 16)
    (fun u => SchurTower.form_of_smul_id_le (su2_fine_gap_zero M) u)
    (fun y => inner_cubeGen_le_sum (fun _ => 1 / 16) (fun _ => by norm_num)
      (fun z => extProj (coarseLaw (plaqOf (n := 2 * M)) reTr ((0 : ℝ) / 2) haarSU2
        (straightBlocking M)) (sideTwoCube M z)) y)
    hβ' ?_ (su2_coarse_gap_zero M) hα
  have hM' : (M : ℝ) ^ 4 ≠ 0 := hM.ne'
  rw [hsum]
  exact (show (1 / (M : ℝ) ^ 4) * ((M : ℝ) ^ 4 * (1 / 16)) = 1 / 16 by
    rw [one_div, ← mul_assoc, inv_mul_cancel₀ hM', one_mul]).le

end SU2Closed


