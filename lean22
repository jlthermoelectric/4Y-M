section AvgContinuity

variable {S E Sc Ec ι : Type*} [OrientedGraph S E] [OrientedGraph Sc Ec] [Fintype ι]
  (pb : PathBlocking S E Sc Ec ι)

/-- **The normalised path average is continuous where `Q_ē ≠ 0`.** -/
theorem continuousOn_avgMap_apply (V0 : SU2) (e : Ec) :
    ContinuousOn (fun U : E → SU2 => avgMap pb V0 U e) (nzSet pb e) := by
  rw [continuousOn_iff_continuous_domRestrict]
  let F : nzSet pb e → SU2 := fun U =>
    ⟨(Real.sqrt (qnorm (qsum pb U.1 e)))⁻¹ • qsum pb U.1 e, normalise_mem (qsum_mem pb U.1 e) U.2⟩
  have hF : Continuous F := by
    refine Continuous.subtype_mk ?_ _
    have hq : Continuous fun U : nzSet pb e => qsum pb U.1 e :=
      (continuous_qsum pb e).comp continuous_subtype_val
    refine Continuous.smul
      (f := fun U : nzSet pb e => (Real.sqrt (qnorm (qsum pb U.1 e)))⁻¹) ?_ hq
    exact (Real.continuous_sqrt.comp (continuous_qnorm.comp hq)).inv₀ fun U =>
      (Real.sqrt_pos.2 (qnorm_pos (qsum_mem pb U.1 e) U.2)).ne'
  convert hF using 1
  funext U
  exact Subtype.ext (nrmSU2_coe V0 (qsum_mem pb U.1 e) U.2)

theorem isOpen_nzSet (e : Ec) : IsOpen (nzSet pb e) :=
  isOpen_ne_fun (continuous_qsum pb e) continuous_const

/-- If every path of `ē` has holonomy `1` and the weights sum to `1`, then `c(U)(ē) = 1`. -/
theorem qsum_eq_one {U : E → SU2} {e : Ec} (h : ∀ i, pathProd (pb.path e i) U = 1)
    (hw : ∑ i, pb.wt e i = 1) : qsum pb U e = 1 := by
  simp only [qsum, h]
  rw [← Finset.sum_smul, hw, one_smul]
  rfl

theorem avgMap_eq_one_of_qsum {U : E → SU2} {e : Ec} (V0 : SU2) (h : qsum pb U e = 1) :
    avgMap pb V0 U e = 1 := by
  show nrmSU2 V0 (qsum pb U e) = 1
  rw [h]
  exact nrmSU2_su2 V0 1

end AvgContinuity

/-- A continuous function on an open set, taking two values there, is not almost everywhere
constant for the product Haar measure. -/
theorem not_ae_const_pi_on {n : ℕ} [NeZero n] {F : (Link n → SU2) → ℝ} {O : Set (Link n → SU2)}
    (hO : IsOpen O) (hF : ContinuousOn F O) {U₁ U₂ : Link n → SU2} (h1 : U₁ ∈ O) (h2 : U₂ ∈ O)
    (h12 : F U₁ ≠ F U₂) (c : ℝ) :
    ¬ ∀ᵐ U ∂(Measure.pi fun _ : Link n => haarSU2), F U = c := by
  intro hae
  rw [ae_iff] at hae
  have hopen : IsOpen (O ∩ F ⁻¹' {c}ᶜ) := hF.isOpen_inter_preimage hO isOpen_compl_singleton
  have hne : (O ∩ F ⁻¹' {c}ᶜ).Nonempty := by
    by_cases hc : F U₁ = c
    · exact ⟨U₂, h2, fun h => h12 (hc.trans (Set.mem_singleton_iff.1 h).symm)⟩
    · exact ⟨U₁, h1, fun h => hc (Set.mem_singleton_iff.1 h)⟩
  have hsub : O ∩ F ⁻¹' {c}ᶜ ⊆ {U | ¬ F U = c} := fun U hU h => hU.2 (Set.mem_singleton_iff.2 h)
  exact (hopen.measure_pos _ hne).ne' (measure_mono_null hsub hae)

section CoarseNonVacuity

/-- The rotation by a right angle, `[[0, −1], [1, 0]] ∈ SU(2)`. -/
noncomputable def gBox : SU2 := rotSU2 (Real.pi / 2)

theorem gBox_coe : (gBox : Matrix (Fin 2) (Fin 2) ℂ) = !![0, -1; 1, 0] := by
  simp [gBox, rotSU2, Real.cos_pi_div_two, Real.sin_pi_div_two]

theorem sum_box_ite (A B : Matrix (Fin 2) (Fin 2) ℂ) :
    ∑ k : Fin 16, ((1 : ℝ) / 16) • (if k = 0 ∨ k = 1 then A else B) =
      ((1 : ℝ) / 16) • (2 • A + 14 • B) := by
  have c1 : (Finset.univ.filter fun k : Fin 16 => k = 0 ∨ k = 1).card = 2 := by decide
  have c2 : (Finset.univ.filter fun k : Fin 16 => ¬(k = 0 ∨ k = 1)).card = 14 := by decide
  rw [← Finset.smul_sum, Finset.sum_ite, Finset.sum_const, Finset.sum_const, c1, c2]

/-- The matrix `Q = (1/16)(2 g + 14 I)` with `g` the right-angle rotation. -/
noncomputable def qBox : Matrix (Fin 2) (Fin 2) ℂ :=
  ((1 : ℝ) / 16) • (2 • (gBox : Matrix (Fin 2) (Fin 2) ℂ) + 14 • (1 : Matrix (Fin 2) (Fin 2) ℂ))

theorem qBox_00 : qBox 0 0 = ((7 / 8 : ℝ) : ℂ) := by
  rw [qBox, Matrix.smul_apply, Matrix.add_apply, Matrix.smul_apply, Matrix.smul_apply, gBox_coe]
  simp [Complex.real_smul]
  norm_num

theorem qBox_11 : qBox 1 1 = ((7 / 8 : ℝ) : ℂ) := by
  rw [qBox, Matrix.smul_apply, Matrix.add_apply, Matrix.smul_apply, Matrix.smul_apply, gBox_coe]
  simp [Complex.real_smul]
  norm_num

theorem qBox_10 : qBox 1 0 = ((1 / 8 : ℝ) : ℂ) := by
  rw [qBox, Matrix.smul_apply, Matrix.add_apply, Matrix.smul_apply, Matrix.smul_apply, gBox_coe]
  simp [Complex.real_smul]
  norm_num

theorem qBox_mem : qBox ∈ quatSub := by
  unfold qBox
  refine quatSub.smul_mem _ (quatSub.add_mem ?_ ?_)
  · exact nsmul_mem (su2_mem_quatSub gBox) 2
  · exact nsmul_mem (su2_mem_quatSub 1) 14

theorem qBox_ne_zero : qBox ≠ 0 := fun h => by
  have := qBox_00
  rw [h] at this
  norm_num at this

theorem qnorm_qBox : qnorm qBox = 25 / 32 := by
  rw [qnorm, qBox_00, qBox_10, Complex.normSq_ofReal, Complex.normSq_ofReal]
  norm_num

/-- **The normalised average `Q/√det Q` of `qBox` is not the identity**: its `Re tr` is
`(7/4)/√(25/32) ≠ 2`. -/
theorem reTr_nrm_qBox_ne (V0 : SU2) : reTr.toFun (nrmSU2 V0 qBox) ≠ 2 := by
  show ((nrmSU2 V0 qBox : SU2) : Matrix (Fin 2) (Fin 2) ℂ).trace.re ≠ 2
  rw [nrmSU2_coe V0 qBox_mem qBox_ne_zero, Matrix.trace_smul, Complex.smul_re,
    Matrix.trace_fin_two, qBox_00, qBox_11, qnorm_qBox, smul_eq_mul]
  rw [Complex.add_re, Complex.ofReal_re]
  intro h
  have hpos : 0 < Real.sqrt (25 / 32) := Real.sqrt_pos.2 (by norm_num)
  rw [inv_mul_eq_div, div_eq_iff hpos.ne'] at h
  have hs : Real.sqrt (25 / 32) = 7 / 8 := by linarith
  have h2 := Real.sq_sqrt (show (0 : ℝ) ≤ 25 / 32 by norm_num)
  rw [hs] at h2
  norm_num at h2

variable (M : ℕ) [NeZero M]

/-- The fine link from `e₀` in direction `0` of `(ℤ/2Mℤ)⁴`. -/
def fBox : Link (2 * M) := ((ofOff (Pi.single 0 1) : Site (2 * M)), 0)

/-- The configuration with the right-angle rotation on `fBox` and `I` on every other link. -/
noncomputable def UBox : Link (2 * M) → SU2 := Function.update 1 (fBox M) gBox

omit [NeZero M] in
theorem UBox_of_ne {l : Link (2 * M)} (h : l ≠ fBox M) : UBox M l = 1 := by
  rw [UBox, Function.update_of_ne h]
  rfl

omit [NeZero M] in
theorem UBox_f : UBox M (fBox M) = gBox := by
  rw [UBox, Function.update_self]

omit [NeZero M] in
theorem pathProd_UBox_of_notMem {x y : Site (2 * M)} (p : FPath (Site (2 * M)) (Link (2 * M)) x y)
    (hp : fBox M ∉ pathLinks p) : pathProd p (UBox M) = 1 := by
  rw [pathProd_eq_of_notMem p hp (V' := 1) fun e he => UBox_of_ne M he, pathProd_const_one]

omit [NeZero M] in
theorem ιS_zero_eq : ιS M 0 = ofOff 0 := by
  rw [ιS_zero, ofOff_zero]

omit [NeZero M] in
theorem ιS_unitV_eq (μ : Fin 4) : ιS M (0 + unitV μ) = ofOff (Pi.single μ 2) := by
  rw [ιS_add_unitV, ιS_zero, zero_add, ← ofOff_unitV, ← ofOff_add]
  congr 1
  rw [← Pi.single_add]
  norm_num

omit [NeZero M] in
theorem fBox_notMem (hM : 2 ≤ M) {y : Site M} {μ : Fin 4} {B : Fin 4 → ℤ} (hy : ιS M y = ofOff B)
    (k : Fin 16) (h : SepOff (Pi.single 0 1) B 0 (linksOff 0 (boxSteps k μ))) :
    fBox M ∉ pathLinks ((boxPathBlocking M).path (y, μ) k) := by
  rw [pathLinks_boxPathBlocking]
  exact notMem_map_of_sep (by omega) hy _ _ _ h

theorem pathProd_l1_zero :
    pathProd ((boxPathBlocking M).path ((0 : Site M), (0 : Fin 4)) 0) (UBox M) = gBox := by
  show pathProd (boxPath M 0 0 0) (UBox M) = gBox
  simp only [boxPath, pathProd_cast]
  rw [show boxSteps 0 0 = [(0, true), (0, true)] by decide, pathProd_walk_fwd, pathProd_walk_fwd]
  have h1 : ((ιS M 0, 0) : Link (2 * M)) ≠ fBox M := by
    intro h
    have h0 := congrFun (congrArg Prod.fst h) 0
    simp [fBox, ιS_zero, ofOff] at h0
  have h2 : ((ιS M 0 + unitV 0, 0) : Link (2 * M)) = fBox M := by
    rw [fBox, ιS_zero, zero_add, ofOff_unitV]
  have h3 : ∀ x : Site (2 * M), pathProd (walk x []) (UBox M) = 1 := fun x => rfl
  rw [UBox_of_ne M h1, h2, UBox_f, h3, one_mul, mul_one]

theorem pathProd_l1
    (hout : ∀ k : Fin 16, k ≠ 0 → k ≠ 1 →
      fBox M ∉ pathLinks ((boxPathBlocking M).path ((0 : Site M), (0 : Fin 4)) k)) (k : Fin 16) :
    ((pathProd ((boxPathBlocking M).path ((0 : Site M), (0 : Fin 4)) k) (UBox M) : SU2) :
      Matrix (Fin 2) (Fin 2) ℂ) =
      if k = 0 ∨ k = 1 then (gBox : Matrix (Fin 2) (Fin 2) ℂ) else 1 := by
  by_cases hk : k = 0 ∨ k = 1
  · rw [if_pos hk]
    rcases hk with rfl | rfl
    · rw [pathProd_l1_zero]
    · have h := pathProd_boxPath_jOf M (0 : Site M) 0 (UBox M)
      have hj : jOf 0 = 1 := rfl
      rw [hj] at h
      show ((pathProd (boxPath M 0 0 1) (UBox M) : SU2) : Matrix (Fin 2) (Fin 2) ℂ) = _
      rw [h]
      exact congrArg Subtype.val (pathProd_l1_zero M)
  · rw [if_neg hk]
    obtain ⟨hk0, hk1⟩ := not_or.1 hk
    rw [pathProd_UBox_of_notMem M _ (hout k hk0 hk1)]
    rfl

theorem qsum_l1
    (hout : ∀ k : Fin 16, k ≠ 0 → k ≠ 1 →
      fBox M ∉ pathLinks ((boxPathBlocking M).path ((0 : Site M), (0 : Fin 4)) k)) :
    qsum (boxPathBlocking M) (UBox M) ((0 : Site M), (0 : Fin 4)) = qBox := by
  unfold qsum
  simp only [pathProd_l1 M hout]
  exact sum_box_ite _ _

omit [NeZero M] in
theorem box_wt_sum (e : Link M) : ∑ k, (boxPathBlocking M).wt e k = 1 := by
  show ∑ _k : Fin 16, (1 : ℝ) / 16 = 1
  rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  norm_num

omit [NeZero M] in
theorem qsum_other (hM : 2 ≤ M) {y : Site M} {μ : Fin 4} {B : Fin 4 → ℤ} (hy : ιS M y = ofOff B)
    (h : ∀ k : Fin 16, SepOff (Pi.single 0 1) B 0 (linksOff 0 (boxSteps k μ))) :
    qsum (boxPathBlocking M) (UBox M) (y, μ) = 1 :=
  qsum_eq_one _ (fun k => pathProd_UBox_of_notMem M _ (fBox_notMem M hM hy k (h k))) (box_wt_sum M _)

omit [NeZero M] in
theorem qsum_box_one (e : Link M) : qsum (boxPathBlocking M) 1 e = 1 :=
  qsum_eq_one _ (fun _ => pathProd_const_one _) (box_wt_sum M e)

/-- **Non-vacuity of `Y` for the connected box blocking** (`M ≥ 2`, every real `β` in the
normalisation of Part VI, every `V₀`): the coarse space of the box path average contains the
nonzero vector `G − μ_c(G)`, `G = Re tr V_p` for the coarse plaquette `p` at the origin in the
`(0, 1)` plane. `G ∘ c` is continuous on the open set where the four weighted sums `Q_ē` of `p`
are nonzero; it equals `2` at `U = I`, and `(7/4)/√(25/32) ≠ 2` at the configuration with the
right-angle rotation on the fine link `(e₀, 0)` and `I` elsewhere (that link lies on the box paths
`ε = 0` and `ε = e₀` of the coarse link `(0, 0)` and on no box path of the other three links of
`p`). -/
theorem boxY_ne_zero (hM : 2 ≤ M) (β : ℝ) (V0 : SU2) :
    ∃ g ∈ aeY (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
      (avgCoarseMap (boxPathBlocking M) (plaqOf (n := 2 * M)) (β / 2) V0 (hnull_box M hM)),
      g ≠ 0 := by
  set pb := boxPathBlocking M
  have hG := memLp_plaqObs M (aeLaw (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
    (avgCoarseMap pb (plaqOf (n := 2 * M)) (β / 2) V0 (hnull_box M hM)))
  refine ⟨_, centred_mem_cgL2 _ (Gauge (Site M) SU2) hG (plaqObs_smul M), fun h0 => ?_⟩
  have hae := ae_eq_const_of_centred_eq_zero _ hG h0
  have hae1 := (ae_map_iff (measurable_avgMap pb V0).aemeasurable
    (measurableSet_eq_fun (measurable_plaqObs M) measurable_const)).1 hae
  have hae2 := (absolutelyContinuous_tilted
    (integrable_exp_wilsonExp (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2)).ae_le hae1
  let l1 : Link M := ((0 : Site M), (0 : Fin 4))
  let l2 : Link M := ((0 : Site M) + unitV 0, (1 : Fin 4))
  let l3 : Link M := ((0 : Site M) + unitV 1, (0 : Fin 4))
  let l4 : Link M := ((0 : Site M), (1 : Fin 4))
  let O : Set (Link (2 * M) → SU2) := nzSet pb l1 ∩ nzSet pb l2 ∩ nzSet pb l3 ∩ nzSet pb l4
  have hO : IsOpen O :=
    (((isOpen_nzSet pb l1).inter (isOpen_nzSet pb l2)).inter (isOpen_nzSet pb l3)).inter
      (isOpen_nzSet pb l4)
  have hcont : ContinuousOn (fun U => plaqObs M (avgMap pb V0 U)) O := by
    have c1 := (continuousOn_avgMap_apply pb V0 l1).mono fun U (hU : U ∈ O) => hU.1.1.1
    have c2 := (continuousOn_avgMap_apply pb V0 l2).mono fun U (hU : U ∈ O) => hU.1.1.2
    have c3 := (continuousOn_avgMap_apply pb V0 l3).mono fun U (hU : U ∈ O) => hU.1.2
    have c4 := (continuousOn_avgMap_apply pb V0 l4).mono fun U (hU : U ∈ O) => hU.2
    exact continuous_reTr.comp_continuousOn (((c1.mul c2).mul c3.inv).mul c4.inv)
  have s2 := box_sep_plaq.2.1
  have s3 := box_sep_plaq.2.2.1
  have s4 := box_sep_plaq.2.2.2
  have q2 : qsum pb (UBox M) l2 = 1 := qsum_other M hM (ιS_unitV_eq M 0) s2
  have q3 : qsum pb (UBox M) l3 = 1 := qsum_other M hM (ιS_unitV_eq M 1) s3
  have q4 : qsum pb (UBox M) l4 = 1 := qsum_other M hM (ιS_zero_eq M) s4
  have q1 : qsum pb (UBox M) l1 = qBox :=
    qsum_l1 M fun k h0 h1 => fBox_notMem M hM (ιS_zero_eq M) k (box_sep_plaq.1 k h0 h1)
  have hone : ∀ e, qsum pb 1 e = 1 := qsum_box_one M
  have h1O : (1 : Link (2 * M) → SU2) ∈ O := by
    refine ⟨⟨⟨?_, ?_⟩, ?_⟩, ?_⟩ <;> (show qsum pb 1 _ ≠ 0; rw [hone]; exact one_ne_zero)
  have h2O : UBox M ∈ O := by
    refine ⟨⟨⟨?_, ?_⟩, ?_⟩, ?_⟩
    · show qsum pb (UBox M) l1 ≠ 0
      rw [q1]
      exact qBox_ne_zero
    · show qsum pb (UBox M) l2 ≠ 0
      rw [q2]
      exact one_ne_zero
    · show qsum pb (UBox M) l3 ≠ 0
      rw [q3]
      exact one_ne_zero
    · show qsum pb (UBox M) l4 ≠ 0
      rw [q4]
      exact one_ne_zero
  have hv1 : plaqObs M (avgMap pb V0 1) = 2 := by
    have : avgMap pb V0 1 = 1 := funext fun e => avgMap_eq_one_of_qsum pb V0 (hone e)
    rw [this, plaqObs_one]
  have hv2 : plaqObs M (avgMap pb V0 (UBox M)) ≠ 2 := by
    show reTr.toFun (avgMap pb V0 (UBox M) l1 * avgMap pb V0 (UBox M) l2 *
      (avgMap pb V0 (UBox M) l3)⁻¹ * (avgMap pb V0 (UBox M) l4)⁻¹) ≠ 2
    rw [avgMap_eq_one_of_qsum pb V0 q2, avgMap_eq_one_of_qsum pb V0 q3,
      avgMap_eq_one_of_qsum pb V0 q4]
    simp only [inv_one, mul_one]
    show reTr.toFun (nrmSU2 V0 (qsum pb (UBox M) l1)) ≠ 2
    rw [q1]
    exact reTr_nrm_qBox_ne V0
  refine not_ae_const_pi_on hO hcont h1O h2O ?_ _ hae2
  show plaqObs M (avgMap pb V0 1) ≠ plaqObs M (avgMap pb V0 (UBox M))
  rw [hv1]
  exact fun h => hv2 h.symm

end CoarseNonVacuity

/-- The fine link `(e₀, 0)` lies on no box path of the coarse link `(0, 0)` other than
`ε = 0` and `ε = e₀` at `M = 1` (fine torus `(ℤ/2ℤ)⁴`). -/
theorem fBox_out_one (k : Fin 16) (h0 : k ≠ 0) (h1 : k ≠ 1) :
    fBox 1 ∉ pathLinks ((boxPathBlocking 1).path ((0 : Site 1), (0 : Fin 4)) k) := by
  have hc := count_map_modOff (ιS 1 0) (linksOff 0 (boxSteps k 0)) (Pi.single 0 1, 0)
  rw [List.count_eq_zero.2 (box_out_one 0 k h0 h1)] at hc
  rw [pathLinks_boxPathBlocking]
  have hf : fBox 1 = (ιS 1 0 + ofOff (Pi.single 0 1), (0 : Fin 4)) := by
    rw [fBox, ιS_zero, zero_add]
  rw [hf]
  exact (@List.count_eq_zero _ instBEqOfDecidableEq _ _ _).1 hc

/-- `Re tr` of the coarse link `(0, 0)`; at `M = 1` this link is a closed loop winding once around
the fine torus `(ℤ/2ℤ)⁴` in direction `0`. -/
noncomputable def linkObs (V : Link 1 → SU2) : ℝ := reTr.toFun (V ((0 : Site 1), (0 : Fin 4)))

theorem linkObs_smul (g : Gauge (Site 1) SU2) (V : Link 1 → SU2) : linkObs (g • V) = linkObs V := by
  rw [linkObs, linkObs, gauge_smul_apply]
  have h : tgt ((0 : Site 1), (0 : Fin 4)) = src ((0 : Site 1), (0 : Fin 4)) := Subsingleton.elim _ _
  rw [h]
  exact reTr.conj _ _

theorem measurable_linkObs : Measurable linkObs := reTr.meas.comp (measurable_pi_apply _)

theorem memLp_linkObs (ν : Measure (Link 1 → SU2)) [IsProbabilityMeasure ν] : MemLp linkObs 2 ν :=
  MemLp.of_bound measurable_linkObs.aestronglyMeasurable 2 (ae_of_all _ fun U => by
    rw [Real.norm_eq_abs]
    exact reTr.abs_le _)

/-- **Non-vacuity of `Y` for the connected box blocking at `M = 1`** (fine `(ℤ/2ℤ)⁴`, one coarse
site, every real `β`, every `V₀`): the coarse space contains the nonzero vector `G − μ_c(G)`,
`G = Re tr V_{(0, 0)}` (the coarse link is a closed loop, so `G` is coarse-gauge invariant). Every
box path of `(0, 0)` winds once around the fine torus in direction `0`, so `G` is the trace of a
smeared winding holonomy, not a local observable (a degenerate case). -/
theorem boxY_ne_zero_one (β : ℝ) (V0 : SU2) :
    ∃ g ∈ aeY (plaqOf (n := 2 * 1)) reTr (β / 2) haarSU2
      (avgCoarseMap (boxPathBlocking 1) (plaqOf (n := 2 * 1)) (β / 2) V0 (hnull_box_pos 1)),
      g ≠ 0 := by
  set pb := boxPathBlocking 1
  have hG := memLp_linkObs (aeLaw (plaqOf (n := 2 * 1)) reTr (β / 2) haarSU2
    (avgCoarseMap pb (plaqOf (n := 2 * 1)) (β / 2) V0 (hnull_box_pos 1)))
  refine ⟨_, centred_mem_cgL2 _ (Gauge (Site 1) SU2) hG linkObs_smul, fun h0 => ?_⟩
  have hae := ae_eq_const_of_centred_eq_zero _ hG h0
  have hae1 := (ae_map_iff (measurable_avgMap pb V0).aemeasurable
    (measurableSet_eq_fun measurable_linkObs measurable_const)).1 hae
  have hae2 := (absolutelyContinuous_tilted
    (integrable_exp_wilsonExp (plaqOf (n := 2 * 1)) reTr (β / 2) haarSU2)).ae_le hae1
  let l1 : Link 1 := ((0 : Site 1), (0 : Fin 4))
  have hcont : ContinuousOn (fun U => linkObs (avgMap pb V0 U)) (nzSet pb l1) :=
    continuous_reTr.comp_continuousOn (continuousOn_avgMap_apply pb V0 l1)
  have hone : ∀ e, qsum pb 1 e = 1 := qsum_box_one 1
  have q1 : qsum pb (UBox 1) l1 = qBox := qsum_l1 1 fBox_out_one
  have h1O : (1 : Link (2 * 1) → SU2) ∈ nzSet pb l1 := by
    show qsum pb 1 l1 ≠ 0
    rw [hone]
    exact one_ne_zero
  have h2O : UBox 1 ∈ nzSet pb l1 := by
    show qsum pb (UBox 1) l1 ≠ 0
    rw [q1]
    exact qBox_ne_zero
  have hv1 : linkObs (avgMap pb V0 1) = 2 := by
    show reTr.toFun (avgMap pb V0 1 l1) = 2
    rw [avgMap_eq_one_of_qsum pb V0 (hone l1)]
    exact reTr_one
  have hv2 : linkObs (avgMap pb V0 (UBox 1)) ≠ 2 := by
    show reTr.toFun (nrmSU2 V0 (qsum pb (UBox 1) l1)) ≠ 2
    rw [q1]
    exact reTr_nrm_qBox_ne V0
  refine not_ae_const_pi_on (isOpen_nzSet pb l1) hcont h1O h2O ?_ _ hae2
  show linkObs (avgMap pb V0 1) ≠ linkObs (avgMap pb V0 (UBox 1))
  rw [hv1]
  exact fun h => hv2 h.symm

/-- **Non-vacuity of `Y` for the connected box blocking, every `M ≥ 1`** (every real `β`, every
`V₀`): `boxY_ne_zero` for `M ≥ 2` and `boxY_ne_zero_one` for `M = 1`. -/
theorem boxY_ne_zero_pos (M : ℕ) [NeZero M] (β : ℝ) (V0 : SU2) :
    ∃ g ∈ aeY (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
      (avgCoarseMap (boxPathBlocking M) (plaqOf (n := 2 * M)) (β / 2) V0 (hnull_box_pos M)),
      g ≠ 0 := by
  rcases Nat.eq_or_lt_of_le (Nat.one_le_iff_ne_zero.2 (NeZero.ne M)) with h | h
  · subst h
    exact boxY_ne_zero_one β V0
  · exact boxY_ne_zero M h β V0

section CoarseLemmaIV

variable {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ]
  (Γ : Type*) [Group Γ] [MulAction Γ Ω] [MeasurableConstSMul Γ Ω] [SMulInvariantMeasure Γ Ω μ]
  {Ωc : Type*} [MeasurableSpace Ωc] (μc : Measure Ωc) [IsProbabilityMeasure μc]
  (Γc : Type*) [Group Γc] [MulAction Γc Ωc] [MeasurableConstSMul Γc Ωc]
  [SMulInvariantMeasure Γc Ωc μc] {c : Ω → Ωc} (hc : MeasurePreserving c μ μc)

omit [MeasurableSpace Ω] [IsProbabilityMeasure μ] [SMulInvariantMeasure Γ Ω μ] [MeasurableConstSMul Γ Ω] in
/-- **`σ(c)` is gauge stable** for an everywhere covariant `c`. -/
theorem stable_comap {φ : Γ → Γc} (hφ : ∀ γ ω, c (γ • ω) = φ γ • c ω) :
    Stable Γ (MeasurableSpace.comap c ‹MeasurableSpace Ωc›) := by
  intro γ
  rw [measurable_iff_comap_le, MeasurableSpace.comap_comp]
  have h : c ∘ (γ • · : Ω → Ω) = (φ γ • · : Ωc → Ωc) ∘ c := funext fun ω => hφ γ ω
  rw [h, ← MeasurableSpace.comap_comp]
  exact MeasurableSpace.comap_mono (measurable_const_smul (φ γ)).comap_le

/-- **Lemma IV for an everywhere covariant coarse map**: on the centred `Γ`-invariant space,
`E_μ[· | σ(c)] = Π = J J*`. -/
theorem cubeProj_comap_eq_Pi {φ : Γ → Γc} (hφ : ∀ γ ω, c (γ • ω) = φ γ • c ω)
    (hsurj : Function.Surjective φ) (u : cgL2 μ Γ) :
    cubeProj μ Γ hc.measurable.comap_le (stable_comap Γ Γc hφ) u =
      (isoProj (coarseJ μ Γ μc Γc hc hφ)).P u := by
  have hfix : ∀ z, cubeProj μ Γ hc.measurable.comap_le (stable_comap Γ Γc hφ)
      (coarseJ μ Γ μc Γc hc hφ z) = coarseJ μ Γ μc Γc hc hφ z := by
    intro z
    apply Subtype.ext
    rw [cubeProj_coe, coarseJ_coe]
    have : Fact (MeasurableSpace.comap c ‹MeasurableSpace Ωc› ≤ ‹MeasurableSpace Ω›) :=
      ⟨hc.measurable.comap_le⟩
    refine (Submodule.starProjection_eq_self_iff).2 ?_
    rw [mem_lpMeas_iff_aestronglyMeasurable]
    exact ⟨((z : Lp ℝ 2 μc) : Ωc → ℝ) ∘ c,
      (Lp.stronglyMeasurable (z : Lp ℝ 2 μc)).comp_measurable (comap_measurable c),
      coeFn_compL2 μ hc _⟩
  have hmem : ((cubeProj μ Γ hc.measurable.comap_le (stable_comap Γ Γc hφ) u : cgL2 μ Γ) :
      Lp ℝ 2 μ) ∈ lpMeas ℝ ℝ (MeasurableSpace.comap c ‹MeasurableSpace Ωc›) 2 μ := by
    have : Fact (MeasurableSpace.comap c ‹MeasurableSpace Ωc› ≤ ‹MeasurableSpace Ω›) :=
      ⟨hc.measurable.comap_le⟩
    exact Submodule.starProjection_apply_mem _ _
  obtain ⟨y, hy⟩ := ProductEndpoint.exists_coarseJ_eq μ Γ μc Γc hc hφ hsurj hmem
  have hadj : isoAdj (coarseJ μ Γ μc Γc hc hφ) u = y := by
    refine ext_inner_left ℝ fun z => ?_
    rw [← inner_isoAdj, ← hfix z,
      (cubeProj_isSymmetric μ Γ hc.measurable.comap_le (stable_comap Γ Γc hφ))
        (coarseJ μ Γ μc Γc hc hφ z) u, ← hy, LinearIsometry.inner_map_map]
  rw [isoProj_apply, hadj, hy]

end CoarseLemmaIV

section Completion

variable {S E Sc Ec ι : Type*} [OrientedGraph S E] [OrientedGraph Sc Ec] [Fintype ι]
  (pb : PathBlocking S E Sc Ec ι)

theorem qsum_smul_eq_zero_iff (g : Gauge S SU2) (U : E → SU2) (e : Ec) :
    qsum pb (g • U) e = 0 ↔ qsum pb U e = 0 := by
  rw [qsum_smul]
  constructor
  · intro h
    have h2 := congrArg (fun A => (((g (pb.emb (src e)))⁻¹ : SU2) : Matrix (Fin 2) (Fin 2) ℂ) * A *
      ((g (pb.emb (tgt e)) : SU2) : Matrix (Fin 2) (Fin 2) ℂ)) h
    simp only [Matrix.mul_zero, Matrix.zero_mul] at h2
    rw [← h2, ← Matrix.mul_assoc, ← Matrix.mul_assoc, ← coe_mul, inv_mul_cancel, Matrix.mul_assoc,
      ← coe_mul, inv_mul_cancel]
    simp
  · intro h
    rw [h, Matrix.mul_zero, Matrix.zero_mul]

open Classical in
/-- **The covariant completion of the normalised path average**: `Q_ē / √det Q_ē` where
`Q_ē ≠ 0`, and the holonomy of the path `i₀` of `ē` where `Q_ē = 0`. -/
noncomputable def avgMapC (V0 : SU2) (i0 : ι) (U : E → SU2) : Ec → SU2 := fun e =>
  if qsum pb U e = 0 then pathProd (pb.path e i0) U else avgMap pb V0 U e

theorem avgMapC_smul (V0 : SU2) (i0 : ι) (g : Gauge S SU2) (U : E → SU2) :
    avgMapC pb V0 i0 (g • U) = pbGauge pb g • avgMapC pb V0 i0 U := by
  classical
  funext e
  rw [gauge_smul_apply]
  by_cases hQ : qsum pb U e = 0
  · have hQ' : qsum pb (g • U) e = 0 := (qsum_smul_eq_zero_iff pb g U e).2 hQ
    simp only [avgMapC, hQ, hQ', if_true]
    rw [pathProd_smul]
    rfl
  · have hQ' : qsum pb (g • U) e ≠ 0 := fun h => hQ ((qsum_smul_eq_zero_iff pb g U e).1 h)
    simp only [avgMapC, hQ, hQ', if_false]
    show nrmSU2 V0 (qsum pb (g • U) e) = _
    rw [qsum_smul, nrmSU2_conj V0 (qsum_mem pb U e) hQ]
    rfl

theorem avgMapC_eq_of_notMem (V0 : SU2) (i0 : ι) {U : E → SU2} (hU : U ∉ zeroSet pb) :
    avgMapC pb V0 i0 U = avgMap pb V0 U := by
  classical
  funext e
  have hQ : qsum pb U e ≠ 0 := fun h => hU ⟨e, h⟩
  simp only [avgMapC, hQ, if_false]

variable [Fintype E]

theorem measurable_avgMapC (V0 : SU2) (i0 : ι) :
    Measurable (avgMapC pb V0 i0 : (E → SU2) → Ec → SU2) := by
  classical
  refine measurable_pi_lambda _ fun e => ?_
  exact Measurable.ite (isClosed_eq (continuous_qsum pb e) continuous_const).measurableSet
    (continuous_pathProd _).measurable ((measurable_pi_apply e).comp (measurable_avgMap pb V0))

/-- The covariant completion as an everywhere covariant coarse map. -/
noncomputable def avgCoarseMapC (V0 : SU2) (i0 : ι) : CoarseMap S E Sc Ec SU2 where
  toFun := avgMapC pb V0 i0
  meas := measurable_avgMapC pb V0 i0
  φ := pbGauge pb
  surj := pbGauge_surjective pb
  equiv := avgMapC_smul pb V0 i0

end Completion

section BoxLemmaIV

variable (M : ℕ) [NeZero M] (β : ℝ) (V0 : SU2)

/-- **The covariant completion of the box map equals the box map almost everywhere** (every
`M ≥ 1`, every real `β`, every `V₀`; `i₀` the straight path `ε = 0`): the zero set is null. -/
theorem avgMapC_box_ae :
    ∀ᵐ U ∂(su2Wilson M β), avgMapC (boxPathBlocking M) V0 0 U = avgMap (boxPathBlocking M) V0 U := by
  have h : su2Wilson M β (zeroSet (boxPathBlocking M)) = 0 :=
    tilted_absolutelyContinuous _ _ (hnull_box_pos M)
  filter_upwards [measure_eq_zero_iff_ae_notMem.1 h] with U hU
  exact avgMapC_eq_of_notMem _ V0 0 hU

/-- **Lemma IV for the covariant completion of the box map** (every `M ≥ 1`, every real `β`, every
`V₀`): with `c'` the covariant completion (`avgCoarseMapC`, equal to the box path average
`μ`-almost everywhere by `avgMapC_box_ae`), `E_μ[u | σ(c')] = Π' u` for every `u ∈ H`, where
`Π' = J' J'*` and `J' g = g ∘ c'` on the coarse space of the law `c'_* μ`. -/
theorem box_condExpC_eq_Pi (u : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2) :
    cubeProj (su2Wilson M β) (Gauge (Site (2 * M)) SU2)
        (measurePreserving_mapLaw (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
          (avgCoarseMapC (boxPathBlocking M) V0 0)).measurable.comap_le
        (stable_comap (Gauge (Site (2 * M)) SU2) (Gauge (Site M) SU2)
          (avgCoarseMapC (boxPathBlocking M) V0 0).equiv) u =
      (isoProj (mapJ (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
        (avgCoarseMapC (boxPathBlocking M) V0 0))).P u :=
  cubeProj_comap_eq_Pi (su2Wilson M β) (Gauge (Site (2 * M)) SU2)
    (mapLaw (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (avgCoarseMapC (boxPathBlocking M) V0 0))
    (Gauge (Site M) SU2)
    (measurePreserving_mapLaw (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
      (avgCoarseMapC (boxPathBlocking M) V0 0))
    (avgCoarseMapC (boxPathBlocking M) V0 0).equiv (avgCoarseMapC (boxPathBlocking M) V0 0).surj u

end BoxLemmaIV

section Transfer

variable {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ]
  (Γ : Type*) [Group Γ] [MulAction Γ Ω] [MeasurableConstSMul Γ Ω] [SMulInvariantMeasure Γ Ω μ]
  {Ωc : Type*} [MeasurableSpace Ωc] (μc : Measure Ωc) [IsProbabilityMeasure μc]
  (Γc : Type*) [Group Γc] [MulAction Γc Ωc] [MeasurableConstSMul Γc Ωc]
  [SMulInvariantMeasure Γc Ωc μc]

/-- **Two coarse maps that agree almost everywhere have the same coarse embedding** `J`. -/
theorem coarseJae_eq_coarseJ_of_ae {c c' : Ω → Ωc} (hc : MeasurePreserving c μ μc)
    (hc' : MeasurePreserving c' μ μc) (hcc : c =ᵐ[μ] c') {φ : Γ → Γc}
    (hφ : ∀ γ, ∀ᵐ ω ∂μ, c (γ • ω) = φ γ • c ω) (hφ' : ∀ γ ω, c' (γ • ω) = φ γ • c' ω) :
    coarseJae μ Γ μc Γc hc hφ = coarseJ μ Γ μc Γc hc' hφ' := by
  refine LinearIsometry.ext fun y => Subtype.ext ?_
  rw [coarseJae_coe, coarseJ_coe]
  refine Lp.ext ((coeFn_compL2 μ hc _).trans (Filter.EventuallyEq.trans ?_
    (coeFn_compL2 μ hc' _).symm))
  filter_upwards [hcc] with ω hω
  simp only [Function.comp, hω]

omit [IsProbabilityMeasure μ] in
/-- **`σ(c)` and `σ(c')` have the same `L²` functions** when `c = c'` almost everywhere. -/
theorem lpMeas_comap_eq {c c' : Ω → Ωc} (hcc : c =ᵐ[μ] c') :
    lpMeas ℝ ℝ (MeasurableSpace.comap c ‹MeasurableSpace Ωc›) 2 μ =
      lpMeas ℝ ℝ (MeasurableSpace.comap c' ‹MeasurableSpace Ωc›) 2 μ := by
  have key : ∀ {c c' : Ω → Ωc}, c =ᵐ[μ] c' → ∀ f : Lp ℝ 2 μ,
      f ∈ lpMeas ℝ ℝ (MeasurableSpace.comap c ‹MeasurableSpace Ωc›) 2 μ →
      f ∈ lpMeas ℝ ℝ (MeasurableSpace.comap c' ‹MeasurableSpace Ωc›) 2 μ := by
    intro c c' hcc f hf
    rw [mem_lpMeas_iff_aestronglyMeasurable] at hf ⊢
    obtain ⟨g, hg, hfg⟩ := hf
    obtain ⟨k, hk, hkg⟩ := hg.exists_eq_measurable_comp
    refine ⟨k ∘ c', hk.comp_measurable (comap_measurable c'), hfg.trans ?_⟩
    rw [hkg]
    filter_upwards [hcc] with ω hω
    simp only [Function.comp, hω]
  ext f
  exact ⟨key hcc f, key hcc.symm f⟩

end Transfer

section BoxLemmaIVTransfer

variable (M : ℕ) [NeZero M] (β : ℝ) (V0 : SU2)

/-- **Lemma IV for the connected box blocking** (every `M ≥ 1`, every real `β`, every `V₀`): for the
box path average `c` itself (Part XXIII's map, gauge covariant only almost everywhere),
`E_μ[u | σ(c)] = Π u` for every `u ∈ H`, with `Π = J J*` built from Part XIX's `aeJ`. Proof: the
covariant completion `c'` equals `c` almost everywhere, so `J = J'` and `σ(c)`, `σ(c')` have the
same `L²` functions; then `cubeProj_comap_eq_Pi` for `c'`. -/
theorem box_condExp_eq_Pi (u : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2) :
    condL2 (su2Wilson M β) (measurable_avgMap (boxPathBlocking M) V0).comap_le
        (u : Lp ℝ 2 (su2Wilson M β)) =
      (((isoProj (aeJ (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
        (avgCoarseMap (boxPathBlocking M) (plaqOf (n := 2 * M)) (β / 2) V0
          (hnull_box_pos M)))).P u : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2) :
        Lp ℝ 2 (su2Wilson M β)) := by
  have hcc : avgMap (boxPathBlocking M) V0 =ᵐ[su2Wilson M β] avgMapC (boxPathBlocking M) V0 0 :=
    (avgMapC_box_ae M β V0).mono fun U hU => hU.symm
  have hc := measurePreserving_aeLaw (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
    (avgCoarseMap (boxPathBlocking M) (plaqOf (n := 2 * M)) (β / 2) V0 (hnull_box_pos M))
  have hc' : MeasurePreserving (avgMapC (boxPathBlocking M) V0 0) (su2Wilson M β)
      (aeLaw (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
        (avgCoarseMap (boxPathBlocking M) (plaqOf (n := 2 * M)) (β / 2) V0 (hnull_box_pos M))) :=
    ⟨measurable_avgMapC _ V0 0, (Measure.map_congr hcc).symm⟩
  have hJ := coarseJae_eq_coarseJ_of_ae (su2Wilson M β) (Gauge (Site (2 * M)) SU2)
    (aeLaw (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
      (avgCoarseMap (boxPathBlocking M) (plaqOf (n := 2 * M)) (β / 2) V0 (hnull_box_pos M)))
    (Gauge (Site M) SU2) hc hc' hcc (φ := pbGauge (boxPathBlocking M))
    (avgCoarseMap (boxPathBlocking M) (plaqOf (n := 2 * M)) (β / 2) V0 (hnull_box_pos M)).ae_equiv
    (avgMapC_smul (boxPathBlocking M) V0 0)
  have hIV := cubeProj_comap_eq_Pi (su2Wilson M β) (Gauge (Site (2 * M)) SU2)
    (aeLaw (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
      (avgCoarseMap (boxPathBlocking M) (plaqOf (n := 2 * M)) (β / 2) V0 (hnull_box_pos M)))
    (Gauge (Site M) SU2) hc' (avgMapC_smul (boxPathBlocking M) V0 0)
    (pbGauge_surjective (boxPathBlocking M)) u
  have hIV' := congrArg Subtype.val hIV
  rw [cubeProj_coe] at hIV'
  show _ = (((isoProj (coarseJae (su2Wilson M β) (Gauge (Site (2 * M)) SU2)
    (aeLaw (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
      (avgCoarseMap (boxPathBlocking M) (plaqOf (n := 2 * M)) (β / 2) V0 (hnull_box_pos M)))
    (Gauge (Site M) SU2) hc (φ := pbGauge (boxPathBlocking M))
    (avgCoarseMap (boxPathBlocking M) (plaqOf (n := 2 * M)) (β / 2) V0 (hnull_box_pos M)).ae_equiv)).P
      u : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2) : Lp ℝ 2 (su2Wilson M β))
  rw [hJ, ← hIV']
  have hL := lpMeas_comap_eq (su2Wilson M β) hcc
  have : Fact (MeasurableSpace.comap (avgMap (boxPathBlocking M) V0)
      (inferInstance : MeasurableSpace (Link M → SU2)) ≤
      (inferInstance : MeasurableSpace (Link (2 * M) → SU2))) :=
    ⟨(measurable_avgMap (boxPathBlocking M) V0).comap_le⟩
  have : Fact (MeasurableSpace.comap (avgMapC (boxPathBlocking M) V0 0)
      (inferInstance : MeasurableSpace (Link M → SU2)) ≤
      (inferInstance : MeasurableSpace (Link (2 * M) → SU2))) :=
    ⟨(measurable_avgMapC (boxPathBlocking M) V0 0).comap_le⟩
  have key : ∀ (K K' : Submodule ℝ (Lp ℝ 2 (su2Wilson M β))) [K.HasOrthogonalProjection]
      [K'.HasOrthogonalProjection], K = K' →
      K.starProjection (u : Lp ℝ 2 (su2Wilson M β)) = K'.starProjection u := by
    intro K K' _ _ hK
    subst hK
    rfl
  exact key _ _ hL

end BoxLemmaIVTransfer

section BoxLemmaIVCorollaries

