section Geometry

variable (M : ℕ) [NeZero M]

/-- The second link `(e₀, 1)` of the plaquette `q0` is not a skeleton link of the straight blocking
(its source is odd in direction `0`, and it points in direction `1`). -/
theorem q0_l2_not_mem_skel : (plaqOf (q0 (2 * M))).l2 ∉ skel (straightBlocking M) := by
  rintro (⟨ē, hē⟩ | ⟨ē, hē⟩)
  · have h1 := congrArg (fun l : Link (2 * M) => l.1 0) hē
    simp only [straightBlocking, ιS, plaqOf, q0, unitV, zero_add, Pi.single_eq_same] at h1
    have h4 := congrArg (ZMod.castHom (dvd_mul_right 2 M) (ZMod 2)) h1
    rw [castHom_dbl, map_one] at h4
    exact zero_ne_one h4
  · have h2 := congrArg (fun l : Link (2 * M) => l.2) hē
    have h1 := congrArg (fun l : Link (2 * M) => l.1 0) hē
    simp only [straightBlocking, plaqOf, q0] at h2
    simp only [straightBlocking, ιS, plaqOf, q0, unitV, Pi.add_apply, zero_add,
      Pi.single_eq_same, h2] at h1
    rw [Pi.single_eq_of_ne (by decide : (0 : Fin 4) ≠ 1), add_zero] at h1
    have h4 := congrArg (ZMod.castHom (dvd_mul_right 2 M) (ZMod 2)) h1
    rw [castHom_dbl, map_one] at h4
    exact zero_ne_one h4

omit [NeZero M] in
theorem q0_l1_ne_l2 : (plaqOf (q0 (2 * M))).l1 ≠ (plaqOf (q0 (2 * M))).l2 := fun h => by
  have := congrArg Prod.snd h
  simp [plaqOf, q0] at this

omit [NeZero M] in
theorem q0_l3_ne_l2 : (plaqOf (q0 (2 * M))).l3 ≠ (plaqOf (q0 (2 * M))).l2 := fun h => by
  have := congrArg Prod.snd h
  simp [plaqOf, q0] at this

theorem q0_l4_ne_l2 : (plaqOf (q0 (2 * M))).l4 ≠ (plaqOf (q0 (2 * M))).l2 := fun h => by
  have := congrArg (fun l : Link (2 * M) => l.1 0) h
  simp [plaqOf, q0, unitV] at this

