/-- Lemma IV for the box map with Mathlib's conditional expectation: `μ[u | σ(c)] = Π u` `μ`-a.e.,
for `u ∈ H` (every `M ≥ 1`, every real `β`, every `V₀`). -/
theorem box_condExp_ae_eq_Pi (u : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2) :
    (su2Wilson M β)[((u : Lp ℝ 2 (su2Wilson M β)) : (Link (2 * M) → SU2) → ℝ) |
        MeasurableSpace.comap (avgMap (boxPathBlocking M) V0) inferInstance] =ᵐ[su2Wilson M β]
      ((((isoProj (aeJ (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
        (avgCoarseMap (boxPathBlocking M) (plaqOf (n := 2 * M)) (β / 2) V0
          (hnull_box_pos M)))).P u : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2) :
        Lp ℝ 2 (su2Wilson M β)) : (Link (2 * M) → SU2) → ℝ) := by
  rw [← box_condExp_eq_Pi M β V0 u]
  exact (condL2_ae_eq_condExp _ (measurable_avgMap (boxPathBlocking M) V0).comap_le _).symm

/-- On `H`, `E_μ[u | σ(c)] = 0` if and only if `Π u = 0`, for the box map (every `M ≥ 1`, every
real `β`, every `V₀`). -/
theorem box_condExp_eq_zero_iff (u : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2) :
    condL2 (su2Wilson M β) (measurable_avgMap (boxPathBlocking M) V0).comap_le
        (u : Lp ℝ 2 (su2Wilson M β)) = 0 ↔
