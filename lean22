/-! # Part XXXI. `YangMills.StrongCoupling.ContinuousVersions`: full support of the Wilson measure, continuous versions, oscillation functionals, the comparison `‖f‖ ≤ ∑ⱼ δⱼ f` and the density of continuous versions in `H` (new; uses Parts III, IV and VI) -/

/-!
# Continuous versions, oscillation functionals and density on the centred gauge-invariant space

## (a) Formal target

For the SU(2) Wilson measure `μ ∝ exp((β/2) ∑ₚ Re tr U_p) ∏ dU` on `(ℤ/2Mℤ)⁴` (every `M ≥ 1`, every
real `β`, in the normalisation `β = β_W` of Part VI's `su2Wilson`) and its centred gauge-invariant
space `H = wilsonH`: the domain of the elements of `H` with a continuous version, the oscillation
functionals `δⱼ` in the link variables, the comparison `‖f‖ ≤ ∑ⱼ δⱼ f` and the density of the domain
in `H`. These are the domain fields of Part XXIX's `SU2SingleLinkInfluence` with `K = 1`.

## (b) What is proved

* `isOpenPosMeasure_wilsonMeasure`: on any finite lattice, the Wilson measure built from a
  probability measure `h` that charges every nonempty open set charges every nonempty open set
  (the tilt by `exp` of the Wilson exponent is equivalent to the product measure); for SU(2) this
  is an instance, so two continuous functions equal `μ`-a.e. are equal (`eq_of_ae_eq_wilson`).
* For any measure on `E → G` and any subspace `K` of `L²`: `ContVer` (elements with a continuous
  version), the chosen version `verOf`, its uniqueness and linearity on `ContVer`; the oscillation
  `oscOf j f = sup_{U,s} |verOf f (update U j s) − verOf f U|` (a bounded family when `G` is
  compact, `bddAbove_oscOf`), nonnegative, subadditive and
  positively homogeneous on `ContVer`, zero exactly when `verOf f` does not depend on `U_j`; and,
  when `G` is compact, `E` finite, `μ` a probability measure and `K` centred,
  `|verOf f| ≤ ∑ⱼ oscOf j f` and `‖f‖ ≤ ∑ⱼ oscOf j f`
  (change one link at a time between a point where `verOf f ≤ 0` and one where `verOf f ≥ 0`).
* For SU(2): `contVer`, `ver`, `linkOsc`, the closure properties (`zero_mem_contVer`,
  `add_mem_contVer`, `smul_mem_contVer`, `linkOsc_add`, `linkOsc_smul`), the comparison
  `norm_le_sum_linkOsc` (`K = 1`) and the density `dense_contVer`, the SU(2) case of `dense_ContVer`
  (any compact topological group `G`, any gauge-invariant weakly regular probability measure on
  `E → G`, the gauge average taken against a right-invariant probability measure on `S → G`):
  continuous functions are dense in `L²(μ)`, and an element of `H` orthogonal to `contVer` is
  orthogonal to every continuous function, because the gauge average `∫ φ(k • U) dk` of a
  continuous `φ` is continuous and gauge invariant and has the same inner product with every
  gauge-invariant element (`integral_gaugeAvg_mul`, Fubini).

## (c) What remains open

Nothing here is an estimate. Whether the heat-bath projections map `contVer` into itself, and the
influence bounds of `SU2SingleLinkInfluence`, need the conditional law of a link and are not proved
in this part (they come from the heat-bath kernel part and the single-link part).

## (d) Axioms and checks

The module axiom audit covers every headline; only `propext`, `Classical.choice` and `Quot.sound`
appear, and the source uses no `sorry`, `admit`, `axiom`, `native_decide`, `implemented_by` or
`set_option`.

## (e) Scope

Finite volume, every `M ≥ 1` and every real `β` (each statement at fixed `M` and `β`). This is
functional-analytic bookkeeping for the heat-bath (Gibbs-sampler) dynamics. It contains no
estimate, so nothing here bounds a gap, and it is not a proof of a mass gap.
-/

namespace YangMills.StrongCoupling.ContinuousVersions

open MeasureTheory
open scoped InnerProductSpace
open YangMills.StrongCoupling.CondExpInputs YangMills.StrongCoupling.WilsonCube
  YangMills.StrongCoupling.WilsonSU2
open OrientedGraph

/-! ## Full support of the Wilson measure -/

/-- **The Wilson measure charges every nonempty open set** (any finite lattice, any `κ`, any
probability measure `h` on `G` that charges every nonempty open set): the product measure does,
and it is absolutely continuous with respect to its exponential tilt. -/
theorem isOpenPosMeasure_wilsonMeasure {S E G : Type*} [OrientedGraph S E] [Fintype E] [Group G]
    [TopologicalSpace G] [MeasurableSpace G] [MeasurableMul₂ G] [MeasurableInv G]
    {Pl : Type*} [Fintype Pl] (plaq : Pl → Plaq S E) (χ : ClassFn G) (κ : ℝ)
    (h : Measure G) [IsProbabilityMeasure h] [h.IsOpenPosMeasure] :
    (wilsonMeasure plaq χ κ h).IsOpenPosMeasure :=
  (absolutelyContinuous_tilted (integrable_exp_wilsonExp plaq χ κ h)).isOpenPosMeasure

/-! ## Continuous versions in a subspace of `L²` -/

section Generic

variable {E G : Type*} [TopologicalSpace G] [MeasurableSpace G]
  (μ : Measure (E → G)) (K : Submodule ℝ (Lp ℝ 2 μ))

/-- The elements of `K` with a continuous version. -/
def ContVer : Set K :=
  {f | ∃ g : (E → G) → ℝ, Continuous g ∧ ((f : Lp ℝ 2 μ) : (E → G) → ℝ) =ᵐ[μ] g}

open Classical in
/-- A continuous version of `f ∈ ContVer μ K` (chosen), and `0` off `ContVer μ K`. -/
noncomputable def verOf (f : K) : (E → G) → ℝ :=
  if hf : f ∈ ContVer μ K then Classical.choose hf else 0

/-- The oscillation of the version of `f` in the link variable `U_j`:
`sup_{U, s} |verOf f (update U j s) − verOf f U|`. -/
noncomputable def oscOf [DecidableEq E] (j : E) (f : K) : ℝ :=
  ⨆ p : (E → G) × G, |verOf μ K f (Function.update p.1 j p.2) - verOf μ K f p.1|

variable {μ K}

theorem verOf_spec {f : K} (hf : f ∈ ContVer μ K) :
    Continuous (verOf μ K f) ∧ ((f : Lp ℝ 2 μ) : (E → G) → ℝ) =ᵐ[μ] verOf μ K f := by
  rw [verOf, dif_pos hf]
  exact Classical.choose_spec hf

theorem verOf_of_not_mem {f : K} (hf : f ∉ ContVer μ K) : verOf μ K f = 0 := by
  rw [verOf, dif_neg hf]

theorem continuous_verOf (f : K) : Continuous (verOf μ K f) := by
  by_cases hf : f ∈ ContVer μ K
  · exact (verOf_spec hf).1
  · rw [verOf_of_not_mem hf]
    exact continuous_zero

theorem ContVer.zero_mem : (0 : K) ∈ ContVer μ K :=
  ⟨0, continuous_zero, Lp.coeFn_zero ℝ 2 μ⟩

theorem ContVer.add_mem : ∀ f ∈ ContVer μ K, ∀ g ∈ ContVer μ K, f + g ∈ ContVer μ K := by
  rintro f ⟨a, ha, hfa⟩ g ⟨b, hb, hgb⟩
  exact ⟨a + b, ha.add hb, (Lp.coeFn_add (f : Lp ℝ 2 μ) (g : Lp ℝ 2 μ)).trans (hfa.add hgb)⟩

theorem ContVer.sub_mem : ∀ f ∈ ContVer μ K, ∀ g ∈ ContVer μ K, f - g ∈ ContVer μ K := by
  rintro f ⟨a, ha, hfa⟩ g ⟨b, hb, hgb⟩
  exact ⟨a - b, ha.sub hb, (Lp.coeFn_sub (f : Lp ℝ 2 μ) (g : Lp ℝ 2 μ)).trans (hfa.sub hgb)⟩

theorem ContVer.smul_mem : ∀ (a : ℝ), ∀ f ∈ ContVer μ K, a • f ∈ ContVer μ K := by
  rintro a f ⟨g, hg, hfg⟩
  exact ⟨a • g, hg.const_smul a, (Lp.coeFn_smul a (f : Lp ℝ 2 μ)).trans (hfg.const_smul a)⟩

/-- **Uniqueness of the continuous version**: a continuous `g` with `f = g` a.e. is `verOf f`. -/
theorem verOf_eq_of_ae_eq [μ.IsOpenPosMeasure] {f : K} {g : (E → G) → ℝ} (hg : Continuous g)
    (hfg : ((f : Lp ℝ 2 μ) : (E → G) → ℝ) =ᵐ[μ] g) : verOf μ K f = g :=
  ((continuous_verOf f).ae_eq_iff_eq μ hg).1 ((verOf_spec ⟨g, hg, hfg⟩).2.symm.trans hfg)

theorem verOf_add [μ.IsOpenPosMeasure] {f g : K} (hf : f ∈ ContVer μ K) (hg : g ∈ ContVer μ K) :
    verOf μ K (f + g) = verOf μ K f + verOf μ K g :=
  verOf_eq_of_ae_eq ((continuous_verOf f).add (continuous_verOf g))
    ((Lp.coeFn_add (f : Lp ℝ 2 μ) (g : Lp ℝ 2 μ)).trans ((verOf_spec hf).2.add (verOf_spec hg).2))

theorem verOf_smul [μ.IsOpenPosMeasure] (a : ℝ) {f : K} (hf : f ∈ ContVer μ K) :
    verOf μ K (a • f) = a • verOf μ K f :=
  verOf_eq_of_ae_eq ((continuous_verOf f).const_smul a)
    ((Lp.coeFn_smul a (f : Lp ℝ 2 μ)).trans ((verOf_spec hf).2.const_smul a))

/-! ### Oscillations -/

variable [DecidableEq E]

theorem oscOf_nonneg (j : E) (f : K) : 0 ≤ oscOf μ K j f :=
  Real.iSup_nonneg fun _ => abs_nonneg _

variable [CompactSpace G]

theorem bddAbove_oscOf (j : E) (f : K) :
    BddAbove (Set.range fun p : (E → G) × G =>
      |verOf μ K f (Function.update p.1 j p.2) - verOf μ K f p.1|) := by
  obtain ⟨C, hC⟩ := isCompact_univ.exists_bound_of_continuousOn (continuous_verOf f).continuousOn
  refine ⟨C + C, ?_⟩
  rintro _ ⟨p, rfl⟩
  have h1 := hC (Function.update p.1 j p.2) (Set.mem_univ _)
  have h2 := hC p.1 (Set.mem_univ _)
  rw [Real.norm_eq_abs] at h1 h2
  refine (abs_sub_le _ 0 _).trans ?_
  rw [sub_zero, zero_sub, abs_neg]
  exact add_le_add h1 h2

theorem abs_sub_le_oscOf (j : E) (f : K) (U : E → G) (s : G) :
    |verOf μ K f (Function.update U j s) - verOf μ K f U| ≤ oscOf μ K j f :=
  le_ciSup (f := fun p : (E → G) × G =>
    |verOf μ K f (Function.update p.1 j p.2) - verOf μ K f p.1|) (bddAbove_oscOf j f) (U, s)

variable [Nonempty G]

omit [CompactSpace G] in
theorem oscOf_le (j : E) (f : K) {c : ℝ}
    (h : ∀ (U : E → G) (s : G), |verOf μ K f (Function.update U j s) - verOf μ K f U| ≤ c) :
    oscOf μ K j f ≤ c :=
  ciSup_le fun p => h p.1 p.2

theorem oscOf_eq_zero_iff (j : E) (f : K) :
    oscOf μ K j f = 0 ↔
      ∀ (U : E → G) (s : G), verOf μ K f (Function.update U j s) = verOf μ K f U := by
  constructor
  · intro h U s
    have h1 := abs_sub_le_oscOf j f U s
    rw [h] at h1
    exact sub_eq_zero.1 (abs_nonpos_iff.1 h1)
  · intro h
    refine le_antisymm (oscOf_le j f fun U s => ?_) (oscOf_nonneg j f)
    simp only [h U s, sub_self, abs_zero, le_refl]

theorem oscOf_of_not_mem (j : E) {f : K} (hf : f ∉ ContVer μ K) : oscOf μ K j f = 0 :=
  (oscOf_eq_zero_iff j f).2 fun U s => by simp only [verOf_of_not_mem hf, Pi.zero_apply]

theorem oscOf_add [μ.IsOpenPosMeasure] (j : E) : ∀ f ∈ ContVer μ K, ∀ g ∈ ContVer μ K,
    oscOf μ K j (f + g) ≤ oscOf μ K j f + oscOf μ K j g := by
  intro f hf g hg
  refine oscOf_le j _ fun U s => ?_
  rw [verOf_add hf hg, Pi.add_apply, Pi.add_apply]
  have e : verOf μ K f (Function.update U j s) + verOf μ K g (Function.update U j s) -
      (verOf μ K f U + verOf μ K g U) =
      (verOf μ K f (Function.update U j s) - verOf μ K f U) +
      (verOf μ K g (Function.update U j s) - verOf μ K g U) := by ring
  rw [e]
  exact (abs_add_le _ _).trans (add_le_add (abs_sub_le_oscOf j f U s) (abs_sub_le_oscOf j g U s))

theorem oscOf_smul [μ.IsOpenPosMeasure] (j : E) (a : ℝ) (ha : 0 ≤ a) : ∀ f ∈ ContVer μ K,
    oscOf μ K j (a • f) ≤ a * oscOf μ K j f := by
  intro f hf
  refine oscOf_le j _ fun U s => ?_
  rw [verOf_smul a hf, Pi.smul_apply, Pi.smul_apply, smul_eq_mul, smul_eq_mul, ← mul_sub,
    abs_mul, abs_of_nonneg ha]
  exact mul_le_mul_of_nonneg_left (abs_sub_le_oscOf j f U s) ha

/-! ### Comparison with the oscillations -/

omit [TopologicalSpace G] [MeasurableSpace G] [CompactSpace G] [Nonempty G] in
/-- **Changing one link at a time inside a finite set `T`**: if each single-link change at a link of
`T` moves `v` by at most `d j`, and `V` agrees with `U` off `T`, then `|v V − v U| ≤ ∑_{j ∈ T} d j`. -/
theorem abs_sub_le_sum_of_update_on {v : (E → G) → ℝ} {d : E → ℝ} (T : Finset E)
    (hd : ∀ j ∈ T, ∀ (U : E → G) (s : G), |v (Function.update U j s) - v U| ≤ d j)
    (U V : E → G) (hUV : ∀ i ∉ T, V i = U i) : |v V - v U| ≤ ∑ j ∈ T, d j := by
  have key : ∀ T' : Finset E, T' ⊆ T →
      |v (fun e => if e ∈ T' then V e else U e) - v U| ≤ ∑ j ∈ T', d j := by
    intro T'
    induction T' using Finset.induction_on with
    | empty => intro _; simp
    | insert a T' ha ih =>
      intro hsub
      have e1 : (fun e => if e ∈ insert a T' then V e else U e) =
          Function.update (fun e => if e ∈ T' then V e else U e) a (V a) := by
        funext e
        by_cases hea : e = a
        · subst hea
          simp
        · rw [Function.update_of_ne hea]
          simp [Finset.mem_insert, hea]
      rw [e1, Finset.sum_insert ha]
      exact (abs_sub_le _ _ _).trans (add_le_add (hd a (hsub (Finset.mem_insert_self a T')) _ _)
        (ih ((Finset.subset_insert a T').trans hsub)))
  have hV : (fun e => if e ∈ T then V e else U e) = V := funext fun e => by
    by_cases he : e ∈ T
    · rw [if_pos he]
    · rw [if_neg he, hUV e he]
  have h := key T (Finset.Subset.refl T)
  rwa [hV] at h

omit [TopologicalSpace G] [MeasurableSpace G] [CompactSpace G] [Nonempty G] in
/-- **Changing one link at a time**: if each single-link change moves `v` by at most `d j`, then
`|v V − v U| ≤ ∑ⱼ d j`. -/
theorem abs_sub_le_sum_of_update [Fintype E] {v : (E → G) → ℝ} {d : E → ℝ}
    (hd : ∀ j (U : E → G) (s : G), |v (Function.update U j s) - v U| ≤ d j) (U V : E → G) :
    |v V - v U| ≤ ∑ j, d j :=
  abs_sub_le_sum_of_update_on Finset.univ (fun j _ => hd j) U V
    (fun i hi => absurd (Finset.mem_univ i) hi)

omit [DecidableEq E] [CompactSpace G] in
/-- **`‖f‖₂ ≤ sup |verOf f|`** (`μ` a probability measure). -/
theorem norm_le_of_abs_verOf_le [IsProbabilityMeasure μ] {f : K} (hf : f ∈ ContVer μ K) {C : ℝ}
    (hC : ∀ U, |verOf μ K f U| ≤ C) : ‖f‖ ≤ C := by
  have hC0 : 0 ≤ C := (abs_nonneg _).trans (hC (Classical.arbitrary _))
  have h := Lp.norm_le_of_ae_bound (f := (f : Lp ℝ 2 μ)) hC0 (by
    filter_upwards [(verOf_spec hf).2] with ω hω
    rw [hω, Real.norm_eq_abs]
    exact hC ω)
  have h1 : measureUnivNNReal μ = 1 := by simp [measureUnivNNReal]
  rw [h1, NNReal.coe_one, Real.one_rpow, one_mul] at h
  exact h

/-- **The version is controlled by the oscillations** (`G` compact, `K` centred, `μ` a
probability measure): `|verOf f U| ≤ ∑ⱼ oscOf j f` for `f ∈ ContVer μ K`. -/
theorem abs_verOf_le_sum [Fintype E] [IsProbabilityMeasure μ]
    (hK : ∀ f : K, ∫ ω, (f : Lp ℝ 2 μ) ω ∂μ = 0) {f : K} (hf : f ∈ ContVer μ K) (U : E → G) :
    |verOf μ K f U| ≤ ∑ j, oscOf μ K j f := by
  have hc := continuous_verOf (μ := μ) f
  have hint : ∫ ω, verOf μ K f ω ∂μ = 0 := by
    rw [← integral_congr_ae (verOf_spec hf).2]
    exact hK f
  have hI : Integrable (verOf μ K f) μ :=
    ((Lp.memLp (f : Lp ℝ 2 μ)).integrable one_le_two).congr (verOf_spec hf).2
  obtain ⟨V₀, -, h₀⟩ := isCompact_univ.exists_isMinOn Set.univ_nonempty hc.continuousOn
  obtain ⟨V₁, -, h₁⟩ := isCompact_univ.exists_isMaxOn Set.univ_nonempty hc.continuousOn
  have hmin : ∀ W, verOf μ K f V₀ ≤ verOf μ K f W := fun W => isMinOn_iff.1 h₀ W (Set.mem_univ W)
  have hmax : ∀ W, verOf μ K f W ≤ verOf μ K f V₁ := fun W => isMaxOn_iff.1 h₁ W (Set.mem_univ W)
  have hle0 : verOf μ K f V₀ ≤ 0 := by
    have h := integral_mono (integrable_const (verOf μ K f V₀)) hI hmin
    rw [hint] at h
    simpa using h
  have hge0 : 0 ≤ verOf μ K f V₁ := by
    have h := integral_mono hI (integrable_const (verOf μ K f V₁)) hmax
    rw [hint] at h
    simpa using h
  have htel := abs_sub_le_sum_of_update (abs_sub_le_oscOf (μ := μ) (K := K) · f) V₀ V₁
  have hU0 := hmin U
  have hU1 := hmax U
  refine (abs_le.2 ⟨?_, ?_⟩).trans ((le_abs_self _).trans htel) <;> linarith

/-- **Comparison with constant `1`**: `‖f‖ ≤ ∑ⱼ oscOf j f` for `f ∈ ContVer μ K` (`G` compact, `K`
centred, `μ` a probability measure), since `‖f‖₂ ≤ sup |verOf f|`. -/
theorem norm_le_sum_oscOf [Fintype E] [IsProbabilityMeasure μ]
    (hK : ∀ f : K, ∫ ω, (f : Lp ℝ 2 μ) ω ∂μ = 0) {f : K} (hf : f ∈ ContVer μ K) :
    ‖f‖ ≤ ∑ j, oscOf μ K j f :=
  norm_le_of_abs_verOf_le hf (abs_verOf_le_sum hK hf)

end Generic

/-! ## Gauge averages -/

section Gauge

variable {S E G : Type*} [OrientedGraph S E] [Group G]

/-- A function `S → G` as a gauge transformation. -/
def toGauge (k : S → G) : Gauge S G := k

/-- A gauge transformation as a function `S → G`. -/
def fromGauge (γ : Gauge S G) : S → G := γ

theorem toGauge_mul_smul (k : S → G) (γ : Gauge S G) (U : E → G) :
    toGauge k • γ • U = toGauge (k * fromGauge γ) • U :=
  (mul_smul (toGauge k) γ U).symm

theorem continuous_toGauge_smul [TopologicalSpace G] [IsTopologicalGroup G] :
    Continuous fun p : (E → G) × (S → G) => toGauge p.2 • p.1 :=
  continuous_pi fun e =>
    (((continuous_apply (src e)).comp continuous_snd).mul
      ((continuous_apply e).comp continuous_fst)).mul
      ((continuous_apply (tgt e)).comp continuous_snd).inv

variable [MeasurableSpace G] [MeasurableMul₂ G] [MeasurableInv G]

theorem measurable_toGauge_smul :
    Measurable fun p : (E → G) × (S → G) => toGauge p.2 • p.1 :=
  measurable_pi_lambda _ fun e =>
    (((measurable_pi_apply (src e)).comp measurable_snd).mul
      ((measurable_pi_apply e).comp measurable_fst)).mul
      ((measurable_pi_apply (tgt e)).comp measurable_snd).inv

/-- The gauge average `Aφ(U) = ∫ φ(k • U) ν(dk)`. -/
noncomputable def gaugeAvg (ν : Measure (S → G)) (φ : (E → G) → ℝ) (U : E → G) : ℝ :=
  ∫ k, φ (toGauge k • U) ∂ν

omit [MeasurableInv G] in
/-- **The gauge average is gauge invariant** for a right-invariant `ν`. -/
theorem gaugeAvg_smul (ν : Measure (S → G)) [ν.IsMulRightInvariant] (φ : (E → G) → ℝ)
    (γ : Gauge S G) (U : E → G) : gaugeAvg ν φ (γ • U) = gaugeAvg ν φ U := by
  show ∫ k, φ (toGauge k • γ • U) ∂ν = ∫ k, φ (toGauge k • U) ∂ν
  have h : (fun k : S → G => φ (toGauge k • γ • U)) =
      fun k => φ (toGauge (k * fromGauge γ) • U) :=
    funext fun k => by rw [toGauge_mul_smul]
  rw [h]
  exact integral_mul_right_eq_self (fun k => φ (toGauge k • U)) (fromGauge γ)

/-- **The gauge average has the same inner product with every gauge-invariant element**
(`μ` gauge invariant, `ν` any probability measure, `φ` measurable and bounded):
`∫ Aφ · w dμ = ∫ φ · w dμ` (Fubini, then `w ∘ (k • ·) = w` and `(k • ·)_* μ = μ`). -/
theorem integral_gaugeAvg_mul [Fintype E] (μ : Measure (E → G)) [IsProbabilityMeasure μ]
    [SMulInvariantMeasure (Gauge S G) (E → G) μ] (ν : Measure (S → G)) [IsProbabilityMeasure ν]
    {φ : (E → G) → ℝ} (hφ : Measurable φ) {C : ℝ} (hC : ∀ U, ‖φ U‖ ≤ C)
    (w : Lp ℝ 2 μ) (hw : ∀ γ : Gauge S G, actL2 μ (Gauge S G) γ w = w) :
    ∫ U, gaugeAvg ν φ U * w U ∂μ = ∫ U, φ U * w U ∂μ := by
  have hwi : Integrable (w : (E → G) → ℝ) μ := (Lp.memLp w).integrable one_le_two
  have hk : ∀ k : S → G, ∫ U, φ (toGauge k • U) * w U ∂μ = ∫ U, φ U * w U ∂μ := by
    intro k
    have h1 : (w : (E → G) → ℝ) ∘ (toGauge k • ·) =ᵐ[μ] w := by
      have h2 := coeFn_compL2 μ (measurePreserving_smul (toGauge k) μ) w
      have h3 : compL2 μ (measurePreserving_smul (toGauge k) μ) w = w := hw (toGauge k)
      rw [h3] at h2
      exact h2.symm
    calc ∫ U, φ (toGauge k • U) * w U ∂μ = ∫ U, φ (toGauge k • U) * w (toGauge k • U) ∂μ :=
          integral_congr_ae (h1.mono fun U hU => by
            show φ (toGauge k • U) * w U = φ (toGauge k • U) * w (toGauge k • U)
            rw [show w (toGauge k • U) = w U from hU])
      _ = ∫ U, φ U * w U ∂μ :=
          (measurePreserving_smul (toGauge k) μ).integral_comp
            (measurableEmbedding_const_smul (toGauge k)) (fun U => φ U * w U)
  have hF : Integrable (Function.uncurry fun U (k : S → G) => φ (toGauge k • U) * w U)
      (μ.prod ν) := by
    refine Integrable.mono' ((hwi.norm.const_mul C).comp_fst ν) ?_ (ae_of_all _ fun p => ?_)
    · exact ((hφ.comp measurable_toGauge_smul).aestronglyMeasurable).mul
        hwi.aestronglyMeasurable.comp_fst
    · show ‖φ (toGauge p.2 • p.1) * w p.1‖ ≤ C * ‖w p.1‖
      rw [norm_mul]
      exact mul_le_mul_of_nonneg_right (hC _) (norm_nonneg _)
  calc ∫ U, gaugeAvg ν φ U * w U ∂μ = ∫ U, ∫ k, φ (toGauge k • U) * w U ∂ν ∂μ := by
        refine integral_congr_ae (ae_of_all _ fun U => ?_)
        exact (integral_mul_const (w U) fun k => φ (toGauge k • U)).symm
    _ = ∫ k, ∫ U, φ (toGauge k • U) * w U ∂μ ∂ν := integral_integral_swap hF
    _ = ∫ _k : S → G, ∫ U, φ U * w U ∂μ ∂ν := integral_congr_ae (ae_of_all _ hk)
    _ = ∫ U, φ U * w U ∂μ := by simp

end Gauge

/-! ## Density of the continuous versions in the centred gauge-invariant space -/

section Density

variable {S E G : Type*} [OrientedGraph S E] [Fintype E] [Group G] [TopologicalSpace G]
  [IsTopologicalGroup G] [CompactSpace G] [MeasurableSpace G] [MeasurableMul₂ G] [MeasurableInv G]
  [BorelSpace (E → G)] [FirstCountableTopology (E → G)] [LocallyCompactSpace (E → G)]
  [NormalSpace (E → G)] [OpensMeasurableSpace (S → G)]

/-- **An element of the centred gauge-invariant space orthogonal to every element with a
continuous version is zero** (`G` a compact topological group, `μ` a gauge-invariant weakly regular
probability measure on `E → G`, `ν` a right-invariant probability measure on `S → G`): it is then
orthogonal to every continuous `φ`, because the centred gauge average of `φ` has a continuous
version and the same inner product (`integral_gaugeAvg_mul`), and continuous functions are dense in
`L²(μ)`. -/
theorem eq_zero_of_forall_inner_ContVer (μ : Measure (E → G)) [IsProbabilityMeasure μ]
    [SMulInvariantMeasure (Gauge S G) (E → G) μ] [μ.WeaklyRegular]
    (ν : Measure (S → G)) [IsProbabilityMeasure ν] [ν.IsMulRightInvariant]
    (v : cgL2 μ (Gauge S G)) (hv : ∀ a ∈ ContVer μ (cgL2 μ (Gauge S G)), ⟪a, v⟫_ℝ = 0) :
    (v : Lp ℝ 2 μ) = 0 := by
  have hv0 : ∫ U, (v : Lp ℝ 2 μ) U ∂μ = 0 := ((mem_cgL2 μ (Gauge S G)).1 v.2).1
  have hvinv := ((mem_cgL2 μ (Gauge S G)).1 v.2).2
  have key : ∀ φ : C(E → G, ℝ), ⟪ContinuousMap.toLp 2 μ ℝ φ, (v : Lp ℝ 2 μ)⟫_ℝ = 0 := by
    intro φ
    obtain ⟨C, hC⟩ := isCompact_univ.exists_bound_of_continuousOn φ.continuous.continuousOn
    have hAc : Continuous (gaugeAvg ν φ) := by
      have h := continuous_parametric_integral_of_continuous (μ := ν)
        (f := fun U (k : S → G) => φ (toGauge k • U))
        (φ.continuous.comp continuous_toGauge_smul) isCompact_univ
      have h' : Continuous fun U => ∫ k, φ (toGauge k • U) ∂ν := by
        simpa only [Measure.restrict_univ] using h
      exact h'
    obtain ⟨C', hC'⟩ := isCompact_univ.exists_bound_of_continuousOn hAc.continuousOn
    have hAm : MemLp (gaugeAvg ν φ) 2 μ :=
      MemLp.of_bound hAc.aestronglyMeasurable C' (ae_of_all _ fun U => hC' U (Set.mem_univ U))
    have hmem := centred_mem_cgL2 μ (Gauge S G) hAm (gaugeAvg_smul ν φ)
    have hae : ((hAm.toLp (gaugeAvg ν φ) - (∫ U, gaugeAvg ν φ U ∂μ) • one2 μ : Lp ℝ 2 μ) :
        (E → G) → ℝ) =ᵐ[μ] fun U => gaugeAvg ν φ U - ∫ U, gaugeAvg ν φ U ∂μ := by
      filter_upwards [Lp.coeFn_sub (hAm.toLp (gaugeAvg ν φ)) ((∫ U, gaugeAvg ν φ U ∂μ) • one2 μ),
        hAm.coeFn_toLp, Lp.coeFn_smul (∫ U, gaugeAvg ν φ U ∂μ) (one2 μ), coeFn_one2 μ]
        with U h1 h2 h3 h4
      rw [h1, Pi.sub_apply, h2, h3, Pi.smul_apply, h4, smul_eq_mul, mul_one]
    have h0 : ⟪hAm.toLp (gaugeAvg ν φ) - (∫ U, gaugeAvg ν φ U ∂μ) • one2 μ,
        (v : Lp ℝ 2 μ)⟫_ℝ = 0 :=
      hv ⟨_, hmem⟩ ⟨_, hAc.sub continuous_const, hae⟩
    rw [inner_sub_left, real_inner_smul_left, inner_one2, hv0, mul_zero, sub_zero] at h0
    refine Eq.trans ?_ h0
    rw [L2.inner_def, L2.inner_def]
    calc ∫ U, ⟪(ContinuousMap.toLp 2 μ ℝ φ : Lp ℝ 2 μ) U, (v : Lp ℝ 2 μ) U⟫_ℝ ∂μ
        = ∫ U, φ U * (v : Lp ℝ 2 μ) U ∂μ := by
          refine integral_congr_ae ?_
          filter_upwards [ContinuousMap.coeFn_toLp (p := 2) (μ := μ) (𝕜 := ℝ) φ] with U hU
          rw [hU, Real.inner_apply]
      _ = ∫ U, gaugeAvg ν φ U * (v : Lp ℝ 2 μ) U ∂μ :=
          (integral_gaugeAvg_mul μ ν φ.continuous.measurable
            (fun U => hC U (Set.mem_univ U)) (v : Lp ℝ 2 μ) hvinv).symm
      _ = ∫ U, ⟪(hAm.toLp (gaugeAvg ν φ) : Lp ℝ 2 μ) U, (v : Lp ℝ 2 μ) U⟫_ℝ ∂μ := by
          refine integral_congr_ae ?_
          filter_upwards [hAm.coeFn_toLp] with U hU
          rw [hU, Real.inner_apply]
  have hd := ContinuousMap.toLp_denseRange (α := E → G) (E := ℝ) (μ := μ) (p := 2) ℝ
    ENNReal.ofNat_ne_top
  have hcl : closure (Set.range (ContinuousMap.toLp (E := ℝ) 2 μ ℝ :
      C(E → G, ℝ) →L[ℝ] Lp ℝ 2 μ)) ⊆ {g | ⟪g, (v : Lp ℝ 2 μ)⟫_ℝ = 0} :=
    closure_minimal (Set.range_subset_iff.2 key)
      (isClosed_eq (continuous_id.inner continuous_const) continuous_const)
  exact inner_self_eq_zero.1 (hcl (hd (v : Lp ℝ 2 μ)))

/-- **Density of the elements with a continuous version** in the centred gauge-invariant space
(same assumptions). -/
theorem dense_ContVer (μ : Measure (E → G)) [IsProbabilityMeasure μ]
    [SMulInvariantMeasure (Gauge S G) (E → G) μ] [μ.WeaklyRegular]
    (ν : Measure (S → G)) [IsProbabilityMeasure ν] [ν.IsMulRightInvariant] :
    ∀ u : cgL2 μ (Gauge S G), u ∈ closure (ContVer μ (cgL2 μ (Gauge S G))) := by
  intro u
  let T : Submodule ℝ (cgL2 μ (Gauge S G)) :=
    { carrier := ContVer μ (cgL2 μ (Gauge S G))
      add_mem' := fun {f g} hf hg => ContVer.add_mem f hf g hg
      zero_mem' := ContVer.zero_mem
      smul_mem' := fun a {f} hf => ContVer.smul_mem a f hf }
  have hS : T.topologicalClosure = ⊤ := by
    rw [Submodule.topologicalClosure_eq_top_iff, Submodule.eq_bot_iff]
    intro v hv
    exact Subtype.ext (eq_zero_of_forall_inner_ContVer μ ν v fun a ha =>
      (Submodule.mem_orthogonal T v).1 hv a ha)
  have hu : u ∈ T.topologicalClosure := by
    rw [hS]
    exact Submodule.mem_top
  rwa [← SetLike.mem_coe, Submodule.topologicalClosure_coe] at hu

end Density

/-! ## SU(2) on `(ℤ/2Mℤ)⁴` -/

section SU2

variable (M : ℕ) [NeZero M] (β : ℝ)

/-- `SU(2)` is nonempty (stated once so that instance search finds it at once). -/
instance instNonemptySU2 : Nonempty SU2 := ⟨1⟩

/-- The SU(2) Wilson measure `μ ∝ exp((β/2) ∑ₚ Re tr U_p) ∏ dU` on `(ℤ/2Mℤ)⁴` charges every
nonempty open set. -/
instance isOpenPosMeasure_su2 :
    (wilsonMeasure (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2).IsOpenPosMeasure :=
  isOpenPosMeasure_wilsonMeasure _ _ _ _

/-- **Uniqueness of continuous versions** (SU(2) on `(ℤ/2Mℤ)⁴`, every `M ≥ 1`, every real `β`):
two continuous functions of the links that agree `μ`-a.e. are equal. -/
theorem eq_of_ae_eq_wilson {f g : (Link (2 * M) → SU2) → ℝ} (hf : Continuous f)
    (hg : Continuous g)
    (hfg : f =ᵐ[wilsonMeasure (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2] g) : f = g :=
  (hf.ae_eq_iff_eq _ hg).1 hfg

/-- The elements of `H` with a continuous version (SU(2) on `(ℤ/2Mℤ)⁴`). -/
noncomputable abbrev contVer : Set (wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2) :=
  ContVer (wilsonMeasure (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2)
    (wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2)

/-- The continuous version of `f ∈ contVer M β` (`0` off `contVer M β`). -/
noncomputable abbrev ver (f : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2) :
    (Link (2 * M) → SU2) → ℝ :=
  verOf (wilsonMeasure (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2)
    (wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2) f

/-- The oscillation `δⱼ f = sup_{U, s} |ver f (update U j s) − ver f U|` (`0` off `contVer M β`). -/
noncomputable abbrev linkOsc (j : Link (2 * M))
    (f : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2) : ℝ :=
  oscOf (wilsonMeasure (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2)
    (wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2) j f

theorem continuous_ver (f : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2) :
    Continuous (ver M β f) :=
  continuous_verOf f

theorem coeFn_ae_eq_ver {f : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2}
    (hf : f ∈ contVer M β) :
    ((f : Lp ℝ 2 (wilsonMeasure (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2)) :
      (Link (2 * M) → SU2) → ℝ) =ᵐ[wilsonMeasure (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2]
      ver M β f :=
  (verOf_spec hf).2

theorem mem_contVer_of_ae_eq {f : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2}
    {g : (Link (2 * M) → SU2) → ℝ} (hg : Continuous g)
    (hfg : ((f : Lp ℝ 2 (wilsonMeasure (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2)) :
      (Link (2 * M) → SU2) → ℝ) =ᵐ[wilsonMeasure (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2] g) :
    f ∈ contVer M β :=
  ⟨g, hg, hfg⟩

/-- **The version is unique** (SU(2) on `(ℤ/2Mℤ)⁴`, every `M ≥ 1`, every real `β`). -/
theorem ver_eq_of_ae_eq {f : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2}
    {g : (Link (2 * M) → SU2) → ℝ} (hg : Continuous g)
    (hfg : ((f : Lp ℝ 2 (wilsonMeasure (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2)) :
      (Link (2 * M) → SU2) → ℝ) =ᵐ[wilsonMeasure (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2] g) :
    ver M β f = g :=
  verOf_eq_of_ae_eq hg hfg

theorem ver_of_not_mem {f : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2}
    (hf : f ∉ contVer M β) : ver M β f = 0 :=
  verOf_of_not_mem hf

theorem zero_mem_contVer : (0 : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2) ∈ contVer M β :=
  ContVer.zero_mem

theorem add_mem_contVer : ∀ f ∈ contVer M β, ∀ g ∈ contVer M β, f + g ∈ contVer M β :=
  ContVer.add_mem

theorem smul_mem_contVer : ∀ (a : ℝ), ∀ f ∈ contVer M β, a • f ∈ contVer M β :=
  ContVer.smul_mem

theorem ver_add {f g : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2} (hf : f ∈ contVer M β)
    (hg : g ∈ contVer M β) : ver M β (f + g) = ver M β f + ver M β g :=
  verOf_add hf hg

theorem ver_smul (a : ℝ) {f : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2}
    (hf : f ∈ contVer M β) : ver M β (a • f) = a • ver M β f :=
  verOf_smul a hf

theorem linkOsc_nonneg (j : Link (2 * M)) (f : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2) :
    0 ≤ linkOsc M β j f :=
  oscOf_nonneg j f

theorem abs_sub_le_linkOsc (j : Link (2 * M))
    (f : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2) (U : Link (2 * M) → SU2) (s : SU2) :
    |ver M β f (Function.update U j s) - ver M β f U| ≤ linkOsc M β j f :=
  abs_sub_le_oscOf j f U s

theorem linkOsc_le (j : Link (2 * M)) (f : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2)
    {c : ℝ} (h : ∀ (U : Link (2 * M) → SU2) (s : SU2),
      |ver M β f (Function.update U j s) - ver M β f U| ≤ c) :
    linkOsc M β j f ≤ c :=
  oscOf_le j f h

theorem linkOsc_eq_zero_iff (j : Link (2 * M))
    (f : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2) :
    linkOsc M β j f = 0 ↔
      ∀ (U : Link (2 * M) → SU2) (s : SU2), ver M β f (Function.update U j s) = ver M β f U :=
  oscOf_eq_zero_iff j f

theorem linkOsc_of_not_mem (j : Link (2 * M))
    {f : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2} (hf : f ∉ contVer M β) :
    linkOsc M β j f = 0 :=
  oscOf_of_not_mem j hf

/-- **`δⱼ` is subadditive on the domain** (the field `δ_add` of `SU2SingleLinkInfluence`). -/
theorem linkOsc_add : ∀ j, ∀ f ∈ contVer M β, ∀ g ∈ contVer M β,
    linkOsc M β j (f + g) ≤ linkOsc M β j f + linkOsc M β j g :=
  fun j => oscOf_add j

/-- **`δⱼ` is positively homogeneous on the domain** (the field `δ_smul`). -/
theorem linkOsc_smul : ∀ j (a : ℝ), 0 ≤ a → ∀ f ∈ contVer M β,
    linkOsc M β j (a • f) ≤ a * linkOsc M β j f :=
  fun j a ha => oscOf_smul j a ha

theorem integral_eq_zero_of_mem_H (f : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2) :
    ∫ ω, (f : Lp ℝ 2 (wilsonMeasure (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2)) ω
      ∂(wilsonMeasure (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2) = 0 :=
  ((mem_cgL2 _ _).1 f.2).1

/-- **The version is controlled by the oscillations** (SU(2) on `(ℤ/2Mℤ)⁴`, every `M ≥ 1`, every
real `β`): `|ver f U| ≤ ∑ⱼ δⱼ f` for `f ∈ contVer M β`. -/
theorem abs_ver_le_sum_linkOsc {f : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2}
    (hf : f ∈ contVer M β) (U : Link (2 * M) → SU2) :
    |ver M β f U| ≤ ∑ j, linkOsc M β j f :=
  abs_verOf_le_sum (integral_eq_zero_of_mem_H M β) hf U

/-- **The comparison `‖f‖ ≤ K ∑ⱼ δⱼ f` with `K = 1`** (SU(2) on `(ℤ/2Mℤ)⁴`, every `M ≥ 1`, every
real `β`; the field `poinc` of `SU2SingleLinkInfluence`). -/
theorem norm_le_sum_linkOsc : ∀ f ∈ contVer M β, ‖f‖ ≤ 1 * ∑ j, linkOsc M β j f :=
  fun _ hf => (norm_le_sum_oscOf (integral_eq_zero_of_mem_H M β) hf).trans_eq (one_mul _).symm

/-- An element of `H` orthogonal to every element of `contVer M β` is zero (SU(2) on `(ℤ/2Mℤ)⁴`,
every `M ≥ 1`, every real `β`; the gauge average uses the Haar probability on `SU(2)^{sites}`). -/
theorem eq_zero_of_forall_inner_contVer
    (v : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2)
    (hv : ∀ a ∈ contVer M β, ⟪a, v⟫_ℝ = 0) :
    (v : Lp ℝ 2 (wilsonMeasure (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2)) = 0 :=
  eq_zero_of_forall_inner_ContVer (wilsonMeasure (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2)
    (Measure.pi fun _ : Site (2 * M) => haarSU2) v hv

/-- **Density of the domain** (SU(2) on `(ℤ/2Mℤ)⁴`, every `M ≥ 1`, every real `β`; the field
`dense` of `SU2SingleLinkInfluence`): every `u ∈ H` lies in the closure of `contVer M β`. -/
theorem dense_contVer : ∀ u : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2,
    u ∈ closure (contVer M β) :=
  dense_ContVer (wilsonMeasure (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2)
    (Measure.pi fun _ : Site (2 * M) => haarSU2)

end SU2

end YangMills.StrongCoupling.ContinuousVersions

/-! # Part XXXII. `YangMills.StrongCoupling.SingleLinkDobrushin`: the single-link influence hypothesis `SU2SingleLinkInfluence M β (18|β|)` of Part XXIX for every `M ≥ 1` and every real `β`, hence the single-link Poincaré inequality and the generator bounds of Part XXIX with no hypothesis (new; uses Parts IV, VI, X, XV, XXII, XXV, XXIX, XXX and XXXI) -/

/-!
# The single-link Dobrushin input for the SU(2) Wilson heat baths

## (a) Formal target

For the SU(2) Wilson measure `μ ∝ exp((β/2) ∑ₚ Re tr U_p) ∏ₑ dUₑ` on `(ℤ/2Mℤ)⁴` (Part VI's
`su2Wilson`, so `β = β_W = 4/g²`), every `M ≥ 1` and every real `β`: the named hypothesis
`SU2SingleLinkInfluence M β (18 |β|)` of Part XXIX, with domain the elements of `H` (centred,
gauge-invariant `L²(μ)`) that have a continuous version, `δⱼ` the oscillation of that version in
`Uⱼ`, influence matrix `c j e = |β| k j e` (`k j e` the number of plaquettes that contain both links
`j` and `e`) and `K = 1`; and, through Part XXIX, the single-link Poincaré inequality with constant
`1 − 18|β|` and the bounds `D_c ≥ ((1 − 18|β|)/128) I`, `D ≥ ((1 − 18|β|)/64) I` for the cube
heat-bath generators.

## (b) What is proved

* The count (every `n ≥ 1`, hence every `M ≥ 1` with `n = 2M`): `card_plaq_mem_le` (a link `(y, ρ)`
  of `(ℤ/nℤ)⁴` lies in at most six plaquettes `(x, μ, ν)`: they are the image of the six pairs
  (direction `≠ ρ`, whether `x = y`) under an explicit map), `sum_kPair_le` (double counting with at
  most four links per plaquette, for any plaquette family) and `su2_col_count`:
  `∑_{j ≠ e} k j e ≤ 18`. No finite computation over the lattice is used.
* The log-density oscillation: `wilsonExp_update_osc` (any Wilson setting `W = κ ∑ₚ χ(U_p)`,
  `|χ| ≤ B`): if `U` and `U'` agree off the link `j`, then `s ↦ W(U^{e←s}) − W(U'^{e←s})` has
  oscillation at most `4 |κ| B k j e` (window form `wilsonExp_update_window`), because only the
  plaquettes containing both `j` and `e` give a term that depends on `s`. For SU(2) (`κ = β/2`,
  `B = 2`), `su2_wilsonExp_update_osc`: `L = 4 |β| k j e`, so `tanh(L/4) = tanh(|β| k j e)`.
* The influence step: `linkKer e φ` is the single-link kernel average
  `U ↦ ∫ φ(U^{e←s}) dν_U(s)`, `ν_U = h.tilted (s ↦ W(U^{e←s}))`. `kernel_update_infl_tanh` (any
  Wilson setting; Part XXV's `tilt_kernel_abs_le`) and `su2_kernel_update_infl` (SU(2), via
  Part XXV's `tanh_le_of_nonneg`): for `j ≠ e`, if `a` and `d` bound the oscillations of a
  measurable `φ` in `U_j` and in `U_e`, then `|Φ(U^{j←s}) − Φ(U)| ≤ a + |β| k j e · d` for
  `Φ = linkKer e φ`.
* The assembly: `su2_singleLinkInfluence_of_hyps : SU2SingleLinkInfluence M β (18 |β|)` for every
  `M ≥ 1` and every real `β`, conditional on two named hypotheses that restate the interfaces of
  the heat-bath kernel part (`HeatBathKernel`) and of the continuous-version part
  (`ContinuousVersions`): `KernelHyp M β` (the kernel average of a continuous function is continuous
  and is a version of `P_{e} f` whenever `f` has a continuous version) and `VersionHyp M β D ver δ`
  (continuous versions and their uniqueness, the domain closed under linear combinations and dense
  in `H`, `δⱼ` the least bound of the oscillation in `Uⱼ`, subadditive and positively homogeneous,
  and `‖f‖ ≤ ∑ⱼ δⱼ f`). The consequences through Part XXIX, under the same two hypotheses:
  `su2_singleLinkPoincare_of_hyps` (`SingleLinkPoincare M β (1 − 18|β|)`),
  `su2_coarse_gap_of_hyps` (`D_c ≥ ((1 − 18|β|)/128) I`), `su2_gap_of_hyps`
  (`D ≥ ((1 − 18|β|)/64) I`) and `su2_gap_pos_of_hyps` (a positive constant for `|β| < 1/18`, the
  same for every `M`).
* The discharge (closing section of this part): `su2_kernelHyp` and `su2_versionHyp` prove both
  hypotheses, for every `M ≥ 1` and every real `β`, from the heat-bath kernel part and the
  continuous-version part of this file. Hence, with no hypothesis: `su2_singleLinkInfluence M β :
  SU2SingleLinkInfluence M β (18 |β|)` (domain `contVer M β`, `δ = linkOsc M β`,
  `c j e = |β| k j e`, `K = 1`), `su2_singleLinkPoincare` (`SingleLinkPoincare M β (1 − 18|β|)`),
  `su2_coarse_gap` (`D_c ≥ ((1 − 18|β|)/128) I`), `su2_gap` (`D ≥ ((1 − 18|β|)/64) I`) and
  `su2_gap_pos` (`|β| < 1/18`: a positive constant, the same for every `M`). These bounds are
  true for every real `β` and say something only for `|β| < 1/18`.

## (c) What remains open

The `_of_hyps` theorems take `KernelHyp M β` and `VersionHyp M β D ver δ` as arguments; these
restate `su2_continuous_kerAvg`, `su2_linkPj_kerAvg` (whose `kerAvg` unfolds to `linkKer`) and the
theorems on `contVer M β`, `ver M β`, `linkOsc M β`, and they are proved in the closing section
(see (b)). The coefficient `tanh(|β| k j e)` is replaced by the larger `|β| k j e`. Only
`≤ 18` is proved for the column count (equality, and the value `15` of distinct neighbours at
`M = 1`, are not formalised). The block heat baths of Part XXVI (`SU2HeatBathOsc`) are not
treated here. Nothing
here concerns infinite volume, the continuum limit, weak coupling or the transfer matrix.

## (d) Axioms and checks

Every headline depends only on `propext`, `Classical.choice` and `Quot.sound` (the module axiom
audit covers every headline); the part contains no `sorry`, `admit`, `axiom` declarations,
`native_decide`, `implemented_by` or `set_option`.

## (e) Scope

This part is not a proof of a mass gap. `∑ₑ (I − P_{e})`, `D` and `D_c` generate heat-bath
(Gibbs-sampler) dynamics of the finite-volume Wilson measure: the single-link heat bath and the
fine and coarse cube heat baths. The bounds here are lower bounds on their spectral gaps (on `H`,
and on `Y` for `D_c`) with constants that do not depend on `M` (uniform in the side `2M` of the
periodic torus; no infinite-volume statement); they are not bounds on the transfer matrix. They
are non-trivial only for `|β| < 1/18 ≈ 0.056` (`β = β_W`), deep strong coupling. The
mathematics is known on paper: Dobrushin's uniqueness condition (Dobrushin, Theory Probab.
Appl. 15 (1970) 458–486); under it the heat-bath Dirichlet form has spectral gap `≥ 1 − r(C)`
(L. Wu, Ann. Probab. 34 (2006) 1960–1989, Thm 2.1; random-scan form); and a single-link
Dobrushin bound `18β` for the SU(N) Wilson measure in `d = 4` (uniqueness and decay of
correlations for `β < 1/18`) also appears in the preprint A. Mihajlovic, arXiv:2611.11534. No
novelty is claimed; the contribution is the formal derivation.
-/

namespace YangMills.StrongCoupling.SingleLinkDobrushin

open MeasureTheory MeasureTheory.Measure YangMills.StrongCoupling.WilsonCube
  YangMills.StrongCoupling.WilsonSU2 YangMills.StrongCoupling.SingleLinkInfluence
  YangMills.StrongCoupling.FibreReduction YangMills.StrongCoupling.ProductEndpoint
open Function (update update_of_ne update_self update_comm update_idem)

/-! ### The plaquette count -/

section Count

variable {S E G : Type*} [OrientedGraph S E] [DecidableEq E]

/-- The links of a plaquette, as a finite set (at most four). -/
def pLinks (P : Plaq S E) : Finset E := {P.l1, P.l2, P.l3, P.l4}

theorem card_pLinks_le (P : Plaq S E) : (pLinks P).card ≤ 4 := Finset.card_le_four

/-- The holonomy of a plaquette depends only on the variables on its links. -/
theorem hol_congr [Group G] (P : Plaq S E) {V W : E → G} (h : ∀ l ∈ pLinks P, V l = W l) :
    hol P V = hol P W := by
  show V P.l1 * V P.l2 * (V P.l3)⁻¹ * (V P.l4)⁻¹ = W P.l1 * W P.l2 * (W P.l3)⁻¹ * (W P.l4)⁻¹
  rw [h _ (Finset.mem_insert_self _ _), h _ (Finset.mem_insert_of_mem (Finset.mem_insert_self _ _)),
    h _ (Finset.mem_insert_of_mem (Finset.mem_insert_of_mem (Finset.mem_insert_self _ _))),
    h _ (Finset.mem_insert_of_mem (Finset.mem_insert_of_mem (Finset.mem_insert_of_mem
      (Finset.mem_singleton_self _))))]

variable {Pl : Type*} [Fintype Pl] (plaq : Pl → Plaq S E)

/-- `k j e`: the number of plaquettes (indices `p`) whose links contain both `j` and `e`. -/
def kPair (j e : E) : ℕ :=
  (Finset.univ.filter fun p => j ∈ pLinks (plaq p) ∧ e ∈ pLinks (plaq p)).card

/-- **Double counting**: `∑_{j ≠ e} k j e ≤ 3 · #{p : e ∈ p}` (each plaquette has at most four
links). -/
theorem sum_kPair_le [Fintype E] (e : E) :
    ∑ j ∈ ({e} : Finset E)ᶜ, kPair plaq j e ≤
      3 * (Finset.univ.filter fun p => e ∈ pLinks (plaq p)).card := by
  simp only [kPair, Finset.card_filter]
  rw [Finset.sum_comm, Finset.mul_sum]
  refine Finset.sum_le_sum fun p _ => ?_
  by_cases he : e ∈ pLinks (plaq p)
  · rw [if_pos he, mul_one, ← Finset.card_filter]
    calc (({e} : Finset E)ᶜ.filter fun j => j ∈ pLinks (plaq p) ∧ e ∈ pLinks (plaq p)).card
        ≤ ((pLinks (plaq p)).erase e).card := Finset.card_le_card fun j hj => by
          obtain ⟨hj1, hj2, -⟩ := Finset.mem_filter.1 hj
          exact Finset.mem_erase.2 ⟨fun h => Finset.mem_compl.1 hj1 (Finset.mem_singleton.2 h), hj2⟩
      _ = (pLinks (plaq p)).card - 1 := Finset.card_erase_of_mem he
      _ ≤ 3 := by have := card_pLinks_le (plaq p); omega
  · rw [if_neg he, mul_zero]
    exact (Finset.sum_eq_zero fun j _ => if_neg fun h => he h.2).le

end Count

/-- **Each link of `(ℤ/nℤ)⁴` lies in at most six plaquettes** (every `n ≥ 1`): the plaquettes
`(x, μ, ν)` that contain `(y, ρ)` are determined by the other direction and by whether `x = y`. -/
theorem card_plaq_mem_le (n : ℕ) [NeZero n] (e : Link n) :
    (Finset.univ.filter fun q : PlaqIdx n => e ∈ pLinks (plaqOf q)).card ≤ 6 := by
  obtain ⟨y, ρ⟩ := e
  have hT : (((Finset.univ : Finset (Fin 4)).erase ρ) ×ˢ (Finset.univ : Finset Bool)).card = 6 := by
    rw [Finset.card_product, Finset.card_erase_of_mem (Finset.mem_univ _), Finset.card_univ,
      Finset.card_univ, Fintype.card_fin, Fintype.card_bool]
  rw [← Finset.card_map ⟨Subtype.val, Subtype.val_injective⟩, ← hT]
  refine Finset.card_le_card_of_surjOn
    (fun w : Fin 4 × Bool => (cond w.2 y (y - unitV w.1), min w.1 ρ, max w.1 ρ)) ?_
  intro z hz
  obtain ⟨⟨⟨x, μ, ν⟩, hμν⟩, hq, rfl⟩ := Finset.mem_map.1 hz
  have hq' := (Finset.mem_filter.1 hq).2
  simp only [pLinks, plaqOf, Finset.mem_insert, Finset.mem_singleton, Prod.mk.injEq] at hq'
  have hlt : μ < ν := hμν
  rcases hq' with ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩
  · refine ⟨(ν, true), Finset.mem_product.2 ⟨Finset.mem_erase.2 ⟨by rw [h2]; exact hlt.ne',
      Finset.mem_univ _⟩, Finset.mem_univ _⟩, ?_⟩
    show (y, min ν ρ, max ν ρ) = (x, μ, ν)
    rw [h1, h2, min_eq_right hlt.le, max_eq_left hlt.le]
  · refine ⟨(μ, false), Finset.mem_product.2 ⟨Finset.mem_erase.2 ⟨by rw [h2]; exact hlt.ne,
      Finset.mem_univ _⟩, Finset.mem_univ _⟩, ?_⟩
    show (y - unitV μ, min μ ρ, max μ ρ) = (x, μ, ν)
    rw [h1, h2, min_eq_left hlt.le, max_eq_right hlt.le, add_sub_cancel_right]
  · refine ⟨(ν, false), Finset.mem_product.2 ⟨Finset.mem_erase.2 ⟨by rw [h2]; exact hlt.ne',
      Finset.mem_univ _⟩, Finset.mem_univ _⟩, ?_⟩
    show (y - unitV ν, min ν ρ, max ν ρ) = (x, μ, ν)
    rw [h1, h2, min_eq_right hlt.le, max_eq_left hlt.le, add_sub_cancel_right]
  · refine ⟨(μ, true), Finset.mem_product.2 ⟨Finset.mem_erase.2 ⟨by rw [h2]; exact hlt.ne,
      Finset.mem_univ _⟩, Finset.mem_univ _⟩, ?_⟩
    show (y, min μ ρ, max μ ρ) = (x, μ, ν)
    rw [h1, h2, min_eq_left hlt.le, max_eq_right hlt.le]

/-- **The column count** (every `n ≥ 1`, so every `M ≥ 1` with `n = 2M`): for every link `e` of
`(ℤ/nℤ)⁴`, `∑_{j ≠ e} k j e ≤ 18`, `k j e` = number of plaquettes containing `j` and `e`. -/
theorem su2_col_count (n : ℕ) [NeZero n] (e : Link n) :
    ∑ j ∈ ({e} : Finset (Link n))ᶜ, kPair (plaqOf (n := n)) j e ≤ 18 :=
  (sum_kPair_le _ e).trans (by have := card_plaq_mem_le n e; omega)

theorem su2_col_count_real (n : ℕ) [NeZero n] (e : Link n) :
    ∑ j ∈ ({e} : Finset (Link n))ᶜ, (kPair (plaqOf (n := n)) j e : ℝ) ≤ 18 := by
  rw [← Nat.cast_sum]
  exact_mod_cast su2_col_count n e

/-! ### The oscillation of the log-density -/

section Osc

variable {S E G : Type*} [OrientedGraph S E] [DecidableEq E] [Group G] [MeasurableSpace G]
  {Pl : Type*} [Fintype Pl] (plaq : Pl → Plaq S E) (χ : ClassFn G) (κ : ℝ)

/-- **The log-density oscillation** (abstract Wilson setting). If `U` and `U'` agree off the link
`j`, the difference `s ↦ W(U^{e←s}) − W(U'^{e←s})` of Wilson exponents `W = κ ∑ₚ χ(U_p)` has
oscillation at most `4 |κ| B k j e` (`B` = the bound of `|χ|`): only the `k j e` plaquettes that
contain both `j` and `e` contribute a non-constant term, each in `[−2|κ|B, 2|κ|B]`. -/
theorem wilsonExp_update_osc {j e : E} {U U' : E → G} (hUU : ∀ l, l ≠ j → U l = U' l)
    (t t' : G) :
    (wilsonExp plaq χ κ (update U e t) - wilsonExp plaq χ κ (update U' e t)) -
        (wilsonExp plaq χ κ (update U e t') - wilsonExp plaq χ κ (update U' e t')) ≤
      4 * |κ| * χ.bound * kPair plaq j e := by
  set d : Pl → ℝ := fun p =>
    (χ.toFun (hol (plaq p) (update U e t)) - χ.toFun (hol (plaq p) (update U' e t))) -
      (χ.toFun (hol (plaq p) (update U e t')) - χ.toFun (hol (plaq p) (update U' e t'))) with hd
  have hsum : (wilsonExp plaq χ κ (update U e t) - wilsonExp plaq χ κ (update U' e t)) -
      (wilsonExp plaq χ κ (update U e t') - wilsonExp plaq χ κ (update U' e t')) =
      κ * ∑ p, d p := by
    simp only [wilsonExp, hd, Finset.sum_sub_distrib]
    ring
  have hzero : ∀ p, ¬ (j ∈ pLinks (plaq p) ∧ e ∈ pLinks (plaq p)) → d p = 0 := by
    intro p hp
    by_cases hj : j ∈ pLinks (plaq p)
    · have he : e ∉ pLinks (plaq p) := fun he => hp ⟨hj, he⟩
      have h1 : ∀ (V : E → G) (s : G), hol (plaq p) (update V e s) = hol (plaq p) V :=
        fun V s => hol_congr _ fun l hl => update_of_ne (fun h => he (by rw [← h]; exact hl)) _ _
      simp only [hd, h1]
      ring
    · have h1 : ∀ s : G, hol (plaq p) (update U e s) = hol (plaq p) (update U' e s) :=
        fun s => hol_congr _ fun l hl => by
          by_cases hle : l = e
          · rw [hle, update_self, update_self]
          · rw [update_of_ne hle, update_of_ne hle]
            exact hUU l fun h => hj (by rw [← h]; exact hl)
      simp only [hd, h1, sub_self]
  have hbd : ∀ p, |d p| ≤ 4 * χ.bound := fun p => by
    have h1 := abs_le.1 (χ.abs_le (hol (plaq p) (update U e t)))
    have h2 := abs_le.1 (χ.abs_le (hol (plaq p) (update U' e t)))
    have h3 := abs_le.1 (χ.abs_le (hol (plaq p) (update U e t')))
    have h4 := abs_le.1 (χ.abs_le (hol (plaq p) (update U' e t')))
    rw [abs_le]
    constructor <;> linarith [h1.1, h1.2, h2.1, h2.2, h3.1, h3.2, h4.1, h4.2]
  rw [hsum, ← Finset.sum_filter_of_ne (p := fun p => j ∈ pLinks (plaq p) ∧ e ∈ pLinks (plaq p))
    (fun p _ hp => by_contra fun h => hp (hzero p h))]
  calc κ * ∑ p ∈ Finset.univ.filter (fun p => j ∈ pLinks (plaq p) ∧ e ∈ pLinks (plaq p)), d p
      ≤ |κ * ∑ p ∈ Finset.univ.filter (fun p => j ∈ pLinks (plaq p) ∧ e ∈ pLinks (plaq p)), d p| :=
        le_abs_self _
    _ = |κ| * |∑ p ∈ Finset.univ.filter (fun p => j ∈ pLinks (plaq p) ∧ e ∈ pLinks (plaq p)), d p| :=
        abs_mul _ _
    _ ≤ |κ| * ∑ p ∈ Finset.univ.filter (fun p => j ∈ pLinks (plaq p) ∧ e ∈ pLinks (plaq p)),
          4 * χ.bound :=
        mul_le_mul_of_nonneg_left ((Finset.abs_sum_le_sum_abs _ _).trans
          (Finset.sum_le_sum fun p _ => hbd p)) (abs_nonneg _)
    _ = 4 * |κ| * χ.bound * kPair plaq j e := by
        rw [Finset.sum_const, nsmul_eq_mul]
        unfold kPair
        ring

/-- **Window form** of `wilsonExp_update_osc`: the difference takes values in `[m, m + L]`,
`L = 4 |κ| B k j e`. -/
theorem wilsonExp_update_window [Nonempty G] {j e : E} {U U' : E → G}
    (hUU : ∀ l, l ≠ j → U l = U' l) :
    ∃ m : ℝ, ∀ t : G, m ≤ wilsonExp plaq χ κ (update U e t) - wilsonExp plaq χ κ (update U' e t) ∧
      wilsonExp plaq χ κ (update U e t) - wilsonExp plaq χ κ (update U' e t) ≤
        m + 4 * |κ| * χ.bound * kPair plaq j e := by
  obtain ⟨m, h1, h2⟩ := TiltTV.exists_osc_window
    (h := fun t => wilsonExp plaq χ κ (update U e t) - wilsonExp plaq χ κ (update U' e t))
    (wilsonExp_update_osc plaq χ κ hUU)
  exact ⟨m, fun t => ⟨h1 t, h2 t⟩⟩

end Osc

/-- **The log-density oscillation for SU(2)** (`(ℤ/nℤ)⁴`, every `n ≥ 1`, `κ = β/2`, `χ = Re tr`,
`|Re tr| ≤ 2`, every real `β = β_W`): for `U`, `U'` that agree off `j`, the function
`s ↦ W(U^{e←s}) − W(U'^{e←s})` has oscillation at most `L = 4 |β| k j e`, so
`tanh(L/4) = tanh(|β| k j e)`. -/
theorem su2_wilsonExp_update_osc {n : ℕ} [NeZero n] (β : ℝ) {j e : Link n}
    {U U' : Link n → SU2} (hUU : ∀ l, l ≠ j → U l = U' l) (t t' : SU2) :
    (wilsonExp (plaqOf (n := n)) reTr (β / 2) (update U e t) -
        wilsonExp (plaqOf (n := n)) reTr (β / 2) (update U' e t)) -
      (wilsonExp (plaqOf (n := n)) reTr (β / 2) (update U e t') -
        wilsonExp (plaqOf (n := n)) reTr (β / 2) (update U' e t')) ≤
      4 * |β| * kPair (plaqOf (n := n)) j e := by
  have h := wilsonExp_update_osc (plaqOf (n := n)) reTr (β / 2) (e := e) hUU t t'
  have e1 : 4 * |β / 2| * reTr.bound * (kPair (plaqOf (n := n)) j e : ℝ) =
      4 * |β| * kPair (plaqOf (n := n)) j e := by
    rw [abs_div, abs_two]
    show 4 * (|β| / 2) * 2 * _ = _
    ring
  exact h.trans_eq e1

/-! ### The influence step for the single-link kernel -/

section Kernel

variable {S E G : Type*} [OrientedGraph S E] [DecidableEq E] [Group G] [MeasurableSpace G]
  {Pl : Type*} [Fintype Pl] (plaq : Pl → Plaq S E) (χ : ClassFn G) (κ : ℝ) (h : Measure G)

/-- The single-link heat-bath kernel average `Φ(U) = ∫ g(U^{e←s}) dν_U(s)`,
`ν_U = h.tilted (s ↦ W(U^{e←s}))`, `W = κ ∑ₚ χ(U_p)` (the conditional law of `U_e` given the other
links; the same expression as the kernel `kerAvg` of the heat-bath kernel part). -/
noncomputable def linkKer (e : E) (g : (E → G) → ℝ) (U : E → G) : ℝ :=
  ∫ s, g (update U e s) ∂(h.tilted fun s => wilsonExp plaq χ κ (update U e s))

/-- The kernel average does not depend on `U_e` (the statement of `kerAvg_update_self` of the
heat-bath kernel part, restated so that this part does not depend on that one). -/
theorem linkKer_update_self (e : E) (g : (E → G) → ℝ) (U : E → G) (s : G) :
    linkKer plaq χ κ h e g (update U e s) = linkKer plaq χ κ h e g U := by
  simp only [linkKer, update_idem]

variable [MeasurableMul₂ G] [MeasurableInv G] [IsProbabilityMeasure h]

/-- **The pointwise influence step** (abstract Wilson setting, probability measure `h` on `G`).
Let `φ` be measurable with `|φ(U^{j←s}) − φ(U)| ≤ a` and `|φ(U^{e←s}) − φ(U)| ≤ d` for all `U, s`,
and `j ≠ e`. Then the kernel average `Φ = linkKer e φ` satisfies
`|Φ(U^{j←s}) − Φ(U)| ≤ a + tanh(|κ| B k j e) · d` (`B` the bound of `|χ|`): Part XXV's
`tilt_kernel_abs_le` with the oscillation `4 |κ| B k j e` of the log-density ratio. -/
theorem kernel_update_infl_tanh {φ : (E → G) → ℝ} (hφ : Measurable φ) {j e : E} (hje : j ≠ e)
    {a d : ℝ} (ha : ∀ U s, |φ (update U j s) - φ U| ≤ a)
    (hd : ∀ U s, |φ (update U e s) - φ U| ≤ d) (U : E → G) (s : G) :
    |linkKer plaq χ κ h e φ (update U j s) - linkKer plaq χ κ h e φ U| ≤
      a + tanh (|κ| * χ.bound * kPair plaq j e) * d := by
  have hm : ∀ V : E → G, Measurable fun t => wilsonExp plaq χ κ (update V e t) := fun V =>
    (measurable_wilsonExp plaq χ κ).comp (measurable_update V)
  have hint : Integrable (fun t => exp (wilsonExp plaq χ κ (update U e t))) h :=
    TiltTV.integrable_exp_of_le (hm U) (C := |κ| * (Fintype.card Pl * χ.bound)) fun t =>
      (le_abs_self _).trans (abs_wilsonExp_le plaq χ κ _)
  have key := TiltTV.tilt_kernel_abs_le (μ := h)
    (h₁ := fun t => wilsonExp plaq χ κ (update (update U j s) e t))
    (h₂ := fun t => wilsonExp plaq χ κ (update U e t))
    (g₁ := fun t => φ (update (update U j s) e t)) (g₂ := fun t => φ (update U e t))
    (hm (update U j s)) (hm U) hint
    (fun x y => wilsonExp_update_osc plaq χ κ (U := update U j s) (U' := U)
      (fun l hl => update_of_ne hl _ _) x y)
    (hφ.comp (measurable_update _)) (hφ.comp (measurable_update _))
    (fun t => by
      show |φ (update (update U j s) e t) - φ (update U e t)| ≤ a
      rw [update_comm hje]
      exact ha _ _)
    (fun x y => by
      have h1 := hd (update U e y) x
      rw [update_idem] at h1
      exact (abs_le.1 h1).2)
  have e4 : 4 * |κ| * χ.bound * (kPair plaq j e : ℝ) / 4 = |κ| * χ.bound * kPair plaq j e := by
    ring
  rw [e4] at key
  exact key

end Kernel

/-- **The pointwise influence step for SU(2)** (`(ℤ/nℤ)⁴`, every `n ≥ 1`, `κ = β/2`, `χ = Re tr`,
Haar measure, every real `β = β_W`, `j ≠ e`): if `a`, `d` bound the oscillations of a measurable
`φ` in `U_j` and in `U_e`, then `|Φ(U^{j←s}) − Φ(U)| ≤ a + |β| k j e · d` for the kernel average
`Φ = linkKer e φ` (`tanh x ≤ x`). -/
theorem su2_kernel_update_infl {n : ℕ} [NeZero n] (β : ℝ) {φ : (Link n → SU2) → ℝ}
    (hφ : Measurable φ) {j e : Link n} (hje : j ≠ e) {a d : ℝ}
    (ha : ∀ U s, |φ (update U j s) - φ U| ≤ a) (hd : ∀ U s, |φ (update U e s) - φ U| ≤ d)
    (U : Link n → SU2) (s : SU2) :
    |linkKer (plaqOf (n := n)) reTr (β / 2) haarSU2 e φ (update U j s) -
        linkKer (plaqOf (n := n)) reTr (β / 2) haarSU2 e φ U| ≤
      a + |β| * kPair (plaqOf (n := n)) j e * d := by
  have key := kernel_update_infl_tanh (plaqOf (n := n)) reTr (β / 2) haarSU2 hφ hje ha hd U s
  have e1 : |β / 2| * reTr.bound * (kPair (plaqOf (n := n)) j e : ℝ) =
      |β| * kPair (plaqOf (n := n)) j e := by
    rw [abs_div, abs_two]
    show |β| / 2 * 2 * _ = _
    ring
  rw [e1] at key
  have hd0 : 0 ≤ d := (abs_nonneg _).trans (hd U s)
  have hx : 0 ≤ |β| * (kPair (plaqOf (n := n)) j e : ℝ) := by positivity
  have h2 := mul_le_mul_of_nonneg_right (TiltTV.tanh_le_of_nonneg hx) hd0
  linarith

/-! ### The interfaces of the kernel part and of the continuous-version part, as hypotheses -/

section Assembly

variable (M : ℕ) [NeZero M] (β : ℝ)

/-- **The heat-bath kernel formula for single links, as a named hypothesis** (SU(2) on
`(ℤ/2Mℤ)⁴`, `μ ∝ exp((β/2) ∑ₚ Re tr U_p) ∏ dU`, `β = β_W`): the kernel average of a continuous
function is continuous, and `P_{e} f = E_μ[f | links ≠ e]` has the version `linkKer e g` whenever
`f ∈ H` has the continuous version `g`. These are the statements `su2_continuous_kerAvg` and
`su2_linkPj_kerAvg` of the heat-bath kernel part (`HeatBathKernel`), whose `kerAvg` unfolds to
`linkKer`. -/
structure KernelHyp : Prop where
  /-- The kernel average of a continuous function is continuous. -/
  continuous_ker : ∀ (e : Link (2 * M)) {g : (Link (2 * M) → SU2) → ℝ}, Continuous g →
    Continuous (linkKer (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 e g)
  /-- The kernel formula: `P_{e} f = linkKer e g` `μ`-a.e. when `f = g` `μ`-a.e., `g` continuous. -/
  linkPj_ker : ∀ (e : Link (2 * M)) {g : (Link (2 * M) → SU2) → ℝ}, Continuous g →
    ∀ (f : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2),
      ((f : Lp ℝ 2 (su2Wilson M β)) : (Link (2 * M) → SU2) → ℝ) =ᵐ[su2Wilson M β] g →
      ((((su2LinkPj M β e).P f : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2) :
        Lp ℝ 2 (su2Wilson M β)) : (Link (2 * M) → SU2) → ℝ)
        =ᵐ[su2Wilson M β] linkKer (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 e g

/-- **Continuous versions and oscillations, as a named hypothesis** on a domain `D ⊆ H`, a version
map `ver` and functionals `δ` (SU(2) on `(ℤ/2Mℤ)⁴`, `β = β_W`). The fields are the statements of
the continuous-version part (`ContinuousVersions`) for `D = contVer M β`, `ver = ver M β`,
`δ = linkOsc M β` (`δ j f = sup_{U,s} |ver f (U^{j←s}) − ver f U|`): `ver f` is continuous and
is a version of `f ∈ D`; `D` is the set of elements with a continuous version, closed under
linear combinations and dense in `H`; continuous versions are unique; `δ j` is the least bound of
the oscillation of `ver f` in `U_j`, subadditive and positively homogeneous on `D`; and
`‖f‖ ≤ 1 · ∑ⱼ δⱼ f` on `D`. -/
structure VersionHyp (D : Set (wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2))
    (ver : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 → (Link (2 * M) → SU2) → ℝ)
    (δ : Link (2 * M) → wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 → ℝ) : Prop where
  /-- `ver f` is continuous. -/
  continuous_ver : ∀ f : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2, Continuous (ver f)
  /-- `ver f` is a version of `f ∈ D`. -/
  coeFn_ae_eq_ver : ∀ {f : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2}, f ∈ D →
    ((f : Lp ℝ 2 (wilsonMeasure (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2)) :
      (Link (2 * M) → SU2) → ℝ) =ᵐ[wilsonMeasure (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2] ver f
  /-- An element with a continuous version lies in `D`. -/
  mem_of_ae_eq : ∀ {f : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2}
    {g : (Link (2 * M) → SU2) → ℝ}, Continuous g →
    ((f : Lp ℝ 2 (wilsonMeasure (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2)) :
      (Link (2 * M) → SU2) → ℝ) =ᵐ[wilsonMeasure (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2] g →
    f ∈ D
  /-- Uniqueness: `ver f` is every continuous version of `f`. -/
  ver_eq_of_ae_eq : ∀ {f : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2}
    {g : (Link (2 * M) → SU2) → ℝ}, Continuous g →
    ((f : Lp ℝ 2 (wilsonMeasure (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2)) :
      (Link (2 * M) → SU2) → ℝ) =ᵐ[wilsonMeasure (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2] g →
    ver f = g
  zero_mem : (0 : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2) ∈ D
  add_mem : ∀ f ∈ D, ∀ g ∈ D, f + g ∈ D
  smul_mem : ∀ (a : ℝ), ∀ f ∈ D, a • f ∈ D
  osc_nonneg : ∀ (j : Link (2 * M)) (f : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2),
    0 ≤ δ j f
  /-- `δ j f` bounds the oscillation of `ver f` in `U_j`. -/
  abs_sub_le_osc : ∀ (j : Link (2 * M)) (f : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2)
    (U : Link (2 * M) → SU2) (s : SU2), |ver f (update U j s) - ver f U| ≤ δ j f
  /-- `δ j f` is the least such bound. -/
  osc_le : ∀ (j : Link (2 * M)) (f : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2) {c : ℝ},
    (∀ (U : Link (2 * M) → SU2) (s : SU2), |ver f (update U j s) - ver f U| ≤ c) → δ j f ≤ c
  osc_add : ∀ j, ∀ f ∈ D, ∀ g ∈ D, δ j (f + g) ≤ δ j f + δ j g
  osc_smul : ∀ j (a : ℝ), 0 ≤ a → ∀ f ∈ D, δ j (a • f) ≤ a * δ j f
  /-- The comparison with `K = 1`. -/
  norm_le_sum_osc : ∀ f ∈ D, ‖f‖ ≤ 1 * ∑ j, δ j f
  /-- Density of `D` in `H`. -/
  dense : ∀ u : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2, u ∈ closure D

variable {M β}

/-- `ver (P_{e} f) = linkKer e (ver f)` for `f ∈ D` (kernel formula and uniqueness of continuous
versions). -/
theorem ver_linkPj {D : Set (wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2)}
    {ver : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 → (Link (2 * M) → SU2) → ℝ}
    {δ : Link (2 * M) → wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 → ℝ}
    (hK : KernelHyp M β) (hV : VersionHyp M β D ver δ) (e : Link (2 * M))
    {f : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2} (hf : f ∈ D) :
    ver ((su2LinkPj M β e).P f) = linkKer (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 e (ver f) :=
  hV.ver_eq_of_ae_eq (hK.continuous_ker e (hV.continuous_ver f))
    (hK.linkPj_ker e (hV.continuous_ver f) f (hV.coeFn_ae_eq_ver hf))

variable (M β)

/-- **The single-link Dobrushin input** (SU(2) on `(ℤ/2Mℤ)⁴`, `μ ∝ exp((β/2) ∑ₚ Re tr U_p) ∏ dU`,
every `M ≥ 1`, every real `β = β_W`; conditional on `KernelHyp M β` and `VersionHyp M β D ver δ`):
`SU2SingleLinkInfluence M β (18 |β|)` of Part XXIX with domain `D`, functionals `δ`, influence
matrix `c j e = |β| k j e` (`k j e` = number of plaquettes containing `j` and `e`, `kPair`),
column sums `≤ 18 |β|` (`su2_col_count`) and `K = 1`. The influence step is
`su2_kernel_update_infl`. -/
noncomputable def su2_singleLinkInfluence_of_hyps
    {D : Set (wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2)}
    {ver : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 → (Link (2 * M) → SU2) → ℝ}
    {δ : Link (2 * M) → wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 → ℝ}
    (hK : KernelHyp M β) (hV : VersionHyp M β D ver δ) :
    SU2SingleLinkInfluence M β (18 * |β|) where
  D := D
  δ := δ
  c j e := |β| * kPair (plaqOf (n := 2 * M)) j e
  K := 1
  mem e f hf := hV.mem_of_ae_eq (hK.continuous_ker e (hV.continuous_ver f))
    (hK.linkPj_ker e (hV.continuous_ver f) f (hV.coeFn_ae_eq_ver hf))
  nonneg j f _ := hV.osc_nonneg j f
  self e j hj f hf := by
    have hje : j = e := Finset.mem_singleton.1 hj
    subst hje
    refine le_antisymm (hV.osc_le j _ fun U s => ?_) (hV.osc_nonneg j _)
    rw [ver_linkPj hK hV j hf, linkKer_update_self, sub_self, abs_zero]
  infl e j hj f hf := by
    have hje : j ≠ e := fun h => hj (Finset.mem_singleton.2 h)
    rw [Finset.sum_singleton]
    refine hV.osc_le j _ fun U s => ?_
    rw [ver_linkPj hK hV e hf]
    exact su2_kernel_update_infl β (hV.continuous_ver f).measurable hje (hV.abs_sub_le_osc j f)
      (hV.abs_sub_le_osc e f) U s
  c_nonneg _ _ := mul_nonneg (abs_nonneg _) (Nat.cast_nonneg _)
  col e := by
    rw [← Finset.mul_sum, mul_comm]
    exact mul_le_mul_of_nonneg_right (su2_col_count_real (2 * M) e) (abs_nonneg β)
  K_nonneg := zero_le_one
  poinc := hV.norm_le_sum_osc
  dense := hV.dense
  zero_mem := hV.zero_mem
  add_mem := hV.add_mem
  smul_mem := hV.smul_mem
  δ_add := hV.osc_add
  δ_smul := hV.osc_smul

/-- `SU2SingleLinkInfluence M β (18 |β|)` is inhabited (every `M ≥ 1`, every real `β = β_W`;
conditional on `KernelHyp M β` and `VersionHyp M β D ver δ`). -/
theorem su2_singleLinkInfluence_nonempty_of_hyps
    {D : Set (wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2)}
    {ver : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 → (Link (2 * M) → SU2) → ℝ}
    {δ : Link (2 * M) → wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 → ℝ}
    (hK : KernelHyp M β) (hV : VersionHyp M β D ver δ) :
    Nonempty (SU2SingleLinkInfluence M β (18 * |β|)) :=
  ⟨su2_singleLinkInfluence_of_hyps M β hK hV⟩

/-! ### Consequences through Part XXIX -/

/-- **The single-link Poincaré inequality** (SU(2) on `(ℤ/2Mℤ)⁴`, every `M ≥ 1`, every real
`β = β_W`, non-trivial for `|β| < 1/18`; conditional on `KernelHyp M β` and
`VersionHyp M β D ver δ`): `(1 − 18|β|) ‖u‖² ≤ ∑ₑ ‖u − P_{e} u‖²` on `H`. -/
theorem su2_singleLinkPoincare_of_hyps
    {D : Set (wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2)}
    {ver : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 → (Link (2 * M) → SU2) → ℝ}
    {δ : Link (2 * M) → wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 → ℝ}
    (hK : KernelHyp M β) (hV : VersionHyp M β D ver δ) :
    SmallCouplingInputs.SingleLinkPoincare M β (1 - 18 * |β|) :=
  su2_singleLinkPoincare_small_beta (su2_singleLinkInfluence_of_hyps M β hK hV)

/-- **The coarse cube generator** (SU(2) on `(ℤ/2Mℤ)⁴`, straight blocking, coarse side-2 cubes at
every coarse base point, weights `1/16`, every `M ≥ 1`, every real `β = β_W`, non-trivial for
`|β| < 1/18`; conditional on `KernelHyp M β` and `VersionHyp M β D ver δ`):
`D_c ≥ ((1 − 18|β|)/128) I`. -/
theorem su2_coarse_gap_of_hyps
    {D : Set (wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2)}
    {ver : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 → (Link (2 * M) → SU2) → ℝ}
    {δ : Link (2 * M) → wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 → ℝ}
    (hK : KernelHyp M β) (hV : VersionHyp M β D ver δ) :
    ((1 - 18 * |β|) / 128) • LinearMap.id ≤ su2Dc M β (sideTwoCube M) (fun _ => 1 / 16) :=
  su2_coarse_gap_small_beta_of_linkInfluence (su2_singleLinkInfluence_of_hyps M β hK hV)

/-- **The fine cube generator** (SU(2) on `(ℤ/2Mℤ)⁴`, fine side-2 cubes at every base point,
weights `1/16`, every `M ≥ 1`, every real `β = β_W`, non-trivial for `|β| < 1/18`; conditional on
`KernelHyp M β` and `VersionHyp M β D ver δ`): `D ≥ ((1 − 18|β|)/64) I` on `H`. A finite-volume
lower bound for the heat-bath generator, not a mass gap. -/
theorem su2_gap_of_hyps
    {D : Set (wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2)}
    {ver : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 → (Link (2 * M) → SU2) → ℝ}
    {δ : Link (2 * M) → wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 → ℝ}
    (hK : KernelHyp M β) (hV : VersionHyp M β D ver δ) :
    ((1 - 18 * |β|) / 64) • LinearMap.id ≤ su2D M β (cube2 M) (fun _ => 1 / 16) :=
  su2_gap_small_beta_of_linkInfluence (su2_singleLinkInfluence_of_hyps M β hK hV)

/-- **A positive lower bound for `|β| < 1/18`** (SU(2) on `(ℤ/2Mℤ)⁴`, fine side-2 cubes, weights
`1/16`, every `M ≥ 1`, `|β| < 1/18`, `β = β_W`; conditional on `KernelHyp M β` and
`VersionHyp M β D ver δ`): `0 < (1 − 18|β|)/64` and `D ≥ ((1 − 18|β|)/64) I` on `H`, an
explicit positive constant that does not depend on `M` (the heat-bath generator in finite
volume; not a mass gap). -/
theorem su2_gap_pos_of_hyps
    {D : Set (wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2)}
    {ver : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 → (Link (2 * M) → SU2) → ℝ}
    {δ : Link (2 * M) → wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 → ℝ}
    (hK : KernelHyp M β) (hV : VersionHyp M β D ver δ) (hβ : |β| < 1 / 18) :
    0 < (1 - 18 * |β|) / 64 ∧
      ((1 - 18 * |β|) / 64) • LinearMap.id ≤ su2D M β (cube2 M) (fun _ => 1 / 16) :=
  ⟨div_pos (by linarith) (by norm_num), su2_gap_of_hyps M β hK hV⟩

end Assembly

end YangMills.StrongCoupling.SingleLinkDobrushin

/-! ### Discharge of the two named hypotheses

`KernelHyp M β` and `VersionHyp M β (contVer M β) (ver M β) (linkOsc M β)` hold for every `M ≥ 1`
and every real `β = β_W`: they are theorems of the heat-bath kernel part (`HeatBathKernel`) and of
the continuous-version part (`ContinuousVersions`) of this file. The single-link Dobrushin input and
its consequences through Part XXIX therefore hold with no hypothesis: finite-volume heat-bath
(Gibbs-sampler) bounds with constants independent of `M`, non-trivial for `|β| < 1/18`; not a
mass gap. -/

namespace YangMills.StrongCoupling.SingleLinkDobrushin

open YangMills.StrongCoupling.WilsonCube YangMills.StrongCoupling.WilsonSU2
  YangMills.StrongCoupling.SingleLinkInfluence YangMills.StrongCoupling.FibreReduction
  YangMills.StrongCoupling.ProductEndpoint

/-- `linkKer` is the single-link kernel `kerAvg` of the heat-bath kernel part, by definition. -/
theorem su2_linkKer_eq_kerAvg (M : ℕ) [NeZero M] (β : ℝ) (e : Link (2 * M))
    (g : (Link (2 * M) → SU2) → ℝ) :
    linkKer (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 e g =
      HeatBathKernel.kerAvg (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 e g := rfl

/-- `KernelHyp M β` holds (every `M ≥ 1`, every real `β = β_W`): the kernel part's
`su2_continuous_kerAvg` and `su2_linkPj_kerAvg` (its `kerAvg` unfolds to `linkKer`). -/
theorem su2_kernelHyp (M : ℕ) [NeZero M] (β : ℝ) : KernelHyp M β :=
  ⟨fun e _ hg => HeatBathKernel.su2_continuous_kerAvg M β e hg,
    fun e _ hg f hf => HeatBathKernel.su2_linkPj_kerAvg M β e hg f hf⟩

/-- `VersionHyp M β (contVer M β) (ver M β) (linkOsc M β)` holds (every `M ≥ 1`, every real
`β = β_W`): the theorems of the continuous-version part. -/
theorem su2_versionHyp (M : ℕ) [NeZero M] (β : ℝ) :
    VersionHyp M β (ContinuousVersions.contVer M β) (ContinuousVersions.ver M β)
      (ContinuousVersions.linkOsc M β) :=
  { continuous_ver := ContinuousVersions.continuous_ver M β
    coeFn_ae_eq_ver := fun hf => ContinuousVersions.coeFn_ae_eq_ver M β hf
    mem_of_ae_eq := fun hg hfg => ContinuousVersions.mem_contVer_of_ae_eq M β hg hfg
    ver_eq_of_ae_eq := fun hg hfg => ContinuousVersions.ver_eq_of_ae_eq M β hg hfg
    zero_mem := ContinuousVersions.zero_mem_contVer M β
    add_mem := ContinuousVersions.add_mem_contVer M β
    smul_mem := ContinuousVersions.smul_mem_contVer M β
    osc_nonneg := ContinuousVersions.linkOsc_nonneg M β
    abs_sub_le_osc := ContinuousVersions.abs_sub_le_linkOsc M β
    osc_le := fun j f _ h => ContinuousVersions.linkOsc_le M β j f h
    osc_add := ContinuousVersions.linkOsc_add M β
    osc_smul := ContinuousVersions.linkOsc_smul M β
    norm_le_sum_osc := ContinuousVersions.norm_le_sum_linkOsc M β
    dense := ContinuousVersions.dense_contVer M β }

/-- **The single-link Dobrushin input, with no hypothesis** (column sums `18 |β|`, below `1` iff
`|β| < 1/18`; SU(2) on `(ℤ/2Mℤ)⁴`,
`μ ∝ exp((β/2) ∑ₚ Re tr U_p) ∏ dU`, every `M ≥ 1`, every real `β = β_W`):
`SU2SingleLinkInfluence M β (18 |β|)` with `D` = elements of `H` with a continuous version,
`δⱼ` = oscillation in `Uⱼ`, `c j e = |β| k j e`, `K = 1`. -/
noncomputable def su2_singleLinkInfluence (M : ℕ) [NeZero M] (β : ℝ) :
    SU2SingleLinkInfluence M β (18 * |β|) :=
  su2_singleLinkInfluence_of_hyps M β (su2_kernelHyp M β) (su2_versionHyp M β)

/-- **The single-link Poincaré inequality** (SU(2) on `(ℤ/2Mℤ)⁴`, every `M ≥ 1`, every real
`β = β_W`, non-trivial for `|β| < 1/18`; no hypothesis): `(1 − 18|β|) ‖u‖² ≤ ∑ₑ ‖u − P_{e} u‖²`
for `u ∈ H` (centred gauge-invariant `L²`): a lower bound, independent of `M`, on the spectral
gap of the single-link heat-bath generator `∑ₑ (I − P_{e})` in finite volume; not a mass gap. -/
theorem su2_singleLinkPoincare (M : ℕ) [NeZero M] (β : ℝ) :
    SmallCouplingInputs.SingleLinkPoincare M β (1 - 18 * |β|) :=
  su2_singleLinkPoincare_of_hyps M β (su2_kernelHyp M β) (su2_versionHyp M β)

/-- **`D_c ≥ ((1 − 18|β|)/128) I`** (SU(2) on `(ℤ/2Mℤ)⁴`, straight blocking, coarse side-2 cubes,
weights `1/16`, every `M ≥ 1`, every real `β = β_W`; no hypothesis; non-trivial for
`|β| < 1/18`): the coarse cube heat-bath generator of the blocked law on `Y` (`hCoarseGap` of
Part XXII), with a constant independent of `M`; finite volume, not a mass gap. -/
theorem su2_coarse_gap (M : ℕ) [NeZero M] (β : ℝ) :
    ((1 - 18 * |β|) / 128) • LinearMap.id ≤ su2Dc M β (sideTwoCube M) (fun _ => 1 / 16) :=
  su2_coarse_gap_of_hyps M β (su2_kernelHyp M β) (su2_versionHyp M β)

/-- **`D ≥ ((1 − 18|β|)/64) I`** (SU(2) on `(ℤ/2Mℤ)⁴`, fine side-2 cubes, weights `1/16`, every
`M ≥ 1`, every real `β = β_W`; no hypothesis; non-trivial for `|β| < 1/18`). A finite-volume lower
bound for the heat-bath generator, uniform in `M`; not a mass gap. For `|β| ≤ 83/2070` (about
`0.040`) the constant is at least `1/230`, the constant of `su2_gap_small_beta_of_influences`
(Part XXIX), which needs `|β| ≤ 1/1000`, the block influence hypothesis and the residual bounds;
that theorem is a consistency check of the Schur-split interface, not a better estimate. -/
theorem su2_gap (M : ℕ) [NeZero M] (β : ℝ) :
    ((1 - 18 * |β|) / 64) • LinearMap.id ≤ su2D M β (cube2 M) (fun _ => 1 / 16) :=
  su2_gap_of_hyps M β (su2_kernelHyp M β) (su2_versionHyp M β)

/-- **A positive heat-bath bound for `|β| < 1/18`** (SU(2) on `(ℤ/2Mℤ)⁴`, fine side-2 cubes,
weights `1/16`, every `M ≥ 1`, `β = β_W`; no other hypothesis): `0 < (1 − 18|β|)/64` and
`D ≥ ((1 − 18|β|)/64) I`. Not a mass gap. -/
theorem su2_gap_pos (M : ℕ) [NeZero M] {β : ℝ} (hβ : |β| < 1 / 18) :
    0 < (1 - 18 * |β|) / 64 ∧
      ((1 - 18 * |β|) / 64) • LinearMap.id ≤ su2D M β (cube2 M) (fun _ => 1 / 16) :=
  su2_gap_pos_of_hyps M β (su2_kernelHyp M β) (su2_versionHyp M β) hβ

end YangMills.StrongCoupling.SingleLinkDobrushin

/-! # Part XXXIII. `YangMills.StrongCoupling.BlockHeatBathOsc`: the hypothesis `SU2HeatBathOsc M β` of Part XXVI for every `M ≥ 1` and every real `β`, hence `hcons` and `hFibre` for `M ≥ 2`, `|β| ≤ 1/228` with no hypothesis (new; uses Parts IV, VI, X, XXI, XXV, XXVI, XXX and XXXI) -/

/-!
# The block heat baths of Part XXVI: `SU2HeatBathOsc M β` from the kernel and version laws

## (a) Formal target

Part XXVI of this file reduces `hcons` for the constrained block heat baths
`P'ₓ = E_μ[· | links outside Bₓ]`, `Bₓ = cube2 M x ∖ Sk`, of the SU(2) Wilson measure
`μ ∝ exp((β/2) ∑ₚ Re tr U_p) ∏ dU` on `(ℤ/2Mℤ)⁴` (`β = β_W`, straight blocking, periodic boundary)
to one named hypothesis `SU2HeatBathOsc M β`, whose field `infl` carries the analytic content:
`δₑ(P'ₓ f) ≤ δₑ f + |β| kₑₓ ∑_{e' ∈ Bₓ} δₑ' f` for a non-skeleton link `e ∉ Bₓ`, with `kₑₓ = kCount M x e`
the number of plaquettes that contain `e` and meet `Bₓ`. The target here is that hypothesis for every
`M ≥ 1` and every real `β`, with `δₑ` the oscillation in `Uₑ` of the continuous version, from two
groups of exact statements that are stated here as hypotheses: the block kernel formula
(`BlockKernelLaws`: `P_V f` has the version `U ↦ ∫ g(U updated on V by W) dν_U(W)`, `ν_U` the
product Haar measure tilted by the Wilson exponent, which is continuous when `g` is) and the
continuous-version laws (`VersionLaws`: uniqueness of continuous versions, the oscillation
functionals, density of the continuous versions in `H`).

## (b) What is proved

* `wilsonExp_block_window` (the block log-density oscillation): if two families of configurations
  `F ξ`, `F' ξ` agree off a link `e` and are constant off `Bₓ`, then
  `ξ ↦ wilsonExp(F ξ) − wilsonExp(F' ξ)` takes values in an interval of length `4 |β| kₑₓ`
  (plaquettes not containing `e` cancel, plaquettes containing `e` and not meeting `Bₓ` give a
  constant, the `kₑₓ` others give `(β/2)·[−4, 4]` each). The count is Part XXVI's `kCount`.
* `abs_sub_le_sum_of_eqOff` (oscillation over a block): if `|g(U with Uⱼ := s) − g U| ≤ dⱼ` for
  the links `j` of a finite family, then `|g V − g V'| ≤ ∑ⱼ dⱼ` whenever `V`, `V'` agree off the
  family (one link at a time).
* `block_kernel_infl` (the influence step at the level of versions): for a measurable `g` with
  link oscillations `≤ d`, a non-skeleton link `e ∉ Bₓ`, any configuration `U` and `s ∈ SU(2)`, the
  block kernel average of `g` changes by at most `d e + |β| kₑₓ ∑_{k ∈ Bₓ} d k` when `Uₑ` is
  replaced by `s`. Proof: `kernel_infl` and `tiltTVBound_holds` of Part XXVI with the window of
  length `L = 4 |β| kₑₓ` above, the block window of length `∑_{k ∈ Bₓ} d k` (the infimum of the
  integrand as lower end), and `tanh (L/4) ≤ L/4` (Part XXV).
* `norm_le_sum_nsk` (comparison on `ker E_μ[· | σ(Sk)]`, `K = 1`): if `f` has a continuous version
  and `E_μ[f | σ(Sk)] = 0`, then `‖f‖ ≤ ∑_{e ∉ Sk} δₑ f` (the kernel average over the non-skeleton
  links of the version vanishes identically, and the version moves by at most `∑_{e ∉ Sk} δₑ f`
  under the block update). `dense_ker`: the continuous versions with `E_μ[f | σ(Sk)] = 0` are dense
  in `H ∩ ker E_μ[· | σ(Sk)]` (apply `I − E_μ[· | σ(Sk)]` to the dense set of continuous versions).
* `su2HeatBathOsc_of_laws`: `BlockKernelLaws M β upd → VersionLaws M β D₀ ver δ → SU2HeatBathOsc M β`
  (every `M ≥ 1`, every real `β`), with domain `D₀ ∩ ker E_μ[· | σ(Sk)]`, `δₑ` the given
  oscillation functional and `K = 1`. `su2_hcons_of_laws`: for `M ≥ 2` and `|β| ≤ 1/228`,
  `(1/2)(1 − 228 |β|)² ‖u‖² ≤ ∑ₓ (1/16) ‖u − P'ₓ u‖²` on `H ∩ ker Π`, through
  `su2_hcons_of_osc` of Part XXVI.
* The discharge (closing section of this part): `blockKernelLaws_holds` (the block kernel formula of
  the heat-bath kernel part of this file; `blockKer (blockUpd V)` is its `kerAvgV V` by definition,
  `blockKer_eq_kerAvgV`) and `versionLaws_holds` (the continuous-version part) prove both laws for
  every `M ≥ 1` and every real `β`. Hence, with no hypothesis: `su2HeatBathOsc_holds M β :
  SU2HeatBathOsc M β` (every `M ≥ 1`, every real `β`; domain the continuous versions `f` with
  `E_μ[f | σ(Sk)] = 0`, `δₑ` the oscillation in `Uₑ`, `K = 1`) and `su2_hcons_discharged`
  (`hcons` with `λ = (1/2)(1 − 228 |β|)²` for `M ≥ 2`, `|β| ≤ 1/228`; positive for
  `|β| < 1/228`).

## (c) What remains open

The `_of_laws` theorems take `BlockKernelLaws` and `VersionLaws` as arguments; these restate the
block kernel formula of the heat-bath kernel part and the statements of the continuous-version part
(uniqueness, versions, oscillation functionals, density in `H`), and they are proved in the closing
section (see (b)). The coefficient `tanh(|β| kₑₓ)` is replaced by the larger `|β| kₑₓ`. `hResidual`
at `β ≠ 0` is untouched (`hCoarseGap` at `β ≠ 0` comes from the single-link part
`SingleLinkDobrushin`, not from this one), the count `228` needs `M ≥ 2` (Part XXVI; the count `84`
at `M = 1` is not formalised), and nothing here concerns weak coupling. The constant
`(1/2)(1 − 228 |β|)²` is that of the sweep form used here, not a best constant. No novelty is
claimed: oscillation contraction under a systematic scan is the mechanism of Dobrushin-type proofs
for systematic scan (Dyer–Goldberg–Jerrum, Combin. Probab. Comput. 17 (2008) 761–779, finite spin
systems; block updates: Pedersen, MFCS 2007, LNCS, 264–275), and under Dobrushin's condition
(Dobrushin, Theory Probab. Appl. 15 (1970) 458–486) heat-bath gaps with block updates are known
for general spin spaces (L. Wu, Ann. Probab. 34 (2006) 1960–1989, Thm 3.1 and Rem. 3.2;
random-scan form). Here the influence estimate uses the tilt bound of Part XXV.

## (d) Axioms and checks

Only `propext`, `Classical.choice` and `Quot.sound` (the module axiom audit covers every headline);
no sorry, admit, axiom declarations, native_decide or implemented_by, and no `set_option`. Uses
Parts IV, VI, X, XII, XVII, XXI, XXV and XXVI of this file; the closing section also uses the
heat-bath kernel part and the continuous-version part.

## (e) Scope

This is not a proof of a mass gap. It concerns the constrained cube heat-bath (Gibbs-sampler)
dynamics of the finite-volume Wilson measure, which resample the non-skeleton links of a cube with
the skeleton fixed (the fluctuation field at fixed blocked field), not the transfer matrix.
`SU2HeatBathOsc M β` holds for every `M ≥ 1` and every real `β`; `hcons` is non-trivial only at
deep strong coupling (`|β_W| < 1/228 ≈ 0.0044`, `M ≥ 2`). `hcons` is the fibre input of the
Schur split, on `H ∩ ker Π` (Part X's `su2_hFibre_of_constrained` turns it into `hFibre` for the
cube generator), not a bound on the whole generator. No constant depends on `M`, and nothing
here is an infinite-volume or continuum statement.
-/

namespace YangMills.StrongCoupling.BlockHeatBathOsc

open Finset YangMills.StrongCoupling.WilsonCube YangMills.StrongCoupling.WilsonSU2
  YangMills.StrongCoupling.FibreReduction YangMills.StrongCoupling.SweepContraction
  YangMills.StrongCoupling.HeatBathInfluence

/-! ### The block log-density oscillation -/

section LogDensity

variable (M : ℕ) [NeZero M]

/-- The holonomy of a plaquette depends only on the variables on its four links. -/
theorem plaq_hol_congr {n : ℕ} (q : PlaqIdx n) {V V' : Link n → SU2}
    (h : ∀ l ∈ plaqLinks q, V l = V' l) : hol (plaqOf q) V = hol (plaqOf q) V' := by
  have h1 := h (plaqOf q).l1 (by simp [plaqLinks])
  have h2 := h (plaqOf q).l2 (by simp [plaqLinks])
  have h3 := h (plaqOf q).l3 (by simp [plaqLinks])
  have h4 := h (plaqOf q).l4 (by simp [plaqLinks])
  simp only [hol]
  rw [h1, h2, h3, h4]

/-- **The block log-density oscillation** (SU(2) on `(ℤ/2Mℤ)⁴`, `μ ∝ exp((β/2) ∑ₚ Re tr U_p) ∏ dU`,
`β = β_W`, every `M ≥ 1`, every real `β`, straight blocking, block `Bₓ = cube2 M x ∖ Sk`). If the
configurations `F ξ` and `F' ξ` agree off the link `e`, and `F ξ = U`, `F' ξ = U'` off `Bₓ`, then
`ξ ↦ wilsonExp(F ξ) − wilsonExp(F' ξ)` takes values in `[m, m + 4 |β| kₑₓ]` for some `m`, where
`kₑₓ = kCount M x e` counts the plaquettes that contain `e` and meet `Bₓ` (Part XXVI). In the
application `F ξ` and `F' ξ` are `U` with `Uₑ := s` and `U`, both updated on `Bₓ` by `ξ`. -/
theorem wilsonExp_block_window (β : ℝ) (x : Site (2 * M)) {e : Link (2 * M)}
    {Ξ : Type*} (F F' : Ξ → Link (2 * M) → SU2) (U U' : Link (2 * M) → SU2)
    (hFF : ∀ ξ l, l ≠ e → F ξ l = F' ξ l)
    (hF : ∀ ξ l, l ∉ cube2 M x \ skel (straightBlocking M) → F ξ l = U l)
    (hF' : ∀ ξ l, l ∉ cube2 M x \ skel (straightBlocking M) → F' ξ l = U' l) :
    ∃ m : ℝ, ∀ ξ, m ≤ wilsonExp plaqOf reTr (β / 2) (F ξ) - wilsonExp plaqOf reTr (β / 2) (F' ξ) ∧
      wilsonExp plaqOf reTr (β / 2) (F ξ) - wilsonExp plaqOf reTr (β / 2) (F' ξ) ≤
        m + 4 * |β| * (kCount M x e : ℝ) := by
  classical
  set B := cube2 M x \ skel (straightBlocking M)
  set Pq : PlaqIdx (2 * M) → Prop := fun q => e ∈ plaqLinks q ∧ ∃ l ∈ plaqLinks q, l ∈ B
  have hk0 : (univ.filter Pq).card = kCount M x e := by
    unfold kCount
    exact congrArg Finset.card (Finset.filter_congr fun q _ => Iff.rfl)
  have hk : ((univ.filter Pq).card : ℝ) = kCount M x e := by rw [hk0]
  set c : PlaqIdx (2 * M) → ℝ := fun q =>
    if e ∈ plaqLinks q then reTr.toFun (hol (plaqOf q) U) - reTr.toFun (hol (plaqOf q) U') else 0
    with hc
  set d : Ξ → PlaqIdx (2 * M) → ℝ := fun ξ q =>
    reTr.toFun (hol (plaqOf q) (F ξ)) - reTr.toFun (hol (plaqOf q) (F' ξ)) with hd
  have hd_off : ∀ ξ q, ¬ Pq q → d ξ q = c q := by
    intro ξ q hq
    by_cases he : e ∈ plaqLinks q
    · have hnB : ∀ l ∈ plaqLinks q, l ∉ B := fun l hl hlB => hq ⟨he, l, hl, hlB⟩
      simp only [hd, hc, if_pos he]
      rw [plaq_hol_congr q (fun l hl => hF ξ l (hnB l hl)),
        plaq_hol_congr q (fun l hl => hF' ξ l (hnB l hl))]
    · simp only [hd, hc, if_neg he]
      rw [plaq_hol_congr q (fun l hl => hFF ξ l (fun hle => he (hle ▸ hl))), sub_self]
  have hd_bd : ∀ ξ q, |d ξ q| ≤ 4 := by
    intro ξ q
    have h1 := reTr.abs_le (hol (plaqOf q) (F ξ))
    have h2 := reTr.abs_le (hol (plaqOf q) (F' ξ))
    have hb : reTr.bound = 2 := rfl
    rw [hb] at h1 h2
    calc |d ξ q| ≤ |reTr.toFun (hol (plaqOf q) (F ξ))| + |reTr.toFun (hol (plaqOf q) (F' ξ))| :=
          abs_sub _ _
      _ ≤ 4 := by linarith
  have hsplit : ∀ ξ, wilsonExp plaqOf reTr (β / 2) (F ξ) - wilsonExp plaqOf reTr (β / 2) (F' ξ) =
      β / 2 * (∑ q ∈ univ.filter Pq, d ξ q) + β / 2 * ∑ q ∈ univ.filter (fun q => ¬ Pq q), c q := by
    intro ξ
    have h1 : wilsonExp plaqOf reTr (β / 2) (F ξ) - wilsonExp plaqOf reTr (β / 2) (F' ξ) =
        β / 2 * ∑ q, d ξ q := by
      rw [wilsonExp, wilsonExp, ← mul_sub, ← Finset.sum_sub_distrib]
    have h2 : ∑ q ∈ univ.filter (fun q => ¬ Pq q), d ξ q =
        ∑ q ∈ univ.filter (fun q => ¬ Pq q), c q :=
      Finset.sum_congr rfl fun q hq => hd_off ξ q (Finset.mem_filter.1 hq).2
    rw [h1, ← Finset.sum_filter_add_sum_filter_not univ Pq, h2, mul_add]
  refine ⟨β / 2 * ∑ q ∈ univ.filter (fun q => ¬ Pq q), c q - 2 * |β| * kCount M x e, fun ξ => ?_⟩
  rw [hsplit ξ, ← hk]
  have hS : |∑ q ∈ univ.filter Pq, d ξ q| ≤ 4 * (univ.filter Pq).card := by
    calc |∑ q ∈ univ.filter Pq, d ξ q| ≤ ∑ q ∈ univ.filter Pq, |d ξ q| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ q ∈ univ.filter Pq, (4 : ℝ) := Finset.sum_le_sum fun q _ => hd_bd ξ q
      _ = 4 * (univ.filter Pq).card := by rw [Finset.sum_const, nsmul_eq_mul, mul_comm]
  have hT : |β / 2 * ∑ q ∈ univ.filter Pq, d ξ q| ≤ 2 * |β| * (univ.filter Pq).card := by
    rw [abs_mul, abs_div, abs_two]
    calc |β| / 2 * |∑ q ∈ univ.filter Pq, d ξ q| ≤ |β| / 2 * (4 * (univ.filter Pq).card) :=
          mul_le_mul_of_nonneg_left hS (by positivity)
      _ = 2 * |β| * (univ.filter Pq).card := by ring
  obtain ⟨h1, h2⟩ := abs_le.1 hT
  constructor <;> linarith

end LogDensity

/-! ### The oscillation over a block -/

section Telescope

variable {E G J : Type*} [DecidableEq E]

/-- **Oscillation over a finite family of coordinates.** If changing the coordinate `ι j` moves `g`
by at most `d j` for every `j ∈ B`, then `|g V − g V'| ≤ ∑_{j ∈ B} d j` whenever `V` and `V'` agree
off the coordinates `ι j`, `j ∈ B` (change one coordinate at a time). -/
theorem abs_sub_le_sum_of_eqOff (g : (E → G) → ℝ) (ι : J → E) (d : J → ℝ) (B : Finset J)
    (hd : ∀ j ∈ B, ∀ U s, |g (Function.update U (ι j) s) - g U| ≤ d j) (V V' : E → G)
    (hV : ∀ l, (∀ j ∈ B, ι j ≠ l) → V l = V' l) : |g V - g V'| ≤ ∑ j ∈ B, d j := by
  classical
  induction B using Finset.induction_on generalizing V with
  | empty =>
    have hVV : V = V' := funext fun l => hV l fun j hj => absurd hj (Finset.notMem_empty j)
    rw [hVV, sub_self, abs_zero, Finset.sum_empty]
  | insert a B ha ih =>
    rw [Finset.sum_insert ha]
    have h1 : |g (Function.update V (ι a) (V' (ι a))) - g V| ≤ d a :=
      hd a (Finset.mem_insert_self a B) V (V' (ι a))
    have h2 : |g (Function.update V (ι a) (V' (ι a))) - g V'| ≤ ∑ j ∈ B, d j := by
      refine ih (fun j hj => hd j (Finset.mem_insert_of_mem hj)) _ fun l hl => ?_
      by_cases hla : l = ι a
      · rw [hla, Function.update_self]
      · rw [Function.update_of_ne hla]
        refine hV l fun j hj => ?_
        rcases Finset.mem_insert.1 hj with rfl | hj
        · exact fun h => hla h.symm
        · exact hl j hj
    calc |g V - g V'| = |(g (Function.update V (ι a) (V' (ι a))) - g V') -
          (g (Function.update V (ι a) (V' (ι a))) - g V)| := by congr 1; ring
      _ ≤ |g (Function.update V (ι a) (V' (ι a))) - g V'| +
          |g (Function.update V (ι a) (V' (ι a))) - g V| := abs_sub _ _
      _ ≤ ∑ j ∈ B, d j + d a := add_le_add h2 h1
      _ = d a + ∑ j ∈ B, d j := add_comm _ _

end Telescope

/-! ### The influence step for the block kernels, at the level of versions -/

section KernelOsc

open MeasureTheory

variable (M : ℕ) [NeZero M]

omit [NeZero M] in
/-- An update map with the coordinate laws of a block update (`W i` on `V`, `U i` off `V`) is
measurable in `W`. -/
theorem measurable_upd {V : Set (Link (2 * M))}
    (upd : (Link (2 * M) → SU2) → (Link (2 * M) → SU2) → (Link (2 * M) → SU2))
    (h1 : ∀ i ∈ V, ∀ W U, upd W U i = W i) (h2 : ∀ i ∉ V, ∀ W U, upd W U i = U i)
    (U : Link (2 * M) → SU2) : Measurable fun W => upd W U := by
  refine measurable_pi_lambda _ fun i => ?_
  by_cases hi : i ∈ V
  · have hfun : (fun W => upd W U i) = fun W => W i := funext fun W => h1 i hi W U
    rw [hfun]
    exact measurable_pi_apply i
  · have hfun : (fun W => upd W U i) = fun _ => U i := funext fun W => h2 i hi W U
    rw [hfun]
    exact measurable_const

/-- **The influence step for the block heat-bath kernels, at the level of versions** (SU(2) on
`(ℤ/2Mℤ)⁴`, `β = β_W`, every `M ≥ 1`, every real `β`, straight blocking). Let `upd W U` be `U`
updated on `Bₓ = cube2 M x ∖ Sk` by `W`, let `g` be measurable with `|g(U with Uⱼ := s) − g U| ≤ d j`
for every non-skeleton link `j`, and let `e ∉ Bₓ` be a non-skeleton link. Then the block average of
`g` (over the product Haar measure tilted by the Wilson exponent of the updated configuration)
changes by at most `d e + |β| kₑₓ ∑_{k ∈ Bₓ} d k` when `Uₑ` is replaced by `s`. Proof:
`kernel_infl` with `tiltTVBound_holds` (Part XXVI), the window `wilsonExp_block_window` of length
`L = 4 |β| kₑₓ`, the window of length `∑_{k ∈ Bₓ} d k` of the integrand
(`abs_sub_le_sum_of_eqOff`, lower end the infimum), and `tanh (L/4) ≤ L/4` (Part XXV). -/
theorem block_kernel_infl (β : ℝ) (x : Site (2 * M))
    (upd : (Link (2 * M) → SU2) → (Link (2 * M) → SU2) → (Link (2 * M) → SU2))
    (h1 : ∀ i ∈ cube2 M x \ skel (straightBlocking M), ∀ W U, upd W U i = W i)
    (h2 : ∀ i ∉ cube2 M x \ skel (straightBlocking M), ∀ W U, upd W U i = U i)
    {g : (Link (2 * M) → SU2) → ℝ} (hg : Measurable g) (d : NSk M → ℝ)
    (hd : ∀ j U s, |g (Function.update U j.1 s) - g U| ≤ d j)
    (e : NSk M) (he : e ∉ su2Block M x) (U : Link (2 * M) → SU2) (s : SU2) :
    |∫ W, g (upd W (Function.update U e.1 s)) ∂((Measure.pi fun _ : Link (2 * M) => haarSU2).tilted
        fun W => wilsonExp plaqOf reTr (β / 2) (upd W (Function.update U e.1 s))) -
      ∫ W, g (upd W U) ∂((Measure.pi fun _ : Link (2 * M) => haarSU2).tilted
        fun W => wilsonExp plaqOf reTr (β / 2) (upd W U))| ≤
      d e + |β| * (kCount M x e.1 : ℝ) * ∑ k ∈ su2Block M x, d k := by
  have heV : e.1 ∉ cube2 M x \ skel (straightBlocking M) := fun h => he ((mem_su2Block M).2 h.1)
  have hupd_e : ∀ W, upd W (Function.update U e.1 s) = Function.update (upd W U) e.1 s := by
    intro W
    funext i
    rcases eq_or_ne i e.1 with rfl | hie
    · rw [h2 _ heV, Function.update_self, Function.update_self]
    · rw [Function.update_of_ne hie]
      by_cases hi : i ∈ cube2 M x \ skel (straightBlocking M)
      · rw [h1 i hi, h1 i hi]
      · rw [h2 i hi, h2 i hi, Function.update_of_ne hie]
  obtain ⟨m, hm⟩ := wilsonExp_block_window M β x (e := e.1) (fun W => upd W (Function.update U e.1 s))
    (fun W => upd W U) (Function.update U e.1 s) U
    (fun W l hl => by
      show upd W (Function.update U e.1 s) l = upd W U l
      rw [hupd_e, Function.update_of_ne hl])
    (fun W l hl => h2 l hl W _) (fun W l hl => h2 l hl W _)
  have hd0 : ∀ j, 0 ≤ d j := fun j => (abs_nonneg _).trans (hd j (fun _ => 1) 1)
  have htel : ∀ W W', |g (upd W U) - g (upd W' U)| ≤ ∑ k ∈ su2Block M x, d k := by
    intro W W'
    refine abs_sub_le_sum_of_eqOff g Subtype.val d (su2Block M x) (fun j _ V t => hd j V t) _ _
      fun l hl => ?_
    by_cases hlV : l ∈ cube2 M x \ skel (straightBlocking M)
    · exact absurd rfl (hl ⟨l, hlV.2⟩ ((mem_su2Block M).2 hlV.1))
    · rw [h2 l hlV, h2 l hlV]
  set S := ∑ k ∈ su2Block M x, d k with hS
  have hS0 : 0 ≤ S := Finset.sum_nonneg fun j _ => hd0 j
  have hbdd : BddBelow (Set.range fun W => g (upd W U)) :=
    ⟨g (upd (fun _ => 1) U) - S, by
      rintro _ ⟨W, rfl⟩
      have := htel (fun _ => 1) W
      rw [abs_le] at this
      linarith⟩
  have hF'b : ∀ W, (⨅ W', g (upd W' U)) ≤ g (upd W U) ∧
      g (upd W U) ≤ (⨅ W', g (upd W' U)) + S := by
    intro W
    refine ⟨ciInf_le hbdd W, ?_⟩
    have : g (upd W U) - S ≤ ⨅ W', g (upd W' U) := le_ciInf fun W' => by
      have := htel W W'
      rw [abs_le] at this
      linarith
    linarith
  have hC := fun V => abs_wilsonExp_le (plaqOf (n := 2 * M)) reTr (β / 2) V
  have key := kernel_infl tiltTVBound_holds (Measure.pi fun _ : Link (2 * M) => haarSU2)
    ((measurable_wilsonExp (plaqOf (n := 2 * M)) reTr (β / 2)).comp
      (measurable_upd M upd h1 h2 (Function.update U e.1 s)))
    ((measurable_wilsonExp (plaqOf (n := 2 * M)) reTr (β / 2)).comp (measurable_upd M upd h1 h2 U))
    (hg.comp (measurable_upd M upd h1 h2 (Function.update U e.1 s)))
    (hg.comp (measurable_upd M upd h1 h2 U))
    (fun W => hC _) (fun W => hC _) hm
    (fun W => by
      show |g (upd W (Function.update U e.1 s)) - g (upd W U)| ≤ d e
      rw [hupd_e]
      exact hd e _ s) hF'b
  have ht : Real.tanh (4 * |β| * (kCount M x e.1 : ℝ) / 4) ≤ |β| * (kCount M x e.1 : ℝ) := by
    have := YangMills.StrongCoupling.TiltTV.tanh_quarter_le
      (L := 4 * |β| * (kCount M x e.1 : ℝ)) (by positivity)
    linarith
  calc _ ≤ d e + Real.tanh (4 * |β| * (kCount M x e.1 : ℝ) / 4) * S := key
    _ ≤ d e + |β| * (kCount M x e.1 : ℝ) * S := by
      have := mul_le_mul_of_nonneg_right ht hS0
      linarith

end KernelOsc

/-! ### Two facts about probability measures -/

section Generic

open MeasureTheory

/-- If `|c − F ξ| ≤ S` for every `ξ` and `F` has integral `0` against a tilt of a probability measure
by a bounded exponent, then `|c| ≤ S`. -/
theorem abs_le_of_tilted_integral_eq_zero {Ξ : Type} [MeasurableSpace Ξ] (ν0 : Measure Ξ)
    [IsProbabilityMeasure ν0] {w F : Ξ → ℝ} (hw : Measurable w) {C : ℝ} (hwC : ∀ ξ, |w ξ| ≤ C)
    (hF : Measurable F) {c S : ℝ} (h : ∀ ξ, |c - F ξ| ≤ S)
    (h0 : ∫ ξ, F ξ ∂(ν0.tilted w) = 0) : |c| ≤ S := by
  have := isProbabilityMeasure_tilted (integrable_exp_of_abs_le ν0 hw hwC)
  have hint : Integrable F (ν0.tilted w) :=
    Integrable.of_bound hF.aestronglyMeasurable (|c| + S) (ae_of_all _ fun ξ => by
      have hξ := h ξ
      rw [Real.norm_eq_abs]
      rw [abs_le] at hξ ⊢
      constructor <;> cases abs_cases c <;> linarith)
  have hc : c = ∫ ξ, (c - F ξ) ∂(ν0.tilted w) := by
    rw [integral_sub (integrable_const c) hint, integral_const, probReal_univ, one_smul, h0,
      sub_zero]
  rw [hc]
  have hI := norm_integral_le_of_norm_le_const (μ := ν0.tilted w) (f := fun ξ => c - F ξ) (C := S)
    (ae_of_all _ fun ξ => by rw [Real.norm_eq_abs]; exact h ξ)
  rw [Real.norm_eq_abs, probReal_univ, mul_one] at hI
  exact hI

/-- On a probability space, an `L²` class with a representative bounded by `C ≥ 0` has norm
`≤ C`. -/
theorem norm_le_of_forall_abs_le {α : Type*} [MeasurableSpace α] {μ : Measure α}
    [IsProbabilityMeasure μ] (f : Lp ℝ 2 μ) {g : α → ℝ} (hfg : f =ᵐ[μ] g) {C : ℝ} (hC : 0 ≤ C)
    (hg : ∀ x, |g x| ≤ C) : ‖f‖ ≤ C := by
  have hL := Lp.norm_le_of_ae_bound (p := 2) hC (hfg.mono fun x hx => by
    rw [hx, Real.norm_eq_abs]; exact hg x)
  have hone : measureUnivNNReal μ = 1 := by
    rw [← ENNReal.coe_inj, coe_measureUnivNNReal, measure_univ, ENNReal.coe_one]
  rwa [hone, NNReal.coe_one, Real.one_rpow, one_mul] at hL

end Generic

/-! ### The kernel and version laws, and the assembly of `SU2HeatBathOsc` -/

section Laws

open MeasureTheory

variable (M : ℕ) [NeZero M] (β : ℝ)

/-- The block heat-bath average `U ↦ ∫ g(upd W U) dν_U(W)` for an update map `upd`, with `ν_U` the
product Haar measure on `Link (2M) → SU(2)` tilted by `W ↦ wilsonExp(upd W U)` (SU(2),
`κ = β/2`). For `upd W U` = `U` updated on `V` by `W` this is the conditional expectation of `g`
given the links outside `V` (the block kernel formula). -/
noncomputable def blockKer
    (upd : (Link (2 * M) → SU2) → (Link (2 * M) → SU2) → (Link (2 * M) → SU2))
    (g : (Link (2 * M) → SU2) → ℝ) (U : Link (2 * M) → SU2) : ℝ :=
  ∫ W, g (upd W U) ∂((Measure.pi fun _ : Link (2 * M) => haarSU2).tilted
    fun W => wilsonExp (plaqOf (n := 2 * M)) reTr (β / 2) (upd W U))

/-- **The block kernel formula, as a named statement** (SU(2) on `(ℤ/2Mℤ)⁴`,
`μ ∝ exp((β/2) ∑ₚ Re tr U_p) ∏ dU`, every `M ≥ 1`, every real `β = β_W`): `upd V W U` is `U` updated
on `V` by `W`, and for every link set `V` and every continuous `g` the block average
`blockKer (upd V) g` is continuous and is a version of `P_V f = E_μ[f | links outside V]` whenever
`g` is a version of `f ∈ H`. -/
structure BlockKernelLaws (upd : Set (Link (2 * M)) → (Link (2 * M) → SU2) →
    (Link (2 * M) → SU2) → (Link (2 * M) → SU2)) : Prop where
  upd_of_mem : ∀ {V : Set (Link (2 * M))} {i : Link (2 * M)}, i ∈ V →
    ∀ W U : Link (2 * M) → SU2, upd V W U i = W i
  upd_of_not_mem : ∀ {V : Set (Link (2 * M))} {i : Link (2 * M)}, i ∉ V →
    ∀ W U : Link (2 * M) → SU2, upd V W U i = U i
  continuous_ker : ∀ (V : Set (Link (2 * M))) {g : (Link (2 * M) → SU2) → ℝ}, Continuous g →
    Continuous (blockKer M β (upd V) g)
  wilsonPj_ker : ∀ (V : Set (Link (2 * M))) {g : (Link (2 * M) → SU2) → ℝ}, Continuous g →
    ∀ (f : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2),
    ((f : Lp ℝ 2 (su2Wilson M β)) : (Link (2 * M) → SU2) → ℝ) =ᵐ[su2Wilson M β] g →
    ((((wilsonPj (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 V).P f :
      wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2) : Lp ℝ 2 (su2Wilson M β)) :
      (Link (2 * M) → SU2) → ℝ) =ᵐ[su2Wilson M β] blockKer M β (upd V) g

/-- **The continuous-version laws, as a named statement** (SU(2) on `(ℤ/2Mℤ)⁴`, every `M ≥ 1`,
every real `β = β_W`), for a set `D₀ ⊆ H`, a version map `ver` and functionals `δ`: `ver f` is
continuous and is a version of `f` on `D₀`; an element of `H` with a continuous version `g` lies in
`D₀` and has `ver f = g`; `D₀` is closed under addition and real scalar multiplication;
`0 ≤ δ j f`, `|ver f (U with Uⱼ := s) − ver f U| ≤ δ j f`, and `δ j f` is below every such bound;
`D₀` is dense in `H`. Intended instance: `D₀` = the elements of `H` with a continuous version,
`δ j` = the oscillation in `Uⱼ` of the version. -/
structure VersionLaws (D0 : Set (wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2))
    (ver : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 → (Link (2 * M) → SU2) → ℝ)
    (δ : Link (2 * M) → wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 → ℝ) : Prop where
  continuous_ver : ∀ f : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2, Continuous (ver f)
  coeFn_ae_eq_ver : ∀ {f : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2}, f ∈ D0 →
    ((f : Lp ℝ 2 (su2Wilson M β)) : (Link (2 * M) → SU2) → ℝ) =ᵐ[su2Wilson M β] ver f
  mem_contVer_of_ae_eq : ∀ {f : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2}
    {g : (Link (2 * M) → SU2) → ℝ}, Continuous g →
    ((f : Lp ℝ 2 (su2Wilson M β)) : (Link (2 * M) → SU2) → ℝ) =ᵐ[su2Wilson M β] g → f ∈ D0
  ver_eq_of_ae_eq : ∀ {f : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2}
    {g : (Link (2 * M) → SU2) → ℝ}, Continuous g →
    ((f : Lp ℝ 2 (su2Wilson M β)) : (Link (2 * M) → SU2) → ℝ) =ᵐ[su2Wilson M β] g → ver f = g
  add_mem_contVer : ∀ f ∈ D0, ∀ g ∈ D0, f + g ∈ D0
  smul_mem_contVer : ∀ (a : ℝ), ∀ f ∈ D0, a • f ∈ D0
  linkOsc_nonneg : ∀ (j : Link (2 * M)) (f : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2),
    0 ≤ δ j f
  abs_sub_le_linkOsc : ∀ (j : Link (2 * M))
    (f : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2) (U : Link (2 * M) → SU2) (s : SU2),
    |ver f (Function.update U j s) - ver f U| ≤ δ j f
  linkOsc_le : ∀ (j : Link (2 * M)) (f : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2)
    {c : ℝ}, (∀ (U : Link (2 * M) → SU2) (s : SU2), |ver f (Function.update U j s) - ver f U| ≤ c) →
    δ j f ≤ c
  dense_contVer : ∀ u : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2, u ∈ closure D0

variable {M β}
variable {upd : Set (Link (2 * M)) → (Link (2 * M) → SU2) → (Link (2 * M) → SU2) →
    (Link (2 * M) → SU2)}
  {D0 : Set (wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2)}
  {ver : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 → (Link (2 * M) → SU2) → ℝ}
  {δ : Link (2 * M) → wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 → ℝ}

/-- If `f ∈ D₀`, then `P_V f ∈ D₀`, and the version of `P_V f` is the block average of the version
of `f`. -/
theorem ver_wilsonPj (hK : BlockKernelLaws M β upd) (hV : VersionLaws M β D0 ver δ)
    (V : Set (Link (2 * M))) {f : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2}
    (hf : f ∈ D0) :
    (wilsonPj (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 V).P f ∈ D0 ∧
      ver ((wilsonPj (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 V).P f) =
        blockKer M β (upd V) (ver f) := by
  have hae := hK.wilsonPj_ker V (hV.continuous_ver f) f (hV.coeFn_ae_eq_ver hf)
  exact ⟨hV.mem_contVer_of_ae_eq (hK.continuous_ker V (hV.continuous_ver f)) hae,
    hV.ver_eq_of_ae_eq (hK.continuous_ker V (hV.continuous_ver f)) hae⟩

/-- The block average does not depend on the variables inside the block. -/
theorem blockKer_update_of_mem (hK : BlockKernelLaws M β upd) {V : Set (Link (2 * M))}
    {e : Link (2 * M)} (he : e ∈ V) (g : (Link (2 * M) → SU2) → ℝ) (U : Link (2 * M) → SU2)
    (s : SU2) : blockKer M β (upd V) g (Function.update U e s) = blockKer M β (upd V) g U := by
  have h : ∀ W, upd V W (Function.update U e s) = upd V W U := fun W => funext fun i => by
    by_cases hi : i ∈ V
    · rw [hK.upd_of_mem hi, hK.upd_of_mem hi]
    · rw [hK.upd_of_not_mem hi, hK.upd_of_not_mem hi,
        Function.update_of_ne (by rintro rfl; exact hi he)]
  simp only [blockKer, h]

/-- **Comparison on `ker E_μ[· | σ(Sk)]`, `K = 1`** (SU(2) on `(ℤ/2Mℤ)⁴`, every `M ≥ 1`, every real
`β`, straight blocking; conditional on the kernel and version laws): if `f ∈ D₀` and
`E_μ[f | σ(Sk)] = 0`, then `‖f‖ ≤ ∑_{e ∉ Sk} δₑ f`. The block average of the version over the
non-skeleton links vanishes identically, and the version moves by at most `∑_{e ∉ Sk} δₑ f` under
that block update. -/
theorem norm_le_sum_nsk (hK : BlockKernelLaws M β upd) (hV : VersionLaws M β D0 ver δ)
    {f : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2} (hf : f ∈ D0)
    (hk : su2P M β (skel (straightBlocking M))ᶜ f = 0) :
    ‖f‖ ≤ 1 * ∑ e : NSk M, δ e.1 f := by
  have h0 : ver 0 = 0 := hV.ver_eq_of_ae_eq continuous_zero (Lp.coeFn_zero _ _ _)
  have h1 : blockKer M β (upd (skel (straightBlocking M))ᶜ) (ver f) = 0 :=
    (ver_wilsonPj hK hV (skel (straightBlocking M))ᶜ hf).2.symm.trans ((congrArg ver hk).trans h0)
  have hS0 : 0 ≤ ∑ e : NSk M, δ e.1 f := Finset.sum_nonneg fun e _ => hV.linkOsc_nonneg e.1 f
  refine (norm_le_of_forall_abs_le _ (hV.coeFn_ae_eq_ver hf) hS0 fun U => ?_).trans_eq
    (one_mul _).symm
  have hm := measurable_upd M (upd (skel (straightBlocking M))ᶜ) (fun i hi => hK.upd_of_mem hi)
    (fun i hi => hK.upd_of_not_mem hi) U
  refine abs_le_of_tilted_integral_eq_zero (Measure.pi fun _ : Link (2 * M) => haarSU2)
    ((measurable_wilsonExp (plaqOf (n := 2 * M)) reTr (β / 2)).comp hm)
    (fun W => abs_wilsonExp_le (plaqOf (n := 2 * M)) reTr (β / 2) _)
    ((hV.continuous_ver f).measurable.comp hm) (fun W => ?_) (congrFun h1 U)
  refine abs_sub_le_sum_of_eqOff (ver f) Subtype.val (fun e => δ e.1 f) univ
    (fun j _ U' t => hV.abs_sub_le_linkOsc j.1 f U' t) _ _ fun l hl => ?_
  have hlV : l ∉ (skel (straightBlocking M))ᶜ := fun hlV => hl ⟨l, hlV⟩ (mem_univ _) rfl
  exact (hK.upd_of_not_mem hlV W U).symm

/-- **Density in `H ∩ ker E_μ[· | σ(Sk)]`** (SU(2), every `M ≥ 1`, every real `β`; conditional on
the kernel and version laws): the elements of `D₀` with `E_μ[f | σ(Sk)] = 0` are dense there
(apply the continuous map `I − E_μ[· | σ(Sk)]`, which maps `D₀` into that set and fixes `u`). -/
theorem dense_ker (hK : BlockKernelLaws M β upd) (hV : VersionLaws M β D0 ver δ)
    (u : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2)
    (hu : su2P M β (skel (straightBlocking M))ᶜ u = 0) :
    u ∈ closure {f | f ∈ D0 ∧ su2P M β (skel (straightBlocking M))ᶜ f = 0} := by
  have hidem : ∀ v, su2P M β (skel (straightBlocking M))ᶜ
      (su2P M β (skel (straightBlocking M))ᶜ v) = su2P M β (skel (straightBlocking M))ᶜ v :=
    (wilsonPj (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (skel (straightBlocking M))ᶜ).idem
  have hQc : Continuous (su2P M β (skel (straightBlocking M))ᶜ) :=
    AddMonoidHomClass.continuous_of_bound _ 1 fun v => (norm_P_le
      (wilsonPj (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (skel (straightBlocking M))ᶜ) v).trans_eq
        (one_mul _).symm
  have hmaps : Set.MapsTo (fun v => v - su2P M β (skel (straightBlocking M))ᶜ v) D0
      {f | f ∈ D0 ∧ su2P M β (skel (straightBlocking M))ᶜ f = 0} := by
    intro v hv
    refine ⟨?_, ?_⟩
    · have h1 : su2P M β (skel (straightBlocking M))ᶜ v ∈ D0 :=
        (ver_wilsonPj hK hV (skel (straightBlocking M))ᶜ hv).1
      exact (congrArg (· ∈ D0) ((congrArg (v + ·) (neg_one_smul ℝ _)).trans
        (sub_eq_add_neg v _).symm)).mp (hV.add_mem_contVer v hv _ (hV.smul_mem_contVer (-1) _ h1))
    · exact (map_sub (su2P M β (skel (straightBlocking M))ᶜ) v _).trans
        (sub_eq_zero.2 (hidem v).symm)
  have h := map_mem_closure (f := fun v => v - su2P M β (skel (straightBlocking M))ᶜ v)
    (continuous_id.sub hQc) (hV.dense_contVer u) hmaps
  simp only [hu, sub_zero] at h
  exact h

/-- The field `self`: for a link `e` of the block `Bₓ`, `δₑ(P'ₓ f) = 0`. -/
theorem block_osc_self (hK : BlockKernelLaws M β upd) (hV : VersionLaws M β D0 ver δ)
    (x : Site (2 * M)) (e : NSk M) (he : e ∈ su2Block M x)
    {f : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2} (hf : f ∈ D0) :
    δ e.1 ((wilsonPj (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
      (cube2 M x \ skel (straightBlocking M))).P f) = 0 := by
  have hv := (ver_wilsonPj hK hV (cube2 M x \ skel (straightBlocking M)) hf).2
  refine le_antisymm (hV.linkOsc_le e.1 _ fun U s => ?_) (hV.linkOsc_nonneg e.1 _)
  rw [hv, blockKer_update_of_mem hK (V := cube2 M x \ skel (straightBlocking M)) (e := e.1)
    ⟨(mem_su2Block M).1 he, e.2⟩ (ver f) U s, sub_self, abs_zero]

/-- **The field `infl`** (SU(2) on `(ℤ/2Mℤ)⁴`, every `M ≥ 1`, every real `β = β_W`; conditional on
the kernel and version laws): for a non-skeleton link `e ∉ Bₓ` and `f ∈ D₀`,
`δₑ(P'ₓ f) ≤ δₑ f + |β| kₑₓ ∑_{k ∈ Bₓ} δₖ f`. -/
theorem block_osc_infl (hK : BlockKernelLaws M β upd) (hV : VersionLaws M β D0 ver δ)
    (x : Site (2 * M)) (e : NSk M) (he : e ∉ su2Block M x)
    {f : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2} (hf : f ∈ D0) :
    δ e.1 ((wilsonPj (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
      (cube2 M x \ skel (straightBlocking M))).P f) ≤
      δ e.1 f + |β| * (kCount M x e.1 : ℝ) * ∑ k ∈ su2Block M x, δ k.1 f := by
  have hv := (ver_wilsonPj hK hV (cube2 M x \ skel (straightBlocking M)) hf).2
  refine hV.linkOsc_le e.1 _ fun U s => ?_
  rw [hv]
  exact block_kernel_infl M β x (upd (cube2 M x \ skel (straightBlocking M)))
    (fun i hi W U => hK.upd_of_mem hi W U) (fun i hi W U => hK.upd_of_not_mem hi W U)
    (hV.continuous_ver f).measurable (fun k => δ k.1 f)
    (fun j U s => hV.abs_sub_le_linkOsc j.1 f U s) e he U s

/-- **`SU2HeatBathOsc M β` from the kernel and version laws** (SU(2) on `(ℤ/2Mℤ)⁴`,
`μ ∝ exp((β/2) ∑ₚ Re tr U_p) ∏ dU`, every `M ≥ 1`, every real `β = β_W`, straight blocking):
domain `D₀ ∩ ker E_μ[· | σ(Sk)]`, `δₑ` the given functional at the non-skeleton link `e`, `K = 1`. -/
noncomputable def su2HeatBathOsc_of_laws (hK : BlockKernelLaws M β upd)
    (hV : VersionLaws M β D0 ver δ) : SU2HeatBathOsc M β where
  D := {f | f ∈ D0 ∧ su2P M β (skel (straightBlocking M))ᶜ f = 0}
  δ e f := δ e.1 f
  K := 1
  mem x f hf := ⟨(ver_wilsonPj hK hV _ hf.1).1,
    (proj_comp_eq_of_le
      (wilsonPj (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (skel (straightBlocking M))ᶜ)
      (wilsonPj (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (cube2 M x \ skel (straightBlocking M)))
      (fun z => wilsonP_fixes_wilsonP _ _ _ _ (fun _ he => he.2) z) f).trans hf.2⟩
  nonneg e f _ := hV.linkOsc_nonneg e.1 f
  self x e he _ hf := block_osc_self hK hV x e he hf.1
  infl x e he _ hf := block_osc_infl hK hV x e he hf.1
  K_nonneg := zero_le_one
  poinc _ hf := norm_le_sum_nsk hK hV hf.1 hf.2
  ker_skel _ hf := hf.2
  dense u hu := dense_ker hK hV u hu

/-- **`hcons` at small `|β|` from the kernel and version laws** (SU(2) on `(ℤ/2Mℤ)⁴`,
`μ ∝ exp((β/2) ∑ₚ Re tr U_p) ∏ dU`, `β = β_W`, every `M ≥ 2`, `|β| ≤ 1/228`, straight blocking,
side-2 cubes at every base point, weights `1/16`):
`(1/2)(1 − 228 |β|)² ‖u‖² ≤ ∑ₓ (1/16) ‖u − P'ₓ u‖²` on `H ∩ ker Π`, through `su2_hcons_of_osc`
(Part XXVI). Conditional on `BlockKernelLaws` and `VersionLaws` only; the constants do not depend on
`M`; non-trivial for `|β| < 1/228`. A finite-volume fibre bound for the constrained
(skeleton-fixed) cube heat baths; not a mass gap. -/
theorem su2_hcons_of_laws (hM : 2 ≤ M) (hK : BlockKernelLaws M β upd)
    (hV : VersionLaws M β D0 ver δ) (hβ : |β| ≤ 1 / 228)
    (u : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2) (hu : (su2Pi M β).P u = 0) :
    ((1 / 2 : ℝ) * (1 - 228 * |β|) ^ 2) * ‖u‖ ^ 2 ≤
      ∑ x, (1 / 16 : ℝ) * ‖u - su2P M β (cube2 M x \ skel (straightBlocking M)) u‖ ^ 2 :=
  su2_hcons_of_osc hM (su2HeatBathOsc_of_laws hK hV) hβ u hu

end Laws

end YangMills.StrongCoupling.BlockHeatBathOsc

/-! ### Discharge of the kernel and version laws

`BlockKernelLaws M β blockUpd` holds by the block kernel formula of the heat-bath kernel part of
this file, and `VersionLaws M β (contVer M β) (ver M β) (linkOsc M β)` by the continuous-version
part, for every `M ≥ 1` and every real `β = β_W`. Hence `SU2HeatBathOsc M β` holds with no
hypothesis, and `hcons` holds for `M ≥ 2`, `|β| ≤ 1/228` with no other hypothesis: finite-volume
heat-bath (Gibbs-sampler) bounds with constants independent of `M`, at deep strong coupling.
`hcons` is the fibre input of the Schur split (with Part X's `su2_hFibre_of_constrained` it gives
`hFibre`); not a mass gap. -/

namespace YangMills.StrongCoupling.BlockHeatBathOsc

open YangMills.StrongCoupling YangMills.StrongCoupling.WilsonCube
  YangMills.StrongCoupling.WilsonSU2 YangMills.StrongCoupling.FibreReduction
  YangMills.StrongCoupling.HeatBathInfluence YangMills.StrongCoupling.BlockHeatBathOsc

/-- `BlockKernelLaws M β blockUpd` holds (SU(2) on `(ℤ/2Mℤ)⁴`, every `M ≥ 1`, every real
`β = β_W`): the coordinate laws of `blockUpd` and the block kernel formula with its continuity, from
the heat-bath kernel part. -/
theorem blockKernelLaws_holds (M : ℕ) [NeZero M] (β : ℝ) :
    BlockKernelLaws M β HeatBathKernel.blockUpd where
  upd_of_mem hi W U := HeatBathKernel.blockUpd_of_mem hi W U
  upd_of_not_mem hi W U := HeatBathKernel.blockUpd_of_not_mem hi W U
  continuous_ker V _ hg := HeatBathKernel.su2_continuous_kerAvgV M β V hg
  wilsonPj_ker V _ hg f hf := HeatBathKernel.su2_wilsonPj_kerAvgV M β V hg f hf

/-- `blockKer (blockUpd V)` is the block kernel `kerAvgV V` of the heat-bath kernel part, by
definition. -/
theorem blockKer_eq_kerAvgV (M : ℕ) [NeZero M] (β : ℝ) (V : Set (Link (2 * M)))
    (g : (Link (2 * M) → SU2) → ℝ) :
    blockKer M β (HeatBathKernel.blockUpd V) g =
      HeatBathKernel.kerAvgV (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 V g := rfl

/-- `VersionLaws M β (contVer M β) (ver M β) (linkOsc M β)` holds (SU(2) on `(ℤ/2Mℤ)⁴`, every
`M ≥ 1`, every real `β = β_W`): the statements of the continuous-version part. -/
theorem versionLaws_holds (M : ℕ) [NeZero M] (β : ℝ) :
    VersionLaws M β (ContinuousVersions.contVer M β) (ContinuousVersions.ver M β)
      (ContinuousVersions.linkOsc M β) where
  continuous_ver := ContinuousVersions.continuous_ver M β
  coeFn_ae_eq_ver hf := ContinuousVersions.coeFn_ae_eq_ver M β hf
  mem_contVer_of_ae_eq hg hfg := ContinuousVersions.mem_contVer_of_ae_eq M β hg hfg
  ver_eq_of_ae_eq hg hfg := ContinuousVersions.ver_eq_of_ae_eq M β hg hfg
  add_mem_contVer := ContinuousVersions.add_mem_contVer M β
  smul_mem_contVer := ContinuousVersions.smul_mem_contVer M β
  linkOsc_nonneg := ContinuousVersions.linkOsc_nonneg M β
  abs_sub_le_linkOsc := ContinuousVersions.abs_sub_le_linkOsc M β
  linkOsc_le := ContinuousVersions.linkOsc_le M β
  dense_contVer := ContinuousVersions.dense_contVer M β

/-- **`SU2HeatBathOsc M β` with no hypothesis** (SU(2) on `(ℤ/2Mℤ)⁴`,
`μ ∝ exp((β/2) ∑ₚ Re tr U_p) ∏ dU`, every `M ≥ 1`, every real `β = β_W`, straight blocking): domain
the continuous versions `f ∈ H` with `E_μ[f | σ(Sk)] = 0`, `δₑ` the oscillation in `Uₑ`
(non-skeleton `e`), influence coefficient `|β| kₑₓ`, `K = 1`. -/
noncomputable def su2HeatBathOsc_holds (M : ℕ) [NeZero M] (β : ℝ) : SU2HeatBathOsc M β :=
  su2HeatBathOsc_of_laws (blockKernelLaws_holds M β) (versionLaws_holds M β)

/-- **`hcons` with no hypothesis** (SU(2) on `(ℤ/2Mℤ)⁴`, `μ ∝ exp((β/2) ∑ₚ Re tr U_p) ∏ dU`,
`β = β_W`, every `M ≥ 2`, `|β| ≤ 1/228`, straight blocking, side-2 cubes at every base point,
weights `1/16`): `(1/2)(1 − 228 |β|)² ‖u‖² ≤ ∑ₓ (1/16) ‖u − P'ₓ u‖²` on `H ∩ ker Π`, positive for
`|β| < 1/228`; no constant depends on `M`. A finite-volume fibre bound for the constrained
(skeleton-fixed) cube heat-bath (Gibbs-sampler) generators; not a mass gap. -/
theorem su2_hcons_discharged {M : ℕ} [NeZero M] (hM : 2 ≤ M) {β : ℝ} (hβ : |β| ≤ 1 / 228)
    (u : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2) (hu : (su2Pi M β).P u = 0) :
    ((1 / 2 : ℝ) * (1 - 228 * |β|) ^ 2) * ‖u‖ ^ 2 ≤
      ∑ x, (1 / 16 : ℝ) * ‖u - su2P M β (cube2 M x \ skel (straightBlocking M)) u‖ ^ 2 :=
  su2_hcons_of_laws hM (blockKernelLaws_holds M β) (versionLaws_holds M β) hβ u hu

open YangMills.StrongCoupling.CubeSplit in
open scoped InnerProductSpace in
/-- **`hFibre` with no hypothesis** (SU(2) on `(ℤ/2Mℤ)⁴`, `μ ∝ exp((β/2) ∑ₚ Re tr U_p) ∏ dU`,
`β = β_W`, every `M ≥ 2`, `|β| ≤ 1/228`, straight blocking, side-2 cubes at every base point,
weights `1/16`): `⟨u, A u⟩ ≥ (1/2)(1 − 228 |β|)² ‖u‖²` on `ker Π`, where `A = ∑ₓ (1/16)(I − Pₓ)` is the
cube heat-bath (Gibbs-sampler) generator, by Part X's `su2_hFibre_of_constrained` applied to
`su2_hcons_discharged`. No constant depends on `M`. A finite-volume fibre bound; not a mass gap. -/
theorem su2_hFibre_discharged {M : ℕ} [NeZero M] (hM : 2 ≤ M) {β : ℝ} (hβ : |β| ≤ 1 / 228) :
    ∀ u : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2, (su2Pi M β).P u = 0 →
      ((1 / 2 : ℝ) * (1 - 228 * |β|) ^ 2) * ‖u‖ ^ 2 ≤
        ⟪u, cubeGen (fun _ => (1 / 16 : ℝ)) (fun x => su2P M β (cube2 M x)) u⟫_ℝ :=
  su2_hFibre_of_constrained M β (cube2 M) (fun _ => (1 / 16 : ℝ)) (fun _ => by norm_num)
    (fun u hu => su2_hcons_discharged hM hβ u hu)

end YangMills.StrongCoupling.BlockHeatBathOsc

/-! # Part XXXIV. `YangMills.StrongCoupling.AllVolumes`: the column count on `(ℤ/2ℤ)⁴`, hence `SU2HeatBathInfluence M β (228|β|)`, `hcons` and `hFibre` for every `M ≥ 1` and `|β| ≤ 1/228`, and Part X's bound at small coupling with `hResidual` as its only hypothesis (new; uses Parts I, II, IV, VI, X, XV, XVIII, XXI, XXII, XXVI, XXXII and XXXIII) -/

/-!
## Part XXXIV. Every volume: the column count on the smallest torus, `hcons` and `hFibre` for every `M ≥ 1`

Part XXVI bounds the column sums of the block influence counts by `228` for `M ≥ 2`, through one finite
computation in window coordinates that needs `M ≥ 2` (the offsets `−1` and `+1` of a plaquette base must be
distinct). This part treats the remaining torus, `M = 1`, that is `(ℤ/2ℤ)⁴`, by a cruder count: a link outside the
block of `x` is a link outside the side-2 cube of `x`; on `(ℤ/2ℤ)⁴` that cube has `32` of the `64` links, and each
link lies in at most six plaquettes, so the column sum is at most `6 · 32 = 192 ≤ 228`. Hence
`SU2HeatBathInfluence M β (228 |β|)` holds for every `M ≥ 1` and every real `β = β_W`, and with it `hcons` and
`hFibre` for every `M ≥ 1`, `|β| ≤ 1/228`, with no hypothesis. Together with Part XXXII's `hCoarseGap`, Part X's
bound then holds at small coupling for every `M ≥ 1` with `hResidual` as its only remaining input (which can be met
at `β = 0`, `su2_gap_of_residual_small_beta_zero`). Finite volume,
heat-bath (Gibbs-sampler) generators at deep strong coupling; not a mass gap.
-/

namespace YangMills.StrongCoupling.AllVolumes

open YangMills.StrongCoupling YangMills.StrongCoupling.WilsonSU2 YangMills.StrongCoupling.FibreReduction
  YangMills.StrongCoupling.SweepContraction YangMills.StrongCoupling.HeatBathInfluence
  YangMills.StrongCoupling.SmallCouplingInputs YangMills.StrongCoupling.BlockHeatBathOsc
  YangMills.StrongCoupling.CubeSplit YangMills.StrongCoupling.WilsonCube SchurSplit
open scoped InnerProductSpace

/-- **Each link meets the block of `x` through at most six plaquettes** (every `M ≥ 1`, every base point `x`,
every link `e`): `kₑₓ ≤ 6`, because at most six plaquettes of `(ℤ/2Mℤ)⁴` contain `e` (Part XXXII's
`card_plaq_mem_le`). -/
theorem kCount_le_six (M : ℕ) [NeZero M] (x : Site (2 * M)) (e : Link (2 * M)) : kCount M x e ≤ 6 := by
  classical
  refine le_trans (Finset.card_le_card ?_) (SingleLinkDobrushin.card_plaq_mem_le (2 * M) e)
  intro q hq
  have h := (Finset.mem_filter.1 hq).2.1
  refine Finset.mem_filter.2 ⟨Finset.mem_univ _, ?_⟩
  simp only [plaqLinks, SingleLinkDobrushin.pLinks, Finset.mem_insert, Finset.mem_singleton] at h ⊢
  exact h

/-- **On `(ℤ/2ℤ)⁴` at most `32` non-skeleton links lie outside the block of `x`**: they lie outside the side-2
cube of `x`, which has `32` of the `64` links (`card_cubeLinkFinset` at `n = 2`). -/
theorem card_compl_block_one (x : Site (2 * 1)) : ((su2Block 1 x)ᶜ).card ≤ 32 := by
  classical
  have hcube : (cubeLinkFinset (2 * 1) x).card = 32 := card_cubeLinkFinset (by norm_num) x
  have hlink : Fintype.card (Link (2 * 1)) = 64 := by
    simp only [Link, Fintype.card_prod, ProductEndpoint.card_site, Fintype.card_fin]
    norm_num
  calc ((su2Block 1 x)ᶜ).card
      = (((su2Block 1 x)ᶜ).map ⟨Subtype.val, Subtype.val_injective⟩).card := (Finset.card_map _).symm
    _ ≤ ((cubeLinkFinset (2 * 1) x)ᶜ).card := by
        refine Finset.card_le_card fun l hl => ?_
        obtain ⟨e, he, rfl⟩ := Finset.mem_map.1 hl
        refine Finset.mem_compl.2 fun hc => Finset.mem_compl.1 he ?_
        exact (mem_su2Block 1).2 ((mem_cubeLinkFinset (2 * 1) x e.1).1 hc)
    _ = 32 := by rw [Finset.card_compl, hlink, hcube]

/-- **The column sum of the influence counts on `(ℤ/2ℤ)⁴`** (`M = 1`, every base point `x`, straight blocking):
`∑_{e ∈ N ∖ Bₓ} kₑₓ ≤ 192`. (The research notes give the exact value `84` on paper; this cruder bound suffices
for the constant `228` of Part XXVI.) -/
theorem col_count_one (x : Site (2 * 1)) : ∑ e ∈ (su2Block 1 x)ᶜ, kCount 1 x e.1 ≤ 192 := by
  calc ∑ e ∈ (su2Block 1 x)ᶜ, kCount 1 x e.1 ≤ ∑ _e ∈ (su2Block 1 x)ᶜ, 6 :=
        Finset.sum_le_sum fun e _ => kCount_le_six 1 x e.1
    _ = ((su2Block 1 x)ᶜ).card * 6 := by rw [Finset.sum_const, smul_eq_mul]
    _ ≤ 32 * 6 := Nat.mul_le_mul_right 6 (card_compl_block_one x)
    _ = 192 := by norm_num

/-- **The column sum of the influence counts is at most `228` for every `M ≥ 1`** (every base point `x`,
straight blocking): Part XXVI's `col_count` for `M ≥ 2` and `col_count_one` for `M = 1`. -/
theorem col_count_all (M : ℕ) [NeZero M] (x : Site (2 * M)) :
    ∑ e ∈ (su2Block M x)ᶜ, (kCount M x e.1 : ℝ) ≤ 228 := by
  rcases Nat.lt_or_ge M 2 with hM | hM
  · have h1 : M = 1 := by have := NeZero.ne M; omega
    subst h1
    have h := col_count_one x
    have h' : ∑ e ∈ (su2Block 1 x)ᶜ, kCount 1 x e.1 ≤ 228 := h.trans (by norm_num)
    exact_mod_cast h'
  · exact col_count M hM x

/-- **`SU2HeatBathInfluence M β (228 |β|)` from `SU2HeatBathOsc M β`, every `M ≥ 1`** (every real `β = β_W`):
Part XXVI's `SU2HeatBathOsc.toInfluence` with the column bound `col_count_all`, which no longer needs `M ≥ 2`. -/
noncomputable def toInfluence_all {M : ℕ} [NeZero M] {β : ℝ} (O : SU2HeatBathOsc M β) :
    SU2HeatBathInfluence M β (228 * |β|) where
  D := O.D
  δ := O.δ
  c e x := |β| * (kCount M x e.1 : ℝ)
  K := O.K
  mem := O.mem
  nonneg := O.nonneg
  self := O.self
  infl := O.infl
  c_nonneg _ _ := mul_nonneg (abs_nonneg _) (Nat.cast_nonneg _)
  col x := by
    rw [← Finset.mul_sum, mul_comm]
    exact mul_le_mul_of_nonneg_right (col_count_all M x) (abs_nonneg β)
  K_nonneg := O.K_nonneg
  poinc := O.poinc
  ker_skel := O.ker_skel
  dense := O.dense

/-- **`SU2HeatBathInfluence M β (228 |β|)` with no hypothesis** (SU(2) on `(ℤ/2Mℤ)⁴`,
`μ ∝ exp((β/2) ∑ₚ Re tr U_p) ∏ dU`, every `M ≥ 1`, every real `β = β_W`, straight blocking), from Part XXXIII's
`su2HeatBathOsc_holds`. -/
noncomputable def su2HeatBathInfluence_all (M : ℕ) [NeZero M] (β : ℝ) :
    SU2HeatBathInfluence M β (228 * |β|) :=
  toInfluence_all (su2HeatBathOsc_holds M β)

/-- **`hcons` with no hypothesis, every `M ≥ 1`** (SU(2) on `(ℤ/2Mℤ)⁴`, `μ ∝ exp((β/2) ∑ₚ Re tr U_p) ∏ dU`,
`β = β_W`, `|β| ≤ 1/228`, straight blocking, side-2 cubes at every base point, weights `1/16`):
`(1/2)(1 − 228 |β|)² ‖u‖² ≤ ∑ₓ (1/16) ‖u − P'ₓ u‖²` on `H ∩ ker Π`, positive for `|β| < 1/228`. Part XXXIII's
`su2_hcons_discharged` without `M ≥ 2`; no constant depends on `M`. A finite-volume fibre bound for the constrained
(skeleton-fixed) cube heat-bath generators; not a mass gap. -/
theorem su2_hcons_all {M : ℕ} [NeZero M] {β : ℝ} (hβ : |β| ≤ 1 / 228)
    (u : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2) (hu : (su2Pi M β).P u = 0) :
    ((1 / 2 : ℝ) * (1 - 228 * |β|) ^ 2) * ‖u‖ ^ 2 ≤
      ∑ x, (1 / 16 : ℝ) * ‖u - su2P M β (cube2 M x \ skel (straightBlocking M)) u‖ ^ 2 :=
  su2_hcons_small_beta (su2HeatBathInfluence_all M β) hβ u hu

/-- **`hFibre` with no hypothesis, every `M ≥ 1`** (SU(2) on `(ℤ/2Mℤ)⁴`, `μ ∝ exp((β/2) ∑ₚ Re tr U_p) ∏ dU`,
`β = β_W`, `|β| ≤ 1/228`, straight blocking, side-2 cubes at every base point, weights `1/16`):
`⟨u, A u⟩ ≥ (1/2)(1 − 228 |β|)² ‖u‖²` on `ker Π`, where `A = ∑ₓ (1/16)(I − Pₓ)`, by Part X's
`su2_hFibre_of_constrained` applied to `su2_hcons_all`. Part XXXIII's `su2_hFibre_discharged` without `M ≥ 2`; no
constant depends on `M`. A finite-volume fibre bound; not a mass gap. -/
theorem su2_hFibre_all {M : ℕ} [NeZero M] {β : ℝ} (hβ : |β| ≤ 1 / 228) :
    ∀ u : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2, (su2Pi M β).P u = 0 →
      ((1 / 2 : ℝ) * (1 - 228 * |β|) ^ 2) * ‖u‖ ^ 2 ≤
        ⟪u, cubeGen (fun _ => (1 / 16 : ℝ)) (fun x => su2P M β (cube2 M x)) u⟫_ℝ :=
  su2_hFibre_of_constrained M β (cube2 M) (fun _ => (1 / 16 : ℝ)) (fun _ => by norm_num)
    (fun u hu => su2_hcons_all hβ u hu)

/-- **Part X's bound at small coupling with `hResidual` as the only input, every `M ≥ 1`** (SU(2) on
`(ℤ/2Mℤ)⁴`, `μ ∝ exp((β/2) ∑ₚ Re tr U_p) ∏ dU`, `β = β_W`, `|β| ≤ 1/228`, straight blocking, fine side-2 cubes
`cube2 M x` and coarse side-2 cubes `sideTwoCube M z` at every base point, all weights `1/16`): with
`λ = (1/2)(1 − 228 |β|)²` and `ϖ_c = (1 − 18 |β|)/128`, for every `α < λ`, `β' ≥ 0` and every trial operator `X`
whose residual certificate holds, `D ≥ min(α, β' ϖ_c) I`. `hWilson` is Part VI's `su2_inputs`, `hFibre` is
`su2_hcons_all` through Part X, and `hCoarseGap` is Part XXXII's `su2_coarse_gap`; `hResidual` is the one input
left as a hypothesis (it can be met at `β = 0`, with `X = 0` and `β' = 2`: `su2_gap_of_residual_small_beta_zero`
below). An implication,
not a new lower bound: Part XXXII's `su2_gap` already gives `D ≥ ((1 − 18|β|)/64) I` directly. Finite volume; not
a mass gap. -/
theorem su2_gap_of_residual_small_beta {M : ℕ} [NeZero M] {β : ℝ} (hβ : |β| ≤ 1 / 228) {α β' : ℝ}
    (hα : α < (1 / 2 : ℝ) * (1 - 228 * |β|) ^ 2) (hβ' : 0 ≤ β')
    (X : (su2Pi M β).Hc →ₗ[ℝ] (su2Pi M β).Hf)
    (hResidual : ∀ v : (su2Pi M β).Hc,
      β' * (su2Pi M β).gC (su2Jt M β) (su2Dc M β (ProductEndpoint.sideTwoCube M) (fun _ => 1 / 16)) v +
        qForm (E := (su2Pi M β).Hf) (F := (su2Pi M β).Hc)
          ((su2Pi M β).blkA (su2D M β (cube2 M) (fun _ => 1 / 16)))
          ((su2Pi M β).blkB (su2D M β (cube2 M) (fun _ => 1 / 16))) α X v +
        ‖resid (E := (su2Pi M β).Hf) (F := (su2Pi M β).Hc)
          ((su2Pi M β).blkA (su2D M β (cube2 M) (fun _ => 1 / 16)))
          ((su2Pi M β).blkB (su2D M β (cube2 M) (fun _ => 1 / 16))) α X v‖ ^ 2 /
          ((1 / 2 : ℝ) * (1 - 228 * |β|) ^ 2 - α) ≤
        ⟪v, (su2Pi M β).blkC (su2D M β (cube2 M) (fun _ => 1 / 16)) v⟫_ℝ) :
    min α (β' * ((1 - 18 * |β|) / 128)) • LinearMap.id ≤ su2D M β (cube2 M) (fun _ => 1 / 16) :=
  su2_gap_of_constrained M β (cube2 M) (fun _ => 1 / 16) (fun _ => by norm_num)
    (ProductEndpoint.sideTwoCube M) (fun _ => 1 / 16) (fun u hu => su2_hcons_all hβ u hu) hα hβ'
    (SingleLinkDobrushin.su2_coarse_gap M β) X hResidual

/-- **Non-vacuity of `su2_gap_of_residual_small_beta` at `β = 0`** (every `M ≥ 1`, every `α < 1/2`): the residual
certificate holds with the trial operator `X = 0` and `β' = 2` (Part XVIII's `su2_hResidual_zero_uniform`), so the
theorem applies and gives `D ≥ min(α, 2 · (1/128)) I`. This only shows that its hypothesis can be met; the elementary
bound at `β = 0` is larger (Part XVII's `su2_fine_gap_zero_half`). -/
theorem su2_gap_of_residual_small_beta_zero {M : ℕ} [NeZero M] {α : ℝ} (hα : α < 1 / 2) :
    min α (2 * ((1 - 18 * |(0 : ℝ)|) / 128)) • LinearMap.id ≤ su2D M 0 (cube2 M) (fun _ => 1 / 16) :=
  su2_gap_of_residual_small_beta (by simp) (by simpa using hα) (by norm_num) 0
    (fun v => UniformEndpoint.su2_hResidual_zero_uniform M α ((1 / 2 : ℝ) * (1 - 228 * |(0 : ℝ)|) ^ 2) v)

end YangMills.StrongCoupling.AllVolumes

/-! # Part XXXV. `YangMills.StrongCoupling.CoarseComparison`: the coarse comparison `2 ⟪y, D_c y⟫ ≤ e^{1536|β|} ⟪J y, D J y⟫` at every real coupling and every `M ≥ 1`, hence `hResidual` reduced to the mixed block (new; uses Parts I–IV, VI, X, XII, XV, XVI, XVIII, XXX–XXXII and XXXIV) -/

/-!
## Part XXXV. The coarse comparison at every coupling, and `hResidual` reduced to the mixed block

Part XXXIV states Part X's bound at small coupling with `hResidual` as its only remaining input. With the zero
trial operator, `hResidual` asks for two local bounds in terms of a form `Γ ≥ 0` (Part XVI's `cert_zero_of_local`): the
coarse-form term `⟪J* v, D_c J* v⟫ ≤ K_g Γ v` and the mixed-block term `‖B v‖² ≤ ε_B Γ v`. This part proves the first
for SU(2) at every real coupling, with `Γ v = ⟪v, C v⟫`, and states the reduction of `hResidual` to the second.

**(a) General Wilson model and blocking.** For a finite Wilson model (any `plaq`, any bounded continuous class
function `χ`, any `κ`, a bi-invariant probability measure `h` on a compact second-countable group) and any two-link blocking with `a ⊔ b`
injective:
* tilt comparison (`kerAvgV_le_exp_mul_haarAvgV`, `haarAvgV_le_exp_mul_kerAvgV`): if the Wilson exponent varies by at
  most `s` when the links of `V` change, the block heat-bath kernel and the Haar block average `A_V` of a nonnegative
  bounded function are within a factor `eˢ` of each other, pointwise;
* change of variables (`haarAvgV_blockMap`): if no coarse link has both fine links in `V`, then
  `A_V (Φ ∘ c) (U) = A_{trace V} Φ (c U)`, where `trace V` is the set of coarse links met by `V`;
* fibrewise Efron–Stein (`haarAvgV_sq_le_sum`): if sub-blocks `Tᵢ ⊆ V` cover `V`, the Haar variance over `V` at any
  frozen field is at most the sum of the Haar mean squares of `g − A_{Tᵢ} g` (from Part XII's sweep inequality and
  Part XV's product-measure composition lemma);
* hence, for `y ∈ Y` with a continuous version (`coarse_defect_le`, `fine_defect`, `coarse_block_defect`):
  `‖y − Pᶜ_V y‖² ≤ e^{4s} ∑ᵢ ‖J y − P_{V'ᵢ} J y‖²` when `V = trace W` for a fine set `W` and the traces of fine sets
  `V'ᵢ` cover `V` (each of `W`, `V'ᵢ` with at most one fine link of each coarse link, oscillation at most `s`).

**(b) SU(2) on `(ℤ/2Mℤ)⁴`** (`μ ∝ exp((β/2) ∑ₚ Re tr U_p) ∏ dU`, `β = β_W` any real number, every `M ≥ 1`, straight
blocking, fine side-2 cubes `cube2 M x` and coarse side-2 cubes `sideTwoCube M z` at every base point, all weights
`1/16`): with `W` the first fine links of the coarse cube, `V'_ε` the part of the fine cube at `2z + ε` that feeds the
coarse cube, `ε` of one parity (Part XVIII's cover), and `s = 384 |β|` (at most `32` links per block, at most six
plaquettes per link, `2|β|` per plaquette: `su2_wilsonExp_sub_le`):
* `su2_coarse_comparison`: `2 ⟪y, D_c y⟫ ≤ e^{1536 |β|} ⟪J y, D J y⟫` on `Y` (density of continuous versions, Part
  XXXI); at `β = 0` this is Part XVIII's `su2_coarse_comparison_zero`;
* `su2_gC_le`: `⟪J* v, D_c J* v⟫ ≤ (e^{1536 |β|}/2) ⟪v, C v⟫` on `H_c`;
* `su2_hResidual_of_mixed`: if `‖B v‖² ≤ ε_B ⟪v, C v⟫` on `H_c` and `β' e^{1536|β|}/2 + ε_B/(λ − α) ≤ 1`, the residual
  certificate holds with `X = 0`;
* `su2_gap_of_mixed_small_beta`: Part X's bound `D ≥ min(α, β' ϖ_c) I` (`λ = (1/2)(1 − 228|β|)²`,
  `ϖ_c = (1 − 18|β|)/128`, `|β| ≤ 1/228`) with the mixed-block bound as its only hypothesis;
  `su2_gap_of_mixed_small_beta_zero`: at `β = 0` the mixed block vanishes and the hypotheses hold with `ε_B = 0` and
  `β' = 2`.

**(c) What remains open.** The mixed-block bound `‖B v‖² ≤ ε_B ⟪v, C v⟫` is not proved at `β ≠ 0`; the accompanying
research notes give an unrefereed paper proof of a bound of this kind with `ε_B = O(β²)` for `|β| < 1/72`. The constant
`e^{1536|β|}` is crude (the notes' route, with exact plaquette counts and a different form `Γ`, has
`K_g = e^{576|β|}/2`); at `|β| = 1/1000` it is about `4.65`.
`su2_gap_of_mixed_small_beta` is an implication, not a new lower bound: Part XXXII's `su2_gap` already gives
`D ≥ ((1 − 18|β|)/64) I` directly.

**(d) Axioms and checks.** Every headline depends only on `propext`, `Classical.choice` and `Quot.sound` (the
module's axiom audit covers every declaration); the source checks of the whole file are listed in its header.

**(e) Scope.** Finite volume, every `M ≥ 1`, each statement at one real coupling `β = β_W`; heat-bath (Gibbs-sampler)
generators, not the transfer matrix. This is not a proof of a mass gap; no novelty is claimed for the mechanism
(local density comparisons of conditional laws).
-/

namespace YangMills.StrongCoupling.CoarseComparison

open MeasureTheory
open scoped InnerProductSpace
open SchurSplit YangMills.StrongCoupling.CubeSplit YangMills.StrongCoupling.CondExpInputs
  YangMills.StrongCoupling.WilsonCube YangMills.StrongCoupling.WilsonSU2
  YangMills.StrongCoupling.HeatBathKernel

/-! ### Tilted averages against untilted ones -/

section Tilt

variable {Ξ : Type*} [MeasurableSpace Ξ]

/-- **Upper tilt comparison.** If `ψ ξ − ψ ξ' ≤ s` for all `ξ, ξ'`, then for bounded measurable
`F ≥ 0`, `∫ F d(ρ tilted by ψ) ≤ eˢ ∫ F dρ` (`ρ` a probability measure). -/
theorem integral_tilted_le (ρ : Measure Ξ) [IsProbabilityMeasure ρ] {ψ F : Ξ → ℝ}
    (hψ : Measurable ψ) {B : ℝ} (hB : ∀ ξ, |ψ ξ| ≤ B) (hF : Measurable F) {C : ℝ}
    (hC : ∀ ξ, |F ξ| ≤ C) (hF0 : ∀ ξ, 0 ≤ F ξ) {s : ℝ} (hs : ∀ ξ ξ', ψ ξ - ψ ξ' ≤ s) :
    ∫ ξ, F ξ ∂(ρ.tilted ψ) ≤ Real.exp s * ∫ ξ, F ξ ∂ρ := by
  rw [integral_tilted_eq_div]
  have hE := integrable_exp_of_bound ρ hψ hB
  have hZ : 0 < ∫ ξ, Real.exp (ψ ξ) ∂ρ := integral_exp_pos hE
  have hFi : Integrable F ρ := Integrable.of_bound hF.aestronglyMeasurable C
    (ae_of_all _ fun ξ => by rw [Real.norm_eq_abs]; exact hC ξ)
  have hEF : Integrable (fun ξ => Real.exp (ψ ξ) * F ξ) ρ :=
    Integrable.of_bound (hψ.exp.mul hF).aestronglyMeasurable (Real.exp B * C)
      (ae_of_all _ fun ξ => by
        rw [Real.norm_eq_abs, abs_mul, Real.abs_exp]
        exact mul_le_mul (Real.exp_le_exp.2 ((le_abs_self _).trans (hB ξ))) (hC ξ) (abs_nonneg _)
          (Real.exp_pos _).le)
  have hpt : ∀ ξ, Real.exp (ψ ξ) ≤ Real.exp s * ∫ ξ', Real.exp (ψ ξ') ∂ρ := fun ξ => by
    rw [← integral_const_mul]
    calc Real.exp (ψ ξ) = ∫ _ξ', Real.exp (ψ ξ) ∂ρ := by simp
      _ ≤ ∫ ξ', Real.exp s * Real.exp (ψ ξ') ∂ρ :=
          integral_mono (integrable_const _) (hE.const_mul _) fun ξ' => by
            rw [← Real.exp_add]
            exact Real.exp_le_exp.2 (by linarith [hs ξ ξ'])
  rw [div_le_iff₀ hZ]
  calc ∫ ξ, Real.exp (ψ ξ) * F ξ ∂ρ
      ≤ ∫ ξ, (Real.exp s * ∫ ξ', Real.exp (ψ ξ') ∂ρ) * F ξ ∂ρ :=
        integral_mono hEF (hFi.const_mul _) fun ξ => mul_le_mul_of_nonneg_right (hpt ξ) (hF0 ξ)
    _ = Real.exp s * (∫ ξ, F ξ ∂ρ) * ∫ ξ, Real.exp (ψ ξ) ∂ρ := by
        rw [integral_const_mul]
        ring

/-- **Lower tilt comparison.** Same assumptions: `e⁻ˢ ∫ F dρ ≤ ∫ F d(ρ tilted by ψ)`. -/
theorem le_integral_tilted (ρ : Measure Ξ) [IsProbabilityMeasure ρ] {ψ F : Ξ → ℝ}
    (hψ : Measurable ψ) {B : ℝ} (hB : ∀ ξ, |ψ ξ| ≤ B) (hF : Measurable F) {C : ℝ}
    (hC : ∀ ξ, |F ξ| ≤ C) (hF0 : ∀ ξ, 0 ≤ F ξ) {s : ℝ} (hs : ∀ ξ ξ', ψ ξ - ψ ξ' ≤ s) :
    Real.exp (-s) * ∫ ξ, F ξ ∂ρ ≤ ∫ ξ, F ξ ∂(ρ.tilted ψ) := by
  rw [integral_tilted_eq_div]
  have hE := integrable_exp_of_bound ρ hψ hB
  have hZ : 0 < ∫ ξ, Real.exp (ψ ξ) ∂ρ := integral_exp_pos hE
  have hFi : Integrable F ρ := Integrable.of_bound hF.aestronglyMeasurable C
    (ae_of_all _ fun ξ => by rw [Real.norm_eq_abs]; exact hC ξ)
  have hEF : Integrable (fun ξ => Real.exp (ψ ξ) * F ξ) ρ :=
    Integrable.of_bound (hψ.exp.mul hF).aestronglyMeasurable (Real.exp B * C)
      (ae_of_all _ fun ξ => by
        rw [Real.norm_eq_abs, abs_mul, Real.abs_exp]
        exact mul_le_mul (Real.exp_le_exp.2 ((le_abs_self _).trans (hB ξ))) (hC ξ) (abs_nonneg _)
          (Real.exp_pos _).le)
  have hpt : ∀ ξ, Real.exp (-s) * ∫ ξ', Real.exp (ψ ξ') ∂ρ ≤ Real.exp (ψ ξ) := fun ξ => by
    rw [← integral_const_mul]
    calc ∫ ξ', Real.exp (-s) * Real.exp (ψ ξ') ∂ρ ≤ ∫ _ξ', Real.exp (ψ ξ) ∂ρ :=
          integral_mono (hE.const_mul _) (integrable_const _) fun ξ' => by
            rw [← Real.exp_add]
            exact Real.exp_le_exp.2 (by linarith [hs ξ' ξ])
      _ = Real.exp (ψ ξ) := by simp
  rw [le_div_iff₀ hZ]
  calc Real.exp (-s) * (∫ ξ, F ξ ∂ρ) * ∫ ξ, Real.exp (ψ ξ) ∂ρ
      = ∫ ξ, (Real.exp (-s) * ∫ ξ', Real.exp (ψ ξ') ∂ρ) * F ξ ∂ρ := by
        rw [integral_const_mul]
        ring
    _ ≤ ∫ ξ, Real.exp (ψ ξ) * F ξ ∂ρ :=
        integral_mono (hFi.const_mul _) hEF fun ξ => mul_le_mul_of_nonneg_right (hpt ξ) (hF0 ξ)

/-- On a probability space the mean minimises the mean square deviation:
`∫ (φ − ∫ φ)² ≤ ∫ (φ − c)²` for bounded measurable `φ` and every constant `c`. -/
theorem integral_sq_sub_mean_le (ρ : Measure Ξ) [IsProbabilityMeasure ρ] {φ : Ξ → ℝ}
    (hφ : Measurable φ) {C : ℝ} (hC : ∀ ξ, |φ ξ| ≤ C) (c : ℝ) :
    ∫ ξ, (φ ξ - ∫ ξ', φ ξ' ∂ρ) ^ 2 ∂ρ ≤ ∫ ξ, (φ ξ - c) ^ 2 ∂ρ := by
  set m := ∫ ξ', φ ξ' ∂ρ with hm
  have hφi : Integrable φ ρ := Integrable.of_bound hφ.aestronglyMeasurable C
    (ae_of_all _ fun ξ => by rw [Real.norm_eq_abs]; exact hC ξ)
  have hsq : Integrable (fun ξ => (φ ξ - m) ^ 2) ρ :=
    Integrable.of_bound ((hφ.sub measurable_const).pow_const 2).aestronglyMeasurable ((C + |m|) ^ 2)
      (ae_of_all _ fun ξ => by
        rw [Real.norm_eq_abs, abs_pow]
        exact pow_le_pow_left₀ (abs_nonneg _)
          ((abs_sub _ _).trans (add_le_add (hC ξ) le_rfl)) 2)
  have e : ∀ ξ, (φ ξ - c) ^ 2 = (φ ξ - m) ^ 2 + ((2 * (m - c)) * (φ ξ - m) + (m - c) ^ 2) :=
    fun ξ => by ring
  have hlin : Integrable (fun ξ => (2 * (m - c)) * (φ ξ - m) + (m - c) ^ 2) ρ :=
    ((hφi.sub (integrable_const m)).const_mul _).add (integrable_const _)
  have h0 : ∫ ξ, (φ ξ - m) ∂ρ = 0 := by
    rw [integral_sub hφi (integrable_const m)]
    simp [← hm]
  have hzero : ∫ ξ, (2 * (m - c)) * (φ ξ - m) + (m - c) ^ 2 ∂ρ = (m - c) ^ 2 := by
    have hi1 : Integrable (fun ξ => (2 * (m - c)) * (φ ξ - m)) ρ :=
      (hφi.sub (integrable_const m)).const_mul _
    calc ∫ ξ, (2 * (m - c)) * (φ ξ - m) + (m - c) ^ 2 ∂ρ
        = ∫ ξ, (2 * (m - c)) * (φ ξ - m) ∂ρ + ∫ _ξ, (m - c) ^ 2 ∂ρ :=
          integral_add hi1 (integrable_const _)
      _ = (2 * (m - c)) * ∫ ξ, (φ ξ - m) ∂ρ + (m - c) ^ 2 := by
          rw [integral_const_mul]
          simp
      _ = (m - c) ^ 2 := by rw [h0]; ring
  simp_rw [e]
  rw [integral_add hsq hlin, hzero]
  linarith [sq_nonneg (m - c)]

end Tilt

/-! ### Haar block averages -/

section Haar

variable {E G : Type*} [Fintype E] [Group G] [MeasurableSpace G] (h : Measure G)

/-- **The Haar block average** `A_V g (U) = ∫ g(U with the links of V replaced by W) d(∏ h)(W)`:
the average over the links of `V` against the untilted product measure, the other links frozen. -/
noncomputable def haarAvgV (V : Set E) (g : (E → G) → ℝ) (U : E → G) : ℝ :=
  ∫ W, g (blockUpd V W U) ∂(Measure.pi fun _ : E => h)

omit [Fintype E] [Group G] in
theorem measurable_blockUpd_left (V : Set E) (U : E → G) :
    Measurable fun W : E → G => blockUpd V W U :=
  (measurable_blockUpd V).comp (measurable_const.prodMk measurable_id)

omit [Group G] in
/-- `A_V g` does not depend on the links of `V`. -/
theorem haarAvgV_blockUpd (V : Set E) (g : (E → G) → ℝ) (W U : E → G) :
    haarAvgV h V g (blockUpd V W U) = haarAvgV h V g U := by
  unfold haarAvgV
  simp only [blockUpd_blockUpd]

omit [Fintype E] [Group G] [MeasurableSpace G] in
theorem blockUpd_inner (V : Set E) (W W' U : E → G) :
    blockUpd V (blockUpd V W W') U = blockUpd V W U := by
  funext i
  by_cases hi : i ∈ V
  · rw [blockUpd_of_mem hi, blockUpd_of_mem hi, blockUpd_of_mem hi]
  · rw [blockUpd_of_not_mem hi, blockUpd_of_not_mem hi]

omit [Fintype E] [Group G] [MeasurableSpace G] in
theorem blockUpd_comm_of_subset {T V : Set E} (hTV : T ⊆ V) (K' K ζ : E → G) :
    blockUpd V (blockUpd T K' K) ζ = blockUpd T K' (blockUpd V K ζ) := by
  funext i
  by_cases hT : i ∈ T
  · rw [blockUpd_of_mem (hTV hT), blockUpd_of_mem hT, blockUpd_of_mem hT]
  · by_cases hV : i ∈ V
    · rw [blockUpd_of_mem hV, blockUpd_of_not_mem hT, blockUpd_of_not_mem hT, blockUpd_of_mem hV]
    · rw [blockUpd_of_not_mem hV, blockUpd_of_not_mem hT, blockUpd_of_not_mem hV]

end Haar

/-! ### Block heat-bath kernels against Haar block averages -/

section KerTilt

variable {S E G : Type*} [OrientedGraph S E] [Fintype E] [Group G] [MeasurableSpace G]
  [MeasurableMul₂ G] [MeasurableInv G]
  {Pl : Type*} [Fintype Pl] (plaq : Pl → Plaq S E) (χ : ClassFn G) (κ : ℝ)
  (h : Measure G) [IsProbabilityMeasure h]

omit [MeasurableMul₂ G] [MeasurableInv G] in
/-- **At `κ = 0` the block kernel is the Haar block average.** -/
theorem kerAvgV_zero (V : Set E) (g : (E → G) → ℝ) : kerAvgV plaq χ 0 h V g = haarAvgV h V g := by
  funext U
  have h0 : (fun W : E → G => wilsonExp plaq χ 0 (blockUpd V W U)) = 0 := by
    funext W
    simp [wilsonExp]
  rw [kerAvgV, h0, MeasureTheory.tilted_zero]
  rfl

/-- **The block kernel is at most `eˢ` times the Haar block average** (for `g ≥ 0` bounded
measurable), if the Wilson exponent varies by at most `s` when the links of `V` change. -/
theorem kerAvgV_le_exp_mul_haarAvgV (V : Set E) {g : (E → G) → ℝ} (hg : Measurable g) {C : ℝ}
    (hC : ∀ U, |g U| ≤ C) (hg0 : ∀ U, 0 ≤ g U) {s : ℝ}
    (hs : ∀ W W' U : E → G,
      wilsonExp plaq χ κ (blockUpd V W U) - wilsonExp plaq χ κ (blockUpd V W' U) ≤ s)
    (U : E → G) : kerAvgV plaq χ κ h V g U ≤ Real.exp s * haarAvgV h V g U := by
  unfold kerAvgV haarAvgV
  exact integral_tilted_le (Measure.pi fun _ : E => h)
    (ψ := fun W => wilsonExp plaq χ κ (blockUpd V W U)) (F := fun W => g (blockUpd V W U))
    ((measurable_wilsonExp plaq χ κ).comp (measurable_blockUpd_left V U))
    (fun W => abs_wilsonExp_le plaq χ κ (blockUpd V W U)) (hg.comp (measurable_blockUpd_left V U))
    (fun W => hC _) (fun W => hg0 _) (fun W W' => hs W W' U)

/-- **The Haar block average is at most `eˢ` times the block kernel** (same assumptions). -/
theorem haarAvgV_le_exp_mul_kerAvgV (V : Set E) {g : (E → G) → ℝ} (hg : Measurable g) {C : ℝ}
    (hC : ∀ U, |g U| ≤ C) (hg0 : ∀ U, 0 ≤ g U) {s : ℝ}
    (hs : ∀ W W' U : E → G,
      wilsonExp plaq χ κ (blockUpd V W U) - wilsonExp plaq χ κ (blockUpd V W' U) ≤ s)
    (U : E → G) : haarAvgV h V g U ≤ Real.exp s * kerAvgV plaq χ κ h V g U := by
  have key : Real.exp (-s) * haarAvgV h V g U ≤ kerAvgV plaq χ κ h V g U := by
    unfold kerAvgV haarAvgV
    exact le_integral_tilted (Measure.pi fun _ : E => h)
      (ψ := fun W => wilsonExp plaq χ κ (blockUpd V W U)) (F := fun W => g (blockUpd V W U))
      ((measurable_wilsonExp plaq χ κ).comp (measurable_blockUpd_left V U))
      (fun W => abs_wilsonExp_le plaq χ κ (blockUpd V W U)) (hg.comp (measurable_blockUpd_left V U))
      (fun W => hC _) (fun W => hg0 _) (fun W W' => hs W W' U)
  calc haarAvgV h V g U = Real.exp s * (Real.exp (-s) * haarAvgV h V g U) := by
        rw [← mul_assoc, ← Real.exp_add, add_neg_cancel, Real.exp_zero, one_mul]
    _ ≤ Real.exp s * kerAvgV plaq χ κ h V g U :=
        mul_le_mul_of_nonneg_left key (Real.exp_pos s).le

/-- `∫ kerAvgV V g dμ = ∫ g dμ` (tower property of the block heat-bath kernel). -/
theorem integral_kerAvgV (V : Set E) {g : (E → G) → ℝ} (hg : Measurable g) {C : ℝ}
    (hC : ∀ U, |g U| ≤ C) :
    ∫ U, kerAvgV plaq χ κ h V g U ∂(wilsonMeasure plaq χ κ h) =
      ∫ U, g U ∂(wilsonMeasure plaq χ κ h) := by
  rw [← integral_congr_ae (condExp_kerAvgV plaq χ κ h V hg hC)]
  exact integral_condExp (extSigma_le V)

end KerTilt

/-! ### The oscillation of the Wilson exponent over a block of links -/

section Osc

open YangMills.StrongCoupling.SingleLinkDobrushin

variable {S E G : Type*} [OrientedGraph S E] [DecidableEq E] [Group G] [MeasurableSpace G]
  {Pl : Type*} [Fintype Pl] (plaq : Pl → Plaq S E) (χ : ClassFn G) (κ : ℝ)

/-- If `U` and `U'` agree off the finite set `F`, the Wilson exponents differ by at most
`2 |κ| B` times the number of plaquettes that meet `F` (`B` = the bound of `|χ|`). -/
theorem wilsonExp_sub_le (F : Finset E) {U U' : E → G} (hUU : ∀ l, l ∉ F → U l = U' l) :
    wilsonExp plaq χ κ U - wilsonExp plaq χ κ U' ≤
      2 * |κ| * χ.bound * (Finset.univ.filter fun p => ∃ l ∈ F, l ∈ pLinks (plaq p)).card := by
  set d : Pl → ℝ := fun p => χ.toFun (hol (plaq p) U) - χ.toFun (hol (plaq p) U') with hd
  have hsum : wilsonExp plaq χ κ U - wilsonExp plaq χ κ U' = κ * ∑ p, d p := by
    simp only [wilsonExp, hd, Finset.sum_sub_distrib]
    ring
  have hzero : ∀ p, ¬ (∃ l ∈ F, l ∈ pLinks (plaq p)) → d p = 0 := by
    intro p hp
    have e : hol (plaq p) U = hol (plaq p) U' :=
      hol_congr _ fun l hl => hUU l fun hlF => hp ⟨l, hlF, hl⟩
    simp only [hd, e, sub_self]
  have hbd : ∀ p, |d p| ≤ 2 * χ.bound := fun p => by
    have h1 := abs_le.1 (χ.abs_le (hol (plaq p) U))
    have h2 := abs_le.1 (χ.abs_le (hol (plaq p) U'))
    rw [abs_le]
    constructor <;> linarith [h1.1, h1.2, h2.1, h2.2]
  rw [hsum, ← Finset.sum_filter_of_ne (p := fun p => ∃ l ∈ F, l ∈ pLinks (plaq p))
    (fun p _ hp => by_contra fun h => hp (hzero p h))]
  calc κ * ∑ p ∈ Finset.univ.filter (fun p => ∃ l ∈ F, l ∈ pLinks (plaq p)), d p
      ≤ |κ * ∑ p ∈ Finset.univ.filter (fun p => ∃ l ∈ F, l ∈ pLinks (plaq p)), d p| :=
        le_abs_self _
    _ = |κ| * |∑ p ∈ Finset.univ.filter (fun p => ∃ l ∈ F, l ∈ pLinks (plaq p)), d p| :=
        abs_mul _ _
    _ ≤ |κ| * ∑ p ∈ Finset.univ.filter (fun p => ∃ l ∈ F, l ∈ pLinks (plaq p)), 2 * χ.bound :=
        mul_le_mul_of_nonneg_left ((Finset.abs_sum_le_sum_abs _ _).trans
          (Finset.sum_le_sum fun p _ => hbd p)) (abs_nonneg _)
    _ = 2 * |κ| * χ.bound * (Finset.univ.filter fun p => ∃ l ∈ F, l ∈ pLinks (plaq p)).card := by
        rw [Finset.sum_const, nsmul_eq_mul]
        ring

/-- The plaquettes meeting `F` are at most the sum over `l ∈ F` of the plaquettes containing `l`. -/
theorem card_filter_meet_le (F : Finset E) :
    (Finset.univ.filter fun p => ∃ l ∈ F, l ∈ pLinks (plaq p)).card ≤
      ∑ l ∈ F, (Finset.univ.filter fun p => l ∈ pLinks (plaq p)).card := by
  classical
  refine (Finset.card_le_card ?_).trans Finset.card_biUnion_le
  intro p hp
  obtain ⟨l, hlF, hl⟩ := (Finset.mem_filter.1 hp).2
  exact Finset.mem_biUnion.2 ⟨l, hlF, Finset.mem_filter.2 ⟨Finset.mem_univ _, hl⟩⟩

end Osc

section SU2Osc

open YangMills.StrongCoupling.SingleLinkDobrushin

/-- **The SU(2) block oscillation** (`(ℤ/nℤ)⁴`, every `n ≥ 1`, `κ = β/2`, `χ = Re tr`, every real
`β = β_W`): if `U` and `U'` agree off a finite set `F` of at most `32` links, the Wilson exponents
differ by at most `384 |β|` (each link lies in at most six plaquettes, each plaquette contributes at
most `2|β|`). -/
theorem su2_wilsonExp_sub_le {n : ℕ} [NeZero n] (β : ℝ) (F : Finset (Link n)) (hF : F.card ≤ 32)
    {U U' : Link n → SU2} (hUU : ∀ l, l ∉ F → U l = U' l) :
    wilsonExp (plaqOf (n := n)) reTr (β / 2) U - wilsonExp (plaqOf (n := n)) reTr (β / 2) U' ≤
      384 * |β| := by
  have h1 := wilsonExp_sub_le (plaqOf (n := n)) reTr (β / 2) F hUU
  have h2 := card_filter_meet_le (plaqOf (n := n)) F
  have h3 : ∑ l ∈ F, (Finset.univ.filter fun p => l ∈ pLinks (plaqOf (n := n) p)).card ≤
      ∑ _l ∈ F, 6 := Finset.sum_le_sum fun l _ => card_plaq_mem_le n l
  rw [Finset.sum_const, smul_eq_mul] at h3
  have h4 : ((Finset.univ.filter fun p => ∃ l ∈ F, l ∈ pLinks (plaqOf (n := n) p)).card : ℝ) ≤
      192 := by
    have : (Finset.univ.filter fun p => ∃ l ∈ F, l ∈ pLinks (plaqOf (n := n) p)).card ≤ 192 :=
      (h2.trans h3).trans (by omega)
    exact_mod_cast this
  have e1 : 2 * |β / 2| * reTr.bound = 2 * |β| := by
    rw [abs_div, abs_two]
    show 2 * (|β| / 2) * 2 = _
    ring
  rw [e1] at h1
  calc _ ≤ 2 * |β| * ((Finset.univ.filter fun p => ∃ l ∈ F, l ∈ pLinks (plaqOf (n := n) p)).card : ℝ) := h1
    _ ≤ 2 * |β| * 192 := mul_le_mul_of_nonneg_left h4 (by positivity)
    _ = 384 * |β| := by ring

/-- The links `(z + a, μ)`, `a ∈ {0,1}⁴`, `a_μ = 0`, as a finset (at most `32` links). -/
def cubeFinset (n : ℕ) (z : Site n) : Finset (Link n) :=
  (Finset.univ.filter fun q : (Fin 4 → Fin 2) × Fin 4 => q.1 q.2 = 0).image
    fun q => (z + fun i => (((q.1 i : ℕ) : ZMod n)), q.2)

theorem sideTwoCube_subset_cubeFinset (n : ℕ) (z : Site n) :
    ProductEndpoint.sideTwoCube n z ⊆ (cubeFinset n z : Set (Link n)) := by
  rintro ⟨w, μ⟩ ⟨a, ha, hw⟩
  exact Finset.mem_coe.2 (Finset.mem_image.2
    ⟨(a, μ), Finset.mem_filter.2 ⟨Finset.mem_univ _, ha⟩, Prod.ext hw.symm rfl⟩)

theorem card_cubeFinset_le (n : ℕ) (z : Site n) : (cubeFinset n z).card ≤ 32 :=
  Finset.card_image_le.trans (by decide)

end SU2Osc

/-! ### Change of variables through the blocking map -/

section ChangeVar

variable {G : Type*} [Group G] [MeasurableSpace G] (h : Measure G) [IsProbabilityMeasure h]

omit [Group G] in
/-- **Reindexing a product measure along an injection**: `W ↦ W ∘ σ` pushes `∏_ι h` to `∏_κ h`. -/
theorem map_comp_pi {ι κ : Type*} [Fintype ι] [Fintype κ] (σ : κ → ι) (hσ : Function.Injective σ) :
    (Measure.pi fun _ : ι => h).map (fun (W : ι → G) (k : κ) => W (σ k)) =
      Measure.pi fun _ : κ => h := by
  classical
  have hm : Measurable fun (W : ι → G) (k : κ) => W (σ k) :=
    measurable_pi_lambda _ fun k => measurable_pi_apply (σ k)
  refine (Measure.pi_eq fun s hs => ?_).symm
  rw [Measure.map_apply hm (MeasurableSet.univ_pi hs)]
  set t : ι → Set G := Function.extend σ s (fun _ => Set.univ) with ht
  have hpre : (fun (W : ι → G) (k : κ) => W (σ k)) ⁻¹' Set.univ.pi s = Set.univ.pi t := by
    ext W
    simp only [Set.mem_preimage, Set.mem_univ_pi]
    constructor
    · intro hW i
      by_cases hi : ∃ k, σ k = i
      · obtain ⟨k, rfl⟩ := hi
        rw [ht, hσ.extend_apply]
        exact hW k
      · rw [ht, Function.extend_apply' _ _ _ hi]
        exact Set.mem_univ _
    · intro hW k
      have h1 := hW (σ k)
      rwa [ht, hσ.extend_apply] at h1
  rw [hpre, Measure.pi_pi]
  have hsub : ∏ i ∈ Finset.univ.image σ, h (t i) = ∏ i, h (t i) :=
    Finset.prod_subset (Finset.subset_univ _) fun i _ hi => by
      have hi' : ¬ ∃ k, σ k = i := fun ⟨k, hk⟩ =>
        hi (hk ▸ Finset.mem_image_of_mem σ (Finset.mem_univ k))
      rw [ht, Function.extend_apply' _ _ _ hi', measure_univ]
  rw [← hsub, Finset.prod_image fun k _ k' _ hkk => hσ hkk]
  exact Finset.prod_congr rfl fun k _ => by rw [ht, hσ.extend_apply]

variable {S E Sc Ec : Type*} [OrientedGraph S E] [OrientedGraph Sc Ec] [Fintype E] [Fintype Ec]
  [MeasurableMul₂ G] [Measure.IsMulLeftInvariant h] [Measure.IsMulRightInvariant h]
  (blk : Blocking S E Sc Ec)

/-- The coarse links met by a set `V` of fine links: those `ē` with `a ē ∈ V` or `b ē ∈ V`. -/
def blkTrace (V : Set E) : Set Ec := {ē | blk.a ē ∈ V ∨ blk.b ē ∈ V}

/-- **Change of variables through the blocking map.** If no coarse link has both fine links in `V`
and `a ⊔ b` is injective, then for every frozen field `U` and measurable `Φ`, averaging `Φ ∘ c` over
the links of `V` (against `∏ h`) is averaging `Φ` over the coarse links met by `V`, at the frozen
coarse field `c U`: `A_V (Φ ∘ c) (U) = A_{blkTrace V} Φ (c U)`. -/
theorem haarAvgV_blockMap (hab : Function.Injective (Sum.elim blk.a blk.b)) (V : Set E)
    (hV : ∀ ē, ¬ (blk.a ē ∈ V ∧ blk.b ē ∈ V)) {Φ : (Ec → G) → ℝ} (hΦ : Measurable Φ)
    (U : E → G) :
    haarAvgV h V (fun U' => Φ (blockMap blk U')) U =
      haarAvgV h (blkTrace blk V) Φ (blockMap blk U) := by
  classical
  set σ : Ec → E := fun ē => if blk.a ē ∈ V then blk.a ē else blk.b ē with hσ_def
  set φ : Ec → G → G := fun ē x => if blk.a ē ∈ V then x * U (blk.b ē) else U (blk.a ē) * x
    with hφ_def
  have ha : ∀ x y, blk.a x = blk.a y → x = y := fun x y hxy =>
    Sum.inl_injective (@hab (Sum.inl x) (Sum.inl y) hxy)
  have hb : ∀ x y, blk.b x = blk.b y → x = y := fun x y hxy =>
    Sum.inr_injective (@hab (Sum.inr x) (Sum.inr y) hxy)
  have hab' : ∀ x y, blk.a x ≠ blk.b y := fun x y hxy =>
    Sum.inl_ne_inr (@hab (Sum.inl x) (Sum.inr y) hxy)
  have hσ : Function.Injective σ := by
    intro x y hxy
    simp only [hσ_def] at hxy
    split_ifs at hxy with h1 h2 h2
    · exact ha _ _ hxy
    · exact absurd hxy (hab' x y)
    · exact absurd hxy.symm (hab' y x)
    · exact hb _ _ hxy
  have hpt : ∀ W : E → G, blockMap blk (blockUpd V W U) =
      blockUpd (blkTrace blk V) (fun ē => φ ē (W (σ ē))) (blockMap blk U) := by
    intro W
    funext ē
    by_cases hae : blk.a ē ∈ V
    · have hbe : blk.b ē ∉ V := fun hbe => hV ē ⟨hae, hbe⟩
      rw [blockUpd_of_mem (show ē ∈ blkTrace blk V from Or.inl hae)]
      simp only [blockMap, hφ_def, hσ_def, if_pos hae, blockUpd_of_mem hae, blockUpd_of_not_mem hbe]
    · by_cases hbe : blk.b ē ∈ V
      · rw [blockUpd_of_mem (show ē ∈ blkTrace blk V from Or.inr hbe)]
        simp only [blockMap, hφ_def, hσ_def, if_neg hae, blockUpd_of_not_mem hae,
          blockUpd_of_mem hbe]
      · rw [blockUpd_of_not_mem (show ē ∉ blkTrace blk V from fun h' => h'.elim hae hbe)]
        simp only [blockMap, blockUpd_of_not_mem hae, blockUpd_of_not_mem hbe]
  have hφm : ∀ ē, MeasurePreserving (φ ē) h h := fun ē => by
    by_cases hae : blk.a ē ∈ V
    · have e : φ ē = fun x => x * U (blk.b ē) := funext fun x => by simp only [hφ_def, if_pos hae]
      rw [e]
      exact measurePreserving_mul_right h _
    · have e : φ ē = fun x => U (blk.a ē) * x := funext fun x => by simp only [hφ_def, if_neg hae]
      rw [e]
      exact measurePreserving_mul_left h _
  have hK : MeasurePreserving (fun (W : E → G) (ē : Ec) => φ ē (W (σ ē)))
      (Measure.pi fun _ : E => h) (Measure.pi fun _ : Ec => h) := by
    have h1 : MeasurePreserving (fun (W : E → G) (ē : Ec) => W (σ ē))
        (Measure.pi fun _ : E => h) (Measure.pi fun _ : Ec => h) :=
      ⟨measurable_pi_lambda _ fun ē => measurable_pi_apply (σ ē), map_comp_pi h σ hσ⟩
    have h2 : MeasurePreserving (fun (K : Ec → G) (ē : Ec) => φ ē (K ē))
        (Measure.pi fun _ : Ec => h) (Measure.pi fun _ : Ec => h) :=
      measurePreserving_pi (fun _ => h) (fun _ => h) hφm
    exact h2.comp h1
  have hg : Measurable fun K : Ec → G => Φ (blockUpd (blkTrace blk V) K (blockMap blk U)) :=
    hΦ.comp (measurable_blockUpd_left _ _)
  unfold haarAvgV
  rw [← hK.map_eq, integral_map hK.measurable.aemeasurable hg.aestronglyMeasurable]
  exact integral_congr_ae (ae_of_all _ fun W => by simp only [hpt W])

end ChangeVar

/-! ### A fibrewise Efron–Stein inequality for the product measure -/

section EfronStein

variable {Ω : Type*} {m m0 : MeasurableSpace Ω}

/-- The conditional expectation on `L²(μ)` as an orthogonal projection. -/
noncomputable def condOrth (μ : Measure Ω) (hm : m ≤ m0) : OrthProj (Lp ℝ 2 μ) where
  P := (condL2 μ hm : Lp ℝ 2 μ →ₗ[ℝ] Lp ℝ 2 μ)
  idem x := condL2_idem μ hm x
  symm := condL2_isSymmetric μ hm

/-- `‖u‖² = ∫ F²` for any version `F` of `u ∈ L²(μ)`. -/
theorem norm_sq_eq_integral {μ : Measure Ω} (u : Lp ℝ 2 μ) {F : Ω → ℝ}
    (hu : (u : Ω → ℝ) =ᵐ[μ] F) : ‖u‖ ^ 2 = ∫ ω, F ω ^ 2 ∂μ := by
  rw [← real_inner_self_eq_norm_sq, L2.inner_def]
  refine integral_congr_ae ?_
  filter_upwards [hu] with ω hω
  rw [hω, real_inner_self_eq_norm_sq, Real.norm_eq_abs, sq_abs]

variable {S E G : Type*} [OrientedGraph S E] [Fintype E] [Group G] [MeasurableSpace G]
  [MeasurableMul₂ G] [MeasurableInv G]
  {Pl : Type*} [Fintype Pl] (plaq : Pl → Plaq S E) (χ : ClassFn G)
  (h : Measure G) [IsProbabilityMeasure h]

omit [MeasurableMul₂ G] [MeasurableInv G] in
/-- For the product measure (`κ = 0`) the sweep of exterior conditional expectations along a list is
the conditional expectation for the union of the link sets. -/
theorem sweepProd_condOrth {ι : Type*} (T : ι → Set E) :
    ∀ (l : List ι) (u : Lp ℝ 2 (wilsonMeasure plaq χ 0 h)),
      ConstrainedFibre.sweepProd (fun i => condOrth (wilsonMeasure plaq χ 0 h) (extSigma_le (T i))) l u =
        condL2 (wilsonMeasure plaq χ 0 h) (extSigma_le {e | ∃ i ∈ l, e ∈ T i}) u
  | [], u => by
    rw [ConstrainedFibre.sweepProd_nil]
    have hset : {e : E | ∃ i ∈ ([] : List ι), e ∈ T i} = ∅ := by simp
    rw [hset]
    refine (FibreReduction.condL2_eq_self _ (extSigma_le ∅) ?_).symm
    rw [ProductEndpoint.extSigma_empty]
    exact (mem_lpMeas_iff_aestronglyMeasurable).2 (Lp.aestronglyMeasurable _)
  | i :: l, u => by
    rw [ConstrainedFibre.sweepProd_cons, sweepProd_condOrth T l u]
    show condL2 _ (extSigma_le (T i)) (condL2 _ (extSigma_le _) u) = _
    rw [ProductEndpoint.condL2_extSigma_comp (fun _ => h) _
      (ConstrainedFibre.wilsonMeasure_zero plaq χ h)]
    have hset : T i ∪ {e | ∃ x ∈ l, e ∈ T x} = {e | ∃ x ∈ i :: l, e ∈ T x} := by
      ext e
      simp
    rw [hset]

include plaq χ in
/-- **Fibrewise Efron–Stein for the product measure.** Let the sets `T i ⊆ V` (`i ∈ s`) cover `V`.
For bounded measurable `g` and every frozen field `ζ`, the Haar variance of `g` over the links of
`V` is at most the sum over `i` of the Haar mean square of `g − A_{T i} g` over the links of `V`. -/
theorem haarAvgV_sq_le_sum {ι : Type*} (T : ι → Set E) (s : Finset ι) {V : Set E}
    (hTV : ∀ i, T i ⊆ V) (hV : V = {e | ∃ i ∈ s, e ∈ T i}) {g : (E → G) → ℝ}
    (hg : Measurable g) {C : ℝ} (hC : ∀ U, |g U| ≤ C) (ζ : E → G) :
    haarAvgV h V (fun U => (g U - haarAvgV h V g U) ^ 2) ζ ≤
      ∑ i ∈ s, haarAvgV h V (fun U => (g U - haarAvgV h (T i) g U) ^ 2) ζ := by
  set μ0 := wilsonMeasure plaq χ 0 h with hμ0
  have hμ := ConstrainedFibre.wilsonMeasure_zero plaq χ h
  set φ : (E → G) → ℝ := fun K => g (blockUpd V K ζ) with hφ_def
  have hφm : Measurable φ := hg.comp (measurable_blockUpd_left V ζ)
  have hφC : ∀ K, |φ K| ≤ C := fun K => hC _
  have hφL : MemLp φ 2 μ0 := MemLp.of_bound hφm.aestronglyMeasurable C
    (ae_of_all _ fun K => by rw [Real.norm_eq_abs]; exact hφC K)
  set u : Lp ℝ 2 μ0 := hφL.toLp φ
  have hcond : ∀ T' : Set E, (condL2 μ0 (extSigma_le T') u : (E → G) → ℝ) =ᵐ[μ0]
      haarAvgV h T' φ := fun T' => by
    refine (condL2_ae_eq_condExp μ0 (extSigma_le T') u).trans ?_
    refine (condExp_congr_ae hφL.coeFn_toLp).trans ?_
    rw [← kerAvgV_zero plaq χ h T' φ]
    exact condExp_kerAvgV plaq χ 0 h T' hφm hφC
  have hnorm : ∀ T' : Set E, ‖u - condL2 μ0 (extSigma_le T') u‖ ^ 2 =
      ∫ K, (φ K - haarAvgV h T' φ K) ^ 2 ∂μ0 := fun T' =>
    norm_sq_eq_integral _ ((Lp.coeFn_sub _ _).trans (hφL.coeFn_toLp.sub (hcond T')))
  -- the L² inequality
  have hL2 : ‖u - condL2 μ0 (extSigma_le V) u‖ ^ 2 ≤
      ∑ i ∈ s, ‖u - condL2 μ0 (extSigma_le (T i)) u‖ ^ 2 := by
    have h1 := ConstrainedFibre.norm_sub_sweepProd_sq_le
      (fun i => condOrth μ0 (extSigma_le (T i))) u s.toList
    rw [sweepProd_condOrth plaq χ h T s.toList u] at h1
    have hset : {e | ∃ i ∈ s.toList, e ∈ T i} = V := by
      rw [hV]
      ext e
      simp
    rw [hset, Finset.sum_map_toList] at h1
    exact h1
  rw [hnorm V] at hL2
  simp only [hnorm] at hL2
  -- identify both sides with the Haar averages at `ζ`
  have hA : ∀ K, haarAvgV h V φ K = haarAvgV h V g ζ := fun K => by
    unfold haarAvgV
    simp only [hφ_def, blockUpd_inner]
  have hAT : ∀ i K, haarAvgV h (T i) φ K = haarAvgV h (T i) g (blockUpd V K ζ) := fun i K => by
    unfold haarAvgV
    simp only [hφ_def, blockUpd_comm_of_subset (hTV i)]
  have hL : haarAvgV h V (fun U => (g U - haarAvgV h V g U) ^ 2) ζ =
      ∫ K, (φ K - haarAvgV h V φ K) ^ 2 ∂μ0 := by
    rw [hμ0, hμ]
    unfold haarAvgV
    simp only [hφ_def, blockUpd_inner, blockUpd_blockUpd]
  have hR : ∀ i, haarAvgV h V (fun U => (g U - haarAvgV h (T i) g U) ^ 2) ζ =
      ∫ K, (φ K - haarAvgV h (T i) φ K) ^ 2 ∂μ0 := fun i => by
    rw [hμ0, hμ]
    unfold haarAvgV
    simp only [hφ_def, blockUpd_comm_of_subset (hTV i)]
  rw [hL]
  simp only [hR]
  exact hL2

end EfronStein


/-! ### The comparison on one coarse cube, for a general Wilson model and blocking -/

section GenericCube

variable {S E Sc Ec G : Type*} [OrientedGraph S E] [OrientedGraph Sc Ec] [Fintype E] [Fintype Ec]
  [Group G] [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G] [SecondCountableTopology G]
  [MeasurableSpace G] [BorelSpace G] [MeasurableMul₂ G] [MeasurableInv G]
  {Pl : Type*} [Fintype Pl] (plaq : Pl → Plaq S E) (χ : ClassFn G) (hχ : Continuous χ.toFun)
  (κ : ℝ) (h : Measure G) [IsProbabilityMeasure h] [Measure.IsMulLeftInvariant h]
  [Measure.IsMulRightInvariant h] (blk : Blocking S E Sc Ec)

theorem integrable_of_cont {X : Type*} [TopologicalSpace X] [CompactSpace X] [MeasurableSpace X]
    [OpensMeasurableSpace X] {μ : Measure X} [IsFiniteMeasure μ] {f : X → ℝ} (hf : Continuous f) :
    Integrable f μ := by
  obtain ⟨C, hC⟩ := isCompact_univ.exists_bound_of_continuousOn hf.continuousOn
  exact Integrable.of_bound hf.aestronglyMeasurable C (ae_of_all _ fun x => hC x (Set.mem_univ x))

omit [MeasurableMul₂ G] [MeasurableInv G] [Measure.IsMulLeftInvariant h]
  [Measure.IsMulRightInvariant h] in
include χ hχ in
/-- Haar block averages of continuous functions are continuous (any finite lattice). -/
theorem continuous_haarAvgV_of {S' E' : Type*} [OrientedGraph S' E'] [Fintype E'] (V : Set E')
    {g : (E' → G) → ℝ} (hg : Continuous g) : Continuous (haarAvgV h V g) := by
  rw [← kerAvgV_zero (Empty.elim : Empty → Plaq S' E') χ h V g]
  exact continuous_kerAvgV _ _ _ _ hχ V hg

omit [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G] [SecondCountableTopology G]
  [BorelSpace G] [Measure.IsMulLeftInvariant h] [Measure.IsMulRightInvariant h] in
include χ in
/-- Haar block averages are measurable for the exterior σ-algebra (any finite lattice). -/
theorem measurable_haarAvgV_of {S' E' : Type*} [OrientedGraph S' E'] [Fintype E'] (V : Set E')
    {g : (E' → G) → ℝ} (hg : Measurable g) :
    Measurable[extSigma (G := G) V] (haarAvgV h V g) := by
  rw [← kerAvgV_zero (Empty.elim : Empty → Plaq S' E') χ h V g]
  exact measurable_kerAvgV _ _ _ _ V hg

omit [Fintype E] [Fintype Ec] [CompactSpace G] [SecondCountableTopology G]
  [MeasurableSpace G] [BorelSpace G] [MeasurableMul₂ G] [MeasurableInv G] in
theorem continuous_blockMap_of : Continuous (blockMap (G := G) blk) :=
  continuous_pi fun _ => (continuous_apply _).mul (continuous_apply _)

omit [Fintype Ec] [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G]
  [SecondCountableTopology G] [BorelSpace G] in
/-- `J y` has the version `Y₀ ∘ c` when `y` has the version `Y₀`. -/
theorem wilsonJ_ae_eq (y : coarseY plaq χ κ h blk) {Y0 : (Ec → G) → ℝ}
    (hy : ((y : Lp ℝ 2 (coarseLaw plaq χ κ h blk)) : (Ec → G) → ℝ) =ᵐ[coarseLaw plaq χ κ h blk] Y0) :
    (((wilsonJ plaq χ κ h blk y : wilsonH plaq χ κ h) : Lp ℝ 2 (wilsonMeasure plaq χ κ h)) :
      (E → G) → ℝ) =ᵐ[wilsonMeasure plaq χ κ h] fun U => Y0 (blockMap blk U) := by
  have hc := measurePreserving_blockMap plaq χ κ h blk
  have e : ((wilsonJ plaq χ κ h blk y : wilsonH plaq χ κ h) : Lp ℝ 2 (wilsonMeasure plaq χ κ h)) =
      compL2 _ hc (y : Lp ℝ 2 (coarseLaw plaq χ κ h blk)) := rfl
  rw [e]
  exact (coeFn_compL2 _ hc _).trans (hc.quasiMeasurePreserving.ae_eq_comp hy)

omit [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G] [SecondCountableTopology G]
  [BorelSpace G] in
/-- Monotonicity of the defect: `V' ⊆ V` gives `‖u − P_{V'} u‖ ≤ ‖u − P_V u‖`. -/
theorem wilsonP_norm_sub_le_of_subset {V' V : Set E} (hVV : V' ⊆ V) (u : wilsonH plaq χ κ h) :
    ‖u - wilsonP plaq χ κ h V' u‖ ^ 2 ≤ ‖u - wilsonP plaq χ κ h V u‖ ^ 2 :=
  FibreReduction.norm_sub_le_of_le (FibreReduction.wilsonPj plaq χ κ h V)
    (FibreReduction.wilsonPj plaq χ κ h V')
    (fun _ => Subtype.ext (FibreReduction.condL2_eq_self _ (extSigma_le V')
      (FibreReduction.mem_lpMeas_mono _ (FibreReduction.extSigma_anti hVV)
        (FibreReduction.condL2_mem _ (extSigma_le V) _)))) u

include hχ in
/-- **Step 1 (best approximation on the coarse side).** For `y ∈ Y` with continuous version `Y₀`
and any coarse link set `V`: `‖y − Pᶜ_V y‖² ≤ ∫ (Y₀ − A_V Y₀)² ∘ c dμ`. -/
theorem coarse_defect_le (V : Set Ec) (y : coarseY plaq χ κ h blk) {Y0 : (Ec → G) → ℝ}
    (hY0 : Continuous Y0)
    (hy : ((y : Lp ℝ 2 (coarseLaw plaq χ κ h blk)) : (Ec → G) → ℝ) =ᵐ[coarseLaw plaq χ κ h blk] Y0) :
    ‖y - coarseP plaq χ κ h blk V y‖ ^ 2 ≤
      ∫ U, (Y0 (blockMap blk U) - haarAvgV h V Y0 (blockMap blk U)) ^ 2
        ∂(wilsonMeasure plaq χ κ h) := by
  set ν := coarseLaw plaq χ κ h blk with hν
  have hAc := continuous_haarAvgV_of χ hχ h V hY0
  have hAm := measurable_haarAvgV_of χ h V hY0.measurable
  obtain ⟨CA, hCA⟩ := exists_abs_le_of_continuous hAc
  have hmem : MemLp (haarAvgV h V Y0) 2 ν := MemLp.of_bound hAc.aestronglyMeasurable CA
    (ae_of_all _ fun ξ => by rw [Real.norm_eq_abs]; exact hCA ξ)
  have hz : (condOrth ν (extSigma_le V)).P (hmem.toLp _) = hmem.toLp _ :=
    FibreReduction.condL2_eq_self ν (extSigma_le V) ((mem_lpMeas_iff_aestronglyMeasurable).2
      ⟨_, hAm.stronglyMeasurable, hmem.coeFn_toLp⟩)
  have key := SmallCoupling.norm_sub_P_le_of_fix (condOrth ν (extSigma_le V)) (y : Lp ℝ 2 ν) _ hz
  have hint : ‖(y : Lp ℝ 2 ν) - hmem.toLp _‖ ^ 2 = ∫ ξ, (Y0 ξ - haarAvgV h V Y0 ξ) ^ 2 ∂ν :=
    norm_sq_eq_integral _ ((Lp.coeFn_sub _ _).trans (hy.sub hmem.coeFn_toLp))
  have hmap : ∫ ξ, (Y0 ξ - haarAvgV h V Y0 ξ) ^ 2 ∂ν =
      ∫ U, (Y0 (blockMap blk U) - haarAvgV h V Y0 (blockMap blk U)) ^ 2
        ∂(wilsonMeasure plaq χ κ h) := by
    rw [hν, coarseLaw]
    exact integral_map (measurable_blockMap _).aemeasurable
      ((hY0.sub hAc).pow 2).aestronglyMeasurable
  have hn : ‖y - coarseP plaq χ κ h blk V y‖ =
      ‖(y : Lp ℝ 2 ν) - (condOrth ν (extSigma_le V)).P (y : Lp ℝ 2 ν)‖ := rfl
  rw [hn]
  exact key.trans (hint.trans hmap).le

include hχ in
/-- **Step 3 (one block of fine links).** Let no coarse link have both fine links in `V'`, and let
the Wilson exponent vary by at most `s` when the links of `V'` change. For `y ∈ Y` with continuous
version `Y₀`: `∫ (Y₀ − A_{trace V'} Y₀)² ∘ c dμ ≤ e^{2s} ‖J y − P_{V'} J y‖²`. -/
theorem fine_defect (hab : Function.Injective (Sum.elim blk.a blk.b)) (V' : Set E)
    (hV' : ∀ ē, ¬ (blk.a ē ∈ V' ∧ blk.b ē ∈ V')) {s : ℝ}
    (hs : ∀ W W' U : E → G,
      wilsonExp plaq χ κ (blockUpd V' W U) - wilsonExp plaq χ κ (blockUpd V' W' U) ≤ s)
    (y : coarseY plaq χ κ h blk) {Y0 : (Ec → G) → ℝ} (hY0 : Continuous Y0)
    (hy : ((y : Lp ℝ 2 (coarseLaw plaq χ κ h blk)) : (Ec → G) → ℝ) =ᵐ[coarseLaw plaq χ κ h blk] Y0) :
    ∫ U, (Y0 (blockMap blk U) - haarAvgV h (blkTrace blk V') Y0 (blockMap blk U)) ^ 2
        ∂(wilsonMeasure plaq χ κ h) ≤
      Real.exp (2 * s) *
        ‖wilsonJ plaq χ κ h blk y - wilsonP plaq χ κ h V' (wilsonJ plaq χ κ h blk y)‖ ^ 2 := by
  set μ := wilsonMeasure plaq χ κ h with hμ
  have hfc : Continuous fun U => Y0 (blockMap blk U) := hY0.comp (continuous_blockMap_of blk)
  obtain ⟨Cf, hCf⟩ := exists_abs_le_of_continuous hfc
  have hJ := wilsonJ_ae_eq plaq χ κ h blk y hy
  have hcv : ∀ U, haarAvgV h V' (fun U' => Y0 (blockMap blk U')) U =
      haarAvgV h (blkTrace blk V') Y0 (blockMap blk U) :=
    fun U => haarAvgV_blockMap h blk hab V' hV' hY0.measurable U
  have hmc : Continuous (kerAvgV plaq χ κ h V' fun U => Y0 (blockMap blk U)) :=
    continuous_kerAvgV _ _ _ _ hχ V' hfc
  have hAc : Continuous (haarAvgV h V' fun U => Y0 (blockMap blk U)) :=
    continuous_haarAvgV_of χ hχ h V' hfc
  have hP : ((wilsonP plaq χ κ h V' (wilsonJ plaq χ κ h blk y) : wilsonH plaq χ κ h) :
      Lp ℝ 2 μ) =ᵐ[μ] kerAvgV plaq χ κ h V' fun U => Y0 (blockMap blk U) :=
    wilsonP_kerAvgV _ _ _ _ V' hfc.measurable hCf _ hJ
  have hnorm : ‖wilsonJ plaq χ κ h blk y - wilsonP plaq χ κ h V' (wilsonJ plaq χ κ h blk y)‖ ^ 2 =
      ∫ U, (Y0 (blockMap blk U) - kerAvgV plaq χ κ h V' (fun U' => Y0 (blockMap blk U')) U) ^ 2
        ∂μ := by
    have hn : ‖wilsonJ plaq χ κ h blk y - wilsonP plaq χ κ h V' (wilsonJ plaq χ κ h blk y)‖ =
        ‖((wilsonJ plaq χ κ h blk y : wilsonH plaq χ κ h) : Lp ℝ 2 μ) -
          ((wilsonP plaq χ κ h V' (wilsonJ plaq χ κ h blk y) : wilsonH plaq χ κ h) :
            Lp ℝ 2 μ)‖ := rfl
    rw [hn]
    exact norm_sq_eq_integral _ ((Lp.coeFn_sub _ _).trans (hJ.sub hP))
  have hg1c : Continuous fun U =>
      (Y0 (blockMap blk U) - haarAvgV h V' (fun U' => Y0 (blockMap blk U')) U) ^ 2 :=
    (hfc.sub hAc).pow 2
  have hg2c : Continuous fun U =>
      (Y0 (blockMap blk U) - kerAvgV plaq χ κ h V' (fun U' => Y0 (blockMap blk U')) U) ^ 2 :=
    (hfc.sub hmc).pow 2
  obtain ⟨C1, hC1⟩ := exists_abs_le_of_continuous hg1c
  obtain ⟨C2, hC2⟩ := exists_abs_le_of_continuous hg2c
  -- the Haar mean minimises the mean square over the block
  have hmin : ∀ U, haarAvgV h V' (fun U =>
        (Y0 (blockMap blk U) - haarAvgV h V' (fun U' => Y0 (blockMap blk U')) U) ^ 2) U ≤
      haarAvgV h V' (fun U =>
        (Y0 (blockMap blk U) - kerAvgV plaq χ κ h V' (fun U' => Y0 (blockMap blk U')) U) ^ 2) U :=
    fun U => by
      unfold haarAvgV
      simp only [blockUpd_blockUpd, kerAvgV_blockUpd]
      exact integral_sq_sub_mean_le (Measure.pi fun _ : E => h)
        (φ := fun W => Y0 (blockMap blk (blockUpd V' W U)))
        (hfc.measurable.comp (measurable_blockUpd_left V' U)) (fun W => hCf _) _
  have hK1 := integral_kerAvgV plaq χ κ h V' hg1c.measurable hC1
  have hK2 := integral_kerAvgV plaq χ κ h V' hg2c.measurable hC2
  have hKc1 := continuous_kerAvgV plaq χ κ h hχ V' hg1c
  have hKc2 := continuous_kerAvgV plaq χ κ h hχ V' hg2c
  have hAc1 := continuous_haarAvgV_of χ hχ h V' hg1c
  have e0 : ∫ U, (Y0 (blockMap blk U) - haarAvgV h (blkTrace blk V') Y0 (blockMap blk U)) ^ 2 ∂μ =
      ∫ U, (Y0 (blockMap blk U) - haarAvgV h V' (fun U' => Y0 (blockMap blk U')) U) ^ 2 ∂μ :=
    integral_congr_ae (ae_of_all _ fun U => by simp only [hcv U])
  rw [e0, hnorm, ← hK1, ← hK2]
  have hexp : Real.exp (2 * s) = Real.exp s * Real.exp s := by rw [← Real.exp_add, two_mul]
  calc ∫ U, kerAvgV plaq χ κ h V' (fun U =>
          (Y0 (blockMap blk U) - haarAvgV h V' (fun U' => Y0 (blockMap blk U')) U) ^ 2) U ∂μ
      ≤ ∫ U, Real.exp s * haarAvgV h V' (fun U =>
          (Y0 (blockMap blk U) - haarAvgV h V' (fun U' => Y0 (blockMap blk U')) U) ^ 2) U ∂μ :=
        integral_mono (integrable_of_cont hKc1) ((integrable_of_cont hAc1).const_mul _) fun U =>
          kerAvgV_le_exp_mul_haarAvgV _ _ _ _ V' hg1c.measurable hC1 (fun _ => sq_nonneg _) hs U
    _ ≤ ∫ U, Real.exp s * (Real.exp s * kerAvgV plaq χ κ h V' (fun U =>
          (Y0 (blockMap blk U) - kerAvgV plaq χ κ h V' (fun U' => Y0 (blockMap blk U')) U) ^ 2) U)
          ∂μ :=
        integral_mono ((integrable_of_cont hAc1).const_mul _)
          (((integrable_of_cont hKc2).const_mul _).const_mul _) fun U =>
          mul_le_mul_of_nonneg_left ((hmin U).trans
            (haarAvgV_le_exp_mul_kerAvgV _ _ _ _ V' hg2c.measurable hC2 (fun _ => sq_nonneg _) hs U))
            (Real.exp_pos _).le
    _ = Real.exp (2 * s) * ∫ U, kerAvgV plaq χ κ h V' (fun U =>
          (Y0 (blockMap blk U) - kerAvgV plaq χ κ h V' (fun U' => Y0 (blockMap blk U')) U) ^ 2) U
          ∂μ := by
        rw [hexp, mul_assoc, ← integral_const_mul, ← integral_const_mul]

include hχ in
/-- **Step 2 (one coarse block).** Let `V` be a set of coarse links and `W` a set of fine links with
`trace W = V`, no coarse link having both fine links in `W`; let the sets `trace (V' i)` (`i ∈ t`) be
contained in `V` and cover it, no coarse link having both fine links in any `V' i`; and let the Wilson
exponent vary by at most `s` when the links of `W` or of any `V' i` change. For `y ∈ Y` with continuous
version `Y₀`: `‖y − Pᶜ_V y‖² ≤ e^{4s} ∑_{i ∈ t} ‖J y − P_{V' i} J y‖²`. -/
theorem coarse_block_defect (hab : Function.Injective (Sum.elim blk.a blk.b)) {ι : Type*}
    (V : Set Ec) (W : Set E) (hWV : blkTrace blk W = V) (hW : ∀ ē, ¬ (blk.a ē ∈ W ∧ blk.b ē ∈ W))
    (V' : ι → Set E) (t : Finset ι) (hV' : ∀ i ē, ¬ (blk.a ē ∈ V' i ∧ blk.b ē ∈ V' i))
    (hTV : ∀ i, blkTrace blk (V' i) ⊆ V) (hcov : V = {e | ∃ i ∈ t, e ∈ blkTrace blk (V' i)})
    {s : ℝ}
    (hsW : ∀ Wa Wb U : E → G,
      wilsonExp plaq χ κ (blockUpd W Wa U) - wilsonExp plaq χ κ (blockUpd W Wb U) ≤ s)
    (hsV : ∀ i, ∀ Wa Wb U : E → G,
      wilsonExp plaq χ κ (blockUpd (V' i) Wa U) - wilsonExp plaq χ κ (blockUpd (V' i) Wb U) ≤ s)
    (y : coarseY plaq χ κ h blk) {Y0 : (Ec → G) → ℝ} (hY0 : Continuous Y0)
    (hy : ((y : Lp ℝ 2 (coarseLaw plaq χ κ h blk)) : (Ec → G) → ℝ) =ᵐ[coarseLaw plaq χ κ h blk] Y0) :
    ‖y - coarseP plaq χ κ h blk V y‖ ^ 2 ≤ Real.exp (4 * s) * ∑ i ∈ t,
      ‖wilsonJ plaq χ κ h blk y - wilsonP plaq χ κ h (V' i) (wilsonJ plaq χ κ h blk y)‖ ^ 2 := by
  set μ := wilsonMeasure plaq χ κ h with hμ
  have hcM := continuous_blockMap_of (G := G) blk
  have hAVc := continuous_haarAvgV_of χ hχ h V hY0
  have hgc : Continuous fun ξ => (Y0 ξ - haarAvgV h V Y0 ξ) ^ 2 := (hY0.sub hAVc).pow 2
  have hgic : ∀ i, Continuous fun ξ => (Y0 ξ - haarAvgV h (blkTrace blk (V' i)) Y0 ξ) ^ 2 :=
    fun i => (hY0.sub (continuous_haarAvgV_of χ hχ h _ hY0)).pow 2
  have hG1c : Continuous fun U => (Y0 (blockMap blk U) - haarAvgV h V Y0 (blockMap blk U)) ^ 2 :=
    hgc.comp hcM
  have hGic : ∀ i, Continuous fun U =>
      (Y0 (blockMap blk U) - haarAvgV h (blkTrace blk (V' i)) Y0 (blockMap blk U)) ^ 2 :=
    fun i => (hgic i).comp hcM
  obtain ⟨C1, hC1⟩ := exists_abs_le_of_continuous hG1c
  have hCi : ∀ i, ∃ C, ∀ U, |(Y0 (blockMap blk U) -
      haarAvgV h (blkTrace blk (V' i)) Y0 (blockMap blk U)) ^ 2| ≤ C :=
    fun i => exists_abs_le_of_continuous (hGic i)
  choose Ci hCi using hCi
  obtain ⟨CY, hCY⟩ := exists_abs_le_of_continuous hY0
  -- change of variables on `W`
  have hcvW : ∀ (Φ : (Ec → G) → ℝ), Measurable Φ → ∀ U,
      haarAvgV h W (fun U' => Φ (blockMap blk U')) U = haarAvgV h V Φ (blockMap blk U) :=
    fun Φ hΦ U => by rw [haarAvgV_blockMap h blk hab W hW hΦ U, hWV]
  -- the fibrewise Efron–Stein inequality, transported to the fine side
  have hES : ∀ U, haarAvgV h W (fun U => (Y0 (blockMap blk U) -
        haarAvgV h V Y0 (blockMap blk U)) ^ 2) U ≤
      ∑ i ∈ t, haarAvgV h W (fun U => (Y0 (blockMap blk U) -
        haarAvgV h (blkTrace blk (V' i)) Y0 (blockMap blk U)) ^ 2) U := fun U => by
    rw [hcvW _ hgc.measurable U]
    simp only [hcvW _ (hgic _).measurable U]
    exact haarAvgV_sq_le_sum (Empty.elim : Empty → Plaq Sc Ec) χ h (fun i => blkTrace blk (V' i))
      t hTV hcov hY0.measurable hCY _
  have hstep3 : ∀ i ∈ t, ∫ U, (Y0 (blockMap blk U) -
      haarAvgV h (blkTrace blk (V' i)) Y0 (blockMap blk U)) ^ 2 ∂μ ≤
        Real.exp (2 * s) * ‖wilsonJ plaq χ κ h blk y -
          wilsonP plaq χ κ h (V' i) (wilsonJ plaq χ κ h blk y)‖ ^ 2 := fun i _ =>
    fine_defect plaq χ hχ κ h blk hab (V' i) (hV' i) (hsV i) y hY0 hy
  have hKWc1 := continuous_kerAvgV plaq χ κ h hχ W hG1c
  have hAWci : ∀ i, Continuous (haarAvgV h W fun U => (Y0 (blockMap blk U) -
      haarAvgV h (blkTrace blk (V' i)) Y0 (blockMap blk U)) ^ 2) :=
    fun i => continuous_haarAvgV_of χ hχ h W (hGic i)
  have hKWci : ∀ i, Continuous (kerAvgV plaq χ κ h W fun U => (Y0 (blockMap blk U) -
      haarAvgV h (blkTrace blk (V' i)) Y0 (blockMap blk U)) ^ 2) :=
    fun i => continuous_kerAvgV plaq χ κ h hχ W (hGic i)
  have hexp : Real.exp (4 * s) = Real.exp s * Real.exp s * Real.exp (2 * s) := by
    rw [← Real.exp_add, ← Real.exp_add]
    ring_nf
  calc ‖y - coarseP plaq χ κ h blk V y‖ ^ 2
      ≤ ∫ U, (Y0 (blockMap blk U) - haarAvgV h V Y0 (blockMap blk U)) ^ 2 ∂μ :=
        coarse_defect_le plaq χ hχ κ h blk V y hY0 hy
    _ = ∫ U, kerAvgV plaq χ κ h W (fun U =>
          (Y0 (blockMap blk U) - haarAvgV h V Y0 (blockMap blk U)) ^ 2) U ∂μ :=
        (integral_kerAvgV plaq χ κ h W hG1c.measurable hC1).symm
    _ ≤ ∫ U, Real.exp s * ∑ i ∈ t, haarAvgV h W (fun U => (Y0 (blockMap blk U) -
          haarAvgV h (blkTrace blk (V' i)) Y0 (blockMap blk U)) ^ 2) U ∂μ :=
        integral_mono (integrable_of_cont hKWc1)
          ((integrable_of_cont (continuous_finsetSum _ fun i _ => hAWci i)).const_mul _)
          fun U => (kerAvgV_le_exp_mul_haarAvgV _ _ _ _ W hG1c.measurable hC1
            (fun _ => sq_nonneg _) hsW U).trans
            (mul_le_mul_of_nonneg_left (hES U) (Real.exp_pos _).le)
    _ ≤ ∫ U, Real.exp s * ∑ i ∈ t, Real.exp s * kerAvgV plaq χ κ h W (fun U =>
          (Y0 (blockMap blk U) - haarAvgV h (blkTrace blk (V' i)) Y0 (blockMap blk U)) ^ 2) U ∂μ :=
        integral_mono
          ((integrable_of_cont (continuous_finsetSum _ fun i _ => hAWci i)).const_mul _)
          ((integrable_of_cont (continuous_finsetSum _ fun i _ =>
            continuous_const.mul (hKWci i))).const_mul _)
          fun U => mul_le_mul_of_nonneg_left (Finset.sum_le_sum fun i _ =>
            haarAvgV_le_exp_mul_kerAvgV _ _ _ _ W (hGic i).measurable (hCi i)
              (fun _ => sq_nonneg _) hsW U) (Real.exp_pos _).le
    _ = Real.exp s * Real.exp s * ∑ i ∈ t, ∫ U, (Y0 (blockMap blk U) -
          haarAvgV h (blkTrace blk (V' i)) Y0 (blockMap blk U)) ^ 2 ∂μ := by
        rw [integral_const_mul, integral_finsetSum _ fun i _ =>
          (integrable_of_cont (hKWci i)).const_mul _]
        have hi : ∀ i ∈ t, ∫ U, Real.exp s * kerAvgV plaq χ κ h W (fun U => (Y0 (blockMap blk U) -
            haarAvgV h (blkTrace blk (V' i)) Y0 (blockMap blk U)) ^ 2) U ∂μ =
            Real.exp s * ∫ U, (Y0 (blockMap blk U) -
              haarAvgV h (blkTrace blk (V' i)) Y0 (blockMap blk U)) ^ 2 ∂μ := fun i _ => by
          rw [integral_const_mul, integral_kerAvgV plaq χ κ h W (hGic i).measurable (hCi i)]
        rw [Finset.sum_congr rfl hi, ← Finset.mul_sum, mul_assoc]
    _ ≤ Real.exp s * Real.exp s * ∑ i ∈ t, Real.exp (2 * s) * ‖wilsonJ plaq χ κ h blk y -
          wilsonP plaq χ κ h (V' i) (wilsonJ plaq χ κ h blk y)‖ ^ 2 :=
        mul_le_mul_of_nonneg_left (Finset.sum_le_sum hstep3) (by positivity)
    _ = Real.exp (4 * s) * ∑ i ∈ t, ‖wilsonJ plaq χ κ h blk y -
          wilsonP plaq χ κ h (V' i) (wilsonJ plaq χ κ h blk y)‖ ^ 2 := by
        rw [← Finset.mul_sum, ← mul_assoc, hexp]

end GenericCube

/-! ### Abstract assembly lemmas for the residual certificate -/

section ResidualGeneric

variable {H Y : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [NormedAddCommGroup Y]
  [InnerProductSpace ℝ Y] {D : H →ₗ[ℝ] H} {pj : OrthProj H} {J : Y →ₗ[ℝ] H} {Jt : H →ₗ[ℝ] Y}
  {Dc : Y →ₗ[ℝ] Y}

/-- From a comparison `2 ⟪y, D_c y⟫ ≤ K ⟪J y, D J y⟫` on `Y` and `J J* = I` on `H_c`:
`⟪J* v, D_c J* v⟫ ≤ (K/2) ⟪v, C v⟫` on `H_c`. -/
theorem gC_le_of_comparison (hJJt : ∀ v : pj.Hc, J (Jt v) = v) {K : ℝ}
    (hcomp : ∀ y, 2 * ⟪y, Dc y⟫_ℝ ≤ K * ⟪J y, D (J y)⟫_ℝ) (v : pj.Hc) :
    pj.gC Jt Dc v ≤ (K / 2) * ⟪v, pj.blkC D v⟫_ℝ := by
  rw [pj.inner_blkC, OrthProj.gC]
  have h1 := hcomp (Jt v)
  rw [hJJt v] at h1
  linarith

/-- `⟪v, C v⟫ ≥ 0` on `H_c` when `D ≥ 0` as a form. -/
theorem inner_blkC_nonneg (hD : ∀ u : H, 0 ≤ ⟪u, D u⟫_ℝ) (v : pj.Hc) :
    0 ≤ ⟪v, pj.blkC D v⟫_ℝ := by
  rw [pj.inner_blkC]
  exact hD v

/-- **The residual certificate with `X = 0` from the mixed block and the coarse form**: with
`Γ v = ⟪v, C v⟫`, Part XVI's `cert_zero_of_local` with `c = 1`. -/
theorem hResidual_of_form {lam α β' εB Kg : ℝ} (hα : α < lam) (hβ' : 0 ≤ β')
    (hΓ : ∀ v : pj.Hc, 0 ≤ ⟪v, pj.blkC D v⟫_ℝ)
    (hB : ∀ v : pj.Hc, ‖pj.blkB D v‖ ^ 2 ≤ εB * ⟪v, pj.blkC D v⟫_ℝ)
    (hg : ∀ v : pj.Hc, pj.gC Jt Dc v ≤ Kg * ⟪v, pj.blkC D v⟫_ℝ)
    (hbud : β' * Kg + εB / (lam - α) ≤ 1) (v : pj.Hc) :
    β' * pj.gC Jt Dc v + qForm (pj.blkA D) (pj.blkB D) α 0 v +
      ‖resid (pj.blkA D) (pj.blkB D) α 0 v‖ ^ 2 / (lam - α) ≤ ⟪v, pj.blkC D v⟫_ℝ :=
  SmallCoupling.cert_zero_of_local _ hα hβ' hΓ hB hg (fun _ => (one_mul _).le) hbud v

/-- If the mixed block vanishes, its square norm is at most `0 · ⟪v, C v⟫`. -/
theorem blkB_sq_le_zero_mul (hB : ∀ v : pj.Hc, pj.blkB D v = 0) (v : pj.Hc) :
    ‖pj.blkB D v‖ ^ 2 ≤ 0 * ⟪v, pj.blkC D v⟫_ℝ := by
  rw [hB v, norm_zero, zero_mul]
  norm_num

end ResidualGeneric

/-! ### SU(2) on `(ℤ/2Mℤ)⁴` -/

section SU2

open YangMills.StrongCoupling.FibreReduction YangMills.StrongCoupling.UniformEndpoint
  YangMills.StrongCoupling.ContinuousVersions

variable (M : ℕ) [NeZero M] (β : ℝ)

/-- The fine links of the side-2 cube at `x` that belong to coarse links of the side-2 coarse cube
at `z`. -/
def subCube (z : Site M) (x : Site (2 * M)) : Set (Link (2 * M)) :=
  {l | l ∈ cube2 M x ∧ ∃ ē ∈ ProductEndpoint.sideTwoCube M z,
    l = (straightBlocking M).a ē ∨ l = (straightBlocking M).b ē}

/-- The first fine links of the coarse links of a side-2 coarse cube. -/
def firstLinks (z : Site M) : Set (Link (2 * M)) :=
  (straightBlocking M).a '' ProductEndpoint.sideTwoCube M z

theorem blkTrace_firstLinks (z : Site M) :
    blkTrace (straightBlocking M) (firstLinks M z) = ProductEndpoint.sideTwoCube M z := by
  have hab := ProductEndpoint.straightBlocking_sumElim_injective M
  ext ē
  constructor
  · rintro (⟨ē', h', he⟩ | ⟨ē', h', he⟩)
    · rwa [← Sum.inl_injective (@hab (Sum.inl ē') (Sum.inl ē) he)]
    · exact absurd he (fun h'' => Sum.inl_ne_inr (@hab (Sum.inl ē') (Sum.inr ē) h''))
  · intro hē
    exact Or.inl ⟨ē, hē, rfl⟩

theorem firstLinks_not_both (z : Site M) (ē : Link M) :
    ¬ ((straightBlocking M).a ē ∈ firstLinks M z ∧ (straightBlocking M).b ē ∈ firstLinks M z) := by
  have hab := ProductEndpoint.straightBlocking_sumElim_injective M
  rintro ⟨-, ⟨ē', -, he⟩⟩
  exact Sum.inl_ne_inr (@hab (Sum.inl ē') (Sum.inr ē) he)

omit [NeZero M] in
theorem firstLinks_subset (z : Site M) :
    firstLinks M z ⊆ ((cubeFinset M z).image (straightBlocking M).a : Finset (Link (2 * M))) := by
  rintro l ⟨ē, hē, rfl⟩
  exact Finset.mem_coe.2 (Finset.mem_image_of_mem _ (sideTwoCube_subset_cubeFinset M z hē))

theorem blkTrace_subCube_subset (z : Site M) (x : Site (2 * M)) :
    blkTrace (straightBlocking M) (subCube M z x) ⊆ ProductEndpoint.sideTwoCube M z := by
  have hab := ProductEndpoint.straightBlocking_sumElim_injective M
  rintro ē (⟨-, ē', h', he | he⟩ | ⟨-, ē', h', he | he⟩)
  · rwa [Sum.inl_injective (@hab (Sum.inl ē) (Sum.inl ē') he)]
  · exact absurd he (fun h'' => Sum.inl_ne_inr (@hab (Sum.inl ē) (Sum.inr ē') h''))
  · exact absurd he.symm (fun h'' => Sum.inl_ne_inr (@hab (Sum.inl ē') (Sum.inr ē) h''))
  · rwa [Sum.inr_injective (@hab (Sum.inr ē) (Sum.inr ē') he)]

/-- The SU(2) block oscillation for any set of fine links inside a finset of at most `32` links. -/
theorem su2_osc_of_subset {V : Set (Link (2 * M))} (F : Finset (Link (2 * M))) (hVF : V ⊆ F)
    (hF : F.card ≤ 32) (Wa Wb U : Link (2 * M) → SU2) :
    wilsonExp (plaqOf (n := 2 * M)) reTr (β / 2) (blockUpd V Wa U) -
      wilsonExp (plaqOf (n := 2 * M)) reTr (β / 2) (blockUpd V Wb U) ≤ 384 * |β| :=
  su2_wilsonExp_sub_le β F hF fun l hl =>
    have hlV : l ∉ V := fun h' => hl (Finset.mem_coe.1 (hVF h'))
    (blockUpd_of_not_mem hlV Wa U).trans (blockUpd_of_not_mem hlV Wb U).symm

/-- **One coarse cube, one parity** (SU(2) on `(ℤ/2Mℤ)⁴`, every real `β`, every `M ≥ 1`): for
`y ∈ Y` with continuous version `Y₀`,
`‖y − Pᶜ_{V_z} y‖² ≤ e^{1536|β|} ∑_{ε of parity p} ‖J y − P_{cube2 (2z+ε)} J y‖²`. -/
theorem su2_coarse_cube_defect (z : Site M) (p : ZMod 2)
    (y : coarseY (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (straightBlocking M))
    {Y0 : (Link M → SU2) → ℝ} (hY0 : Continuous Y0)
    (hy : ((y : Lp ℝ 2 (coarseLaw (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (straightBlocking M))) :
      (Link M → SU2) → ℝ) =ᵐ[coarseLaw (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
        (straightBlocking M)] Y0) :
    ‖y - coarseP (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (straightBlocking M)
        (ProductEndpoint.sideTwoCube M z) y‖ ^ 2 ≤
      Real.exp (1536 * |β|) * ∑ ε ∈ Finset.univ.filter (fun ε => parity4 ε = p),
        ‖su2J M β y - su2P M β (cube2 M (fineSite M z ε)) (su2J M β y)‖ ^ 2 := by
  have hsub : ∀ ε, subCube M z (fineSite M z ε) ⊆ cube2 M (fineSite M z ε) := fun ε l hl => hl.1
  have hcov : ProductEndpoint.sideTwoCube M z = {e | ∃ ε ∈ Finset.univ.filter
      (fun ε : Fin 4 → Fin 2 => parity4 ε = p),
        e ∈ blkTrace (straightBlocking M) (subCube M z (fineSite M z ε))} := by
    ext ē
    constructor
    · intro hē
      obtain ⟨ε, hε, hm⟩ := sideTwoCube_subset_cover M z p hē
      refine ⟨ε, hε, ?_⟩
      rcases hm with ha | hb
      · exact Or.inl ⟨ha, ē, hē, Or.inl rfl⟩
      · exact Or.inr ⟨hb, ē, hē, Or.inr rfl⟩
    · rintro ⟨ε, -, hε⟩
      exact blkTrace_subCube_subset M z _ hε
  have key := coarse_block_defect (plaqOf (n := 2 * M)) reTr continuous_reTr (β / 2) haarSU2
    (straightBlocking M) (ProductEndpoint.straightBlocking_sumElim_injective M)
    (ProductEndpoint.sideTwoCube M z) (firstLinks M z) (blkTrace_firstLinks M z)
    (firstLinks_not_both M z) (fun ε => subCube M z (fineSite M z ε))
    (Finset.univ.filter fun ε => parity4 ε = p)
    (fun ε ē hboth => cube2_not_both M (fineSite M z ε) ē ⟨(hboth.1).1, (hboth.2).1⟩)
    (fun ε => blkTrace_subCube_subset M z _) hcov
    (su2_osc_of_subset M β _ (firstLinks_subset M z)
      (Finset.card_image_le.trans (card_cubeFinset_le M z)))
    (fun ε => su2_osc_of_subset M β _
      ((hsub ε).trans (sideTwoCube_subset_cubeFinset (2 * M) _)) (card_cubeFinset_le _ _))
    y hY0 hy
  have hexp : Real.exp (4 * (384 * |β|)) = Real.exp (1536 * |β|) := congrArg Real.exp (by ring)
  refine (key.trans_eq (congrArg (· * _) hexp)).trans
    (mul_le_mul_of_nonneg_left (Finset.sum_le_sum fun ε _ => ?_) (Real.exp_pos _).le)
  exact wilsonP_norm_sub_le_of_subset _ _ _ _ (hsub ε) _

/-- An orthogonal projection is continuous (`‖P x‖ ≤ ‖x‖`). -/
theorem continuous_orthProj {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (P : OrthProj H) : Continuous P.P :=
  AddMonoidHomClass.continuous_of_bound P.P 1 fun x =>
    ((sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).1 (ConstrainedFibre.norm_P_sq_le P x)).trans_eq
      (one_mul _).symm

omit [NeZero M] in
/-- Summing a per-cube, per-parity bound over both parities and all coarse cubes (real numbers only):
if `g z ≤ K ∑_{ε of parity p} f (2z + ε)` for every `z` and `p`, `f ≥ 0` and `K ≥ 0`, then
`2 ∑_z g z / 16 ≤ K ∑ₓ f x / 16` (`(z, ε) ↦ 2z + ε` is injective). -/
theorem sum_parity_bound [NeZero M] (g : Site M → ℝ) (f : Site (2 * M) → ℝ) (hf : ∀ x, 0 ≤ f x)
    {K : ℝ} (hK : 0 ≤ K)
    (hz : ∀ z (p : ZMod 2), g z ≤ K * ∑ ε ∈ Finset.univ.filter (fun ε => parity4 ε = p),
      f (fineSite M z ε)) :
    2 * ∑ z, 1 / 16 * g z ≤ K * ∑ x, 1 / 16 * f x := by
  classical
  have hz2 : ∀ z, 2 * g z ≤ K * ∑ ε, f (fineSite M z ε) := fun z => by
    calc 2 * g z = ∑ _p : ZMod 2, g z := by
          rw [Finset.sum_const, Finset.card_univ, ZMod.card, nsmul_eq_mul]
          norm_num
      _ ≤ ∑ p : ZMod 2, K * ∑ ε ∈ Finset.univ.filter (fun ε => parity4 ε = p), f (fineSite M z ε) :=
          Finset.sum_le_sum fun p _ => hz z p
      _ = K * ∑ ε, f (fineSite M z ε) := by rw [← Finset.mul_sum, Finset.sum_fiberwise]
  have hinj := fineSite_injective M
  calc 2 * ∑ z, 1 / 16 * g z = ∑ z, 1 / 16 * (2 * g z) := by
        rw [Finset.mul_sum]
        exact Finset.sum_congr rfl fun z _ => by ring
    _ ≤ ∑ z, 1 / 16 * (K * ∑ ε, f (fineSite M z ε)) :=
        Finset.sum_le_sum fun z _ => mul_le_mul_of_nonneg_left (hz2 z) (by norm_num)
    _ = K * ∑ z, ∑ ε, 1 / 16 * f (fineSite M z ε) := by
        simp only [Finset.mul_sum]
        exact Finset.sum_congr rfl fun z _ => Finset.sum_congr rfl fun ε _ => by ring
    _ = K * ∑ q : Site M × (Fin 4 → Fin 2), 1 / 16 * f (fineSite M q.1 q.2) := by
        rw [Fintype.sum_prod_type]
    _ = K * ∑ x ∈ Finset.univ.image
          (fun q : Site M × (Fin 4 → Fin 2) => fineSite M q.1 q.2), 1 / 16 * f x := by
        rw [Finset.sum_image (f := fun x => 1 / 16 * f x) (s := Finset.univ) hinj.injOn]
    _ ≤ K * ∑ x, 1 / 16 * f x :=
        mul_le_mul_of_nonneg_left (Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _)
          fun x _ _ => mul_nonneg (by norm_num) (hf x)) hK

/-- The coarse comparison for `y ∈ Y` with a continuous version, as sums of squared defects. -/
theorem su2_coarse_comparison_of_version
    (y : coarseY (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (straightBlocking M))
    {Y0 : (Link M → SU2) → ℝ} (hY0 : Continuous Y0)
    (hy : ((y : Lp ℝ 2 (coarseLaw (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (straightBlocking M))) :
      (Link M → SU2) → ℝ) =ᵐ[coarseLaw (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
        (straightBlocking M)] Y0) :
    2 * ∑ z, 1 / 16 * ‖y - coarseP (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (straightBlocking M)
        (ProductEndpoint.sideTwoCube M z) y‖ ^ 2 ≤
      Real.exp (1536 * |β|) * ∑ x, 1 / 16 *
        ‖su2J M β y - su2P M β (cube2 M x) (su2J M β y)‖ ^ 2 :=
  sum_parity_bound M (fun z => ‖y - coarseP (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
      (straightBlocking M) (ProductEndpoint.sideTwoCube M z) y‖ ^ 2)
    (fun x => ‖su2J M β y - su2P M β (cube2 M x) (su2J M β y)‖ ^ 2) (fun _ => sq_nonneg _)
    (Real.exp_pos _).le (fun z p => su2_coarse_cube_defect M β z p y hY0 hy)

/-- **The coarse comparison at every coupling** (SU(2) on `(ℤ/2Mℤ)⁴`, `μ ∝ exp((β/2) ∑ₚ Re tr U_p) ∏ dU`,
`β = β_W` any real number, every `M ≥ 1`, straight blocking, fine side-2 cubes `cube2 M x` and coarse
side-2 cubes `sideTwoCube M z` at every base point, all weights `1/16`): on the coarse space `Y`,
`2 ⟪y, D_c y⟫ ≤ e^{1536 |β|} ⟪J y, D J y⟫`. At `β = 0` this is Part XVIII's
`su2_coarse_comparison_zero`; no constant depends on `M`. Finite volume; not a mass gap. -/
theorem su2_coarse_comparison
    (y : coarseY (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (straightBlocking M)) :
    2 * ⟪y, su2Dc M β (ProductEndpoint.sideTwoCube M) (fun _ => 1 / 16) y⟫_ℝ ≤
      Real.exp (1536 * |β|) *
        ⟪su2J M β y, su2D M β (cube2 M) (fun _ => 1 / 16) (su2J M β y)⟫_ℝ := by
  have hc : ∀ y' : coarseY (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (straightBlocking M),
      ⟪y', su2Dc M β (ProductEndpoint.sideTwoCube M) (fun _ => 1 / 16) y'⟫_ℝ =
        ∑ z, 1 / 16 * ‖y' - coarseP (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
          (straightBlocking M) (ProductEndpoint.sideTwoCube M z) y'‖ ^ 2 := fun y' =>
    inner_cubeGen_eq (fun _ => (1 / 16 : ℝ))
      (fun z => ProductEndpoint.extProj (coarseLaw (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
        (straightBlocking M)) (ProductEndpoint.sideTwoCube M z)) y'
  have hf : ∀ y' : coarseY (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (straightBlocking M),
      ⟪su2J M β y', su2D M β (cube2 M) (fun _ => 1 / 16) (su2J M β y')⟫_ℝ =
        ∑ x, 1 / 16 * ‖su2J M β y' - su2P M β (cube2 M x) (su2J M β y')‖ ^ 2 := fun y' =>
    inner_cubeGen_eq (fun _ => (1 / 16 : ℝ))
      (fun x => wilsonPj (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (cube2 M x)) (su2J M β y')
  rw [hc, hf]
  have hPc : ∀ V : Set (Link M),
      Continuous (coarseP (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (straightBlocking M) V) :=
    fun V => continuous_orthProj (ProductEndpoint.extProj (coarseLaw (plaqOf (n := 2 * M)) reTr
      (β / 2) haarSU2 (straightBlocking M)) V)
  have hPf : ∀ V : Set (Link (2 * M)), Continuous (su2P M β V) :=
    fun V => continuous_orthProj (wilsonPj (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 V)
  have hJc : Continuous (su2J M β) := (su2J M β).continuous
  have hL : Continuous fun y' : coarseY (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
      (straightBlocking M) => 2 * ∑ z, 1 / 16 * ‖y' - coarseP (plaqOf (n := 2 * M)) reTr (β / 2)
        haarSU2 (straightBlocking M) (ProductEndpoint.sideTwoCube M z) y'‖ ^ 2 :=
    continuous_const.mul (continuous_finsetSum _ fun z _ =>
      continuous_const.mul ((continuous_id.sub (hPc _)).norm.pow 2))
  have hR : Continuous fun y' : coarseY (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
      (straightBlocking M) => Real.exp (1536 * |β|) * ∑ x, 1 / 16 *
        ‖su2J M β y' - su2P M β (cube2 M x) (su2J M β y')‖ ^ 2 :=
    continuous_const.mul (continuous_finsetSum _ fun x _ =>
      continuous_const.mul ((hJc.sub ((hPf _).comp hJc)).norm.pow 2))
  have hsub : ContVer (coarseLaw (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (straightBlocking M))
      (coarseY (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (straightBlocking M)) ⊆
      {y' | 2 * ∑ z, 1 / 16 * ‖y' - coarseP (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
          (straightBlocking M) (ProductEndpoint.sideTwoCube M z) y'‖ ^ 2 ≤
        Real.exp (1536 * |β|) * ∑ x, 1 / 16 *
          ‖su2J M β y' - su2P M β (cube2 M x) (su2J M β y')‖ ^ 2} := fun y' hy' => by
    obtain ⟨Y0, hY0, hY0y⟩ := hy'
    exact su2_coarse_comparison_of_version M β y' hY0 hY0y
  exact closure_minimal hsub (isClosed_le hL hR)
    (dense_ContVer _ (Measure.pi fun _ : Site M => haarSU2) y)

/-- `D = ∑ₓ (1/16)(I − P_{cube2 M x}) ≥ 0` as a form on `H`. -/
theorem su2D_nonneg (u : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2) :
    0 ≤ ⟪u, su2D M β (cube2 M) (fun _ => 1 / 16) u⟫_ℝ := by
  have h : ⟪u, su2D M β (cube2 M) (fun _ => 1 / 16) u⟫_ℝ =
      ∑ x, 1 / 16 * ‖u - su2P M β (cube2 M x) u‖ ^ 2 :=
    inner_cubeGen_eq (fun _ => (1 / 16 : ℝ))
      (fun x => wilsonPj (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (cube2 M x)) u
  rw [h]
  exact Finset.sum_nonneg fun x _ => mul_nonneg (by norm_num) (sq_nonneg _)

/-- **The coarse-form term of `hResidual` at every coupling** (same setting as
`su2_coarse_comparison`): `⟪J* v, D_c J* v⟫ ≤ (e^{1536|β|}/2) ⟪v, C v⟫` on `H_c`. -/
theorem su2_gC_le (v : (su2Pi M β).Hc) :
    (su2Pi M β).gC (su2Jt M β) (su2Dc M β (ProductEndpoint.sideTwoCube M) (fun _ => 1 / 16)) v ≤
      (Real.exp (1536 * |β|) / 2) *
        ⟪v, (su2Pi M β).blkC (su2D M β (cube2 M) (fun _ => 1 / 16)) v⟫_ℝ := by
  have hW := su2_inputs M β (cube2 M) (fun _ => 1 / 16) (ProductEndpoint.sideTwoCube M)
    (fun _ => 1 / 16)
  exact gC_le_of_comparison (J := (su2J M β : _ →ₗ[ℝ] _))
    (fun v => (hW.JJt v).trans ((su2Pi M β).P_of_mem_Hc v.2)) (su2_coarse_comparison M β) v

/-- **`hResidual` reduced to the mixed block** (SU(2) on `(ℤ/2Mℤ)⁴`, every real `β = β_W`, every
`M ≥ 1`, straight blocking, fine side-2 cubes `cube2 M x` and coarse side-2 cubes `sideTwoCube M z`,
all weights `1/16`): if the mixed block satisfies `‖B v‖² ≤ ε_B ⟪v, C v⟫` on `H_c` and
`β' e^{1536|β|}/2 + ε_B/(λ − α) ≤ 1` with `α < λ`, `β' ≥ 0`, then the residual certificate holds with
the trial operator `X = 0`. The coarse-form term is `su2_gC_le`; the mixed-block bound is left as a
hypothesis. -/
theorem su2_hResidual_of_mixed {lam α β' εB : ℝ} (hα : α < lam) (hβ' : 0 ≤ β')
    (hB : ∀ v : (su2Pi M β).Hc,
      ‖(su2Pi M β).blkB (su2D M β (cube2 M) (fun _ => 1 / 16)) v‖ ^ 2 ≤
        εB * ⟪v, (su2Pi M β).blkC (su2D M β (cube2 M) (fun _ => 1 / 16)) v⟫_ℝ)
    (hbud : β' * (Real.exp (1536 * |β|) / 2) + εB / (lam - α) ≤ 1) (v : (su2Pi M β).Hc) :
    β' * (su2Pi M β).gC (su2Jt M β) (su2Dc M β (ProductEndpoint.sideTwoCube M) (fun _ => 1 / 16)) v +
      qForm (E := (su2Pi M β).Hf) (F := (su2Pi M β).Hc)
        ((su2Pi M β).blkA (su2D M β (cube2 M) (fun _ => 1 / 16)))
        ((su2Pi M β).blkB (su2D M β (cube2 M) (fun _ => 1 / 16))) α
          (0 : (su2Pi M β).Hc →ₗ[ℝ] (su2Pi M β).Hf) v +
      ‖resid (E := (su2Pi M β).Hf) (F := (su2Pi M β).Hc)
        ((su2Pi M β).blkA (su2D M β (cube2 M) (fun _ => 1 / 16)))
        ((su2Pi M β).blkB (su2D M β (cube2 M) (fun _ => 1 / 16))) α
          (0 : (su2Pi M β).Hc →ₗ[ℝ] (su2Pi M β).Hf) v‖ ^ 2 / (lam - α) ≤
      ⟪v, (su2Pi M β).blkC (su2D M β (cube2 M) (fun _ => 1 / 16)) v⟫_ℝ :=
  hResidual_of_form hα hβ' (inner_blkC_nonneg (su2D_nonneg M β)) hB (su2_gC_le M β) hbud v

/-- **Part X's bound at small coupling with the mixed block as the only hypothesis** (SU(2) on
`(ℤ/2Mℤ)⁴`, `μ ∝ exp((β/2) ∑ₚ Re tr U_p) ∏ dU`, `β = β_W`, `|β| ≤ 1/228`, every `M ≥ 1`, straight
blocking, fine side-2 cubes `cube2 M x` and coarse side-2 cubes `sideTwoCube M z` at every base point,
all weights `1/16`): with `λ = (1/2)(1 − 228 |β|)²` and `ϖ_c = (1 − 18|β|)/128`, if
`‖B v‖² ≤ ε_B ⟪v, C v⟫` on `H_c`, `α < λ`, `β' ≥ 0` and `β' e^{1536|β|}/2 + ε_B/(λ − α) ≤ 1`, then
`D ≥ min(α, β' ϖ_c) I`. Part XXXIV's `su2_gap_of_residual_small_beta` with `X = 0` and
`su2_hResidual_of_mixed`. An implication, not a new lower bound (Part XXXII's `su2_gap` gives
`D ≥ ((1 − 18|β|)/64) I` directly). Finite volume; not a mass gap. -/
theorem su2_gap_of_mixed_small_beta (hβ : |β| ≤ 1 / 228) {α β' εB : ℝ}
    (hα : α < (1 / 2 : ℝ) * (1 - 228 * |β|) ^ 2) (hβ' : 0 ≤ β')
    (hB : ∀ v : (su2Pi M β).Hc,
      ‖(su2Pi M β).blkB (su2D M β (cube2 M) (fun _ => 1 / 16)) v‖ ^ 2 ≤
        εB * ⟪v, (su2Pi M β).blkC (su2D M β (cube2 M) (fun _ => 1 / 16)) v⟫_ℝ)
    (hbud : β' * (Real.exp (1536 * |β|) / 2) +
      εB / ((1 / 2 : ℝ) * (1 - 228 * |β|) ^ 2 - α) ≤ 1) :
    min α (β' * ((1 - 18 * |β|) / 128)) • LinearMap.id ≤ su2D M β (cube2 M) (fun _ => 1 / 16) :=
  AllVolumes.su2_gap_of_residual_small_beta hβ hα hβ' 0
    (su2_hResidual_of_mixed M β hα hβ' hB hbud)

/-- **Non-vacuity at `β = 0`**: the mixed block vanishes (Part XV's `su2_blkB_zero`), so the
hypotheses of `su2_gap_of_mixed_small_beta` hold with `ε_B = 0` and `β' = 2`, the constant of Part
XVIII; the theorem gives `D ≥ min(α, 2 · (1/128)) I` for every `α < 1/2`. -/
theorem su2_gap_of_mixed_small_beta_zero {α : ℝ} (hα : α < 1 / 2) :
    min α (2 * ((1 - 18 * |(0 : ℝ)|) / 128)) • LinearMap.id ≤
      su2D M 0 (cube2 M) (fun _ => 1 / 16) := by
  have hα0 : α < (1 / 2 : ℝ) * (1 - 228 * |(0 : ℝ)|) ^ 2 := by norm_num; linarith
  have hbud0 : (2 : ℝ) * (Real.exp (1536 * |(0 : ℝ)|) / 2) +
      0 / ((1 / 2 : ℝ) * (1 - 228 * |(0 : ℝ)|) ^ 2 - α) ≤ 1 := by norm_num
  exact su2_gap_of_mixed_small_beta M 0 (by norm_num) hα0 (by norm_num)
    (blkB_sq_le_zero_mul (ProductEndpoint.su2_blkB_zero M)) hbud0

end SU2

end YangMills.StrongCoupling.CoarseComparison

/-! # Part XXXVI. `YangMills.StrongCoupling.MixedBlock`: the mixed block `‖B v‖² ≤ ε_B ⟪v, C v⟫` for `|β| < 1/18` and every `M ≥ 1`, hence `hResidual` and Part X's bound with every input proved for `|β| ≤ 1/2000` (new; uses Parts I–IV, VI, X, XV–XVII, XXI, XXII, XXVII, XXIX–XXXIII and XXXV) -/

/-!
## Part XXXVI. The mixed block at small coupling, and Part X's bound with every input proved

Part XXXV reduces `hResidual` (with the zero trial operator) to one bound on the mixed block
`B = (I − Π) D Π`: `‖B v‖² ≤ ε_B ⟪v, C v⟫` on `H_c`, with `β' e^{1536|β|}/2 + ε_B/(λ − α) ≤ 1`
(`su2_hResidual_of_mixed`). This part proves that bound for SU(2) on `(ℤ/2Mℤ)⁴`
(`μ ∝ exp((β/2) ∑ₚ Re tr U_p) ∏ dU`, `β = β_W`, every `M ≥ 1`, straight blocking, fine side-2 cubes `cube2 M x` at
every base point, weights `1/16`) for `|β| < 1/18`, with `ε_B = 9216 τ²/(1 − 18|β|)`, `τ = 4|β| e^{24|β|}`
(`ε_B ≈ 147456 β²`), and so closes Part X's route at small coupling.

**(a) The argument.** Let `u = J y ∈ ran Π` and `f = (I − Π) D u`, so `Π f = 0`.
* Fibre Poincaré (`su2_fibrePoincare`, `su2_fibrePoincare_Pi`): on `ker E_μ[· | σ(Sk)] = ker Π` (Lemma IV),
  `(1 − 18|β|) ‖f‖² ≤ ∑_{e ∉ Sk} ‖f − P_e f‖²`, the single-link heat baths `P_e` of the non-skeleton links only. This
  is Part XXIX's `scan_poincare` with influence data on the continuous versions in that kernel: the influence step of
  Part XXXII (`su2_kernel_update_infl`), its column count `18`, and the comparison and density of Part XXXIII
  (`norm_le_sum_nsk`, `dense_ker`).
* For a non-skeleton link `e`, `P_e` fixes `u` and `ran Π`, so `f − P_e f = ∑ₓ (1/16) (P_e Pₓ u − Pₓ u)`
  (`sub_proj_mixed`).
* Local defect (`su2_local_defect`, for `y` with a continuous version):
  `‖Pₓ u − P_e Pₓ u‖ ≤ (e^{4|β| k} − 1) ‖u − Pₓ u‖`, with `k = kMeet (cube2 M x) e` the number of plaquettes that
  contain `e` and meet the cube. Only those plaquettes make the block kernel of the cube
  depend on `U_e`, so changing `U_e` tilts the conditional law of the cube by a density in `[e^{−L}, e^{L}]`,
  `L = 4|β| k`. Then `|∫ F dν' − ∫ F dν| ≤ (e^L − 1) (∫ (F − ∫ F dν)² dν)^{1/2}`, and the best approximation of `Pₓ u`
  by a function of the links `≠ e` bounds `‖Pₓ u − P_e Pₓ u‖`.
* Counts and the Schur test (`kMeet_le_six`, `kMeet_col`, `kMeet_row`, `exp_sub_one_le_kMeet`, `schur_sq_le`):
  `k ≤ 6`, `∑ₓ k ≤ 192`, `∑_e k ≤ 768` (crude counts: six plaquettes per link, four links per plaquette, eight cubes
  per link, `32` links per cube), and `e^{4|β| k} − 1 ≤ τ k`. With `⟪u, D u⟫ = ∑ₓ (1/16) ‖u − Pₓ u‖²` this gives
  `(1 − 18|β|) ‖f‖² ≤ (12 τ)(768 τ) ⟪u, D u⟫` (`mixed_sq_le_abstract`, on any real inner product space;
  `mixed_sq_le_of_version` instantiates it).
* Every `y ∈ Y` is a limit of elements with a continuous version (Part XXXI), so the bound holds on all of `ran J = H_c`
  (`su2_mixed_block_J`, `su2_mixed_block`).

**(b) Headlines.**
* `su2_mixed_block` (`|β| < 1/18`, every `M ≥ 1`): `‖B v‖² ≤ ε_B ⟪v, C v⟫` on `H_c`.
* `su2_hResidual_closed` (`|β| ≤ 1/2000`, every `M ≥ 1`, coarse side-2 cubes `sideTwoCube M z`, weights `1/16`):
  the residual certificate of `CubeSplitInputs.gap_of_residual` holds with
  `X = 0`, `λ = (1/2)(1 − 228|β|)²`, `α = λ/2` and `β' = 1/2` (`budget_mixed`).
* `su2_gap_closed_small_beta` (`|β| ≤ 1/2000`, every `M ≥ 1`): `D ≥ ((1 − 18|β|)/256) I`, Part X's bound
  `D ≥ min(α, β' ϖ_c) I` with every input proved: `hWilson` (Part VI), `hFibre` (Parts X, XXXIII, XXXIV), `hCoarseGap`
  (`ϖ_c = (1 − 18|β|)/128`, Part XXXII) and `hResidual` (Parts XXXV and this part).

**(c) What it is and what it is not.** This closes the Schur-split route at small nonzero coupling, uniformly in the
side `2M` of the periodic torus, in finite volume. It is not a new lower bound: Part XXXII's `su2_gap` gives
`D ≥ ((1 − 18|β|)/64) I` directly, four times larger, for `|β| < 1/18`; the content is that the route's interface is
met by the actual Wilson operators at small `β ≠ 0` (`0 < |β| ≤ 1/2000`).
The constants are crude (`ε_B` through counts `192` and `768`; the research
notes, with exact counts `72` and `252` and a different form `Γ`, give `ε_B ≈ 4536 β²`), and `1/2000` is far inside the
strong-coupling regime. A nonzero mixed block at `β ≠ 0` is still not proved.

**(d) Checks.** Every headline depends only on `propext`, `Classical.choice` and `Quot.sound`.

**(e) Scope.** Finite volume; heat-bath (Gibbs-sampler) generators, not the transfer matrix; deep strong coupling.
This is not a proof of a mass gap, and no novelty is claimed for the mechanism (local comparisons of conditional laws,
Dobrushin-type influence bounds, a Schur test).
-/

namespace YangMills.StrongCoupling.MixedBlock

open YangMills.StrongCoupling.WilsonSU2 YangMills.StrongCoupling.SingleLinkDobrushin

/-- `k_e(V)`: the number of plaquettes of `(ℤ/nℤ)⁴` that contain the link `e` and meet the link
set `V`. -/
noncomputable def kMeet {n : ℕ} [NeZero n] (V : Set (Link n)) (e : Link n) : ℕ := by
  classical
  exact (Finset.univ.filter fun q : PlaqIdx n =>
    e ∈ pLinks (plaqOf q) ∧ ∃ l ∈ pLinks (plaqOf q), l ∈ V).card

/-- The mixed-block constant `ε_B = 9216 τ² / (1 − 18|β|)`, `τ = 4|β| e^{24|β|}`
(`9216 = 12 · 768`: the weighted column sum `192/16` and the row count of the Schur test). -/
noncomputable def epsB (β : ℝ) : ℝ :=
  9216 * (4 * |β| * Real.exp (24 * |β|)) ^ 2 / (1 - 18 * |β|)

end YangMills.StrongCoupling.MixedBlock

namespace YangMills.StrongCoupling.MixedBlock

section CountsSchur

open YangMills.StrongCoupling.WilsonSU2 YangMills.StrongCoupling.SingleLinkDobrushin
  YangMills.StrongCoupling.FibreReduction YangMills.StrongCoupling.SmallCouplingInputs

/-! ### The plaquette counts `k_e(V)` for the side-2 cubes -/

/-- **A link meets a link set through at most six plaquettes** (`(ℤ/nℤ)⁴`, finite volume, every
`n ≥ 1`, every link set `V`, every link `e`): `k_e(V) ≤ 6`, where `k_e(V)` = `kMeet V e` is the number of plaquettes
that contain `e` and meet `V`, because at most six plaquettes contain `e` (Part XXXII's
`card_plaq_mem_le`). A crude bound, not sharp. -/
theorem kMeet_le_six {n : ℕ} [NeZero n] (V : Set (Link n)) (e : Link n) : kMeet V e ≤ 6 := by
  classical
  unfold kMeet
  refine le_trans (Finset.card_le_card fun q hq => ?_) (card_plaq_mem_le n e)
  exact Finset.mem_filter.2 ⟨Finset.mem_univ _, (Finset.mem_filter.1 hq).2.1⟩

/-- Column form of `k_e(V)`: if `V ⊆ F`, then `k_e(V) ≤ ∑_{q ∋ e} ∑_{l ∈ q} [l ∈ F]`. -/
theorem cnt_kMeet_le_col {n : ℕ} [NeZero n] (V : Set (Link n)) (F : Finset (Link n))
    (hVF : ∀ l ∈ V, l ∈ F) (e : Link n) :
    kMeet V e ≤ ∑ q ∈ Finset.univ.filter (fun q : PlaqIdx n => e ∈ pLinks (plaqOf q)),
      ∑ l ∈ pLinks (plaqOf q), if l ∈ F then 1 else 0 := by
  classical
  unfold kMeet
  rw [Finset.card_filter, Finset.sum_filter]
  refine Finset.sum_le_sum fun q _ => ?_
  rcases em (e ∈ pLinks (plaqOf q) ∧ ∃ l ∈ pLinks (plaqOf q), l ∈ V) with hq | hq
  · rw [if_pos hq, if_pos hq.1]
    obtain ⟨l, hl, hlV⟩ := hq.2
    exact (if_pos (hVF l hlV)).symm.le.trans
      (Finset.single_le_sum (f := fun l => if l ∈ F then 1 else 0) (fun _ _ => Nat.zero_le _) hl)
  · rw [if_neg hq]
    exact Nat.zero_le _

/-- Row form of `k_e(V)`: if `V ⊆ F`, then `k_e(V) ≤ ∑_{q meets F} [e ∈ q]`. -/
theorem cnt_kMeet_le_row {n : ℕ} [NeZero n] (V : Set (Link n)) (F : Finset (Link n))
    (hVF : ∀ l ∈ V, l ∈ F) (e : Link n) :
    kMeet V e ≤ ∑ q ∈ Finset.univ.filter (fun q : PlaqIdx n => ∃ l ∈ F, l ∈ pLinks (plaqOf q)),
      if e ∈ pLinks (plaqOf q) then 1 else 0 := by
  classical
  unfold kMeet
  rw [← Finset.card_filter]
  refine Finset.card_le_card fun q hq => ?_
  obtain ⟨-, he, l, hl, hlV⟩ := Finset.mem_filter.1 hq
  exact Finset.mem_filter.2 ⟨Finset.mem_filter.2 ⟨Finset.mem_univ _, l, hVF l hlV, hl⟩, he⟩

/-- **The column count of the side-2 cubes** (`(ℤ/2Mℤ)⁴`, finite volume, every `M ≥ 1`, straight
setting, the side-2 cubes `cube2 M x` at every base point `x`, every link `e`): `∑ₓ k_e(cube2 M x) ≤ 192`, where
`k_e(V)` = `kMeet V e` is the number of plaquettes that contain `e` and meet `V`. Double counting:
at most `6` plaquettes contain `e`, each has at most `4` links, and each link lies in exactly `8`
side-2 cubes (Part XXII's `card_cubesContaining` on `(ℤ/2Mℤ)⁴`; `2M ≥ 2`). A crude bound, not sharp. -/
theorem kMeet_col (M : ℕ) [NeZero M] (e : Link (2 * M)) :
    ∑ x : Site (2 * M), kMeet (cube2 M x) e ≤ 192 := by
  have hM : 2 ≤ 2 * M := Nat.mul_le_mul_left 2 (Nat.one_le_iff_ne_zero.2 (NeZero.ne M))
  have h6 := card_plaq_mem_le (2 * M) e
  calc ∑ x, kMeet (cube2 M x) e
      ≤ ∑ x, ∑ q ∈ Finset.univ.filter (fun q : PlaqIdx (2 * M) => e ∈ pLinks (plaqOf q)),
          ∑ l ∈ pLinks (plaqOf q), (if l ∈ cubeLinkFinset (2 * M) x then 1 else 0) :=
        Finset.sum_le_sum fun x _ => cnt_kMeet_le_col (cube2 M x) (cubeLinkFinset (2 * M) x)
          (fun l hl => (mem_cubeLinkFinset (2 * M) x l).2 hl) e
    _ = ∑ q ∈ Finset.univ.filter (fun q : PlaqIdx (2 * M) => e ∈ pLinks (plaqOf q)),
          ∑ l ∈ pLinks (plaqOf q), ∑ x, (if l ∈ cubeLinkFinset (2 * M) x then 1 else 0) :=
        Finset.sum_comm.trans (Finset.sum_congr rfl fun q _ => Finset.sum_comm)
    _ = ∑ q ∈ Finset.univ.filter (fun q : PlaqIdx (2 * M) => e ∈ pLinks (plaqOf q)),
          ∑ l ∈ pLinks (plaqOf q), 8 := by
        refine Finset.sum_congr rfl fun q _ => Finset.sum_congr rfl fun l _ => ?_
        rw [← Finset.card_filter]
        exact card_cubesContaining (2 * M) hM l
    _ ≤ ∑ q ∈ Finset.univ.filter (fun q : PlaqIdx (2 * M) => e ∈ pLinks (plaqOf q)), 32 :=
        Finset.sum_le_sum fun q _ => by
          rw [Finset.sum_const, smul_eq_mul]
          exact Nat.mul_le_mul_right 8 (card_pLinks_le (plaqOf q))
    _ ≤ 192 := by
        rw [Finset.sum_const, smul_eq_mul]
        exact Nat.mul_le_mul_right 32 h6

/-- **The row count of the side-2 cubes** (`(ℤ/2Mℤ)⁴`, finite volume, every `M ≥ 1`, straight
setting, the side-2 cube `cube2 M x` at every base point `x`): `∑ₑ k_e(cube2 M x) ≤ 768`, where `k_e(V)` = `kMeet V e`
is the number of plaquettes that contain `e` and meet `V`. Double counting: each plaquette has at
most `4` links, the cube has at most `32` links (`card_cubeLinkFinset_le`) and each link lies in at
most `6` plaquettes (`card_plaq_mem_le`). A crude bound, not sharp. -/
theorem kMeet_row (M : ℕ) [NeZero M] (x : Site (2 * M)) :
    ∑ e : Link (2 * M), kMeet (cube2 M x) e ≤ 768 := by
  have h32 := card_cubeLinkFinset_le (2 * M) x
  calc ∑ e, kMeet (cube2 M x) e
      ≤ ∑ e, ∑ q ∈ Finset.univ.filter (fun q : PlaqIdx (2 * M) =>
          ∃ l ∈ cubeLinkFinset (2 * M) x, l ∈ pLinks (plaqOf q)),
            (if e ∈ pLinks (plaqOf q) then 1 else 0) :=
        Finset.sum_le_sum fun e _ => cnt_kMeet_le_row (cube2 M x) (cubeLinkFinset (2 * M) x)
          (fun l hl => (mem_cubeLinkFinset (2 * M) x l).2 hl) e
    _ = ∑ q ∈ Finset.univ.filter (fun q : PlaqIdx (2 * M) =>
          ∃ l ∈ cubeLinkFinset (2 * M) x, l ∈ pLinks (plaqOf q)),
            ∑ e, (if e ∈ pLinks (plaqOf q) then 1 else 0) :=
        Finset.sum_comm
    _ ≤ ∑ q ∈ Finset.univ.filter (fun q : PlaqIdx (2 * M) =>
          ∃ l ∈ cubeLinkFinset (2 * M) x, l ∈ pLinks (plaqOf q)), 4 :=
        Finset.sum_le_sum fun q _ => by
          rw [← Finset.card_filter]
          exact (Finset.card_le_card fun e he => (Finset.mem_filter.1 he).2).trans
            (card_pLinks_le _)
    _ = 4 * (Finset.univ.filter (fun q : PlaqIdx (2 * M) =>
          ∃ l ∈ cubeLinkFinset (2 * M) x, l ∈ pLinks (plaqOf q))).card := by
        rw [Finset.sum_const, smul_eq_mul, mul_comm]
    _ ≤ 4 * ∑ l ∈ cubeLinkFinset (2 * M) x,
          (Finset.univ.filter fun q : PlaqIdx (2 * M) => l ∈ pLinks (plaqOf q)).card :=
        Nat.mul_le_mul_left 4
          (CoarseComparison.card_filter_meet_le (plaqOf (n := 2 * M)) (cubeLinkFinset (2 * M) x))
    _ ≤ 4 * ∑ _l ∈ cubeLinkFinset (2 * M) x, 6 :=
        Nat.mul_le_mul_left 4 (Finset.sum_le_sum fun l _ => card_plaq_mem_le (2 * M) l)
    _ ≤ 768 := by
        rw [Finset.sum_const, smul_eq_mul]
        exact Nat.mul_le_mul_left 4 (Nat.mul_le_mul_right 6 h32)

/-! ### The real-analysis pieces -/

/-- **The linearised plaquette factor** (every real `β = β_W`, every `k ≤ 6`):
`e^{4|β|k} − 1 ≤ 4|β| e^{24|β|} k`, from `e^t − 1 ≤ t e^t` (`t = 4|β|k ≥ 0`) and `t ≤ 24|β|`. -/
theorem exp_sub_one_le_kMeet (β : ℝ) {k : ℕ} (hk : k ≤ 6) :
    Real.exp (4 * |β| * k) - 1 ≤ 4 * |β| * Real.exp (24 * |β|) * k := by
  have hk' : (k : ℝ) ≤ 6 := by exact_mod_cast hk
  have hb : 0 ≤ |β| := abs_nonneg β
  have ht0 : 0 ≤ 4 * |β| * (k : ℝ) := by positivity
  have hle : 4 * |β| * (k : ℝ) ≤ 24 * |β| := by
    calc 4 * |β| * (k : ℝ) ≤ 4 * |β| * 6 := mul_le_mul_of_nonneg_left hk' (by positivity)
      _ = 24 * |β| := by ring
  have hE := Real.exp_pos (4 * |β| * k)
  have h1 := mul_le_mul_of_nonneg_right (Real.add_one_le_exp (-(4 * |β| * k))) hE.le
  have h2 : Real.exp (-(4 * |β| * k)) * Real.exp (4 * |β| * k) = 1 := by
    rw [← Real.exp_add, neg_add_cancel, Real.exp_zero]
  have h3 : Real.exp (4 * |β| * k) ≤ Real.exp (24 * |β|) := Real.exp_le_exp.2 hle
  have h4 : Real.exp (4 * |β| * k) - 1 ≤ 4 * |β| * k * Real.exp (4 * |β| * k) := by
    rw [h2] at h1
    linarith only [h1]
  calc _ ≤ 4 * |β| * k * Real.exp (4 * |β| * k) := h4
    _ ≤ 4 * |β| * k * Real.exp (24 * |β|) := mul_le_mul_of_nonneg_left h3 ht0
    _ = _ := mul_right_comm _ _ _

/-- **The weighted Schur test, squared form, with `A1 ≥ 0`** (finite index types `ι`, `κ`, either
possibly empty; real weights): for `w, a ≥ 0`, `A1 ≥ 0`, column sums `∑ₓ wₓ a_{ex} ≤ A1` (every `e`)
and row sums `∑ₑ a_{ex} ≤ A2` (every `x`): `∑ₑ (∑ₓ wₓ a_{ex} hₓ)² ≤ A1 A2 ∑ₓ wₓ hₓ²` for every real
`h` (Cauchy–Schwarz in `x` with weights `wₓ a_{ex}`, then the row sums). -/
theorem schur_sq_le_of_nonneg {ι κ : Type*} [Fintype ι] [Fintype κ] (w : ι → ℝ)
    (a : κ → ι → ℝ) (h : ι → ℝ) (hw : ∀ x, 0 ≤ w x) (ha : ∀ e x, 0 ≤ a e x) {A1 A2 : ℝ}
    (hA1 : 0 ≤ A1) (h1 : ∀ e, ∑ x, w x * a e x ≤ A1) (h2 : ∀ x, ∑ e, a e x ≤ A2) :
    ∑ e, (∑ x, w x * a e x * h x) ^ 2 ≤ A1 * A2 * ∑ x, w x * h x ^ 2 := by
  have hCS : ∀ e, (∑ x, w x * a e x * h x) ^ 2 ≤ A1 * ∑ x, w x * a e x * h x ^ 2 := by
    intro e
    have hwa : ∀ x, 0 ≤ w x * a e x := fun x => mul_nonneg (hw x) (ha e x)
    have hwah : ∀ x, 0 ≤ w x * a e x * h x ^ 2 := fun x => mul_nonneg (hwa x) (sq_nonneg (h x))
    refine (Finset.sum_sq_le_sum_mul_sum_of_sq_le_mul Finset.univ (fun x _ => hwa x)
      (fun x _ => hwah x) fun x _ => le_of_eq (by ring)).trans ?_
    exact mul_le_mul_of_nonneg_right (h1 e) (Finset.sum_nonneg fun x _ => hwah x)
  calc ∑ e, (∑ x, w x * a e x * h x) ^ 2
      ≤ ∑ e, A1 * ∑ x, w x * a e x * h x ^ 2 := Finset.sum_le_sum fun e _ => hCS e
    _ = A1 * ∑ x, (∑ e, a e x) * (w x * h x ^ 2) := by
        rw [← Finset.mul_sum, Finset.sum_comm]
        refine congrArg (A1 * ·) (Finset.sum_congr rfl fun x _ => ?_)
        rw [Finset.sum_mul]
        exact Finset.sum_congr rfl fun e _ => by ring
    _ ≤ A1 * ∑ x, A2 * (w x * h x ^ 2) := by
        refine mul_le_mul_of_nonneg_left (Finset.sum_le_sum fun x _ => ?_) hA1
        exact mul_le_mul_of_nonneg_right (h2 x) (mul_nonneg (hw x) (sq_nonneg (h x)))
    _ = A1 * A2 * ∑ x, w x * h x ^ 2 := by rw [← Finset.mul_sum, mul_assoc]

/-- **The weighted Schur test, squared form** (finite index types `ι`, `κ` with `κ` nonempty; real
weights): for `w, a, h ≥ 0`, column sums `∑ₓ wₓ a_{ex} ≤ A1` (every `e`) and row sums
`∑ₑ a_{ex} ≤ A2` (every `x`): `∑ₑ (∑ₓ wₓ a_{ex} hₓ)² ≤ A1 A2 ∑ₓ wₓ hₓ²`. (`κ` nonempty gives
`A1 ≥ 0`; for empty `κ` and `A1 < 0` the statement fails. The hypothesis `h ≥ 0` is not used. See
`schur_sq_le_of_nonneg`.) -/
theorem schur_sq_le {ι κ : Type*} [Fintype ι] [Fintype κ] [Nonempty κ] (w : ι → ℝ)
    (a : κ → ι → ℝ) (h : ι → ℝ) (hw : ∀ x, 0 ≤ w x) (ha : ∀ e x, 0 ≤ a e x)
    (_hh : ∀ x, 0 ≤ h x) {A1 A2 : ℝ}
    (h1 : ∀ e, ∑ x, w x * a e x ≤ A1) (h2 : ∀ x, ∑ e, a e x ≤ A2) :
    ∑ e, (∑ x, w x * a e x * h x) ^ 2 ≤ A1 * A2 * ∑ x, w x * h x ^ 2 :=
  schur_sq_le_of_nonneg w a h hw ha
    ((Finset.sum_nonneg fun x _ => mul_nonneg (hw x) (ha (Classical.arbitrary κ) x)).trans
      (h1 _)) h1 h2

/-- `e^x ≤ 1/(1 − c)` for `0 ≤ x ≤ c < 1`. -/
theorem cnt_exp_le {x c : ℝ} (h0 : 0 ≤ x) (hx : x ≤ c) (hc : c < 1) :
    Real.exp x ≤ 1 / (1 - c) :=
  (Real.exp_bound_div_one_sub_of_interval h0 (hx.trans_lt hc)).trans
    (one_div_le_one_div_of_le (sub_pos.2 hc) (sub_le_sub_left hx 1))

/-- **The mixed-block budget** (every real `β = β_W` with `|β| ≤ 1/2000`): the budget hypothesis
`β' e^{1536|β|}/2 + ε_B/(λ − α) ≤ 1` of Part XXXV's `su2_hResidual_of_mixed` holds with `β' = 1/2`,
`ε_B = epsB β`, `λ = (1/2)(1 − 228|β|)²` and `α = λ/2` (numerically `≤ 0.659 + 0.195 < 1`). Only
`e^x ≤ 1/(1 − x)` and arithmetic on small rationals are used. -/
theorem budget_mixed (β : ℝ) (hβ : |β| ≤ 1 / 2000) :
    (1 / 2 : ℝ) * (Real.exp (1536 * |β|) / 2) +
      epsB β / ((1 / 2 : ℝ) * (1 - 228 * |β|) ^ 2 - 1 / 2 * ((1 / 2 : ℝ) * (1 - 228 * |β|) ^ 2)) ≤
      1 := by
  have hE : epsB β = 9216 * (4 * |β| * Real.exp (24 * |β|)) ^ 2 / (1 - 18 * |β|) := rfl
  have hb0 := abs_nonneg β
  rw [hE]
  generalize |β| = b at hβ hb0 ⊢
  have hu : Real.exp (768 * b) ≤ 125 / 77 :=
    (cnt_exp_le (c := 48 / 125) (by positivity) (by linarith only [hβ]) (by norm_num)).trans_eq
      (by norm_num)
  have hT1 : Real.exp (1536 * b) ≤ (125 / 77) ^ 2 := by
    rw [show (1536 : ℝ) * b = 768 * b + 768 * b by ring, Real.exp_add, ← sq]
    exact pow_le_pow_left₀ (Real.exp_pos _).le hu 2
  have hv : Real.exp (24 * b) ≤ 250 / 247 :=
    (cnt_exp_le (c := 3 / 250) (by positivity) (by linarith only [hβ]) (by norm_num)).trans_eq
      (by norm_num)
  have hτ0 : 0 ≤ 4 * b * Real.exp (24 * b) :=
    mul_nonneg (mul_nonneg (by norm_num) hb0) (Real.exp_pos _).le
  have hτ : 4 * b * Real.exp (24 * b) ≤ 1 / 494 :=
    (mul_le_mul (by linarith only [hβ] : 4 * b ≤ 1 / 500) hv (Real.exp_pos _).le
      (by norm_num)).trans_eq (by norm_num)
  have hN : 9216 * (4 * b * Real.exp (24 * b)) ^ 2 ≤ 9216 * (1 / 494) ^ 2 :=
    mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hτ0 hτ 2) (by norm_num)
  have hEps : 9216 * (4 * b * Real.exp (24 * b)) ^ 2 / (1 - 18 * b) ≤
      9216 * (1 / 494) ^ 2 / (991 / 1000) :=
    div_le_div₀ (by norm_num) hN (by norm_num) (by linarith only [hβ])
  have hD : (1 / 4 : ℝ) * (443 / 500) ^ 2 ≤
      (1 / 2 : ℝ) * (1 - 228 * b) ^ 2 - 1 / 2 * ((1 / 2 : ℝ) * (1 - 228 * b) ^ 2) := by
    rw [show (1 / 2 : ℝ) * (1 - 228 * b) ^ 2 - 1 / 2 * ((1 / 2 : ℝ) * (1 - 228 * b) ^ 2) =
      1 / 4 * (1 - 228 * b) ^ 2 by ring]
    exact mul_le_mul_of_nonneg_left
      (pow_le_pow_left₀ (by norm_num) (by linarith only [hβ]) 2) (by norm_num)
  have hB : 9216 * (4 * b * Real.exp (24 * b)) ^ 2 / (1 - 18 * b) /
      ((1 / 2 : ℝ) * (1 - 228 * b) ^ 2 - 1 / 2 * ((1 / 2 : ℝ) * (1 - 228 * b) ^ 2)) ≤
      9216 * (1 / 494) ^ 2 / (991 / 1000) / ((1 / 4 : ℝ) * (443 / 500) ^ 2) :=
    div_le_div₀ (by norm_num) hEps (by norm_num) hD
  calc _ ≤ (1 / 2 : ℝ) * ((125 / 77) ^ 2 / 2) +
        9216 * (1 / 494) ^ 2 / (991 / 1000) / ((1 / 4 : ℝ) * (443 / 500) ^ 2) :=
        add_le_add (by linarith only [hT1]) hB
    _ ≤ 1 := by norm_num

end CountsSchur

