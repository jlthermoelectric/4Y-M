a functional `Γ ≥ 0` on `H_c` with `‖B v‖² ≤ ε_B Γ v`, `⟪J* v, D_c J* v⟫ ≤ (e^{576b}/2) Γ v` and
`(1 − ((e^{36b} − 1) e^{18b})²) Γ v ≤ ⟪v, C v⟫`, where
`ε_B = (63/2)(e^{12b} − 1)² e^{108b}/(1 − 72b)`. Conclusion: `D ≥ (1/230) I`. The proof is Part XVI's
`su2_gap_of_local_residual` with `α = 1/230`, `β' = 3/5`, `ϖ_c = (1 − 72b)/128` from
`su2_coarse_gap_of_singleLink` and the budget `budget_small_beta`; no constant depends on `M`.
This is a finite-volume lower bound for the heat-bath generator at deep strong coupling, not a mass
gap. -/
theorem su2_gap_small_beta_of_estimates (hβ : |β| ≤ 1 / 1000)
    (hfine : SingleLinkPoincare M β (1 - 72 * |β|))
    (hcons : ∀ u, (su2Pi M β).P u = 0 →
      (1 - 72 * |β|) / 56 * ‖u‖ ^ 2 ≤
        ∑ x, 1 / 16 * ‖u - su2P M β (cube2 M x \ skel (straightBlocking M)) u‖ ^ 2)
    (Γ : (su2Pi M β).Hc → ℝ) (hΓ : ∀ v, 0 ≤ Γ v)
    (hB : ∀ v, ‖(su2Pi M β).blkB (su2D M β (cube2 M) (fun _ => 1 / 16)) v‖ ^ 2 ≤
      63 / 2 * (Real.exp (12 * |β|) - 1) ^ 2 * Real.exp (108 * |β|) / (1 - 72 * |β|) * Γ v)
    (hg : ∀ v, (su2Pi M β).gC (su2Jt M β) (su2Dc M β (sideTwoCube M) (fun _ => 1 / 16)) v ≤
      Real.exp (576 * |β|) / 2 * Γ v)
    (hC : ∀ v, (1 - ((Real.exp (36 * |β|) - 1) * Real.exp (18 * |β|)) ^ 2) * Γ v ≤
      ⟪v, (su2Pi M β).blkC (su2D M β (cube2 M) (fun _ => 1 / 16)) v⟫_ℝ) :
    (1 / 230 : ℝ) • LinearMap.id ≤ su2D M β (cube2 M) (fun _ => 1 / 16) := by
  have hb0 : 0 ≤ |β| := abs_nonneg β
  have hCG := su2_coarse_gap_of_singleLink M β hfine
  have hα : (1 / 230 : ℝ) < (1 - 72 * |β|) / 56 := by linarith
  have h := SmallCoupling.su2_gap_of_local_residual M β (cube2 M) (fun _ => 1 / 16)
    (fun _ => by norm_num) (sideTwoCube M) (fun _ => 1 / 16) (β' := 3 / 5) hcons hα (by norm_num)
    hCG Γ hΓ hB hg hC (budget_small_beta hb0 hβ)
  have hmin : min (1 / 230 : ℝ) (3 / 5 * ((1 - 72 * |β|) / 128)) = 1 / 230 :=
    min_eq_left (by linarith)
  calc (1 / 230 : ℝ) • LinearMap.id =
        (min (1 / 230 : ℝ) (3 / 5 * ((1 - 72 * |β|) / 128))) • LinearMap.id := by rw [hmin]
    _ ≤ _ := h

/-- **Non-vacuity of `su2_gap_small_beta_of_estimates`** (every `M ≥ 1`, `β = 0`): every hypothesis
is discharged (`singleLinkPoincare_zero`; `hcons` from Part XVII's `su2_hcons_zero_half`; `B = 0` by
Part XV's `su2_blkB_zero`; `Γ v = ⟪v, C v⟫` with Part XVIII's `su2_gC_le_zero`), so `D ≥ (1/230) I`.
The elementary bound at `β = 0` is larger; this instance only shows the hypotheses can be met. -/
theorem su2_gap_small_beta_zero :
    (1 / 230 : ℝ) • LinearMap.id ≤ su2D M 0 (cube2 M) (fun _ => 1 / 16) := by
  have ha : |(0 : ℝ)| = 0 := abs_zero
  have hCG0 := SchurTower.form_of_smul_id_le (su2_coarse_gap_zero M)
  have hgC : ∀ v : (su2Pi M 0).Hc,
      0 ≤ (su2Pi M 0).gC (su2Jt M 0) (su2Dc M 0 (sideTwoCube M) (fun _ => 1 / 16)) v := by
    intro v
    have h1 := hCG0 (su2Jt M 0 v)
    rw [OrthProj.gC]
    linarith [sq_nonneg ‖su2Jt M 0 v‖]
  refine su2_gap_small_beta_of_estimates M 0 (by rw [ha]; norm_num)
    (by rw [ha, mul_zero, sub_zero]; exact singleLinkPoincare_zero M)
    (fun u hu => ?_) (fun v => ⟪v, (su2Pi M 0).blkC (su2D M 0 (cube2 M) (fun _ => 1 / 16)) v⟫_ℝ)
    (fun v => ?_) (fun v => ?_) (fun v => ?_) (fun v => ?_)
  · have h := SkeletonCondExp.su2_hcons_zero_half M u hu
    rw [ha]
    linarith [sq_nonneg ‖u‖]
  · have h1 := UniformEndpoint.su2_gC_le_zero M v
    have h2 := hgC v
    linarith
  · have h0 : ‖(su2Pi M 0).blkB (su2D M 0 (cube2 M) (fun _ => 1 / 16)) v‖ ^ 2 = 0 := by
      rw [su2_blkB_zero M v]
      simp
    calc ‖(su2Pi M 0).blkB (su2D M 0 (cube2 M) (fun _ => 1 / 16)) v‖ ^ 2 = 0 := h0
      _ ≤ _ := by simp
  · have h1 := UniformEndpoint.su2_gC_le_zero M v
    simp only [ha, mul_zero, Real.exp_zero]
    linarith
  · simp only [ha, mul_zero, Real.exp_zero, sub_self, zero_mul]
    norm_num

end Assembly

section FromInfluence

/-- **The cube generator at small coupling, with `hcons` from the influence hypothesis of Part XXI of
this file** (SU(2) on `(ℤ/2Mℤ)⁴`, `d = 4`, every `M ≥ 1`, `|β| ≤ 1/1000` in the normalisation of
Part VI's `su2Wilson`, straight blocking, fine side-2 cubes `cube2 M x` and coarse side-2 cubes
`sideTwoCube M z` at every base point, all weights `1/16`). Part XXI's named hypothesis
`SweepContraction.SU2HeatBathInfluence M β (228 |β|)` gives, through
`SweepContraction.su2_hcons_small_beta`, `hcons` with `λ = (1/2)(1 − 228|β|)²`. For `|β| ≤ 1/1000`
this is at least `1/2 · (772/1000)² ≥ 1/56 ≥ (1 − 72|β|)/56`, which is the `hcons` input of
