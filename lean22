open OrientedGraph

section Occurrence

variable {S E : Type*} [OrientedGraph S E] {G : Type*} [Group G]

/-- The links of a fine path, in order (forward and backward traversals alike). -/
def pathLinks {x y : S} : FPath S E x y → List E
  | .nil _ => []
  | .fwd e p => e :: pathLinks p
  | .bwd e p => e :: pathLinks p

theorem pathLinks_cast {x y x' y' : S} (hx : x = x') (hy : y = y') (p : FPath S E x y) :
    pathLinks (p.cast hx hy) = pathLinks p := by
  subst hx
  subst hy
  rfl

/-- A path that avoids `e₀` has the same holonomy for two configurations that agree off `e₀`. -/
theorem pathProd_eq_of_notMem {e0 : E} {x y : S} (p : FPath S E x y) (hp : e0 ∉ pathLinks p)
    {V V' : E → G} (hV : ∀ e, e ≠ e0 → V e = V' e) : pathProd p V = pathProd p V' := by
  induction p with
  | nil x => rfl
  | fwd e p ih =>
      simp only [pathLinks, List.mem_cons, not_or] at hp
      simp only [pathProd]
      rw [hV e (Ne.symm hp.1), ih hp.2]
  | bwd e p ih =>
      simp only [pathLinks, List.mem_cons, not_or] at hp
      simp only [pathProd]
      rw [hV e (Ne.symm hp.1), ih hp.2]

/-- **A link traversed exactly once is pinned by the holonomy**: if `p` traverses `e₀` exactly
once and `V`, `V'` agree off `e₀`, then `V(p) = V'(p)` forces `V e₀ = V' e₀`. -/
theorem eq_at_of_count_one [DecidableEq E] {e0 : E} {x y : S} (p : FPath S E x y)
    (hp : (pathLinks p).count e0 = 1) {V V' : E → G} (hV : ∀ e, e ≠ e0 → V e = V' e)
    (h : pathProd p V = pathProd p V') : V e0 = V' e0 := by
  induction p with
  | nil x => simp [pathLinks] at hp
  | fwd e p ih =>
      simp only [pathProd] at h
      by_cases he : e = e0
      · subst he
        have h0 : (pathLinks p).count e = 0 := by
          simpa [pathLinks, List.count_cons] using hp
        rw [pathProd_eq_of_notMem p (List.count_eq_zero.1 h0) hV] at h
        exact mul_right_cancel h
      · have h1 : (pathLinks p).count e0 = 1 := by
          simpa [pathLinks, List.count_cons, he] using hp
        rw [hV e he] at h
        exact ih h1 (mul_left_cancel h)
  | bwd e p ih =>
      simp only [pathProd] at h
      by_cases he : e = e0
      · subst he
        have h0 : (pathLinks p).count e = 0 := by
          simpa [pathLinks, List.count_cons] using hp
        rw [pathProd_eq_of_notMem p (List.count_eq_zero.1 h0) hV] at h
        exact _root_.inv_inj.1 (mul_right_cancel h)
      · have h1 : (pathLinks p).count e0 = 1 := by
          simpa [pathLinks, List.count_cons, he] using hp
        rw [hV e he] at h
        exact ih h1 (mul_left_cancel h)

end Occurrence

section NullSet

/-- **Pinned sets are null for a product of left-invariant probability measures on an infinite
group.** If any two points of a measurable set `Z` that agree off the coordinate `e₀` agree at
`e₀`, then the translates of `Z` by `g n` in the coordinate `e₀` (`g` injective) are pairwise
disjoint and have the measure of `Z`, so `Z` is null. -/
theorem pi_null_of_pinned {E G : Type*} [Fintype E] [DecidableEq E] [Group G] [MeasurableSpace G]
    [MeasurableMul G] (h : Measure G) [IsProbabilityMeasure h] [h.IsMulLeftInvariant]
    {g : ℕ → G} (hg : Function.Injective g) (e0 : E) {Z : Set (E → G)} (hZ : MeasurableSet Z)
    (hpin : ∀ V ∈ Z, ∀ V' ∈ Z, (∀ e, e ≠ e0 → V e = V' e) → V e0 = V' e0) :
    Measure.pi (fun _ : E => h) Z = 0 := by
  let c : ℕ → E → G := fun n e => if e = e0 then g n else 1
  let T : ℕ → (E → G) → (E → G) := fun n U e => c n e * U e
  have hT : ∀ n, MeasurePreserving (T n) (Measure.pi fun _ : E => h)
      (Measure.pi fun _ : E => h) := fun n =>
    measurePreserving_pi (fun _ => h) (fun _ => h) (f := fun e u => c n e * u)
      fun e => measurePreserving_mul_left h (c n e)
  have hA : ∀ n, Measure.pi (fun _ : E => h) (T n ⁻¹' Z) = Measure.pi (fun _ : E => h) Z :=
    fun n => (hT n).measure_preimage hZ.nullMeasurableSet
  have hmeas : ∀ n, MeasurableSet (T n ⁻¹' Z) := fun n => (hT n).measurable hZ
  have hdisj : Pairwise (Function.onFun Disjoint fun n => T n ⁻¹' Z) := by
    intro n m hnm
    refine Set.disjoint_left.2 fun U hn hm => hnm ?_
    have hoff : ∀ e, e ≠ e0 → T n U e = T m U e := fun e he => by simp [T, c, he]
    have h0 := hpin _ hn _ hm hoff
    simp only [T, c] at h0
    exact hg (mul_right_cancel h0)
  have hU := measure_iUnion (μ := Measure.pi fun _ : E => h) hdisj hmeas
  by_contra hne
  have htop : ∑' n : ℕ, Measure.pi (fun _ : E => h) (T n ⁻¹' Z) = ⊤ := by
    simp_rw [hA]
    exact ENNReal.tsum_const_eq_top_of_ne_zero hne
  rw [htop] at hU
  exact measure_ne_top _ _ hU

/-- The rotation `[[cos t, −sin t], [sin t, cos t]]` as an element of `SU(2)`. -/
noncomputable def rotSU2 (t : ℝ) : SU2 :=
  ⟨!![(Real.cos t : ℂ), -(Real.sin t : ℂ); (Real.sin t : ℂ), (Real.cos t : ℂ)],
    mem_SU2_of_quat (mem_quatSub.2 ⟨by
        show (Real.cos t : ℂ) = star (Real.cos t : ℂ)
        rw [Complex.star_def, Complex.conj_ofReal], by
        show -(Real.sin t : ℂ) = -star (Real.sin t : ℂ)
        rw [Complex.star_def, Complex.conj_ofReal]⟩)
      (by
        simp only [qnorm, Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero,
          Matrix.cons_val_one, Matrix.empty_val', Matrix.cons_val_fin_one, Complex.normSq_ofReal]
        linear_combination Real.cos_sq_add_sin_sq t)⟩

theorem rotSU2_apply00 (t : ℝ) : ((rotSU2 t : SU2) : Matrix (Fin 2) (Fin 2) ℂ) 0 0 = Real.cos t := by
  simp [rotSU2]

/-- **SU(2) is infinite**: `n ↦ rot(1/(n+1))` is injective (`cos` is injective on `[0, Real.pi]`). -/
theorem rotSeq_injective : Function.Injective fun n : ℕ => rotSU2 (1 / ((n : ℝ) + 1)) := by
  intro n m h
  have h00 := congrArg (fun A : SU2 => ((A : Matrix (Fin 2) (Fin 2) ℂ) 0 0).re) h
  simp only [rotSU2_apply00, Complex.ofReal_re] at h00
  have hmem : ∀ k : ℕ, 1 / ((k : ℝ) + 1) ∈ Set.Icc 0 Real.pi := fun k => by
    have hk : (0 : ℝ) ≤ k := k.cast_nonneg
    refine ⟨by positivity, ?_⟩
    have h1 : 1 / ((k : ℝ) + 1) ≤ 1 := by
      rw [div_le_one (by positivity)]
      linarith
    linarith [Real.pi_gt_three]
  have h2 := Real.injOn_cos (hmem n) (hmem m) h00
  rw [one_div, one_div, _root_.inv_inj] at h2
  exact_mod_cast add_right_cancel h2

end NullSet

section PrivateLink

variable {S E Sc Ec ι : Type*} [OrientedGraph S E] [OrientedGraph Sc Ec] [Fintype ι]
  (pb : PathBlocking S E Sc Ec ι)

/-- **A private link of the coarse link `ē`** (up to paths with the same holonomy): a fine link
`e₀`, a path index `i₀` and a set `s` of path indices such that every path in `s` has the
holonomy of path `i₀` for every configuration, path `i₀` traverses `e₀` exactly once, every path
outside `s` either has weight `0` or avoids `e₀`, and the weights in `s` do not sum to `0`. With
`s = {i₀}` this says: `e₀` occurs in exactly one path, exactly once, and that path has a nonzero
weight. -/
def HasPrivateLink [DecidableEq E] (ē : Ec) : Prop :=
  ∃ (e0 : E) (i0 : ι) (s : Finset ι),
    (∀ i ∈ s, ∀ U : E → SU2, pathProd (pb.path ē i) U = pathProd (pb.path ē i0) U) ∧
    (pathLinks (pb.path ē i0)).count e0 = 1 ∧
    (∀ i ∉ s, pb.wt ē i = 0 ∨ e0 ∉ pathLinks (pb.path ē i)) ∧
    ∑ i ∈ s, pb.wt ē i ≠ 0

omit [Fintype ι] in
/-- The strict form: `e₀` occurs in exactly one path, exactly once, with nonzero weight. -/
theorem hasPrivateLink_of_unique [DecidableEq E] {ē : Ec} (e0 : E) (i0 : ι)
    (hone : (pathLinks (pb.path ē i0)).count e0 = 1)
    (hout : ∀ i, i ≠ i0 → e0 ∉ pathLinks (pb.path ē i)) (hw : pb.wt ē i0 ≠ 0) :
    HasPrivateLink pb ē := by
  classical
  refine ⟨e0, i0, {i0}, fun i hi U => by rw [Finset.mem_singleton.1 hi], hone,
    fun i hi => Or.inr (hout i fun h => hi (Finset.mem_singleton.2 h)), ?_⟩
  rw [Finset.sum_singleton]
  exact hw

/-- **Pinning**: with a private link `e₀` of `ē`, two configurations that agree off `e₀` and
have the same weighted sum `Q_ē` agree at `e₀`. -/
theorem eq_at_of_qsum_eq [DecidableEq E] {ē : Ec} {e0 : E} {i0 : ι} {s : Finset ι}
    (hhol : ∀ i ∈ s, ∀ U : E → SU2, pathProd (pb.path ē i) U = pathProd (pb.path ē i0) U)
    (hone : (pathLinks (pb.path ē i0)).count e0 = 1)
    (hout : ∀ i ∉ s, pb.wt ē i = 0 ∨ e0 ∉ pathLinks (pb.path ē i))
    (hw : ∑ i ∈ s, pb.wt ē i ≠ 0) {V V' : E → SU2} (hV : ∀ e, e ≠ e0 → V e = V' e)
    (hq : qsum pb V ē = qsum pb V' ē) : V e0 = V' e0 := by
  classical
  let D : Matrix (Fin 2) (Fin 2) ℂ := ((pathProd (pb.path ē i0) V : SU2) : Matrix (Fin 2) (Fin 2) ℂ) -
    ((pathProd (pb.path ē i0) V' : SU2) : Matrix (Fin 2) (Fin 2) ℂ)
  have hout' : ∀ i ∈ sᶜ, pb.wt ē i • (((pathProd (pb.path ē i) V : SU2) :
      Matrix (Fin 2) (Fin 2) ℂ) - ((pathProd (pb.path ē i) V' : SU2) :
      Matrix (Fin 2) (Fin 2) ℂ)) = 0 := by
    intro i hi
    rcases hout i (Finset.mem_compl.1 hi) with h0 | h0
    · rw [h0, zero_smul]
    · rw [pathProd_eq_of_notMem _ h0 hV, sub_self, smul_zero]
  have hin : ∀ i ∈ s, pb.wt ē i • (((pathProd (pb.path ē i) V : SU2) :
      Matrix (Fin 2) (Fin 2) ℂ) - ((pathProd (pb.path ē i) V' : SU2) :
      Matrix (Fin 2) (Fin 2) ℂ)) = pb.wt ē i • D := by
    intro i hi
    rw [hhol i hi V, hhol i hi V']
  have key : qsum pb V ē - qsum pb V' ē = (∑ i ∈ s, pb.wt ē i) • D := by
    simp only [qsum]
    rw [← Finset.sum_sub_distrib]
    simp_rw [← smul_sub]
    rw [← Finset.sum_add_sum_compl s, Finset.sum_eq_zero hout', add_zero,
      Finset.sum_congr rfl hin, Finset.sum_smul]
  rw [hq, sub_self] at key
  have hD0 : D = 0 := (smul_eq_zero.1 key.symm).resolve_left hw
  have hP : pathProd (pb.path ē i0) V = pathProd (pb.path ē i0) V' :=
    Subtype.ext (sub_eq_zero.1 hD0)
  exact eq_at_of_count_one _ hone hV hP

/-- **The null-set hypothesis from private links**: if every coarse link has a private link,
the zero set `{U : some Q_ē(U) = 0}` is null for the product Haar measure. -/
theorem hnull_of_private [Fintype E] [DecidableEq E] [Countable Ec]
    (hpriv : ∀ ē, HasPrivateLink pb ē) :
    Measure.pi (fun _ : E => haarSU2) (zeroSet pb) = 0 := by
  have hZ : zeroSet pb = ⋃ ē, {U : E → SU2 | qsum pb U ē = 0} := by
    ext U
    simp [zeroSet]
  rw [hZ]
  refine measure_iUnion_null fun ē => ?_
  obtain ⟨e0, i0, s, hhol, hone, hout, hw⟩ := hpriv ē
  refine pi_null_of_pinned haarSU2 rotSeq_injective e0
    (isClosed_eq (continuous_qsum pb ē) continuous_const).measurableSet ?_
  intro V hV V' hV' hoff
  exact eq_at_of_qsum_eq pb hhol hone hout hw hoff (hV.trans hV'.symm)

end PrivateLink


section PrivateInputs

variable {S E Sc Ec ι : Type*} [OrientedGraph S E] [OrientedGraph Sc Ec] [Fintype ι]
  (pb : PathBlocking S E Sc Ec ι) [Fintype E] [DecidableEq E] [Countable Ec]

/-- **`hWilson` for path blockings with private links**: Part XIX's `su2_inputs_of_paths` with its
null-set hypothesis supplied by `hnull_of_private`. For the SU(2) Wilson measure on any finite
oriented lattice, any coupling, any path blocking in which every coarse link has a private link
(any real weights), and arbitrary fine and coarse link sets and weights, every field of
`CubeSplitInputs` holds. -/
theorem su2_inputs_of_private {Pl : Type*} [Fintype Pl] (plaq : Pl → Plaq S E) (κ : ℝ) (V0 : SU2)
    (hpriv : ∀ ē, HasPrivateLink pb ē) {ιx ιc : Type*} [Fintype ιx] [Fintype ιc]
    (V : ιx → Set E) (w : ιx → ℝ) (Vc : ιc → Set Ec) (wc : ιc → ℝ) :
    CubeSplitInputs (cubeGen w fun x => wilsonP plaq reTr κ haarSU2 (V x)) w
      (fun x => wilsonP plaq reTr κ haarSU2 (V x))
      (isoProj (aeJ plaq reTr κ haarSU2 (avgCoarseMap pb plaq κ V0 (hnull_of_private pb hpriv))))
      (aeJ plaq reTr κ haarSU2 (avgCoarseMap pb plaq κ V0 (hnull_of_private pb hpriv)) :
        aeY plaq reTr κ haarSU2 (avgCoarseMap pb plaq κ V0 (hnull_of_private pb hpriv)) →ₗ[ℝ]
          wilsonH plaq reTr κ haarSU2)
      (isoAdj (aeJ plaq reTr κ haarSU2 (avgCoarseMap pb plaq κ V0 (hnull_of_private pb hpriv))) :
        wilsonH plaq reTr κ haarSU2 →ₗ[ℝ]
          aeY plaq reTr κ haarSU2 (avgCoarseMap pb plaq κ V0 (hnull_of_private pb hpriv)))
      (cubeGen wc fun z => lawP (aeLaw plaq reTr κ haarSU2
        (avgCoarseMap pb plaq κ V0 (hnull_of_private pb hpriv))) (Vc z)) :=
  su2_inputs_of_paths pb plaq κ V0 (hnull_of_private pb hpriv) V w Vc wc

end PrivateInputs

/-! ## Walks on the periodic lattice `(ℤ/nℤ)⁴` -/

section Walks

variable {n : ℕ}

/-- A signed lattice step: a direction and an orientation (`true`: forwards). -/
abbrev Step := Fin 4 × Bool

/-- The end point of the walk with steps `s` from `x`. -/
def endpt (x : Site n) : List Step → Site n
  | [] => x
  | (i, true) :: s => endpt (x + unitV i) s
  | (i, false) :: s => endpt (x - unitV i) s

/-- The fine path of the walk with steps `s` from `x`. -/
def walk (x : Site n) : (s : List Step) → FPath (Site n) (Link n) x (endpt x s)
  | [] => FPath.nil x
  | (i, true) :: s => FPath.fwd (x, i) (walk (x + unitV i) s)
  | (i, false) :: s =>
      (FPath.bwd (x - unitV i, i) (walk (x - unitV i) s)).cast (sub_add_cancel x (unitV i)) rfl

/-- The links traversed by the walk with steps `s` from `x`. -/
def linksOf (x : Site n) : List Step → List (Link n)
  | [] => []
  | (i, true) :: s => (x, i) :: linksOf (x + unitV i) s
  | (i, false) :: s => (x - unitV i, i) :: linksOf (x - unitV i) s

theorem pathLinks_walk (x : Site n) (s : List Step) : pathLinks (walk x s) = linksOf x s := by
  induction s generalizing x with
  | nil => rfl
  | cons st s ih =>
      obtain ⟨i, b⟩ := st
      cases b
      · show pathLinks ((FPath.bwd (x - unitV i, i) (walk (x - unitV i) s)).cast _ rfl) = _
        rw [pathLinks_cast]
        exact congrArg _ (ih _)
      · show pathLinks (FPath.fwd (x, i) (walk (x + unitV i) s)) = _
        exact congrArg _ (ih _)

theorem pathProd_walk_fwd {G : Type*} [Group G] (x : Site n) (i : Fin 4) (s : List Step)
    (U : Link n → G) :
    pathProd (walk x ((i, true) :: s)) U = U (x, i) * pathProd (walk (x + unitV i) s) U := rfl

theorem pathProd_walk_bwd {G : Type*} [Group G] (x : Site n) (i : Fin 4) (s : List Step)
    (U : Link n → G) :
    pathProd (walk x ((i, false) :: s)) U =
      (U (x - unitV i, i))⁻¹ * pathProd (walk (x - unitV i) s) U := by
  show pathProd ((FPath.bwd (x - unitV i, i) (walk (x - unitV i) s)).cast _ rfl) U = _
  rw [pathProd_cast]
  rfl

/-- **A backtrack does not change the holonomy**: inserting a step forwards along `i` followed
by the same step backwards. -/
theorem pathProd_walk_backtrack {G : Type*} [Group G] (U : Link n → G) (i : Fin 4)
    (s2 : List Step) :
    ∀ (s1 : List Step) (x : Site n),
      pathProd (walk x (s1 ++ (i, true) :: (i, false) :: s2)) U = pathProd (walk x (s1 ++ s2)) U
  | [], x => by
      simp only [List.nil_append]
      rw [pathProd_walk_fwd, pathProd_walk_bwd, add_sub_cancel_right, ← mul_assoc, mul_inv_cancel,
        one_mul]
  | (j, true) :: s1, x => by
      simp only [List.cons_append]
      rw [pathProd_walk_fwd, pathProd_walk_fwd, pathProd_walk_backtrack U i s2 s1]
  | (j, false) :: s1, x => by
      simp only [List.cons_append]
      rw [pathProd_walk_bwd, pathProd_walk_bwd, pathProd_walk_backtrack U i s2 s1]

/-! ### Integer offsets -/

/-- The site with integer coordinates `a` (reduced mod `n`). -/
def ofOff (a : Fin 4 → ℤ) : Site n := fun i => (a i : ZMod n)

theorem ofOff_add (a b : Fin 4 → ℤ) : (ofOff (a + b) : Site n) = ofOff a + ofOff b := by
  funext i
  simp [ofOff]

theorem ofOff_sub (a b : Fin 4 → ℤ) : (ofOff (a - b) : Site n) = ofOff a - ofOff b := by
  funext i
  simp [ofOff]

theorem ofOff_zero : (ofOff 0 : Site n) = 0 := by
  funext i
  simp [ofOff]

theorem ofOff_single (i : Fin 4) (c : ℤ) : (ofOff (Pi.single i c) : Site n) = Pi.single i (c : ZMod n) := by
  funext j
  by_cases h : j = i
  · subst h
    simp [ofOff]
  · simp [ofOff, Pi.single_eq_of_ne h]

theorem ofOff_unitV (i : Fin 4) : (ofOff (Pi.single i 1) : Site n) = unitV i := by
  rw [ofOff_single, Int.cast_one]
  rfl

/-- The links of a walk from the integer point `a`, as integer offsets and directions. -/
def linksOff (a : Fin 4 → ℤ) : List Step → List ((Fin 4 → ℤ) × Fin 4)
  | [] => []
  | (i, true) :: s => (a, i) :: linksOff (a + Pi.single i 1) s
  | (i, false) :: s => (a - Pi.single i 1, i) :: linksOff (a - Pi.single i 1) s

/-- The integer end point of a walk from `a`. -/
def endOff (a : Fin 4 → ℤ) : List Step → (Fin 4 → ℤ)
  | [] => a
  | (i, true) :: s => endOff (a + Pi.single i 1) s
  | (i, false) :: s => endOff (a - Pi.single i 1) s

theorem linksOf_off (x : Site n) (s : List Step) :
    ∀ a : Fin 4 → ℤ, linksOf (x + ofOff a) s = (linksOff a s).map fun p => (x + ofOff p.1, p.2) := by
  induction s with
  | nil => intro a; rfl
  | cons st s ih =>
      obtain ⟨i, b⟩ := st
      intro a
      cases b
      · have h : x + ofOff a - unitV i = x + ofOff (a - Pi.single i 1) := by
          rw [ofOff_sub, ofOff_unitV, add_sub_assoc]
        simp only [linksOf, linksOff, List.map_cons, h, ih]
      · have h : x + ofOff a + unitV i = x + ofOff (a + Pi.single i 1) := by
          rw [ofOff_add, ofOff_unitV, add_assoc]
        simp only [linksOf, linksOff, List.map_cons, h, ih]

theorem endpt_off (x : Site n) (s : List Step) :
    ∀ a : Fin 4 → ℤ, endpt (x + ofOff a) s = x + ofOff (endOff a s) := by
  induction s with
  | nil => intro a; rfl
  | cons st s ih =>
      obtain ⟨i, b⟩ := st
      intro a
      cases b
      · have h : x + ofOff a - unitV i = x + ofOff (a - Pi.single i 1) := by
          rw [ofOff_sub, ofOff_unitV, add_sub_assoc]
        simp only [endpt, endOff, h, ih]
      · have h : x + ofOff a + unitV i = x + ofOff (a + Pi.single i 1) := by
          rw [ofOff_add, ofOff_unitV, add_assoc]
        simp only [endpt, endOff, h, ih]

/-- Integer points with coordinates in `{0, 1, 2, 3}` stay distinct modulo `n ≥ 4`. -/
theorem ofOff_inj (hn : 4 ≤ n) {a b : Fin 4 → ℤ} (ha : ∀ i, 0 ≤ a i ∧ a i < 4)
    (hb : ∀ i, 0 ≤ b i ∧ b i < 4) (h : (ofOff a : Site n) = ofOff b) : a = b := by
  funext i
  have hi := congrFun h i
  simp only [ofOff] at hi
  rw [ZMod.intCast_eq_intCast_iff_dvd_sub] at hi
  have hn' : (4 : ℤ) ≤ n := by exact_mod_cast hn
  have h0 := Int.eq_zero_of_abs_lt_dvd hi (by
    rw [abs_lt]
    obtain ⟨ha1, ha2⟩ := ha i
    obtain ⟨hb1, hb2⟩ := hb i
    constructor <;> linarith)
  linarith

theorem count_map_off (hn : 4 ≤ n) (x : Site n) (L : List ((Fin 4 → ℤ) × Fin 4))
    (q : (Fin 4 → ℤ) × Fin 4) (hL : ∀ p ∈ L, ∀ i, 0 ≤ p.1 i ∧ p.1 i < 4)
    (hq : ∀ i, 0 ≤ q.1 i ∧ q.1 i < 4) :
    @List.count (Link n) instBEqOfDecidableEq (x + ofOff q.1, q.2)
      (L.map fun p => ((x + ofOff p.1 : Site n), p.2)) = L.count q := by
  induction L with
  | nil => rfl
  | cons p L ih =>
      simp only [List.map_cons, List.count_cons]
      rw [ih fun p' hp' => hL p' (List.mem_cons_of_mem _ hp')]
      have hiff : (((x + ofOff p.1 : Site n), p.2) = (x + ofOff q.1, q.2)) ↔ p = q := by
        constructor
        · intro h
          rw [Prod.mk.injEq] at h
          exact Prod.ext (ofOff_inj hn (hL p List.mem_cons_self) hq (add_left_cancel h.1)) h.2
        · intro h
          rw [h]
      simp only [beq_iff_eq, hiff]

end Walks

/-! ## The connected box path family `(ℤ/2Mℤ)⁴ → (ℤ/Mℤ)⁴` -/

section Box

/-- `ε_i(k)`: bit `i` of `k`, so that `k ↦ ε(k)` enumerates `{0, 1}⁴`. -/
def epsOf (k : Fin 16) (i : Fin 4) : Bool := k.val.testBit i.val

/-- The lexicographic contour `0 → ε(k)`: forward steps along the `i` with `ε_i = 1`, in
increasing order. -/
def upSteps (k : Fin 16) : List Step :=
  (([0, 1, 2, 3] : List (Fin 4)).filter (epsOf k)).map fun i => (i, true)

/-- **The steps of the box path `(k, μ)`**: the contour `2y → 2y + ε(k)`, two forward steps along
`μ`, and the contour back from `2y + ε(k) + 2e_μ` to `2y + 2e_μ`. -/
def boxSteps (k : Fin 16) (μ : Fin 4) : List Step :=
  upSteps k ++ [(μ, true), (μ, true)] ++ ((upSteps k).reverse.map fun st => (st.1, false))

theorem endOff_box : ∀ k : Fin 16, ∀ μ : Fin 4, endOff 0 (boxSteps k μ) = Pi.single μ 2 := by
  decide +kernel

/-- The path index whose private link is used (`ε = e₃` for `μ ≠ 3`, `ε = e₂` for `μ = 3`). -/
def i0Of (μ : Fin 4) : Fin 16 := if μ = 3 then 4 else 8

/-- The offset of the private link (`e₃` for `μ ≠ 3`, `e₂` for `μ = 3`); its direction is `μ`. -/
def b0Of (μ : Fin 4) : Fin 4 → ℤ := if μ = 3 then Pi.single 2 1 else Pi.single 3 1

/-- The paths with the holonomy of path `i0Of μ` that are allowed to contain the private link. -/
def sOf (μ : Fin 4) : Finset (Fin 16) := if μ = 3 then {4, 12} else {8}

theorem box_once : ∀ μ : Fin 4, (linksOff 0 (boxSteps (i0Of μ) μ)).count (b0Of μ, μ) = 1 := by
  decide

theorem box_out : ∀ μ : Fin 4, ∀ k : Fin 16, k ∉ sOf μ → (b0Of μ, μ) ∉ linksOff 0 (boxSteps k μ) := by
  decide +kernel

theorem box_range : ∀ μ : Fin 4, ∀ k : Fin 16, ∀ p ∈ linksOff 0 (boxSteps k μ),
    ∀ i, 0 ≤ p.1 i ∧ p.1 i < 4 := by
  decide +kernel

/-- **No strict private link for `μ = 3`** (integer-offset form): every link of every box path
`(k, 3)` is traversed at least twice by it or also by another box path `(k', 3)`. The statement is
about integer offsets; its transfer to `(ℤ/2Mℤ)⁴` (by `ofOff_inj` for `M ≥ 2`) is not stated here. -/
theorem box_no_strict_private_three : ∀ k : Fin 16, ∀ p ∈ linksOff 0 (boxSteps k 3),
    (linksOff 0 (boxSteps k 3)).count p ≠ 1 ∨
      ∃ k' : Fin 16, k' ≠ k ∧ p ∈ linksOff 0 (boxSteps k' 3) := by
  decide +kernel

theorem b0Of_range : ∀ μ : Fin 4, ∀ i, 0 ≤ b0Of μ i ∧ b0Of μ i < 4 := by
  decide

theorem i0Of_mem : ∀ μ : Fin 4, i0Of μ ∈ sOf μ := by
  decide

theorem boxSteps_12 : boxSteps 12 3 = [(2, true), (3, true), (3, true)] ++
    (3, true) :: (3, false) :: [(2, false)] := by
  decide

theorem boxSteps_4 : boxSteps 4 3 = [(2, true), (3, true), (3, true)] ++ [(2, false)] := by
  decide

variable (M : ℕ)

theorem endpt_box (y : Site M) (μ : Fin 4) (k : Fin 16) :
    endpt (ιS M y) (boxSteps k μ) = ιS M (y + unitV μ) := by
  have h := endpt_off (ιS M y) (boxSteps k μ) 0
  rw [ofOff_zero, add_zero] at h
  rw [h, endOff_box k μ, ιS_add_unitV, add_assoc, ofOff_single]
  congr 1
  funext j
  by_cases hj : j = μ
  · subst hj
    simp [unitV]
    norm_num
  · simp [unitV, Pi.single_eq_of_ne hj]

/-- **The box path** `(k, μ)` from `2y` to `2(y + e_μ)`. -/
def boxPath (y : Site M) (μ : Fin 4) (k : Fin 16) :
    FPath (Site (2 * M)) (Link (2 * M)) (ιS M y) (ιS M (y + unitV μ)) :=
  (walk (ιS M y) (boxSteps k μ)).cast rfl (endpt_box M y μ k)

/-- **The connected box path blocking** `(ℤ/2Mℤ)⁴ → (ℤ/Mℤ)⁴` (block averaging in the spirit of
Bałaban's averaging operations; the average of SU(2) holonomies is projected back onto SU(2)): the
coarse link
`(y, μ)` carries the 16 box paths `(k, μ)`, `ε(k) ∈ {0, 1}⁴`, each with weight `1/16`. -/
noncomputable def boxPathBlocking : PathBlocking (Site (2 * M)) (Link (2 * M)) (Site M) (Link M) (Fin 16) where
  emb := ιS M
  inj := (straightBlocking M).inj
  path e k := boxPath M e.1 e.2 k
  wt _ _ := 1 / 16

theorem pathLinks_boxPath (y : Site M) (μ : Fin 4) (k : Fin 16) :
    pathLinks (boxPath M y μ k) =
      (linksOff 0 (boxSteps k μ)).map fun p => (ιS M y + ofOff p.1, p.2) := by
  rw [boxPath, pathLinks_cast, pathLinks_walk]
  have h := linksOf_off (ιS M y) (boxSteps k μ) 0
  rw [ofOff_zero, add_zero] at h
  exact h

theorem pathLinks_boxPathBlocking (y : Site M) (μ : Fin 4) (k : Fin 16) :
    pathLinks ((boxPathBlocking M).path (y, μ) k) =
      (linksOff 0 (boxSteps k μ)).map fun p => (ιS M y + ofOff p.1, p.2) :=
  pathLinks_boxPath M y μ k

/-- For `μ = 3` the box paths `ε = e₂ + e₃` and `ε = e₂` have the same holonomy (the first
backtracks along the last link of its straight segment). -/
theorem pathProd_boxPath_12 {G : Type*} [Group G] (y : Site M) (U : Link (2 * M) → G) :
    pathProd (boxPath M y 3 12) U = pathProd (boxPath M y 3 4) U := by
  simp only [boxPath, pathProd_cast]
  rw [boxSteps_12, boxSteps_4, pathProd_walk_backtrack]

/-- **Every coarse link of the box blocking has a private link** (`M ≥ 2`): for `μ ≠ 3` the fine
link `(2y + e₃, μ)` occurs only in the path `ε = e₃`, exactly once; for `μ = 3` the fine link
`(2y + e₂, 3)` occurs exactly once in the path `ε = e₂` and otherwise only in the path
`ε = e₂ + e₃`, which has the same holonomy; the weights are `1/16`. -/
theorem box_hasPrivateLink (hM : 2 ≤ M) (e : Link M) :
    HasPrivateLink (boxPathBlocking M) e := by
  obtain ⟨y, μ⟩ := e
  have hn : 4 ≤ 2 * M := by omega
  refine ⟨(ιS M y + ofOff (b0Of μ), μ), i0Of μ, sOf μ, ?_, ?_, ?_, ?_⟩
  · intro i hi U
    show pathProd (boxPath M y μ i) U = pathProd (boxPath M y μ (i0Of μ)) U
    by_cases hμ : μ = 3
    · subst hμ
      have hi' : i = 4 ∨ i = 12 := by simpa [sOf] using hi
      rcases hi' with rfl | rfl
      · rfl
      · exact pathProd_boxPath_12 M y U
    · have hi' : i = 8 := by simpa [sOf, hμ] using hi
      subst hi'
      simp [i0Of, hμ]
  · rw [pathLinks_boxPathBlocking,
      count_map_off hn (ιS M y) _ (b0Of μ, μ) (box_range μ (i0Of μ)) (b0Of_range μ)]
    exact box_once μ
  · intro i hi
    right
    have hc := count_map_off hn (ιS M y) _ (b0Of μ, μ) (box_range μ i) (b0Of_range μ)
    rw [List.count_eq_zero.2 (box_out μ i hi)] at hc
    rw [pathLinks_boxPathBlocking]
    exact (@List.count_eq_zero _ instBEqOfDecidableEq _ _ _).1 hc
  · exact (Finset.sum_pos (fun _ _ => by show (0 : ℝ) < 1 / 16; norm_num)
      ⟨i0Of μ, i0Of_mem μ⟩).ne'

variable [NeZero M]

/-- **The null-set hypothesis for the connected box blocking** (`M ≥ 2`, equal weights `1/16`):
the zero set of the box path averages is null for the product Haar measure. -/
theorem hnull_box (hM : 2 ≤ M) :
    Measure.pi (fun _ : Link (2 * M) => haarSU2) (zeroSet (boxPathBlocking M)) = 0 :=
  hnull_of_private (boxPathBlocking M) (box_hasPrivateLink M hM)

/-- **`hWilson` for the connected box blocking of SU(2) on `(ℤ/2Mℤ)⁴`** (`M ≥ 2`, any real `β` in
the normalisation of Part VI's `su2Wilson`, `κ = β/2`,
any `V₀`; the Wilson measure `Z⁻¹ exp[(β/2) ∑ₚ Re tr U_p] ∏ₑ h(dUₑ)` of Part VI of this file, `h` the Haar
probability measure): with `c(U)(y, μ) = Q/√det Q`, `Q = (1/16) ∑_ε U(box path (ε, μ) from 2y)`, the
operators built from the SU(2) Wilson measure, its conditional expectations, `J g = g ∘ c` and the
law `c_* μ` satisfy every field of `CubeSplitInputs`, for arbitrary fine and coarse link sets and
weights; no null-set hypothesis remains. This is the identification step only: no gap, split or
residual bound is proved for this blocking. -/
theorem su2_inputs_box (hM : 2 ≤ M) (β : ℝ) (V0 : SU2) {ιx ιc : Type*} [Fintype ιx] [Fintype ιc]
    (V : ιx → Set (Link (2 * M))) (w : ιx → ℝ) (Vc : ιc → Set (Link M)) (wc : ιc → ℝ) :
    CubeSplitInputs
      (cubeGen w fun x => wilsonP (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (V x)) w
      (fun x => wilsonP (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (V x))
      (isoProj (aeJ (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
        (avgCoarseMap (boxPathBlocking M) (plaqOf (n := 2 * M)) (β / 2) V0 (hnull_box M hM))))
      (aeJ (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
        (avgCoarseMap (boxPathBlocking M) (plaqOf (n := 2 * M)) (β / 2) V0 (hnull_box M hM)) :
        aeY (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
          (avgCoarseMap (boxPathBlocking M) (plaqOf (n := 2 * M)) (β / 2) V0 (hnull_box M hM))
          →ₗ[ℝ] wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2)
      (isoAdj (aeJ (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
        (avgCoarseMap (boxPathBlocking M) (plaqOf (n := 2 * M)) (β / 2) V0 (hnull_box M hM))) :
        wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 →ₗ[ℝ]
          aeY (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
            (avgCoarseMap (boxPathBlocking M) (plaqOf (n := 2 * M)) (β / 2) V0 (hnull_box M hM)))
      (cubeGen wc fun z => lawP (aeLaw (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
        (avgCoarseMap (boxPathBlocking M) (plaqOf (n := 2 * M)) (β / 2) V0 (hnull_box M hM)))
        (Vc z)) :=
  su2_inputs_of_paths (boxPathBlocking M) (plaqOf (n := 2 * M)) (β / 2) V0 (hnull_box M hM)
    V w Vc wc

end Box

end YangMills.StrongCoupling.BoxPathFamily

/-! # Part XXV. `YangMills.StrongCoupling.TiltTV`: the total-variation bound `TV ≤ tanh(osc/4)` for exponentially tilted probability measures, in measure-theoretic form (new; uses Part XXI) -/

/-!
# Total variation of an exponential tilt

## (a) Formal target

Part XXI of this file reduces the constrained fibre bound to one named influence hypothesis, whose
`infl` field compares two conditional laws of a block that differ by an exponential tilt. Its paper
proof uses the bound `TV(μ, ν) ≤ tanh(L/4)` for `ν = e^h μ / Z` with `osc h ≤ L`; Part XXI checks
only the real inequality behind it (`tilt_tv_core`). Here the measure theory is done for Mathlib's
`Measure.tilted`, on an arbitrary measurable space.

## (b) What is proved

For a probability measure `μ`, a measurable `h` with `h x − h y ≤ L` for all `x, y`, and
`ν = μ.tilted h` (density `e^h / ∫ e^h dμ`):
* `tanh_quarter_eq`: `(e^{L/2} − 1)/(e^{L/2} + 1) = tanh(L/4)`; `tanh_quarter_nonneg`;
  `tanh_le_of_nonneg` (`tanh t ≤ t` for `t ≥ 0`) and `tanh_quarter_le` (`tanh(L/4) ≤ L/4`);
* `tilt_tv_window`, `tilt_tv_sub_le`, `tilt_tv_abs_le`: `|ν(A) − μ(A)| ≤ tanh(L/4)` for every
  measurable `A`, from `tilt_tv_core` of Part XXI with `q = e^{L/2}`;
* `tilt_integral_sub_le`, `tilt_integral_abs_le`: `|∫ f dν − ∫ f dμ| ≤ tanh(L/4) · S` for measurable
  `f` with `f x − f y ≤ S` for all `x, y`;
* `tilt_tilt_sub`, `tilt_pair_integral_abs_le`: the same for two tilts `μ.tilted h₁`, `μ.tilted h₂`
  of one probability measure, with `L` bounding the oscillation of `h₁ − h₂`;
* `tilt_kernel_abs_le`, the kernel form used by an influence estimate: if `|g₁ − g₂| ≤ a`
  pointwise and `g₂ x − g₂ y ≤ b`, then
  `|∫ g₁ d(μ.tilted h₁) − ∫ g₂ d(μ.tilted h₂)| ≤ a + tanh(L/4) · b`;
* `tilt_kernel_abs_le_ae`: the same with `|g₁ − g₂| ≤ a` and `c ≤ g₂ ≤ c + b` only `μ`-a.e.;
* `tilt_integral_abs_le_window`, `tilt_pair_integral_abs_le_window`, `tilt_kernel_abs_le_window`:
  the same with window hypotheses `m ≤ h ≤ m + L` (or `m ≤ h₁ − h₂ ≤ m + L` and `h₂ ≤ C`) and
  `a ≤ g ≤ a + s` at every point;
* helpers: `integrable_of_abs_bound`, `integrable_exp_of_le` (`e^h` is integrable when `h ≤ C`),
  `exists_osc_window` (`m ≤ h ≤ m + L` from `h x − h y ≤ L`), `real_tilted_apply_eq`.
All functions are real valued and measurable; boundedness of `f`, `g₁`, `g₂` and of the density
follows from the oscillation hypotheses; `e^{h₂}` is assumed integrable in the two-tilt and kernel
forms (the window forms assume `h₂ ≤ C` instead), and `e^h` is integrable under the hypotheses of
the one-tilt forms.

## (c) What remains open

Nothing here identifies the conditional expectations of the Wilson measure with tilted kernels, and
the influence hypothesis of Part XXI is not discharged here. Its `infl` field still needs: the
block heat bath as the kernel `ξ ↦ ∫ f(U_{Bᶜ}, ξ) d(Haar^B.tilted (H U))`, with
`H U ξ = (β/2) ∑_{p meets B} Re tr U_p` (`β = β_W = 4/g²` as in Part VI's `su2Wilson`); the
bound `L = 4 |β| k` on the oscillation of `H U − H U'` for configurations that differ at one link
`e ∉ B`, where `k` counts the plaquettes that contain
`e` and meet `B` (so `tanh(L/4) = tanh(|β| k)`); and the oscillation functionals, domain and density
statement of Part XXI.

## (d) Axioms and checks

Only `propext`, `Classical.choice` and `Quot.sound` (the module axiom audit covers every headline);
no sorry, admit, axiom declarations, native_decide or implemented_by, and no `set_option`. Uses
`tilt_tv_core` from Part XXI of this file.

## (e) Scope

Abstract measure theory on an arbitrary measurable space; no lattice, no coupling constant. This is
not a proof of a mass gap. The bound is elementary and sharp (see Cohen and Fausti,
arXiv:2309.02413, Cor. 5.2.1, where `TV` is the supremum over events, as here); its linear form
`TV ≤ osc h / 4` goes back to Simon, Commun. Math. Phys. 68 (1979) 183–185. No novelty is
claimed: what this part adds is the formalisation for Mathlib's `Measure.tilted`, in the forms
that an influence estimate uses.
-/

namespace YangMills.StrongCoupling.TiltTV

open MeasureTheory YangMills.StrongCoupling.SweepContraction

/-! ### The constant `tanh (L / 4)` -/

/-- `(e^{L/2} − 1)/(e^{L/2} + 1) = tanh(L/4)`. -/
theorem tanh_quarter_eq (L : ℝ) :
    (exp (L / 2) - 1) / (exp (L / 2) + 1) = tanh (L / 4) := by
  have h1 : exp (L / 2) = exp (L / 4) * exp (L / 4) := by
    rw [← exp_add]; ring_nf
  have h2 : exp (-(L / 4)) = (exp (L / 4))⁻¹ := exp_neg _
  have hp : 0 < exp (L / 4) := exp_pos _
  rw [tanh_eq_sinh_div_cosh, sinh_eq, cosh_eq, h1, h2]
  field_simp

theorem tanh_quarter_nonneg {L : ℝ} (hL : 0 ≤ L) : 0 ≤ tanh (L / 4) := by
  rw [← tanh_quarter_eq]
  have : 1 ≤ exp (L / 2) := one_le_exp (by linarith)
  apply div_nonneg <;> linarith

/-- `tanh t ≤ t` for `t ≥ 0`. -/
theorem tanh_le_of_nonneg {t : ℝ} (ht : 0 ≤ t) : tanh t ≤ t := by
  have hd : ∀ s : ℝ, HasDerivAt (fun y => y * cosh y - sinh y) (s * sinh s) s := by
    intro s
    have h := ((hasDerivAt_id' s).mul (hasDerivAt_cosh s)).sub (hasDerivAt_sinh s)
    have e : s * sinh s = 1 * cosh s + s * sinh s - cosh s := by ring
    rw [e]; exact h
  have hmono : Monotone (fun y => y * cosh y - sinh y) := by
    refine monotone_of_deriv_nonneg (fun s => (hd s).differentiableAt) fun s => ?_
    rw [(hd s).deriv]
    rcases le_total 0 s with hs | hs
    · exact mul_nonneg hs (sinh_nonneg_iff.2 hs)
    · exact mul_nonneg_of_nonpos_of_nonpos hs (sinh_nonpos_iff.2 hs)
  have h0 := hmono ht
  simp only [zero_mul, sinh_zero, sub_zero] at h0
  rw [tanh_eq_sinh_div_cosh, div_le_iff₀ (cosh_pos t)]
  linarith

theorem tanh_quarter_le {L : ℝ} (hL : 0 ≤ L) : tanh (L / 4) ≤ L / 4 :=
  tanh_le_of_nonneg (by linarith)

/-! ### Bounded functions -/

variable {α : Type*} [MeasurableSpace α]

theorem integrable_of_abs_bound {μ : Measure α} [IsFiniteMeasure μ] {f : α → ℝ}
    (hf : Measurable f) (C : ℝ) (hC : ∀ x, |f x| ≤ C) : Integrable f μ :=
  Integrable.of_bound hf.aestronglyMeasurable C
    (ae_of_all _ fun x => by rw [Real.norm_eq_abs]; exact hC x)

theorem integrable_exp_of_le {μ : Measure α} [IsFiniteMeasure μ] {h : α → ℝ}
    (hh : Measurable h) {C : ℝ} (hC : ∀ x, h x ≤ C) : Integrable (fun x => exp (h x)) μ :=
  integrable_of_abs_bound hh.exp (exp C) fun x => by
    rw [abs_of_pos (exp_pos _)]; exact exp_le_exp.2 (hC x)

/-- An oscillation bound `h x − h y ≤ L` gives a window `m ≤ h ≤ m + L` (`m = inf h`). -/
theorem exists_osc_window {β : Type*} [Nonempty β] {h : β → ℝ} {L : ℝ}
    (hosc : ∀ x y, h x - h y ≤ L) : ∃ m, (∀ x, m ≤ h x) ∧ ∀ x, h x ≤ m + L := by
  obtain ⟨x₀⟩ := ‹Nonempty β›
  have hbdd : BddBelow (Set.range h) :=
    ⟨h x₀ - L, by rintro _ ⟨y, rfl⟩; linarith [hosc x₀ y]⟩
  refine ⟨⨅ x, h x, fun x => ciInf_le hbdd x, fun x => ?_⟩
  have : h x - L ≤ ⨅ y, h y := le_ciInf fun y => by linarith [hosc x y]
  linarith

theorem abs_le_of_window {β : Type*} {f : β → ℝ} {c S : ℝ} (hlo : ∀ x, c ≤ f x)
    (hhi : ∀ x, f x ≤ c + S) (x : β) : |f x| ≤ |c| + |S| := by
  rw [abs_le]
  constructor <;>
    linarith [hlo x, hhi x, le_abs_self c, neg_abs_le c, le_abs_self S, neg_abs_le S]

/-! ### The set form -/

/-- `ν(A) = ∫_A e^h / ∫ e^h dμ dμ` for `ν = μ.tilted h`. -/
theorem real_tilted_apply_eq {μ : Measure α} (h : α → ℝ) {A : Set α} (hA : MeasurableSet A) :
    (μ.tilted h).real A = ∫ x in A, exp (h x) / ∫ y, exp (h y) ∂μ ∂μ := by
  rw [measureReal_def, tilted_apply_eq_ofReal_integral' h hA, ENNReal.toReal_ofReal]
  exact setIntegral_nonneg hA fun x _ =>
    div_nonneg (exp_pos _).le (integral_nonneg fun _ => (exp_pos _).le)

/-- **Set form, window version.** For a probability measure `μ`, a measurable `h` with
`m ≤ h ≤ m + L` and a measurable set `A`: `(μ.tilted h)(A) − μ(A) ≤ tanh(L/4)`. -/
theorem tilt_tv_window {μ : Measure α} [IsProbabilityMeasure μ] {h : α → ℝ} (hh : Measurable h)
    {m L : ℝ} (hlo : ∀ x, m ≤ h x) (hhi : ∀ x, h x ≤ m + L) {A : Set α} (hA : MeasurableSet A) :
    (μ.tilted h).real A - μ.real A ≤ tanh (L / 4) := by
  obtain ⟨x₀⟩ := nonempty_of_isProbabilityMeasure μ
  have hL : 0 ≤ L := by linarith [hlo x₀, hhi x₀]
  have hint : Integrable (fun x => exp (h x)) μ := integrable_exp_of_le hh hhi
  have hZ : 0 < ∫ y, exp (h y) ∂μ := integral_exp_pos hint
  have hXY : (∫ x in A, exp (h x) ∂μ) + ∫ x in Aᶜ, exp (h x) ∂μ = ∫ y, exp (h y) ∂μ :=
    integral_add_compl hA hint
  have hν : (μ.tilted h).real A = (∫ x in A, exp (h x) ∂μ) / ∫ y, exp (h y) ∂μ := by
    rw [real_tilted_apply_eq h hA]; exact integral_div _ _
  have hp0 : 0 ≤ μ.real A := measureReal_nonneg
  have hcompl : μ.real Aᶜ = 1 - μ.real A := probReal_compl_eq_one_sub hA
  have hp1 : 0 ≤ 1 - μ.real A := by rw [← hcompl]; exact measureReal_nonneg
  have hq : 1 ≤ exp (L / 2) := one_le_exp (by linarith)
  have hq2 : exp (m + L) = exp m * exp (L / 2) ^ 2 := by
    rw [sq, ← exp_add, add_halves, exp_add]
  have hX0 : 0 ≤ ∫ x in A, exp (h x) ∂μ := setIntegral_nonneg hA fun x _ => (exp_pos _).le
  have hY0 : 0 ≤ ∫ x in Aᶜ, exp (h x) ∂μ :=
    setIntegral_nonneg hA.compl fun x _ => (exp_pos _).le
  have hXle : ∫ x in A, exp (h x) ∂μ ≤ exp m * exp (L / 2) ^ 2 * μ.real A := by
    have : ∫ x in A, exp (h x) ∂μ ≤ ∫ _ in A, exp (m + L) ∂μ :=
      setIntegral_mono hint.integrableOn (integrable_const _).integrableOn
        fun x => exp_le_exp.2 (hhi x)
    rw [setIntegral_const, smul_eq_mul, hq2] at this
    linarith
  have hYge : exp m * (1 - μ.real A) ≤ ∫ x in Aᶜ, exp (h x) ∂μ := by
    have : ∫ _ in Aᶜ, exp m ∂μ ≤ ∫ x in Aᶜ, exp (h x) ∂μ :=
      setIntegral_mono (integrable_const _).integrableOn hint.integrableOn
        fun x => exp_le_exp.2 (hlo x)
    rw [setIntegral_const, smul_eq_mul, hcompl] at this
    linarith
  have hden : 0 < μ.real A * exp (L / 2) ^ 2 + (1 - μ.real A) := by
    have := mul_le_mul_of_nonneg_left (one_le_pow₀ hq : (1 : ℝ) ≤ exp (L / 2) ^ 2) hp0
    linarith
  have hm := exp_pos m
  have h1 : (∫ x in A, exp (h x) ∂μ) * (exp m * (1 - μ.real A)) ≤
      (exp m * exp (L / 2) ^ 2 * μ.real A) * ∫ x in Aᶜ, exp (h x) ∂μ :=
    mul_le_mul hXle hYge (by positivity) (by positivity)
  have h2 : (∫ x in A, exp (h x) ∂μ) * (1 - μ.real A) ≤
      exp (L / 2) ^ 2 * μ.real A * ∫ x in Aᶜ, exp (h x) ∂μ := by
    refine le_of_mul_le_mul_left ?_ hm
    linarith [h1]
  have key : (∫ x in A, exp (h x) ∂μ) / ∫ y, exp (h y) ∂μ ≤
      μ.real A * exp (L / 2) ^ 2 / (μ.real A * exp (L / 2) ^ 2 + (1 - μ.real A)) := by
    rw [div_le_div_iff₀ hZ hden, ← hXY]
    linarith [h2]
  calc (μ.tilted h).real A - μ.real A
      ≤ μ.real A * exp (L / 2) ^ 2 / (μ.real A * exp (L / 2) ^ 2 + (1 - μ.real A))
          - μ.real A := by rw [hν]; linarith
    _ ≤ (exp (L / 2) - 1) / (exp (L / 2) + 1) := tilt_tv_core hp0 hq
    _ = tanh (L / 4) := tanh_quarter_eq L

/-- **Set form.** `ν(A) − μ(A) ≤ tanh(L/4)` for `ν = μ.tilted h`, `h` measurable with
`h x − h y ≤ L` for all `x, y`, `μ` a probability measure, `A` measurable. -/
theorem tilt_tv_sub_le {μ : Measure α} [IsProbabilityMeasure μ] {h : α → ℝ} (hh : Measurable h)
    {L : ℝ} (hosc : ∀ x y, h x - h y ≤ L) {A : Set α} (hA : MeasurableSet A) :
    (μ.tilted h).real A - μ.real A ≤ tanh (L / 4) := by
  have := nonempty_of_isProbabilityMeasure μ
  obtain ⟨m, hlo, hhi⟩ := exists_osc_window hosc
  exact tilt_tv_window hh hlo hhi hA

/-- **Set form, both signs (the total-variation bound).** For a probability measure `μ`, a
measurable `h` with `h x − h y ≤ L` for all `x, y` (that is, `sup h − inf h ≤ L`) and every
measurable set `A`: `|(μ.tilted h)(A) − μ(A)| ≤ tanh(L/4)`. -/
theorem tilt_tv_abs_le {μ : Measure α} [IsProbabilityMeasure μ] {h : α → ℝ} (hh : Measurable h)
    {L : ℝ} (hosc : ∀ x y, h x - h y ≤ L) {A : Set α} (hA : MeasurableSet A) :
    |(μ.tilted h).real A - μ.real A| ≤ tanh (L / 4) := by
  have := nonempty_of_isProbabilityMeasure μ
  obtain ⟨m, hlo, hhi⟩ := exists_osc_window hosc
  have : IsProbabilityMeasure (μ.tilted h) :=
    isProbabilityMeasure_tilted (integrable_exp_of_le hh hhi)
  have h1 := tilt_tv_sub_le (μ := μ) hh hosc hA
  have h2 := tilt_tv_sub_le (μ := μ) hh hosc hA.compl
  rw [probReal_compl_eq_one_sub (μ := μ.tilted h) hA, probReal_compl_eq_one_sub (μ := μ) hA]
    at h2
  exact abs_sub_le_iff.2 ⟨h1, by linarith⟩

/-! ### The expectation form -/

/-- **Expectation form, window version.** -/
theorem tilt_integral_sub_le_window {μ : Measure α} [IsProbabilityMeasure μ] {h : α → ℝ}
    (hh : Measurable h) {L : ℝ} (hosc : ∀ x y, h x - h y ≤ L) {f : α → ℝ} (hf : Measurable f)
    {c S : ℝ} (hlo : ∀ x, c ≤ f x) (hhi : ∀ x, f x ≤ c + S) :
    ∫ x, f x ∂(μ.tilted h) - ∫ x, f x ∂μ ≤ tanh (L / 4) * S := by
  have := nonempty_of_isProbabilityMeasure μ
  obtain ⟨x₀⟩ := nonempty_of_isProbabilityMeasure μ
  have hS : 0 ≤ S := by linarith [hlo x₀, hhi x₀]
  obtain ⟨m, hm1, hm2⟩ := exists_osc_window hosc
  have hint := integrable_exp_of_le (μ := μ) hh hm2
  have hZ : 0 < ∫ y, exp (h y) ∂μ := integral_exp_pos hint
  set ρ : α → ℝ := fun x => exp (h x) / ∫ y, exp (h y) ∂μ with hρdef
  have hρm : Measurable ρ := hh.exp.div_const _
  have hρb : ∀ x, |ρ x| ≤ exp (m + L) / ∫ y, exp (h y) ∂μ := fun x => by
    rw [abs_of_pos (div_pos (exp_pos _) hZ)]
    exact div_le_div_of_nonneg_right (exp_le_exp.2 (hm2 x)) hZ.le
  have hρint : Integrable ρ μ := integrable_of_abs_bound hρm _ hρb
  have hρ1 : ∫ x, ρ x ∂μ = 1 := by
    rw [hρdef, integral_div, div_self hZ.ne']
  have hfb := abs_le_of_window hlo hhi
  have hfint : Integrable f μ := integrable_of_abs_bound hf _ hfb
  have hρfint : Integrable (fun x => ρ x * f x) μ := by
    refine integrable_of_abs_bound (hρm.mul hf)
      ((exp (m + L) / ∫ y, exp (h y) ∂μ) * (|c| + |S|)) fun x => ?_
    rw [abs_mul]
    exact mul_le_mul (hρb x) (hfb x) (abs_nonneg _) (div_pos (exp_pos _) hZ).le
  have hν : ∫ x, f x ∂(μ.tilted h) = ∫ x, ρ x * f x ∂μ := by
    rw [integral_tilted]; rfl
  set A : Set α := {x | 1 < ρ x} with hAdef
  have hA : MeasurableSet A := measurableSet_lt measurable_const hρm
  have hpt : ∀ x, ρ x * f x - f x - c * (ρ x - 1) ≤
      S * A.indicator (fun x => ρ x - 1) x := by
    intro x
    by_cases hx : x ∈ A
    · rw [Set.indicator_of_mem hx]
      have hx' : 1 < ρ x := hx
      nlinarith [hhi x, hlo x]
    · rw [Set.indicator_of_notMem hx]
      have hx' : ρ x ≤ 1 := not_lt.1 hx
      nlinarith [hhi x, hlo x]
  have hlhs : ∫ x, (ρ x * f x - f x - c * (ρ x - 1)) ∂μ =
      ∫ x, ρ x * f x ∂μ - ∫ x, f x ∂μ := by
    have i1 : Integrable (fun x => ρ x * f x - f x) μ := hρfint.sub hfint
    have i2 : Integrable (fun x => c * (ρ x - 1)) μ := (hρint.sub (integrable_const 1)).const_mul c
    have e1 : ∫ x, (ρ x * f x - f x - c * (ρ x - 1)) ∂μ =
        ∫ x, (ρ x * f x - f x) ∂μ - ∫ x, c * (ρ x - 1) ∂μ := integral_sub i1 i2
    have e2 : ∫ x, (ρ x * f x - f x) ∂μ = ∫ x, ρ x * f x ∂μ - ∫ x, f x ∂μ :=
      integral_sub hρfint hfint
    have e3 : ∫ x, c * (ρ x - 1) ∂μ = c * ∫ x, (ρ x - 1) ∂μ := integral_const_mul c _
    have e4 : ∫ x, (ρ x - 1) ∂μ = ∫ x, ρ x ∂μ - ∫ _, (1 : ℝ) ∂μ :=
      integral_sub hρint (integrable_const 1)
    have e5 : ∫ _, (1 : ℝ) ∂μ = 1 := by simp
    rw [e1, e2, e3, e4, e5, hρ1]
    ring
  have hνA : (μ.tilted h).real A = ∫ x in A, ρ x ∂μ := real_tilted_apply_eq h hA
  have hrhs : ∫ x, S * A.indicator (fun x => ρ x - 1) x ∂μ =
      S * ((μ.tilted h).real A - μ.real A) := by
    have i1 : ∫ x, S * A.indicator (fun x => ρ x - 1) x ∂μ = S * ∫ x in A, (ρ x - 1) ∂μ := by
      rw [integral_const_mul, integral_indicator hA]
    have i2 : ∫ x in A, (ρ x - 1) ∂μ = ∫ x in A, ρ x ∂μ - ∫ _ in A, (1 : ℝ) ∂μ :=
      integral_sub hρint.integrableOn (integrable_const 1).integrableOn
    have i3 : ∫ _ in A, (1 : ℝ) ∂μ = μ.real A := by simp
    rw [i1, i2, i3, hνA]
  have hmono : ∫ x, (ρ x * f x - f x - c * (ρ x - 1)) ∂μ ≤
      ∫ x, S * A.indicator (fun x => ρ x - 1) x ∂μ :=
    integral_mono ((hρfint.sub hfint).sub ((hρint.sub (integrable_const 1)).const_mul c))
      (((hρint.sub (integrable_const 1)).indicator hA).const_mul S) hpt
  have hset := tilt_tv_sub_le (μ := μ) hh hosc hA
  rw [hν, ← hlhs]
  calc ∫ x, (ρ x * f x - f x - c * (ρ x - 1)) ∂μ
      ≤ S * ((μ.tilted h).real A - μ.real A) := hrhs ▸ hmono
    _ ≤ S * tanh (L / 4) := mul_le_mul_of_nonneg_left hset hS
    _ = tanh (L / 4) * S := mul_comm _ _

/-- **Expectation form, one sign.** -/
theorem tilt_integral_sub_le {μ : Measure α} [IsProbabilityMeasure μ] {h : α → ℝ}
    (hh : Measurable h) {L : ℝ} (hosc : ∀ x y, h x - h y ≤ L) {f : α → ℝ} (hf : Measurable f)
    {S : ℝ} (hfosc : ∀ x y, f x - f y ≤ S) :
    ∫ x, f x ∂(μ.tilted h) - ∫ x, f x ∂μ ≤ tanh (L / 4) * S := by
  have := nonempty_of_isProbabilityMeasure μ
  obtain ⟨c, hlo, hhi⟩ := exists_osc_window hfosc
  exact tilt_integral_sub_le_window hh hosc hf hlo hhi

/-- **Expectation form.** For a probability measure `μ`, measurable `h` and `f` with
`h x − h y ≤ L` and `f x − f y ≤ S` for all `x, y`:
`|∫ f d(μ.tilted h) − ∫ f dμ| ≤ tanh(L/4) · S`. -/
theorem tilt_integral_abs_le {μ : Measure α} [IsProbabilityMeasure μ] {h : α → ℝ}
    (hh : Measurable h) {L : ℝ} (hosc : ∀ x y, h x - h y ≤ L) {f : α → ℝ} (hf : Measurable f)
    {S : ℝ} (hfosc : ∀ x y, f x - f y ≤ S) :
    |∫ x, f x ∂(μ.tilted h) - ∫ x, f x ∂μ| ≤ tanh (L / 4) * S := by
  refine abs_sub_le_iff.2 ⟨tilt_integral_sub_le hh hosc hf hfosc, ?_⟩
  have hf' : Measurable (fun x => -f x) := hf.neg
  have hfosc' : ∀ x y, (fun x => -f x) x - (fun x => -f x) y ≤ S := fun x y => by
    show -f x - -f y ≤ S
    linarith [hfosc y x]
  have := tilt_integral_sub_le (μ := μ) hh hosc hf' hfosc'
  simp only [integral_neg] at this
  linarith

/-! ### Two tilts and the kernel form -/

/-- `(μ.tilted h₂).tilted (h₁ − h₂) = μ.tilted h₁` when `e^{h₂}` is integrable. -/
theorem tilt_tilt_sub {μ : Measure α} {h₁ h₂ : α → ℝ}
    (hint : Integrable (fun x => exp (h₂ x)) μ) :
    (μ.tilted h₂).tilted (fun x => h₁ x - h₂ x) = μ.tilted h₁ := by
  rw [tilted_tilted hint]
  congr 1
  funext x
  simp

/-- **Two tilts.** For a probability measure `μ`, measurable `h₁`, `h₂` with `e^{h₂}` integrable
and `(h₁ − h₂) x − (h₁ − h₂) y ≤ L`, and measurable `g` with `g x − g y ≤ S`:
`|∫ g d(μ.tilted h₁) − ∫ g d(μ.tilted h₂)| ≤ tanh(L/4) · S`. -/
theorem tilt_pair_integral_abs_le {μ : Measure α} [IsProbabilityMeasure μ] {h₁ h₂ : α → ℝ}
    (hh₁ : Measurable h₁) (hh₂ : Measurable h₂) (hint : Integrable (fun x => exp (h₂ x)) μ)
    {L : ℝ} (hosc : ∀ x y, (h₁ x - h₂ x) - (h₁ y - h₂ y) ≤ L) {g : α → ℝ} (hg : Measurable g)
    {S : ℝ} (hgosc : ∀ x y, g x - g y ≤ S) :
    |∫ x, g x ∂(μ.tilted h₁) - ∫ x, g x ∂(μ.tilted h₂)| ≤ tanh (L / 4) * S := by
  have : IsProbabilityMeasure (μ.tilted h₂) := isProbabilityMeasure_tilted hint
  rw [← tilt_tilt_sub hint]
  exact tilt_integral_abs_le (hh₁.sub hh₂) hosc hg hgosc

/-- **Kernel form (the shape of an influence estimate).** Let `μ` be a probability measure, `h₁`,
`h₂` measurable with `e^{h₂}` integrable and `(h₁ − h₂) x − (h₁ − h₂) y ≤ L` for all `x, y`, and
`g₁`, `g₂` measurable with `|g₁ x − g₂ x| ≤ a` and `g₂ x − g₂ y ≤ b` for all `x, y`. Then
`|∫ g₁ d(μ.tilted h₁) − ∫ g₂ d(μ.tilted h₂)| ≤ a + tanh(L/4) · b`.
In an influence estimate, `μ.tilted hᵢ` are the conditional laws of a block given two outside
configurations that differ at one coordinate, `gᵢ` are the sections of `f` at them, `a` bounds the
oscillation of `f` in that coordinate and `b` the oscillation of `f` over the block. -/
theorem tilt_kernel_abs_le {μ : Measure α} [IsProbabilityMeasure μ] {h₁ h₂ g₁ g₂ : α → ℝ}
    (hh₁ : Measurable h₁) (hh₂ : Measurable h₂) (hint : Integrable (fun x => exp (h₂ x)) μ)
    {L a b : ℝ} (hosc : ∀ x y, (h₁ x - h₂ x) - (h₁ y - h₂ y) ≤ L)
    (hg₁ : Measurable g₁) (hg₂ : Measurable g₂) (ha : ∀ x, |g₁ x - g₂ x| ≤ a)
    (hb : ∀ x y, g₂ x - g₂ y ≤ b) :
    |∫ x, g₁ x ∂(μ.tilted h₁) - ∫ x, g₂ x ∂(μ.tilted h₂)| ≤ a + tanh (L / 4) * b := by
  have := nonempty_of_isProbabilityMeasure μ
  have : IsProbabilityMeasure (μ.tilted h₂) := isProbabilityMeasure_tilted hint
  obtain ⟨m, _, hm2⟩ := exists_osc_window hosc
  have : IsProbabilityMeasure (μ.tilted h₁) := by
    rw [← tilt_tilt_sub hint]
    exact isProbabilityMeasure_tilted (integrable_exp_of_le (hh₁.sub hh₂) hm2)
  obtain ⟨c, hlo, hhi⟩ := exists_osc_window hb
  have hg₂int : Integrable g₂ (μ.tilted h₁) :=
    integrable_of_abs_bound hg₂ _ (abs_le_of_window hlo hhi)
  have hdint : Integrable (fun x => g₁ x - g₂ x) (μ.tilted h₁) :=
    integrable_of_abs_bound (hg₁.sub hg₂) a ha
  have hg₁int : Integrable g₁ (μ.tilted h₁) :=
    (hdint.add hg₂int).congr (ae_of_all _ fun x => by simp)
  have hd : |∫ x, (g₁ x - g₂ x) ∂(μ.tilted h₁)| ≤ a := by
    have := norm_integral_le_of_norm_le_const (μ := μ.tilted h₁) (C := a)
      (ae_of_all _ fun x => by rw [Real.norm_eq_abs]; exact ha x)
    simpa using this
  rw [integral_sub hg₁int hg₂int] at hd
  have hp := tilt_pair_integral_abs_le hh₁ hh₂ hint hosc hg₂ hb
  calc |∫ x, g₁ x ∂(μ.tilted h₁) - ∫ x, g₂ x ∂(μ.tilted h₂)|
      = |(∫ x, g₁ x ∂(μ.tilted h₁) - ∫ x, g₂ x ∂(μ.tilted h₁)) +
          (∫ x, g₂ x ∂(μ.tilted h₁) - ∫ x, g₂ x ∂(μ.tilted h₂))| := by ring_nf
    _ ≤ |∫ x, g₁ x ∂(μ.tilted h₁) - ∫ x, g₂ x ∂(μ.tilted h₁)| +
          |∫ x, g₂ x ∂(μ.tilted h₁) - ∫ x, g₂ x ∂(μ.tilted h₂)| := abs_add_le _ _
    _ ≤ a + tanh (L / 4) * b := add_le_add hd hp

/-- **Kernel form, almost-everywhere hypotheses.** As `tilt_kernel_abs_le`, with
`|g₁ − g₂| ≤ a` and `c ≤ g₂ ≤ c + b` required only `μ`-almost everywhere (essential bounds).
The functions are replaced by measurable truncations that agree with them `μ`-a.e., hence
`μ.tilted hᵢ`-a.e. -/
theorem tilt_kernel_abs_le_ae {μ : Measure α} [IsProbabilityMeasure μ] {h₁ h₂ g₁ g₂ : α → ℝ}
    (hh₁ : Measurable h₁) (hh₂ : Measurable h₂) (hint : Integrable (fun x => exp (h₂ x)) μ)
    {L a b c : ℝ} (hosc : ∀ x y, (h₁ x - h₂ x) - (h₁ y - h₂ y) ≤ L)
    (hg₁ : Measurable g₁) (hg₂ : Measurable g₂) (ha : ∀ᵐ x ∂μ, |g₁ x - g₂ x| ≤ a)
    (hb : ∀ᵐ x ∂μ, c ≤ g₂ x ∧ g₂ x ≤ c + b) :
    |∫ x, g₁ x ∂(μ.tilted h₁) - ∫ x, g₂ x ∂(μ.tilted h₂)| ≤ a + tanh (L / 4) * b := by
  obtain ⟨x₁, hx₁⟩ := ha.exists
  obtain ⟨x₂, hx₂⟩ := hb.exists
  have ha0 : 0 ≤ a := (abs_nonneg _).trans hx₁
  have hb0 : 0 ≤ b := by linarith [hx₂.1, hx₂.2]
  set g₂' : α → ℝ := fun x => max c (min (g₂ x) (c + b)) with hg₂'
  set d' : α → ℝ := fun x => max (-a) (min (g₁ x - g₂ x) a) with hd'
  have hm₂' : Measurable g₂' := measurable_const.max (hg₂.min measurable_const)
  have hm₁' : Measurable (fun x => g₂' x + d' x) :=
    hm₂'.add (measurable_const.max ((hg₁.sub hg₂).min measurable_const))
  have hwin : ∀ x, c ≤ g₂' x ∧ g₂' x ≤ c + b := fun x =>
    ⟨le_max_left _ _, max_le (by linarith) (min_le_right _ _)⟩
  have hb' : ∀ x y, g₂' x - g₂' y ≤ b := fun x y => by
    linarith [(hwin x).2, (hwin y).1]
  have ha' : ∀ x, |(g₂' x + d' x) - g₂' x| ≤ a := fun x => by
    rw [add_sub_cancel_left, abs_le]
    exact ⟨le_max_left _ _, max_le (by linarith) (min_le_right _ _)⟩
  have hgood : ∀ᵐ x ∂μ, g₂' x = g₂ x ∧ g₂' x + d' x = g₁ x := by
    filter_upwards [ha, hb] with x hxa hxb
    rw [abs_le] at hxa
    have e₂ : g₂' x = g₂ x := by
      simp only [hg₂']
      rw [min_eq_left hxb.2, max_eq_right hxb.1]
    have e₁ : d' x = g₁ x - g₂ x := by
      simp only [hd']
      rw [min_eq_left hxa.2, max_eq_right hxa.1]
    exact ⟨e₂, by rw [e₂, e₁]; ring⟩
  have h₁ae : ∫ x, g₁ x ∂(μ.tilted h₁) = ∫ x, (g₂' x + d' x) ∂(μ.tilted h₁) :=
    integral_congr_ae ((tilted_absolutelyContinuous μ h₁).ae_le
      (hgood.mono fun x hx => hx.2.symm))
  have h₂ae : ∫ x, g₂ x ∂(μ.tilted h₂) = ∫ x, g₂' x ∂(μ.tilted h₂) :=
    integral_congr_ae ((tilted_absolutelyContinuous μ h₂).ae_le
      (hgood.mono fun x hx => hx.1.symm))
  rw [h₁ae, h₂ae]
  exact tilt_kernel_abs_le hh₁ hh₂ hint hosc hm₁' hm₂' ha' hb'

/-! ### Window forms (hypotheses `m ≤ h ≤ m + L`, `a ≤ g ≤ a + s` for every point) -/

/-- **Expectation form, window hypotheses.** For a probability measure `μ` and measurable `h`, `g`
with `m ≤ h x ≤ m + L` and `a ≤ g x ≤ a + s` for every `x`:
`|∫ g d(μ.tilted h) − ∫ g dμ| ≤ tanh(L/4) · s`. -/
theorem tilt_integral_abs_le_window {μ : Measure α} [IsProbabilityMeasure μ] {h g : α → ℝ}
    (hh : Measurable h) (hg : Measurable g) {m L a s : ℝ}
    (hhb : ∀ x, m ≤ h x ∧ h x ≤ m + L) (hgb : ∀ x, a ≤ g x ∧ g x ≤ a + s) :
    |∫ x, g x ∂(μ.tilted h) - ∫ x, g x ∂μ| ≤ tanh (L / 4) * s :=
  tilt_integral_abs_le hh (fun x y => by linarith [(hhb x).2, (hhb y).1]) hg
    (fun x y => by linarith [(hgb x).2, (hgb y).1])

/-- **Two tilts, window hypotheses.** For a probability measure `μ`, measurable `h₁`, `h₂`, `g`
with `h₂ ≤ C`, `m ≤ h₁ x − h₂ x ≤ m + L` and `a ≤ g x ≤ a + s` for every `x`:
`|∫ g d(μ.tilted h₁) − ∫ g d(μ.tilted h₂)| ≤ tanh(L/4) · s`. -/
theorem tilt_pair_integral_abs_le_window {μ : Measure α} [IsProbabilityMeasure μ]
    {h₁ h₂ g : α → ℝ} (hh₁ : Measurable h₁) (hh₂ : Measurable h₂) (hg : Measurable g)
    {C m L a s : ℝ} (hC : ∀ x, h₂ x ≤ C) (hdiff : ∀ x, m ≤ h₁ x - h₂ x ∧ h₁ x - h₂ x ≤ m + L)
    (hgb : ∀ x, a ≤ g x ∧ g x ≤ a + s) :
    |∫ x, g x ∂(μ.tilted h₁) - ∫ x, g x ∂(μ.tilted h₂)| ≤ tanh (L / 4) * s :=
  tilt_pair_integral_abs_le hh₁ hh₂ (integrable_exp_of_le (μ := μ) hh₂ hC)
    (fun x y => by linarith [(hdiff x).2, (hdiff y).1]) hg
    (fun x y => by linarith [(hgb x).2, (hgb y).1])

/-- **Kernel form, window hypotheses.** For a probability measure `μ`, measurable `h₁`, `h₂`,
`g₁`, `g₂` with `h₂ ≤ C`, `m ≤ h₁ x − h₂ x ≤ m + L`, `|g₁ x − g₂ x| ≤ a` and
`c ≤ g₂ x ≤ c + b` for every `x`:
`|∫ g₁ d(μ.tilted h₁) − ∫ g₂ d(μ.tilted h₂)| ≤ a + tanh(L/4) · b`. -/
theorem tilt_kernel_abs_le_window {μ : Measure α} [IsProbabilityMeasure μ]
    {h₁ h₂ g₁ g₂ : α → ℝ} (hh₁ : Measurable h₁) (hh₂ : Measurable h₂) (hg₁ : Measurable g₁)
    (hg₂ : Measurable g₂) {C m L a b c : ℝ} (hC : ∀ x, h₂ x ≤ C)
    (hdiff : ∀ x, m ≤ h₁ x - h₂ x ∧ h₁ x - h₂ x ≤ m + L) (ha : ∀ x, |g₁ x - g₂ x| ≤ a)
    (hgb : ∀ x, c ≤ g₂ x ∧ g₂ x ≤ c + b) :
    |∫ x, g₁ x ∂(μ.tilted h₁) - ∫ x, g₂ x ∂(μ.tilted h₂)| ≤ a + tanh (L / 4) * b :=
  tilt_kernel_abs_le hh₁ hh₂ (integrable_exp_of_le (μ := μ) hh₂ hC)
    (fun x y => by linarith [(hdiff x).2, (hdiff y).1]) hg₁ hg₂ ha
    (fun x y => by linarith [(hgb x).2, (hgb y).1])

end YangMills.StrongCoupling.TiltTV

/-! # Part XXVI. `YangMills.StrongCoupling.HeatBathInfluence`: the lattice count behind the influence hypothesis of Part XXI (column sums `≤ 228`, every `M ≥ 2`), the one-step influence inequality for block heat-bath kernels, and a smaller named hypothesis that implies `SU2HeatBathInfluence` (new; uses Parts IV, VI, X, XII, XVII, XXI and XXV) -/

/-!
# The column-sum count for the SU(2) block heat baths, and `SU2HeatBathInfluence` from a smaller hypothesis

## (a) Formal target

Part XXI of this file reduces `hsweep`, `hcons` and `hFibre` at `β ≠ 0` to one named hypothesis,
`SU2HeatBathInfluence M β θ`: Dobrushin-type influence data for the constrained heat baths
`P'ₓ = E_μ[· | links outside cube2 M x ∖ Sk]` of the SU(2) Wilson measure
`μ(dU) = Z⁻¹ exp((β/2) ∑ₚ Re tr U_p) ∏ₑ dUₑ` on `(ℤ/2Mℤ)⁴` (`β = β_W`, the Wilson coupling of Part VI;
straight blocking; periodic boundary). The research-notes value is `θ = 228 |β|`, with the influence
coefficient `c e x = tanh(|β| kₑₓ) ≤ |β| kₑₓ`, where `kₑₓ` counts the plaquettes that contain the link
`e` and meet the block `Bₓ = cube2 M x ∖ Sk`. The target here is the combinatorial half of that
hypothesis in Lean: the column-sum count `∑_{e ∈ N ∖ Bₓ} kₑₓ ≤ 228`, and the assembly of
`SU2HeatBathInfluence M β (228 |β|)` from the remaining analytic data.

## (b) What is proved

* `kCount M x e` is `kₑₓ` (plaquettes as in `plaqOf`, one per `(y, μ < ν)`).
* `col_count_nat`, `col_count`: for every `M ≥ 2` and every base point `x`,
  `∑_{e ∈ N ∖ Bₓ} kₑₓ ≤ 228` (`N` = the non-skeleton links). Proof: every plaquette that meets
  `cube2 M x` has its base at an offset in `{−1, 0, 1}⁴` from `x`. Each counted pair (link,
  plaquette) is coded by a window plaquette code `< 1296` (base offsets, directions) and the link
  position `< 4`. The code map is injective on the counted pairs because the window `{−1, …, 2}`
  embeds in `ℤ/2Mℤ` when `2M ≥ 4`
  (`off_inj`). Cube membership (`offLink_mem_cube2`) and the skeleton (`mem_skel_of_par`,
  `offLink_mem_skel`) are read off from the offsets and the parity class of `x`. One finite
  computation (`window_count`, `decide +kernel` over lists of naturals, one count per window
  plaquette) gives `228` for each of the `16` parity classes. No sum over the lattice is evaluated,
  and the bound does not depend on `M`.
* `SU2HeatBathOsc M β`, **the smaller named hypothesis**: the analytic data of
  `SU2HeatBathInfluence` (domain, oscillation functionals, influence step, comparison, kernel and
  density conditions) with the influence coefficient fixed to `|β| kₑₓ`; the influence matrix and
  its column sums are no longer hypotheses. The influence step `infl` itself, which carries the
  analytic content (how far a block heat bath moves when one outside link changes), is still part of
  the hypothesis.
* `SU2HeatBathOsc.toInfluence`: `SU2HeatBathOsc M β → SU2HeatBathInfluence M β (228 |β|)` for every
  `M ≥ 2` and every real `β` (the fields `c`, `c_nonneg` and `col` are discharged).
* `su2_hsweep_of_osc`, `su2_hcons_of_osc`: for `M ≥ 2` and `|β| ≤ 1/228`, every parity sweep
  contracts by `228 |β|` on `H ∩ ker Π`, and
  `(1/2)(1 − 228 |β|)² ‖u‖² ≤ ∑ₓ (1/16) ‖u − P'ₓ u‖²` on `H ∩ ker Π`, conditional on
  `SU2HeatBathOsc M β` only (positive for `|β| < 1/228`; no constant depends on `M`).
* `su2_osc_zero`, `su2_osc_zero_nonempty`: the smaller hypothesis holds at `β = 0` (every `M ≥ 1`),
  from Part XXI's `su2_influence_zero`, so it is not vacuous.
* `TiltTVBound` (a named statement: the expectation form of the tilt total-variation bound
  `|∫ g d(μ.tilted h) − ∫ g dμ| ≤ tanh(L/4) · s` for `h ∈ [m, m + L]`, `g ∈ [a, a + s]`) and
  `kernel_infl`: given it, for two tilts `ν = ν₀.tilted h`, `ν' = ν₀.tilted h'` of one probability
  measure with `h − h' ∈ [m, m + L]`, and `|F − F'| ≤ a`, `F' ∈ [b, b + s]`:
  `|∫ F dν − ∫ F' dν'| ≤ a + tanh(L/4) · s`. This is the step of the paper proof that produces the
  influence field; `TiltTVBound` is proved at the end of this part (`tiltTVBound_holds`, from
  `tilt_integral_abs_le_window` of Part XXV of this file), so the `TiltTVBound` argument of
  `kernel_infl` can always be supplied (`kernel_infl tiltTVBound_holds`); it is not yet applied
  to the block heat-bath kernels `P'ₓ` (see (c)).

## (c) What remains open

`SU2HeatBathOsc M β` is not proved here for any `β ≠ 0`. The research notes give a paper proof (domain
of continuous versions with conditional skeleton mean `0`, `δₑ` = oscillation in `Uₑ`, `K = 1`) whose
influence step uses the total-variation bound `TV(μ, e^h μ / Z) ≤ tanh(osc h / 4)` (known on paper:
Cohen and Fausti, arXiv:2309.02413, Cor. 5.2.1, preprint; the linear form `osc h / 4` is in Simon,
Commun. Math. Phys. 68 (1979) 183–185) applied to the block conditional laws, whose log-density
changes by at most `4 |β| kₑₓ` in oscillation when one outside link changes. In Lean the missing
pieces are the version map and kernel formula for `P'ₓ`, the oscillation functionals on `L²`
classes,
the application of the tilt bound to the block conditional laws, and density. The count at `M = 1`
(`84` in the research notes) is not formalised; the window argument needs `M ≥ 2`. `hResidual` and
`hCoarseGap` at `β ≠ 0` are untouched; nothing here concerns weak coupling. Oscillation contraction
under a systematic scan is the mechanism of Dobrushin-type proofs for systematic scan (Dyer,
Goldberg and Jerrum, Combin. Probab. Comput. 17 (2008) 761–779, finite spin systems). Under
Dobrushin's condition the heat-bath Dirichlet form has spectral gap `≥ 1 − r(C)` for general
single-spin spaces, with block updates allowed (L. Wu, Ann. Probab. 34 (2006) 1960–1989, Thm 2.1,
Thm 3.1 and Rem. 3.2; random-scan form). Applied to these block heat baths, if its hypotheses are
met (not checked here), it would give on paper a constant of the form `1 − θ`, stronger than the
`(1/2)(1 − θ)²` of the sweep form used here. No novelty is claimed for the analytic statements:
the contribution here is the kernel-checked lattice count in this file's interface.

## (d) Axioms and checks

Only `propext`, `Classical.choice` and `Quot.sound` (the module axiom audit covers every headline);
no sorry, admit, axiom declarations, native_decide or implemented_by, and no `set_option`. One
`decide +kernel` (`window_count`). Uses Parts VI, X, XII, XVII and XXI of this file (and their
dependencies), and Part XXV for `tiltTVBound_holds`.

## (e) Scope

This is not a proof of a mass gap. It is a finite-volume statement at deep strong coupling
(`|β_W| ≤ 1/228`) about heat-bath generators (not the transfer matrix), conditional on one named
analytic hypothesis that is shown satisfiable at `β = 0` only. That hypothesis still contains the
influence step `infl`, i.e. the analytic content; what is kernel-checked at `β ≠ 0` is the lattice
count, for `M ≥ 2`. No constant depends on `M` (uniform in the size of the periodic torus; no
infinite-volume statement).
-/

namespace YangMills.StrongCoupling.HeatBathInfluence

open Finset YangMills.StrongCoupling.FibreReduction YangMills.StrongCoupling.WilsonCube
  YangMills.StrongCoupling.WilsonSU2 YangMills.StrongCoupling.SweepContraction
  YangMills.StrongCoupling.ConstrainedFibre YangMills.StrongCoupling.SkeletonCondExp

/-- Coordinate `i` of the local cube test: shifted offset `n i ∈ {1, 2}`, and `= 1` in direction `ρ`. -/
def cC (n : ℕ → ℕ) (ρ i : ℕ) : Bool := (n i == 1 || n i == 2) && (i != ρ || n i == 1)

/-- The local cube test (side-2 cube at offset `0`). -/
def cubeB (n : ℕ → ℕ) (ρ : ℕ) : Bool := cC n ρ 0 && cC n ρ 1 && cC n ρ 2 && cC n ρ 3

/-- Coordinate `i` of the local skeleton test for the parity code `p`. -/
def sC (p : ℕ) (n : ℕ → ℕ) (ρ i : ℕ) : Bool := i == ρ || (p / 2 ^ i % 2 + n i) % 2 == 1

/-- The local skeleton test. -/
def skelB (p : ℕ) (n : ℕ → ℕ) (ρ : ℕ) : Bool := sC p n ρ 0 && sC p n ρ 1 && sC p n ρ 2 && sC p n ρ 3

theorem cubeB_iff (n : ℕ → ℕ) (ρ : ℕ) : cubeB n ρ = true ↔ ∀ i < 4, cC n ρ i = true := by
  constructor
  · intro h i hi
    simp only [cubeB, Bool.and_eq_true] at h
    interval_cases i <;> simp_all
  · intro h
    simp [cubeB, h 0 (by norm_num), h 1 (by norm_num), h 2 (by norm_num), h 3 (by norm_num)]

theorem skelB_iff (p : ℕ) (n : ℕ → ℕ) (ρ : ℕ) : skelB p n ρ = true ↔ ∀ i < 4, sC p n ρ i = true := by
  constructor
  · intro h i hi
    simp only [skelB, Bool.and_eq_true] at h
    interval_cases i <;> simp_all
  · intro h
    simp [skelB, h 0 (by norm_num), h 1 (by norm_num), h 2 (by norm_num), h 3 (by norm_num)]


/-- Shifted offset `d + 1 ∈ {0, …, 3}` of coordinate `i` of link number `k` of the window plaquette with
code `t` (base offsets `t / 3^i % 3 − 1`, directions `μ = t / 81 % 4`, `ν = t / 324 % 4`). -/
def wOff (t k i : ℕ) : ℕ :=
  t / 3 ^ i % 3 + cond ((k == 1 && i == t / 81 % 4) || (k == 2 && i == t / 324 % 4)) 1 0

/-- Direction of link number `k` of the window plaquette with code `t`. -/
def wDir (t k : ℕ) : ℕ := cond (k == 0 || k == 2) (t / 81 % 4) (t / 324 % 4)

variable (M : ℕ) [NeZero M]

/-- The link of `(ℤ/2Mℤ)⁴` at offset `n i − 1` from `x` in coordinate `i`, direction `ρ`. -/
def offLink (x : Site (2 * M)) (n : ℕ → ℕ) (ρ : Fin 4) : Link (2 * M) :=
  (fun i => x i + ((n i : ZMod (2 * M)) - 1), ρ)

omit [NeZero M] in
theorem off_inj (hM : 2 ≤ M) {u v : ℕ} (hu : u < 4) (hv : v < 4)
    (h : (u : ZMod (2 * M)) - 1 = (v : ZMod (2 * M)) - 1) : u = v := by
  have h' : (u : ZMod (2 * M)) = (v : ZMod (2 * M)) := by linear_combination h
  rw [ZMod.natCast_eq_natCast_iff', Nat.mod_eq_of_lt (by omega), Nat.mod_eq_of_lt (by omega)] at h'
  exact h'

omit [NeZero M] in
theorem offLink_mem_cube2 (hM : 2 ≤ M) (x : Site (2 * M)) (n : ℕ → ℕ) (hn : ∀ i < 4, n i < 4)
    (ρ : Fin 4) : offLink M x n ρ ∈ cube2 M x ↔ cubeB n ρ = true := by
  rw [cubeB_iff]
  constructor
  · rintro ⟨a, ha, he⟩
    have key : ∀ i : Fin 4, n i = (a i : ℕ) + 1 := by
      intro i
      have h := congrFun he i
      simp only [offLink, Pi.add_apply] at h
      have h' : (n i : ZMod (2 * M)) - 1 = (((a i : ℕ) + 1 : ℕ) : ZMod (2 * M)) - 1 := by
        push_cast
        linear_combination h
      exact off_inj M hM (hn i i.isLt) (by have := (a i).isLt; omega) h'
    intro i hi
    have hk : n i = (a ⟨i, hi⟩ : ℕ) + 1 := key ⟨i, hi⟩
    have hai := (a ⟨i, hi⟩).isLt
    simp only [cC, Bool.and_eq_true, Bool.or_eq_true, beq_iff_eq, bne_iff_ne, ne_eq]
    refine ⟨by omega, ?_⟩
    by_cases hiρ : i = (ρ : ℕ)
    · right
      have hρ : (⟨i, hi⟩ : Fin 4) = ρ := Fin.ext hiρ
      have ha' : a ρ = 0 := ha
      rw [hk, hρ, ha']
      rfl
    · left
      exact hiρ
  · intro h
    have h' : ∀ i : Fin 4, (n i = 1 ∨ n i = 2) ∧ ((i : ℕ) = ρ → n i = 1) := by
      intro i
      have := h i i.isLt
      simp only [cC, Bool.and_eq_true, Bool.or_eq_true, beq_iff_eq, bne_iff_ne, ne_eq] at this
      refine ⟨this.1, fun hi => ?_⟩
      rcases this.2 with h2 | h2
      · exact absurd hi h2
      · exact h2
    refine ⟨fun i => ⟨n i - 1, by have := (h' i).1; omega⟩, ?_, ?_⟩
    · apply Fin.ext
      show n ρ - 1 = 0
      have := (h' ρ).2 rfl
      omega
    · funext i
      have h1 : 1 ≤ n i := by have := (h' i).1; omega
      show x i + ((n i : ZMod (2 * M)) - 1) = x i + ((n i - 1 : ℕ) : ZMod (2 * M))
      rw [Nat.cast_sub h1, Nat.cast_one]

/-- The parity of a coordinate of `ℤ/2Mℤ`. -/
def zpar (z : ZMod (2 * M)) : ℕ := (ZMod.castHom (dvd_mul_right 2 M) (ZMod 2) z).val

theorem zpar_eq (z : ZMod (2 * M)) : zpar M z = z.val % 2 := by
  unfold zpar
  conv_lhs => rw [← ZMod.natCast_zmod_val z]
  rw [map_natCast, ZMod.val_natCast]

theorem zpar_lt (z : ZMod (2 * M)) : zpar M z < 2 := by
  rw [zpar_eq]; omega

omit [NeZero M] in
theorem zpar_off (z : ZMod (2 * M)) (m : ℕ) :
    zpar M (z + ((m : ZMod (2 * M)) - 1)) = 0 ↔ (zpar M z + m) % 2 = 1 := by
  unfold zpar
  rw [map_add, map_sub, map_natCast, map_one]
  generalize ZMod.castHom (dvd_mul_right 2 M) (ZMod 2) z = c
  rw [← ZMod.natCast_mod m 2, Nat.add_mod c.val m 2]
  have hm : m % 2 < 2 := Nat.mod_lt _ (by norm_num)
  generalize m % 2 = k at hm ⊢
  have key : ∀ c : ZMod 2, ∀ k : ℕ, k < 2 →
      ((c + ((k : ZMod 2) - 1)).val = 0 ↔ (c.val % 2 + k) % 2 = 1) := by decide
  exact key c k hm

/-- **A link whose coordinates (other than its direction) are even lies on the skeleton.** -/
theorem mem_skel_of_par (z : Site (2 * M)) (ρ : Fin 4) (h : ∀ i, i ≠ ρ → zpar M (z i) = 0) :
    (z, ρ) ∈ skel (straightBlocking M) := by
  let y : Site M := fun i => (((z i).val / 2 : ℕ) : ZMod M)
  have hy : ∀ i, ιS M y i = z i - (((z i).val % 2 : ℕ) : ZMod (2 * M)) := by
    intro i
    have e1 : ιS M y i = ((2 * ((z i).val / 2) : ℕ) : ZMod (2 * M)) := by
      show dbl M ((((z i).val / 2 : ℕ) : ZMod M)) = _
      rw [← Int.cast_natCast, dbl_intCast]
      norm_cast
    rw [e1]
    have hz : z i = ((2 * ((z i).val / 2) + (z i).val % 2 : ℕ) : ZMod (2 * M)) := by
      rw [Nat.div_add_mod, ZMod.natCast_zmod_val]
    generalize (z i).val = v at hz ⊢
    rw [hz, Nat.cast_add]
    ring
  have hpar : ∀ i, i ≠ ρ → (z i).val % 2 = 0 := fun i hi => by rw [← zpar_eq]; exact h i hi
  simp only [skel, Set.mem_union, Set.mem_range]
  have hρ : (z ρ).val % 2 = 0 ∨ (z ρ).val % 2 = 1 := by omega
  rcases hρ with h0 | h1
  · left
    refine ⟨(y, ρ), ?_⟩
    show (ιS M y, ρ) = (z, ρ)
    congr 1
    funext i
    rw [hy i]
    by_cases hi : i = ρ
    · subst hi
      rw [h0]
      simp
    · rw [hpar i hi]
      simp
  · right
    refine ⟨(y, ρ), ?_⟩
    show (ιS M y + unitV ρ, ρ) = (z, ρ)
    congr 1
    funext i
    rw [Pi.add_apply, hy i]
    by_cases hi : i = ρ
    · subst hi
      rw [h1]
      simp [unitV]
    · rw [hpar i hi]
      simp [unitV, Pi.single_eq_of_ne hi]

/-- The parity code `∑ᵢ zpar(xᵢ) 2ⁱ` of a site. -/
def parCode (x : Site (2 * M)) : ℕ :=
  zpar M (x 0) + 2 * zpar M (x 1) + 4 * zpar M (x 2) + 8 * zpar M (x 3)

theorem parCode_lt (x : Site (2 * M)) : parCode M x < 16 := by
  have := zpar_lt M (x 0); have := zpar_lt M (x 1); have := zpar_lt M (x 2); have := zpar_lt M (x 3)
  unfold parCode; omega

theorem parCode_bit (x : Site (2 * M)) (i : Fin 4) : parCode M x / 2 ^ (i : ℕ) % 2 = zpar M (x i) := by
  have := zpar_lt M (x 0); have := zpar_lt M (x 1); have := zpar_lt M (x 2); have := zpar_lt M (x 3)
  unfold parCode
  fin_cases i <;> simp <;> omega

/-- **The skeleton test is sound**: if the local skeleton test holds for the shifted offsets `n`, the
link `offLink x n ρ` lies on the skeleton. -/
theorem offLink_mem_skel (x : Site (2 * M)) (n : ℕ → ℕ) (ρ : Fin 4)
    (h : skelB (parCode M x) n ρ = true) : offLink M x n ρ ∈ skel (straightBlocking M) := by
  rw [skelB_iff] at h
  apply mem_skel_of_par
  intro i hi
  have := h i i.isLt
  simp only [sC, Bool.or_eq_true, beq_iff_eq] at this
  rcases this with h1 | h1
  · exact absurd (Fin.ext h1) hi
  · rw [zpar_off, ← parCode_bit M x i]
    exact h1


/-! ### Plaquettes in window coordinates -/

/-- The four links of the plaquette `q`. -/
def plaqLinks {n : ℕ} (q : PlaqIdx n) : Finset (Link n) :=
  {(plaqOf q).l1, (plaqOf q).l2, (plaqOf q).l3, (plaqOf q).l4}

/-- Link number `k` of `q` (`l₁, l₂, l₃, l₄` for `k = 0, 1, 2, ≥ 3`). -/
def linkK {n : ℕ} (q : PlaqIdx n) (k : ℕ) : Link n :=
  if k = 0 then (plaqOf q).l1 else if k = 1 then (plaqOf q).l2 else if k = 2 then (plaqOf q).l3
  else (plaqOf q).l4

/-- The position of `e` in `q` (the first match; `3` if none). -/
def posK {n : ℕ} (q : PlaqIdx n) (e : Link n) : ℕ :=
  if e = (plaqOf q).l1 then 0 else if e = (plaqOf q).l2 then 1 else if e = (plaqOf q).l3 then 2
  else 3

theorem posK_lt {n : ℕ} (q : PlaqIdx n) (e : Link n) : posK q e < 4 := by
  unfold posK; split_ifs <;> omega

theorem linkK_posK {n : ℕ} {q : PlaqIdx n} {e : Link n} (he : e ∈ plaqLinks q) :
    linkK q (posK q e) = e := by
  simp only [plaqLinks, Finset.mem_insert, Finset.mem_singleton] at he
  unfold posK
  split_ifs with h1 h2 h3
  · simp [linkK, h1]
  · simp [linkK, h2]
  · simp [linkK, h3]
  · have : e = (plaqOf q).l4 := by tauto
    simp [linkK, this]

theorem linkK_mem {n : ℕ} (q : PlaqIdx n) (k : ℕ) : linkK q k ∈ plaqLinks q := by
  unfold linkK plaqLinks; split_ifs <;> simp

/-- The direction of link number `k` of a plaquette with directions `μ < ν`. -/
def dirF (μ ν : Fin 4) (k : ℕ) : Fin 4 := if k = 0 ∨ k = 2 then μ else ν

omit [NeZero M] in
theorem unitV_apply_eq (μ i : Fin 4) :
    (unitV μ : Site (2 * M)) i = (((cond ((i : ℕ) == (μ : ℕ)) 1 0 : ℕ)) : ZMod (2 * M)) := by
  by_cases h : i = μ
  · subst h; simp [unitV]
  · have h' : ((i : ℕ) == (μ : ℕ)) = false := by
      simp only [beq_eq_false_iff_ne, ne_eq]
      exact fun h'' => h (Fin.ext h'')
    rw [h']
    simp [unitV, Pi.single_eq_of_ne h]

omit [NeZero M] in
/-- **The links of a plaquette in window coordinates.** If the base of `q` sits at offset
`cB t i − 1` from `x` and `q` has directions `(cMu t, cNu t)`, then link `k` of `q` is
`offLink x (wOff t k) (dirF μ ν k)`. -/
theorem linkK_eq (x : Site (2 * M)) (q : PlaqIdx (2 * M)) (t : ℕ)
    (hb : ∀ i : Fin 4, q.1.1 i = x i + (((t / 3 ^ (i : ℕ) % 3 : ℕ) : ZMod (2 * M)) - 1))
    (hμ : t / 81 % 4 = q.1.2.1) (hν : t / 324 % 4 = q.1.2.2) (k : ℕ) (hk : k < 4) :
    linkK q k = offLink M x (wOff t k) (dirF q.1.2.1 q.1.2.2 k) := by
  obtain ⟨⟨y, μ, ν⟩, hμν⟩ := q
  simp only at hb hμ hν ⊢
  interval_cases k
  · simp only [linkK, plaqOf, offLink, dirF, wOff]
    refine Prod.ext (funext fun i => ?_) (by simp)
    simp [hb i]
  · refine Prod.ext (funext fun i => ?_) (by simp [linkK, plaqOf, offLink, dirF])
    show y i + unitV μ i = x i + (((wOff t 1 i : ℕ) : ZMod (2 * M)) - 1)
    rw [hb i, unitV_apply_eq]
    simp only [wOff, hμ]
    simp only [show ((1 : ℕ) == 1) = true from rfl, show ((1 : ℕ) == 2) = false from rfl,
      Bool.true_and, Bool.false_and, Bool.or_false]
    push_cast
    ring
  · refine Prod.ext (funext fun i => ?_) (by simp [linkK, plaqOf, offLink, dirF])
    show y i + unitV ν i = x i + (((wOff t 2 i : ℕ) : ZMod (2 * M)) - 1)
    rw [hb i, unitV_apply_eq]
    simp only [wOff, hν]
    simp only [show ((2 : ℕ) == 1) = false from rfl, show ((2 : ℕ) == 2) = true from rfl,
      Bool.true_and, Bool.false_and, Bool.false_or]
    push_cast
    ring
  · simp only [linkK, plaqOf, offLink, dirF, wOff]
    refine Prod.ext (funext fun i => ?_) (by simp)
    simp [hb i]

theorem dirF_val (t : ℕ) (μ ν : Fin 4) (hμ : t / 81 % 4 = μ) (hν : t / 324 % 4 = ν) (k : ℕ) :
    ((dirF μ ν k : Fin 4) : ℕ) = wDir t k := by
  unfold dirF wDir
  by_cases h0 : k = 0
  · subst h0; simp [hμ]
  by_cases h2 : k = 2
  · subst h2; simp [hμ]
  have e0 : (k == 0) = false := by simp [h0]
  have e2 : (k == 2) = false := by simp [h2]
  rw [if_neg (by omega), e0, e2]
  simp [hν]

/-- Decoding of base offsets: `z = (m − 1)` with `m ∈ {0, 1, 2}` gives back `m` (`M ≥ 2`). -/
def dec (z : ZMod (2 * M)) : ℕ := if z = -1 then 0 else if z = 0 then 1 else 2

omit [NeZero M] in
theorem dec_eq (hM : 2 ≤ M) {m : ℕ} (hm : m < 3) : dec M ((m : ZMod (2 * M)) - 1) = m := by
  unfold dec
  have hn1 : (-1 : ZMod (2 * M)) = ((0 : ℕ) : ZMod (2 * M)) - 1 := by simp
  have h0 : (0 : ZMod (2 * M)) = ((1 : ℕ) : ZMod (2 * M)) - 1 := by simp
  split_ifs with ha hb
  · rw [hn1] at ha
    exact (off_inj M hM (by omega) (by omega) ha).symm
  · rw [h0] at hb
    exact (off_inj M hM (by omega) (by omega) hb).symm
  · have h1 : m ≠ 0 := fun h => ha (by subst h; simp)
    have h2 : m ≠ 1 := fun h => hb (by subst h; simp)
    omega

omit [NeZero M] in
/-- A plaquette that meets `cube2 M x` has its base at offset `m − 1`, `m ∈ {0, 1, 2}`, from `x`. -/
theorem base_off (x : Site (2 * M)) (q : PlaqIdx (2 * M)) {l : Link (2 * M)}
    (hl : l ∈ plaqLinks q) (hc : l ∈ cube2 M x) (i : Fin 4) :
    ∃ m : ℕ, m < 3 ∧ q.1.1 i = x i + ((m : ZMod (2 * M)) - 1) := by
  obtain ⟨a, -, ha⟩ := hc
  have hi := congrFun ha i
  have hai := (a i).isLt
  obtain ⟨⟨y, μ, ν⟩, hμν⟩ := q
  simp only [plaqLinks, Finset.mem_insert, Finset.mem_singleton] at hl
  simp only
  rcases hl with rfl | rfl | rfl | rfl
  · refine ⟨(a i : ℕ) + 1, by omega, ?_⟩
    simp only [plaqOf, Pi.add_apply] at hi
    rw [hi]; push_cast; ring
  · simp only [plaqOf, Pi.add_apply, unitV_apply_eq] at hi
    refine ⟨(a i : ℕ) + 1 - cond ((i : ℕ) == (μ : ℕ)) 1 0, ?_, ?_⟩
    · cases ((i : ℕ) == (μ : ℕ)) <;> simp <;> omega
    · have hle : cond ((i : ℕ) == (μ : ℕ)) 1 0 ≤ (a i : ℕ) + 1 := by
        cases ((i : ℕ) == (μ : ℕ)) <;> simp
      rw [Nat.cast_sub hle]
      push_cast
      linear_combination hi
  · simp only [plaqOf, Pi.add_apply, unitV_apply_eq] at hi
    refine ⟨(a i : ℕ) + 1 - cond ((i : ℕ) == (ν : ℕ)) 1 0, ?_, ?_⟩
    · cases ((i : ℕ) == (ν : ℕ)) <;> simp <;> omega
    · have hle : cond ((i : ℕ) == (ν : ℕ)) 1 0 ≤ (a i : ℕ) + 1 := by
        cases ((i : ℕ) == (ν : ℕ)) <;> simp
      rw [Nat.cast_sub hle]
      push_cast
      linear_combination hi
  · refine ⟨(a i : ℕ) + 1, by omega, ?_⟩
    simp only [plaqOf, Pi.add_apply] at hi
    rw [hi]; push_cast; ring


/-! ### The window count and the column sum -/

/-- Window code of `(b, μ, ν, k)`: `b 0 + 3 b 1 + 9 b 2 + 27 b 3 + 81 μ + 324 ν + 1296 k`. -/
def code (b : ℕ → ℕ) (μ ν k : ℕ) : ℕ :=
  b 0 + 3 * b 1 + 9 * b 2 + 27 * b 3 + 81 * μ + 324 * ν + 1296 * k

theorem code_decode {b : ℕ → ℕ} (hb : ∀ i < 4, b i < 3) {μ ν k : ℕ} (hμ : μ < 4) (hν : ν < 4)
    (hk : k < 4) :
    (∀ i < 4, code b μ ν k / 3 ^ i % 3 = b i) ∧ code b μ ν k / 81 % 4 = μ ∧
      code b μ ν k / 324 % 4 = ν ∧ code b μ ν k / 1296 % 4 = k ∧ code b μ ν k < 5184 := by
  have h0 := hb 0 (by norm_num)
  have h1 := hb 1 (by norm_num)
  have h2 := hb 2 (by norm_num)
  have h3 := hb 3 (by norm_num)
  refine ⟨fun i hi => ?_, ?_, ?_, ?_, ?_⟩
  · interval_cases i <;> simp only [code, Nat.reducePow] <;> omega
  all_goals (simp only [code]; omega)

theorem wOff_lt (t k i : ℕ) : wOff t k i < 4 := by
  unfold wOff
  have := Nat.mod_lt (t / 3 ^ i) (by norm_num : 3 > 0)
  cases ((k == 1 && i == t / 81 % 4) || (k == 2 && i == t / 324 % 4)) <;> simp <;> omega

/-- Link number `j` of the window plaquette `t` is in the local cube and off the local skeleton. -/
def wMeet (p t j : ℕ) : Bool := cubeB (wOff t j) (wDir t j) && !skelB p (wOff t j) (wDir t j)

/-- The window plaquette with code `s` has directions `μ < ν`. -/
def wDirOk (s : ℕ) : Bool := Nat.blt (s / 81 % 4) (s / 324 % 4)

/-- The window plaquette with code `s` meets the block (some link in the cube and off the skeleton). -/
def wMeets (p s : ℕ) : Bool := wMeet p s 0 || wMeet p s 1 || wMeet p s 2 || wMeet p s 3

/-- Link number `k` of the window plaquette with code `s` is off the cube and off the skeleton. -/
def wOut (p s k : ℕ) : Bool := !cubeB (wOff s k) (wDir s k) && !skelB p (wOff s k) (wDir s k)

/-- **The window predicate** (parity code `p` of the base point): the window plaquette with code `s`
has directions `μ < ν` and meets the block, and its link number `k` is off the cube and off the
skeleton. -/
def wPred (p s k : ℕ) : Bool := wDirOk s && wMeets p s && wOut p s k

/-- The number of link positions `k < 4` with `wPred p s k`, computed per plaquette. -/
def wCnt (p s : ℕ) : ℕ :=
  cond (wDirOk s && wMeets p s)
    (cond (wOut p s 0) 1 0 + cond (wOut p s 1) 1 0 + cond (wOut p s 2) 1 0 + cond (wOut p s 3) 1 0) 0

/-- **The window count (one finite computation)**: for each of the `16` parity classes, the window
plaquettes (codes `s < 1296`) carry exactly `228` pairs (plaquette, link position) satisfying the
window predicate. -/
theorem window_count :
    (List.range 16).all (fun p => ((List.range 1296).map (wCnt p)).sum == 228) = true := by
  decide +kernel

theorem window_count_of_lt {p : ℕ} (hp : p < 16) : ((List.range 1296).map (wCnt p)).sum = 228 := by
  have h := List.all_eq_true.1 window_count p (List.mem_range.2 hp)
  simpa using h

theorem sum_range_list (g : ℕ → ℕ) : ∀ n, ∑ s ∈ Finset.range n, g s = ((List.range n).map g).sum
  | 0 => by simp
  | n + 1 => by
    rw [Finset.sum_range_succ, List.range_succ, List.map_append, List.sum_append, sum_range_list g n]
    simp

theorem wCnt_eq (p s : ℕ) :
    ∑ k ∈ Finset.range 4, (if wPred p s k = true then 1 else 0) = wCnt p s := by
  have key : ∀ a b0 b1 b2 b3 : Bool,
      ((((0 + if (a && b0) = true then 1 else 0) + if (a && b1) = true then 1 else 0) +
          if (a && b2) = true then 1 else 0) + if (a && b3) = true then 1 else 0 : ℕ) =
        cond a (cond b0 1 0 + cond b1 1 0 + cond b2 1 0 + cond b3 1 0) 0 := by decide
  simp only [Finset.sum_range_succ, Finset.sum_range_zero]
  exact key _ _ _ _ _

/-- `kₑₓ`: the number of plaquettes of `(ℤ/2Mℤ)⁴` that contain the link `e` and meet the block
`cube2 M x ∖ Sk`. -/
noncomputable def kCount (x : Site (2 * M)) (e : Link (2 * M)) : ℕ := by
  classical
  exact (univ.filter fun q : PlaqIdx (2 * M) =>
    e ∈ plaqLinks q ∧ ∃ l ∈ plaqLinks q, l ∈ cube2 M x \ skel (straightBlocking M)).card

/-- The base offsets (shifted by `1`) of the plaquette `q` relative to `x`. -/
def bOf (x : Site (2 * M)) (q : PlaqIdx (2 * M)) : ℕ → ℕ :=
  fun i => if h : i < 4 then dec M (q.1.1 ⟨i, h⟩ - x ⟨i, h⟩) else 0

omit [NeZero M] in
theorem bOf_spec (hM : 2 ≤ M) (x : Site (2 * M)) (q : PlaqIdx (2 * M))
    (hmeet : ∃ l ∈ plaqLinks q, l ∈ cube2 M x) :
    (∀ i < 4, bOf M x q i < 3) ∧ ∀ i : Fin 4, q.1.1 i = x i + ((bOf M x q i : ZMod (2 * M)) - 1) := by
  obtain ⟨l, hl, hc⟩ := hmeet
  have key : ∀ i : Fin 4, bOf M x q i < 3 ∧ q.1.1 i = x i + ((bOf M x q i : ZMod (2 * M)) - 1) := by
    intro i
    obtain ⟨m, hm, hq⟩ := base_off M x q hl hc i
    have hb : bOf M x q i = m := by
      have e : bOf M x q i = dec M (q.1.1 i - x i) := dif_pos i.isLt
      rw [e, show q.1.1 i - x i = (m : ZMod (2 * M)) - 1 by rw [hq]; ring]
      exact dec_eq M hM hm
    rw [hb]
    exact ⟨hm, hq⟩
  exact ⟨fun i hi => (key ⟨i, hi⟩).1, fun i => (key i).2⟩

omit [NeZero M] in
/-- All window facts for a plaquette `q` that meets `cube2 M x` and a position `k < 4`. -/
theorem window_facts (hM : 2 ≤ M) (x : Site (2 * M)) (q : PlaqIdx (2 * M))
    (hmeet : ∃ l ∈ plaqLinks q, l ∈ cube2 M x) {k : ℕ} (hk : k < 4) :
    (∀ i < 4, code (bOf M x q) q.1.2.1 q.1.2.2 k / 3 ^ i % 3 = bOf M x q i) ∧
    code (bOf M x q) q.1.2.1 q.1.2.2 k / 81 % 4 = q.1.2.1 ∧
    code (bOf M x q) q.1.2.1 q.1.2.2 k / 324 % 4 = q.1.2.2 ∧
    code (bOf M x q) q.1.2.1 q.1.2.2 k / 1296 % 4 = k ∧
    code (bOf M x q) q.1.2.1 q.1.2.2 k < 5184 ∧
    ∀ j < 4, linkK q j = offLink M x (wOff (code (bOf M x q) q.1.2.1 q.1.2.2 k) j)
      (dirF q.1.2.1 q.1.2.2 j) := by
  obtain ⟨hb3, hbq⟩ := bOf_spec M hM x q hmeet
  obtain ⟨hB, hμ, hν, hK, hlt⟩ := code_decode hb3 q.1.2.1.isLt q.1.2.2.isLt hk
  refine ⟨hB, hμ, hν, hK, hlt, fun j hj => linkK_eq M x q _ (fun i => ?_) hμ hν j hj⟩
  rw [hB i i.isLt]
  exact hbq i

/-- **The column sum of the influence counts is at most `228`** (every `M ≥ 2`, every base point
`x`, straight blocking): `∑_{e ∈ N ∖ Bₓ} kₑₓ ≤ 228`. -/
theorem col_count_nat (hM : 2 ≤ M) (x : Site (2 * M)) :
    ∑ e ∈ (su2Block M x)ᶜ, kCount M x e.1 ≤ 228 := by
  classical
  let S := ((su2Block M x)ᶜ ×ˢ (univ : Finset (PlaqIdx (2 * M)))).filter
    (fun eq : NSk M × PlaqIdx (2 * M) => eq.1.1 ∈ plaqLinks eq.2 ∧
      ∃ l ∈ plaqLinks eq.2, l ∈ cube2 M x \ skel (straightBlocking M))
  have hS : ∑ e ∈ (su2Block M x)ᶜ, kCount M x e.1 = S.card := by
    rw [Finset.card_filter, Finset.sum_product]
    refine Finset.sum_congr rfl fun e _ => ?_
    rw [kCount, Finset.card_filter]
  have hmem : ∀ eq ∈ S, eq.1.1 ∈ plaqLinks eq.2 ∧ eq.1.1 ∉ cube2 M x ∧
      ∃ l ∈ plaqLinks eq.2, l ∈ cube2 M x ∧ l ∉ skel (straightBlocking M) := by
    intro eq heq
    obtain ⟨hprod, he2, l, hl, hlc, hls⟩ := Finset.mem_filter.1 heq
    have he1 := (Finset.mem_product.1 hprod).1
    refine ⟨he2, fun hc => ?_, l, hl, hlc, hls⟩
    exact Finset.mem_compl.1 he1 ((mem_su2Block M).2 hc)
  rw [hS]
  calc S.card ≤ ((Finset.range 1296 ×ˢ Finset.range 4).filter
        (fun sk : ℕ × ℕ => wPred (parCode M x) sk.1 sk.2 = true)).card := by
        generalize hR : (Finset.range 1296 ×ˢ Finset.range 4 : Finset (ℕ × ℕ)) = R
        refine Finset.card_le_card_of_injOn
          (fun eq : NSk M × PlaqIdx (2 * M) =>
            (code (bOf M x eq.2) eq.2.1.2.1 eq.2.1.2.2 0, posK eq.2 eq.1.1))
          (fun eq heq => ?_) (fun eq1 heq1 eq2 heq2 hf => ?_)
        · obtain ⟨he, hnc, l, hl, hlc, hls⟩ := hmem eq (Finset.mem_coe.1 heq)
          obtain ⟨-, hμ, hν, -, -, hlink⟩ :=
            window_facts M hM x eq.2 ⟨l, hl, hlc⟩ (k := 0) (by norm_num)
          have hb3 := (bOf_spec M hM x eq.2 ⟨l, hl, hlc⟩).1
          have hC : code (bOf M x eq.2) eq.2.1.2.1 eq.2.1.2.2 0 < 1296 := by
            have h0 := hb3 0 (by norm_num)
            have h1 := hb3 1 (by norm_num)
            have h2 := hb3 2 (by norm_num)
            have h3 := hb3 3 (by norm_num)
            have hμ4 := eq.2.1.2.1.isLt
            have hν4 := eq.2.1.2.2.isLt
            simp only [code]
            omega
          rw [Finset.mem_coe, Finset.mem_filter, ← hR, Finset.mem_product, Finset.mem_range,
            Finset.mem_range]
          refine ⟨⟨hC, posK_lt _ _⟩, ?_⟩
          have hkl := hlink _ (posK_lt eq.2 eq.1.1)
          rw [linkK_posK he] at hkl
          have hjl := hlink _ (posK_lt eq.2 l)
          rw [linkK_posK hl] at hjl
          simp only [wPred, wDirOk, wMeets, wOut, Bool.and_eq_true, Bool.not_eq_true',
            Bool.or_eq_true]
          refine ⟨⟨by rw [Nat.blt_eq, hμ, hν]; exact eq.2.2, ?_⟩, ?_, ?_⟩
          · have hw : wMeet (parCode M x) (code (bOf M x eq.2) eq.2.1.2.1 eq.2.1.2.2 0)
                (posK eq.2 l) = true := by
              simp only [wMeet, Bool.and_eq_true, Bool.not_eq_true']
              rw [← dirF_val _ _ _ hμ hν]
              refine ⟨(offLink_mem_cube2 M hM x _ (fun i _ => wOff_lt _ _ i) _).1
                (by rw [← hjl]; exact hlc), ?_⟩
              by_contra hs
              simp only [Bool.not_eq_false] at hs
              exact hls (by rw [hjl]; exact offLink_mem_skel M x _ _ hs)
            obtain ⟨j, hj4, hjw⟩ : ∃ j < 4, wMeet (parCode M x)
                (code (bOf M x eq.2) eq.2.1.2.1 eq.2.1.2.2 0) j = true := ⟨_, posK_lt eq.2 l, hw⟩
            rcases (by omega : j = 0 ∨ j = 1 ∨ j = 2 ∨ j = 3) with rfl | rfl | rfl | rfl <;>
              simp [hjw]
          · rw [← dirF_val _ _ _ hμ hν]
            have h1 : ¬ cubeB (wOff (code (bOf M x eq.2) eq.2.1.2.1 eq.2.1.2.2 0) (posK eq.2 eq.1.1))
                (dirF eq.2.1.2.1 eq.2.1.2.2 (posK eq.2 eq.1.1)) = true := by
              rw [← offLink_mem_cube2 M hM x _ (fun i _ => wOff_lt _ _ i), ← hkl]
              exact hnc
            simpa using h1
          · rw [← dirF_val _ _ _ hμ hν]
            have h1 : ¬ skelB (parCode M x)
                (wOff (code (bOf M x eq.2) eq.2.1.2.1 eq.2.1.2.2 0) (posK eq.2 eq.1.1))
                (dirF eq.2.1.2.1 eq.2.1.2.2 (posK eq.2 eq.1.1)) = true := by
              intro hs
              have := offLink_mem_skel M x _ _ hs
              rw [← hkl] at this
              exact eq.1.2 this
            simpa using h1
        · obtain ⟨he1, -, l1, hl1, hlc1, -⟩ := hmem eq1 (Finset.mem_coe.1 heq1)
          obtain ⟨he2, -, l2, hl2, hlc2, -⟩ := hmem eq2 (Finset.mem_coe.1 heq2)
          obtain ⟨hB1, hμ1, hν1, -, -, -⟩ :=
            window_facts M hM x eq1.2 ⟨l1, hl1, hlc1⟩ (k := 0) (by norm_num)
          obtain ⟨hB2, hμ2, hν2, -, -, -⟩ :=
            window_facts M hM x eq2.2 ⟨l2, hl2, hlc2⟩ (k := 0) (by norm_num)
          have hf2 : (code (bOf M x eq1.2) eq1.2.1.2.1 eq1.2.1.2.2 0, posK eq1.2 eq1.1.1) =
              (code (bOf M x eq2.2) eq2.2.1.2.1 eq2.2.1.2.2 0, posK eq2.2 eq2.1.1) := hf
          rw [Prod.mk.injEq] at hf2
          obtain ⟨hf', hk⟩ := hf2
          have hμ : eq1.2.1.2.1 = eq2.2.1.2.1 := Fin.ext (by rw [← hμ1, ← hμ2, hf'])
          have hν : eq1.2.1.2.2 = eq2.2.1.2.2 := Fin.ext (by rw [← hν1, ← hν2, hf'])
          have hy : eq1.2.1.1 = eq2.2.1.1 := by
            funext i
            rw [(bOf_spec M hM x eq1.2 ⟨l1, hl1, hlc1⟩).2 i,
              (bOf_spec M hM x eq2.2 ⟨l2, hl2, hlc2⟩).2 i, ← hB1 i i.isLt, ← hB2 i i.isLt, hf']
          have hq : eq1.2 = eq2.2 := Subtype.ext (Prod.ext hy (Prod.ext hμ hν))
          have he : eq1.1 = eq2.1 := by
            apply Subtype.ext
            rw [← linkK_posK he1, ← linkK_posK he2, hk, hq]
          exact Prod.ext he hq
    _ = ∑ s ∈ Finset.range 1296, wCnt (parCode M x) s := by
        rw [Finset.card_filter, Finset.sum_product]
        exact Finset.sum_congr rfl fun s _ => wCnt_eq _ s
    _ = 228 := by rw [sum_range_list]; exact window_count_of_lt (parCode_lt M x)

/-- **The column sum of the influence counts, real form** (every `M ≥ 2`, every base point `x`,
straight blocking): `∑_{e ∈ N ∖ Bₓ} kₑₓ ≤ 228`. -/
theorem col_count (hM : 2 ≤ M) (x : Site (2 * M)) :
    ∑ e ∈ (su2Block M x)ᶜ, (kCount M x e.1 : ℝ) ≤ 228 := by
  exact_mod_cast col_count_nat M hM x

/-! ### Assembly: `SU2HeatBathInfluence` from a smaller named hypothesis -/

/-- **The smaller named hypothesis.** Influence data for the constrained heat baths
`P'ₓ = E_μ[· | links outside cube2 M x ∖ Sk]` of the SU(2) Wilson measure
`μ ∝ exp((β/2) ∑ₚ Re tr U_p) ∏ dU` on `(ℤ/2Mℤ)⁴` (`β = β_W`), straight blocking, in which the
influence coefficient is fixed to `|β| kₑₓ` (`kCount`): a domain `D ⊆ H ∩ ker E_μ[· | σ(Sk)]`, dense
there, functionals `δₑ ≥ 0` (`e` a non-skeleton link) killed on the block, the influence step
`δₑ(P'ₓ f) ≤ δₑ f + |β| kₑₓ ∑_{e' ∈ Bₓ} δₑ' f` for `e ∉ Bₓ`, and `‖f‖ ≤ K ∑ₑ δₑ f`. Compared with
`SU2HeatBathInfluence`, the influence matrix and its column sums are no longer data; the influence
step `infl`, which carries the analytic content, still is. -/
structure SU2HeatBathOsc (M : ℕ) [NeZero M] (β : ℝ) where
  /-- The domain (paper: continuous versions with conditional skeleton mean `0`). -/
  D : Set (wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2)
  /-- The oscillation functionals (paper: oscillation in `Uₑ`). -/
  δ : NSk M → wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 → ℝ
  /-- The comparison constant (paper: `K = 1`). -/
  K : ℝ
  mem : ∀ x, ∀ f ∈ D, (su2ConstrPj M β x).P f ∈ D
  nonneg : ∀ e, ∀ f ∈ D, 0 ≤ δ e f
  self : ∀ x, ∀ e ∈ su2Block M x, ∀ f ∈ D, δ e ((su2ConstrPj M β x).P f) = 0
  infl : ∀ x e, e ∉ su2Block M x → ∀ f ∈ D,
    δ e ((su2ConstrPj M β x).P f) ≤ δ e f + |β| * (kCount M x e.1 : ℝ) * ∑ k ∈ su2Block M x, δ k f
  K_nonneg : 0 ≤ K
  poinc : ∀ f ∈ D, ‖f‖ ≤ K * ∑ e, δ e f
  ker_skel : ∀ f ∈ D, su2P M β (skel (straightBlocking M))ᶜ f = 0
  dense : ∀ u, su2P M β (skel (straightBlocking M))ᶜ u = 0 → u ∈ closure D

variable {M}

/-- **`SU2HeatBathInfluence M β (228 |β|)` from the smaller hypothesis** (every `M ≥ 2`, every real
`β = β_W`): the influence matrix is `c e x = |β| kₑₓ`, and its column sums are `≤ 228 |β|` by
`col_count`. -/
noncomputable def SU2HeatBathOsc.toInfluence (hM : 2 ≤ M) {β : ℝ} (O : SU2HeatBathOsc M β) :
    SU2HeatBathInfluence M β (228 * |β|) where
  D := O.D
  δ := O.δ
  c e x := |β| * (kCount M x e.1 : ℝ)
  K := O.K
  mem := O.mem
  nonneg := O.nonneg
  self := O.self
  infl := O.infl
  c_nonneg _ _ := mul_nonneg (abs_nonneg _) (Nat.cast_nonneg _)
  col x := by
    rw [← Finset.mul_sum, mul_comm]
    exact mul_le_mul_of_nonneg_right (col_count M hM x) (abs_nonneg β)
  K_nonneg := O.K_nonneg
  poinc := O.poinc
  ker_skel := O.ker_skel
  dense := O.dense

/-- **`hsweep` at small `|β|` from the smaller hypothesis** (SU(2), `β = β_W`, `(ℤ/2Mℤ)⁴`, every
`M ≥ 2`, `|β| ≤ 1/228`): every parity sweep of the constrained heat baths contracts by `228 |β|` on
`H ∩ ker Π`. -/
theorem su2_hsweep_of_osc (hM : 2 ≤ M) {β : ℝ} (O : SU2HeatBathOsc M β) (hβ : |β| ≤ 1 / 228) :
    ∀ (j : Fin 3 → ZMod 2) u, (su2Pi M β).P u = 0 →
      ‖sweepProd (fun x => wilsonPj (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
        (cube2 M x \ skel (straightBlocking M))) (parFamily M j) u‖ ≤ (228 * |β|) * ‖u‖ :=
  su2_hsweep_of_influence (O.toInfluence hM) (by positivity) (by linarith)

/-- **`hcons` at small `|β|` from the smaller hypothesis** (SU(2), `β = β_W`, `(ℤ/2Mℤ)⁴`, every
`M ≥ 2`, side-2 cubes at every base point, weights `1/16`, `|β| ≤ 1/228`):
`(1/2)(1 − 228 |β|)² ‖u‖² ≤ ∑ₓ (1/16) ‖u − P'ₓ u‖²` on `H ∩ ker Π`. The constants do not depend
on `M`. A finite-volume fibre bound for the constrained heat baths, conditional on
`SU2HeatBathOsc M β`, which is established only at `β = 0`; not a mass gap. -/
theorem su2_hcons_of_osc (hM : 2 ≤ M) {β : ℝ} (O : SU2HeatBathOsc M β) (hβ : |β| ≤ 1 / 228)
    (u : wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2) (hu : (su2Pi M β).P u = 0) :
    ((1 / 2 : ℝ) * (1 - 228 * |β|) ^ 2) * ‖u‖ ^ 2 ≤
      ∑ x, (1 / 16 : ℝ) * ‖u - su2P M β (cube2 M x \ skel (straightBlocking M)) u‖ ^ 2 :=
  su2_hcons_small_beta (O.toInfluence hM) hβ u hu

variable (M)

/-- **The smaller hypothesis holds at `β = 0`** (every `M ≥ 1`), from Part XXI's
