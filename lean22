open OrientedGraph

section Offsets

variable {n : ℕ}

/-- Coordinatewise reduction of an integer offset modulo `n`. -/
def modOff (n : ℕ) (a : Fin 4 → ℤ) : Fin 4 → ℤ := fun i => a i % (n : ℤ)

theorem ofOff_eq_iff_modOff (a b : Fin 4 → ℤ) :
    (ofOff a : Site n) = ofOff b ↔ modOff n a = modOff n b := by
  constructor
  · intro h
    funext i
    exact (ZMod.intCast_eq_intCast_iff' _ _ _).1 (congrFun h i)
  · intro h
    funext i
    exact (ZMod.intCast_eq_intCast_iff' _ _ _).2 (congrFun h i)

/-- **Link counts through reduction modulo `n`** (every `n`): the number of occurrences of
`(x + a, d)` among the translated links equals the number of occurrences of `(a mod n, d)` among
the reduced integer links. -/
theorem count_map_modOff (x : Site n) (L : List ((Fin 4 → ℤ) × Fin 4))
    (q : (Fin 4 → ℤ) × Fin 4) :
    @List.count (Link n) instBEqOfDecidableEq (x + ofOff q.1, q.2)
      (L.map fun p => ((x + ofOff p.1 : Site n), p.2)) =
      (L.map fun p => (modOff n p.1, p.2)).count (modOff n q.1, q.2) := by
  induction L with
  | nil => rfl
  | cons p L ih =>
      simp only [List.map_cons, List.count_cons]
      rw [ih]
      have hiff : (((x + ofOff p.1 : Site n), p.2) = (x + ofOff q.1, q.2)) ↔
          ((modOff n p.1, p.2) = (modOff n q.1, q.2)) := by
        rw [Prod.mk.injEq, Prod.mk.injEq]
        exact ⟨fun h => ⟨(ofOff_eq_iff_modOff _ _).1 (add_left_cancel h.1), h.2⟩,
          fun h => ⟨by rw [(ofOff_eq_iff_modOff p.1 q.1).2 h.1], h.2⟩⟩
      simp only [beq_iff_eq, hiff]

/-- The decidable separation condition: every link of direction `d` in `L`, translated by `B`,
differs from `a` in some coordinate by a nonzero integer of absolute value below `4`. -/
def SepOff (a B : Fin 4 → ℤ) (d : Fin 4) (L : List ((Fin 4 → ℤ) × Fin 4)) : Prop :=
  ∀ p ∈ L, p.2 = d → ∃ i, a i - B i - p.1 i ≠ 0 ∧ -4 < a i - B i - p.1 i ∧ a i - B i - p.1 i < 4

instance (a B : Fin 4 → ℤ) (d : Fin 4) (L : List ((Fin 4 → ℤ) × Fin 4)) :
    Decidable (SepOff a B d L) := by
  unfold SepOff
  infer_instance

/-- **Separated links are absent on every torus `(ℤ/nℤ)⁴`, `n ≥ 4`.** -/
theorem notMem_map_of_sep (hn : 4 ≤ n) {x : Site n} {B : Fin 4 → ℤ} (hx : x = ofOff B)
    (a : Fin 4 → ℤ) (d : Fin 4) (L : List ((Fin 4 → ℤ) × Fin 4)) (h : SepOff a B d L) :
    ((ofOff a : Site n), d) ∉ L.map fun p => ((x + ofOff p.1 : Site n), p.2) := by
  intro hmem
  obtain ⟨p, hp, heq⟩ := List.mem_map.1 hmem
  rw [Prod.mk.injEq] at heq
  obtain ⟨i, hne, hlo, hhi⟩ := h p hp heq.2
  have hi := congrFun heq.1 i
  rw [hx] at hi
  simp only [Pi.add_apply, ofOff] at hi
  rw [← Int.cast_add, ZMod.intCast_eq_intCast_iff_dvd_sub] at hi
  have hn' : (4 : ℤ) ≤ n := by exact_mod_cast hn
  have h0 := Int.eq_zero_of_abs_lt_dvd hi (by rw [abs_lt]; constructor <;> linarith)
  exact hne (by linarith)

end Offsets

section PrivateOne

/-- `2^μ`: the index of the box path with `ε = e_μ`. -/
def jOf (μ : Fin 4) : Fin 16 := ![1, 2, 4, 8] μ

theorem boxSteps_jOf : ∀ μ : Fin 4,
    boxSteps (jOf μ) μ = boxSteps 0 μ ++ (μ, true) :: (μ, false) :: [] := by
  decide

variable (M : ℕ)

/-- **The box path `ε = e_μ` has the holonomy of the straight path `ε = 0`** (every `M`, every
group): it is the straight path followed by a backtrack along `μ`. -/
theorem pathProd_boxPath_jOf {G : Type*} [Group G] (y : Site M) (μ : Fin 4)
    (U : Link (2 * M) → G) :
    pathProd (boxPath M y μ (jOf μ)) U = pathProd (boxPath M y μ 0) U := by
  simp only [boxPath, pathProd_cast]
  rw [boxSteps_jOf, pathProd_walk_backtrack, List.append_nil]

theorem box_once_one : ∀ μ : Fin 4,
    ((linksOff 0 (boxSteps 0 μ)).map fun p => (modOff 2 p.1, p.2)).count
      (modOff 2 (Pi.single μ 1), μ) = 1 := by
  decide

theorem box_out_one : ∀ μ : Fin 4, ∀ k : Fin 16, k ≠ 0 → k ≠ jOf μ →
    (modOff 2 (Pi.single μ 1), μ) ∉ (linksOff 0 (boxSteps k μ)).map fun p => (modOff 2 p.1, p.2) := by
  decide

/-- **Private links for the box blocking at `M = 1`** (fine `(ℤ/2ℤ)⁴`, one coarse site): for the
coarse link `(y, μ)` the fine link `(2y + e_μ, μ)` is traversed once by the straight path `ε = 0`,
also by the path `ε = e_μ` (same holonomy) and by no other box path. -/
theorem box_hasPrivateLink_one (e : Link 1) : HasPrivateLink (boxPathBlocking 1) e := by
  obtain ⟨y, μ⟩ := e
  classical
  refine ⟨(ιS 1 y + ofOff (Pi.single μ 1), μ), 0, {0, jOf μ}, ?_, ?_, ?_, ?_⟩
  · intro i hi U
    rcases Finset.mem_insert.1 hi with rfl | hi
    · rfl
    · rw [Finset.mem_singleton.1 hi]
      exact pathProd_boxPath_jOf 1 y μ U
  · rw [pathLinks_boxPathBlocking, count_map_modOff (ιS 1 y) _ (Pi.single μ 1, μ)]
    exact box_once_one μ
  · intro i hi
    right
    have h0 : i ≠ 0 := fun h => hi (by rw [h]; exact Finset.mem_insert_self _ _)
    have hj : i ≠ jOf μ := fun h => hi (by rw [h]; exact Finset.mem_insert_of_mem (Finset.mem_singleton_self _))
    have hc := count_map_modOff (ιS 1 y) (linksOff 0 (boxSteps i μ)) (Pi.single μ 1, μ)
    rw [List.count_eq_zero.2 (box_out_one μ i h0 hj)] at hc
    rw [pathLinks_boxPathBlocking]
    exact (@List.count_eq_zero _ instBEqOfDecidableEq _ _ _).1 hc
  · exact (Finset.sum_pos (fun _ _ => by show (0 : ℝ) < 1 / 16; norm_num)
      ⟨0, Finset.mem_insert_self _ _⟩).ne'

/-- **Every coarse link of the box blocking has a private link, for every `M ≥ 1`.** -/
theorem box_hasPrivateLink_pos (hM : 1 ≤ M) (e : Link M) :
    HasPrivateLink (boxPathBlocking M) e := by
  rcases Nat.eq_or_lt_of_le hM with h | h
  · subst h
    exact box_hasPrivateLink_one e
  · exact box_hasPrivateLink M h e

end PrivateOne


section AllM

variable (M : ℕ) [NeZero M]

/-- **The null-set hypothesis for the connected box blocking, every `M ≥ 1`.** -/
theorem hnull_box_pos :
    Measure.pi (fun _ : Link (2 * M) => haarSU2) (zeroSet (boxPathBlocking M)) = 0 :=
  hnull_of_private (boxPathBlocking M)
    (box_hasPrivateLink_pos M (Nat.one_le_iff_ne_zero.2 (NeZero.ne M)))

/-- **`hWilson` for the connected box blocking of SU(2) on `(ℤ/2Mℤ)⁴`, every `M ≥ 1`** (every real
`β` in the normalisation of Part VI's `su2Wilson`, `κ = β/2`, every `V₀`, arbitrary fine and coarse
link sets and weights; at `M = 1` the coarse torus is a single site). This is the identification
step only: no gap, split or residual bound is proved for this blocking. -/
theorem su2_inputs_box_pos (β : ℝ) (V0 : SU2) {ιx ιc : Type*} [Fintype ιx] [Fintype ιc]
    (V : ιx → Set (Link (2 * M))) (w : ιx → ℝ) (Vc : ιc → Set (Link M)) (wc : ιc → ℝ) :
    CubeSplitInputs
      (cubeGen w fun x => wilsonP (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (V x)) w
      (fun x => wilsonP (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 (V x))
      (isoProj (aeJ (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
        (avgCoarseMap (boxPathBlocking M) (plaqOf (n := 2 * M)) (β / 2) V0 (hnull_box_pos M))))
      (aeJ (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
        (avgCoarseMap (boxPathBlocking M) (plaqOf (n := 2 * M)) (β / 2) V0 (hnull_box_pos M)) :
        aeY (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
          (avgCoarseMap (boxPathBlocking M) (plaqOf (n := 2 * M)) (β / 2) V0 (hnull_box_pos M))
          →ₗ[ℝ] wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2)
      (isoAdj (aeJ (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
        (avgCoarseMap (boxPathBlocking M) (plaqOf (n := 2 * M)) (β / 2) V0 (hnull_box_pos M))) :
        wilsonH (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2 →ₗ[ℝ]
          aeY (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
            (avgCoarseMap (boxPathBlocking M) (plaqOf (n := 2 * M)) (β / 2) V0 (hnull_box_pos M)))
      (cubeGen wc fun z => lawP (aeLaw (plaqOf (n := 2 * M)) reTr (β / 2) haarSU2
        (avgCoarseMap (boxPathBlocking M) (plaqOf (n := 2 * M)) (β / 2) V0 (hnull_box_pos M)))
        (Vc z)) :=
  su2_inputs_of_paths (boxPathBlocking M) (plaqOf (n := 2 * M)) (β / 2) V0 (hnull_box_pos M)
    V w Vc wc

end AllM

theorem box_sep_plaq :
    (∀ k : Fin 16, k ≠ 0 → k ≠ 1 → SepOff (Pi.single 0 1) 0 0 (linksOff 0 (boxSteps k 0))) ∧
    (∀ k : Fin 16, SepOff (Pi.single 0 1) (Pi.single 0 2) 0 (linksOff 0 (boxSteps k 1))) ∧
