  · refine (hasDerivAt_avgVar_gibbs (F := fun _ => ![1, 0, -1]) (F' := 0) hV
      (fun s => hasDerivAt_const 0 _)).congr_deriv ?_
    simp only [avgCov, avg_gibbs_Vt_zero_g, Pi.mul_apply, Pi.pow_apply, Pi.sub_apply,
      Pi.zero_apply, lift_apply, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
