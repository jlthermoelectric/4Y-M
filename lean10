/-- `[D, P] F0 = (1/4, 0, 0)` for `κ = (1/2, −1/2, −1/2)`. -/
theorem commDP_F0_c : commDP ν₃ (kappa ν₃ νb X₃) F0 = ![1 / 4, 0, 0] := by
  rw [kappa_ex]
  funext s
  fin_cases s <;> norm_num [commDP, ip, avg, ν₃, F0, Fin.sum_univ_three, Matrix.cons_val_two,
    Matrix.tail_cons, Matrix.head_cons]

/-- **C1 on the three-point family** (`ν₃`, `νb`, `X₃` of `FiniteFibre`, §8):
`X₀ = cancelX νb` has every row `(0, −1/8, 1/8)`, `X₀ 1 = 0` and `κ(X₀) = 0`; the generator
`X₀ − L₃` (rows summing to zero, positive off-diagonal entries) also has `κ = 0`, by the
characterisation with `Y = −L₃`; `X₃` (`κ = (1/2, −1/2, −1/2) ≠ 0`) is not of the form `X₀ + Y`;
and for the `t`-independent profile `e₁ = (0, 1, 0)` along `ν_t`, the derivative of the average
is `A(−X₀ e₁) = 1/8`, while `A(−X₃ e₁) = 1/4`. -/
theorem example_c_cancel :
    cancelX νb = !![0, -1 / 8, 1 / 8; 0, -1 / 8, 1 / 8; 0, -1 / 8, 1 / 8] ∧
      cancelX νb *ᵥ lift 1 = 0 ∧ ν₃ ᵥ* cancelX νb = -νb ∧ kappa ν₃ νb (cancelX νb) = 0 ∧
      cancelX νb - L₃ = !![-1, 3 / 8, 5 / 8; 1, -17 / 8, 9 / 8; 1, 7 / 8, -15 / 8] ∧
      kappa ν₃ νb (cancelX νb - L₃) = 0 ∧
      ¬ (∃ Y : Matrix (Fin 3) (Fin 3) ℝ, X₃ = cancelX νb + Y ∧ Y *ᵥ lift 1 = 0 ∧ ν₃ ᵥ* Y = 0) ∧
      HasDerivAt (fun t => avg (νt t) e₁) (avg ν₃ (0 - cancelX νb *ᵥ e₁)) 0 ∧
      avg ν₃ (0 - cancelX νb *ᵥ e₁) = avg ν₃ 0 + ∑ s, νb s * e₁ s ∧
      avg ν₃ (0 - cancelX νb *ᵥ e₁) = 1 / 8 ∧
      avg ν₃ (0 - X₃ *ᵥ e₁) = 1 / 4 := by
  have hpos : ∀ s, ν₃ s ≠ 0 := fun s => (ν₃_pos s).ne'
  have hX0 := cancelX_mulVec_one νb_sum_c
  have hL : (cancelX νb - L₃) *ᵥ lift 1 = 0 := by
    rw [Matrix.sub_mulVec, hX0, L₃_one, sub_zero]
  have hνL : ν₃ ᵥ* (-L₃) = 0 := by
    funext r
    fin_cases r <;> norm_num [ν₃, L₃, Matrix.vecMul, dotProduct, Fin.sum_univ_three,
        Matrix.cons_val_two, Matrix.tail_cons, Matrix.head_cons]
  have hiff := kappa_eq_zero_iff_cancel hpos ν₃_sum νb_sum_c hL
  have hiff3 := kappa_eq_zero_iff_cancel hpos ν₃_sum νb_sum_c X₃_one
  have hval : avg ν₃ (0 - cancelX νb *ᵥ e₁) = 1 / 8 := by
    rw [avg_sub_cancelX_mulVec ν₃_sum]
    norm_num [avg, ν₃, νb, e₁, Fin.sum_univ_three,
        Matrix.cons_val_two, Matrix.tail_cons, Matrix.head_cons]
  refine ⟨?_, hX0, vecMul_cancelX ν₃_sum νb, kappa_cancelX ν₃_sum νb, ?_,
    hiff.2 ⟨-L₃, sub_eq_add_neg _ _, ?_, hνL⟩, ?_, ?_, avg_sub_cancelX_mulVec ν₃_sum νb e₁ 0,
    hval, ?_⟩
  · ext i j
    fin_cases i <;> fin_cases j <;> norm_num [cancelX, νb]
  · ext i j
    fin_cases i <;> fin_cases j <;> norm_num [cancelX, νb, L₃]
  · rw [Matrix.neg_mulVec, L₃_one, neg_zero]
  · intro hY
    have hk := hiff3.2 hY
    rw [kappa_ex] at hk
    have := congrFun hk 0
    norm_num at this
  · have h := hasDerivAt_avg_cancelX (ν := νt) (F := fun _ => e₁) (F' := 0) (t₀ := 0)
      (by rw [νt_zero]; exact ν₃_sum) hνt (fun s => hasDerivAt_const 0 _)
    rwa [νt_zero] at h
  · norm_num [avg, ν₃, X₃, e₁, Matrix.mulVec, dotProduct, Fin.sum_univ_three,
      Matrix.cons_val_two, Matrix.tail_cons, Matrix.head_cons]

/-- **C2 on the three-point family**: `Γ_D = !![0, 1/4, 0; −1/2, 1/4, 0; 0, 0, −1/4]` satisfies
the entrywise metric criterion and hence the metric identity; `D(F0, F1) = F1 + Γ_D F0 =
(1, −1/2, 0)`; `∂_t ‖F_t‖²_{ν_t} = 1` at `t = 0`; and the zeroth-order part
`diag(κ/2) − X₃` of the literal `H + ½ κ` fails the criterion (entry `(0, 1)`: `−1/4 ≠ 0`). -/
theorem example_c_gamma :
    metricGamma ν₃ νb X₃ = !![0, 1 / 4, 0; -1 / 2, 1 / 4, 0; 0, 0, -1 / 4] ∧
      (∀ s r, ν₃ s * metricGamma ν₃ νb X₃ s r + ν₃ r * metricGamma ν₃ νb X₃ r s =
        if s = r then νb s else 0) ∧
      (∀ u v : Fin 3 → ℝ, ip ν₃ (metricGamma ν₃ νb X₃ *ᵥ u) v +
        ip ν₃ u (metricGamma ν₃ νb X₃ *ᵥ v) = ∑ s, νb s * u s * v s) ∧
      metricDeriv ν₃ νb X₃ F0 F1 = F1 + metricGamma ν₃ νb X₃ *ᵥ F0 ∧
      metricDeriv ν₃ νb X₃ F0 F1 = ![1, -1 / 2, 0] ∧
      HasDerivAt (fun t => ip (νt t) (Ft t) (Ft t)) 1 0 ∧
      ¬ (∀ u v : Fin 3 → ℝ,
        ip ν₃ ((Matrix.diagonal ((1 / 2 : ℝ) • kappa ν₃ νb X₃) - X₃) *ᵥ u) v +
          ip ν₃ u ((Matrix.diagonal ((1 / 2 : ℝ) • kappa ν₃ νb X₃) - X₃) *ᵥ v) =
        ∑ s, νb s * u s * v s) := by
  have hpos : ∀ s, ν₃ s ≠ 0 := fun s => (ν₃_pos s).ne'
  have hΓ := metricGamma_ex_c
  have hD : metricDeriv ν₃ νb X₃ F0 F1 = F1 + metricGamma ν₃ νb X₃ *ᵥ F0 :=
    metricDeriv_eq_gamma ν₃ νb X₃ F0 F1
  refine ⟨hΓ, metricGamma_symm hpos νb X₃, metricGamma_metric hpos νb X₃, hD, metricDeriv_F0_c,
    ?_, ?_⟩
  · have hΓt : ∀ s r, νt 0 s * metricGamma ν₃ νb X₃ s r + νt 0 r * metricGamma ν₃ νb X₃ r s =
        if s = r then νb s else 0 := by
      rw [νt_zero]
      exact metricGamma_symm hpos νb X₃
    have h := hasDerivAt_ip_gamma (metricGamma ν₃ νb X₃) hΓt hνt hFt hFt
    rw [νt_zero, Ft_zero, ← hD, metricDeriv_F0_c] at h
    convert h using 1
    norm_num [ip, ν₃, F0, Fin.sum_univ_three, Matrix.cons_val_two, Matrix.tail_cons,
      Matrix.head_cons]
  · intro h
    have e := (metric_gamma_iff ν₃ νb _).1 h 0 1
    norm_num [ν₃, X₃, Matrix.diagonal_apply,
        Matrix.cons_val_two, Matrix.tail_cons, Matrix.head_cons] at e

/-- **C3 (a): the spectrum of `[D, P]`** for `κ = (1/2, −1/2, −1/2)` on `ν₃` (`‖κ‖ = 1/2`):
`[D, P] 1 = κ/2`, `[D, P] κ = 1/8 · 1`, `[D, P] κs = 0` for `κs = (0, 1, −1)` (mean zero and
orthogonal to `κ`), `[D, P](1 + 2κ) = κ/2 + 1/4 · 1`, and the eigenvectors `1 ± 2κ`, that is
`(2, 0, 0)` and `(0, 2, 2)`, with eigenvalues `±1/4 = ±‖κ‖/2`. -/
theorem example_c_commDP :
    commDP ν₃ (kappa ν₃ νb X₃) (lift 1) = ![1 / 4, -1 / 4, -1 / 4] ∧
      commDP ν₃ (kappa ν₃ νb X₃) (kappa ν₃ νb X₃) = lift (1 / 8) ∧
      commDP ν₃ (kappa ν₃ νb X₃) κs = 0 ∧
      commDP ν₃ (kappa ν₃ νb X₃) (lift 1 + (2 : ℝ) • kappa ν₃ νb X₃) =
        (1 / 2 : ℝ) • kappa ν₃ νb X₃ + lift (1 / 4) ∧
      commDP ν₃ (kappa ν₃ νb X₃) ![2, 0, 0] = (1 / 4 : ℝ) • ![2, 0, 0] ∧
      commDP ν₃ (kappa ν₃ νb X₃) ![0, 2, 2] = (-1 / 4 : ℝ) • ![0, 2, 2] := by
  have hk : 0 < Real.sqrt (nsq ν₃ (kappa ν₃ νb X₃)) := by
    rw [sqrt_nsq_kappa_c]
    norm_num
  obtain ⟨hp, hm⟩ := commDP_eigen ν₃_sum avg_kappa_ex hk
  rw [sqrt_nsq_kappa_c] at hp hm
  have vp : (lift 1 + (1 / (1 / 2) : ℝ) • kappa ν₃ νb X₃ : Fin 3 → ℝ) = ![2, 0, 0] := by
    rw [kappa_ex]
    funext s
    fin_cases s <;> norm_num
  have vm : (lift 1 - (1 / (1 / 2) : ℝ) • kappa ν₃ νb X₃ : Fin 3 → ℝ) = ![0, 2, 2] := by
    rw [kappa_ex]
    funext s
    fin_cases s <;> norm_num
  rw [vp] at hp
  rw [vm] at hm
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [commDP_lift_one ν₃_sum avg_kappa_ex, kappa_ex]
    funext s
    fin_cases s <;> norm_num
  · rw [commDP_self avg_kappa_ex, nsq_kappa_ex]
    norm_num
  · apply commDP_eq_zero_of_perp avg_κs_c
    rw [kappa_ex]
    norm_num [ip, ν₃, κs, Fin.sum_univ_three,
        Matrix.cons_val_two, Matrix.tail_cons, Matrix.head_cons]
  · rw [commDP_lift_one_add_smul ν₃_sum avg_kappa_ex, nsq_kappa_ex]
    norm_num
  · rw [hp]
    norm_num
  · rw [hm]
    norm_num

/-- **C3 (b): the correction `C_κ`** for `κ = (1/2, −1/2, −1/2)` and `F0 = (1, 0, 0)`:
`C_κ F0 = (0, 1/4, 1/4) = P [D, P] F0 − [D, P] P F0` (with `[D, P] F0 = (1/4, 0, 0)`), and
`C_κ` is `ν₃`-skew. -/
theorem example_c_corrDP :
    corrDP ν₃ (kappa ν₃ νb X₃) F0 = ![0, 1 / 4, 1 / 4] ∧
      corrDP ν₃ (kappa ν₃ νb X₃) F0 =
        proj ν₃ (commDP ν₃ (kappa ν₃ νb X₃) F0) - commDP ν₃ (kappa ν₃ νb X₃) (proj ν₃ F0) ∧
      commDP ν₃ (kappa ν₃ νb X₃) F0 = ![1 / 4, 0, 0] ∧
      (∀ u v : Fin 3 → ℝ, ip ν₃ (corrDP ν₃ (kappa ν₃ νb X₃) u) v +
        ip ν₃ u (corrDP ν₃ (kappa ν₃ νb X₃) v) = 0) :=
  ⟨corrDP_F0_c, corrDP_eq ν₃_sum avg_kappa_ex F0, commDP_F0_c,
    fun u v => ip_corrDP_add ν₃ _ u v⟩

/-- **C3 (c): the projected connection on the family of `FiniteFibre`, §8** (`ν_t`, `F_t`, `X₃`)
at `t = 0`: `∇₀(F0, F1) = (1, −1/4, 1/4)`; `∇₀(1, 0) = 0` and `∇₀(2·1, 3·1) = 3·1`; `∇₀` is
metric (pointwise, and along `F_t` against every differentiable path `G`); `[∇₀, P] F = 0`, while
`[D, P] F = (1/4, 0, 0)`; and `A(∇₀ F) = 1/2 = ∂_t (A F)`, while `A(D F) = 3/8`. -/
theorem example_c_projDeriv :
    projDeriv ν₃ νb X₃ F0 F1 = ![1, -1 / 4, 1 / 4] ∧
      projDeriv ν₃ νb X₃ (lift 1) 0 = 0 ∧
      projDeriv ν₃ νb X₃ (lift 2) (lift 3) = lift 3 ∧
      (∀ u u' v v' : Fin 3 → ℝ,
        ip ν₃ (projDeriv ν₃ νb X₃ u u') v + ip ν₃ u (projDeriv ν₃ νb X₃ v v') =
          ∑ s, νb s * u s * v s + ip ν₃ u' v + ip ν₃ u v') ∧
      (∀ (G : ℝ → Fin 3 → ℝ) (G' : Fin 3 → ℝ), (∀ s, HasDerivAt (fun t => G t s) (G' s) 0) →
        HasDerivAt (fun t => ip (νt t) (Ft t) (G t))
          (ip ν₃ (projDeriv ν₃ νb X₃ F0 F1) (G 0) + ip ν₃ F0 (projDeriv ν₃ νb X₃ (G 0) G')) 0) ∧
      projDeriv ν₃ νb X₃ (proj ν₃ F0) (lift (1 / 2)) - proj ν₃ (projDeriv ν₃ νb X₃ F0 F1) = 0 ∧
      metricDeriv ν₃ νb X₃ (proj ν₃ F0) (lift (1 / 2)) - proj ν₃ (metricDeriv ν₃ νb X₃ F0 F1) =
        ![1 / 4, 0, 0] ∧
      avg ν₃ (projDeriv ν₃ νb X₃ F0 F1) = 1 / 2 ∧
      avg ν₃ (metricDeriv ν₃ νb X₃ F0 F1) = 3 / 8 ∧
      HasDerivAt (fun t => avg (νt t) (Ft t)) (1 / 2) 0 := by
  have hpos : ∀ s, νt 0 s ≠ 0 := by rw [νt_zero]; exact fun s => (ν₃_pos s).ne'
  have hpos3 : ∀ s, ν₃ s ≠ 0 := fun s => (ν₃_pos s).ne'
  have hsum : ∑ r, (νb r * F0 r + ν₃ r * F1 r) = 1 / 2 := by
    norm_num [νb, ν₃, F0, F1, Fin.sum_univ_three, Matrix.cons_val_two, Matrix.tail_cons,
        Matrix.head_cons]
  obtain ⟨-, hone, -, havg, hder⟩ := projDeriv_spec X₃ hpos X₃_one νt_sum hνt hFt
  rw [νt_zero] at hone havg hder
  rw [Ft_zero] at havg hder
  rw [hsum] at havg
  rw [havg] at hder
  have hcomm := projDeriv_proj_sub hpos3 ν₃_sum νb_sum_c X₃_one F0 F1
  rw [hsum] at hcomm
  have havg' := avg_projDeriv hpos3 ν₃_sum νb_sum_c X₃_one F0 F1
  rw [hsum] at havg'
  obtain ⟨-, hC⟩ := commutator_DP X₃ hpos X₃_one hνt hFt
  rw [νt_zero, Ft_zero, hsum, commDP_F0_c] at hC
  refine ⟨?_, hone, projDeriv_lift hpos3 ν₃_sum νb_sum_c X₃_one 2 3, ip_projDeriv_add hpos3 νb X₃,
    fun G G' hG => ?_, hcomm, hC, havg', ?_, hder⟩
  · rw [projDeriv, metricDeriv_F0_c, corrDP_F0_c]
    funext s
    fin_cases s <;> norm_num
  · have h := hasDerivAt_ip_projDeriv X₃ hpos hνt hFt hG
    rwa [νt_zero, Ft_zero] at h
  · rw [metricDeriv_F0_c]
    norm_num [avg, ν₃, Fin.sum_univ_three, Matrix.cons_val_two, Matrix.tail_cons, Matrix.head_cons]

/-- **C2 and C3 together: `∇₀ = ∂_t + Γ₀`** on the family of `FiniteFibre`, §8 at `t = 0`:
the correction matrix is `C_κ = !![0, −1/8, −1/8; 1/4, 0, 0; 1/4, 0, 0]` (non-local),
`Γ₀ = Γ_D + C_κ = !![0, 1/8, −1/8; −1/4, 1/4, 0; 1/4, 0, −1/4]`, `Γ₀ 1 = 0`, `Γ₀` satisfies the
entrywise metric criterion and hence the metric identity, and `∇₀(F0, F1) = F1 + Γ₀ F0`. -/
theorem example_c_projGamma :
    corrMat ν₃ (kappa ν₃ νb X₃) = !![0, -1 / 8, -1 / 8; 1 / 4, 0, 0; 1 / 4, 0, 0] ∧
      metricGamma ν₃ νb X₃ + corrMat ν₃ (kappa ν₃ νb X₃) =
        !![0, 1 / 8, -1 / 8; -1 / 4, 1 / 4, 0; 1 / 4, 0, -1 / 4] ∧
      (metricGamma ν₃ νb X₃ + corrMat ν₃ (kappa ν₃ νb X₃)) *ᵥ lift 1 = 0 ∧
      (∀ s r, ν₃ s * (metricGamma ν₃ νb X₃ + corrMat ν₃ (kappa ν₃ νb X₃)) s r +
          ν₃ r * (metricGamma ν₃ νb X₃ + corrMat ν₃ (kappa ν₃ νb X₃)) r s =
        if s = r then νb s else 0) ∧
      (∀ u v : Fin 3 → ℝ,
        ip ν₃ ((metricGamma ν₃ νb X₃ + corrMat ν₃ (kappa ν₃ νb X₃)) *ᵥ u) v +
          ip ν₃ u ((metricGamma ν₃ νb X₃ + corrMat ν₃ (kappa ν₃ νb X₃)) *ᵥ v) =
        ∑ s, νb s * u s * v s) ∧
      projDeriv ν₃ νb X₃ F0 F1 = F1 + (metricGamma ν₃ νb X₃ + corrMat ν₃ (kappa ν₃ νb X₃)) *ᵥ F0 ∧
      corrDP ν₃ (kappa ν₃ νb X₃) F0 = corrMat ν₃ (kappa ν₃ νb X₃) *ᵥ F0 := by
  have hpos3 : ∀ s, ν₃ s ≠ 0 := fun s => (ν₃_pos s).ne'
  have hC : corrMat ν₃ (kappa ν₃ νb X₃) = !![0, -1 / 8, -1 / 8; 1 / 4, 0, 0; 1 / 4, 0, 0] := by
    rw [kappa_ex]
    ext i j
    fin_cases i <;> fin_cases j <;> norm_num [corrMat, Matrix.of_apply, ν₃,
        Matrix.cons_val_two, Matrix.tail_cons, Matrix.head_cons]
  have hG : metricGamma ν₃ νb X₃ + corrMat ν₃ (kappa ν₃ νb X₃) =
      !![0, 1 / 8, -1 / 8; -1 / 4, 1 / 4, 0; 1 / 4, 0, -1 / 4] := by
    rw [hC, metricGamma_ex_c]
    ext i j
    fin_cases i <;> fin_cases j <;> norm_num
  refine ⟨hC, hG, ?_, projGamma_symm hpos3 νb X₃,
    (metric_gamma_iff ν₃ νb _).2 (projGamma_symm hpos3 νb X₃), projDeriv_eq_gamma ν₃ νb X₃ F0 F1,
    corrDP_eq_mulVec ν₃ _ F0⟩
  rw [hG]
  funext s
  fin_cases s <;> norm_num [Matrix.mulVec, dotProduct, Fin.sum_univ_three,
      Matrix.cons_val_two, Matrix.tail_cons, Matrix.head_cons]

/-- **C4 on the connection of `FiniteFibre`, §8**: `X₃` has nonnegative off-diagonal entries,
`X₃ 1 = 0` and `X₃ ≠ 0`; hence `X₃ + X₃* ≠ diag(X₃* 1)` and the literal `H + ½ κ` is not metric
(`eq_zero_of_generator_metric`, `horizHalf_not_metric_of_generator`); and `X₃` is not a
derivation (`mulVec_leibniz_eq_zero`). -/
theorem example_c_generator :
    (∀ s r : Fin 3, s ≠ r → 0 ≤ X₃ s r) ∧ X₃ ≠ 0 ∧
      X₃ + adj ν₃ X₃ ≠ Matrix.diagonal (adj ν₃ X₃ *ᵥ lift 1) ∧
      ¬ (∀ u u' v v' : Fin 3 → ℝ,
          ip ν₃ (horizHalf ν₃ νb X₃ u u') v + ip ν₃ u (horizHalf ν₃ νb X₃ v v') =
            ∑ s, νb s * u s * v s + ip ν₃ u' v + ip ν₃ u v') ∧
      ¬ (∀ u v : Fin 3 → ℝ, X₃ *ᵥ (u * v) = u * X₃ *ᵥ v + v * X₃ *ᵥ u) := by
  have hoff : ∀ s r : Fin 3, s ≠ r → 0 ≤ X₃ s r := by
    intro s r hsr
    fin_cases s <;> fin_cases r <;> simp [X₃] at hsr ⊢
  have hne : X₃ ≠ 0 := by
    intro h
    have := congrFun (congrFun h 1) 0
    norm_num [X₃] at this
  exact ⟨hoff, hne, fun h => hne (eq_zero_of_generator_metric ν₃_pos X₃_one hoff h),
    horizHalf_not_metric_of_generator ν₃_pos νb X₃_one hoff hne,
    fun h => hne (mulVec_leibniz_eq_zero X₃ h)⟩

/-- The weights `(1/2, 1/2)` on a two-point fibre. -/
def ν₂_c : Fin 2 → ℝ := ![1 / 2, 1 / 2]

/-- The matrix `!![−1, 1; −1, 1]`: rows sum to zero, one negative off-diagonal entry. -/
def X₂_c : Matrix (Fin 2) (Fin 2) ℝ := !![-1, 1; -1, 1]

/-- The weights `ν₂_c` are positive. -/
theorem ν₂_c_pos : ∀ s, 0 < ν₂_c s := by
  intro s
  fin_cases s <;> norm_num [ν₂_c]

/-- **C4 (b): a literal `H + ½ κ` that is metric with `κ ≠ 0`.** On two points with weights
`(1/2, 1/2)`, `ν' = 0` and `X = !![−1, 1; −1, 1]`: `X 1 = 0`, `X* = !![−1, −1; 1, 1]`,
`X + X* = diag(−2, 2) = diag(X* 1)`, so the literal `H + ½ κ` is metric (`horizHalf_metric_iff`),
although `κ = (−2, 2) ≠ 0` (with `A κ = 0`) and `X + X* ≠ 0` (`X` is not `ν`-skew). Consistently
with `eq_zero_of_generator_metric`, `X` has a negative off-diagonal entry; and `X` is not a
derivation (`leibniz_linearMap_eq_zero`). -/
theorem example_c_literal_metric :
    X₂_c *ᵥ lift 1 = 0 ∧
      adj ν₂_c X₂_c = !![-1, -1; 1, 1] ∧
      X₂_c + adj ν₂_c X₂_c = Matrix.diagonal (adj ν₂_c X₂_c *ᵥ lift 1) ∧
      X₂_c + adj ν₂_c X₂_c = !![-2, 0; 0, 2] ∧ X₂_c + adj ν₂_c X₂_c ≠ 0 ∧
      (∀ u u' v v' : Fin 2 → ℝ,
        ip ν₂_c (horizHalf ν₂_c 0 X₂_c u u') v + ip ν₂_c u (horizHalf ν₂_c 0 X₂_c v v') =
          ip ν₂_c u' v + ip ν₂_c u v') ∧
      kappa ν₂_c 0 X₂_c = ![-2, 2] ∧ kappa ν₂_c 0 X₂_c ≠ 0 ∧
      avg ν₂_c (kappa ν₂_c 0 X₂_c) = 0 ∧ X₂_c 1 0 < 0 ∧
      ¬ (∀ u v : Fin 2 → ℝ, X₂_c *ᵥ (u * v) = u * X₂_c *ᵥ v + v * X₂_c *ᵥ u) := by
  have hadj : adj ν₂_c X₂_c = !![-1, -1; 1, 1] := by
    ext i j
    fin_cases i <;> fin_cases j <;> norm_num [adj, ν₂_c, X₂_c]
  have hsum : X₂_c + adj ν₂_c X₂_c = !![-2, 0; 0, 2] := by
    rw [hadj]
    ext i j
    fin_cases i <;> fin_cases j <;> norm_num [X₂_c]
  have hdiag : X₂_c + adj ν₂_c X₂_c = Matrix.diagonal (adj ν₂_c X₂_c *ᵥ lift 1) := by
    rw [hsum, hadj]
    ext i j
    fin_cases i <;> fin_cases j <;> norm_num [Matrix.mulVec, dotProduct, Fin.sum_univ_two]
  have hκ : kappa ν₂_c 0 X₂_c = ![-2, 2] := by
    funext r
    fin_cases r <;> norm_num [kappa, ν₂_c, X₂_c, Matrix.vecMul, dotProduct, Fin.sum_univ_two]
  have hne : X₂_c ≠ 0 := by
    intro h
    have := congrFun (congrFun h 0) 0
    norm_num [X₂_c] at this
  refine ⟨?_, hadj, hdiag, hsum, ?_, ?_, hκ, ?_, ?_, ?_, ?_⟩
  · funext s
    fin_cases s <;> norm_num [X₂_c, Matrix.mulVec, dotProduct, Fin.sum_univ_two]
  · rw [hsum]
    intro h
    have := congrFun (congrFun h 0) 0
    norm_num at this
  · intro u u' v v'
    have h := (horizHalf_metric_iff ν₂_c_pos 0 X₂_c).2 hdiag u u' v v'
    simpa using h
  · rw [hκ]
    intro h
    have := congrFun h 0
    norm_num at this
  · rw [hκ]
    norm_num [avg, ν₂_c, Fin.sum_univ_two]
  · norm_num [X₂_c]
  · intro h
    have h0 := leibniz_linearMap_eq_zero (Matrix.mulVecLin X₂_c) (fun u v => by
      simpa only [Matrix.mulVecLin_apply] using h u v)
    apply hne
    ext i j
    have e := congrFun (LinearMap.congr_fun h0 (Pi.single j 1)) i
    rw [Matrix.mulVecLin_apply, Matrix.mulVec_single_one, LinearMap.zero_apply] at e
    simpa using e

/-- The mean-zero profile `(1, 0, −2)` for the weights `ν₃`. -/
def f_c : Fin 3 → ℝ := ![1, 0, -2]

/-- **C5 on the three-point fibre**, with `κa = (1/2, −1/2, −1/2)` (the coefficient of `X₃`, `νb`),
`κb = κs = (0, 1, −1)` (the coefficient of `X = 0`, `νc`) and `f = (1, 0, −2)` (`A f = 0`,
`⟨κa, f⟩ = ⟨κb, f⟩ = 1/2`): `[D, P]_{κa} [D, P]_{κb} f = κa/8`; the curvature term
`Q [D,P]_{κa} [D,P]_{κb} f − Q [D,P]_{κb} [D,P]_{κa} f = ¼(⟨κb, f⟩ κa − ⟨κa, f⟩ κb)
= (1/16, −3/16, 1/16)`; `‖[D, P]_{κa} f‖² = ⟨κa, f⟩²/4 = 1/16`; and `[D, P]` is linear in `κ`. -/
theorem example_c_curvature :
    kappa ν₃ νc 0 = κs ∧ avg ν₃ f_c = 0 ∧ ip ν₃ (kappa ν₃ νb X₃) f_c = 1 / 2 ∧
      ip ν₃ κs f_c = 1 / 2 ∧
      commDP ν₃ (kappa ν₃ νb X₃) (commDP ν₃ κs f_c) = (1 / 8 : ℝ) • kappa ν₃ νb X₃ ∧
      fluct ν₃ (commDP ν₃ (kappa ν₃ νb X₃) (commDP ν₃ κs f_c)) -
          fluct ν₃ (commDP ν₃ κs (commDP ν₃ (kappa ν₃ νb X₃) f_c)) =
        (1 / 4 : ℝ) • (ip ν₃ κs f_c • kappa ν₃ νb X₃ - ip ν₃ (kappa ν₃ νb X₃) f_c • κs) ∧
      fluct ν₃ (commDP ν₃ (kappa ν₃ νb X₃) (commDP ν₃ κs f_c)) -
          fluct ν₃ (commDP ν₃ κs (commDP ν₃ (kappa ν₃ νb X₃) f_c)) =
        ![1 / 16, -3 / 16, 1 / 16] ∧
      nsq ν₃ (commDP ν₃ (kappa ν₃ νb X₃) f_c) = 1 / 16 ∧
      commDP ν₃ (kappa ν₃ νb X₃ + κs) f_c = commDP ν₃ (kappa ν₃ νb X₃) f_c + commDP ν₃ κs f_c ∧
      commDP ν₃ ((2 : ℝ) • κs) f_c = (2 : ℝ) • commDP ν₃ κs f_c := by
  have hf : avg ν₃ f_c = 0 := by
    norm_num [avg, ν₃, f_c, Fin.sum_univ_three, Matrix.cons_val_two, Matrix.tail_cons,
      Matrix.head_cons]
  have ha : ip ν₃ (kappa ν₃ νb X₃) f_c = 1 / 2 := by
    rw [kappa_ex]
    norm_num [ip, ν₃, f_c, Fin.sum_univ_three, Matrix.cons_val_two, Matrix.tail_cons,
      Matrix.head_cons]
  have hb : ip ν₃ κs f_c = 1 / 2 := by
    norm_num [ip, ν₃, κs, f_c, Fin.sum_univ_three, Matrix.cons_val_two, Matrix.tail_cons,
      Matrix.head_cons]
  have hcurv := fluct_commDP_comm ν₃_sum avg_kappa_ex avg_κs_c hf
  refine ⟨kappa_strict, hf, ha, hb, ?_, hcurv, ?_, ?_, commDP_add_left ν₃ _ _ f_c,
    commDP_smul_left ν₃ κs f_c 2⟩
  · rw [commDP_commDP ν₃_sum avg_kappa_ex hf, hb]
    norm_num
  · rw [hcurv, ha, hb, kappa_ex]
    funext s
    fin_cases s <;> norm_num [κs]
  · rw [nsq_commDP_of_avg_eq_zero ν₃_sum _ hf, ha]
    norm_num

end Example

/-! ## Part G: Gibbs calculus, a two-level variance bound, the Gaussian lift score -/

/-! ### G1–G2. The free energy and variance transport for Gibbs weights -/

section GibbsCalculus

variable {S : Type*} [Fintype S]

/-- The variance `Var_ν F = A (F F) − (A F)²` of a profile `F` under the weights `ν`. -/
def avgVar (ν F : S → ℝ) : ℝ := avg ν (F * F) - avg ν F ^ 2

/-- The covariance `Cov_ν (U, W) = A (U W) − A U · A W` of two profiles under the weights `ν`. -/
def avgCov (ν U W : S → ℝ) : ℝ := avg ν (U * W) - avg ν U * avg ν W

/-- `⟨Q U, W⟩_ν = Cov_ν (U, W)`, for any weights `ν` (`ip_fluct_left_eq_cov` in the notation
`avgCov`). -/
theorem ip_fluct_eq_avgCov (ν U W : S → ℝ) : ip ν (fluct ν U) W = avgCov ν U W :=
  ip_fluct_left_eq_cov ν U W

theorem avgCov_comm (ν U W : S → ℝ) : avgCov ν U W = avgCov ν W U := by
  rw [avgCov, avgCov, mul_comm U W, mul_comm (avg ν U)]

theorem avgVar_eq_avgCov (ν F : S → ℝ) : avgVar ν F = avgCov ν F F := by
  rw [avgVar, avgCov, sq]

/-- For normalised weights, `Var_ν F = ‖Q F‖²_ν`. -/
theorem avgVar_eq_nsq_fluct {ν : S → ℝ} (h1 : ∑ s, ν s = 1) (F : S → ℝ) :
    avgVar ν F = nsq ν (fluct ν F) := by
  have h := nsq_eq_sq_avg_add_nsq_fluct h1 F
  have h2 : nsq ν F = avg ν (F * F) := (avg_mul ν F F).symm
  rw [avgVar]
  linarith

/-- For nonnegative normalised weights, `Var_ν F ≥ 0`. -/
theorem avgVar_nonneg {ν : S → ℝ} (hν : ∀ s, 0 ≤ ν s) (h1 : ∑ s, ν s = 1) (F : S → ℝ) :
    0 ≤ avgVar ν F := by
  rw [avgVar_eq_nsq_fluct h1]
  exact nsq_nonneg hν _

/-- For normalised weights, `Cov_ν ((F − c)², W) = Cov_ν (F², W) − 2 c Cov_ν (F, W)` for every
constant `c`. -/
theorem avgCov_sq_sub_lift {ν : S → ℝ} (h1 : ∑ s, ν s = 1) (F W : S → ℝ) (c : ℝ) :
    avgCov ν ((F - lift c) ^ 2) W = avgCov ν (F * F) W - 2 * c * avgCov ν F W := by
  have e1 : avg ν ((F - lift c) ^ 2 * W) =
      avg ν (F * F * W) - 2 * c * avg ν (F * W) + c ^ 2 * avg ν W := by
    simp only [avg, Pi.mul_apply, Pi.pow_apply, Pi.sub_apply, lift_apply, Finset.mul_sum,
      ← Finset.sum_sub_distrib, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun s _ => by ring
  have e2 : avg ν ((F - lift c) ^ 2) =
      avg ν (F * F) - 2 * c * avg ν F + c ^ 2 * ∑ s, ν s := by
    simp only [avg, Pi.mul_apply, Pi.pow_apply, Pi.sub_apply, lift_apply, Finset.mul_sum,
      ← Finset.sum_sub_distrib, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun s _ => by ring
  simp only [avgCov]
  rw [e1, e2, h1]
  ring

/-- **The free energy (G1).** Let `S` be nonempty and let the potentials `V t` have coordinate
derivatives `V'` at `t₀`. Then `t ↦ log ∑_r exp(−V t r)` has derivative `−A V'` at `t₀`, where `A`
is the average for the Gibbs weights `ν = gibbs (V t₀)`. -/
theorem hasDerivAt_log_partition [Nonempty S] {V : ℝ → S → ℝ} {V' : S → ℝ} {t₀ : ℝ}
    (hV : ∀ s, HasDerivAt (fun t => V t s) (V' s) t₀) :
    HasDerivAt (fun t => Real.log (∑ r, Real.exp (-V t r))) (-avg (gibbs (V t₀)) V') t₀ := by
  have hZ : HasDerivAt (fun t => ∑ r, Real.exp (-V t r)) (∑ r, Real.exp (-V t₀ r) * -V' r) t₀ :=
    HasDerivAt.fun_sum fun r _ => (hV r).neg.exp
  refine (hZ.log (gibbs_Z_pos (V t₀)).ne').congr_deriv ?_
  simp only [avg, gibbs, Finset.sum_div, ← Finset.sum_neg_distrib]
  exact Finset.sum_congr rfl fun r _ => by ring

/-- **The derivative of the mean of a differentiable family (G1).** Let `S` be nonempty, let the
potentials `V t` have coordinate derivatives `V' t₀` at `t₀`, and let the family `V' t` have
coordinate derivatives `V''` at `t₀`. Then, with `ν = gibbs (V t₀)`,
`∂ₜ A_t (V' t) = A V'' − (A (V' V') − (A V')²)` at `t₀`. (With `V' t` the coordinate derivative of
`V` at every `t`, this is the second derivative of `−log Z`.) -/
theorem hasDerivAt_avg_gibbs_self [Nonempty S] {V V' : ℝ → S → ℝ} {V'' : S → ℝ} {t₀ : ℝ}
    (hV : ∀ s, HasDerivAt (fun t => V t s) (V' t₀ s) t₀)
    (hV' : ∀ s, HasDerivAt (fun t => V' t s) (V'' s) t₀) :
    HasDerivAt (fun t => avg (gibbs (V t)) (V' t))
      (avg (gibbs (V t₀)) V'' -
        (avg (gibbs (V t₀)) (V' t₀ * V' t₀) - avg (gibbs (V t₀)) (V' t₀) ^ 2)) t₀ := by
  refine (hasDerivAt_avg_gibbs hV hV').congr_deriv ?_
  rw [ip_fluct_eq_avgCov, avgCov, sq]

/-- **The free energy along a line (G1, affine case).** Let `S` be nonempty and `V t = V₀ + t U`.
For every `t`: `∂ₜ log Z_t = −A_t U`; `∂ₜ (−A_t U) = Var_t U = A_t (U U) − (A_t U)²`, the averages
being for `gibbs (V t)`; `Var_t U ≥ 0`. Consequently `t ↦ log ∑_r exp(−V t r)` is convex on `ℝ`. -/
theorem free_energy_line [Nonempty S] (V₀ U : S → ℝ) :
    (∀ t₀ : ℝ, HasDerivAt (fun t : ℝ => Real.log (∑ r, Real.exp (-(V₀ + t • U) r)))
        (-avg (gibbs (V₀ + t₀ • U)) U) t₀) ∧
      (∀ t₀ : ℝ, HasDerivAt (fun t : ℝ => -avg (gibbs (V₀ + t • U)) U)
        (avgVar (gibbs (V₀ + t₀ • U)) U) t₀) ∧
      (∀ t : ℝ, 0 ≤ avgVar (gibbs (V₀ + t • U)) U) ∧
      ConvexOn ℝ Set.univ (fun t : ℝ => Real.log (∑ r, Real.exp (-(V₀ + t • U) r))) := by
  have hl : ∀ (t₀ : ℝ) (s : S), HasDerivAt (fun t : ℝ => (V₀ + t • U) s) (U s) t₀ := by
    intro t₀ s
    have h := ((hasDerivAt_id' t₀).mul_const (U s)).const_add (V₀ s)
    simp only [one_mul] at h
    simpa only [Pi.add_apply, Pi.smul_apply, smul_eq_mul] using h
  have h1 : ∀ t₀ : ℝ, HasDerivAt (fun t : ℝ => Real.log (∑ r, Real.exp (-(V₀ + t • U) r)))
      (-avg (gibbs (V₀ + t₀ • U)) U) t₀ := fun t₀ =>
    hasDerivAt_log_partition (V := fun t : ℝ => V₀ + t • U) (hl t₀)
  have h2 : ∀ t₀ : ℝ, HasDerivAt (fun t : ℝ => -avg (gibbs (V₀ + t • U)) U)
      (avgVar (gibbs (V₀ + t₀ • U)) U) t₀ := by
    intro t₀
    have h := (hasDerivAt_avg_gibbs (V := fun t : ℝ => V₀ + t • U) (F := fun _ : ℝ => U)
      (F' := 0) (hl t₀) (fun s => hasDerivAt_const t₀ (U s))).neg
    refine h.congr_deriv ?_
    rw [ip_fluct_eq_avgCov, avgVar_eq_avgCov]
    simp only [avg, Pi.zero_apply, mul_zero, Finset.sum_const_zero]
    ring
  have h3 : ∀ t : ℝ, 0 ≤ avgVar (gibbs (V₀ + t • U)) U := fun t =>
    avgVar_nonneg (fun s => (gibbs_pos _ s).le) (gibbs_sum _) U
  refine ⟨h1, h2, h3, ?_⟩
  have hd : deriv (fun t : ℝ => Real.log (∑ r, Real.exp (-(V₀ + t • U) r))) =
      fun t : ℝ => -avg (gibbs (V₀ + t • U)) U := funext fun t => (h1 t).deriv
  refine Monotone.convexOn_univ_of_deriv (fun t => (h1 t).differentiableAt) ?_
  rw [hd]
  exact monotone_of_deriv_nonneg (fun t => (h2 t).differentiableAt)
    (fun t => by rw [(h2 t).deriv]; exact h3 t)

/-- **Variance transport (G2).** Let `S` be nonempty, let the potentials `V t` have coordinate
derivatives `V'` at `t₀` and the profiles `F t` coordinate derivatives `F'` at `t₀`. Then, with
`ν = gibbs (V t₀)`, `f = F t₀` and `m = A f`,
`∂ₜ Var_{ν_t} (F t) = 2 Cov_ν (f, F') − Cov_ν ((f − m)², V')` at `t₀`. -/
theorem hasDerivAt_avgVar_gibbs [Nonempty S] {V F : ℝ → S → ℝ} {V' F' : S → ℝ} {t₀ : ℝ}
    (hV : ∀ s, HasDerivAt (fun t => V t s) (V' s) t₀)
    (hF : ∀ s, HasDerivAt (fun t => F t s) (F' s) t₀) :
    HasDerivAt (fun t => avgVar (gibbs (V t)) (F t))
      (2 * avgCov (gibbs (V t₀)) (F t₀) F' -
        avgCov (gibbs (V t₀)) ((F t₀ - lift (avg (gibbs (V t₀)) (F t₀))) ^ 2) V') t₀ := by
  have hFF : ∀ s, HasDerivAt (fun t => (F t * F t) s) ((F' * F t₀ + F t₀ * F') s) t₀ :=
    fun s => (hF s).mul (hF s)
  have h1 := hasDerivAt_avg_gibbs hV hFF
  have h2 := (hasDerivAt_avg_gibbs hV hF).fun_pow 2
  refine (h1.sub h2).congr_deriv ?_
  have hn : ∑ s, gibbs (V t₀) s = 1 := gibbs_sum _
  have e : avg (gibbs (V t₀)) (F' * F t₀ + F t₀ * F') = 2 * avg (gibbs (V t₀)) (F t₀ * F') := by
    simp only [avg, Pi.add_apply, Pi.mul_apply, Finset.mul_sum]
    exact Finset.sum_congr rfl fun s _ => by ring
  have hp : ((2 : ℕ) : ℝ) * avg (gibbs (V t₀)) (F t₀) ^ (2 - 1) =
      2 * avg (gibbs (V t₀)) (F t₀) := by
    norm_num
  rw [avgCov_sq_sub_lift hn, ip_fluct_eq_avgCov, ip_fluct_eq_avgCov, e, hp,
    avgCov_comm _ V' (F t₀ * F t₀), avgCov_comm _ V' (F t₀)]
  simp only [avgCov]
  ring

end GibbsCalculus

/-! ### G3. A two-level variance bound -/

section TwoLevel

/-- **The largest eigenvalue bounds the quadratic form of a symmetric `2 × 2` matrix**: for all
real `a, b, d, x, y`, `a x² + 2 b x y + d y² ≤ C (x² + y²)` with
`C = (a + d + √((a − d)² + 4 b²))/2`. -/
theorem quad_form_le_top_eigenvalue (a b d x y : ℝ) :
    a * x ^ 2 + 2 * b * x * y + d * y ^ 2 ≤
      (a + d + Real.sqrt ((a - d) ^ 2 + 4 * b ^ 2)) / 2 * (x ^ 2 + y ^ 2) := by
  have hs0 : 0 ≤ Real.sqrt ((a - d) ^ 2 + 4 * b ^ 2) := Real.sqrt_nonneg _
  have hss : Real.sqrt ((a - d) ^ 2 + 4 * b ^ 2) ^ 2 = (a - d) ^ 2 + 4 * b ^ 2 :=
    Real.sq_sqrt (by positivity)
  set s := Real.sqrt ((a - d) ^ 2 + 4 * b ^ 2) with hs
  have hkey : 4 * s * ((a + d + s) / 2 * (x ^ 2 + y ^ 2) -
      (a * x ^ 2 + 2 * b * x * y + d * y ^ 2)) =
      ((d - a + s) * x - 2 * b * y) ^ 2 + ((a - d + s) * y - 2 * b * x) ^ 2 := by
    linear_combination (x ^ 2 + y ^ 2) * hss
  rcases hs0.lt_or_eq with hpos | hzero
  · have h := add_nonneg (sq_nonneg ((d - a + s) * x - 2 * b * y))
      (sq_nonneg ((a - d + s) * y - 2 * b * x))
    rw [← hkey] at h
    have h4 : (0 : ℝ) < 4 * s := by positivity
    have := (mul_nonneg_iff_of_pos_left h4).1 h
    linarith
  · have h0 : (a - d) ^ 2 + 4 * b ^ 2 = 0 := by rw [← hss, ← hzero]; norm_num
    have hb2 : b ^ 2 = 0 := by nlinarith [sq_nonneg (a - d), sq_nonneg b]
    have had2 : (a - d) ^ 2 = 0 := by nlinarith [sq_nonneg (a - d), sq_nonneg b]
    have hb : b = 0 := pow_eq_zero_iff two_ne_zero |>.1 hb2
    have had : a = d := sub_eq_zero.1 (pow_eq_zero_iff two_ne_zero |>.1 had2)
    have heq : a * x ^ 2 + 2 * b * x * y + d * y ^ 2 = (a + d + 0) / 2 * (x ^ 2 + y ^ 2) := by
      rw [hb, had]; ring
    rw [← hzero]
    exact heq.le

/-- The two-level constant `C* = (A + D + √((A − D)² + 4 B²))/2` with `A = λ⁻¹ + χ²/γ`,
`B = χ/γ`, `D = γ⁻¹`: the largest eigenvalue of the symmetric matrix `[[A, B], [B, D]]`. -/
def twoLevelConst (lam gam chi : ℝ) : ℝ :=
  ((lam⁻¹ + chi ^ 2 / gam) + gam⁻¹ +
      Real.sqrt (((lam⁻¹ + chi ^ 2 / gam) - gam⁻¹) ^ 2 + 4 * (chi / gam) ^ 2)) / 2

/-- Without coupling (`χ = 0`) the two-level constant is `max λ⁻¹ γ⁻¹`. -/
theorem twoLevelConst_zero (lam gam : ℝ) : twoLevelConst lam gam 0 = max lam⁻¹ gam⁻¹ := by
  have h : Real.sqrt (((lam⁻¹ + 0 ^ 2 / gam) - gam⁻¹) ^ 2 + 4 * (0 / gam) ^ 2) =
      |lam⁻¹ - gam⁻¹| := by
    rw [← Real.sqrt_sq_eq_abs]
    congr 1
    ring
  rw [twoLevelConst, h]
  rcases le_total lam⁻¹ gam⁻¹ with hl | hl
  · rw [max_eq_right hl, abs_of_nonpos (sub_nonpos.2 hl)]
    ring
  · rw [max_eq_left hl, abs_of_nonneg (sub_nonneg.2 hl)]
    ring

/-- **The two-level variance bound, scalar form (G3a).** Let `γ > 0`, `V, H ≥ 0`, and suppose
`Var ≤ λ⁻¹ V + γ⁻¹ E_B` and `√E_B ≤ √H + χ √V`. Then `Var ≤ C* (V + H)` with
`C* = twoLevelConst λ γ χ`. (No sign condition on `λ`, `χ` or `E_B` is needed.) -/
theorem two_level_bound {lam gam chi V H EB Var : ℝ} (hgam : 0 < gam) (hV : 0 ≤ V) (hH : 0 ≤ H)
    (hVar : Var ≤ lam⁻¹ * V + gam⁻¹ * EB)
    (hcomp : Real.sqrt EB ≤ Real.sqrt H + chi * Real.sqrt V) :
    Var ≤ twoLevelConst lam gam chi * (V + H) := by
  have hg : 0 ≤ gam⁻¹ := inv_nonneg.2 hgam.le
  have hEB : EB ≤ (Real.sqrt H + chi * Real.sqrt V) ^ 2 := by
    rcases le_or_gt 0 EB with h0 | h0
    · calc EB = Real.sqrt EB ^ 2 := (Real.sq_sqrt h0).symm
        _ ≤ (Real.sqrt H + chi * Real.sqrt V) ^ 2 :=
          pow_le_pow_left₀ (Real.sqrt_nonneg EB) hcomp 2
    · exact h0.le.trans (sq_nonneg _)
  have hq := quad_form_le_top_eigenvalue (lam⁻¹ + chi ^ 2 / gam) (chi / gam) gam⁻¹
    (Real.sqrt V) (Real.sqrt H)
  rw [Real.sq_sqrt hV, Real.sq_sqrt hH] at hq
  calc Var ≤ lam⁻¹ * V + gam⁻¹ * EB := hVar
    _ ≤ lam⁻¹ * V + gam⁻¹ * (Real.sqrt H + chi * Real.sqrt V) ^ 2 := by
        have := mul_le_mul_of_nonneg_left hEB hg
        linarith
    _ = (lam⁻¹ + chi ^ 2 / gam) * V + 2 * (chi / gam) * Real.sqrt V * Real.sqrt H +
          gam⁻¹ * H := by
        rw [add_sq, mul_pow, Real.sq_sqrt hV, Real.sq_sqrt hH]
        ring
    _ ≤ twoLevelConst lam gam chi * (V + H) := hq

end TwoLevel

section TwoLevelFibres

variable {E Y : Type*} [Fintype E] [Fintype Y] [DecidableEq Y]

omit [Fintype Y] in
theorem fibreMass_nonneg {μ : E → ℝ} (hμ : ∀ p, 0 ≤ μ p) (π : E → Y) (y : Y) :
    0 ≤ fibreMass μ π y :=
  Finset.sum_nonneg fun p _ => hμ p

omit [Fintype Y] in
theorem fibreVar_nonneg {μ : E → ℝ} (hμ : ∀ p, 0 ≤ μ p) (π : E → Y) (F : E → ℝ) (y : Y) :
    0 ≤ fibreVar μ π F y :=
  Finset.sum_nonneg fun p _ =>
    mul_nonneg (div_nonneg (hμ p) (fibreMass_nonneg hμ π y)) (sq_nonneg _)

/-- **The two-level variance bound on a finite total space (G3b).** Let `μ > 0` on a finite total
space `E` with fibre map `π : E → Y`, let `F : E → ℝ`, `m ∈ ℝ`, `λ > 0`, `γ > 0`, `H ≥ 0`, and
assume
* the fibre Poincaré bounds `Var_y F ≤ λ⁻¹ E_y` for every `y`,
* the base bound `∑_y μ_y (A_y F − m)² ≤ γ⁻¹ E_B`,
* the comparison `√E_B ≤ √H + χ √(∑_y μ_y E_y)`.
Then `∑_p μ p (F p − m)² ≤ C* (∑_y μ_y E_y + H)` with `C* = twoLevelConst λ γ χ`. The comparison
inequality is an assumption here, not derived; `μ` need not be normalised. -/
theorem two_level_variance_bound {μ : E → ℝ} (hμ : ∀ p, 0 < μ p) (π : E → Y) (F : E → ℝ)
    (m : ℝ) (Ey : Y → ℝ) {lam gam chi H EB : ℝ} (hlam : 0 < lam) (hgam : 0 < gam) (hH : 0 ≤ H)
    (hfib : ∀ y, fibreVar μ π F y ≤ lam⁻¹ * Ey y)
    (hbase : ∑ y, fibreMass μ π y * (fibreAvg μ π F y - m) ^ 2 ≤ gam⁻¹ * EB)
    (hcomp : Real.sqrt EB ≤ Real.sqrt H + chi * Real.sqrt (∑ y, fibreMass μ π y * Ey y)) :
    ∑ p, μ p * (F p - m) ^ 2 ≤
      twoLevelConst lam gam chi * (∑ y, fibreMass μ π y * Ey y + H) := by
  have hm : ∀ y, 0 ≤ fibreMass μ π y := fibreMass_nonneg (fun p => (hμ p).le) π
  have hE : ∀ y, 0 ≤ Ey y := by
    intro y
    have h3 : 0 ≤ lam⁻¹ * Ey y := (fibreVar_nonneg (fun p => (hμ p).le) π F y).trans (hfib y)
    exact (mul_nonneg_iff_of_pos_left (inv_pos.2 hlam)).1 h3
  have hV : 0 ≤ ∑ y, fibreMass μ π y * Ey y :=
    Finset.sum_nonneg fun y _ => mul_nonneg (hm y) (hE y)
  have hfibsum : ∑ y, fibreMass μ π y * fibreVar μ π F y ≤
      lam⁻¹ * ∑ y, fibreMass μ π y * Ey y := by
    rw [Finset.mul_sum]
    exact Finset.sum_le_sum fun y _ => by
      calc fibreMass μ π y * fibreVar μ π F y ≤ fibreMass μ π y * (lam⁻¹ * Ey y) :=
            mul_le_mul_of_nonneg_left (hfib y) (hm y)
        _ = lam⁻¹ * (fibreMass μ π y * Ey y) := by ring
  have hVar : ∑ p, μ p * (F p - m) ^ 2 ≤ lam⁻¹ * (∑ y, fibreMass μ π y * Ey y) + gam⁻¹ * EB := by
    rw [total_variance hμ π F m]
    linarith
  exact two_level_bound hgam hV hH hVar hcomp

end TwoLevelFibres

/-! ### G4. The lift score is a logarithmic derivative -/

section LiftScore

variable {n m d : Type*} [Fintype n] [Fintype m] [Fintype d] [DecidableEq n] [DecidableEq m]

/-- The fibre displacement `ψ(y) = (J − J_*) y + N z` of the lifted field `J y + N z` from the
conditional-mean lift `J_* y`, at a fixed fibre coordinate `z`. -/
def liftResidual (K : Matrix n n ℝ) (A : Matrix m n ℝ) (J : Matrix n m ℝ) (N : Matrix n d ℝ)
    (z : d → ℝ) (y : m → ℝ) : n → ℝ :=
  (J - condMeanLift K A) *ᵥ y + N *ᵥ z

/-- The exponent `ℓ(y) = −½ ψ(y)·K ψ(y)`. (For a Gaussian with precision `K`, this is the log of the
conditional density of the fine field at `J y + N z` given `A φ = y`, up to a `y`-independent
constant; that identification is not formalised here.) -/
def liftLogWeight (K : Matrix n n ℝ) (A : Matrix m n ℝ) (J : Matrix n m ℝ) (N : Matrix n d ℝ)
    (z : d → ℝ) (y : m → ℝ) : ℝ :=
  -(liftResidual K A J N z y ⬝ᵥ (K *ᵥ liftResidual K A J N z y)) / 2

variable {K : Matrix n n ℝ} {A : Matrix m n ℝ}

/-- **The lift score is a logarithmic derivative (G4).** Let `K` be symmetric and invertible,
`G = A K⁻¹ Aᵀ` invertible, `A J = 1` and `A N = 0`. For every fibre coordinate `z`, base point `y`
and direction `η`, the derivative of `t ↦ ℓ(y + t η)` at `t = 0` is
`κ_J(y, J y + N z) = −(K J η)·(J y + N z − J_* y)`. The key step is `A ψ = 0`, so that
`(K J_* η)·ψ = 0`. Finite-dimensional algebra only; no measure is constructed. -/
theorem hasDerivAt_liftLogWeight (hK : IsUnit K.det) (hKs : Kᵀ = K)
    (hG : IsUnit (A * K⁻¹ * Aᵀ).det) {J : Matrix n m ℝ} (hJ : A * J = 1) {N : Matrix n d ℝ}
    (hN : A * N = 0) (z : d → ℝ) (y η : m → ℝ) :
    HasDerivAt (fun t : ℝ => liftLogWeight K A J N z (y + t • η))
      (kappaJ K A J η y (J *ᵥ y + N *ᵥ z)) 0 := by
  set ψ := liftResidual K A J N z y with hψ
  set w := (J - condMeanLift K A) *ᵥ η with hw
  have hres : ∀ t : ℝ, liftResidual K A J N z (y + t • η) = ψ + t • w := by
    intro t
    simp only [hψ, hw, liftResidual, Matrix.mulVec_add, Matrix.mulVec_smul]
    abel
  have hsym : w ⬝ᵥ (K *ᵥ ψ) = (K *ᵥ w) ⬝ᵥ ψ := by
    rw [Matrix.dotProduct_mulVec, ← Matrix.mulVec_transpose, hKs]
  have hsym' : ψ ⬝ᵥ (K *ᵥ w) = (K *ᵥ w) ⬝ᵥ ψ := dotProduct_comm _ _
  have hexp : (fun t : ℝ => liftLogWeight K A J N z (y + t • η)) = fun t : ℝ =>
      -(ψ ⬝ᵥ (K *ᵥ ψ)) / 2 + t * (-((K *ᵥ w) ⬝ᵥ ψ)) + t ^ 2 * (-(w ⬝ᵥ (K *ᵥ w)) / 2) := by
    funext t
    simp only [liftLogWeight, hres, Matrix.mulVec_add, Matrix.mulVec_smul, dotProduct_add,
      add_dotProduct, dotProduct_smul, smul_dotProduct, smul_eq_mul, hsym, hsym']
    ring
  have hψA : A *ᵥ ψ = 0 := by
    simp only [hψ, liftResidual, Matrix.mulVec_add, Matrix.mulVec_mulVec, Matrix.mul_sub, hJ,
      mul_condMeanLift hG, sub_self, hN, Matrix.zero_mulVec, add_zero]
  have hφ : J *ᵥ y + N *ᵥ z - condMeanLift K A *ᵥ y = ψ := by
    rw [hψ, liftResidual, Matrix.sub_mulVec]
    abel
  have hval : kappaJ K A J η y (J *ᵥ y + N *ᵥ z) = -((K *ᵥ w) ⬝ᵥ ψ) := by
    rw [kappaJ, hφ, hw, Matrix.sub_mulVec, Matrix.mulVec_sub, sub_dotProduct,
      condMeanLift_orth hK η hψA, sub_zero]
  rw [hexp, hval]
  exact ((((hasDerivAt_id' (0 : ℝ)).mul_const (-((K *ᵥ w) ⬝ᵥ ψ))).const_add
    (-(ψ ⬝ᵥ (K *ᵥ ψ)) / 2)).add ((hasDerivAt_pow 2 (0 : ℝ)).mul_const
      (-(w ⬝ᵥ (K *ᵥ w)) / 2))).congr_deriv (by simp)

end LiftScore

/-! ### G5. The linear-sector response -/

section LinearResponse

variable {d : Type*} [Fintype d] [DecidableEq d]

/-- The response vector `b = B⁻¹ R⁻¹ a`. -/
def responseVec (R B : Matrix d d ℝ) (a : d → ℝ) : d → ℝ := B⁻¹ *ᵥ (R⁻¹ *ᵥ a)

/-- The linear-sector coefficient `χ_OU = a·R⁻¹ B⁻¹ R⁻¹ a`. -/
def chiOU (R B : Matrix d d ℝ) (a : d → ℝ) : ℝ := a ⬝ᵥ ((R⁻¹ * B⁻¹ * R⁻¹) *ᵥ a)

/-- **The linear-sector response (G5).** Let `R` be symmetric and invertible, `B` symmetric
positive definite, `a` a vector, and `b = B⁻¹ R⁻¹ a`. Then `R B b = a`;
`χ_OU = a·R⁻¹ B⁻¹ R⁻¹ a = b·B b`; `(a·R⁻¹ c)² ≤ χ_OU (c·B c)` for every `c`; and equality holds at
`c = b`. This is the restriction to linear test functions of a Gaussian (covariance `R⁻¹`) response
bound; nothing about a measure is formalised. -/
theorem linear_response {R B : Matrix d d ℝ} (hRs : Rᵀ = R) (hR : IsUnit R.det) (hBs : Bᵀ = B)
    (hBpos : ∀ x : d → ℝ, x ≠ 0 → 0 < x ⬝ᵥ (B *ᵥ x)) (a : d → ℝ) :
    R *ᵥ (B *ᵥ responseVec R B a) = a ∧
      chiOU R B a = responseVec R B a ⬝ᵥ (B *ᵥ responseVec R B a) ∧
      (∀ c : d → ℝ, (a ⬝ᵥ (R⁻¹ *ᵥ c)) ^ 2 ≤ chiOU R B a * (c ⬝ᵥ (B *ᵥ c))) ∧
      (a ⬝ᵥ (R⁻¹ *ᵥ responseVec R B a)) ^ 2 =
        chiOU R B a * (responseVec R B a ⬝ᵥ (B *ᵥ responseVec R B a)) := by
  have hB : IsUnit B.det := isUnit_det_of_posDef hBpos
  have hBpsd : ∀ x : d → ℝ, 0 ≤ x ⬝ᵥ (B *ᵥ x) := fun x => by
    by_cases hx : x = 0
    · rw [hx, Matrix.mulVec_zero, dotProduct_zero]
    · exact (hBpos x hx).le
  have hRi : (R⁻¹)ᵀ = R⁻¹ := by rw [Matrix.transpose_nonsing_inv, hRs]
  have hBb : B *ᵥ responseVec R B a = R⁻¹ *ᵥ a := by
    rw [responseVec, Matrix.mulVec_mulVec, Matrix.mul_nonsing_inv _ hB, Matrix.one_mulVec]
  have hlin : ∀ c, a ⬝ᵥ (R⁻¹ *ᵥ c) = responseVec R B a ⬝ᵥ (B *ᵥ c) := by
    intro c
    rw [← mulVec_dotProduct_symm hRi, ← hBb]
    exact mulVec_dotProduct_symm hBs _ _
  have hchi : chiOU R B a = responseVec R B a ⬝ᵥ (B *ᵥ responseVec R B a) := by
    rw [← hlin, chiOU, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, responseVec]
  refine ⟨?_, hchi, fun c => ?_, ?_⟩
  · rw [hBb, Matrix.mulVec_mulVec, Matrix.mul_nonsing_inv _ hR, Matrix.one_mulVec]
  · rw [hlin c, hchi]
    exact kForm_cauchySchwarz hBs hBpsd _ c
  · rw [hlin, hchi]
    ring

end LinearResponse

