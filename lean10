/-! #### G1–G2 on the potentials `V_t = (t, 1, 2 − t)` (`Vt`), with `q = exp(−1)` -/

/-- Gibbs averages at `t = 0`: `A G = (G 0 + q G 1 + q² G 2)/(1 + q + q²)`, `q = exp(−1)`. -/
theorem avg_gibbs_Vt_zero_g (G : Fin 3 → ℝ) :
    avg (gibbs (Vt 0)) G = (G 0 + Real.exp (-1) * G 1 + Real.exp (-1) ^ 2 * G 2) /
      (1 + Real.exp (-1) + Real.exp (-1) ^ 2) := by
  have h2 : Real.exp (-2) = Real.exp (-1) ^ 2 := by
    rw [← Real.exp_nat_mul]
    norm_num
  have hV : Vt 0 = ![0, 1, 2] := by simp [Vt]
  have hZ : (1 + Real.exp (-1) + Real.exp (-1) ^ 2) ≠ 0 := by positivity
  rw [hV]
  simp only [avg, gibbs, Fin.sum_univ_three, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons, neg_zero, Real.exp_zero, h2]
  field_simp

/-- The profiles `F_t = (t, 1, 0)`. -/
def Ft_g (t : ℝ) : Fin 3 → ℝ := ![0, 1, 0] + t • ![1, 0, 0]

/-- **Witness for G1 and G2** on `V_t = (t, 1, 2 − t)`, with `q = exp(−1)` and
`Z = 1 + q + q²`: `∂ₜ log Z_t = (q² − 1)/Z` at `t = 0`; `∂ₜ A_t (1, 0, −1) = −q (1 + 4q + q²)/Z²`
at `t = 0`; `Var_0 (1, 0, −1) ≥ 0` and `log Z_t` is convex in `t`; `∂ₜ Var_t (1, 0, −1) =
q (1 − q²)(1 + 7q + q²)/Z³` and `∂ₜ Var_t F_t = −q (1 + 3q + 2q² − q³ + q⁴)/Z³` at `t = 0`. -/
theorem example_g_free_energy :
    HasDerivAt (fun t => Real.log (∑ r, Real.exp (-Vt t r)))
        ((Real.exp (-1) ^ 2 - 1) / (1 + Real.exp (-1) + Real.exp (-1) ^ 2)) 0 ∧
      HasDerivAt (fun t => avg (gibbs (Vt t)) ![1, 0, -1])
        (-(Real.exp (-1) * (1 + 4 * Real.exp (-1) + Real.exp (-1) ^ 2) /
          (1 + Real.exp (-1) + Real.exp (-1) ^ 2) ^ 2)) 0 ∧
      0 ≤ avgVar (gibbs (Vt 0)) ![1, 0, -1] ∧
      ConvexOn ℝ Set.univ (fun t => Real.log (∑ r, Real.exp (-Vt t r))) ∧
      HasDerivAt (fun t => avgVar (gibbs (Vt t)) ![1, 0, -1])
        (Real.exp (-1) * (1 - Real.exp (-1) ^ 2) * (1 + 7 * Real.exp (-1) + Real.exp (-1) ^ 2) /
          (1 + Real.exp (-1) + Real.exp (-1) ^ 2) ^ 3) 0 ∧
