/-! #### G3 with `λ = 2/3`, `γ = 1`, `χ = 1`: `A = 5/2`, `B = D = 1`, `C* = 3` -/

theorem twoLevelConst_g : twoLevelConst (2 / 3) 1 1 = 3 := by
  have h : Real.sqrt (((2 / 3 : ℝ)⁻¹ + 1 ^ 2 / 1 - 1⁻¹) ^ 2 + 4 * (1 / 1) ^ 2) = 5 / 2 := by
    rw [show ((2 / 3 : ℝ)⁻¹ + 1 ^ 2 / 1 - 1⁻¹) ^ 2 + 4 * (1 / 1) ^ 2 = (5 / 2) ^ 2 by norm_num]
    exact Real.sqrt_sq (by norm_num)
  rw [twoLevelConst, h]
  norm_num

/-- **Witness for G3a**: `C*(2/3, 1, 1) = 3`, `C*(2, 1/3, 0) = max (1/2) 3 = 3`, and the bound is
attained: with `V = 4`, `H = 1`, `E_B = 9` (so `√E_B = 3 = √H + χ √V`) and
`Var = λ⁻¹ V + γ⁻¹ E_B = 15`, the theorem gives `15 ≤ C* (V + H) = 15`. -/
theorem example_g_two_level :
    twoLevelConst (2 / 3) 1 1 = 3 ∧ twoLevelConst 2 (1 / 3) 0 = 3 ∧
      (15 : ℝ) ≤ twoLevelConst (2 / 3) 1 1 * (4 + 1) ∧
      twoLevelConst (2 / 3) 1 1 * (4 + 1) = 15 := by
  have hcomp : Real.sqrt 9 ≤ Real.sqrt 1 + 1 * Real.sqrt 4 := by
    rw [show (9 : ℝ) = 3 ^ 2 by norm_num, show (4 : ℝ) = 2 ^ 2 by norm_num,
      Real.sqrt_sq (show (0 : ℝ) ≤ 3 by norm_num), Real.sqrt_sq (show (0 : ℝ) ≤ 2 by norm_num),
      Real.sqrt_one]
    norm_num
  refine ⟨twoLevelConst_g, ?_, two_level_bound (lam := 2 / 3) (gam := 1) (chi := 1) (EB := 9)
    (by norm_num) (by norm_num) (by norm_num) (by norm_num) hcomp, ?_⟩
  · rw [twoLevelConst_zero, max_eq_right (by norm_num)]
    norm_num
  · rw [twoLevelConst_g]
    norm_num

/-- The profile `F = (0, 4, 1, 3)` on the four-point total space of `μ₄`, `π₄`. -/
def F_g : Fin 4 → ℝ := ![0, 4, 1, 3]

/-- Fibre energies `E_0 = 2`, `E_1 = 2/3` on the two-point base. -/
def E_g : Fin 2 → ℝ := ![2, 2 / 3]

theorem μ₄_pos_g : ∀ p, 0 < μ₄ p := fun p => by fin_cases p <;> simp [μ₄]

/-- **Witness for G3b** on the four-point example (`μ₄ = (1/8, 3/8, 1/4, 1/4)`, fibres `{0, 1}`,
`{2, 3}`), `F = (0, 4, 1, 3)`, `m = 5/2`, `λ = 2/3`, `γ = 1`, `χ = 1`, `H = 0`, `E_B = 1/4`,
`E = (2, 2/3)`: the fibre variances are `3` and `1` (`≤ (3/2) E_y`, with equality), the base sum is
`1/4`, `∑_y μ_y E_y = 4/3`, and the total variance `9/4` is at most `C* (4/3 + 0) = 4`. -/
theorem example_g_two_level_fibres :
    ∑ p, μ₄ p * (F_g p - 5 / 2) ^ 2 = 9 / 4 ∧
      fibreVar μ₄ π₄ F_g 0 = 3 ∧ fibreVar μ₄ π₄ F_g 1 = 1 ∧
      (∀ y, fibreVar μ₄ π₄ F_g y ≤ (2 / 3)⁻¹ * E_g y) ∧
      ∑ y, fibreMass μ₄ π₄ y * (fibreAvg μ₄ π₄ F_g y - 5 / 2) ^ 2 = 1 / 4 ∧
      ∑ y, fibreMass μ₄ π₄ y * E_g y = 4 / 3 ∧
      ∑ p, μ₄ p * (F_g p - 5 / 2) ^ 2 ≤
        twoLevelConst (2 / 3) 1 1 * (∑ y, fibreMass μ₄ π₄ y * E_g y + 0) ∧
      twoLevelConst (2 / 3) 1 1 * (∑ y, fibreMass μ₄ π₄ y * E_g y + 0) = 4 := by
  have hm0 : fibreMass μ₄ π₄ 0 = 1 / 2 := by
    rw [fibreMass, Finset.sum_filter, Fin.sum_univ_four]
    simp [μ₄, π₄]
    norm_num
  have hm1 : fibreMass μ₄ π₄ 1 = 1 / 2 := by
    rw [fibreMass, Finset.sum_filter, Fin.sum_univ_four]
    simp [μ₄, π₄]
    norm_num
  have ha0 : fibreAvg μ₄ π₄ F_g 0 = 3 := by
    rw [fibreAvg, hm0, Finset.sum_filter, Fin.sum_univ_four]
    simp [μ₄, π₄, F_g]
    norm_num
  have ha1 : fibreAvg μ₄ π₄ F_g 1 = 2 := by
    rw [fibreAvg, hm1, Finset.sum_filter, Fin.sum_univ_four]
    simp [μ₄, π₄, F_g]
    norm_num
  have hv0 : fibreVar μ₄ π₄ F_g 0 = 3 := by
    rw [fibreVar, hm0, ha0, Finset.sum_filter, Fin.sum_univ_four]
    simp [μ₄, π₄, F_g]
    norm_num
  have hv1 : fibreVar μ₄ π₄ F_g 1 = 1 := by
    rw [fibreVar, hm1, ha1, Finset.sum_filter, Fin.sum_univ_four]
    simp [μ₄, π₄, F_g]
    norm_num
  have htot : ∑ p, μ₄ p * (F_g p - 5 / 2) ^ 2 = 9 / 4 := by
    rw [Fin.sum_univ_four]
    simp [μ₄, F_g]
    norm_num
  have hfib : ∀ y, fibreVar μ₄ π₄ F_g y ≤ (2 / 3)⁻¹ * E_g y := by
    rw [Fin.forall_fin_two, hv0, hv1]
    norm_num [E_g]
  have hbase : ∑ y, fibreMass μ₄ π₄ y * (fibreAvg μ₄ π₄ F_g y - 5 / 2) ^ 2 = 1 / 4 := by
    rw [Fin.sum_univ_two, hm0, hm1, ha0, ha1]
    norm_num
  have hV : ∑ y, fibreMass μ₄ π₄ y * E_g y = 4 / 3 := by
    rw [Fin.sum_univ_two, hm0, hm1]
    norm_num [E_g]
  have hcomp : Real.sqrt (1 / 4) ≤
      Real.sqrt 0 + 1 * Real.sqrt (∑ y, fibreMass μ₄ π₄ y * E_g y) := by
    rw [hV, Real.sqrt_zero, zero_add, one_mul]
    exact Real.sqrt_le_sqrt (by norm_num)
  refine ⟨htot, hv0, hv1, hfib, hbase, hV,
    two_level_variance_bound μ₄_pos_g π₄ F_g (5 / 2) E_g (lam := 2 / 3) (gam := 1) (chi := 1)
      (H := 0) (EB := 1 / 4) (by norm_num) (by norm_num) le_rfl hfib (by rw [hbase]; norm_num)
      hcomp, ?_⟩
  rw [twoLevelConst_g, hV]
  norm_num

/-! #### G4 on the two-site Gaussian `K₂`, `A₂`, `J₂` with `N = (1, −1)ᵀ` -/

/-- The fibre direction `N = (1, −1)ᵀ` of `A₂`. -/
def N_g : Matrix (Fin 2) (Fin 1) ℝ := !![1; -1]

theorem A₂_N_g : A₂ * N_g = 0 := by
  ext i j
  fin_cases i
  fin_cases j
  simp [A₂, N_g, Matrix.mul_apply, Fin.sum_univ_two]

theorem kappaJ_N_g (y z η : Fin 1 → ℝ) :
    kappaJ K₂ A₂ J₂ η y (J₂ *ᵥ y + N_g *ᵥ z) = η 0 * (z 0 - y 0 / 3) := by
  rw [kappaJ, condMeanLift₂]
  simp [K₂, J₂, N_g, Matrix.mulVec, dotProduct, Fin.sum_univ_two, Matrix.diagonal]
  ring

theorem liftLogWeight_g (y z : Fin 1 → ℝ) :
    liftLogWeight K₂ A₂ J₂ N_g z y = -(3 / 2) * (z 0 - y 0 / 3) ^ 2 := by
  rw [liftLogWeight, liftResidual, condMeanLift₂]
  simp [K₂, J₂, N_g, Matrix.mulVec, dotProduct, Fin.sum_univ_two, Matrix.diagonal]
  ring

/-- **Witness for G4**: with `K₂ = diag(1, 2)`, `A₂ = (1/2, 1/2)`, `J₂ = (1, 1)ᵀ`, `N = (1, −1)ᵀ`:
`A₂ N = 0`; `ℓ(y) = −(3/2)(z − y/3)²`; for all `y, z, η` the derivative of `t ↦ ℓ(y + t η)` at
`0` is `κ_{J₂}(y, J₂ y + N z) = η (z − y/3)`; at `y = 0`, `z = η = 1` the field is `(1, −1)` and the
derivative is `1`. -/
theorem example_g_lift_score :
    A₂ * N_g = 0 ∧
      (∀ y z η : Fin 1 → ℝ, HasDerivAt (fun t : ℝ => liftLogWeight K₂ A₂ J₂ N_g z (y + t • η))
        (kappaJ K₂ A₂ J₂ η y (J₂ *ᵥ y + N_g *ᵥ z)) 0) ∧
      (∀ y z η : Fin 1 → ℝ, kappaJ K₂ A₂ J₂ η y (J₂ *ᵥ y + N_g *ᵥ z) = η 0 * (z 0 - y 0 / 3)) ∧
      (∀ y z : Fin 1 → ℝ, liftLogWeight K₂ A₂ J₂ N_g z y = -(3 / 2) * (z 0 - y 0 / 3) ^ 2) ∧
      J₂ *ᵥ 0 + N_g *ᵥ ![1] = ![1, -1] ∧
      HasDerivAt (fun t : ℝ => liftLogWeight K₂ A₂ J₂ N_g ![1] (0 + t • (![1] : Fin 1 → ℝ)))
        1 0 := by
  have hd : ∀ y z η : Fin 1 → ℝ,
      HasDerivAt (fun t : ℝ => liftLogWeight K₂ A₂ J₂ N_g z (y + t • η))
      (kappaJ K₂ A₂ J₂ η y (J₂ *ᵥ y + N_g *ᵥ z)) 0 := fun y z η =>
    hasDerivAt_liftLogWeight K₂_det K₂_symm G₂_det A₂_J₂ A₂_N_g z y η
  refine ⟨A₂_N_g, hd, kappaJ_N_g, liftLogWeight_g, ?_, ?_⟩
  · ext i
    fin_cases i <;> simp [J₂, N_g]
  · have h := hd 0 ![1] ![1]
    rw [kappaJ_N_g] at h
    simpa using h

/-! #### G5 with `R = K₂ = diag(1, 2)`, `B = [[2, 1], [1, 1]]`, `a = (1, 2)` -/

/-- The symmetric positive definite matrix `B = [[2, 1], [1, 1]]`; it does not commute with
`K₂`. -/
def B_g : Matrix (Fin 2) (Fin 2) ℝ := !![2, 1; 1, 1]

/-- The source vector `a = (1, 2)`. -/
def a_g : Fin 2 → ℝ := ![1, 2]

theorem B_g_inv : B_g⁻¹ = !![1, -1; -1, 2] := by
  apply Matrix.inv_eq_left_inv
  ext i j
  fin_cases i <;> fin_cases j <;> simp [B_g, Matrix.mul_apply, Fin.sum_univ_two] <;> norm_num

theorem B_g_symm : B_gᵀ = B_g := by
  ext i j
  fin_cases i <;> fin_cases j <;> rfl

theorem B_g_quad (x : Fin 2 → ℝ) : x ⬝ᵥ (B_g *ᵥ x) = x 0 ^ 2 + (x 0 + x 1) ^ 2 := by
  simp [B_g, dotProduct, Matrix.mulVec, Fin.sum_univ_two]
  ring

theorem B_g_pos : ∀ x : Fin 2 → ℝ, x ≠ 0 → 0 < x ⬝ᵥ (B_g *ᵥ x) := by
  intro x hx
  rw [B_g_quad]
  by_contra hle'
  have hle := not_lt.1 hle'
  have h0 : x 0 ^ 2 = 0 := by nlinarith [sq_nonneg (x 0), sq_nonneg (x 0 + x 1)]
  have h1 : (x 0 + x 1) ^ 2 = 0 := by nlinarith [sq_nonneg (x 0), sq_nonneg (x 0 + x 1)]
  have hx0 : x 0 = 0 := pow_eq_zero_iff two_ne_zero |>.1 h0
  have hx1 : x 1 = 0 := by
    have h01 := pow_eq_zero_iff two_ne_zero |>.1 h1
    linarith
  apply hx
  funext i
  fin_cases i <;> simp [hx0, hx1]

theorem responseVec_g : responseVec K₂ B_g a_g = ![0, 1] := by
  rw [responseVec, B_g_inv, K₂_inv]
  ext i
  fin_cases i <;> simp [a_g, Matrix.mulVec, dotProduct, Fin.sum_univ_two, Matrix.diagonal]
  norm_num

/-- **Witness for G5** with `R = K₂ = diag(1, 2)`, `B = [[2, 1], [1, 1]]`, `a = (1, 2)`:
`b = B⁻¹ R⁻¹ a = (0, 1)`, `R B b = a`, `χ_OU = 1`, `(a·R⁻¹ c)² ≤ c·B c` for every `c`, with
equality at `c = b`; the other order `R⁻¹ B⁻¹ a = (−1, 3/2)` does not solve `R B b = a`. -/
theorem example_g_linear_response :
    responseVec K₂ B_g a_g = ![0, 1] ∧ K₂ *ᵥ (B_g *ᵥ ![0, 1]) = a_g ∧ chiOU K₂ B_g a_g = 1 ∧
      (∀ c : Fin 2 → ℝ, (a_g ⬝ᵥ (K₂⁻¹ *ᵥ c)) ^ 2 ≤ 1 * (c ⬝ᵥ (B_g *ᵥ c))) ∧
      (a_g ⬝ᵥ (K₂⁻¹ *ᵥ ![0, 1])) ^ 2 = 1 * (![0, 1] ⬝ᵥ (B_g *ᵥ ![0, 1])) ∧
      K₂⁻¹ *ᵥ (B_g⁻¹ *ᵥ a_g) = ![-1, 3 / 2] ∧
      K₂ *ᵥ (B_g *ᵥ (K₂⁻¹ *ᵥ (B_g⁻¹ *ᵥ a_g))) ≠ a_g := by
  obtain ⟨h1, h2, h3, h4⟩ := linear_response K₂_symm K₂_det B_g_symm B_g_pos a_g
  rw [responseVec_g] at h1 h2 h4
  have hchi : chiOU K₂ B_g a_g = 1 := by
    rw [h2]
    simp [B_g, dotProduct, Matrix.mulVec, Fin.sum_univ_two]
  have hwrong : K₂⁻¹ *ᵥ (B_g⁻¹ *ᵥ a_g) = ![-1, 3 / 2] := by
    rw [B_g_inv, K₂_inv]
    ext i
    fin_cases i <;> simp [a_g, Matrix.mulVec, dotProduct, Fin.sum_univ_two, Matrix.diagonal] <;>
      norm_num
  rw [hchi] at h3 h4
  refine ⟨responseVec_g, h1, hchi, h3, h4, hwrong, ?_⟩
  rw [hwrong]
  intro h
  have h' := congrFun h 1
  norm_num [K₂, B_g, a_g, Matrix.mulVec, dotProduct, Fin.sum_univ_two, Matrix.diagonal] at h'

end Example

/-! ## Part A: square-root and joint certificates, preconditioning, matrix certificates,
differential response, accumulated error

Notation: `ℰ(f) = ⟨f, L f⟩_ν` (the energy), `ℰ(u, v) = ⟨u, L v⟩_ν`, `Q = fluct`; for a solution
`g` of `L g = κ`, `χ = ⟨κ, g⟩_ν`; for solutions `L g_a = κ_a`, `X_κ a b = ⟨κ_a, g_b⟩_ν` is the
response matrix (`respMat`, written out below). "(H)" stands for the hypotheses of `ip_solve_le`:
`0 < ν s`, `∑ ν = 1`, `L` `ν`-symmetric, `L 1 = 0`, kernel of `L` in the constants, every nonzero
eigenvalue at least `λ₁ > 0`.

* **Square-root certificate.** For `A κ = 0`, `V(h) = ℰ(h) + 2 ⟨r, h⟩_ν` with `r = κ − L h`
  (`certV_eq_energy_add_residual`); for `ν`-symmetric `L` with `ℰ ≥ 0`, `√ℰ` satisfies the
  triangle inequality (`sqrt_energy_add_le`); under (H), `χ − V(h) = ℰ(g − h) ≤ λ₁⁻¹ ‖r‖²_ν` and
  `max(0, √ℰ(h) − √(λ₁⁻¹‖r‖²)) ≤ √χ ≤ √ℰ(h) + √(λ₁⁻¹‖r‖²)` (`sqrt_certificate`).
* **Joint attainability.** For `ν`-symmetric `L` with `L 1 = 0` and `L g_a = κ_a`, the profile
  `f_w = ∑ w_b g_b` has `⟨κ_a, Q f_w⟩_ν = (X_κ w)_a` and `ℰ(f_w) = w·X_κ w`
  (`joint_attainable`); under (H) every `f` with the same averaging errors has `ℰ(f) ≥ w·X_κ w`,
  with equality exactly when `Q f = Q f_w` (`joint_attainable_least`, using `energy_eq_zero_iff`).
* **Preconditioning.** For `ν`-symmetric `L` with `ℰ ≥ 0` and `L q = r`,
  `⟨r, q⟩_ν = max_f [2⟨r, f⟩_ν − ℰ(f)]` (`isGreatest_two_ip_sub_energy`); if `L`, `R` are
  `ν`-symmetric, `0 < m ≤ M`, `m ℰ_R ≤ ℰ_L ≤ M ℰ_R`, `L q = r`, `R s = r`, then
  `M⁻¹⟨r, s⟩ ≤ ⟨r, q⟩ ≤ m⁻¹⟨r, s⟩` (`precond_ip_bounds`) and, if also `L 1 = 0` and
  `r = κ − L h`, `V(h) + M⁻¹⟨r, s⟩ ≤ χ ≤ V(h) + m⁻¹⟨r, s⟩` (`precond_certificate`).
* **Matrix certificate.** For `ν`-symmetric `L` with `L 1 = 0` and trial profiles `h_a`,
  `X_κ a b = V_ab + ⟨ρ_a, q_b⟩_ν` with `ρ_a = κ_a − L h_a`, `L q_b = ρ_b`
  (`respX_eq_certVMat_add`), and under (H)
  `α·V α ≤ α·X_κ α ≤ α·V α + λ₁⁻¹ ‖∑ α_a ρ_a‖²_ν` (`matrix_certificate`).
* **Differential response.** Along `L₀ + t B` (`L₀`, `B` `ν`-symmetric) with
  `(L₀ + t B) g_t = κ` near `t₀`: `∂_t ⟨κ, g_t⟩_ν = −⟨g_{t₀}, B g_{t₀}⟩_ν` (`hasDerivAt_chi_path`);
  so `t ↦ ⟨κ, g_t⟩_ν` is antitone on an open convex set where this holds, when `B` has nonnegative
  energy (`antitoneOn_chi_path`).
* **Accumulated error.** For continuous `ε`, `χ ≥ 0`, `E ≥ 0` on `ℝ` with `|ε| ≤ √(χ E)`
  everywhere and `a ≤ b`: `|∫_a^b ε| ≤ ∫_a^b √(χ E) ≤ √((∫_a^b χ)(∫_a^b E))`
  (`abs_integral_le_sqrt_integral_mul`).
-/

section PartA

variable {S : Type*} [Fintype S] {ν : S → ℝ} {L : Matrix S S ℝ}

/-! ### Linear-algebra identities -/

/-- Bilinear expansion: `⟨∑ α_a u_a, ∑ β_b v_b⟩_ν = ∑_a ∑_b α_a β_b ⟨u_a, v_b⟩_ν`. -/
theorem ip_sum_smul_sum_A {ι : Type*} [Fintype ι] (ν : S → ℝ) (α β : ι → ℝ)
    (u v : ι → S → ℝ) :
    ip ν (∑ a, α a • u a) (∑ b, β b • v b) = ∑ a, ∑ b, α a * β b * ip ν (u a) (v b) := by
  rw [ip_sum_smul_left]
  refine Finset.sum_congr rfl fun a _ => ?_
  rw [ip_sum_smul_right, Finset.mul_sum]
  exact Finset.sum_congr rfl fun b _ => by ring

/-- The quadratic form of `M = Matrix.of F`: `w · M w = ∑_a ∑_b w_a w_b F a b`. -/
theorem dotProduct_of_mulVec_A {ι : Type*} [Fintype ι] (F : ι → ι → ℝ) (w : ι → ℝ) :
    w ⬝ᵥ (Matrix.of F *ᵥ w) = ∑ a, ∑ b, w a * w b * F a b := by
  simp only [dotProduct, Matrix.mulVec, Matrix.of_apply, Finset.mul_sum]
  exact Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => by ring

/-- **Energy of a sum**: for `ν`-symmetric `L`, `ℰ(u + v) = ℰ(u) + 2 ℰ(u, v) + ℰ(v)`. -/
theorem energy_add_A (hsymm : ∀ s r, ν s * L s r = ν r * L r s) (u v : S → ℝ) :
    ip ν (u + v) (L *ᵥ (u + v)) =
      ip ν u (L *ᵥ u) + 2 * ip ν u (L *ᵥ v) + ip ν v (L *ᵥ v) := by
  have hvu : ip ν v (L *ᵥ u) = ip ν u (L *ᵥ v) := by rw [ip_mulVec_comm hsymm, ip_comm]
  rw [Matrix.mulVec_add, ip_add_left, ip_add_right, ip_add_right, hvu]
  ring

/-! ### A1: the square-root certificate -/

/-- **The certificate in residual form**: for `A κ = 0` and any trial profile `h`, with residual
`r = κ − L h`: `V(h) = ℰ(h) + 2 ⟨r, h⟩_ν`. No hypothesis on `L` is needed. -/
theorem certV_eq_energy_add_residual {κ : S → ℝ} (hκ : avg ν κ = 0) (h : S → ℝ) :
    certV ν κ L h = ip ν h (L *ᵥ h) + 2 * ip ν (κ - L *ᵥ h) h := by
  rw [certV, ip_fluct_of_avg_eq_zero hκ, ip_sub_left, ip_comm ν (L *ᵥ h) h]
  ring

/-- **The energy seminorm**: if `L` is `ν`-symmetric with nonnegative energy, then
`√ℰ(u + v) ≤ √ℰ(u) + √ℰ(v)`. -/
theorem sqrt_energy_add_le (hsymm : ∀ s r, ν s * L s r = ν r * L r s)
    (hpsd : ∀ u, 0 ≤ ip ν u (L *ᵥ u)) (u v : S → ℝ) :
    Real.sqrt (ip ν (u + v) (L *ᵥ (u + v))) ≤
      Real.sqrt (ip ν u (L *ᵥ u)) + Real.sqrt (ip ν v (L *ᵥ v)) := by
  have hu := hpsd u
  have hv := hpsd v
  have hb : ip ν u (L *ᵥ v) ≤ Real.sqrt (ip ν u (L *ᵥ u)) * Real.sqrt (ip ν v (L *ᵥ v)) := by
    rw [← Real.sqrt_mul hu]
    exact (le_abs_self _).trans (Real.abs_le_sqrt (sq_ip_mulVec_le hsymm hpsd u v))
  rw [Real.sqrt_le_left (by positivity), energy_add_A hsymm, add_sq, Real.sq_sqrt hu,
    Real.sq_sqrt hv]
  linarith

/-- **The square-root certificate** (A1). Under (H), let `L g = κ`, `χ = ⟨κ, g⟩_ν`, let `h` be any
trial profile and `r = κ − L h`. Then `V(h) = ℰ(h) + 2⟨r, h⟩_ν`; `χ − V(h) = ℰ(g − h)`;
`ℰ(g − h) ≤ λ₁⁻¹ ‖r‖²_ν`; and
`max(0, √ℰ(h) − √(λ₁⁻¹ ‖r‖²_ν)) ≤ √χ ≤ √ℰ(h) + √(λ₁⁻¹ ‖r‖²_ν)`. Squared, the upper bound is never
below the linear upper bound `V(h) + λ₁⁻¹ ‖r‖²_ν` of `certificate` (Cauchy–Schwarz for `ℰ`); the
lower bound can exceed `V(h)`: for `κ` an eigenvector with eigenvalue `λ₁` and `h = 2 g` it gives
`χ`, while `V(h) = 0`. These comparisons are not formalised. -/
theorem sqrt_certificate [DecidableEq S] (hν : ∀ s, 0 < ν s) (h1 : ∑ s, ν s = 1)
    (hsymm : ∀ s r, ν s * L s r = ν r * L r s) (hL1 : L *ᵥ lift 1 = 0)
    (hker : ∀ v, L *ᵥ v = 0 → ∃ c, v = lift c) {lam₁ : ℝ} (hlam : 0 < lam₁)
    (hgap : ∀ (μ : ℝ) (v : S → ℝ), v ≠ 0 → L *ᵥ v = μ • v → μ ≠ 0 → lam₁ ≤ μ)
    {κ g : S → ℝ} (hg : L *ᵥ g = κ) (h : S → ℝ) :
    certV ν κ L h = ip ν h (L *ᵥ h) + 2 * ip ν (κ - L *ᵥ h) h ∧
      ip ν κ g - certV ν κ L h = ip ν (g - h) (L *ᵥ (g - h)) ∧
      ip ν (g - h) (L *ᵥ (g - h)) ≤ lam₁⁻¹ * nsq ν (κ - L *ᵥ h) ∧
      Real.sqrt (ip ν κ g) ≤
        Real.sqrt (ip ν h (L *ᵥ h)) + Real.sqrt (lam₁⁻¹ * nsq ν (κ - L *ᵥ h)) ∧
      max 0 (Real.sqrt (ip ν h (L *ᵥ h)) - Real.sqrt (lam₁⁻¹ * nsq ν (κ - L *ᵥ h))) ≤
        Real.sqrt (ip ν κ g) := by
  have hκ := avg_eq_zero_of_solve hsymm hL1 hg
  have hpsd := ip_mulVec_nonneg hν h1 hsymm hL1 hker hlam hgap
  have hq : L *ᵥ (g - h) = κ - L *ᵥ h := by rw [Matrix.mulVec_sub, hg]
  have hid := chi_eq_certV_add hsymm hL1 hg h hq
  have hE : ip ν (g - h) (L *ᵥ (g - h)) = ip ν (κ - L *ᵥ h) (g - h) := by rw [hq, ip_comm]
  have hup := ip_solve_le hν h1 hsymm hL1 hker hlam hgap hq
  have hEle : ip ν (g - h) (L *ᵥ (g - h)) ≤ lam₁⁻¹ * nsq ν (κ - L *ᵥ h) := by
    rw [hE]
    exact hup
  have hχ : ip ν κ g = ip ν g (L *ᵥ g) := by rw [hg, ip_comm]
  have hs : Real.sqrt (ip ν (g - h) (L *ᵥ (g - h))) ≤
      Real.sqrt (lam₁⁻¹ * nsq ν (κ - L *ᵥ h)) := Real.sqrt_le_sqrt hEle
  have t1 := sqrt_energy_add_le hsymm hpsd h (g - h)
  have t2 := sqrt_energy_add_le hsymm hpsd g (h - g)
  have e1 : h + (g - h) = g := by abel
  have e2 : g + (h - g) = h := by abel
  have hneg : ip ν (h - g) (L *ᵥ (h - g)) = ip ν (g - h) (L *ᵥ (g - h)) := by
    simp only [ip, Matrix.mulVec_sub, Pi.sub_apply]
    exact Finset.sum_congr rfl fun s _ => by ring
  rw [e1, ← hχ] at t1
  rw [e2, ← hχ, hneg] at t2
  refine ⟨certV_eq_energy_add_residual hκ h, by rw [hid, hE]; ring, hEle, by linarith, ?_⟩
  exact max_le (Real.sqrt_nonneg _) (by linarith)

/-! ### A2: joint attainability without pseudoinverses -/

/-- **Joint attainability** (A2). Let `L` be `ν`-symmetric with `L 1 = 0`, and let `L g_a = κ_a` for
a finite family of directions `a : ι`. Put `X_κ a b = ⟨κ_a, g_b⟩_ν` and, for weights `w : ι → ℝ`,
`f_w = ∑_b w_b g_b`. Then the averaging errors of `f_w` are `⟨κ_a, Q f_w⟩_ν = (X_κ w)_a` for every
`a`, and `ℰ(f_w) = w · X_κ w`. -/
theorem joint_attainable (hsymm : ∀ s r, ν s * L s r = ν r * L r s) (hL1 : L *ᵥ lift 1 = 0)
    {ι : Type*} [Fintype ι] {κ g : ι → S → ℝ} (hg : ∀ a, L *ᵥ g a = κ a) (w : ι → ℝ) :
    (∀ a, ip ν (κ a) (fluct ν (∑ b, w b • g b)) =
        ((Matrix.of fun a b => ip ν (κ a) (g b)) *ᵥ w) a) ∧
      ip ν (∑ b, w b • g b) (L *ᵥ ∑ b, w b • g b) =
        w ⬝ᵥ ((Matrix.of fun a b => ip ν (κ a) (g b)) *ᵥ w) := by
  have hκ : ∀ a, avg ν (κ a) = 0 := fun a => avg_eq_zero_of_solve hsymm hL1 (hg a)
  have hε : ∀ a, ip ν (κ a) (∑ b, w b • g b) =
      ((Matrix.of fun a b => ip ν (κ a) (g b)) *ᵥ w) a := by
    intro a
    rw [ip_sum_smul_right]
    simp only [Matrix.mulVec, dotProduct, Matrix.of_apply]
    exact Finset.sum_congr rfl fun b _ => by ring
  have hLf : L *ᵥ ∑ b, w b • g b = ∑ b, w b • κ b := by
    rw [Matrix.mulVec_sum]
    exact Finset.sum_congr rfl fun b _ => by rw [Matrix.mulVec_smul, hg]
  refine ⟨fun a => by rw [ip_fluct_of_avg_eq_zero (hκ a), hε a], ?_⟩
  rw [hLf, ip_comm, ip_sum_smul_left]
  simp only [dotProduct]
  exact Finset.sum_congr rfl fun b _ => by rw [hε b]

/-- **The energy-minimal joint response** (A2). Under (H), with the notation of
`joint_attainable`: every profile `f` whose averaging errors are `⟨κ_a, Q f⟩_ν = (X_κ w)_a` for all
`a` has `ℰ(f) ≥ w · X_κ w = ℰ(f_w)`, with equality if and only if `Q f = Q f_w`. -/
theorem joint_attainable_least [DecidableEq S] (hν : ∀ s, 0 < ν s) (h1 : ∑ s, ν s = 1)
    (hsymm : ∀ s r, ν s * L s r = ν r * L r s) (hL1 : L *ᵥ lift 1 = 0)
    (hker : ∀ v, L *ᵥ v = 0 → ∃ c, v = lift c) {lam₁ : ℝ} (hlam : 0 < lam₁)
    (hgap : ∀ (μ : ℝ) (v : S → ℝ), v ≠ 0 → L *ᵥ v = μ • v → μ ≠ 0 → lam₁ ≤ μ)
    {ι : Type*} [Fintype ι] {κ g : ι → S → ℝ} (hg : ∀ a, L *ᵥ g a = κ a) (w : ι → ℝ)
    (f : S → ℝ)
    (hf : ∀ a, ip ν (κ a) (fluct ν f) = ((Matrix.of fun a b => ip ν (κ a) (g b)) *ᵥ w) a) :
    w ⬝ᵥ ((Matrix.of fun a b => ip ν (κ a) (g b)) *ᵥ w) ≤ ip ν f (L *ᵥ f) ∧
      (ip ν f (L *ᵥ f) = w ⬝ᵥ ((Matrix.of fun a b => ip ν (κ a) (g b)) *ᵥ w) ↔
        fluct ν f = fluct ν (∑ b, w b • g b)) := by
  obtain ⟨hε, hE⟩ := joint_attainable hsymm hL1 hg w
  have hκ : ∀ a, avg ν (κ a) = 0 := fun a => avg_eq_zero_of_solve hsymm hL1 (hg a)
  have hpsd := ip_mulVec_nonneg hν h1 hsymm hL1 hker hlam hgap
  set fw := ∑ b, w b • g b with hfw
  have hLf : L *ᵥ fw = ∑ b, w b • κ b := by
    rw [hfw, Matrix.mulVec_sum]
    exact Finset.sum_congr rfl fun b _ => by rw [Matrix.mulVec_smul, hg]
  have hcross : ip ν fw (L *ᵥ (f - fw)) = 0 := by
    rw [ip_mulVec_comm hsymm, hLf, ip_sum_smul_left]
    refine Finset.sum_eq_zero fun b _ => ?_
    rw [ip_sub_right, ← ip_fluct_of_avg_eq_zero (hκ b) f, ← ip_fluct_of_avg_eq_zero (hκ b) fw,
      hf b, hε b, sub_self, mul_zero]
  have hsplit : ip ν f (L *ᵥ f) = ip ν fw (L *ᵥ fw) + ip ν (f - fw) (L *ᵥ (f - fw)) := by
    have e : f = fw + (f - fw) := by abel
    conv_lhs => rw [e]
    rw [energy_add_A hsymm, hcross]
    ring
  rw [hE] at hsplit
  have key := energy_eq_zero_iff hν h1 hsymm hL1 hker hlam hgap (f - fw)
  rw [fluct_sub, sub_eq_zero] at key
  refine ⟨by linarith [hpsd (f - fw)], ⟨fun heq => key.1 (by linarith), fun hQ => ?_⟩⟩
  have := key.2 hQ
  linarith

/-! ### A3: the preconditioned certificate -/

/-- **The variational formula for `⟨r, L⁺ r⟩_ν`**: if `L` is `ν`-symmetric with nonnegative energy
and `L q = r`, then `⟨r, q⟩_ν` is the greatest value of `f ↦ 2 ⟨r, f⟩_ν − ℰ(f)`, attained at
`f = q`. -/
theorem isGreatest_two_ip_sub_energy (hsymm : ∀ s r, ν s * L s r = ν r * L r s)
    (hpsd : ∀ u, 0 ≤ ip ν u (L *ᵥ u)) {r q : S → ℝ} (hq : L *ᵥ q = r) :
    IsGreatest (Set.range fun f => 2 * ip ν r f - ip ν f (L *ᵥ f)) (ip ν r q) := by
  have h3 : ip ν q (L *ᵥ q) = ip ν r q := by rw [hq, ip_comm]
  refine ⟨⟨q, ?_⟩, ?_⟩
  · show 2 * ip ν r q - ip ν q (L *ᵥ q) = ip ν r q
    rw [h3]
    ring
  · rintro _ ⟨f, rfl⟩
    have h1 : ip ν q (L *ᵥ f) = ip ν r f := by rw [ip_mulVec_comm hsymm, hq]
    have h2 : ip ν f (L *ᵥ q) = ip ν r f := by rw [hq, ip_comm]
    have e : ip ν (q - f) (L *ᵥ (q - f)) = ip ν r q - 2 * ip ν r f + ip ν f (L *ᵥ f) := by
      rw [Matrix.mulVec_sub, ip_sub_left, ip_sub_right, ip_sub_right, h1, h2, h3]
      ring
    have := hpsd (q - f)
    show 2 * ip ν r f - ip ν f (L *ᵥ f) ≤ ip ν r q
    linarith

/-- **Preconditioned bounds** (A3). Let `L` and `R` be `ν`-symmetric and let `0 < m ≤ M` with
`m ℰ_R(f) ≤ ℰ_L(f) ≤ M ℰ_R(f)` for every `f`. If `L q = r` and `R s = r`, then
`M⁻¹ ⟨r, s⟩_ν ≤ ⟨r, q⟩_ν ≤ m⁻¹ ⟨r, s⟩_ν`. No sign hypothesis is needed: for `m < M` the comparison
forces both energies to be nonnegative, and for `m = M` it forces `ℰ_L = m ℰ_R`, whence
`⟨r, q⟩_ν = m⁻¹ ⟨r, s⟩_ν`. (Solvability of `L q = r` forces `A r = 0` when `L 1 = 0`; neither
`L 1 = 0` nor `R 1 = 0` is used.) -/
theorem precond_ip_bounds {R : Matrix S S ℝ} (hsymmL : ∀ s r, ν s * L s r = ν r * L r s)
    (hsymmR : ∀ s r, ν s * R s r = ν r * R r s) {m M : ℝ} (hm : 0 < m) (hmM : m ≤ M)
    (hlow : ∀ f, m * ip ν f (R *ᵥ f) ≤ ip ν f (L *ᵥ f))
    (hupp : ∀ f, ip ν f (L *ᵥ f) ≤ M * ip ν f (R *ᵥ f))
    {r q s : S → ℝ} (hq : L *ᵥ q = r) (hs : R *ᵥ s = r) :
    M⁻¹ * ip ν r s ≤ ip ν r q ∧ ip ν r q ≤ m⁻¹ * ip ν r s := by
  rcases hmM.lt_or_eq with hlt | heq
  swap
  · rw [← heq] at hupp ⊢
    have hEq : ∀ u, ip ν u (L *ᵥ u) = m * ip ν u (R *ᵥ u) := fun u =>
      le_antisymm (hupp u) (hlow u)
    have a1 := energy_add_A hsymmL s q
    have a2 := energy_add_A hsymmR s q
    rw [hEq (s + q), hEq s, hEq q, a2] at a1
    have e1 : ip ν s (L *ᵥ q) = ip ν r s := by rw [hq, ip_comm]
    have e2 : ip ν s (R *ᵥ q) = ip ν r q := by rw [ip_mulVec_comm hsymmR, hs]
    rw [e1, e2] at a1
    have h2 : ip ν r s = m * ip ν r q := by linear_combination (-1 / 2 : ℝ) * a1
    have key : ip ν r q = m⁻¹ * ip ν r s := by
      rw [h2, ← mul_assoc, inv_mul_cancel₀ hm.ne', one_mul]
    exact ⟨key.ge, key.le⟩
  have hM : 0 < M := hm.trans hlt
  have hpsdR : ∀ u, 0 ≤ ip ν u (R *ᵥ u) := fun u => by
    have h0 : 0 ≤ (M - m) * ip ν u (R *ᵥ u) := by
      rw [sub_mul]
      linarith [hlow u, hupp u]
    exact (mul_nonneg_iff_of_pos_left (sub_pos.2 hlt)).1 h0
  have hpsd : ∀ u, 0 ≤ ip ν u (L *ᵥ u) := fun u => (mul_nonneg hm.le (hpsdR u)).trans (hlow u)
  have hvL : 2 * ip ν r (M⁻¹ • s) - ip ν (M⁻¹ • s) (L *ᵥ (M⁻¹ • s)) ≤ ip ν r q :=
    (isGreatest_two_ip_sub_energy hsymmL hpsd hq).2 ⟨M⁻¹ • s, rfl⟩
  have hvR : 2 * ip ν r (m • q) - ip ν (m • q) (R *ᵥ (m • q)) ≤ ip ν r s :=
    (isGreatest_two_ip_sub_energy hsymmR hpsdR hs).2 ⟨m • q, rfl⟩
  have eR : ip ν (M⁻¹ • s) (R *ᵥ (M⁻¹ • s)) = M⁻¹ * M⁻¹ * ip ν r s := by
    rw [Matrix.mulVec_smul, ip_smul_left, ip_smul_right, hs, ip_comm]
    ring
  have hu := hupp (M⁻¹ • s)
  rw [eR] at hu
  rw [ip_smul_right] at hvL
  have hMM : M * (M⁻¹ * M⁻¹ * ip ν r s) = M⁻¹ * ip ν r s := by
    rw [show M * (M⁻¹ * M⁻¹ * ip ν r s) = M * M⁻¹ * M⁻¹ * ip ν r s by ring,
      mul_inv_cancel₀ hM.ne', one_mul]
  have eL : ip ν q (L *ᵥ q) = ip ν r q := by rw [hq, ip_comm]
  have hl := mul_le_mul_of_nonneg_left (hlow q) hm.le
  rw [eL] at hl
  rw [Matrix.mulVec_smul, ip_smul_left, ip_smul_right, ip_smul_right] at hvR
  refine ⟨by linarith, ?_⟩
  have key : m * ip ν r q ≤ ip ν r s := by linarith
  calc ip ν r q = m⁻¹ * (m * ip ν r q) := by rw [← mul_assoc, inv_mul_cancel₀ hm.ne', one_mul]
    _ ≤ m⁻¹ * ip ν r s := mul_le_mul_of_nonneg_left key (inv_nonneg.2 hm.le)

/-- **The preconditioned certificate** (A3). Let `L` be `ν`-symmetric with `L 1 = 0`, `R`
`ν`-symmetric, `0 < m ≤ M` with `m ℰ_R ≤ ℰ_L ≤ M ℰ_R`. If `L g = κ`, `h` is a trial profile,
`r = κ − L h` and `R s = r`, then `V(h) + M⁻¹ ⟨r, s⟩_ν ≤ χ ≤ V(h) + m⁻¹ ⟨r, s⟩_ν`. -/
theorem precond_certificate {R : Matrix S S ℝ} (hsymmL : ∀ s r, ν s * L s r = ν r * L r s)
    (hL1 : L *ᵥ lift 1 = 0) (hsymmR : ∀ s r, ν s * R s r = ν r * R r s)
    {m M : ℝ} (hm : 0 < m) (hmM : m ≤ M)
    (hlow : ∀ f, m * ip ν f (R *ᵥ f) ≤ ip ν f (L *ᵥ f))
    (hupp : ∀ f, ip ν f (L *ᵥ f) ≤ M * ip ν f (R *ᵥ f))
    {κ g s : S → ℝ} (hg : L *ᵥ g = κ) (h : S → ℝ) (hs : R *ᵥ s = κ - L *ᵥ h) :
    certV ν κ L h + M⁻¹ * ip ν (κ - L *ᵥ h) s ≤ ip ν κ g ∧
      ip ν κ g ≤ certV ν κ L h + m⁻¹ * ip ν (κ - L *ᵥ h) s := by
  have hq : L *ᵥ (g - h) = κ - L *ᵥ h := by rw [Matrix.mulVec_sub, hg]
  have hid := chi_eq_certV_add hsymmL hL1 hg h hq
  obtain ⟨hlo, hhi⟩ := precond_ip_bounds hsymmL hsymmR hm hmM hlow hupp hq hs
  constructor <;> linarith

/-! ### A4: the matrix certificate -/

/-- The matrix certificate of trial profiles `h_a` for directions `κ_a`:
`V_ab = ⟨κ_a, Q h_b⟩_ν + ⟨κ_b, Q h_a⟩_ν − ⟨h_a, L h_b⟩_ν`. Its diagonal entries are `certV`. -/
def certVMat {ι : Type*} (ν : S → ℝ) (κ : ι → S → ℝ) (L : Matrix S S ℝ) (h : ι → S → ℝ) :
    Matrix ι ι ℝ :=
  Matrix.of fun a b =>
    ip ν (κ a) (fluct ν (h b)) + ip ν (κ b) (fluct ν (h a)) - ip ν (h a) (L *ᵥ h b)

/-- **The matrix certificate identity** (A4). Let `L` be `ν`-symmetric with `L 1 = 0`, `L g_a = κ_a`
for all `a`, let `h_a` be trial profiles with residuals `ρ_a = κ_a − L h_a`, and let `L q_b = ρ_b`.
Then `⟨κ_a, g_b⟩_ν = V_ab + ⟨ρ_a, q_b⟩_ν` for all `a, b`. -/
theorem respX_eq_certVMat_add (hsymm : ∀ s r, ν s * L s r = ν r * L r s)
    (hL1 : L *ᵥ lift 1 = 0) {ι : Type*} {κ g h q : ι → S → ℝ} (hg : ∀ a, L *ᵥ g a = κ a)
    (hq : ∀ b, L *ᵥ q b = κ b - L *ᵥ h b) (a b : ι) :
    ip ν (κ a) (g b) = certVMat ν κ L h a b + ip ν (κ a - L *ᵥ h a) (q b) := by
  have hκa := avg_eq_zero_of_solve hsymm hL1 (hg a)
  have hκb := avg_eq_zero_of_solve hsymm hL1 (hg b)
  have hr : κ a - L *ᵥ h a = L *ᵥ (g a - h a) := by rw [Matrix.mulVec_sub, hg]
  have e1 : ip ν (κ a - L *ᵥ h a) (q b) = ip ν (g a - h a) (κ b - L *ᵥ h b) := by
    rw [hr, ← ip_mulVec_comm hsymm, hq]
  have e2 : ip ν (g a) (L *ᵥ h b) = ip ν (κ a) (h b) := by rw [ip_mulVec_comm hsymm, hg]
  have e3 : ip ν (g a) (κ b) = ip ν (κ a) (g b) := by
    rw [← hg b, ip_mulVec_comm hsymm, hg]
  rw [e1, certVMat, Matrix.of_apply, ip_fluct_of_avg_eq_zero hκa, ip_fluct_of_avg_eq_zero hκb]
  simp only [ip_sub_left, ip_sub_right]
  rw [e2, e3, ip_comm ν (h a) (κ b)]
  ring

/-- **The matrix certificate** (A4). Under (H), let `L g_a = κ_a` for a finite family `a : ι`,
`X_κ a b = ⟨κ_a, g_b⟩_ν`, trial profiles `h_a` with residuals `ρ_a = κ_a − L h_a`, and `V` the
matrix certificate. Then for every `α : ι → ℝ`:
`α·V α ≤ α·X_κ α ≤ α·V α + λ₁⁻¹ ‖∑ α_a ρ_a‖²_ν`. -/
theorem matrix_certificate [DecidableEq S] (hν : ∀ s, 0 < ν s) (h1 : ∑ s, ν s = 1)
    (hsymm : ∀ s r, ν s * L s r = ν r * L r s) (hL1 : L *ᵥ lift 1 = 0)
    (hker : ∀ v, L *ᵥ v = 0 → ∃ c, v = lift c) {lam₁ : ℝ} (hlam : 0 < lam₁)
    (hgap : ∀ (μ : ℝ) (v : S → ℝ), v ≠ 0 → L *ᵥ v = μ • v → μ ≠ 0 → lam₁ ≤ μ)
    {ι : Type*} [Fintype ι] {κ g : ι → S → ℝ} (hg : ∀ a, L *ᵥ g a = κ a) (h : ι → S → ℝ)
    (α : ι → ℝ) :
    α ⬝ᵥ (certVMat ν κ L h *ᵥ α) ≤ α ⬝ᵥ ((Matrix.of fun a b => ip ν (κ a) (g b)) *ᵥ α) ∧
      α ⬝ᵥ ((Matrix.of fun a b => ip ν (κ a) (g b)) *ᵥ α) ≤
        α ⬝ᵥ (certVMat ν κ L h *ᵥ α) + lam₁⁻¹ * nsq ν (∑ a, α a • (κ a - L *ᵥ h a)) := by
  have hκ : ∀ a, avg ν (κ a) = 0 := fun a => avg_eq_zero_of_solve hsymm hL1 (hg a)
  have hgα : L *ᵥ ∑ a, α a • g a = ∑ a, α a • κ a := by
    rw [Matrix.mulVec_sum]
    exact Finset.sum_congr rfl fun a _ => by rw [Matrix.mulVec_smul, hg]
  have hLh : L *ᵥ ∑ a, α a • h a = ∑ a, α a • L *ᵥ h a := by
    rw [Matrix.mulVec_sum]
    exact Finset.sum_congr rfl fun a _ => by rw [Matrix.mulVec_smul]
  have hres : ∑ a, α a • (κ a - L *ᵥ h a) = ∑ a, α a • κ a - L *ᵥ ∑ a, α a • h a := by
    rw [hLh, ← Finset.sum_sub_distrib]
    exact Finset.sum_congr rfl fun a _ => by rw [smul_sub]
  have hX : α ⬝ᵥ ((Matrix.of fun a b => ip ν (κ a) (g b)) *ᵥ α) =
      ip ν (∑ a, α a • κ a) (∑ a, α a • g a) := by
    rw [dotProduct_of_mulVec_A, ip_sum_smul_sum_A]
  have hκα : avg ν (∑ a, α a • κ a) = 0 := avg_eq_zero_of_solve hsymm hL1 hgα
  have hκQ : ∀ a u, ip ν (κ a) (fluct ν u) = ip ν (κ a) u := fun a u =>
    ip_fluct_of_avg_eq_zero (hκ a) u
  have hswap : ∑ a, ∑ b, α a * α b * ip ν (κ b) (h a) =
      ∑ a, ∑ b, α a * α b * ip ν (κ a) (h b) := by
    conv_lhs => rw [Finset.sum_comm]
    exact Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => by ring
  have hV : α ⬝ᵥ (certVMat ν κ L h *ᵥ α) = certV ν (∑ a, α a • κ a) L (∑ a, α a • h a) := by
    rw [certVMat, dotProduct_of_mulVec_A, certV, ip_fluct_of_avg_eq_zero hκα, hLh,
      ip_sum_smul_sum_A, ip_sum_smul_sum_A]
    simp only [hκQ, mul_add, mul_sub, Finset.sum_add_distrib, Finset.sum_sub_distrib]
    linear_combination hswap
  obtain ⟨-, hlo, hhi⟩ := certificate hν h1 hsymm hL1 hker hlam hgap hgα (∑ a, α a • h a)
  rw [hX, hV, hres]
  exact ⟨(le_max_right _ _).trans hlo, hhi⟩

/-! ### A5: differential response along an operator path -/

/-- **Differential response along an operator path** (A5). Let `L₀` and `B` be `ν`-symmetric, let
`g : ℝ → S → ℝ` have coordinatewise derivative `g'` at `t₀`, and let `(L₀ + t B) g_t = κ` for all
`t` near `t₀` (`κ` fixed). Then `∂_t ⟨κ, g_t⟩_ν = −⟨g_{t₀}, B g_{t₀}⟩_ν` at `t₀`. -/
theorem hasDerivAt_chi_path {L₀ B : Matrix S S ℝ} (hsymm0 : ∀ s r, ν s * L₀ s r = ν r * L₀ r s)
    (hsymmB : ∀ s r, ν s * B s r = ν r * B r s) {κ g' : S → ℝ} {g : ℝ → S → ℝ} {t₀ : ℝ}
    (hgd : ∀ s, HasDerivAt (fun t => g t s) (g' s) t₀)
    (hsol : ∀ᶠ t in nhds t₀, (L₀ + t • B) *ᵥ g t = κ) :
    HasDerivAt (fun t => ip ν κ (g t)) (-ip ν (g t₀) (B *ᵥ g t₀)) t₀ := by
  have hrow : ∀ (t : ℝ) (v : S → ℝ) (s : S),
      ((L₀ + t • B) *ᵥ v) s = ∑ r, (L₀ s r + B s r * t) * v r := by
    intro t v s
    simp only [Matrix.mulVec, dotProduct, Matrix.add_apply, Matrix.smul_apply, smul_eq_mul]
    exact Finset.sum_congr rfl fun r _ => by ring
  have hsymmt : ∀ s r, ν s * (L₀ + t₀ • B) s r = ν r * (L₀ + t₀ • B) r s := by
    intro s r
    simp only [Matrix.add_apply, Matrix.smul_apply, smul_eq_mul]
    linear_combination hsymm0 s r + t₀ * hsymmB s r
  have h0 : (L₀ + t₀ • B) *ᵥ g t₀ = κ := hsol.self_of_nhds
  have hlin : (L₀ + t₀ • B) *ᵥ g' = -(B *ᵥ g t₀) := by
    funext s
    have hd : HasDerivAt (fun t => ∑ r, (L₀ s r + B s r * t) * g t r)
        (∑ r, (B s r * 1 * g t₀ r + (L₀ s r + B s r * t₀) * g' r)) t₀ :=
      HasDerivAt.fun_sum fun r _ =>
        (((hasDerivAt_id' t₀).const_mul (B s r)).const_add (L₀ s r)).mul (hgd r)
    have hc : HasDerivAt (fun t => ∑ r, (L₀ s r + B s r * t) * g t r) 0 t₀ := by
      refine (hasDerivAt_const t₀ (κ s)).congr_of_eventuallyEq ?_
      filter_upwards [hsol] with t ht
      rw [← hrow t (g t) s, ht]
    have hz := hd.unique hc
    rw [Finset.sum_add_distrib] at hz
    have hB : (B *ᵥ g t₀) s = ∑ r, B s r * 1 * g t₀ r := by
      simp only [Matrix.mulVec, dotProduct, mul_one]
    rw [hrow, Pi.neg_apply, hB]
    linarith
  have hD : HasDerivAt (fun t => ip ν κ (g t)) (ip ν κ g') t₀ := by
    unfold ip
    exact HasDerivAt.fun_sum fun s _ => (hgd s).const_mul (ν s * κ s)
  refine hD.congr_deriv ?_
  rw [← h0, ← ip_mulVec_comm hsymmt, hlin]
  simp only [ip, Pi.neg_apply, mul_neg, Finset.sum_neg_distrib]

/-- **Monotonicity of the response** (A5). Let `L₀`, `B` be `ν`-symmetric with `⟨u, B u⟩_ν ≥ 0` for
all `u`, `I` an open convex set of parameters, `g` differentiable (coordinatewise, derivative
`g' t`) at every `t ∈ I`, and `(L₀ + t B) g_t = κ` for every `t ∈ I`. Then `t ↦ ⟨κ, g_t⟩_ν` is
antitone on `I`. -/
theorem antitoneOn_chi_path {L₀ B : Matrix S S ℝ} (hsymm0 : ∀ s r, ν s * L₀ s r = ν r * L₀ r s)
    (hsymmB : ∀ s r, ν s * B s r = ν r * B r s) (hBpsd : ∀ u, 0 ≤ ip ν u (B *ᵥ u))
    {κ : S → ℝ} {g g' : ℝ → S → ℝ} {I : Set ℝ} (hI : IsOpen I) (hIc : Convex ℝ I)
    (hgd : ∀ t ∈ I, ∀ s, HasDerivAt (fun t => g t s) (g' t s) t)
    (hsol : ∀ t ∈ I, (L₀ + t • B) *ᵥ g t = κ) :
    AntitoneOn (fun t => ip ν κ (g t)) I := by
  have hD : ∀ t ∈ I, HasDerivAt (fun t => ip ν κ (g t)) (-ip ν (g t) (B *ᵥ g t)) t :=
    fun t ht => hasDerivAt_chi_path hsymm0 hsymmB (hgd t ht)
      (Filter.eventually_of_mem (hI.mem_nhds ht) hsol)
  refine antitoneOn_of_deriv_nonpos hIc
    (fun t ht => (hD t ht).continuousAt.continuousWithinAt) ?_ ?_
  · rw [hI.interior_eq]
    exact fun t ht => (hD t ht).differentiableAt.differentiableWithinAt
  · rw [hI.interior_eq]
    intro t ht
    rw [(hD t ht).deriv]
    exact neg_nonpos.2 (hBpsd _)

/-! ### A6: accumulated averaging error over a parameter interval -/

/-- **Accumulated averaging error** (A6). Let `a ≤ b` and let `ε`, `χ`, `E : ℝ → ℝ` be continuous
with `χ ≥ 0`, `E ≥ 0` and `|ε t| ≤ √(χ t · E t)` for every `t` (for instance: `ε` an averaging
error, `χ` the sharp coefficient and `E` the energy along a path). Then
`|∫_a^b ε| ≤ ∫_a^b √(χ E) ≤ √((∫_a^b χ)(∫_a^b E))`. -/
theorem abs_integral_le_sqrt_integral_mul {a b : ℝ} (hab : a ≤ b) {ε χ E : ℝ → ℝ}
    (hε : Continuous ε) (hχ : Continuous χ) (hE : Continuous E) (hχ0 : ∀ t, 0 ≤ χ t)
    (hE0 : ∀ t, 0 ≤ E t) (hb : ∀ t, |ε t| ≤ Real.sqrt (χ t * E t)) :
    |∫ t in a..b, ε t| ≤ ∫ t in a..b, Real.sqrt (χ t * E t) ∧
      ∫ t in a..b, Real.sqrt (χ t * E t) ≤
        Real.sqrt ((∫ t in a..b, χ t) * ∫ t in a..b, E t) := by
  have hsc : Continuous fun t => Real.sqrt (χ t * E t) := (hχ.mul hE).sqrt
  refine ⟨(intervalIntegral.abs_integral_le_integral_abs hab).trans
    (intervalIntegral.integral_mono_on hab (hε.abs.intervalIntegrable _ _)
      (hsc.intervalIntegrable _ _) fun t _ => hb t), ?_⟩
  have hq : ∀ x : ℝ, 0 ≤ (∫ t in a..b, χ t) * (x * x) +
      2 * (∫ t in a..b, Real.sqrt (χ t * E t)) * x + ∫ t in a..b, E t := by
    intro x
    have hpt : ∀ t, (x * Real.sqrt (χ t) + Real.sqrt (E t)) ^ 2 =
        x * x * χ t + 2 * x * Real.sqrt (χ t * E t) + E t := by
      intro t
      rw [Real.sqrt_mul (hχ0 t), add_sq, mul_pow, Real.sq_sqrt (hχ0 t), Real.sq_sqrt (hE0 t)]
      ring
    have hnn : 0 ≤ ∫ t in a..b, (x * Real.sqrt (χ t) + Real.sqrt (E t)) ^ 2 :=
      intervalIntegral.integral_nonneg hab fun t _ => sq_nonneg _
    have hc1 : Continuous fun t => x * x * χ t := continuous_const.mul hχ
    have hc2 : Continuous fun t => 2 * x * Real.sqrt (χ t * E t) := continuous_const.mul hsc
    have hc12 : Continuous fun t => x * x * χ t + 2 * x * Real.sqrt (χ t * E t) := hc1.add hc2
    have e : ∫ t in a..b, (x * Real.sqrt (χ t) + Real.sqrt (E t)) ^ 2 =
        x * x * (∫ t in a..b, χ t) + 2 * x * (∫ t in a..b, Real.sqrt (χ t * E t)) +
          ∫ t in a..b, E t := by
      simp_rw [hpt]
      rw [intervalIntegral.integral_add (hc12.intervalIntegrable _ _) (hE.intervalIntegrable _ _),
        intervalIntegral.integral_add (hc1.intervalIntegrable _ _) (hc2.intervalIntegrable _ _),
        intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul]
    rw [e] at hnn
    linarith
  have hd := discrim_le_zero hq
  rw [discrim] at hd
  have hsq : (∫ t in a..b, Real.sqrt (χ t * E t)) ^ 2 ≤
      (∫ t in a..b, χ t) * ∫ t in a..b, E t := by nlinarith
  exact (le_abs_self _).trans (Real.abs_le_sqrt hsq)

end PartA

namespace Example

/-! ### Part A: closed applications on the three-point fibre -/

/-- The coefficient `κ = (1/2, −1/2, −1/2)`, the value of `kappa ν₃ νb X₃` (`kappa_ex`), an
eigenvector of `L₃` with eigenvalue `2`. -/
def κex_a : Fin 3 → ℝ := ![1 / 2, -1 / 2, -1 / 2]

/-- A coefficient `κ = (1, 0, −2)`, mean zero for `ν₃` and not an eigenvector of `L₃`. -/
def κm_a : Fin 3 → ℝ := ![1, 0, -2]

/-- Its mean-zero solution `L₃⁺ κ = (1/2, −1/6, −5/6)`. -/
def gm_a : Fin 3 → ℝ := ![1 / 2, -1 / 6, -5 / 6]

/-- A trial profile for `κ = (1, 0, −2)`. -/
def hm_a : Fin 3 → ℝ := ![1 / 2, 0, -1 / 2]

theorem L₃_gex_a : L₃ *ᵥ gex = κex_a := by
  funext s
  fin_cases s <;> simp [L₃, gex, κex_a, Matrix.mulVec, dotProduct, Fin.sum_univ_three] <;>
    norm_num

theorem L₃_gm_a : L₃ *ᵥ gm_a = κm_a := by
  funext s
  fin_cases s <;> simp [L₃, gm_a, κm_a, Matrix.mulVec, dotProduct, Fin.sum_univ_three] <;>
    norm_num

theorem chi_m_a : ip ν₃ κm_a gm_a = 2 / 3 := by
  norm_num [ip, ν₃, κm_a, gm_a, Fin.sum_univ_three, Matrix.cons_val_two, Matrix.tail_cons,
      Matrix.head_cons]

/-- **Witness for the square-root certificate** (A1) for `κ = (0, 1, −1)` (`χ = 1/6`) and the trial
profile `h = (0, 1/4, −1/4)` (`λ₁ = 2`): `ℰ(h) = 3/32`, `⟨r, h⟩ = 1/32` for `r = κ − L₃ h`,
`V(h) = 3/32 + 2·(1/32) = 5/32`, `χ − V(h) = ℰ(g − h) = 1/96 ≤ ‖r‖²/λ₁ = 1/64`, the energy
expansion and the seminorm inequality for `h` and `g − h`, and the bracket
`max(0, √(3/32) − 1/8) ≤ √(1/6) ≤ √(3/32) + 1/8`. -/
theorem example_a_sqrt_certificate :
    certV ν₃ κs L₃ hs = ip ν₃ hs (L₃ *ᵥ hs) + 2 * ip ν₃ (κs - L₃ *ᵥ hs) hs ∧
      ip ν₃ hs (L₃ *ᵥ hs) = 3 / 32 ∧ ip ν₃ (κs - L₃ *ᵥ hs) hs = 1 / 32 ∧
      certV ν₃ κs L₃ hs = 5 / 32 ∧
      ip ν₃ κs gs - certV ν₃ κs L₃ hs = ip ν₃ (gs - hs) (L₃ *ᵥ (gs - hs)) ∧
      ip ν₃ (gs - hs) (L₃ *ᵥ (gs - hs)) = 1 / 96 ∧
      ip ν₃ (gs - hs) (L₃ *ᵥ (gs - hs)) ≤ 2⁻¹ * nsq ν₃ (κs - L₃ *ᵥ hs) ∧
      2⁻¹ * nsq ν₃ (κs - L₃ *ᵥ hs) = 1 / 64 ∧
      ip ν₃ (hs + (gs - hs)) (L₃ *ᵥ (hs + (gs - hs))) =
        ip ν₃ hs (L₃ *ᵥ hs) + 2 * ip ν₃ hs (L₃ *ᵥ (gs - hs)) +
          ip ν₃ (gs - hs) (L₃ *ᵥ (gs - hs)) ∧
      Real.sqrt (ip ν₃ (hs + (gs - hs)) (L₃ *ᵥ (hs + (gs - hs)))) ≤
        Real.sqrt (ip ν₃ hs (L₃ *ᵥ hs)) + Real.sqrt (ip ν₃ (gs - hs) (L₃ *ᵥ (gs - hs))) ∧
      Real.sqrt (1 / 6) ≤ Real.sqrt (3 / 32) + 1 / 8 ∧
      max 0 (Real.sqrt (3 / 32) - 1 / 8) ≤ Real.sqrt (1 / 6) := by
  have hLh : L₃ *ᵥ hs = ![0, 3 / 4, -3 / 4] := by
    funext s
    fin_cases s <;> simp [L₃, hs, Matrix.mulVec, dotProduct, Fin.sum_univ_three] <;> norm_num
  have hE : ip ν₃ hs (L₃ *ᵥ hs) = 3 / 32 := by
    rw [hLh]
    norm_num [ip, ν₃, hs, Fin.sum_univ_three, Matrix.cons_val_two, Matrix.tail_cons,
      Matrix.head_cons]
  have hrh : ip ν₃ (κs - L₃ *ᵥ hs) hs = 1 / 32 := by
    rw [hLh]
    norm_num [ip, ν₃, κs, hs, Fin.sum_univ_three, Matrix.cons_val_two, Matrix.tail_cons,
      Matrix.head_cons]
  have hr : nsq ν₃ (κs - L₃ *ᵥ hs) = 1 / 32 := by
    rw [hLh]
    norm_num [nsq, ip, ν₃, κs, Fin.sum_univ_three, Matrix.cons_val_two, Matrix.tail_cons,
      Matrix.head_cons]
  obtain ⟨c1, c2, c3, c4, c5⟩ := sqrt_certificate ν₃_pos ν₃_sum L₃_symm L₃_one L₃_ker
    (by norm_num : (0 : ℝ) < 2) L₃_gap L₃_gs hs
  have hV : certV ν₃ κs L₃ hs = 5 / 32 := by
    rw [c1, hE, hrh]
    norm_num
  have hEg : ip ν₃ (gs - hs) (L₃ *ᵥ (gs - hs)) = 1 / 96 := by
    rw [← c2, chi_strict, hV]
    norm_num
  have h64 : 2⁻¹ * nsq ν₃ (κs - L₃ *ᵥ hs) = 1 / 64 := by
    rw [hr]
    norm_num
  have hsq : Real.sqrt (2⁻¹ * nsq ν₃ (κs - L₃ *ᵥ hs)) = 1 / 8 := by
    rw [h64, show (1 / 64 : ℝ) = (1 / 8) ^ 2 by norm_num]
    exact Real.sqrt_sq (by norm_num)
  rw [hE, hsq, chi_strict] at c4 c5
  exact ⟨certV_eq_energy_add_residual (avg_eq_zero_of_solve L₃_symm L₃_one L₃_gs) hs, hE, hrh,
    hV, c2, hEg, c3, h64, energy_add_A L₃_symm hs (gs - hs),
    sqrt_energy_add_le L₃_symm L₃_psd hs (gs - hs), c4, c5⟩

/-- **The square-root upper bound can be attained** (A1): for `κ = (1/2, −1/2, −1/2)` (`χ = 1/8`)
and `h = (1/5, −1/5, −1/5)`: `ℰ(h) = 2/25`, `‖r‖²/λ₁ = 1/200`, and
`√ℰ(h) + √(‖r‖²/λ₁) = √(2/25) + √(1/200) = √2/4 = √χ`. -/
theorem example_a_sqrt_certificate_sharp :
    ip ν₃ κex_a gex = 1 / 8 ∧ ip ν₃ hex (L₃ *ᵥ hex) = 2 / 25 ∧
      2⁻¹ * nsq ν₃ (κex_a - L₃ *ᵥ hex) = 1 / 200 ∧
      Real.sqrt (ip ν₃ κex_a gex) ≤
        Real.sqrt (ip ν₃ hex (L₃ *ᵥ hex)) + Real.sqrt (2⁻¹ * nsq ν₃ (κex_a - L₃ *ᵥ hex)) ∧
      Real.sqrt (2 / 25) + Real.sqrt (1 / 200) = Real.sqrt (1 / 8) := by
  have hLh : L₃ *ᵥ hex = ![2 / 5, -2 / 5, -2 / 5] := by
    funext s
    fin_cases s <;> simp [L₃, hex, Matrix.mulVec, dotProduct, Fin.sum_univ_three] <;> norm_num
  have hχ : ip ν₃ κex_a gex = 1 / 8 := by
    norm_num [ip, ν₃, κex_a, gex, Fin.sum_univ_three, Matrix.cons_val_two, Matrix.tail_cons,
      Matrix.head_cons]
  have hE : ip ν₃ hex (L₃ *ᵥ hex) = 2 / 25 := by
    rw [hLh]
    norm_num [ip, ν₃, hex, Fin.sum_univ_three, Matrix.cons_val_two, Matrix.tail_cons,
      Matrix.head_cons]
  have hr : 2⁻¹ * nsq ν₃ (κex_a - L₃ *ᵥ hex) = 1 / 200 := by
    rw [hLh]
    norm_num [nsq, ip, ν₃, κex_a, Fin.sum_univ_three, Matrix.cons_val_two, Matrix.tail_cons,
      Matrix.head_cons]
  obtain ⟨-, -, -, c4, -⟩ := sqrt_certificate ν₃_pos ν₃_sum L₃_symm L₃_one L₃_ker
    (by norm_num : (0 : ℝ) < 2) L₃_gap L₃_gex_a hex
  have s2 : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)
  have e1 : Real.sqrt (2 / 25) = Real.sqrt 2 / 5 := by
    rw [show (2 / 25 : ℝ) = (Real.sqrt 2 / 5) ^ 2 by rw [div_pow, s2]; norm_num]
    exact Real.sqrt_sq (by positivity)
  have e2 : Real.sqrt (1 / 200) = Real.sqrt 2 / 20 := by
    rw [show (1 / 200 : ℝ) = (Real.sqrt 2 / 20) ^ 2 by rw [div_pow, s2]; norm_num]
    exact Real.sqrt_sq (by positivity)
  have e3 : Real.sqrt (1 / 8) = Real.sqrt 2 / 4 := by
    rw [show (1 / 8 : ℝ) = (Real.sqrt 2 / 4) ^ 2 by rw [div_pow, s2]; norm_num]
    exact Real.sqrt_sq (by positivity)
  refine ⟨hχ, hE, hr, c4, ?_⟩
  rw [e1, e2, e3]
  ring

/-- Two directions on the three-point fibre: `κ_0 = (1/2, −1/2, −1/2)`, `κ_1 = (1, 0, −2)`. -/
def κpair_a : Fin 2 → Fin 3 → ℝ := ![κex_a, κm_a]

/-- Their solutions `g_0 = (1/4, −1/4, −1/4)`, `g_1 = (1/2, −1/6, −5/6)`. -/
def gpair_a : Fin 2 → Fin 3 → ℝ := ![gex, gm_a]

/-- Trial profiles `h_0 = (1/5, −1/5, −1/5)`, `h_1 = (1/2, 0, −1/2)`. -/
def hpair_a : Fin 2 → Fin 3 → ℝ := ![hex, hm_a]

/-- Weights `w = (−2, 1)`. -/
def w_a : Fin 2 → ℝ := ![-2, 1]

theorem L₃_gpair_a : ∀ a, L₃ *ᵥ gpair_a a = κpair_a a := by
  intro a
  fin_cases a
  · exact L₃_gex_a
  · exact L₃_gm_a

/-- The response matrix of the pair: `X_κ = [[1/8, 1/4], [1/4, 2/3]]`. -/
theorem respX_pair_a :
    (Matrix.of fun a b => ip ν₃ (κpair_a a) (gpair_a b)) = !![1 / 8, 1 / 4; 1 / 4, 2 / 3] := by
  ext a b
  fin_cases a <;> fin_cases b <;>
    norm_num [κpair_a, gpair_a, κex_a, κm_a, gex, gm_a, ip, ν₃, Fin.sum_univ_three,
      Matrix.cons_val_two, Matrix.tail_cons, Matrix.head_cons]

/-- **Witness for joint attainability** (A2) on the three-point fibre with `L₃` and the directions
`κ_0 = (1/2, −1/2, −1/2)`, `κ_1 = (1, 0, −2)`: `X_κ = [[1/8, 1/4], [1/4, 2/3]]`; for `w = (−2, 1)`,
`f_w = −2 g_0 + g_1 = (0, 1/3, −1/3)`, `X_κ w = (0, 1/6)`, and `ℰ(f_w) = w·X_κ w = 1/6`. The energy
vanishes exactly on constants, and every `f` with `⟨κ_0, Q f⟩ = 0` and `⟨κ_1, Q f⟩ = 1/6` has
`ℰ(f) ≥ 1/6`, with equality if and only if `Q f = (0, 1/3, −1/3)`. -/
theorem example_a_joint_response :
    (Matrix.of fun a b => ip ν₃ (κpair_a a) (gpair_a b)) = !![1 / 8, 1 / 4; 1 / 4, 2 / 3] ∧
      ∑ b, w_a b • gpair_a b = gs ∧
      ((Matrix.of fun a b => ip ν₃ (κpair_a a) (gpair_a b)) *ᵥ w_a) = ![0, 1 / 6] ∧
      w_a ⬝ᵥ ((Matrix.of fun a b => ip ν₃ (κpair_a a) (gpair_a b)) *ᵥ w_a) = 1 / 6 ∧
      ip ν₃ κex_a (fluct ν₃ gs) = 0 ∧ ip ν₃ κm_a (fluct ν₃ gs) = 1 / 6 ∧
      ip ν₃ gs (L₃ *ᵥ gs) = 1 / 6 ∧
      (∀ d : Fin 3 → ℝ, ip ν₃ d (L₃ *ᵥ d) = 0 ↔ fluct ν₃ d = 0) ∧
      ∀ f : Fin 3 → ℝ, ip ν₃ κex_a (fluct ν₃ f) = 0 → ip ν₃ κm_a (fluct ν₃ f) = 1 / 6 →
        1 / 6 ≤ ip ν₃ f (L₃ *ᵥ f) ∧ (ip ν₃ f (L₃ *ᵥ f) = 1 / 6 ↔ fluct ν₃ f = gs) := by
  have hX := respX_pair_a
  have hw : ∑ b, w_a b • gpair_a b = gs := by
    funext s
    fin_cases s <;> simp [Fin.sum_univ_two, w_a, gpair_a, gex, gm_a, gs] <;> norm_num
  have hXw : ((Matrix.of fun a b => ip ν₃ (κpair_a a) (gpair_a b)) *ᵥ w_a) = ![0, 1 / 6] := by
    rw [hX]
    funext a
    fin_cases a <;> simp [w_a, Matrix.mulVec, dotProduct, Fin.sum_univ_two] <;> norm_num
  have hwXw : w_a ⬝ᵥ ((Matrix.of fun a b => ip ν₃ (κpair_a a) (gpair_a b)) *ᵥ w_a) =
      (1 / 6 : ℝ) := by
    rw [hXw]
    simp [w_a, dotProduct, Fin.sum_univ_two]
  have hgs : fluct ν₃ gs = gs := by
    funext s
    fin_cases s <;> norm_num [fluct, proj, avg, lift, ν₃, gs, Fin.sum_univ_three,
      Matrix.cons_val_two, Matrix.tail_cons, Matrix.head_cons]
  obtain ⟨hε, hE⟩ := joint_attainable L₃_symm L₃_one L₃_gpair_a w_a
  rw [hw, hXw] at hε
  rw [hw, hwXw] at hE
  have hε0 : ip ν₃ κex_a (fluct ν₃ gs) = 0 := hε 0
  have hε1 : ip ν₃ κm_a (fluct ν₃ gs) = 1 / 6 := hε 1
  refine ⟨hX, hw, hXw, hwXw, hε0, hε1, hE,
    energy_eq_zero_iff ν₃_pos ν₃_sum L₃_symm L₃_one L₃_ker (by norm_num : (0 : ℝ) < 2) L₃_gap,
    ?_⟩
  intro f hf0 hf1
  have hf : ∀ a, ip ν₃ (κpair_a a) (fluct ν₃ f) =
      ((Matrix.of fun a b => ip ν₃ (κpair_a a) (gpair_a b)) *ᵥ w_a) a := by
    rw [hXw]
    intro a
    fin_cases a
    · exact hf0
    · exact hf1
  obtain ⟨hle, hiff⟩ := joint_attainable_least ν₃_pos ν₃_sum L₃_symm L₃_one L₃_ker
    (by norm_num : (0 : ℝ) < 2) L₃_gap L₃_gpair_a w_a f hf
  rw [hwXw, hw, hgs] at hiff
  rw [hwXw] at hle
  exact ⟨hle, hiff⟩

/-- A spanning-tree (star) preconditioner on the three-point fibre: its energy
`ℰ_R(f) = ((f₀ − f₁)² + (f₀ − f₂)²)/4` keeps the two edges of `L₃` at the point of weight `1/2`
and drops the edge `{1, 2}`. -/
def Rst_a : Matrix (Fin 3) (Fin 3) ℝ := !![1, -1 / 2, -1 / 2; -1, 1, 0; -1, 0, 1]

theorem Rst_a_symm : ∀ s r, ν₃ s * Rst_a s r = ν₃ r * Rst_a r s := by
  intro s r
  fin_cases s <;> fin_cases r <;> simp [ν₃, Rst_a] <;> norm_num

theorem Rst_a_one : Rst_a *ᵥ lift 1 = 0 := by
  funext s
  fin_cases s <;> norm_num [Rst_a, Matrix.mulVec, dotProduct, Fin.sum_univ_three,
    Matrix.cons_val_two, Matrix.tail_cons, Matrix.head_cons]

theorem energy_Rst_a (f : Fin 3 → ℝ) :
    ip ν₃ f (Rst_a *ᵥ f) = ((f 0 - f 1) ^ 2 + (f 0 - f 2) ^ 2) / 4 := by
  have r0 : (Rst_a *ᵥ f) 0 = f 0 - f 1 / 2 - f 2 / 2 := by
    simp [Rst_a, Matrix.mulVec, dotProduct, Fin.sum_univ_three]
    ring
  have r1 : (Rst_a *ᵥ f) 1 = -f 0 + f 1 := by
    simp [Rst_a, Matrix.mulVec, dotProduct, Fin.sum_univ_three]
  have r2 : (Rst_a *ᵥ f) 2 = -f 0 + f 2 := by
    simp [Rst_a, Matrix.mulVec, dotProduct, Fin.sum_univ_three]
  simp only [ip, Fin.sum_univ_three, r0, r1, r2]
  simp only [ν₃, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons,
    Matrix.tail_cons]
  ring

/-- Spectral equivalence of `L₃` and the star preconditioner: `ℰ_R ≤ ℰ_{L₃} ≤ 3 ℰ_R`
(`ℰ_{L₃} − ℰ_R = (f₁ − f₂)²/4`, `3 ℰ_R − ℰ_{L₃} = (2f₀ − f₁ − f₂)²/4`). -/
theorem Rst_a_compare (f : Fin 3 → ℝ) :
    1 * ip ν₃ f (Rst_a *ᵥ f) ≤ ip ν₃ f (L₃ *ᵥ f) ∧
      ip ν₃ f (L₃ *ᵥ f) ≤ 3 * ip ν₃ f (Rst_a *ᵥ f) := by
  rw [energy_L₃_r, energy_Rst_a]
  constructor <;> nlinarith [sq_nonneg (f 1 - f 2), sq_nonneg (2 * f 0 - f 1 - f 2)]

/-- The solution `s = (1/8, 1/8, −3/8)` of `R s = r` for `r = κ − L₃ h = (1/4, 0, −1/2)`. -/
def sm_a : Fin 3 → ℝ := ![1 / 8, 1 / 8, -3 / 8]

/-- **Witness for the preconditioned certificate** (A3): `κ = (1, 0, −2)` (`χ = 2/3`), trial
profile `h = (1/2, 0, −1/2)`, residual `r = (1/4, 0, −1/2)`, the star preconditioner `R` with
`m = 1`, `M = 3`, and `R s = r` for `s = (1/8, 1/8, −3/8)`: `V(h) = 5/8`, `⟨r, s⟩ = 1/16`,
`⟨r, L₃⁺ r⟩ = 1/24` (the maximum of `2⟨r, f⟩ − ℰ(f)`), `1/48 ≤ 1/24 ≤ 1/16`, and
`31/48 ≤ χ = 2/3 ≤ 11/16`. For comparison, `certificate` gives `5/8 ≤ χ ≤ 43/64`: here the
preconditioner sharpens the lower bound but not the upper one. -/
theorem example_a_precond :
    L₃ *ᵥ hm_a = ![3 / 4, 0, -3 / 2] ∧ κm_a - L₃ *ᵥ hm_a = ![1 / 4, 0, -1 / 2] ∧
      Rst_a *ᵥ lift 1 = 0 ∧ Rst_a *ᵥ sm_a = κm_a - L₃ *ᵥ hm_a ∧
      certV ν₃ κm_a L₃ hm_a = 5 / 8 ∧ ip ν₃ κm_a gm_a = 2 / 3 ∧
      ip ν₃ (κm_a - L₃ *ᵥ hm_a) sm_a = 1 / 16 ∧
      ip ν₃ (κm_a - L₃ *ᵥ hm_a) (gm_a - hm_a) = 1 / 24 ∧
      IsGreatest (Set.range fun f => 2 * ip ν₃ (κm_a - L₃ *ᵥ hm_a) f - ip ν₃ f (L₃ *ᵥ f))
        (1 / 24) ∧
      3⁻¹ * ip ν₃ (κm_a - L₃ *ᵥ hm_a) sm_a ≤ ip ν₃ (κm_a - L₃ *ᵥ hm_a) (gm_a - hm_a) ∧
      ip ν₃ (κm_a - L₃ *ᵥ hm_a) (gm_a - hm_a) ≤ 1⁻¹ * ip ν₃ (κm_a - L₃ *ᵥ hm_a) sm_a ∧
      certV ν₃ κm_a L₃ hm_a + 3⁻¹ * ip ν₃ (κm_a - L₃ *ᵥ hm_a) sm_a ≤ ip ν₃ κm_a gm_a ∧
      ip ν₃ κm_a gm_a ≤ certV ν₃ κm_a L₃ hm_a + 1⁻¹ * ip ν₃ (κm_a - L₃ *ᵥ hm_a) sm_a ∧
      certV ν₃ κm_a L₃ hm_a + 3⁻¹ * ip ν₃ (κm_a - L₃ *ᵥ hm_a) sm_a = 31 / 48 ∧
      certV ν₃ κm_a L₃ hm_a + 1⁻¹ * ip ν₃ (κm_a - L₃ *ᵥ hm_a) sm_a = 11 / 16 ∧
      certV ν₃ κm_a L₃ hm_a + 2⁻¹ * nsq ν₃ (κm_a - L₃ *ᵥ hm_a) = 43 / 64 := by
  have hLh : L₃ *ᵥ hm_a = ![3 / 4, 0, -3 / 2] := by
    funext s
    fin_cases s <;> simp [L₃, hm_a, Matrix.mulVec, dotProduct, Fin.sum_univ_three] <;> norm_num
  have hr : κm_a - L₃ *ᵥ hm_a = ![1 / 4, 0, -1 / 2] := by
    rw [hLh]
    funext s
    fin_cases s <;> simp [κm_a] <;> norm_num
  have hRs : Rst_a *ᵥ sm_a = κm_a - L₃ *ᵥ hm_a := by
    rw [hr]
    funext s
    fin_cases s <;> simp [Rst_a, sm_a, Matrix.mulVec, dotProduct, Fin.sum_univ_three] <;>
      norm_num
  have hV : certV ν₃ κm_a L₃ hm_a = 5 / 8 := by
    rw [certV, hLh]
    norm_num [ip, fluct, proj, avg, lift, ν₃, κm_a, hm_a, Fin.sum_univ_three,
      Matrix.cons_val_two, Matrix.tail_cons, Matrix.head_cons]
  have hrs : ip ν₃ (κm_a - L₃ *ᵥ hm_a) sm_a = 1 / 16 := by
    rw [hr]
    norm_num [ip, ν₃, sm_a, Fin.sum_univ_three, Matrix.cons_val_two, Matrix.tail_cons,
      Matrix.head_cons]
  have hrq : ip ν₃ (κm_a - L₃ *ᵥ hm_a) (gm_a - hm_a) = 1 / 24 := by
    rw [hr]
    norm_num [ip, ν₃, gm_a, hm_a, Fin.sum_univ_three, Matrix.cons_val_two, Matrix.tail_cons,
      Matrix.head_cons]
  have hnr : nsq ν₃ (κm_a - L₃ *ᵥ hm_a) = 3 / 32 := by
    rw [hr]
    norm_num [nsq, ip, ν₃, Fin.sum_univ_three, Matrix.cons_val_two, Matrix.tail_cons,
      Matrix.head_cons]
  have hq : L₃ *ᵥ (gm_a - hm_a) = κm_a - L₃ *ᵥ hm_a := by rw [Matrix.mulVec_sub, L₃_gm_a]
  have hG := isGreatest_two_ip_sub_energy L₃_symm L₃_psd hq
  rw [hrq] at hG
  obtain ⟨b1, b2⟩ := precond_ip_bounds L₃_symm Rst_a_symm (by norm_num : (0 : ℝ) < 1)
    (by norm_num : (1 : ℝ) ≤ 3) (fun f => (Rst_a_compare f).1) (fun f => (Rst_a_compare f).2)
    hq hRs
  obtain ⟨c1, c2⟩ := precond_certificate L₃_symm L₃_one Rst_a_symm
    (by norm_num : (0 : ℝ) < 1) (by norm_num : (1 : ℝ) ≤ 3) (fun f => (Rst_a_compare f).1)
    (fun f => (Rst_a_compare f).2) L₃_gm_a hm_a hRs
  refine ⟨hLh, hr, Rst_a_one, hRs, hV, chi_m_a, hrs, hrq, hG, b1, b2, c1, c2, ?_, ?_, ?_⟩
  · rw [hV, hrs]
    norm_num
  · rw [hV, hrs]
    norm_num
  · rw [hV, hnr]
    norm_num

/-- **Witness for the matrix certificate** (A4): directions `κ_0 = (1/2, −1/2, −1/2)`,
`κ_1 = (1, 0, −2)` and trial profiles `h_0 = (1/5, −1/5, −1/5)`, `h_1 = (1/2, 0, −1/2)`:
`V = [[3/25, 19/80], [19/80, 5/8]]`, `X_κ = [[1/8, 1/4], [1/4, 2/3]]`,
`(⟨ρ_a, g_b − h_b⟩) = [[1/200, 1/80], [1/80, 1/24]] = X_κ − V`, and for every `α`:
`α·V α ≤ α·X_κ α ≤ α·V α + ‖α_0 ρ_0 + α_1 ρ_1‖²/2`. -/
theorem example_a_matrix_certificate :
    certVMat ν₃ κpair_a L₃ hpair_a = !![3 / 25, 19 / 80; 19 / 80, 5 / 8] ∧
      (Matrix.of fun a b => ip ν₃ (κpair_a a) (gpair_a b)) = !![1 / 8, 1 / 4; 1 / 4, 2 / 3] ∧
      (Matrix.of fun a b => ip ν₃ (κpair_a a - L₃ *ᵥ hpair_a a) (gpair_a b - hpair_a b)) =
        !![1 / 200, 1 / 80; 1 / 80, 1 / 24] ∧
      (∀ a b, ip ν₃ (κpair_a a) (gpair_a b) = certVMat ν₃ κpair_a L₃ hpair_a a b +
        ip ν₃ (κpair_a a - L₃ *ᵥ hpair_a a) (gpair_a b - hpair_a b)) ∧
      ∀ α : Fin 2 → ℝ,
        α ⬝ᵥ (!![3 / 25, 19 / 80; 19 / 80, 5 / 8] *ᵥ α) ≤
            α ⬝ᵥ (!![1 / 8, 1 / 4; 1 / 4, 2 / 3] *ᵥ α) ∧
          α ⬝ᵥ (!![1 / 8, 1 / 4; 1 / 4, 2 / 3] *ᵥ α) ≤
            α ⬝ᵥ (!![3 / 25, 19 / 80; 19 / 80, 5 / 8] *ᵥ α) +
              2⁻¹ * nsq ν₃ (∑ a, α a • (κpair_a a - L₃ *ᵥ hpair_a a)) := by
  have hV : certVMat ν₃ κpair_a L₃ hpair_a = !![3 / 25, 19 / 80; 19 / 80, 5 / 8] := by
    ext a b
    fin_cases a <;> fin_cases b <;>
      norm_num [certVMat, κpair_a, hpair_a, κex_a, κm_a, hex, hm_a, ip, fluct, proj, avg, lift,
        ν₃, L₃, Matrix.mulVec, dotProduct, Fin.sum_univ_three, Matrix.cons_val_two,
        Matrix.tail_cons, Matrix.head_cons]
  have hQ : (Matrix.of fun a b => ip ν₃ (κpair_a a - L₃ *ᵥ hpair_a a) (gpair_a b - hpair_a b)) =
      !![1 / 200, 1 / 80; 1 / 80, 1 / 24] := by
    ext a b
    fin_cases a <;> fin_cases b <;>
      norm_num [κpair_a, hpair_a, gpair_a, κex_a, κm_a, hex, hm_a, gex, gm_a, ip, ν₃, L₃,
        Matrix.mulVec, dotProduct, Fin.sum_univ_three, Matrix.cons_val_two, Matrix.tail_cons,
        Matrix.head_cons]
  have hq : ∀ b, L₃ *ᵥ (gpair_a b - hpair_a b) = κpair_a b - L₃ *ᵥ hpair_a b := fun b => by
    rw [Matrix.mulVec_sub, L₃_gpair_a]
  refine ⟨hV, respX_pair_a, hQ, respX_eq_certVMat_add L₃_symm L₃_one L₃_gpair_a hq, ?_⟩
  intro α
  have h := matrix_certificate ν₃_pos ν₃_sum L₃_symm L₃_one L₃_ker (by norm_num : (0 : ℝ) < 2)
    L₃_gap L₃_gpair_a hpair_a α
  rw [hV, respX_pair_a] at h
  exact h

/-- The energy matrix of the edge `{1, 2}` of the three-point fibre: `ℰ_B(f) = (f₁ − f₂)²/4`. -/
def Bedge_a : Matrix (Fin 3) (Fin 3) ℝ := !![0, 0, 0; 0, 1, -1; 0, -1, 1]

theorem Bedge_a_symm : ∀ s r, ν₃ s * Bedge_a s r = ν₃ r * Bedge_a r s := by
  intro s r
  fin_cases s <;> fin_cases r <;> simp [ν₃, Bedge_a]

theorem Bedge_a_one : Bedge_a *ᵥ lift 1 = 0 := by
  funext s
  fin_cases s <;> simp [Bedge_a, Matrix.mulVec, dotProduct, Fin.sum_univ_three]

theorem Bedge_a_psd (u : Fin 3 → ℝ) : 0 ≤ ip ν₃ u (Bedge_a *ᵥ u) := by
  have r0 : (Bedge_a *ᵥ u) 0 = 0 := by
    simp [Bedge_a, Matrix.mulVec, dotProduct, Fin.sum_univ_three]
  have r1 : (Bedge_a *ᵥ u) 1 = u 1 - u 2 := by
    simp [Bedge_a, Matrix.mulVec, dotProduct, Fin.sum_univ_three]
    ring
  have r2 : (Bedge_a *ᵥ u) 2 = -u 1 + u 2 := by
    simp [Bedge_a, Matrix.mulVec, dotProduct, Fin.sum_univ_three]
  have e : ip ν₃ u (Bedge_a *ᵥ u) = (u 1 - u 2) ^ 2 / 4 := by
    simp only [ip, Fin.sum_univ_three, r0, r1, r2]
    simp only [ν₃, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.head_cons, Matrix.tail_cons]
    ring
  rw [e]
  positivity

/-- The responses `g_t = (1/2, −1/2, −1/2) + (3 + 2t)⁻¹ (0, 1, −1)` to `κ = (1, 0, −2)` along the
path `L₃ + t B` (`B` = `Bedge_a`): `g_t` solves `(L₃ + t B) g_t = κ` for every `t ≠ −3/2`
(`Lpath_gpath_a`); the example uses `t > −3/2`. -/
def gpath_a (t : ℝ) : Fin 3 → ℝ := κex_a + (3 + 2 * t)⁻¹ • κs

/-- Their parameter derivative `−2 (3 + 2t)⁻² (0, 1, −1)`. -/
def dgpath_a (t : ℝ) : Fin 3 → ℝ := (-2 / (3 + 2 * t) ^ 2) • κs

/-- The rows of `L₃ + t B`. -/
theorem Lpath_row_a (t : ℝ) (v : Fin 3 → ℝ) :
    ((L₃ + t • Bedge_a) *ᵥ v) 0 = v 0 - v 1 / 2 - v 2 / 2 ∧
      ((L₃ + t • Bedge_a) *ᵥ v) 1 = -v 0 + (2 + t) * v 1 - (1 + t) * v 2 ∧
      ((L₃ + t • Bedge_a) *ᵥ v) 2 = -v 0 - (1 + t) * v 1 + (2 + t) * v 2 := by
  refine ⟨?_, ?_, ?_⟩ <;>
    simp [L₃, Bedge_a, Matrix.mulVec, dotProduct, Fin.sum_univ_three, Matrix.add_apply] <;> ring

/-- `g_t` solves `(L₃ + t B) g_t = (1, 0, −2)` whenever `3 + 2t ≠ 0`. -/
theorem Lpath_gpath_a : ∀ t : ℝ, 3 + 2 * t ≠ 0 → (L₃ + t • Bedge_a) *ᵥ gpath_a t = κm_a := by
  intro t ht
  have hc : (3 + 2 * t)⁻¹ * (3 + 2 * t) = 1 := inv_mul_cancel₀ ht
  have g0 : gpath_a t 0 = 1 / 2 := by norm_num [gpath_a, κex_a, κs]
  have g1 : gpath_a t 1 = -1 / 2 + (3 + 2 * t)⁻¹ := by norm_num [gpath_a, κex_a, κs]
  have g2 : gpath_a t 2 = -1 / 2 - (3 + 2 * t)⁻¹ := by
    simp only [gpath_a, Pi.add_apply, Pi.smul_apply, smul_eq_mul, κex_a, κs, Matrix.cons_val_two,
      Matrix.head_cons, Matrix.tail_cons]
    ring
  obtain ⟨r0, r1, r2⟩ := Lpath_row_a t (gpath_a t)
  have c0 : ((L₃ + t • Bedge_a) *ᵥ gpath_a t) 0 = 1 := by
    rw [r0, g0, g1, g2]
    ring
  have c1 : ((L₃ + t • Bedge_a) *ᵥ gpath_a t) 1 = 0 := by
    rw [r1, g0, g1, g2]
    linear_combination hc
  have c2 : ((L₃ + t • Bedge_a) *ᵥ gpath_a t) 2 = -2 := by
    rw [r2, g0, g1, g2]
    linear_combination (-1 : ℝ) * hc
  funext s
  fin_cases s
  · exact c0
  · exact c1
  · exact c2

/-- The coordinates of `g_t` have derivative `dgpath_a t` wherever `3 + 2t ≠ 0`. -/
theorem gpath_a_hasDerivAt :
    ∀ t : ℝ, 3 + 2 * t ≠ 0 → ∀ s, HasDerivAt (fun y => gpath_a y s) (dgpath_a t s) t := by
  intro t ht s
  have hc := (((hasDerivAt_id' t).const_mul (2 : ℝ)).const_add (3 : ℝ)).fun_inv ht
  have h := (hc.mul_const (κs s)).const_add (κex_a s)
  simp only [gpath_a, dgpath_a, Pi.add_apply, Pi.smul_apply, smul_eq_mul]
  exact h.congr_deriv (by ring)

/-- **Witness for the differential response** (A5): along `L₃ + t B` with `B` the edge matrix of
`{1, 2}` (`ν₃`-symmetric, `B 1 = 0`, `ℰ_B ≥ 0`), the responses to `κ = (1, 0, −2)` are
`g_t = (1/2, −1/2, −1/2) + (3 + 2t)⁻¹ (0, 1, −1)` for `t > −3/2`, with `g_0 = L₃⁺ κ` and
`χ(0) = 2/3`; `∂_t χ(0) = −⟨g_0, B g_0⟩ = −1/9`; and `χ(t) = ⟨κ, g_t⟩` is antitone on
`(−3/2, ∞)`. -/
theorem example_a_differential :
    Bedge_a *ᵥ lift 1 = 0 ∧ gpath_a 0 = gm_a ∧ ip ν₃ κm_a (gpath_a 0) = 2 / 3 ∧
      (∀ t : ℝ, -3 / 2 < t → (L₃ + t • Bedge_a) *ᵥ gpath_a t = κm_a) ∧
      ip ν₃ gm_a (Bedge_a *ᵥ gm_a) = 1 / 9 ∧
      HasDerivAt (fun t => ip ν₃ κm_a (gpath_a t)) (-ip ν₃ gm_a (Bedge_a *ᵥ gm_a)) 0 ∧
      HasDerivAt (fun t => ip ν₃ κm_a (gpath_a t)) (-1 / 9) 0 ∧
      AntitoneOn (fun t => ip ν₃ κm_a (gpath_a t)) (Set.Ioi (-3 / 2)) := by
  have h0 : gpath_a 0 = gm_a := by
    funext s
    fin_cases s <;> norm_num [gpath_a, gm_a, κex_a, κs]
  have hB : ip ν₃ gm_a (Bedge_a *ᵥ gm_a) = 1 / 9 := by
    norm_num [ip, ν₃, gm_a, Bedge_a, Matrix.mulVec, dotProduct, Fin.sum_univ_three,
      Matrix.cons_val_two, Matrix.tail_cons, Matrix.head_cons]
  have hmem : ∀ t ∈ Set.Ioi (-3 / 2 : ℝ), 3 + 2 * t ≠ 0 := fun t ht => by
    have h : (-3 / 2 : ℝ) < t := ht
    exact (by linarith : (0 : ℝ) < 3 + 2 * t).ne'
  have hsol : ∀ t ∈ Set.Ioi (-3 / 2 : ℝ), (L₃ + t • Bedge_a) *ᵥ gpath_a t = κm_a :=
    fun t ht => Lpath_gpath_a t (hmem t ht)
  have hgd : ∀ t ∈ Set.Ioi (-3 / 2 : ℝ), ∀ s,
      HasDerivAt (fun y => gpath_a y s) (dgpath_a t s) t :=
    fun t ht => gpath_a_hasDerivAt t (hmem t ht)
  have h0mem : (0 : ℝ) ∈ Set.Ioi (-3 / 2 : ℝ) := by norm_num
  have hD := hasDerivAt_chi_path L₃_symm Bedge_a_symm (hgd 0 h0mem)
    (Filter.eventually_of_mem (isOpen_Ioi.mem_nhds h0mem) hsol)
  rw [h0] at hD
  have hA := antitoneOn_chi_path L₃_symm Bedge_a_symm Bedge_a_psd isOpen_Ioi (convex_Ioi _)
    hgd hsol
  refine ⟨Bedge_a_one, h0, by rw [h0, chi_m_a], fun t ht => hsol t ht, hB, hD, ?_, hA⟩
  rw [hB] at hD
  exact hD.congr_deriv (by norm_num)

/-- The profile path `F_t = (0, 1, t)` on the three-point fibre. -/
def Fp_a (t : ℝ) : Fin 3 → ℝ := ![0, 1, t]

/-- **Witness for the accumulated error** (A6) on `[0, 1]`, for `κ = (0, 1, −1)` (`χ = 1/6`,
constant in `t`) and the path `F_t = (0, 1, t)`: `⟨κ, F_t⟩ = (1 − t)/4`,
`ℰ(F_t) = (1 + t² + (1 − t)²)/4`, the pointwise bound `|⟨κ, F_t⟩| ≤ √(χ ℰ(F_t))` (from
`sq_ip_le_of_solve`), and hence `|∫₀¹ ⟨κ, F_t⟩| ≤ ∫₀¹ √(χ ℰ(F_t)) ≤ √((∫₀¹ χ)(∫₀¹ ℰ(F_t)))`. -/
theorem example_a_accumulated :
    (fun t => ip ν₃ κs (Fp_a t)) = (fun t => (1 - t) / 4) ∧
      (fun t => ip ν₃ (Fp_a t) (L₃ *ᵥ Fp_a t)) =
        (fun t => ((0 - 1) ^ 2 + (0 - t) ^ 2 + (1 - t) ^ 2) / 4) ∧
      (∀ t, |ip ν₃ κs (Fp_a t)| ≤ Real.sqrt (1 / 6 * ip ν₃ (Fp_a t) (L₃ *ᵥ Fp_a t))) ∧
      |∫ t in (0 : ℝ)..1, ip ν₃ κs (Fp_a t)| ≤
        ∫ t in (0 : ℝ)..1, Real.sqrt (1 / 6 * ip ν₃ (Fp_a t) (L₃ *ᵥ Fp_a t)) ∧
      ∫ t in (0 : ℝ)..1, Real.sqrt (1 / 6 * ip ν₃ (Fp_a t) (L₃ *ᵥ Fp_a t)) ≤
        Real.sqrt ((∫ _ in (0 : ℝ)..1, (1 / 6 : ℝ)) *
          ∫ t in (0 : ℝ)..1, ip ν₃ (Fp_a t) (L₃ *ᵥ Fp_a t)) := by
  have hεf : (fun t => ip ν₃ κs (Fp_a t)) = (fun t => (1 - t) / 4) := by
    funext t
    simp only [ip, Fin.sum_univ_three, ν₃, κs, Fp_a, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons]
    ring
  have hEf : (fun t => ip ν₃ (Fp_a t) (L₃ *ᵥ Fp_a t)) =
      (fun t => ((0 - 1) ^ 2 + (0 - t) ^ 2 + (1 - t) ^ 2) / 4) := by
    funext t
    rw [energy_L₃_r]
    simp only [Fp_a, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.head_cons, Matrix.tail_cons]
  have hεc : Continuous fun t => ip ν₃ κs (Fp_a t) := by
    rw [hεf]
    fun_prop
  have hEc : Continuous fun t => ip ν₃ (Fp_a t) (L₃ *ᵥ Fp_a t) := by
    rw [hEf]
    fun_prop
  have hb : ∀ t, |ip ν₃ κs (Fp_a t)| ≤ Real.sqrt (1 / 6 * ip ν₃ (Fp_a t) (L₃ *ᵥ Fp_a t)) := by
    intro t
    apply Real.abs_le_sqrt
    have h := sq_ip_le_of_solve L₃_symm L₃_psd L₃_gs (Fp_a t)
    rwa [chi_strict] at h
  obtain ⟨i1, i2⟩ := abs_integral_le_sqrt_integral_mul (χ := fun _ => (1 / 6 : ℝ))
    (by norm_num : (0 : ℝ) ≤ 1) hεc continuous_const hEc (fun _ => by norm_num)
    (fun t => L₃_psd _) hb
  exact ⟨hεf, hEf, hb, i1, i2⟩

end Example

