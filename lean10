          Real.exp (-1) ^ 4) / (1 + Real.exp (-1) + Real.exp (-1) ^ 2) ^ 3)) 0 := by
  have hV : ∀ s, HasDerivAt (fun t => Vt t s) (![1, 0, -1] s) 0 := fun s =>
