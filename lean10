  have hZ : (1 + Real.exp (-1) + Real.exp (-1) ^ 2) ≠ 0 := by positivity
  have hline := free_energy_line (![0, 1, 2] : Fin 3 → ℝ) ![1, 0, -1]
  refine ⟨?_, ?_, hline.2.2.1 0, hline.2.2.2, ?_, ?_⟩
  · refine (hasDerivAt_log_partition hV).congr_deriv ?_
    simp only [avg_gibbs_Vt_zero_g, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons]
    field_simp
    ring
  · refine (hasDerivAt_avg_gibbs_self (V' := fun _ => ![1, 0, -1]) (V'' := 0) hV
      (fun s => hasDerivAt_const 0 _)).congr_deriv ?_
    simp only [avg_gibbs_Vt_zero_g, Pi.mul_apply, Pi.zero_apply, Matrix.cons_val_zero,
      Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons]
    field_simp
