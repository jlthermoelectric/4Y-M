/-! ### The main results -/

section Main

/-- **The box constant `κ ≤ 3321/500`.** For every box `b` of the `4⁴` coarse torus and every
field `φ` of its fibre `F_b⁽⁰⁾` (section fields supported on the links touching `b + {0,1}⁴`),
`∑_l φ_l² ≤ (3321/500) ∑_p (dφ)_p²`. -/
theorem kappa_bound (b : Fin 256) {φ : Fin 1024 → ℝ} (hφ : φ ∈ fibre b) :
    ∑ l, φ l ^ 2 ≤ 3321 / 500 * ∑ p, curl φ p ^ 2 :=
  kappa_of_certs geomCheck_true slotCheck_true kcert kcert_valid b hφ

/-- **κ in norm form**: `‖φ‖² ≤ (3321/500) ‖dφ‖²` on every fibre. -/
theorem kappa_bound_norm (b : Fin 256) {φ : Fin 1024 → ℝ} (hφ : φ ∈ fibre b) :
    ∑ l, φ l ^ 2 ≤ 3321 / 500 * ‖curv φ‖ ^ 2 := by
  have h : ‖curv φ‖ ^ 2 = ∑ p, curl φ p ^ 2 := by
    rw [EuclideanSpace.real_norm_sq_eq]
    rfl
  rw [h]
  exact kappa_bound b hφ

/-- **Primitives of the curvature fibres.** Every `c ∈ K_b` is `dφ` for a fibre field `φ` with
`∑_l φ_l² ≤ (3321/500) ‖c‖²` (the form `|φ_b|² ≤ κ |c_b|²` used by the coarse splitting). -/
theorem kappa_primitive (b : Fin 256) {c : EuclideanSpace ℝ (Fin 1536)} (hc : c ∈ Kb b) :
    ∃ φ ∈ fibre b, curv φ = c ∧ ∑ l, φ l ^ 2 ≤ 3321 / 500 * ‖c‖ ^ 2 := by
  obtain ⟨φ, hφ, rfl⟩ := Submodule.mem_map.mp hc
  exact ⟨φ, hφ, rfl, kappa_bound_norm b hφ⟩

/-- **The curvature map is injective on every fibre.** -/
theorem curv_injective_on_fibre (b : Fin 256) {φ : Fin 1024 → ℝ} (hφ : φ ∈ fibre b)
    (h0 : curv φ = 0) : φ = 0 := by
  have h := kappa_bound_norm b hφ
  rw [h0, norm_zero] at h
  have hz : ∑ l, φ l ^ 2 = 0 := le_antisymm (by simpa using h) (sum_nonneg fun l _ => sq_nonneg _)
  funext l
  have := (sum_eq_zero_iff_of_nonneg fun l _ => sq_nonneg (φ l)).mp hz l (mem_univ l)
  simpa using this

end Main

/-! ### Non-vacuity

A closed nonzero fibre field: `δ_{(x,0)} − δ_{(x',0)}` with `x = (1,0,0,0)` and `x' = (1,1,0,0)`
(links `256` and `320`). Both links touch the box at the origin, are not tree links, and lie in
the same two pins with the same sign, so the pins cancel. -/

section NonVacuity

/-- The integer values of the example field. -/
def nvInt (l : ℕ) : ℤ := if l = 256 then 1 else if l = 320 then -1 else 0

/-- The example field. -/
def nvField (l : Fin 1024) : ℝ := (nvInt l : ℝ)

theorem nvInt_pins : ∀ r < 64, (∑ o ∈ range 16, (nvInt ((4 * blockSite (r % 16) o + r / 16) % 1024)
    + nvInt ((4 * step (blockSite (r % 16) o) (r / 16) + r / 16) % 1024))) = 0 := by
  decide +kernel

theorem nvInt_support : ∀ l < 1024, nvInt l ≠ 0 → isTree l = false ∧ touches 0 l = true := by
  decide +kernel

theorem nvField_mem : nvField ∈ fibre 0 := by
  refine ⟨⟨fun l hl => ?_, fun r => ?_⟩, fun l hl => ?_⟩
  · by_contra h
    have h' : nvInt l ≠ 0 := fun h0 => h (by simp [nvField, h0])
    rw [(nvInt_support l l.2 h').1] at hl
    exact absurd hl (by decide)
  · have := nvInt_pins r r.2
    unfold pinSum
    rw [Fin.sum_univ_eq_sum_range (fun o => nvField (fl (4 * blockSite (r % 16) o + r / 16)) +
      nvField (fl (4 * step (blockSite (r % 16) o) (r / 16) + r / 16))) 16]
    have e : ∀ n, nvField (fl n) = (nvInt (n % 1024) : ℝ) := fun n => rfl
    simp only [e]
    exact_mod_cast this
  · by_contra h
    have h' : nvInt l ≠ 0 := fun h0 => h (by simp [nvField, h0])
    rw [(nvInt_support l l.2 h').2] at hl
    exact absurd hl (by decide)

theorem nvField_ne_zero : nvField ≠ 0 := by
  intro h
  have := congrFun h ⟨256, by norm_num⟩
  simp [nvField, nvInt] at this

/-- **κ applied to a closed nonzero fibre field** (a closed application of `kappa_bound`). -/
theorem kappa_bound_nvField :
    ∑ l, nvField l ^ 2 ≤ 3321 / 500 * ∑ p, curl nvField p ^ 2 :=
  kappa_bound 0 nvField_mem

/-- **κ in norm form for the closed field** (a closed application of `kappa_bound_norm`). -/
theorem kappa_bound_norm_nvField :
    ∑ l, nvField l ^ 2 ≤ 3321 / 500 * ‖curv nvField‖ ^ 2 :=
  kappa_bound_norm 0 nvField_mem

/-- **The curvature of the closed field is nonzero**, so the bound is not an identity `0 ≤ 0`
(a closed application of `curv_injective_on_fibre`). -/
theorem curv_nvField_ne_zero : curv nvField ≠ 0 :=
  fun h => nvField_ne_zero (curv_injective_on_fibre 0 nvField_mem h)

/-- **A closed element of a curvature fibre, with its certified primitive** (a closed application
of `kappa_primitive`). -/
theorem kappa_primitive_nvField : ∃ φ ∈ fibre 0, curv φ = curv nvField ∧
    ∑ l, φ l ^ 2 ≤ 3321 / 500 * ‖curv nvField‖ ^ 2 :=
  kappa_primitive 0 (Submodule.mem_map_of_mem nvField_mem)

/-- `3321/500 = 6.642`. -/
theorem kappa_value : (3321 : ℝ) / 500 = 6.642 := by norm_num

end NonVacuity

/-! ## 4. The coarse constant `C_coarse`

`C_coarse = 1 / λ_min(T | ℱ⁽⁰⁾)` with `T = ∑_b Π_{K_b}`, the sum over all `256` boxes. The
translations by `2t`, `t ∈ {0,1}⁴`, split the problem into the sixteen sectors of the characters
`χ_c`; in each sector a test field per class box and an integer positivity certificate give the
lower bound.

### Sector data in kernel form -/

section SectorKernel

/-- The character `χ_c(t) = (−1)^{#(c ∧ t)}` of the translation by `2t`, as an integer `±1`. -/
def chiZ (c t : ℕ) : ℤ :=
  (if bit c 0 * bit t 0 = 1 then -1 else 1) * (if bit c 1 * bit t 1 = 1 then -1 else 1) *
    (if bit c 2 * bit t 2 = 1 then -1 else 1) * (if bit c 3 * bit t 3 = 1 then -1 else 1)

/-- The translation part of a link: `l = trL (lT l) (fundamental link)`. -/
def lT (l : ℕ) : ℕ := trOf (l / 4)

/-- The fundamental link (`< 64`) of a link. -/
def lF (l : ℕ) : ℕ := 4 * clsOf (l / 4) + l % 4

/-- The translation part of a plaquette. -/
def pT (p : ℕ) : ℕ := trOf (p / 6)

/-- The fundamental plaquette (`< 96`) of a plaquette. -/
def pF (p : ℕ) : ℕ := 6 * clsOf (p / 6) + p % 6

/-- The plaquette of the fundamental plaquette `p₀ < 96`. -/
def fundP (p0 : ℕ) : ℕ := 6 * corner (p0 / 6) + p0 % 6

/-- The twisted plaquette operator of the sector `c` at the fundamental plaquette `p₀`:
four `(fundamental link, coefficient)` entries. -/
def dTw (c p0 : ℕ) : List (ℕ × ℤ) :=
  (List.range 4).map fun i => (lF (plaqLink (fundP p0) i % 1024),
    (if i < 2 then 1 else -1) * chiZ c (lT (plaqLink (fundP p0) i % 1024)))

/-- A row of a matrix `[I; C; 0]` (free, pivot and other rows), packed in base `2^K'`. -/
def rowZ (free piv : List ℕ) (wC : ℕ) (C : List ℕ) (K' s : ℕ) : ℤ :=
  match pos s free with
  | some j' => Int.ofNat (Nat.shiftLeft 1 (Nat.mul K' j'))
  | none => match pos s piv with
    | some i => prow wC K' free.length (C.getD i 0)
    | none => 0

/-- `∑ⱼ (C i j) · Yⱼ` for packed rows `Yⱼ` (kernel form), from the index `j`. -/
def combRows (w P : ℕ) : List ℤ → ℕ → ℤ
  | [], _ => 0
  | y :: ys, j => Int.add (Int.mul (kent w P j) y) (combRows w P ys (j + 1))

/-- A slot row of the test field `W = Z Y` (kernel form): `Yⱼ` at the free slot `j`,
`∑ⱼ C i j Yⱼ` at the pivot slot `i`, `0` elsewhere. -/
def rowW (kc : KCert) (ys : List ℤ) (s : ℕ) : ℤ :=
  match pos s kc.free with
  | some j => ys.getD j 0
  | none => match pos s kc.piv with
    | some i => combRows kc.wC (kc.C.getD i 0) ys 0
    | none => 0

/-- **The packed contribution of the class box `o` to the sector form** (kernel form):
`∑_q 2^β (Ẽ_q ⊗ J_q + J_q ⊗ Ẽ_q) − J_q ⊗ J_q`, with `J = d (Z Y)` on the patch and
`Ẽ_q = χ(t_q) E_{p₀(q)}`. The lists `ex`, `ey` are the packed rows of `E`. -/
def pairAcc (c o K beta wY : ℕ) (kc : KCert) (Yrows : List ℕ) (ex ey : List ℤ) : ℤ :=
  let yx := Yrows.map (prow wY K 45)
  let yy := Yrows.map (prow wY (Nat.mul K 45) 45)
  let wx := (List.range 96).map (rowW kc yx)
  let wy := (List.range 96).map (rowW kc yy)
  sumRange 216 fun q =>
    let P := patchPlaq (corner o) q
    let jx := lcz (fun s => wx.getD s 0) (dlocOf (corner o) q)
    let jy := lcz (fun s => wy.getD s 0) (dlocOf (corner o) q)
    let sg := chiZ c (pT P)
    let etx := Int.mul sg (ex.getD (pF P) 0)
    let ety := Int.mul sg (ey.getD (pF P) 0)
    Int.sub (Int.mul (Int.ofNat (Nat.pow 2 beta)) (Int.add (Int.mul etx jy) (Int.mul jx ety)))
      (Int.mul jx jy)

end SectorKernel

/-! ### Characters and sector parts -/

section SectorFacts

theorem bit_lt (Z a : ℕ) : bit Z a < 2 := by unfold bit; exact Nat.mod_lt _ (by norm_num)

/-- The link of the fundamental link `l₀ < 64`. -/
def fundL (l0 : ℕ) : ℕ := 4 * corner (l0 / 4) + l0 % 4

/-- **Finite facts for the sector decomposition**, one Boolean computation: every link and
plaquette is a translate of a unique fundamental one, the translations compose by `xor`, and the
characters are multiplicative and orthogonal. -/
def sectorCheck : Bool :=
  allBelow 1024 (fun l => trL (lT l) (fundL (lF l)) == l && decide (lT l < 16) && decide (lF l < 64)) &&
  allBelow 16 (fun t => allBelow 64 (fun l0 =>
    lT (trL t (fundL l0)) == t && lF (trL t (fundL l0)) == l0 && decide (fundL l0 < 1024))) &&
  allBelow 1536 (fun p => trP (pT p) (fundP (pF p)) == p && decide (pT p < 16) && decide (pF p < 96)) &&
  allBelow 16 (fun t => allBelow 96 (fun p0 =>
    pT (trP t (fundP p0)) == t && pF (trP t (fundP p0)) == p0 && decide (fundP p0 < 1536))) &&
  allBelow 16 (fun t => allBelow 16 (fun u => allBelow 4 (fun a =>
    bit (t ^^^ u) a == (bit t a + bit u a) % 2))) &&
  allBelow 256 (fun s => trSite 0 s == s) &&
  allBelow 16 (fun c => allBelow 16 (fun t => allBelow 16 (fun u =>
    chiZ c (t ^^^ u) == chiZ c t * chiZ c u))) &&
  allBelow 16 (fun c => allBelow 16 (fun t => chiZ c t * chiZ c t == 1)) &&
  allBelow 16 (fun c => allBelow 16 (fun c' =>
    sumRange 16 (fun t => chiZ c t * chiZ c' t) == if c = c' then 16 else 0)) &&
  allBelow 16 (fun t => sumRange 16 (fun c => chiZ c t) == if t = 0 then 16 else 0) &&
  allBelow 16 (fun o => allBelow 16 (fun t =>
    clsOf (trSite t (corner o)) == o && trOf (trSite t (corner o)) == t))

theorem sector_facts (h : sectorCheck = true) :
    (∀ l < 1024, trL (lT l) (fundL (lF l)) = l ∧ lT l < 16 ∧ lF l < 64) ∧
    (∀ t < 16, ∀ l0 < 64, lT (trL t (fundL l0)) = t ∧ lF (trL t (fundL l0)) = l0 ∧
      fundL l0 < 1024) ∧
    (∀ p < 1536, trP (pT p) (fundP (pF p)) = p ∧ pT p < 16 ∧ pF p < 96) ∧
    (∀ t < 16, ∀ p0 < 96, pT (trP t (fundP p0)) = t ∧ pF (trP t (fundP p0)) = p0 ∧
      fundP p0 < 1536) ∧
    (∀ t < 16, ∀ u < 16, ∀ a < 4, bit (t ^^^ u) a = (bit t a + bit u a) % 2) ∧
    (∀ s < 256, trSite 0 s = s) ∧
    (∀ c < 16, ∀ t < 16, ∀ u < 16, chiZ c (t ^^^ u) = chiZ c t * chiZ c u) ∧
    (∀ c < 16, ∀ t < 16, chiZ c t * chiZ c t = 1) ∧
    (∀ c < 16, ∀ c' < 16, ∑ t ∈ range 16, chiZ c t * chiZ c' t = if c = c' then 16 else 0) ∧
    (∀ t < 16, ∑ c ∈ range 16, chiZ c t = if t = 0 then 16 else 0) ∧
    (∀ o < 16, ∀ t < 16, clsOf (trSite t (corner o)) = o ∧ trOf (trSite t (corner o)) = t) := by
  unfold sectorCheck at h
  simp only [Bool.and_eq_true, allBelow_iff, beq_iff_eq, decide_eq_true_eq, sumRange_eq] at h
  obtain ⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨h1, h2⟩, h3⟩, h4⟩, h5⟩, h6⟩, h7⟩, h8⟩, h9⟩, h10⟩, h11⟩ := h
  refine ⟨fun l hl => ⟨(h1 l hl).1.1, (h1 l hl).1.2, (h1 l hl).2⟩,
    fun t ht l0 hl => ⟨(h2 t ht l0 hl).1.1, (h2 t ht l0 hl).1.2, (h2 t ht l0 hl).2⟩,
    fun p hp => ⟨(h3 p hp).1.1, (h3 p hp).1.2, (h3 p hp).2⟩,
    fun t ht p0 hp => ⟨(h4 t ht p0 hp).1.1, (h4 t ht p0 hp).1.2, (h4 t ht p0 hp).2⟩,
    h5, h6, h7, h8, fun c hc c' hc' => ?_, fun t ht => ?_, h11⟩
  · have := h9 c hc c' hc'; split_ifs at this ⊢ <;> exact this
  · have := h10 t ht; split_ifs at this ⊢ <;> exact this

theorem xor_lt16 {t u : ℕ} (ht : t < 16) (hu : u < 16) : t ^^^ u < 16 :=
  Nat.xor_lt_two_pow (n := 4) (by omega) (by omega)

/-- Translations compose by `xor` (on sites). -/
theorem trSite_comp (hg : geomCheck = true) (hsc : sectorCheck = true) {t u x : ℕ} (ht : t < 16)
    (hu : u < 16) (hx : x < 256) : trSite t (trSite u x) = trSite (t ^^^ u) x := by
  have hc := ((geom_facts hg).1 u hu x hx).2.2
  have hb := (sector_facts hsc).2.2.2.2.1 t ht u hu
  have hbt : ∀ a, bit t a < 2 := fun a => bit_lt t a
  have hbu : ∀ a, bit u a < 2 := fun a => bit_lt u a
  show site4 (coord (trSite u x) 0 + 2 * bit t 0) (coord (trSite u x) 1 + 2 * bit t 1)
      (coord (trSite u x) 2 + 2 * bit t 2) (coord (trSite u x) 3 + 2 * bit t 3) =
    site4 (coord x 0 + 2 * bit (t ^^^ u) 0) (coord x 1 + 2 * bit (t ^^^ u) 1)
      (coord x 2 + 2 * bit (t ^^^ u) 2) (coord x 3 + 2 * bit (t ^^^ u) 3)
  rw [(hc 0 (by norm_num)).2, (hc 1 (by norm_num)).2, (hc 2 (by norm_num)).2, (hc 3 (by norm_num)).2,
    hb 0 (by norm_num), hb 1 (by norm_num), hb 2 (by norm_num), hb 3 (by norm_num)]
  unfold site4
  have e : ∀ x a b : ℕ, a < 2 → b < 2 → ((x + 2 * a) % 4 + 2 * b) % 4 = (x + 2 * ((b + a) % 2)) % 4 := by
    intro x a b ha hb; omega
  rw [e _ _ _ (hbu 0) (hbt 0), e _ _ _ (hbu 1) (hbt 1), e _ _ _ (hbu 2) (hbt 2), e _ _ _ (hbu 3) (hbt 3)]

theorem trL_comp (hg : geomCheck = true) (hsc : sectorCheck = true) {t u l : ℕ} (ht : t < 16)
    (hu : u < 16) (hl : l < 1024) : trL t (trL u l) = trL (t ^^^ u) l := by
  have := ((geom_facts hg).1 u hu (l / 4) (by omega)).2.1
  show 4 * trSite t (trL u l / 4) + trL u l % 4 = 4 * trSite (t ^^^ u) (l / 4) + l % 4
  unfold trL
  rw [show (4 * trSite u (l / 4) + l % 4) / 4 = trSite u (l / 4) by omega,
    show (4 * trSite u (l / 4) + l % 4) % 4 = l % 4 by omega, trSite_comp hg hsc ht hu (by omega)]

theorem trP_comp (hg : geomCheck = true) (hsc : sectorCheck = true) {t u p : ℕ} (ht : t < 16)
    (hu : u < 16) (hp : p < 1536) : trP t (trP u p) = trP (t ^^^ u) p := by
  have := ((geom_facts hg).1 u hu (p / 6) (by omega)).2.1
  show 6 * trSite t (trP u p / 6) + trP u p % 6 = 6 * trSite (t ^^^ u) (p / 6) + p % 6
  unfold trP
  rw [show (6 * trSite u (p / 6) + p % 6) / 6 = trSite u (p / 6) by omega,
    show (6 * trSite u (p / 6) + p % 6) % 6 = p % 6 by omega, trSite_comp hg hsc ht hu (by omega)]

theorem trLink_comp (hg : geomCheck = true) (hsc : sectorCheck = true) {t u : ℕ} (ht : t < 16)
    (hu : u < 16) (l : Fin 1024) : trLink t (trLink u l) = trLink (t ^^^ u) l := by
  apply Fin.ext
  rw [trLink_val hg ht, trLink_val hg hu, trLink_val hg (xor_lt16 ht hu), trL_comp hg hsc ht hu l.2]

theorem trPlaq_val (hg : geomCheck = true) {t : ℕ} (ht : t < 16) (p : Fin 1536) :
    (trPlaq t p).val = trP t p := Nat.mod_eq_of_lt (trP_lt hg ht p.2)

theorem trPlaq_comp (hg : geomCheck = true) (hsc : sectorCheck = true) {t u : ℕ} (ht : t < 16)
    (hu : u < 16) (p : Fin 1536) : trPlaq t (trPlaq u p) = trPlaq (t ^^^ u) p := by
  apply Fin.ext
  rw [trPlaq_val hg ht, trPlaq_val hg hu, trPlaq_val hg (xor_lt16 ht hu), trP_comp hg hsc ht hu p.2]

theorem trLink_zero (hsc : sectorCheck = true) (l : Fin 1024) : trLink 0 l = l := by
  apply Fin.ext
  show (4 * trSite 0 (l.val / 4) + l.val % 4) % 1024 = l.val
  rw [(sector_facts hsc).2.2.2.2.2.1 _ (by omega)]
  omega

/-- Reindexing a sum over the sixteen translations by `t ↦ t xor s`. -/
theorem sum_xor {M : Type*} [AddCommMonoid M] {s : ℕ} (hs : s < 16) (f : ℕ → M) :
    ∑ t ∈ range 16, f (t ^^^ s) = ∑ t ∈ range 16, f t := by
  refine Finset.sum_nbij' (fun t => t ^^^ s) (fun t => t ^^^ s) ?_ ?_ ?_ ?_ ?_
  · intro t ht; exact mem_range.mpr (xor_lt16 (mem_range.mp ht) hs)
  · intro t ht; exact mem_range.mpr (xor_lt16 (mem_range.mp ht) hs)
  · intro t _; show t ^^^ s ^^^ s = t; rw [Nat.xor_assoc, Nat.xor_self, Nat.xor_zero]
  · intro t _; show t ^^^ s ^^^ s = t; rw [Nat.xor_assoc, Nat.xor_self, Nat.xor_zero]
  · intro t _; rfl

end SectorFacts

section SectorProjection

/-- The character as a real number. -/
noncomputable def chiR (c t : ℕ) : ℝ := (chiZ c t : ℝ)

/-- **The sector part** of a link field: `φ_c = (1/16) ∑_t χ_c(t) φ ∘ τ_t`. -/
noncomputable def secL (c : ℕ) (φ : Fin 1024 → ℝ) (l : Fin 1024) : ℝ :=
  (1 / 16 : ℝ) * ∑ t ∈ range 16, chiR c t * φ (trLink t l)

theorem chiR_mul (hsc : sectorCheck = true) {c t u : ℕ} (hc : c < 16) (ht : t < 16) (hu : u < 16) :
    chiR c (t ^^^ u) = chiR c t * chiR c u := by
  unfold chiR; rw [(sector_facts hsc).2.2.2.2.2.2.1 c hc t ht u hu]; push_cast; rfl

theorem chiR_sq (hsc : sectorCheck = true) {c t : ℕ} (hc : c < 16) (ht : t < 16) : chiR c t * chiR c t = 1 := by
  unfold chiR
  have := (sector_facts hsc).2.2.2.2.2.2.2.1 c hc t ht
  exact_mod_cast this

theorem chiR_orth (hsc : sectorCheck = true) {c c' : ℕ} (hc : c < 16) (hc' : c' < 16) :
    ∑ t ∈ range 16, chiR c t * chiR c' t = if c = c' then 16 else 0 := by
  have := (sector_facts hsc).2.2.2.2.2.2.2.2.1 c hc c' hc'
  unfold chiR
  split_ifs at this ⊢ <;> exact_mod_cast this

theorem chiR_sum (hsc : sectorCheck = true) {t : ℕ} (ht : t < 16) : ∑ c ∈ range 16, chiR c t = if t = 0 then 16 else 0 := by
  have := (sector_facts hsc).2.2.2.2.2.2.2.2.2.1 t ht
  unfold chiR
  split_ifs at this ⊢ <;> exact_mod_cast this

/-- **The sectors add up to the field.** -/
theorem sum_secL (hsc : sectorCheck = true) (φ : Fin 1024 → ℝ) (l : Fin 1024) : ∑ c ∈ range 16, secL c φ l = φ l := by
  unfold secL
  rw [← mul_sum, sum_comm]
  simp only [← sum_mul]
  rw [sum_congr rfl fun t ht => by rw [chiR_sum hsc (mem_range.mp ht)]]
  simp only [ite_mul, zero_mul]
  rw [sum_ite_eq', if_pos (mem_range.mpr (by norm_num)), trLink_zero hsc]
  ring

/-- **Covariance of a sector part**: `φ_c ∘ τ_s = χ_c(s) φ_c`. -/
theorem secL_tr (hg : geomCheck = true) (hsc : sectorCheck = true) {c s : ℕ} (hc : c < 16) (hs : s < 16) (φ : Fin 1024 → ℝ) (l : Fin 1024) :
    secL c φ (trLink s l) = chiR c s * secL c φ l := by
  unfold secL
  have e : ∀ t ∈ range 16, chiR c t * φ (trLink t (trLink s l)) =
      chiR c s * (chiR c (t ^^^ s) * φ (trLink (t ^^^ s) l)) := by
    intro t ht
    have ht' := mem_range.mp ht
    rw [trLink_comp hg hsc ht' hs, chiR_mul hsc hc ht' hs]
    have := chiR_sq hsc hc hs
    calc chiR c t * φ (trLink (t ^^^ s) l)
        = chiR c t * (chiR c s * chiR c s) * φ (trLink (t ^^^ s) l) := by rw [this, mul_one]
      _ = _ := by ring
  rw [sum_congr rfl e, ← mul_sum, sum_xor hs (fun t => chiR c t * φ (trLink t l))]
  ring

end SectorProjection

/-! ### Sector algebra and the variational bound -/

section SectorAlgebra

theorem curl_lin (s : Finset ℕ) (a : ℕ → ℝ) (ψ : ℕ → Fin 1024 → ℝ) (p : Fin 1536) :
    curl (fun l => ∑ t ∈ s, a t * ψ t l) p = ∑ t ∈ s, a t * curl (ψ t) p := by
  simp only [curl, mul_add, mul_sub, sum_add_distrib, sum_sub_distrib]

theorem curl_smul (a : ℝ) (φ : Fin 1024 → ℝ) (p : Fin 1536) :
    curl (fun l => a * φ l) p = a * curl φ p := by
  unfold curl; ring

theorem curl_add (φ ψ : Fin 1024 → ℝ) (p : Fin 1536) :
    curl (fun l => φ l + ψ l) p = curl φ p + curl ψ p := by
  unfold curl; ring

/-- The curvature of a sector part: `d φ_c (p) = (1/16) ∑_t χ_c(t) dφ(τ_t p)`. -/
theorem curl_secL (hg : geomCheck = true) (c : ℕ) (φ : Fin 1024 → ℝ) (p : Fin 1536) :
    curl (secL c φ) p = ∑ t ∈ range 16, ((1 / 16 : ℝ) * chiR c t) * curl φ (trPlaq t p) := by
  have e : secL c φ = fun l => ∑ t ∈ range 16, ((1 / 16 : ℝ) * chiR c t) *
      (fun t l => φ (trLink t l)) t l := by
    funext l; unfold secL; rw [mul_sum]; exact sum_congr rfl fun t _ => by ring
  rw [e, curl_lin]
  refine sum_congr rfl fun t ht => ?_
  rw [curl_tr hg (mem_range.mp ht)]

/-- **Covariance of the curvature of a sector part**: `dφ_c ∘ τ_s = χ_c(s) dφ_c`. -/
theorem curl_secL_tr (hg : geomCheck = true) (hsc : sectorCheck = true) {c s : ℕ} (hc : c < 16)
    (hs : s < 16) (φ : Fin 1024 → ℝ) (p : Fin 1536) :
    curl (secL c φ) (trPlaq s p) = chiR c s * curl (secL c φ) p := by
  rw [← curl_tr hg hs]
  have : (fun l => secL c φ (trLink s l)) = fun l => chiR c s * secL c φ l := by
    funext l; exact secL_tr hg hsc hc hs φ l
  rw [this, curl_smul]

/-- The section is invariant under the translations by `2t`. -/
theorem section_tr (hg : geomCheck = true) {t : ℕ} (ht : t < 16) {φ : Fin 1024 → ℝ}
    (hφ : φ ∈ section0) : (fun l => φ (trLink t l)) ∈ section0 := by
  refine ⟨fun l hl => ?_, fun r => ?_⟩
  · apply hφ.1
    rw [trLink_val hg ht, (geom_facts hg).2.1 t ht l l.2]; exact hl
  · have hr : (r : ℕ) / 16 < 4 := by omega
    have hZ : ((r : ℕ) % 16) ^^^ t < 16 := xor_lt16 (by omega) ht
    have hr' : 16 * ((r : ℕ) / 16) + (((r : ℕ) % 16) ^^^ t) < 64 := by omega
    have e1 : (16 * ((r : ℕ) / 16) + (((r : ℕ) % 16) ^^^ t)) % 16 = ((r : ℕ) % 16) ^^^ t := by
      omega
    have e2 : (16 * ((r : ℕ) / 16) + (((r : ℕ) % 16) ^^^ t)) / 16 = (r : ℕ) / 16 := by omega
    rw [← hφ.2 ⟨_, hr'⟩]
    unfold pinSum
    simp only [e1, e2]
    refine sum_congr rfl fun i _ => ?_
    have hbs : blockSite ((r : ℕ) % 16) i < 256 := site4_lt _ _ _ _
    have htb := (geom_facts hg).2.2.1 t ht ((r : ℕ) % 16) (by omega) i i.2
    have hst := (geom_facts hg).1 t ht _ hbs
    have ha : trLink t (fl (4 * blockSite ((r : ℕ) % 16) i + (r : ℕ) / 16)) =
        fl (4 * blockSite (((r : ℕ) % 16) ^^^ t) i + (r : ℕ) / 16) := by
      apply Fin.ext
      rw [trLink_val hg ht]
      show trL t ((4 * blockSite ((r : ℕ) % 16) i + (r : ℕ) / 16) % 1024) =
        (4 * blockSite (((r : ℕ) % 16) ^^^ t) i + (r : ℕ) / 16) % 1024
      rw [Nat.mod_eq_of_lt (by omega), trL_lin _ _ _ hr, htb]
      have := site4_lt (2 * bit (((r : ℕ) % 16) ^^^ t) 0 + bit i 0)
        (2 * bit (((r : ℕ) % 16) ^^^ t) 1 + bit i 1) (2 * bit (((r : ℕ) % 16) ^^^ t) 2 + bit i 2)
        (2 * bit (((r : ℕ) % 16) ^^^ t) 3 + bit i 3)
      unfold blockSite
      omega
    have hb' : trLink t (fl (4 * step (blockSite ((r : ℕ) % 16) i) ((r : ℕ) / 16) + (r : ℕ) / 16)) =
        fl (4 * step (blockSite (((r : ℕ) % 16) ^^^ t) i) ((r : ℕ) / 16) + (r : ℕ) / 16) := by
      apply Fin.ext
      rw [trLink_val hg ht]
      show trL t ((4 * step (blockSite ((r : ℕ) % 16) i) ((r : ℕ) / 16) + (r : ℕ) / 16) % 1024) =
        (4 * step (blockSite (((r : ℕ) % 16) ^^^ t) i) ((r : ℕ) / 16) + (r : ℕ) / 16) % 1024
      have hstep := (geom_facts hg).2.2.2.2.1 _ hbs _ hr
      rw [Nat.mod_eq_of_lt (by omega), trL_lin _ _ _ hr, ← (hst.2.2 _ hr).1, htb]
      have := (geom_facts hg).2.2.2.2.1 (blockSite (((r : ℕ) % 16) ^^^ t) i) (site4_lt _ _ _ _) _ hr
      omega
    rw [ha, hb']

/-- The sector parts of a section field lie in the section. -/
theorem secL_mem (hg : geomCheck = true) (c : ℕ) {φ : Fin 1024 → ℝ} (hφ : φ ∈ section0) :
    secL c φ ∈ section0 := by
  have e : secL c φ = ∑ t ∈ range 16, ((1 / 16 : ℝ) * chiR c t) • (fun l => φ (trLink t l)) := by
    funext l
    simp only [secL, Finset.sum_apply, Pi.smul_apply, smul_eq_mul, mul_sum]
    exact sum_congr rfl fun t _ => by ring
  rw [e]
  exact Submodule.sum_mem _ fun t ht => Submodule.smul_mem _ _ (section_tr hg (mem_range.mp ht) hφ)

/-- **Orthogonality of sectors**: plaquette functions that transform by different characters
are orthogonal. -/
theorem sector_orth (hg : geomCheck = true) (hsc : sectorCheck = true) {c c' : ℕ} (hc : c < 16)
    (hc' : c' < 16) (hne : c ≠ c') (f g : Fin 1536 → ℝ)
    (hf : ∀ s < 16, ∀ p, f (trPlaq s p) = chiR c s * f p)
    (hgc : ∀ s < 16, ∀ p, g (trPlaq s p) = chiR c' s * g p) : ∑ p, f p * g p = 0 := by
  have key : ∀ s ∈ range 16, ∑ p, f p * g p = chiR c s * chiR c' s * ∑ p, f p * g p := by
    intro s hs
    have hs' := mem_range.mp hs
    conv_lhs => rw [← Equiv.sum_comp (Function.Involutive.toPerm _ (trPlaq_invol hg hs'))
      (fun p => f p * g p)]
    simp only [Function.Involutive.coe_toPerm, hf s hs', hgc s hs', mul_sum]
    exact sum_congr rfl fun p _ => by ring
  have h16 : (16 : ℝ) * ∑ p, f p * g p = (∑ s ∈ range 16, chiR c s * chiR c' s) * ∑ p, f p * g p := by
    rw [sum_mul, ← sum_congr rfl key]; simp
  rw [chiR_orth hsc hc hc', if_neg hne, zero_mul] at h16
  linarith

/-- **The square norm splits over orthogonal sectors.** -/
theorem sum_sq_sectors (hg : geomCheck = true) (hsc : sectorCheck = true)
    (g : ℕ → Fin 1536 → ℝ) (hg' : ∀ c < 16, ∀ s < 16, ∀ p, g c (trPlaq s p) = chiR c s * g c p) :
    ∑ p, (∑ c ∈ range 16, g c p) ^ 2 = ∑ c ∈ range 16, ∑ p, g c p ^ 2 := by
  have e : ∀ p, (∑ c ∈ range 16, g c p) ^ 2 =
      ∑ c ∈ range 16, ∑ c' ∈ range 16, g c p * g c' p := fun p => by rw [sq, sum_mul_sum]
  simp only [e]
  rw [sum_comm]
  refine sum_congr rfl fun c hc => ?_
  rw [sum_comm]
  rw [sum_eq_single c]
  · exact sum_congr rfl fun p _ => by ring
  · intro c' hc' hne
    exact sector_orth hg hsc (mem_range.mp hc) (mem_range.mp hc') (Ne.symm hne) _ _
      (hg' c (mem_range.mp hc)) (hg' c' (mem_range.mp hc'))
  · intro h; exact absurd (mem_range.mpr (mem_range.mp hc)) h

/-- **The variational lower bound for a projection**: `‖Π_K c‖² ≥ 2 ⟨c, k⟩ − ‖k‖²` for `k ∈ K`. -/
theorem proj_lower {K : Submodule ℝ (EuclideanSpace ℝ (Fin 1536))} (c k : EuclideanSpace ℝ (Fin 1536))
    (hk : k ∈ K) : 2 * inner ℝ c k - ‖k‖ ^ 2 ≤ ‖K.starProjection c‖ ^ 2 := by
  have h0 := Submodule.starProjection_inner_eq_zero c k hk
  rw [inner_sub_left] at h0
  have h1 := norm_sub_sq_real (K.starProjection c) k
  nlinarith [sq_nonneg ‖K.starProjection c - k‖]

end SectorAlgebra

/-! ### Sector coordinates and the spanning certificate -/

section SectorParam

/-- **A sector certificate**: the sector basis `N = [I; C; 0]` over the `64` fundamental links
with its spanning certificate, the test fields `Y` of the sixteen class boxes, and a packed
LDLᵀ certificate. -/
structure SCert where
  /-- the free fundamental links -/
  free : List ℕ
  /-- the pivot fundamental links -/
  piv : List ℕ
  /-- the width of the pivot rows -/
  wC : ℕ
  /-- the pivot rows -/
  C : List ℕ
  /-- for each pivot, the pin multipliers `(row, coefficient)` -/
  W : List (List (ℕ × ℤ))
  /-- the scale of the spanning certificate -/
  dW : ℕ
  /-- the packing width of the spanning check -/
  K2 : ℕ
  /-- the packing width of the PSD check -/
  K : ℕ
  /-- the scale `2^β` of the test fields -/
  beta : ℕ
  /-- the width of the test-field rows -/
  wY : ℕ
  /-- the test fields: for each class box `o`, `k_o` rows of `45` entries -/
  Y : List (List ℕ)
  /-- the exponent of the scale `σ = 2^sig` of the LDLᵀ certificate -/
  sig : ℕ
  /-- the width of the LDLᵀ rows -/
  wM : ℕ
  /-- the LDLᵀ rows -/
  M : List ℕ
  /-- the width of the LDLᵀ weights -/
  wd : ℕ
  /-- the LDLᵀ weights (unsigned) -/
  d : ℕ

/-- The sector basis data viewed as a `KCert` (only `free`, `piv`, `wC`, `C`, `W`, `dW`, `K2` are
used). -/
def SCert.toK (sc : SCert) : KCert where
  free := sc.free
  piv := sc.piv
  wC := sc.wC
  C := sc.C
  W := sc.W
  dW := sc.dW
  K2 := sc.K2
  K := sc.K
  sig := 0
  wM := 1
  M := []
  wd := 1
  d := 0

/-- The sector basis `N l₀ j`. -/
def SCert.N (sc : SCert) (l0 j : ℕ) : ℤ := sc.toK.Z l0 j

/-- The twisted coefficient of the pin term `n` at the fundamental link `l₀`. -/
def twA (c n l0 : ℕ) : ℤ :=
  if isTree (n % 1024) = false ∧ lF (n % 1024) = l0 then chiZ c (lT (n % 1024)) else 0

/-- The packed twisted coefficient vector of the pin term `n` (kernel form). -/
def twc (c K2 n : ℕ) : ℤ :=
  if isTree (n % 1024) = true then 0
  else Int.mul (chiZ c (lT (n % 1024))) (Int.ofNat (Nat.shiftLeft 1 (Nat.mul K2 (lF (n % 1024)))))

/-- The twisted pin row `r` of the sector `c`, on the fundamental links. -/
def pinTw (c r l0 : ℕ) : ℤ :=
  ∑ o ∈ range 16, (twA c (4 * blockSite (r % 16) o + r / 16) l0 +
    twA c (4 * step (blockSite (r % 16) o) (r / 16) + r / 16) l0)

/-- The twisted pin row packed over the fundamental links (kernel form). -/
def pinTwPack (c K2 r : ℕ) : ℤ :=
  sumRange 16 fun o => Int.add (twc c K2 (4 * blockSite (r % 16) o + r / 16))
    (twc c K2 (4 * step (blockSite (r % 16) o) (r / 16) + r / 16))

theorem twc_eq (hsc : sectorCheck = true) (c K2 n : ℕ) : twc c K2 n = pk K2 96 (twA c n) := by
  have hlt : lF (n % 1024) < 64 := ((sector_facts hsc).1 _ (Nat.mod_lt _ (by norm_num))).2.2
  unfold twc twA
  by_cases h : isTree (n % 1024) = true
  · rw [if_pos h]; simp [pk, h]
  · rw [if_neg h, imul_eq, shift_one_eq]
    have hf : isTree (n % 1024) = false := by simpa using h
    have : (fun l0 => if isTree (n % 1024) = false ∧ lF (n % 1024) = l0 then chiZ c (lT (n % 1024))
        else 0) = fun l0 => chiZ c (lT (n % 1024)) * (if lF (n % 1024) = l0 then 1 else 0) := by
      funext l0; simp only [hf, true_and]; split_ifs <;> ring
    rw [this, pk_smul, pk_single _ _ _ (by omega)]

theorem pinTwPack_eq (hsc : sectorCheck = true) (c K2 r : ℕ) :
    pinTwPack c K2 r = pk K2 96 (pinTw c r) := by
  unfold pinTwPack pinTw
  rw [sumRange_eq, pk_sum]
  refine sum_congr rfl fun i _ => ?_
  rw [pk_add, ← twc_eq hsc, ← twc_eq hsc]; rfl

/-- Values of a covariant field through the fundamental links. -/
theorem cov_value (hsc : sectorCheck = true) (hg : geomCheck = true) {c : ℕ} {ψ : Fin 1024 → ℝ}
    (hcov : ∀ s < 16, ∀ l, ψ (trLink s l) = chiR c s * ψ l) (l : Fin 1024) :
    ψ l = chiR c (lT l) * ψ (fl (fundL (lF l))) := by
  obtain ⟨h1, h2, h3⟩ := (sector_facts hsc).1 l l.2
  have hf := ((sector_facts hsc).2.1 _ h2 _ h3).2.2
  have e : l = trLink (lT l) (fl (fundL (lF l))) := by
    apply Fin.ext
    rw [trLink_val hg h2]
    show (l : ℕ) = trL (lT l) (fundL (lF l) % 1024)
    rw [Nat.mod_eq_of_lt hf, h1]
  conv_lhs => rw [e]
  exact hcov _ h2 _

/-- A covariant section field at a pin term, as a combination of its fundamental values. -/
theorem cov_tw (hsc : sectorCheck = true) (hg : geomCheck = true) {c : ℕ} {ψ : Fin 1024 → ℝ}
    (hψ : ψ ∈ section0) (hcov : ∀ s < 16, ∀ l, ψ (trLink s l) = chiR c s * ψ l) (n : ℕ) :
    ψ (fl n) = ∑ l0 ∈ range 96, (twA c n l0 : ℝ) * ψ (fl (fundL l0)) := by
  have hlt : lF (n % 1024) < 64 := ((sector_facts hsc).1 _ (Nat.mod_lt _ (by norm_num))).2.2
  unfold twA
  by_cases htr : isTree (n % 1024) = true
  · rw [hψ.1 (fl n) (by simpa [fl] using htr)]
    symm; refine sum_eq_zero fun l0 _ => ?_
    simp [htr]
  · have hf : isTree (n % 1024) = false := by simpa using htr
    simp only [hf, true_and]
    push_cast
    simp only [ite_mul, zero_mul]
    rw [sum_ite_eq, if_pos (mem_range.mpr (by omega)), cov_value hsc hg hcov (fl n)]
    rfl

theorem pinSum_tw (hsc : sectorCheck = true) (hg : geomCheck = true) {c : ℕ} {ψ : Fin 1024 → ℝ}
    (hψ : ψ ∈ section0) (hcov : ∀ s < 16, ∀ l, ψ (trLink s l) = chiR c s * ψ l) (r : ℕ)
    (hr : r < 64) :
    pinSum ⟨r, hr⟩ ψ = ∑ l0 ∈ range 96, (pinTw c r l0 : ℝ) * ψ (fl (fundL l0)) := by
  unfold pinSum pinTw
  rw [Fin.sum_univ_eq_sum_range (fun i => ψ (fl (4 * blockSite (r % 16) i + r / 16)) +
    ψ (fl (4 * step (blockSite (r % 16) i) (r / 16) + r / 16))) 16]
  have e : ∀ i ∈ range 16, ψ (fl (4 * blockSite (r % 16) i + r / 16)) +
      ψ (fl (4 * step (blockSite (r % 16) i) (r / 16) + r / 16)) =
      ∑ l0 ∈ range 96, ((twA c (4 * blockSite (r % 16) i + r / 16) l0 : ℝ) +
        (twA c (4 * step (blockSite (r % 16) i) (r / 16) + r / 16) l0 : ℝ)) * ψ (fl (fundL l0)) := by
    intro i _
    rw [cov_tw hsc hg hψ hcov (4 * blockSite (r % 16) i + r / 16),
      cov_tw hsc hg hψ hcov (4 * step (blockSite (r % 16) i) (r / 16) + r / 16), ← sum_add_distrib]
    exact sum_congr rfl fun s _ => by ring
  rw [sum_congr rfl e, sum_comm]
  refine sum_congr rfl fun s _ => ?_
  rw [← sum_mul]
  push_cast
  rfl

/-- **The spanning check of a sector** for the pivot `i` (kernel form). -/
def spanOKS (c : ℕ) (sc : SCert) (i : ℕ) : Bool :=
  (sc.W.getD i []).all (fun e => decide (e.1 < 64)) &&
  decide (32 * wsum (sc.W.getD i []) + sc.dW * (1 + sc.free.length * Nat.pow 2 (sc.wC - 1)) <
    Nat.pow 2 sc.K2) &&
  decide (lcz (pinTwPack c sc.K2) (sc.W.getD i []) = rowPack sc.toK i)

/-- **The basis checks of a sector**: roles, ranges and spanning (kernel form). -/
def sBasis (c : ℕ) (sc : SCert) : Bool :=
  allBelow 64 (fun l0 => sc.free.contains l0 || sc.piv.contains l0 || isTree (fundL l0)) &&
  sc.free.all (fun s => decide (s < 64)) && sc.piv.all (fun s => decide (s < 64)) &&
  decide (0 < sc.dW) && decide (1 ≤ sc.wC) && decide (sc.free.length = 45) &&
  allBelow sc.piv.length (spanOKS c sc)

theorem pinTw_bound (c r l0 : ℕ) : |pinTw c r l0| ≤ 32 := by
  unfold pinTw
  refine (abs_sum_le_sum_abs _ _).trans ?_
  have hc : ∀ t, |chiZ c t| ≤ 1 := fun t => by
    unfold chiZ; split_ifs <;> norm_num
  have : ∀ o ∈ range 16, |twA c (4 * blockSite (r % 16) o + r / 16) l0 +
      twA c (4 * step (blockSite (r % 16) o) (r / 16) + r / 16) l0| ≤ 2 := by
    intro o _
    refine (abs_add_le _ _).trans ?_
    unfold twA
    have h1 := hc (lT ((4 * blockSite (r % 16) o + r / 16) % 1024))
    have h2 := hc (lT ((4 * step (blockSite (r % 16) o) (r / 16) + r / 16) % 1024))
    split_ifs <;> simp <;> linarith
  refine (sum_le_sum this).trans ?_
  simp

/-- **Spanning for a sector.** Every pivot value of a covariant section field is the combination
of its free values. -/
theorem sector_pivot (hsc : sectorCheck = true) (hg : geomCheck = true) {c : ℕ} {sc : SCert}
    (hb : sBasis c sc = true) {ψ : Fin 1024 → ℝ} (hψ : ψ ∈ section0)
    (hcov : ∀ s < 16, ∀ l, ψ (trLink s l) = chiR c s * ψ l) {i : ℕ} (hi : i < sc.piv.length) :
    ψ (fl (fundL (sc.piv.getD i 0))) = ∑ j ∈ range sc.free.length,
      (ent sc.wC (sc.C.getD i 0) j : ℝ) * ψ (fl (fundL (sc.free.getD j 0))) := by
  unfold sBasis at hb
  rw [Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true,
    Bool.and_eq_true, decide_eq_true_eq, decide_eq_true_eq, decide_eq_true_eq, List.all_eq_true,
    List.all_eq_true] at hb
  obtain ⟨⟨⟨⟨⟨⟨_, hfree⟩, hpiv⟩, hdW⟩, hwC⟩, _⟩, hspan⟩ := hb
  have hsp := (allBelow_iff.mp hspan) i hi
  unfold spanOKS at hsp
  rw [Bool.and_eq_true, Bool.and_eq_true, decide_eq_true_eq, decide_eq_true_eq,
    List.all_eq_true] at hsp
  obtain ⟨⟨hr64, hbig⟩, heq⟩ := hsp
  have hL : ∀ e ∈ sc.W.getD i [], e.1 < 64 := fun e he => of_decide_eq_true (hr64 e he)
  have hp64 : sc.piv.getD i 0 < 64 := of_decide_eq_true (hpiv _ (by
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hi]; exact List.getElem_mem hi))
  have hf96 : ∀ f ∈ sc.toK.free, f < 96 := fun f hf => by
    have := of_decide_eq_true (hfree f hf); omega
  set A : ℕ → ℤ := fun l0 => ((sc.W.getD i []).map fun e => e.2 * pinTw c e.1 l0).sum with hA
  have hrp := rowPack_eq sc.toK i (by show sc.piv.getD i 0 < 96; omega) hf96
  change rowPack sc.toK i = pk sc.K2 96 (spanRow sc.toK i) at hrp
  have hpk : pk sc.K2 96 A = pk sc.K2 96 (spanRow sc.toK i) := by
    rw [← hrp, ← heq, lcz_eq, hA, pk_lc]
    refine congrArg List.sum (List.map_congr_left fun e _ => ?_)
    rw [pinTwPack_eq hsc]
  rw [natpow_eq, natpow_eq] at hbig
  have hbig' : ((32 * wsum (sc.W.getD i []) + sc.dW * (1 + sc.free.length * 2 ^ (sc.wC - 1)) : ℕ)
      : ℤ) < ((2 ^ sc.K2 : ℕ) : ℤ) := by exact_mod_cast hbig
  push_cast at hbig'
  have hAR : ∀ s < 96, A s = spanRow sc.toK i s := by
    have h0 : pk sc.K2 96 (fun s => A s - spanRow sc.toK i s) = 0 := by
      rw [pk_sub, hpk, sub_self]
    have hbd : ∀ s < 96, |A s - spanRow sc.toK i s| < 2 ^ sc.K2 := by
      intro s _
      have h1 : |A s| ≤ (wsum (sc.W.getD i []) : ℤ) * 32 :=
        lc_bound _ (fun n => pinTw c n s) 32 fun _ => pinTw_bound _ _ _
      have h2 := abs_spanRow_le sc.toK i s hwC
      have e1 : sc.toK.dW = sc.dW := rfl
      have e2 : sc.toK.free = sc.free := rfl
      have e3 : sc.toK.wC = sc.wC := rfl
      rw [e1, e2, e3] at h2
      calc |A s - spanRow sc.toK i s| ≤ |A s| + |spanRow sc.toK i s| := abs_sub _ _
        _ < 2 ^ sc.K2 := by linarith
    intro s hs'
    exact sub_eq_zero.mp (eq_zero_of_pk hbd h0 s hs')
  have hzero : ∑ s ∈ range 96, (A s : ℝ) * ψ (fl (fundL s)) = 0 := by
    rw [hA, sum_list_comm]
    refine List.sum_eq_zero fun x hx => ?_
    obtain ⟨e, he, rfl⟩ := List.mem_map.mp hx
    rw [← pinSum_tw hsc hg hψ hcov e.1 (hL e he), hψ.2 ⟨e.1, hL e he⟩, mul_zero]
  have h3 : ∑ s ∈ range 96, (spanRow sc.toK i s : ℝ) * ψ (fl (fundL s)) = 0 := by
    rw [← hzero]; exact sum_congr rfl fun s hs' => by rw [hAR s (mem_range.mp hs')]
  have hf96' : ∀ j < sc.toK.free.length, sc.toK.free.getD j 0 < 96 := fun j hj => hf96 _ (by
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hj]; exact List.getElem_mem hj)
  rw [spanRow_sum sc.toK i (fun s => ψ (fl (fundL s))) (by show sc.piv.getD i 0 < 96; omega)
    hf96'] at h3
  have hdW' : (0 : ℝ) < sc.dW := by exact_mod_cast hdW
  have := (mul_eq_zero.mp h3).resolve_left hdW'.ne'
  exact sub_eq_zero.mp this

/-- **The sector coordinates.** Every fundamental value of a covariant section field is
`∑ⱼ N l₀ j · yⱼ`, with `yⱼ` its value at the free link `j`. -/
theorem sector_value (hsc : sectorCheck = true) (hg : geomCheck = true) {c : ℕ} {sc : SCert}
    (hb : sBasis c sc = true) {ψ : Fin 1024 → ℝ} (hψ : ψ ∈ section0)
    (hcov : ∀ s < 16, ∀ l, ψ (trLink s l) = chiR c s * ψ l) {l0 : ℕ} (hl0 : l0 < 64) :
    ψ (fl (fundL l0)) = ∑ j ∈ range sc.free.length,
      (sc.N l0 j : ℝ) * ψ (fl (fundL (sc.free.getD j 0))) := by
  have hroles := hb
  unfold sBasis at hroles
  rw [Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true,
    Bool.and_eq_true] at hroles
  have hr := (allBelow_iff.mp hroles.1.1.1.1.1.1) l0 hl0
  unfold SCert.N KCert.Z
  cases hf : pos l0 sc.toK.free with
  | some j' =>
    obtain ⟨hj', hget⟩ := pos_spec hf
    simp only
    push_cast
    simp only [ite_mul, one_mul, zero_mul]
    rw [sum_ite_eq, if_pos (mem_range.mpr (show j' < sc.free.length from hj'))]
    rw [show sc.toK.free = sc.free from rfl] at hget
    rw [hget]
  | none =>
    cases hp : pos l0 sc.toK.piv with
    | some i =>
      obtain ⟨hi, hget⟩ := pos_spec hp
      simp only
      rw [show sc.toK.piv = sc.piv from rfl] at hget hi
      rw [← hget]
      exact sector_pivot hsc hg hb hψ hcov hi
    | none =>
      simp only [Int.cast_zero, zero_mul, sum_const_zero]
      rw [Bool.or_eq_true, Bool.or_eq_true, List.contains_iff_mem, List.contains_iff_mem] at hr
      rcases hr with (h | h) | h
      · obtain ⟨j, hj⟩ := pos_of_mem h; rw [show sc.toK.free = sc.free from rfl] at hf
        rw [hf] at hj; exact absurd hj (by simp)
      · obtain ⟨j, hj⟩ := pos_of_mem h; rw [show sc.toK.piv = sc.piv from rfl] at hp
        rw [hp] at hj; exact absurd hj (by simp)
      · have hlt := ((sector_facts hsc).2.1 0 (by norm_num) l0 hl0).2.2
        exact hψ.1 (fl (fundL l0)) (by rw [fl_val hlt]; exact h)

end SectorParam

/-! ### The curvature of a sector field -/

section SectorFields

theorem flp_fin (p : Fin 1536) : flp p = p := Fin.ext (Nat.mod_eq_of_lt p.2)

/-- The plaquette `p` is the translate of its fundamental plaquette. -/
theorem plaq_decomp (hg : geomCheck = true) (hsc : sectorCheck = true) (p : Fin 1536) :
    p = trPlaq (pT p) (flp (fundP (pF p))) := by
  obtain ⟨h1, h2, h3⟩ := (sector_facts hsc).2.2.1 p p.2
  have hf := ((sector_facts hsc).2.2.2.1 _ h2 _ h3).2.2
  apply Fin.ext
  rw [trPlaq_val hg h2]
  show (p : ℕ) = trP (pT p) (fundP (pF p) % 1536)
  rw [Nat.mod_eq_of_lt hf, h1]

/-- **The curvature of a covariant field**: `dψ(p) = χ(t_p) (D_c u)(p₀)`, with `D_c` the twisted
plaquette operator on the fundamental values `u`. -/
theorem curl_cov (hg : geomCheck = true) (hsc : sectorCheck = true) {c : ℕ} {ψ : Fin 1024 → ℝ}
    (hcov : ∀ s < 16, ∀ l, ψ (trLink s l) = chiR c s * ψ l) (p : Fin 1536) :
    curl ψ p = chiR c (pT p) *
      ((dTw c (pF p)).map fun e => (e.2 : ℝ) * ψ (fl (fundL e.1))).sum := by
  obtain ⟨_, h2, h3⟩ := (sector_facts hsc).2.2.1 p p.2
  have hf := ((sector_facts hsc).2.2.2.1 _ h2 _ h3).2.2
  conv_lhs => rw [plaq_decomp hg hsc p]
  rw [← curl_tr hg h2]
  have e : (fun l => ψ (trLink (pT p) l)) = fun l => chiR c (pT p) * ψ l := by
    funext l; exact hcov _ h2 l
  rw [e, curl_smul]
  have hv : ∀ n, ψ (fl n) = chiR c (lT (n % 1024)) * ψ (fl (fundL (lF (n % 1024)))) :=
    fun n => cov_value hsc hg hcov (fl n)
  have key : curl ψ (flp (fundP (pF p))) =
      ((dTw c (pF p)).map fun e => (e.2 : ℝ) * ψ (fl (fundL e.1))).sum := by
    rw [flp_val hf]
    unfold curl dTw
    rw [List.map_map, show List.range 4 = [0, 1, 2, 3] from rfl]
    simp only [List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, Function.comp_apply]
    rw [hv (plaqLink (fundP (pF p)) 0), hv (plaqLink (fundP (pF p)) 1),
      hv (plaqLink (fundP (pF p)) 2), hv (plaqLink (fundP (pF p)) 3)]
    unfold chiR
    push_cast
    norm_num
    ring
  rw [key]

/-- Counting the translates: `∑_p G(p₀(p)) = 16 ∑_{p₀} G(p₀)`. -/
theorem sum_pF (hg : geomCheck = true) (hsc : sectorCheck = true) (G : ℕ → ℝ) :
    ∑ p : Fin 1536, G (pF p) = 16 * ∑ p0 ∈ range 96, G p0 := by
  rw [sum_fin_eq_range (fun p => G (pF p)) (fun n => G (pF n)) (fun n h => rfl)]
  have : ∑ n ∈ range 1536, G (pF n) = ∑ x ∈ range 16 ×ˢ range 96, G x.2 := by
    refine Finset.sum_nbij' (fun n => (pT n, pF n)) (fun x => trP x.1 (fundP x.2)) ?_ ?_ ?_ ?_ ?_
    · intro n hn
      obtain ⟨_, h2, h3⟩ := (sector_facts hsc).2.2.1 n (mem_range.mp hn)
      exact mem_product.mpr ⟨mem_range.mpr h2, mem_range.mpr h3⟩
    · intro x hx
      obtain ⟨h1, h2⟩ := mem_product.mp hx
      have hf := ((sector_facts hsc).2.2.2.1 _ (mem_range.mp h1) _ (mem_range.mp h2)).2.2
      exact mem_range.mpr (trP_lt hg (mem_range.mp h1) hf)
    · intro n hn; exact ((sector_facts hsc).2.2.1 n (mem_range.mp hn)).1
    · intro x hx
      obtain ⟨h1, h2⟩ := mem_product.mp hx
      obtain ⟨e1, e2, _⟩ := (sector_facts hsc).2.2.2.1 _ (mem_range.mp h1) _ (mem_range.mp h2)
      exact Prod.ext e1 e2
    · intro n _; rfl
  rw [this, Finset.sum_product]
  simp

end SectorFields

/-! ### The κ bases lie in the fibres -/

section TestFieldSupport

/-- A field supported near the box and zero on tree links, at a pin term (as in `phi_cnt`). -/
theorem phi_cnt' (hs : slotCheck = true) {o : ℕ} (ho : o < 16) {φ : Fin 1024 → ℝ}
    (htree : ∀ l : Fin 1024, isTree l = true → φ l = 0)
    (hsupp : ∀ l : Fin 1024, touches (corner o) l = false → φ l = 0) (n : ℕ) :
    φ (fl n) = ∑ s ∈ range 96, (cnt (corner o) n s : ℝ) * φ (fl (slotLink (corner o) s)) := by
  unfold cnt
  by_cases ht : touches (corner o) (n % 1024) = true
  · have hlt := ((slot_facts hs ho).2.1 _ (Nat.mod_lt _ (by norm_num)) ht).1
    by_cases htr : isTree (n % 1024) = true
    · rw [htree (fl n) (by simpa [fl] using htr)]; symm; refine sum_eq_zero fun s _ => ?_
      simp [htr]
    · have hok : (touches (corner o) (n % 1024) && !isTree (n % 1024)) = true := by
        simp [ht, htr]
      simp only [hok, true_and]
      push_cast
      simp only [ite_mul, one_mul, zero_mul]
      rw [sum_ite_eq, if_pos (mem_range.mpr hlt)]
      exact phi_touch hs ho n ht
  · rw [Bool.not_eq_true] at ht
    rw [hsupp (fl n) ht]; symm; refine sum_eq_zero fun s _ => ?_
    simp [ht]

theorem pinSum_slots' (hs : slotCheck = true) {o : ℕ} (ho : o < 16) {φ : Fin 1024 → ℝ}
    (htree : ∀ l : Fin 1024, isTree l = true → φ l = 0)
    (hsupp : ∀ l : Fin 1024, touches (corner o) l = false → φ l = 0) (r : ℕ) (hr : r < 64) :
    pinSum ⟨r, hr⟩ φ =
      ∑ s ∈ range 96, (pinA (corner o) r s : ℝ) * φ (fl (slotLink (corner o) s)) := by
  unfold pinSum pinA
  rw [Fin.sum_univ_eq_sum_range (fun i => φ (fl (4 * blockSite (r % 16) i + r / 16)) +
    φ (fl (4 * step (blockSite (r % 16) i) (r / 16) + r / 16))) 16]
  have e : ∀ i ∈ range 16, φ (fl (4 * blockSite (r % 16) i + r / 16)) +
      φ (fl (4 * step (blockSite (r % 16) i) (r / 16) + r / 16)) =
      ∑ s ∈ range 96, ((cnt (corner o) (4 * blockSite (r % 16) i + r / 16) s : ℝ) +
        (cnt (corner o) (4 * step (blockSite (r % 16) i) (r / 16) + r / 16) s : ℝ)) *
          φ (fl (slotLink (corner o) s)) := by
    intro i _
    rw [phi_cnt' hs ho htree hsupp (4 * blockSite (r % 16) i + r / 16),
      phi_cnt' hs ho htree hsupp (4 * step (blockSite (r % 16) i) (r / 16) + r / 16),
      ← sum_add_distrib]
    exact sum_congr rfl fun s _ => by ring
  rw [sum_congr rfl e, sum_comm]
  refine sum_congr rfl fun s _ => ?_
  rw [← sum_mul]
  push_cast
  rfl

theorem cnt_sum_le (b n : ℕ) : ∑ s ∈ range 96, |cnt b n s| ≤ 1 := by
  unfold cnt
  by_cases h : (touches b (n % 1024) && !isTree (n % 1024)) = true
  · simp only [h, true_and]
    have : ∀ s ∈ range 96, |(if slotOf b (n % 1024) = s then (1 : ℤ) else 0)| =
        if slotOf b (n % 1024) = s then 1 else 0 := fun s _ => by split_ifs <;> simp
    rw [sum_congr rfl this, sum_ite_eq]
    split_ifs <;> norm_num
  · simp [h]

theorem pinA_sum_le (b r : ℕ) : ∑ s ∈ range 96, |pinA b r s| ≤ 32 := by
  unfold pinA
  calc ∑ s ∈ range 96, |∑ o ∈ range 16, (cnt b (4 * blockSite (r % 16) o + r / 16) s +
        cnt b (4 * step (blockSite (r % 16) o) (r / 16) + r / 16) s)|
      ≤ ∑ s ∈ range 96, ∑ o ∈ range 16, (|cnt b (4 * blockSite (r % 16) o + r / 16) s| +
        |cnt b (4 * step (blockSite (r % 16) o) (r / 16) + r / 16) s|) :=
        sum_le_sum fun s _ => (abs_sum_le_sum_abs _ _).trans (sum_le_sum fun o _ => abs_add_le _ _)
    _ = ∑ o ∈ range 16, (∑ s ∈ range 96, |cnt b (4 * blockSite (r % 16) o + r / 16) s| +
        ∑ s ∈ range 96, |cnt b (4 * step (blockSite (r % 16) o) (r / 16) + r / 16) s|) := by
        rw [sum_comm]; exact sum_congr rfl fun o _ => sum_add_distrib
    _ ≤ ∑ o ∈ range 16, (1 + 1) :=
        sum_le_sum fun o _ => add_le_add (cnt_sum_le _ _) (cnt_sum_le _ _)
    _ = 32 := by simp

/-- The packed slot vector `∑_s pinA r s · Z s` of the pin row `r` (kernel form). -/
def zPin (o : ℕ) (kc : KCert) (r : ℕ) : ℤ :=
  sumRange 16 fun o' =>
    Int.add (if (touches (corner o) ((4 * blockSite (r % 16) o' + r / 16) % 1024) &&
        !isTree ((4 * blockSite (r % 16) o' + r / 16) % 1024)) = true then
      ((List.range 96).map (kc.zp 16)).getD
        (slotOf (corner o) ((4 * blockSite (r % 16) o' + r / 16) % 1024)) 0 else 0)
    (if (touches (corner o) ((4 * step (blockSite (r % 16) o') (r / 16) + r / 16) % 1024) &&
        !isTree ((4 * step (blockSite (r % 16) o') (r / 16) + r / 16) % 1024)) = true then
      ((List.range 96).map (kc.zp 16)).getD
        (slotOf (corner o) ((4 * step (blockSite (r % 16) o') (r / 16) + r / 16) % 1024)) 0
      else 0)

/-- **The fibre parametrisation lies in the fibre** (kernel form): the parametrising slots are not
tree links, and every pin vanishes on every column of `Z`. -/
def zCheck (o : ℕ) (kc : KCert) : Bool :=
  kc.free.all (fun s => !isTree (slotLink (corner o) s)) &&
  kc.piv.all (fun s => !isTree (slotLink (corner o) s)) &&
  decide (kc.wC = 3) &&
  allBelow 64 (fun r => decide (zPin o kc r = 0))

theorem zterm_eq (hs : slotCheck = true) {o : ℕ} (ho : o < 16) (kc : KCert) (n : ℕ) :
    (if (touches (corner o) (n % 1024) && !isTree (n % 1024)) = true then
      ((List.range 96).map (kc.zp 16)).getD (slotOf (corner o) (n % 1024)) 0 else 0) =
    pk 16 kc.free.length (fun j => ∑ s ∈ range 96, cnt (corner o) n s * kc.Z s j) := by
  rw [pk_sum]
  by_cases h : (touches (corner o) (n % 1024) && !isTree (n % 1024)) = true
  · have ht : touches (corner o) (n % 1024) = true := by
      simp only [Bool.and_eq_true] at h; exact h.1
    have hlt := ((slot_facts hs ho).2.1 _ (Nat.mod_lt _ (by norm_num)) ht).1
    rw [if_pos h, KCert.getD_map_range _ hlt, kc.zp_eq]
    have e : ∀ s ∈ range 96, pk 16 kc.free.length (fun j => cnt (corner o) n s * kc.Z s j) =
        if slotOf (corner o) (n % 1024) = s then pk 16 kc.free.length (kc.Z s) else 0 := by
      intro s _
      unfold cnt
      simp only [h, true_and]
      split_ifs <;> simp [pk]
    rw [sum_congr rfl e, sum_ite_eq, if_pos (mem_range.mpr hlt)]
  · rw [if_neg h]; symm
    refine sum_eq_zero fun s _ => ?_
    unfold cnt; simp [h, pk]

theorem zPin_eq (hs : slotCheck = true) {o : ℕ} (ho : o < 16) (kc : KCert) (r : ℕ) :
    zPin o kc r = pk 16 kc.free.length (fun j => ∑ s ∈ range 96, pinA (corner o) r s * kc.Z s j) := by
  unfold zPin
  rw [sumRange_eq]
  simp only [iadd_eq, zterm_eq hs ho, ← pk_add]
  rw [← pk_sum]
  refine pk_congr fun j _ => ?_
  unfold pinA
  simp only [add_mul, sum_mul, sum_add_distrib]
  rw [sum_comm, sum_comm (s := range 16) (t := range 96)]

theorem zCheck_pins (hs : slotCheck = true) {o : ℕ} (ho : o < 16) {kc : KCert}
    (hz : zCheck o kc = true) (r : ℕ) (hr : r < 64) (j : ℕ) (hj : j < kc.free.length) :
    ∑ s ∈ range 96, pinA (corner o) r s * kc.Z s j = 0 := by
  unfold zCheck at hz
  rw [Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true, decide_eq_true_eq] at hz
  have hzr := of_decide_eq_true ((allBelow_iff.mp hz.2) r hr)
  rw [zPin_eq hs ho] at hzr
  have hw : kc.wC = 3 := hz.1.2
  refine eq_zero_of_pk (K := 16) (fun j _ => ?_) hzr j hj
  have hb : ∀ s, |kc.Z s j| ≤ 4 := fun s => by
    have := kc.abs_Z_le (by omega) s j; rw [hw] at this; simpa using this
  calc |∑ s ∈ range 96, pinA (corner o) r s * kc.Z s j|
      ≤ ∑ s ∈ range 96, |pinA (corner o) r s| * 4 :=
        (abs_sum_le_sum_abs _ _).trans (sum_le_sum fun s _ => by
          rw [abs_mul]; exact mul_le_mul_of_nonneg_left (hb s) (abs_nonneg _))
    _ ≤ 32 * 4 := by
        rw [← sum_mul]; exact mul_le_mul_of_nonneg_right (pinA_sum_le _ _) (by norm_num)
    _ < 2 ^ 16 := by norm_num

end TestFieldSupport

/-! ### The sector form -/

section SectorForm

/-- Test-field entry `Y_o j i` of a sector certificate. -/
def SCert.Yent (sc : SCert) (o j i : ℕ) : ℤ := ent sc.wY ((sc.Y.getD o []).getD j 0) i

/-- Slot rows of the test field `W_o = Z_o Y_o` (with `Z_o` from the κ certificate `kc o`). -/
def SCert.Wt (kc : ℕ → KCert) (sc : SCert) (o s i : ℕ) : ℤ :=
  ∑ j ∈ range (kc o).free.length, (kc o).Z s j * sc.Yent o j i

/-- The curvature rows of the test field on the patch: `J q i = ∑ₑ cₑ Wt sₑ i`. -/
def SCert.J (kc : ℕ → KCert) (sc : SCert) (o q i : ℕ) : ℤ :=
  ((dlocOf (corner o) q).map fun e => e.2 * sc.Wt kc o e.1 i).sum

/-- The sector curvature rows `E p₀ i = ∑ₑ cₑ N lₑ i` (twisted plaquette operator times basis). -/
def SCert.E (c : ℕ) (sc : SCert) (p0 i : ℕ) : ℤ := ((dTw c p0).map fun e => e.2 * sc.N e.1 i).sum

/-- The sector curvature at the patch slot `q` of the class box `o`. -/
def SCert.Et (c : ℕ) (sc : SCert) (o q i : ℕ) : ℤ :=
  chiZ c (pT (patchPlaq (corner o) q)) * sc.E c (pF (patchPlaq (corner o) q)) i

/-- **The sector form** `σ (10000 ∑_o ∑_q [2^β (Ẽ ⊗ J + J ⊗ Ẽ) − J ⊗ J] − 23851 · 2^(2β) ∑ E ⊗ E)`. -/
def SCert.H (kc : ℕ → KCert) (c : ℕ) (sc : SCert) (i j : ℕ) : ℤ :=
  2 ^ sc.sig * (10000 * ∑ o ∈ range 16, ∑ q ∈ range 216,
    (2 ^ sc.beta * (sc.Et c o q i * sc.J kc o q j + sc.J kc o q i * sc.Et c o q j) -
      sc.J kc o q i * sc.J kc o q j) -
    23851 * 2 ^ (2 * sc.beta) * ∑ p0 ∈ range 96, sc.E c p0 i * sc.E c p0 j)

/-- The packed sector rows `E p₀` in base `2^K'` (kernel form). -/
def SCert.ex (c : ℕ) (sc : SCert) (K' : ℕ) : List ℤ :=
  (List.range 96).map fun p0 =>
    lcz (fun l0 => ((List.range 64).map (rowZ sc.free sc.piv sc.wC sc.C K')).getD l0 0) (dTw c p0)

/-- **The packed sector form** (kernel form). -/
def SCert.Hpk (kc : ℕ → KCert) (c : ℕ) (sc : SCert) : ℤ :=
  let ex := sc.ex c sc.K
  let ey := sc.ex c (Nat.mul sc.K 45)
  Int.mul (Int.ofNat (Nat.pow 2 sc.sig))
    (Int.sub (Int.mul 10000 (sumRange 16 fun o =>
        pairAcc c o sc.K sc.beta sc.wY (kc o) (sc.Y.getD o []) ex ey))
      (Int.mul (Int.ofNat (23851 * Nat.pow 2 (2 * sc.beta)))
        (sumRange 96 fun p0 => Int.mul (ex.getD p0 0) (ey.getD p0 0))))

theorem rowZ_eq (sc : SCert) (K' s : ℕ) :
    rowZ sc.free sc.piv sc.wC sc.C K' s = pk K' sc.free.length (sc.N s) := by
  have : rowZ sc.free sc.piv sc.wC sc.C K' s = sc.toK.zp K' s := rfl
  rw [this, KCert.zp_eq]; rfl

theorem ex_getD (hsc : sectorCheck = true) (c : ℕ) (sc : SCert) (K' : ℕ) {p0 : ℕ} (hp : p0 < 96) :
    (sc.ex c K').getD p0 0 = pk K' 45 (sc.E c p0) ∨ sc.free.length ≠ 45 := by
  by_cases h45 : sc.free.length = 45
  · left
    unfold SCert.ex
    rw [KCert.getD_map_range _ hp, lcz_eq]
    have hL : ∀ e ∈ dTw c p0, e.1 < 64 := by
      intro e he
      simp only [dTw, List.mem_map, List.mem_range] at he
      obtain ⟨i, _, rfl⟩ := he
      exact ((sector_facts hsc).1 _ (Nat.mod_lt _ (by norm_num))).2.2
    unfold SCert.E
    rw [← h45, pk_lc]
    refine congrArg List.sum (List.map_congr_left fun e he => ?_)
    rw [KCert.getD_map_range _ (hL e he), rowZ_eq]
  · right; exact h45

end SectorForm

section SectorPacked

theorem getD_map_lt {α : Type*} (f : α → ℤ) (l : List α) (d : α) {j : ℕ} (hj : j < l.length) :
    (l.map f).getD j 0 = f (l.getD j d) := by
  rw [List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_eq_getElem hj,
    List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hj]
  rfl

theorem combRows_eq (w P K' : ℕ) (Yr : ℕ → ℕ → ℤ) : ∀ (ys : List ℤ) (j0 : ℕ),
    (∀ j < ys.length, ys.getD j 0 = pk K' 45 (Yr (j0 + j))) →
    combRows w P ys j0 = pk K' 45 (fun i => ∑ j ∈ range ys.length, ent w P (j0 + j) * Yr (j0 + j) i)
  | [], j0, _ => by simp [combRows, pk]
  | y :: ys, j0, hy => by
    show kent w P j0 * y + combRows w P ys (j0 + 1) = _
    have h0 := hy 0 (by simp)
    simp only [List.getD_cons_zero, add_zero] at h0
    rw [combRows_eq w P K' Yr ys (j0 + 1) (fun j hj => by
      have := hy (j + 1) (by simp; omega)
      simp only [List.getD_cons_succ] at this
      rw [this, show j0 + (j + 1) = j0 + 1 + j by ring]), kent_eq, h0, ← pk_smul, ← pk_add]
    refine pk_congr fun i _ => ?_
    rw [List.length_cons, sum_range_succ', add_zero]
    rw [add_comm]
    congr 1
    refine sum_congr rfl fun j _ => ?_
    rw [show j0 + (j + 1) = j0 + 1 + j by ring]

/-- The test-field slot rows in packed form. -/
theorem rowW_eq (kc : KCert) (wY K' : ℕ) (Yrows : List ℕ) (hlen : Yrows.length = kc.free.length)
    (s : ℕ) :
    rowW kc (Yrows.map (prow wY K' 45)) s =
      pk K' 45 (fun i => ∑ j ∈ range kc.free.length, kc.Z s j * ent wY (Yrows.getD j 0) i) := by
  have hy : ∀ j < Yrows.length, (Yrows.map (prow wY K' 45)).getD j 0 =
      pk K' 45 (ent wY (Yrows.getD j 0)) := fun j hj => by
    rw [getD_map_lt _ _ 0 hj, prow_eq]
  unfold rowW KCert.Z
  cases hf : pos s kc.free with
  | some j' =>
    obtain ⟨hj', _⟩ := pos_spec hf
    simp only
    rw [hy j' (by omega)]
    refine pk_congr fun i _ => ?_
    simp only [ite_mul, one_mul, zero_mul]
    rw [sum_ite_eq, if_pos (mem_range.mpr hj')]
  | none =>
    cases hp : pos s kc.piv with
    | some i0 =>
      simp only
      rw [combRows_eq kc.wC (kc.C.getD i0 0) K' (fun j => ent wY (Yrows.getD j 0)) _ 0
        (fun j hj => by rw [zero_add]; exact hy j (by simpa using hj))]
      simp only [zero_add, List.length_map, hlen]
    | none => simp [pk]

theorem dlocOf_length' (b q : ℕ) : (dlocOf b q).length = 4 := dlocOf_length b q

/-- **The packed contribution of one class box** equals the packed form of its semantic rows. -/
theorem pairAcc_eq (hs : slotCheck = true) (hsc : sectorCheck = true) (kc : ℕ → KCert)
    {c o : ℕ} (ho : o < 16) (sc : SCert)
    (hlen : (sc.Y.getD o []).length = (kc o).free.length) (h45 : sc.free.length = 45) :
    pairAcc c o sc.K sc.beta sc.wY (kc o) (sc.Y.getD o []) (sc.ex c sc.K) (sc.ex c (Nat.mul sc.K 45)) =
      pk sc.K (45 * 45) (fun t => ∑ q ∈ range 216,
        (2 ^ sc.beta * (sc.Et c o q (t % 45) * sc.J kc o q (t / 45) +
          sc.J kc o q (t % 45) * sc.Et c o q (t / 45)) -
          sc.J kc o q (t % 45) * sc.J kc o q (t / 45))) := by
  have hW : ∀ K', ∀ s < 96,
      ((List.range 96).map (rowW (kc o) ((sc.Y.getD o []).map (prow sc.wY K' 45)))).getD s 0 =
        pk K' 45 (sc.Wt kc o s) := by
    intro K' s hs'
    rw [KCert.getD_map_range _ hs', rowW_eq _ _ _ _ hlen]
    rfl
  have hJ : ∀ K', ∀ q < 216,
      lcz (fun s => ((List.range 96).map (rowW (kc o) ((sc.Y.getD o []).map (prow sc.wY K' 45)))).getD
        s 0) (dlocOf (corner o) q) = pk K' 45 (sc.J kc o q) := by
    intro K' q _
    rw [lcz_eq]
    unfold SCert.J
    rw [pk_lc]
    refine congrArg List.sum (List.map_congr_left fun e he => ?_)
    rcases dloc_slot hs ho q e he with h | h
    · simp [h]
    · rw [hW K' e.1 h]
  have hE : ∀ K', ∀ q < 216, Int.mul (chiZ c (pT (patchPlaq (corner o) q)))
      ((sc.ex c K').getD (pF (patchPlaq (corner o) q)) 0) = pk K' 45 (sc.Et c o q) := by
    intro K' q hq
    have hpl := ((slot_facts hs ho).2.2.1 q hq).1
    have hpF := ((sector_facts hsc).2.2.1 _ hpl).2.2
    rcases ex_getD hsc c sc K' hpF with h | h
    · rw [imul_eq, h]; unfold SCert.Et; rw [← pk_smul]
    · exact absurd h45 h
  unfold pairAcc
  simp only []
  rw [sumRange_eq, pk_sum]
  refine sum_congr rfl fun q hq => ?_
  have hq' := mem_range.mp hq
  rw [hJ sc.K q hq', hJ (Nat.mul sc.K 45) q hq', hE sc.K q hq', hE (Nat.mul sc.K 45) q hq']
  simp only [isub_eq, imul_eq, iadd_eq, Int.ofNat_eq_natCast, natpow_eq, Nat.mul_eq]
  push_cast
  rw [pk_mul, pk_mul, pk_mul, ← pk_add, ← pk_smul, ← pk_sub]

end SectorPacked

/-! ### Soundness of the sector certificate -/

section SectorCert

/-- The kernel form of the entry bound of the sector form. -/
def SCert.βHk (sc : SCert) : ℕ :=
  Nat.pow 2 sc.sig * (10000 * 16 * 216 *
      (Nat.pow 2 sc.beta * 2 * (4 * Nat.pow 2 (sc.wC - 1)) * (4 * (96 * 4 * Nat.pow 2 (sc.wY - 1))) +
        (4 * (96 * 4 * Nat.pow 2 (sc.wY - 1))) * (4 * (96 * 4 * Nat.pow 2 (sc.wY - 1)))) +
    23851 * Nat.pow 2 (2 * sc.beta) * 96 * (4 * Nat.pow 2 (sc.wC - 1)) * (4 * Nat.pow 2 (sc.wC - 1)))

/-- **Validity of a sector certificate** (a closed Boolean computation). -/
def sectorValid (kc : ℕ → KCert) (c : ℕ) (sc : SCert) : Bool :=
  sBasis c sc &&
  allBelow 16 (fun o => decide ((sc.Y.getD o []).length = (kc o).free.length) &&
    decide ((kc o).free.length ≤ 96)) &&
  decide (1 ≤ sc.K) && decide (1 ≤ sc.wM) && decide (1 ≤ sc.wY) &&
  decide (2 * (sc.βHk + sc.M.length * Nat.pow 2 sc.wd * Nat.pow 2 (sc.wM - 1) *
    Nat.pow 2 (sc.wM - 1)) < Nat.pow 2 sc.K) &&
  psdScan sc.K 45 45 0 (Int.sub (sc.Hpk kc c) (ldlSum sc.K 45 sc.wM sc.wd sc.d sc.M 0))

theorem sectorValid_parts {kc : ℕ → KCert} {c : ℕ} {sc : SCert} (h : sectorValid kc c sc = true) :
    sBasis c sc = true ∧
    (∀ o < 16, (sc.Y.getD o []).length = (kc o).free.length ∧ (kc o).free.length ≤ 96) ∧
    1 ≤ sc.K ∧ 1 ≤ sc.wM ∧ 1 ≤ sc.wY ∧
    2 * (sc.βHk + sc.M.length * 2 ^ sc.wd * 2 ^ (sc.wM - 1) * 2 ^ (sc.wM - 1)) < 2 ^ sc.K ∧
    psdScan sc.K 45 45 0 (Int.sub (sc.Hpk kc c) (ldlSum sc.K 45 sc.wM sc.wd sc.d sc.M 0)) = true := by
  unfold sectorValid at h
  rw [Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true,
    Bool.and_eq_true, decide_eq_true_eq, decide_eq_true_eq, decide_eq_true_eq,
    decide_eq_true_eq] at h
  obtain ⟨⟨⟨⟨⟨⟨h1, h2⟩, h3⟩, h4⟩, h5⟩, h6⟩, h7⟩ := h
  refine ⟨h1, fun o ho => ?_, h3, h4, h5, ?_, h7⟩
  · have := (allBelow_iff.mp h2) o ho
    rw [Bool.and_eq_true, decide_eq_true_eq, decide_eq_true_eq] at this
    exact this
  · simpa only [natpow_eq] using h6

theorem pk_scale (K n : ℕ) (a : ℤ) (u : ℕ → ℤ) : a * pk K n u = pk K n (fun j => a * u j) :=
  (pk_smul K n a u).symm

/-- **The packed sector form** is the packing of the sector form. -/
theorem SCert.Hpk_eq (hs : slotCheck = true) (hsc : sectorCheck = true) (kc : ℕ → KCert) {c : ℕ}
    (sc : SCert) (hlen : ∀ o < 16, (sc.Y.getD o []).length = (kc o).free.length)
    (h45 : sc.free.length = 45) :
    sc.Hpk kc c = pk sc.K (45 * 45) (fun t => sc.H kc c (t % 45) (t / 45)) := by
  have hP : ∀ o ∈ range 16, pairAcc c o sc.K sc.beta sc.wY (kc o) (sc.Y.getD o [])
      (sc.ex c sc.K) (sc.ex c (Nat.mul sc.K 45)) = _ :=
    fun o ho => pairAcc_eq hs hsc kc (mem_range.mp ho) sc (hlen o (mem_range.mp ho)) h45
  have hEE : ∀ p0 ∈ range 96, Int.mul ((sc.ex c sc.K).getD p0 0) ((sc.ex c (Nat.mul sc.K 45)).getD p0 0)
      = pk sc.K 45 (sc.E c p0) * pk (sc.K * 45) 45 (sc.E c p0) := by
    intro p0 hp0
    rcases ex_getD hsc c sc sc.K (mem_range.mp hp0) with h | h
    · rcases ex_getD hsc c sc (Nat.mul sc.K 45) (mem_range.mp hp0) with h' | h'
      · rw [imul_eq, h, h']; rfl
      · exact absurd h45 h'
    · exact absurd h45 h
  unfold SCert.Hpk
  simp only []
  rw [sumRange_eq, sumRange_eq, sum_congr rfl hP, sum_congr rfl hEE, ← pk_sum, ← pk_gram]
  simp only [isub_eq, imul_eq, Int.ofNat_eq_natCast, natpow_eq]
  push_cast
  rw [pk_scale, pk_scale, ← pk_sub, pk_scale]
  refine pk_congr fun t _ => ?_
  unfold SCert.H
  ring

theorem abs_chiZ_le (c t : ℕ) : |chiZ c t| ≤ 1 := by
  unfold chiZ; split_ifs <;> norm_num

theorem lc4_bound (L : List (ℕ × ℤ)) (hL : L.length = 4) (hc : ∀ e ∈ L, |e.2| ≤ 1) (f : ℕ → ℤ)
    (B : ℤ) (hB : ∀ n, |f n| ≤ B) : |(L.map fun e => e.2 * f e.1).sum| ≤ 4 * B := by
  have : ∀ L : List (ℕ × ℤ), (∀ e ∈ L, |e.2| ≤ 1) →
      |(L.map fun e => e.2 * f e.1).sum| ≤ L.length * B := by
    intro L
    induction L with
    | nil => intro _; simp
    | cons e es ih =>
      intro h
      simp only [List.map_cons, List.sum_cons, List.length_cons]
      have h1 := h e (List.mem_cons_self ..)
      have h2 := ih fun e' he' => h e' (List.mem_cons_of_mem _ he')
      have h3 := hB e.1
      have hB0 : 0 ≤ B := le_trans (abs_nonneg _) h3
      calc |e.2 * f e.1 + (es.map fun e => e.2 * f e.1).sum|
          ≤ |e.2 * f e.1| + |(es.map fun e => e.2 * f e.1).sum| := abs_add_le _ _
        _ ≤ 1 * B + es.length * B := by
          rw [abs_mul]; exact add_le_add (mul_le_mul h1 h3 (abs_nonneg _) zero_le_one) h2
        _ = _ := by push_cast; ring
  have := this L hc
  rwa [hL] at this

theorem dTw_coef (c p0 : ℕ) : ∀ e ∈ dTw c p0, |e.2| ≤ 1 := by
  intro e he
  simp only [dTw, List.mem_map, List.mem_range] at he
  obtain ⟨i, _, rfl⟩ := he
  simp only
  rw [abs_mul]
  have := abs_chiZ_le c (lT (plaqLink (fundP p0) i % 1024))
  split_ifs <;> simp [this]

theorem dTw_length (c p0 : ℕ) : (dTw c p0).length = 4 := by simp [dTw]

theorem SCert.abs_E_le {sc : SCert} (hwC : 1 ≤ sc.wC) (c p0 i : ℕ) :
    |sc.E c p0 i| ≤ 4 * 2 ^ (sc.wC - 1) := by
  unfold SCert.E
  exact lc4_bound _ (dTw_length c p0) (dTw_coef c p0) (fun n => sc.N n i) _
    (fun n => sc.toK.abs_Z_le hwC n i)

theorem SCert.abs_Et_le {sc : SCert} (hwC : 1 ≤ sc.wC) (c o q i : ℕ) :
    |sc.Et c o q i| ≤ 4 * 2 ^ (sc.wC - 1) := by
  unfold SCert.Et
  rw [abs_mul]
  have h1 := abs_chiZ_le c (pT (patchPlaq (corner o) q))
  have h2 := sc.abs_E_le hwC c (pF (patchPlaq (corner o) q)) i
  calc |chiZ c (pT (patchPlaq (corner o) q))| * |sc.E c (pF (patchPlaq (corner o) q)) i|
      ≤ 1 * (4 * 2 ^ (sc.wC - 1)) := mul_le_mul h1 h2 (abs_nonneg _) zero_le_one
    _ = 4 * 2 ^ (sc.wC - 1) := one_mul _

theorem SCert.abs_Wt_le {kc : ℕ → KCert} {sc : SCert} (hwY : 1 ≤ sc.wY) {o : ℕ}
    (hkw : (kc o).wC = 3) (hk96 : (kc o).free.length ≤ 96) (s i : ℕ) :
    |sc.Wt kc o s i| ≤ 96 * 4 * 2 ^ (sc.wY - 1) := by
  unfold SCert.Wt
  refine (abs_sum_le_sum_abs _ _).trans ?_
  have hz : ∀ s j, |(kc o).Z s j| ≤ 4 := fun s j => by
    have := (kc o).abs_Z_le (by rw [hkw]; norm_num) s j
    rw [hkw] at this; simpa using this
  have : ∀ j ∈ range (kc o).free.length, |(kc o).Z s j * sc.Yent o j i| ≤ 4 * 2 ^ (sc.wY - 1) :=
    fun j _ => by
      rw [abs_mul]
      exact mul_le_mul (hz s j) (abs_ent_le hwY _ _) (abs_nonneg _) (by norm_num)
  refine (sum_le_sum this).trans ?_
  rw [sum_const, card_range, nsmul_eq_mul]
  have h96 : ((kc o).free.length : ℤ) ≤ 96 := by exact_mod_cast hk96
  have h4 : (0 : ℤ) ≤ 4 * 2 ^ (sc.wY - 1) := by positivity
  calc ((kc o).free.length : ℤ) * (4 * 2 ^ (sc.wY - 1)) ≤ 96 * (4 * 2 ^ (sc.wY - 1)) :=
        mul_le_mul_of_nonneg_right h96 h4
    _ = 96 * 4 * 2 ^ (sc.wY - 1) := by ring

theorem SCert.abs_J_le {kc : ℕ → KCert} {sc : SCert} (hwY : 1 ≤ sc.wY) {o : ℕ}
    (hkw : (kc o).wC = 3) (hk96 : (kc o).free.length ≤ 96) (q i : ℕ) :
    |sc.J kc o q i| ≤ 4 * (96 * 4 * 2 ^ (sc.wY - 1)) := by
  unfold SCert.J
  exact lc4_bound _ (dlocOf_length _ q) (dlocOf_coef _ q) (fun n => sc.Wt kc o n i) _
    (fun n => sc.abs_Wt_le hwY hkw hk96 n i)

/-- The entry bound, abstractly. -/
theorem abs_form_le {Et J : ℕ → ℕ → ℕ → ℤ} {E : ℕ → ℕ → ℤ} {σ b2 bE bJ : ℤ} (hσ : 0 ≤ σ)
    (hb2 : 0 ≤ b2) (hbE : 0 ≤ bE) (hbJ : 0 ≤ bJ) {i j : ℕ}
    (hEt : ∀ o < 16, ∀ q k, |Et o q k| ≤ bE) (hJ : ∀ o < 16, ∀ q k, |J o q k| ≤ bJ)
    (hE : ∀ p k, |E p k| ≤ bE) :
    |σ * (10000 * ∑ o ∈ range 16, ∑ q ∈ range 216, (b2 * (Et o q i * J o q j + J o q i * Et o q j) -
      J o q i * J o q j) - 23851 * (b2 * b2) * ∑ p0 ∈ range 96, E p0 i * E p0 j)| ≤
    σ * (10000 * (16 * (216 * (b2 * 2 * bE * bJ + bJ * bJ))) + 23851 * (b2 * b2) * (96 * (bE * bE))) := by
  have hterm : ∀ o < 16, ∀ q, |b2 * (Et o q i * J o q j + J o q i * Et o q j) - J o q i * J o q j| ≤
      b2 * 2 * bE * bJ + bJ * bJ := by
    intro o ho q
    have e1 := hEt o ho q i; have e2 := hEt o ho q j
    have j1 := hJ o ho q i; have j2 := hJ o ho q j
    have p1 : |Et o q i * J o q j| ≤ bE * bJ := by
      rw [abs_mul]; exact mul_le_mul e1 j2 (abs_nonneg _) hbE
    have p2 : |J o q i * Et o q j| ≤ bJ * bE := by
      rw [abs_mul]; exact mul_le_mul j1 e2 (abs_nonneg _) hbJ
    have p3 : |J o q i * J o q j| ≤ bJ * bJ := by
      rw [abs_mul]; exact mul_le_mul j1 j2 (abs_nonneg _) hbJ
    have q1 : |b2 * (Et o q i * J o q j + J o q i * Et o q j)| ≤ b2 * (bE * bJ + bJ * bE) := by
      rw [abs_mul, abs_of_nonneg hb2]
      exact mul_le_mul_of_nonneg_left ((abs_add_le _ _).trans (add_le_add p1 p2)) hb2
    calc _ ≤ |b2 * (Et o q i * J o q j + J o q i * Et o q j)| + |J o q i * J o q j| := abs_sub _ _
      _ ≤ b2 * (bE * bJ + bJ * bE) + bJ * bJ := add_le_add q1 p3
      _ = _ := by ring
  have hA : |∑ o ∈ range 16, ∑ q ∈ range 216, (b2 * (Et o q i * J o q j + J o q i * Et o q j) -
      J o q i * J o q j)| ≤ 16 * (216 * (b2 * 2 * bE * bJ + bJ * bJ)) := by
    refine (abs_sum_le_sum_abs _ _).trans ?_
    have : ∀ o ∈ range 16, |∑ q ∈ range 216, (b2 * (Et o q i * J o q j + J o q i * Et o q j) -
        J o q i * J o q j)| ≤ 216 * (b2 * 2 * bE * bJ + bJ * bJ) := by
      intro o ho
      refine (abs_sum_le_sum_abs _ _).trans ?_
      refine (sum_le_sum fun q _ => hterm o (mem_range.mp ho) q).trans ?_
      rw [sum_const, card_range, nsmul_eq_mul]; push_cast; exact le_refl _
    refine (sum_le_sum this).trans ?_
    rw [sum_const, card_range, nsmul_eq_mul]; push_cast; exact le_refl _
  have hB : |∑ p0 ∈ range 96, E p0 i * E p0 j| ≤ 96 * (bE * bE) := by
    refine (abs_sum_le_sum_abs _ _).trans ?_
    have : ∀ p0 ∈ range 96, |E p0 i * E p0 j| ≤ bE * bE := fun p0 _ => by
      rw [abs_mul]; exact mul_le_mul (hE p0 i) (hE p0 j) (abs_nonneg _) hbE
    refine (sum_le_sum this).trans ?_
    rw [sum_const, card_range, nsmul_eq_mul]; norm_num
  rw [abs_mul, abs_of_nonneg hσ]
  refine mul_le_mul_of_nonneg_left ?_ hσ
  have hb22 : 0 ≤ b2 * b2 := mul_nonneg hb2 hb2
  calc _ ≤ |10000 * ∑ o ∈ range 16, ∑ q ∈ range 216, (b2 * (Et o q i * J o q j + J o q i * Et o q j) -
        J o q i * J o q j)| + |23851 * (b2 * b2) * ∑ p0 ∈ range 96, E p0 i * E p0 j| := abs_sub _ _
    _ ≤ 10000 * (16 * (216 * (b2 * 2 * bE * bJ + bJ * bJ))) + 23851 * (b2 * b2) * (96 * (bE * bE)) := by
      rw [abs_mul, abs_mul, abs_of_nonneg (by norm_num : (0 : ℤ) ≤ 10000),
        abs_of_nonneg (mul_nonneg (by norm_num : (0 : ℤ) ≤ 23851) hb22)]
      exact add_le_add (mul_le_mul_of_nonneg_left hA (by norm_num))
        (mul_le_mul_of_nonneg_left hB (mul_nonneg (by norm_num) hb22))

theorem SCert.H_eq_form (kc : ℕ → KCert) (c : ℕ) (sc : SCert) (i j : ℕ) :
    sc.H kc c i j = 2 ^ sc.sig * (10000 * ∑ o ∈ range 16, ∑ q ∈ range 216,
      (2 ^ sc.beta * (sc.Et c o q i * sc.J kc o q j + sc.J kc o q i * sc.Et c o q j) -
        sc.J kc o q i * sc.J kc o q j) - 23851 * (2 ^ sc.beta * 2 ^ sc.beta) * ∑ p0 ∈ range 96,
          sc.E c p0 i * sc.E c p0 j) := by
  unfold SCert.H
  rw [← pow_add, show sc.beta + sc.beta = 2 * sc.beta by ring]

theorem SCert.βHk_eq_form (sc : SCert) : (sc.βHk : ℤ) = 2 ^ sc.sig *
    (10000 * (16 * (216 * (2 ^ sc.beta * 2 * (4 * 2 ^ (sc.wC - 1)) * (4 * (96 * 4 * 2 ^ (sc.wY - 1))) +
      (4 * (96 * 4 * 2 ^ (sc.wY - 1))) * (4 * (96 * 4 * 2 ^ (sc.wY - 1)))))) +
    23851 * (2 ^ sc.beta * 2 ^ sc.beta) * (96 * ((4 * 2 ^ (sc.wC - 1)) * (4 * 2 ^ (sc.wC - 1))))) := by
  unfold SCert.βHk
  simp only [natpow_eq]
  push_cast
  rw [← pow_add, show sc.beta + sc.beta = 2 * sc.beta by ring]
  ring

/-- **The entry bound of the sector form.** -/
theorem SCert.abs_H_le {kc : ℕ → KCert} {c : ℕ} {sc : SCert} (hwC : 1 ≤ sc.wC) (hwY : 1 ≤ sc.wY)
    (hkw : ∀ o < 16, (kc o).wC = 3) (hk96 : ∀ o < 16, (kc o).free.length ≤ 96) (i j : ℕ) :
    |sc.H kc c i j| ≤ sc.βHk := by
  rw [sc.H_eq_form kc c i j, sc.βHk_eq_form]
  exact abs_form_le (by positivity) (by positivity) (by positivity) (by positivity)
    (fun o _ q k => sc.abs_Et_le hwC c o q k)
    (fun o ho q k => sc.abs_J_le hwY (hkw o ho) (hk96 o ho) q k)
    (fun p k => sc.abs_E_le hwC c p k)


theorem SCert.H_symm (kc : ℕ → KCert) (c : ℕ) (sc : SCert) (i j : ℕ) :
    sc.H kc c i j = sc.H kc c j i := by
  unfold SCert.H
  congr 2
  · congr 1
    refine sum_congr rfl fun o _ => sum_congr rfl fun q _ => by ring
  · congr 1
    exact sum_congr rfl fun p0 _ => by ring

theorem qf_outer (n : ℕ) (u w y : ℕ → ℝ) :
    qf n (fun i j => u i * w j) y = (∑ i ∈ range n, u i * y i) * ∑ j ∈ range n, w j * y j := by
  unfold qf
  rw [sum_mul_sum]
  exact sum_congr rfl fun i _ => sum_congr rfl fun j _ => by ring

theorem qf_sum_fn {ι : Type*} (s : Finset ι) (n : ℕ) (F : ι → ℕ → ℕ → ℝ) (y : ℕ → ℝ) :
    qf n (fun i j => ∑ t ∈ s, F t i j) y = ∑ t ∈ s, qf n (F t) y := by
  unfold qf
  simp only [sum_mul]
  have h : ∀ i ∈ range n, ∑ j ∈ range n, ∑ t ∈ s, F t i j * y i * y j =
      ∑ t ∈ s, ∑ j ∈ range n, F t i j * y i * y j := fun i _ => sum_comm
  rw [sum_congr rfl h, sum_comm]

theorem qf_sub_fn (n : ℕ) (A B : ℕ → ℕ → ℝ) (y : ℕ → ℝ) :
    qf n (fun i j => A i j - B i j) y = qf n A y - qf n B y := by
  unfold qf; simp only [sub_mul, sum_sub_distrib]

theorem qf_smul_fn (n : ℕ) (a : ℝ) (A : ℕ → ℕ → ℝ) (y : ℕ → ℝ) :
    qf n (fun i j => a * A i j) y = a * qf n A y := by
  unfold qf; simp only [mul_sum]; exact sum_congr rfl fun i _ => sum_congr rfl fun j _ => by ring

/-- The dot product with the coordinates. -/
noncomputable def dotY (n : ℕ) (u : ℕ → ℤ) (y : ℕ → ℝ) : ℝ := ∑ i ∈ range n, (u i : ℝ) * y i

/-- The quadratic form of the sector form, abstractly. -/
theorem qf_form (n : ℕ) {H : ℕ → ℕ → ℤ} {Et J : ℕ → ℕ → ℕ → ℤ} {E : ℕ → ℕ → ℤ} (σ b2 : ℤ)
    (hH : ∀ i j, H i j = σ * (10000 * ∑ o ∈ range 16, ∑ q ∈ range 216,
      (b2 * (Et o q i * J o q j + J o q i * Et o q j) - J o q i * J o q j) -
      23851 * (b2 * b2) * ∑ p0 ∈ range 96, E p0 i * E p0 j)) (y : ℕ → ℝ) :
    qf n (fun i j => (H i j : ℝ)) y = (σ : ℝ) * (10000 * ∑ o ∈ range 16, ∑ q ∈ range 216,
      (2 * (b2 : ℝ) * dotY n (Et o q) y * dotY n (J o q) y - dotY n (J o q) y ^ 2) -
      23851 * ((b2 : ℝ) * b2) * ∑ p0 ∈ range 96, dotY n (E p0) y ^ 2) := by
  have e : (fun i j => (H i j : ℝ)) = fun i j => (σ : ℝ) * (10000 * ∑ o ∈ range 16,
      ∑ q ∈ range 216, ((b2 : ℝ) * (((Et o q i : ℝ) * J o q j) + (J o q i : ℝ) * Et o q j) -
        (J o q i : ℝ) * J o q j) - 23851 * ((b2 : ℝ) * b2) * ∑ p0 ∈ range 96, (E p0 i : ℝ) * E p0 j) := by
    funext i j; rw [hH]; push_cast; ring
  rw [e, qf_smul_fn, qf_sub_fn, qf_smul_fn, qf_smul_fn]
  simp only [qf_sum_fn]
  have hq : ∀ o q, qf n (fun i j => (b2 : ℝ) * (((Et o q i : ℝ) * J o q j) + (J o q i : ℝ) * Et o q j) -
      (J o q i : ℝ) * J o q j) y =
      2 * (b2 : ℝ) * dotY n (Et o q) y * dotY n (J o q) y - dotY n (J o q) y ^ 2 := by
    intro o q
    have e2 : (fun i j => (b2 : ℝ) * (((Et o q i : ℝ) * J o q j) + (J o q i : ℝ) * Et o q j) -
        (J o q i : ℝ) * J o q j) =
        fun i j => (b2 : ℝ) * ((fun i j => (Et o q i : ℝ) * J o q j) i j +
          (fun i j => (J o q i : ℝ) * Et o q j) i j) -
          (fun i j => (J o q i : ℝ) * J o q j) i j := rfl
    rw [e2, qf_sub_fn, qf_smul_fn, qf_add, qf_outer, qf_outer, qf_outer]
    unfold dotY; ring
  have hp : ∀ p0, qf n (fun i j => (E p0 i : ℝ) * E p0 j) y = dotY n (E p0) y ^ 2 :=
    fun p0 => by rw [qf_outer]; unfold dotY; ring
  simp only [hq, hp]

/-- **The certified sector inequality** in coordinates. -/
theorem sector_coord_ineq (hs : slotCheck = true) (hsc : sectorCheck = true) {kc : ℕ → KCert}
    (hkw : ∀ o < 16, (kc o).wC = 3) {c : ℕ} {sc : SCert} (hv : sectorValid kc c sc = true)
    (y : ℕ → ℝ) :
    23851 * ((2 : ℝ) ^ sc.beta * 2 ^ sc.beta) * ∑ p0 ∈ range 96, dotY 45 (sc.E c p0) y ^ 2 ≤
      10000 * ∑ o ∈ range 16, ∑ q ∈ range 216, (2 * (2 : ℝ) ^ sc.beta * dotY 45 (sc.Et c o q) y *
        dotY 45 (sc.J kc o q) y - dotY 45 (sc.J kc o q) y ^ 2) := by
  obtain ⟨hb, hY, hK, hwM, hwY, hbig, hscan⟩ := sectorValid_parts hv
  have h45 : sc.free.length = 45 := by
    unfold sBasis at hb
    rw [Bool.and_eq_true, Bool.and_eq_true, decide_eq_true_eq] at hb
    exact hb.1.2
  have hwC : 1 ≤ sc.wC := by
    unfold sBasis at hb
    rw [Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true, decide_eq_true_eq] at hb
    exact hb.1.1.2
  rw [sc.Hpk_eq hs hsc kc (fun o ho => (hY o ho).1) h45] at hscan
  have hpsd := qf_nonneg_of_psdScan (H := sc.H kc c) (βH := sc.βHk) hK hwM
    (fun i _ j _ => sc.H_symm kc c i j)
    (fun i _ j _ => SCert.abs_H_le hwC hwY hkw (fun o ho => (hY o ho).2) i j) hbig hscan y
  rw [qf_form 45 (2 ^ sc.sig) (2 ^ sc.beta) (sc.H_eq_form kc c) y] at hpsd
  have hsig : (0 : ℝ) < ((2 ^ sc.sig : ℤ) : ℝ) := by positivity
  have := (mul_nonneg_iff_of_pos_left hsig).mp hpsd
  push_cast at this
  linarith


end SectorCert

