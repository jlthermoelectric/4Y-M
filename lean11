section CoarseFields

theorem curl_patch (hs : slotCheck = true) {o : ℕ} (ho : o < 16) {φ : Fin 1024 → ℝ}
    (hφ : φ ∈ fibre (corner o)) {q : ℕ} (hq : q < 216) :
    curl φ (flp (patchPlaq (corner o) q)) =
      ((dlocOf (corner o) q).map fun e => (e.2 : ℝ) * φ (fl (slotLink (corner o) e.1))).sum := by
  have hsf := slot_facts hs ho
  have hterm : ∀ i : ℕ, (((if touches (corner o) (plaqLink (patchPlaq (corner o) q) i % 1024) = true
      then (if i < 2 then 1 else -1) else 0 : ℤ)) : ℝ) *
        φ (fl (slotLink (corner o) (slotOf (corner o) (plaqLink (patchPlaq (corner o) q) i % 1024)))) =
      (if i < 2 then 1 else -1) * φ (fl (plaqLink (patchPlaq (corner o) q) i)) := by
    intro i
    rw [phi_ind hs ho hφ (plaqLink (patchPlaq (corner o) q) i)]
    split_ifs <;> simp
  rw [flp_val (hsf.2.2.1 q hq).1]
  unfold dlocOf
  rw [List.map_map, show List.range 4 = [0, 1, 2, 3] from rfl]
  simp only [List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, Function.comp_apply]
  rw [hterm 0, hterm 1, hterm 2, hterm 3]
  unfold curl
  norm_num
  ring

/-- Sums against the curvature of a field supported near a box reduce to its patch. -/
theorem patch_sum (hg : geomCheck = true) (hs : slotCheck = true) {o : ℕ} (ho : o < 16)
    {φ : Fin 1024 → ℝ} (hsupp : ∀ l : Fin 1024, touches (corner o) l = false → φ l = 0)
    (f : Fin 1536 → ℝ) :
    ∑ p, f p * curl φ p =
      ∑ q ∈ range 216, f (flp (patchPlaq (corner o) q)) * curl φ (flp (patchPlaq (corner o) q)) := by
  have hsf := slot_facts hs ho
  have hgf := geom_facts hg
  rw [sum_fin_eq_range (fun p => f p * curl φ p) (fun n => f (flp n) * curl φ (flp n))
    (fun n h => by rw [flp_val h])]
  refine sum_range_eq_of_inj (patchPlaq (corner o)) (patchOf (corner o))
    (fun p => touches (corner o) (plaqLink p 0 % 1024) || touches (corner o) (plaqLink p 1 % 1024) ||
      touches (corner o) (plaqLink p 2 % 1024) || touches (corner o) (plaqLink p 3 % 1024))
    (fun n => f (flp n) * curl φ (flp n)) (fun q hq => hsf.2.2.1 q hq) ?_ ?_
  · intro p hp hP
    have key : ∀ i < 4, touches (corner o) (plaqLink p i % 1024) = true →
        patchOf (corner o) p < 216 ∧ patchPlaq (corner o) (patchOf (corner o) p) = p := by
      intro i hi ht
      obtain ⟨hmem, hlt⟩ := hgf.2.2.2.2.2 p hp i hi
      rw [Nat.mod_eq_of_lt hlt] at ht
      obtain ⟨h1, h2⟩ := hsf.2.1 _ hlt ht
      exact hsf.2.2.2 _ h1 p (by rw [h2]; exact hmem)
    simp only [Bool.or_eq_true] at hP
    rcases hP with ((h | h) | h) | h
    · exact key 0 (by norm_num) h
    · exact key 1 (by norm_num) h
    · exact key 2 (by norm_num) h
    · exact key 3 (by norm_num) h
  · intro p hp hP
    simp only [Bool.or_eq_false_iff] at hP
    obtain ⟨⟨⟨h0, h1⟩, h2⟩, h3⟩ := hP
    show f (flp p) * curl φ (flp p) = 0
    rw [flp_val hp]
    unfold curl
    simp only
    rw [hsupp (fl (plaqLink p 0)) h0, hsupp (fl (plaqLink p 1)) h1, hsupp (fl (plaqLink p 2)) h2,
      hsupp (fl (plaqLink p 3)) h3]
    ring

/-- **The test field** of the class box `o` for the sector certificate `sc`, at the sector
coordinates `y`: the slot field `(Z_o Y_o y) / 2^β`. -/
noncomputable def testField (kc : ℕ → KCert) (sc : SCert) (o : ℕ) (y : ℕ → ℝ) (l : Fin 1024) : ℝ :=
  if touches (corner o) l = true then
    (∑ i ∈ range 45, (sc.Wt kc o (slotOf (corner o) l) i : ℝ) * y i) / 2 ^ sc.beta
  else 0

theorem testField_slot (hs : slotCheck = true) {o : ℕ} (ho : o < 16) (kc : ℕ → KCert) (sc : SCert)
    (y : ℕ → ℝ) {s : ℕ} (hs96 : s < 96) :
    testField kc sc o y (fl (slotLink (corner o) s)) = dotY 45 (sc.Wt kc o s) y / 2 ^ sc.beta := by
  obtain ⟨hl, ht, hso⟩ := (slot_facts hs ho).1 s hs96
  unfold testField
  rw [fl_val hl, if_pos ht]
  show (∑ i ∈ range 45, (sc.Wt kc o (slotOf (corner o) (slotLink (corner o) s)) i : ℝ) * y i) /
    2 ^ sc.beta = _
  rw [hso]; rfl

theorem Z_tree_zero {o : ℕ} {kc : KCert} (hz : zCheck o kc = true) {s : ℕ}
    (hs : isTree (slotLink (corner o) s) = true) (j : ℕ) : kc.Z s j = 0 := by
  unfold zCheck at hz
  rw [Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true, List.all_eq_true,
    List.all_eq_true] at hz
  obtain ⟨⟨⟨hf, hp⟩, _⟩, _⟩ := hz
  unfold KCert.Z
  cases h1 : pos s kc.free with
  | some j' =>
    obtain ⟨hj, hget⟩ := pos_spec h1
    have hmem : s ∈ kc.free := by
      rw [← hget, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hj]; exact List.getElem_mem hj
    have := hf s hmem
    rw [hs] at this; exact absurd this (by decide)
  | none =>
    cases h2 : pos s kc.piv with
    | some i =>
      obtain ⟨hi, hget⟩ := pos_spec h2
      have hmem : s ∈ kc.piv := by
        rw [← hget, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hi]; exact List.getElem_mem hi
      have := hp s hmem
      rw [hs] at this; exact absurd this (by decide)
    | none => rfl

/-- **The test field lies in the fibre of its box.** -/
theorem testField_mem (hs : slotCheck = true) {o : ℕ} (ho : o < 16) {kc : ℕ → KCert}
    (hz : zCheck o (kc o) = true) (sc : SCert) (y : ℕ → ℝ) :
    testField kc sc o y ∈ fibre (corner o) := by
  have hsf := slot_facts hs ho
  have hsupp : ∀ l : Fin 1024, touches (corner o) l = false → testField kc sc o y l = 0 := by
    intro l hl; unfold testField; rw [if_neg (by simp [hl])]
  have htree : ∀ l : Fin 1024, isTree l = true → testField kc sc o y l = 0 := by
    intro l hl
    unfold testField
    split_ifs with ht
    · obtain ⟨h1, h2⟩ := hsf.2.1 l l.2 ht
      have hst : isTree (slotLink (corner o) (slotOf (corner o) l)) = true := by rw [h2]; exact hl
      have hW : ∀ i, sc.Wt kc o (slotOf (corner o) l) i = 0 := fun i => by
        unfold SCert.Wt; exact sum_eq_zero fun j _ => by rw [Z_tree_zero hz hst j, zero_mul]
      simp [hW]
    · rfl
  refine ⟨⟨htree, fun r => ?_⟩, hsupp⟩
  rw [show r = ⟨r.val, r.2⟩ from rfl, pinSum_slots' hs ho htree hsupp r.val r.2]
  have e : ∀ s ∈ range 96, (pinA (corner o) r s : ℝ) * testField kc sc o y (fl (slotLink (corner o) s))
      = ∑ i ∈ range 45, (y i / 2 ^ sc.beta) * ((pinA (corner o) r s : ℝ) * sc.Wt kc o s i) := by
    intro s hs'
    rw [testField_slot hs ho kc sc y (mem_range.mp hs')]
    unfold dotY
    rw [mul_div_assoc', mul_sum, sum_div]
    exact sum_congr rfl fun i _ => by ring
  rw [sum_congr rfl e, sum_comm]
  refine sum_eq_zero fun i _ => ?_
  rw [← mul_sum]
  have h0 : ∑ s ∈ range 96, (pinA (corner o) r s : ℝ) * sc.Wt kc o s i = 0 := by
    have e2 : ∀ s ∈ range 96, (pinA (corner o) r s : ℝ) * sc.Wt kc o s i =
        ∑ j ∈ range (kc o).free.length, (sc.Yent o j i : ℝ) *
          ((pinA (corner o) r s : ℝ) * (kc o).Z s j) := by
      intro s _
      unfold SCert.Wt; push_cast; rw [mul_sum]
      exact sum_congr rfl fun j _ => by ring
    rw [sum_congr rfl e2, sum_comm]
    refine sum_eq_zero fun j hj => ?_
    rw [← mul_sum]
    have := zCheck_pins hs ho hz r.val r.2 j (mem_range.mp hj)
    have h' : ∑ s ∈ range 96, (pinA (corner o) r s : ℝ) * ((kc o).Z s j : ℝ) = 0 := by
      exact_mod_cast this
    rw [h', mul_zero]
  rw [h0, mul_zero]

theorem list_mul_div (L : List (ℕ × ℤ)) (X : ℕ × ℤ → ℝ) (c : ℝ) :
    (L.map fun e => (e.2 : ℝ) * (X e / c)).sum = (L.map fun e => (e.2 : ℝ) * X e).sum / c := by
  induction L with
  | nil => simp
  | cons e es ih =>
    simp only [List.map_cons, List.sum_cons]
    rw [ih, add_div, mul_div_assoc]

/-- The curvature of the test field on the patch. -/
theorem testField_curl (hs : slotCheck = true) {o : ℕ} (ho : o < 16) {kc : ℕ → KCert}
    (hz : zCheck o (kc o) = true) (sc : SCert) (y : ℕ → ℝ) {q : ℕ} (hq : q < 216) :
    curl (testField kc sc o y) (flp (patchPlaq (corner o) q)) =
      dotY 45 (sc.J kc o q) y / 2 ^ sc.beta := by
  rw [curl_patch hs ho (testField_mem hs ho hz sc y) hq]
  have e : ∀ e ∈ dlocOf (corner o) q, (e.2 : ℝ) * testField kc sc o y (fl (slotLink (corner o) e.1)) =
      (e.2 : ℝ) * (dotY 45 (sc.Wt kc o e.1) y / 2 ^ sc.beta) := by
    intro e he
    rcases dloc_slot hs ho q e he with h | h
    · simp [h]
    · rw [testField_slot hs ho kc sc y h]
  rw [List.map_congr_left e]
  unfold SCert.J dotY
  rw [sum_list_comm]
  exact list_mul_div _ _ _

end CoarseFields

/-! ### Character collapse -/

section CharCollapse

/-- **Character orthogonality collapses a double sector sum.** If
`∑_{t < 16} χ c t · χ c' t = 16 δ_{c c'}` for all `c, c' < 16`, then for every coefficient
array `A`,
`∑_{t < 16} ∑_{c < 16} ∑_{c' < 16} χ c t · χ c' t · A c c' = 16 ∑_{c < 16} A c c`. -/
theorem char_collapse (χ : ℕ → ℕ → ℝ)
    (horth : ∀ c < 16, ∀ c' < 16, ∑ t ∈ range 16, χ c t * χ c' t = if c = c' then 16 else 0)
    (A : ℕ → ℕ → ℝ) :
    ∑ t ∈ range 16, ∑ c ∈ range 16, ∑ c' ∈ range 16, χ c t * χ c' t * A c c' =
      16 * ∑ c ∈ range 16, A c c := by
  calc ∑ t ∈ range 16, ∑ c ∈ range 16, ∑ c' ∈ range 16, χ c t * χ c' t * A c c'
      = ∑ c ∈ range 16, ∑ c' ∈ range 16, (∑ t ∈ range 16, χ c t * χ c' t) * A c c' := by
        rw [sum_comm]
        refine sum_congr rfl fun c _ => ?_
        rw [sum_comm]
        exact sum_congr rfl fun c' _ => (sum_mul _ _ _).symm
    _ = ∑ c ∈ range 16, ∑ c' ∈ range 16, (if c = c' then (16 : ℝ) else 0) * A c c' :=
        sum_congr rfl fun c hc => sum_congr rfl fun c' hc' => by
          rw [horth c (mem_range.mp hc) c' (mem_range.mp hc')]
    _ = 16 * ∑ c ∈ range 16, A c c := by
        rw [mul_sum]
        refine sum_congr rfl fun c hc => ?_
        simp only [ite_mul, zero_mul]
        rw [sum_ite_eq (range 16) c, if_pos hc]

/-- **Square of a character combination, summed over translations.** If
`∑_{t < 16} χ c t · χ c' t = 16 δ_{c c'}` for all `c, c' < 16`, then for every family `κ` of
real functions on a finite type,
`∑_{t < 16} ∑_p (∑_{c < 16} χ c t · κ c p)² = 16 ∑_{c < 16} ∑_p (κ c p)²`. -/
theorem char_sq_collapse (χ : ℕ → ℕ → ℝ)
    (horth : ∀ c < 16, ∀ c' < 16, ∑ t ∈ range 16, χ c t * χ c' t = if c = c' then 16 else 0)
    {ι : Type*} [Fintype ι] (κ : ℕ → ι → ℝ) :
    ∑ t ∈ range 16, ∑ p, (∑ c ∈ range 16, χ c t * κ c p) ^ 2 =
      16 * ∑ c ∈ range 16, ∑ p, κ c p ^ 2 := by
  calc ∑ t ∈ range 16, ∑ p, (∑ c ∈ range 16, χ c t * κ c p) ^ 2
      = ∑ p, ∑ t ∈ range 16, ∑ c ∈ range 16, ∑ c' ∈ range 16,
          χ c t * χ c' t * (κ c p * κ c' p) := by
        rw [sum_comm]
        refine sum_congr rfl fun p _ => sum_congr rfl fun t _ => ?_
        rw [sq, sum_mul_sum]
        exact sum_congr rfl fun c _ => sum_congr rfl fun c' _ => by ring
    _ = ∑ p, 16 * ∑ c ∈ range 16, κ c p * κ c p :=
        sum_congr rfl fun p _ => char_collapse χ horth (fun c c' => κ c p * κ c' p)
    _ = 16 * ∑ c ∈ range 16, ∑ p, κ c p ^ 2 := by
        rw [← mul_sum, sum_comm]
        simp only [sq]

end CharCollapse

/-! ### Stable splittings (the additive Schwarz lemma) -/

section StableSplitting

/-- **The quadratic form of a sum of orthogonal projections**:
`⟪∑_b Π_{K_b} u, u⟫ = ∑_b ‖Π_{K_b} u‖²`. -/
theorem inner_sum_starProjection_self {ι : Type*} [Fintype ι] {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] (K : ι → Submodule ℝ E) (u : E) :
    inner ℝ (∑ b, (K b).starProjection u) u = ∑ b, ‖(K b).starProjection u‖ ^ 2 := by
  rw [sum_inner]
  refine sum_congr rfl fun b _ => ?_
  have h := Submodule.starProjection_inner_eq_zero u ((K b).starProjection u)
    ((K b).starProjection_apply_mem u)
  rw [inner_sub_left, real_inner_self_eq_norm_sq] at h
  rw [real_inner_comm]
  linarith

/-- **A uniform lower bound for `∑_b Π_{K_b}` on `F` gives a stable splitting with constant
`1/q`** (the additive Schwarz lemma).

Let `F` be a subspace of a finite-dimensional real inner product space and `K b ≤ F` finitely many
subspaces. If `q ‖c‖² ≤ ∑_b ‖Π_{K_b} c‖²` for all `c ∈ F`, with `q > 0`, then every `c ∈ F` is a
sum `c = ∑_b c_b` of pieces `c_b ∈ K b` with `∑_b ‖c_b‖² ≤ q⁻¹ ‖c‖²`. The pieces are
`c_b = Π_{K_b} T⁻¹ c`, where `T = ∑_b Π_{K_b}` is inverted on `F`. -/
theorem stable_splitting_of_lower {ι : Type*} [Fintype ι] {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] (F : Submodule ℝ E) (K : ι → Submodule ℝ E)
    (hK : ∀ b, K b ≤ F) {q : ℝ} (hq : 0 < q)
    (hlow : ∀ c ∈ F, q * ‖c‖ ^ 2 ≤ ∑ b, ‖(K b).starProjection c‖ ^ 2) :
    ∀ c ∈ F, ∃ cb : ι → E, (∀ b, cb b ∈ K b) ∧ ∑ b, cb b = c ∧
      ∑ b, ‖cb b‖ ^ 2 ≤ q⁻¹ * ‖c‖ ^ 2 := by
  intro c hc
  let T : E →ₗ[ℝ] E := ∑ b, ((K b).starProjection : E →ₗ[ℝ] E)
  have hT : ∀ u, T u = ∑ b, (K b).starProjection u := fun u => by
    simp only [T, LinearMap.sum_apply, ContinuousLinearMap.coe_coe]
  have hmaps : ∀ u ∈ F, T u ∈ F := fun u _ => by
    rw [hT]
    exact Submodule.sum_mem _ fun b _ => hK b ((K b).starProjection_apply_mem u)
  let TF : Module.End ℝ F := T.restrict hmaps
  have hTF : ∀ x : F, (TF x : E) = T x := fun _ => rfl
  have hinj : Function.Injective TF := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro x hx
    have h0 : T x = 0 := by rw [← hTF, hx, Submodule.coe_zero]
    have h1 := hlow x x.2
    rw [← inner_sum_starProjection_self, ← hT, h0, inner_zero_left] at h1
    have h2 : ‖(x : E)‖ ^ 2 ≤ 0 := by nlinarith
    have h3 : ‖(x : E)‖ = 0 := by nlinarith [norm_nonneg (x : E)]
    exact Subtype.ext (by rw [norm_eq_zero.mp h3, Submodule.coe_zero])
  obtain ⟨u, hu⟩ := LinearMap.injective_iff_surjective.mp hinj ⟨c, hc⟩
  have hTu : T u = c := by rw [← hTF, hu]
  refine ⟨fun b => (K b).starProjection u, fun b => (K b).starProjection_apply_mem _,
    by rw [← hT, hTu], ?_⟩
  have hS : ∑ b, ‖(K b).starProjection (u : E)‖ ^ 2 = inner ℝ c (u : E) := by
    rw [← inner_sum_starProjection_self, ← hT, hTu]
  have hcs : inner ℝ c (u : E) ≤ ‖c‖ * ‖(u : E)‖ := real_inner_le_norm _ _
  have hl := hlow u u.2
  rw [hS] at hl ⊢
  rw [le_inv_mul_iff₀ hq]
  nlinarith [mul_le_mul_of_nonneg_left hcs hq.le, mul_le_mul_of_nonneg_left hl hq.le,
    sq_nonneg (q * ‖(u : E)‖ - ‖c‖)]

/-- **The converse of `stable_splitting_of_lower`**: if every `c ∈ F` splits as `c = ∑_b c_b`
with `c_b ∈ K b` and `∑_b ‖c_b‖² ≤ C ‖c‖²`, `C > 0`, then `C⁻¹ ‖c‖² ≤ ∑_b ‖Π_{K_b} c‖²` on `F`.
So the optimal splitting constant on `F` is exactly `1 / λ_min(∑_b Π_{K_b} | F)`. -/
theorem lower_of_stable_splitting {ι : Type*} [Fintype ι] {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] (F : Submodule ℝ E) (K : ι → Submodule ℝ E)
    {C : ℝ} (hC : 0 < C)
    (hsplit : ∀ c ∈ F, ∃ cb : ι → E, (∀ b, cb b ∈ K b) ∧ ∑ b, cb b = c ∧
      ∑ b, ‖cb b‖ ^ 2 ≤ C * ‖c‖ ^ 2) :
    ∀ c ∈ F, C⁻¹ * ‖c‖ ^ 2 ≤ ∑ b, ‖(K b).starProjection c‖ ^ 2 := by
  intro c hc
  obtain ⟨cb, hcb, hsum, hle⟩ := hsplit c hc
  set P := ∑ b, ‖(K b).starProjection c‖ ^ 2 with hP
  set S := ∑ b, ‖cb b‖ ^ 2 with hS
  have hP0 : 0 ≤ P := sum_nonneg fun b _ => sq_nonneg _
  have hpiece : ∀ b, inner ℝ c (cb b) = inner ℝ ((K b).starProjection c) (cb b) := fun b => by
    have h := Submodule.starProjection_inner_eq_zero c (cb b) (hcb b)
    rw [inner_sub_left] at h
    linarith
  have h1 : ‖c‖ ^ 2 ≤ ∑ b, ‖(K b).starProjection c‖ * ‖cb b‖ := by
    calc ‖c‖ ^ 2 = inner ℝ c c := (real_inner_self_eq_norm_sq c).symm
      _ = ∑ b, inner ℝ c (cb b) := by
          conv_lhs => rw [show inner ℝ c c = inner ℝ c (∑ b, cb b) by rw [hsum]]
          rw [inner_sum]
      _ = ∑ b, inner ℝ ((K b).starProjection c) (cb b) := sum_congr rfl fun b _ => hpiece b
      _ ≤ ∑ b, ‖(K b).starProjection c‖ * ‖cb b‖ :=
          sum_le_sum fun b _ => real_inner_le_norm _ _
  have h2 : (∑ b, ‖(K b).starProjection c‖ * ‖cb b‖) ^ 2 ≤ P * S :=
    sum_mul_sq_le_sq_mul_sq _ _ _
  have h3 : (‖c‖ ^ 2) ^ 2 ≤ P * (C * ‖c‖ ^ 2) :=
    (pow_le_pow_left₀ (sq_nonneg _) h1 2).trans
      (h2.trans (mul_le_mul_of_nonneg_left hle hP0))
  rw [inv_mul_le_iff₀ hC]
  rcases (sq_nonneg ‖c‖).eq_or_lt with h0 | hpos
  · rw [← h0]; positivity
  · refine le_of_mul_le_mul_right ?_ hpos
    nlinarith

end StableSplitting

/-! ### Assembly of the coarse lower bound -/

section SectorInequality

/-- The sector coordinates of a field: the values of its sector part at the free links. -/
noncomputable def secCoord (c : ℕ) (sc : SCert) (φ : Fin 1024 → ℝ) (j : ℕ) : ℝ :=
  secL c φ (fl (fundL (sc.free.getD j 0)))

theorem dotY_smul (n : ℕ) (a : ℤ) (u : ℕ → ℤ) (y : ℕ → ℝ) :
    dotY n (fun i => a * u i) y = (a : ℝ) * dotY n u y := by
  unfold dotY; rw [mul_sum]; push_cast; exact sum_congr rfl fun i _ => by ring

/-- **The certified inequality of one sector**, for the sector part of a section field. -/
theorem sector_ineq (hg : geomCheck = true) (hs : slotCheck = true) (hsc : sectorCheck = true)
    {kc : ℕ → KCert} (hz : ∀ o < 16, zCheck o (kc o) = true) {c : ℕ} (hc : c < 16) {sc : SCert}
    (hv : sectorValid kc c sc = true) {φ : Fin 1024 → ℝ} (hφ : φ ∈ section0) :
    (23851 / 160000 : ℝ) * ∑ p, curl (secL c φ) p ^ 2 ≤
      ∑ o ∈ range 16, (2 * ∑ p, curl (secL c φ) p * curl (testField kc sc o (secCoord c sc φ)) p -
        ∑ p, curl (testField kc sc o (secCoord c sc φ)) p ^ 2) := by
  have hkw : ∀ o < 16, (kc o).wC = 3 := fun o ho => by
    have h := hz o ho
    unfold zCheck at h
    rw [Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true, decide_eq_true_eq] at h
    exact h.1.2
  have hb := (sectorValid_parts hv).1
  have h45 : sc.free.length = 45 := by
    have h := hb
    unfold sBasis at h
    rw [Bool.and_eq_true, Bool.and_eq_true, decide_eq_true_eq] at h
    exact h.1.2
  have hψ := secL_mem hg c hφ
  have hcov : ∀ s < 16, ∀ l, secL c φ (trLink s l) = chiR c s * secL c φ l :=
    fun s hs' l => secL_tr hg hsc hc hs' φ l
  obtain ⟨y, hy⟩ : ∃ y : ℕ → ℝ, y = secCoord c sc φ := ⟨_, rfl⟩
  rw [← hy]
  have hval : ∀ l0 < 64, secL c φ (fl (fundL l0)) = ∑ j ∈ range 45, (sc.N l0 j : ℝ) * y j := by
    intro l0 hl0
    rw [sector_value hsc hg hb hψ hcov hl0, h45, hy]; rfl
  have hD : ∀ p0, ((dTw c p0).map fun e => (e.2 : ℝ) * secL c φ (fl (fundL e.1))).sum =
      dotY 45 (sc.E c p0) y := by
    intro p0
    have hL : ∀ e ∈ dTw c p0, e.1 < 64 := by
      intro e he
      simp only [dTw, List.mem_map, List.mem_range] at he
      obtain ⟨i, _, rfl⟩ := he
      exact ((sector_facts hsc).1 _ (Nat.mod_lt _ (by norm_num))).2.2
    rw [List.map_congr_left fun e he => by rw [hval e.1 (hL e he)]]
    unfold dotY SCert.E
    rw [sum_list_comm]
  have hgp : ∀ p, curl (secL c φ) p = chiR c (pT p) * dotY 45 (sc.E c (pF p)) y := by
    intro p; rw [curl_cov hg hsc hcov p, hD]
  have hnorm : ∑ p, curl (secL c φ) p ^ 2 = 16 * ∑ p0 ∈ range 96, dotY 45 (sc.E c p0) y ^ 2 := by
    have e : ∀ p : Fin 1536, curl (secL c φ) p ^ 2 = dotY 45 (sc.E c (pF p)) y ^ 2 := by
      intro p
      rw [hgp, mul_pow, sq (chiR c (pT p)), chiR_sq hsc hc ((sector_facts hsc).2.2.1 p p.2).2.1,
        one_mul]
    rw [sum_congr rfl fun p _ => e p, sum_pF hg hsc (fun p0 => dotY 45 (sc.E c p0) y ^ 2)]
  have hcross : ∀ o < 16, ∑ p, curl (secL c φ) p * curl (testField kc sc o y) p =
      ∑ q ∈ range 216, dotY 45 (sc.Et c o q) y * (dotY 45 (sc.J kc o q) y / 2 ^ sc.beta) := by
    intro o ho
    have htf := testField_mem hs ho (hz o ho) sc y
    rw [patch_sum hg hs ho htf.2]
    refine sum_congr rfl fun q hq => ?_
    have hP := ((slot_facts hs ho).2.2.1 q (mem_range.mp hq)).1
    rw [testField_curl hs ho (hz o ho) sc y (mem_range.mp hq), hgp, flp_val hP]
    have hEt : sc.Et c o q = fun i => chiZ c (pT (patchPlaq (corner o) q)) *
        sc.E c (pF (patchPlaq (corner o) q)) i := rfl
    have e2 : dotY 45 (sc.Et c o q) y = chiR c (pT (patchPlaq (corner o) q)) *
        dotY 45 (sc.E c (pF (patchPlaq (corner o) q))) y := by
      rw [hEt, dotY_smul]; rfl
    rw [e2]
  have hsq : ∀ o < 16, ∑ p, curl (testField kc sc o y) p ^ 2 =
      ∑ q ∈ range 216, (dotY 45 (sc.J kc o q) y / 2 ^ sc.beta) ^ 2 := by
    intro o ho
    have htf := testField_mem hs ho (hz o ho) sc y
    have := patch_sum hg hs ho htf.2 (curl (testField kc sc o y))
    simp only [← sq] at this
    rw [this]
    exact sum_congr rfl fun q hq => by rw [testField_curl hs ho (hz o ho) sc y (mem_range.mp hq)]
  have hcert := sector_coord_ineq hs hsc hkw hv y
  have hRHS : ∑ o ∈ range 16, (2 * ∑ p, curl (secL c φ) p * curl (testField kc sc o y) p -
      ∑ p, curl (testField kc sc o y) p ^ 2) =
      ∑ o ∈ range 16, (2 * ∑ q ∈ range 216, dotY 45 (sc.Et c o q) y *
        (dotY 45 (sc.J kc o q) y / 2 ^ sc.beta) - ∑ q ∈ range 216,
          (dotY 45 (sc.J kc o q) y / 2 ^ sc.beta) ^ 2) :=
    sum_congr rfl fun o ho => by rw [hcross o (mem_range.mp ho), hsq o (mem_range.mp ho)]
  rw [hnorm, hRHS]
  have hbpos : (0 : ℝ) < 2 ^ sc.beta := by positivity
  have key : ∑ o ∈ range 16, (2 * ∑ q ∈ range 216, dotY 45 (sc.Et c o q) y *
      (dotY 45 (sc.J kc o q) y / 2 ^ sc.beta) - ∑ q ∈ range 216,
        (dotY 45 (sc.J kc o q) y / 2 ^ sc.beta) ^ 2) =
      (∑ o ∈ range 16, ∑ q ∈ range 216, (2 * (2 : ℝ) ^ sc.beta * dotY 45 (sc.Et c o q) y *
        dotY 45 (sc.J kc o q) y - dotY 45 (sc.J kc o q) y ^ 2)) / (2 ^ sc.beta * 2 ^ sc.beta) := by
    rw [sum_div]
    refine sum_congr rfl fun o _ => ?_
    rw [mul_sum, ← sum_sub_distrib, sum_div]
    refine sum_congr rfl fun q _ => ?_
    field_simp
  rw [key, le_div_iff₀ (by positivity)]
  generalize (∑ p0 ∈ range 96, dotY 45 (sc.E c p0) y ^ 2) = A at hcert ⊢
  generalize (∑ o ∈ range 16, ∑ q ∈ range 216, (2 * (2 : ℝ) ^ sc.beta * dotY 45 (sc.Et c o q) y *
    dotY 45 (sc.J kc o q) y - dotY 45 (sc.J kc o q) y ^ 2)) = S at hcert ⊢
  generalize ((2 : ℝ) ^ sc.beta * 2 ^ sc.beta) = B at hcert ⊢
  linarith

end SectorInequality

section CoarseConstant

/-- **The curvature image** `ℱ⁽⁰⁾ = d S⁽⁰⁾` of the section. -/
noncomputable def F0 : Submodule ℝ (EuclideanSpace ℝ (Fin 1536)) := section0.map curv

theorem Kb_le_F0 (b : Fin 256) : Kb b ≤ F0 := Submodule.map_mono inf_le_left

theorem inner_curv (φ ψ : Fin 1024 → ℝ) :
    inner ℝ (curv φ) (curv ψ) = ∑ p, curl φ p * curl ψ p := by
  rw [EuclideanSpace.inner_eq_star_dotProduct, star_trivial]
  show ∑ p, curl ψ p * curl φ p = _
  exact sum_congr rfl fun p _ => mul_comm _ _

theorem norm_curv_sq (φ : Fin 1024 → ℝ) : ‖curv φ‖ ^ 2 = ∑ p, curl φ p ^ 2 := by
  rw [EuclideanSpace.real_norm_sq_eq]; rfl

/-- Summing over the boxes as translates of the class boxes. -/
theorem box_sum (hg : geomCheck = true) (hsc : sectorCheck = true) (G : ℕ → ℝ) :
    ∑ b : Fin 256, G b = ∑ o ∈ range 16, ∑ t ∈ range 16, G (trSite t (corner o)) := by
  rw [sum_fin_eq_range (fun b => G b) G (fun n h => rfl), ← Finset.sum_product']
  refine Finset.sum_nbij' (fun b => (clsOf b, trOf b)) (fun x => trSite x.2 (corner x.1))
    ?_ ?_ ?_ ?_ ?_
  · intro b hb
    obtain ⟨_, h2, h3⟩ := (geom_facts hg).2.2.2.1 b (mem_range.mp hb)
    exact mem_product.mpr ⟨mem_range.mpr h2, mem_range.mpr h3⟩
  · intro x hx
    obtain ⟨h1, h2⟩ := mem_product.mp hx
    exact mem_range.mpr ((geom_facts hg).1 _ (mem_range.mp h2) _ (site4_lt _ _ _ _)).2.1
  · intro b hb; exact ((geom_facts hg).2.2.2.1 b (mem_range.mp hb)).1
  · intro x hx
    obtain ⟨h1, h2⟩ := mem_product.mp hx
    obtain ⟨e1, e2⟩ := (sector_facts hsc).2.2.2.2.2.2.2.2.2.2 _ (mem_range.mp h1) _ (mem_range.mp h2)
    exact Prod.ext e1 e2
  · intro b hb
    show G b = G (trSite (trOf b) (corner (clsOf b)))
    rw [((geom_facts hg).2.2.2.1 b (mem_range.mp hb)).1]

/-- The translate of a fibre field of a class box is a fibre field of the translated box. -/
theorem fibre_tr2 (hg : geomCheck = true) {o t : ℕ} (ht : t < 16) {φ : Fin 1024 → ℝ}
    (hφ : φ ∈ fibre (corner o)) : (fun l => φ (trLink t l)) ∈ fibre (trSite t (corner o)) := by
  have hc : corner o < 256 := site4_lt _ _ _ _
  refine ⟨section_tr hg ht hφ.1, fun l hl => ?_⟩
  apply hφ.2
  rw [trLink_val hg ht]
  have := touches_tr hg ht hc (trL_lt hg ht l.2)
  rw [trL_trL hg ht l.2] at this
  rw [← this]; exact hl

/-- **The test field of the box `trSite t (corner o)`**: `∑_c χ_c(t) · (test field of the class
box for the sector c) ∘ τ_t`. -/
noncomputable def boxField (kc : ℕ → KCert) (scs : ℕ → SCert) (φ : Fin 1024 → ℝ) (o t : ℕ)
    (l : Fin 1024) : ℝ :=
  ∑ c ∈ range 16, chiR c t * testField kc (scs c) o (secCoord c (scs c) φ) (trLink t l)

theorem boxField_mem (hg : geomCheck = true) (hs : slotCheck = true) {kc : ℕ → KCert}
    (hz : ∀ o < 16, zCheck o (kc o) = true) (scs : ℕ → SCert) (φ : Fin 1024 → ℝ) {o t : ℕ}
    (ho : o < 16) (ht : t < 16) : boxField kc scs φ o t ∈ fibre (trSite t (corner o)) := by
  have e : boxField kc scs φ o t = ∑ c ∈ range 16, chiR c t •
      (fun l => testField kc (scs c) o (secCoord c (scs c) φ) (trLink t l)) := by
    funext l; simp [boxField, Finset.sum_apply]
  rw [e]
  exact Submodule.sum_mem _ fun c _ => Submodule.smul_mem _ _
    (fibre_tr2 hg ht (testField_mem hs ho (hz o ho) _ _))

theorem curl_boxField (hg : geomCheck = true) (kc : ℕ → KCert) (scs : ℕ → SCert)
    (φ : Fin 1024 → ℝ) {o t : ℕ} (ht : t < 16) (p : Fin 1536) :
    curl (boxField kc scs φ o t) p = ∑ c ∈ range 16, chiR c t *
      curl (testField kc (scs c) o (secCoord c (scs c) φ)) (trPlaq t p) := by
  unfold boxField
  rw [curl_lin (range 16) (fun c => chiR c t)
    (fun c l => testField kc (scs c) o (secCoord c (scs c) φ) (trLink t l))]
  exact sum_congr rfl fun c _ => by rw [curl_tr hg ht]

/-- **The coarse lower bound**, from valid certificates. -/
theorem coarse_of_certs (hg : geomCheck = true) (hs : slotCheck = true) (hsc : sectorCheck = true)
    {kc : ℕ → KCert} (hz : ∀ o < 16, zCheck o (kc o) = true) {scs : ℕ → SCert}
    (hv : ∀ c < 16, sectorValid kc c (scs c) = true) {x : EuclideanSpace ℝ (Fin 1536)}
    (hx : x ∈ F0) : 23851 / 10000 * ‖x‖ ^ 2 ≤ ∑ b : Fin 256, ‖(Kb b).starProjection x‖ ^ 2 := by
  obtain ⟨φ, hφ, rfl⟩ := Submodule.mem_map.mp hx
  set g : ℕ → Fin 1536 → ℝ := fun c => curl (secL c φ) with hgdef
  set κ : ℕ → ℕ → Fin 1536 → ℝ := fun o c =>
    curl (testField kc (scs c) o (secCoord c (scs c) φ)) with hκdef
  -- the sector decomposition of the curvature
  have hsplit : ∀ p, curl φ p = ∑ c ∈ range 16, g c p := by
    intro p
    have e : φ = fun l => ∑ c ∈ range 16, (1 : ℝ) * secL c φ l := by
      funext l; simp only [one_mul]; rw [sum_secL hsc]
    conv_lhs => rw [e]
    rw [curl_lin]; simp [hgdef]
  have hnorm : ‖curv φ‖ ^ 2 = ∑ c ∈ range 16, ∑ p, g c p ^ 2 := by
    rw [norm_curv_sq, sum_congr rfl fun p _ => by rw [hsplit p]]
    exact sum_sq_sectors hg hsc g fun c hc s hs' p => curl_secL_tr hg hsc hc hs' φ p
  -- the lower bound box by box
  have hlow : ∀ b : Fin 256, 2 * inner ℝ (curv φ) (curv (boxField kc scs φ (clsOf b) (trOf b))) -
      ‖curv (boxField kc scs φ (clsOf b) (trOf b))‖ ^ 2 ≤ ‖(Kb b).starProjection (curv φ)‖ ^ 2 := by
    intro b
    obtain ⟨hb, ho, ht⟩ := (geom_facts hg).2.2.2.1 b b.2
    apply proj_lower
    have hm := boxField_mem hg hs hz scs φ ho ht
    rw [hb] at hm
    exact Submodule.mem_map_of_mem hm
  refine le_trans ?_ (sum_le_sum fun b _ => hlow b)
  -- evaluate the lower bound
  have hbox : ∀ o < 16, ∀ t < 16,
      2 * inner ℝ (curv φ) (curv (boxField kc scs φ o t)) - ‖curv (boxField kc scs φ o t)‖ ^ 2 =
      2 * ∑ c ∈ range 16, ∑ c' ∈ range 16, chiR c t * chiR c' t * ∑ p, g c' p * κ o c p -
        ∑ p, (∑ c ∈ range 16, chiR c t * κ o c p) ^ 2 := by
    intro o ho t ht
    have hinv := trPlaq_invol hg ht
    have hinv' : ∀ p, trPlaq t (trPlaq t p) = p := hinv
    rw [inner_curv, norm_curv_sq]
    have h1 : ∑ p, curl φ p * curl (boxField kc scs φ o t) p =
        ∑ c ∈ range 16, ∑ c' ∈ range 16, chiR c t * chiR c' t * ∑ p, g c' p * κ o c p := by
      simp only [curl_boxField hg kc scs φ ht, mul_sum]
      rw [sum_comm]
      refine sum_congr rfl fun c _ => ?_
      have e : ∑ p, curl φ p * (chiR c t * κ o c (trPlaq t p)) =
          ∑ p, curl φ (trPlaq t p) * (chiR c t * κ o c p) := by
        rw [← Equiv.sum_comp (Function.Involutive.toPerm _ hinv)
          (fun p => curl φ p * (chiR c t * κ o c (trPlaq t p)))]
        simp only [Function.Involutive.coe_toPerm, hinv']
      simp only [hκdef] at e ⊢
      rw [e]
      simp only [hsplit, sum_mul]
      rw [sum_comm]
      refine sum_congr rfl fun c' hc' => ?_
      refine sum_congr rfl fun p _ => ?_
      rw [show g c' (trPlaq t p) = chiR c' t * g c' p from
        curl_secL_tr hg hsc (mem_range.mp hc') ht φ p]
      ring
    have h2 : ∑ p, curl (boxField kc scs φ o t) p ^ 2 =
        ∑ p, (∑ c ∈ range 16, chiR c t * κ o c p) ^ 2 := by
      simp only [curl_boxField hg kc scs φ ht]
      rw [← Equiv.sum_comp (Function.Involutive.toPerm _ hinv)
        (fun p => (∑ c ∈ range 16, chiR c t * κ o c (trPlaq t p)) ^ 2)]
      simp only [Function.Involutive.coe_toPerm, hinv', hκdef]
    rw [h1, h2]
  have hbox_sum := box_sum hg hsc (fun n => 2 * inner ℝ (curv φ)
    (curv (boxField kc scs φ (clsOf n) (trOf n))) -
      ‖curv (boxField kc scs φ (clsOf n) (trOf n))‖ ^ 2)
  rw [hbox_sum]
  have hct : ∀ o ∈ range 16, ∀ t ∈ range 16,
      clsOf (trSite t (corner o)) = o ∧ trOf (trSite t (corner o)) = t :=
    fun o ho t ht => (sector_facts hsc).2.2.2.2.2.2.2.2.2.2 o (mem_range.mp ho) t (mem_range.mp ht)
  have hrw : ∑ o ∈ range 16, ∑ t ∈ range 16,
      (2 * inner ℝ (curv φ) (curv (boxField kc scs φ (clsOf (trSite t (corner o)))
        (trOf (trSite t (corner o))))) -
        ‖curv (boxField kc scs φ (clsOf (trSite t (corner o))) (trOf (trSite t (corner o))))‖ ^ 2) =
      ∑ o ∈ range 16, ∑ t ∈ range 16,
        (2 * ∑ c ∈ range 16, ∑ c' ∈ range 16, chiR c t * chiR c' t * ∑ p, g c' p * κ o c p -
          ∑ p, (∑ c ∈ range 16, chiR c t * κ o c p) ^ 2) :=
    sum_congr rfl fun o ho => sum_congr rfl fun t ht => by
      rw [(hct o ho t ht).1, (hct o ho t ht).2, hbox o (mem_range.mp ho) t (mem_range.mp ht)]
  rw [hrw]
  -- collapse the characters
  have horth : ∀ c < 16, ∀ c' < 16, ∑ t ∈ range 16, chiR c t * chiR c' t = if c = c' then 16 else 0 :=
    fun c hc c' hc' => chiR_orth hsc hc hc'
  have hcoll : ∀ o ∈ range 16, ∑ t ∈ range 16,
      (2 * ∑ c ∈ range 16, ∑ c' ∈ range 16, chiR c t * chiR c' t * ∑ p, g c' p * κ o c p -
        ∑ p, (∑ c ∈ range 16, chiR c t * κ o c p) ^ 2) =
      16 * ∑ c ∈ range 16, (2 * ∑ p, g c p * κ o c p - ∑ p, κ o c p ^ 2) := by
    intro o _
    rw [sum_sub_distrib, ← mul_sum, char_collapse chiR horth (fun c c' => ∑ p, g c' p * κ o c p),
      char_sq_collapse chiR horth (κ o)]
    have e3 : ∑ c ∈ range 16, (2 * ∑ p, g c p * κ o c p - ∑ p, κ o c p ^ 2) =
        2 * ∑ c ∈ range 16, ∑ p, g c p * κ o c p - ∑ c ∈ range 16, ∑ p, κ o c p ^ 2 := by
      rw [sum_sub_distrib, mul_sum]
    rw [e3]
    generalize (∑ c ∈ range 16, ∑ p, g c p * κ o c p) = A
    generalize (∑ c ∈ range 16, ∑ p, κ o c p ^ 2) = B
    ring
  rw [sum_congr rfl hcoll, ← mul_sum]
  have hswap : ∑ o ∈ range 16, ∑ c ∈ range 16, (2 * ∑ p, g c p * κ o c p - ∑ p, κ o c p ^ 2) =
      ∑ c ∈ range 16, ∑ o ∈ range 16, (2 * ∑ p, g c p * κ o c p - ∑ p, κ o c p ^ 2) := sum_comm
  rw [hswap, hnorm]
  have hsec : ∀ c ∈ range 16, (23851 / 160000 : ℝ) * ∑ p, g c p ^ 2 ≤
      ∑ o ∈ range 16, (2 * ∑ p, g c p * κ o c p - ∑ p, κ o c p ^ 2) := fun c hc =>
    sector_ineq hg hs hsc hz (mem_range.mp hc) (hv c (mem_range.mp hc)) hφ
  have := sum_le_sum hsec
  rw [← mul_sum] at this
  generalize (∑ c ∈ range 16, ∑ p, g c p ^ 2) = A at this ⊢
  generalize (∑ c ∈ range 16, ∑ o ∈ range 16, (2 * ∑ p, g c p * κ o c p - ∑ p, κ o c p ^ 2)) = S
    at this ⊢
  linarith

end CoarseConstant

