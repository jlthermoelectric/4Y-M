`∑_b ∑_l (φ_b)_l² ≤ (3321/500) (10000/23851) ‖c‖²`. -/
theorem coarse_primitive_splitting {c : EuclideanSpace ℝ (Fin 1536)} (hc : c ∈ F0) :
    ∃ φb : Fin 256 → Fin 1024 → ℝ, (∀ b : Fin 256, φb b ∈ fibre b) ∧ ∑ b, curv (φb b) = c ∧
      ∑ b, ∑ l, φb b l ^ 2 ≤ 3321 / 500 * (10000 / 23851) * ‖c‖ ^ 2 := by
  obtain ⟨cb, h1, h2, h3⟩ := coarse_splitting hc
  choose φb hφb hcurv hle using fun b => kappa_primitive b (h1 b)
  refine ⟨φb, hφb, by simp only [hcurv]; exact h2, ?_⟩
  calc ∑ b, ∑ l, φb b l ^ 2 ≤ ∑ b, 3321 / 500 * ‖cb b‖ ^ 2 := sum_le_sum fun b _ => hle b
    _ = 3321 / 500 * ∑ b, ‖cb b‖ ^ 2 := by rw [mul_sum]
    _ ≤ 3321 / 500 * (10000 / 23851 * ‖c‖ ^ 2) := by gcongr
    _ = 3321 / 500 * (10000 / 23851) * ‖c‖ ^ 2 := by ring

/-- **The converse, applied.** `lower_of_stable_splitting` recovers `coarse_lower_bound` from
`coarse_splitting`, so the splitting constant `10000/23851` and the lower bound `23851/10000` for
`∑_b Π_{K_b}` on `ℱ⁽⁰⁾` are two forms of the same statement. -/
theorem coarse_lower_bound_of_splitting {x : EuclideanSpace ℝ (Fin 1536)} (hx : x ∈ F0) :
    23851 / 10000 * ‖x‖ ^ 2 ≤ ∑ b : Fin 256, ‖(Kb b).starProjection x‖ ^ 2 := by
  have h := lower_of_stable_splitting F0 Kb (by norm_num : (0 : ℝ) < 10000 / 23851)
    (fun c hc => coarse_splitting hc) x hx
  rwa [show ((10000 : ℝ) / 23851)⁻¹ = 23851 / 10000 by norm_num] at h

end CoarseMain

/-! ### Non-vacuity of the coarse statements

The curvature of the closed nonzero fibre field `nvField` lies in `ℱ⁽⁰⁾` and is nonzero, and the
coarse statements are applied to it. -/

section CoarseNonVacuity

/-- The curvature of the example field lies in `ℱ⁽⁰⁾`. -/
theorem curv_nvField_mem_F0 : curv nvField ∈ F0 :=
  Submodule.mem_map_of_mem (Submodule.mem_inf.mp nvField_mem).1

/-- `ℱ⁽⁰⁾` is not the zero space. -/
theorem F0_ne_bot : F0 ≠ ⊥ := by
  intro h
  have := curv_nvField_mem_F0
  rw [h, Submodule.mem_bot] at this
  exact curv_nvField_ne_zero this

/-- `coarse_lower_bound` applied to the curvature of the example field. -/
theorem coarse_lower_bound_nvField :
    23851 / 10000 * ‖curv nvField‖ ^ 2 ≤ ∑ b : Fin 256, ‖(Kb b).starProjection (curv nvField)‖ ^ 2 :=
  coarse_lower_bound curv_nvField_mem_F0

/-- `coarse_splitting` applied to the curvature of the example field. -/
theorem coarse_splitting_nvField :
    ∃ cb : Fin 256 → EuclideanSpace ℝ (Fin 1536), (∀ b, cb b ∈ Kb b) ∧ ∑ b, cb b = curv nvField ∧
      ∑ b, ‖cb b‖ ^ 2 ≤ 10000 / 23851 * ‖curv nvField‖ ^ 2 :=
  coarse_splitting curv_nvField_mem_F0

/-- `coarse_primitive_splitting` applied to the curvature of the example field. -/
theorem coarse_primitive_splitting_nvField :
    ∃ φb : Fin 256 → Fin 1024 → ℝ, (∀ b : Fin 256, φb b ∈ fibre b) ∧ ∑ b, curv (φb b) = curv nvField ∧
      ∑ b, ∑ l, φb b l ^ 2 ≤ 3321 / 500 * (10000 / 23851) * ‖curv nvField‖ ^ 2 :=
  coarse_primitive_splitting curv_nvField_mem_F0

/-- The certified coarse constant as a decimal: `10000/23851 = 0.419269…` lies in
`(0.4192, 0.4193)`. -/
theorem coarse_value : (0.4192 : ℝ) < 10000 / 23851 ∧ (10000 : ℝ) / 23851 < 0.4193 := by
  constructor <;> norm_num

end CoarseNonVacuity

/-! ### Closed applications of the remaining lemmas with hypotheses

Each lemma of the file whose hypotheses were not yet discharged in a theorem without hypotheses is
applied here to concrete data. -/

section ClosedApplications

/-- `lcz_congr` applied: `f = 1` and `g = (5 at 0, else 1)` differ only at index `0`, whose
coefficient in `[(0, 0), (1, 2)]` is `0`, so they give the same combination. -/
theorem lcz_congr_example :
    lcz (fun _ => 1) [(0, 0), (1, 2)] = lcz (fun n => if n = 0 then 5 else 1) [(0, 0), (1, 2)] := by
  apply lcz_congr
  intro e he
  simp only [List.mem_cons, List.not_mem_nil, or_false] at he
  rcases he with rfl | rfl
  · exact Or.inl rfl
  · exact Or.inr (by simp)

/-- `trP_comp` applied: the translations `1` and `2` compose to `1 ^^^ 2 = 3` on index `0`. -/
theorem trP_comp_example : trP 1 (trP 2 0) = trP (1 ^^^ 2) 0 :=
  trP_comp geomCheck_true sectorCheck_true (by norm_num) (by norm_num) (by norm_num)

/-- `trPlaq_comp` applied: the plaquette translations `1` and `2` compose to `1 ^^^ 2` on
plaquette `0`. -/
theorem trPlaq_comp_example : trPlaq 1 (trPlaq 2 0) = trPlaq (1 ^^^ 2) 0 :=
  trPlaq_comp geomCheck_true sectorCheck_true (by norm_num) (by norm_num) 0

/-- `curl_secL` applied to the example field `nvField`, sector `0`, plaquette `0`. -/
theorem curl_secL_nvField :
    curl (secL 0 nvField) 0 =
      ∑ t ∈ range 16, ((1 / 16 : ℝ) * chiR 0 t) * curl nvField (trPlaq t 0) :=
  curl_secL geomCheck_true 0 nvField 0

/-- `lower_of_stable_splitting` applied to `ℱ⁽⁰⁾`, the spaces `K_b` and the certified splitting
constant `10000/23851`, at the curvature of the example field. -/
theorem lower_of_stable_splitting_nvField :
    (10000 / 23851 : ℝ)⁻¹ * ‖curv nvField‖ ^ 2 ≤
      ∑ b : Fin 256, ‖(Kb b).starProjection (curv nvField)‖ ^ 2 :=
  lower_of_stable_splitting F0 Kb (by norm_num : (0 : ℝ) < 10000 / 23851)
    (fun c hc => coarse_splitting hc) _ curv_nvField_mem_F0

/-- `coarse_lower_bound_of_splitting` applied to the curvature of the example field. -/
theorem coarse_lower_bound_of_splitting_nvField :
    23851 / 10000 * ‖curv nvField‖ ^ 2 ≤
      ∑ b : Fin 256, ‖(Kb b).starProjection (curv nvField)‖ ^ 2 :=
  coarse_lower_bound_of_splitting curv_nvField_mem_F0

end ClosedApplications

